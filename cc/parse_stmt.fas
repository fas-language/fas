// A jump cannot enter a statement expression or skip a variably modified
// declaration. The barrier chain snapshots the scope at each endpoint.
struct VmBarrier {
    previous handle[VmBarrier]
    statement_expr bool
}
struct Jump { label handle[Label], vm handle[VmBarrier], loc u32, next handle[Jump] }

fn pa_check_jump(p handle[Parser], from handle[VmBarrier], to handle[VmBarrier], loc u32) void fails {
    while from != null && from != to { from = from.previous }
    if from != to {
        if to.statement_expr { try pa_error(p, loc, c"jump enters a statement expression") }
        try pa_error(p, loc, c"jump enters the scope of a variably modified declaration")
    }
}

fn pa_add_jump(p handle[Parser], label handle[Label], loc u32) void {
    label.used = true
    jump handle[Jump] = pa_alloc[Jump]()
    jump.loc = loc
    jump.vm = p.vm
    jump.label = label
    jump.next = p.jumps
    p.jumps = jump
}

struct CaseRange { lo addr, hi addr, loc u32 }
struct SwitchContext {
    parent handle[SwitchContext]
    ranges Vec[CaseRange]
    ty u32
    has_default bool
    vm handle[VmBarrier]
}

fn pa_get_label(p handle[Parser], t Token) handle[Label] fails {
    if p.function == null { try pa_error(p, t.loc, c"label outside function") }
    name u32 = try pa_ident(p, t)
    scope handle[Scope] = p.scope
    while scope != null {
        a addr = map_get(&scope.local_labels, name) catch null
        if a != null { return handle_from_addr(a) }
        scope = scope.parent
    }
    a addr = map_get(&p.labels, name) catch {
        l handle[Label] = pa_alloc[Label]()
        l.name = name
        l.loc = t.loc
        map_put(&p.labels, name, handle_addr(l))
        vec_push[addr](&p.label_list, handle_addr(l))
        return l
    }
    return handle_from_addr(a)
}

fn pa_local_labels(p handle[Parser]) handle[Ast] fails {
    t Token = try pa_take(p)
    try pa_gnu(p, t)
    scope handle[Scope] = p.scope
    while true {
        item Token = try pa_take(p)
        name u32 = try pa_ident(p, item)
        l handle[Label] = pa_alloc[Label]()
        l.loc = item.loc
        l.name = name
        if !map_put(&scope.local_labels, name, handle_addr(l)) {
            try pa_error(p, item.loc, c"duplicate local label declaration")
        }
        vec_push[addr](&p.label_list, handle_addr(l))
        if !(try pa_accept(p, c",")) { break }
    }
    try pa_expect(p, c";")
    return null
}

fn pa_asm_string(p handle[Parser]) handle[Ast] fails {
    text handle[Ast] = try pa_strings(p)
    if ty_node(ty_unqual(text.ty)).elem != TY_CHAR {
        try pa_error(p, text.loc, c"asm requires an ordinary string literal")
    }
    return text
}

fn pa_asm(p handle[Parser], file bool) handle[Ast] fails {
    t Token = try pa_take(p)
    n handle[Ast] = pa_node(ND_ASM, t.loc, TY_VOID)
    while true {
        a Token = try pa_peek(p)
        flag u32
        if pa_is(p, a, c"goto") { flag = 1 }
        else if pa_qual(p, a) == Q_VOLATILE { flag = 2 }
        else if pa_inline(p, a) { flag = 4 }
        else { break }
        if file || (n.flags & flag) != 0 { try pa_error(p, a.loc, c"invalid or duplicate asm qualifier") }
        n.flags |= flag
        try pa_take(p)
    }
    try pa_expect(p, c"(")
    n.a = try pa_asm_string(p)
    section u8 = 0
    names TagMap = {}
    defer { map_free(&names) }
    // The lexer can produce a single :: preprocessing token for empty adjacent sections.
    while (try pa_at(p, c":")) || (try pa_at(p, c"::")) {
        sep Token = try pa_take(p)
        section += if pa_is(p, sep, c"::") { 2 } else { 1 }
        if file || section > 4 || (section == 4 && (n.flags & 1) == 0) { try pa_error(p, sep.loc, c"invalid asm operand section") }
        if (try pa_at(p, c")")) || (try pa_at(p, c":")) || (try pa_at(p, c"::")) { continue }
        xs AstList = {}
        while true {
            if section == 4 {
                lt Token = try pa_take(p)
                l handle[Label] = try pa_get_label(p, lt)
                pa_add_jump(p, l, lt.loc)
                item handle[Ast] = pa_node(ND_NAME, lt.loc, TY_VOID)
                item.op = l.name
                item.extra = handle_addr(l)
                pa_append(&xs, item)
            } else {
                opname u32 = 0
                if section <= 2 && (try pa_accept(p, c"[")) {
                    tok Token = try pa_take(p)
                    opname = try pa_ident(p, tok)
                    if !map_put(&names, opname, 1) { try pa_error(p, tok.loc, c"duplicate named asm operand") }
                    try pa_expect(p, c"]")
                }
                constraint handle[Ast] = try pa_asm_string(p)
                if section <= 2 {
                    try pa_expect(p, c"(")
                    e handle[Ast] = try pa_expression(p, 1)
                    try pa_expect(p, c")")
                    if section == 1 {
                        // GNU asm may name a complete array output, including
                        // an input/output memory operand spanning the array.
                        if ty_is_array(e.ty) {
                            if !se_addressable(e) || (se_array_quals(e.ty) & Q_CONST) != 0 || !se_complete(e.ty) {
                                try pa_error(p, e.loc, c"asm output requires a writable array lvalue")
                            }
                        } else { try se_modifiable(p, e) }
                    }
                    spelling Bytes = cc_name(p.names, constraint.op)
                    if bytes_eq_c(spelling, c"\"m\"") || bytes_eq_c(spelling, c"\"=m\"") ||
                        bytes_eq_c(spelling, c"\"+m\"") {
                        decl handle[Symbol] = e.decl
                        if !se_addressable(e) || (e.flags & NF_BITFIELD) != 0 ||
                            (decl != null && decl.storage == SC_REGISTER) {
                            try pa_error(p, e.loc, c"asm memory operand requires an addressable object")
                        }
                    }
                    item handle[Ast] = pa_node(ND_ASM, e.loc, e.ty)
                    item.op = opname
                    item.a = constraint
                    item.b = e
                    pa_append(&xs, item)
                } else { pa_append(&xs, constraint) }
            }
            if !(try pa_accept(p, c",")) { break }
        }
        if section == 1 { n.b = xs.first }
        if section == 2 { n.c = xs.first }
        if section == 3 { n.d = xs.first }
        if section == 4 { n.extra = handle_addr(xs.first) }
    }
    try pa_expect(p, c")")
    try pa_expect(p, c";")
    return n
}

fn pa_block(p handle[Parser], scope bool, statement_expr bool) handle[Ast] fails {
    t Token = try pa_expect(p, c"{")
    if scope { pa_enter(p) }
    defer { if scope { pa_leave(p) } }
    if statement_expr {
        barrier handle[VmBarrier] = pa_alloc[VmBarrier]()
        barrier.previous = p.vm
        barrier.statement_expr = true
        p.vm = barrier
    }
    xs AstList = {}
    while !(try pa_accept(p, c"}")) {
        next Token = try pa_peek(p)
        if next.kind == TK_EOF { try pa_error(p, next.loc, c"unterminated compound statement") }
        item handle[Ast]
        leading handle[Attr] = try pa_attributes(p)
        next = try pa_peek(p)
        if next.kind == TK_IDENT && (try pa_at_second(p, c":")) {
            item = try pa_statement_in(p, true)
        } else if pa_decl_start(p, next) || (pa_is(p, next, c"__extension__") && pa_decl_start(p, try pa_peek_at(p, 1))) {
            item = try pa_declaration(p, false, leading)
            leading = null
        } else if pa_is(p, next, c"__label__") { item = try pa_local_labels(p) }
        else { item = try pa_statement_in(p, true) }
        if item != null { item.attrs = pa_join_attrs(leading, item.attrs) }
        pa_append(&xs, item)
    }
    result u32 = TY_VOID
    last handle[Ast] = xs.last
    if last != null && last.kind == ND_STMT && last.op == 0 { result = se_decay(last.ty) }
    node handle[Ast] = pa_node(ND_BLOCK, t.loc, result)
    node.a = xs.first
    return node
}

fn pa_paren_expr(p handle[Parser]) handle[Ast] fails {
    try pa_expect(p, c"(")
    e handle[Ast] = try pa_expression(p, 1)
    try pa_expect(p, c")")
    return e
}

fn pa_substatement(p handle[Parser]) handle[Ast] fails {
    pa_enter(p)
    defer { pa_leave(p) }
    return try pa_statement(p)
}

fn pa_case_compare(a handle[Ast], b handle[Ast]) i32 {
    width u32 = ty_int_bits(a.ty)
    signed bool = !ty_is_unsigned(a.ty)
    if width <= 64 {
        x u64 = a.value
        y u64 = b.value
        if signed { x ^= 0x8000000000000000; y ^= 0x8000000000000000 }
        return if x < y { -1 } else if x > y { 1 } else { 0 }
    }
    words u32 = (width + 31) / 32
    x WideInt = {a.wide, width, words}
    y WideInt = {b.wide, width, words}
    // Both values already have the switch's promoted type.
    if signed && wi_bit(x, width - 1) != wi_bit(y, width - 1) {
        return if wi_bit(x, width - 1) != 0 { -1 } else { 1 }
    }
    return wi_cmp(x, y)
}

fn pa_case_less(a handle[CaseRange], b handle[CaseRange]) bool {
    return pa_case_compare(handle_from_addr(a.lo), handle_from_addr(b.lo)) < 0
}

fn pa_case_bound(p handle[Parser], ty u32) handle[Ast] fails {
    e handle[Ast] = try pa_expression(p, 3)
    try se_require_ice(p, e)
    e = se_convert(ty, e)
    width u32 = ty_int_bits(ty)
    if width > 64 && e.wide == null { wi_store(e, wi_from_ast(e, width)) }
    return e
}

fn pa_check_cases(p handle[Parser], sw handle[SwitchContext]) void fails {
    sort_vec_by[CaseRange, pa_case_less](&sw.ranges)
    for i usize in 1..sw.ranges.n {
        prev handle[CaseRange] = vec_at[CaseRange](&sw.ranges, i - 1)
        item handle[CaseRange] = vec_at[CaseRange](&sw.ranges, i)
        if pa_case_compare(handle_from_addr(item.lo), handle_from_addr(prev.hi)) <= 0 {
            try pa_error(p, item.loc, c"duplicate or overlapping case value")
        }
    }
}

fn pa_case(p handle[Parser], t Token, n handle[Ast], in_block bool) void fails {
    context handle[SwitchContext] = p.switches
    if context == null { try pa_error(p, t.loc, c"case or default label outside switch") }
    try pa_check_jump(p, context.vm, p.vm, t.loc)
    if pa_is(p, t, c"default") {
        if context.has_default { try pa_error(p, t.loc, c"duplicate default label") }
        context.has_default = true
    } else {
        lo handle[Ast] = try pa_case_bound(p, context.ty)
        hi handle[Ast] = lo
        n.a = lo
        if try pa_accept(p, c"...") {
            try pa_gnu(p, t)
            hi = try pa_case_bound(p, context.ty)
            n.b = hi
        }
        if pa_case_compare(lo, hi) <= 0 {
            range handle[CaseRange] = vec_add[CaseRange](&context.ranges)
            range.lo = handle_addr(lo)
            range.hi = handle_addr(hi)
            range.loc = t.loc
        }
    }
    try pa_expect(p, c":")
    if !in_block { n.c = try pa_label_tail(p) }
}

fn pa_label_tail(p handle[Parser]) handle[Ast] fails {
    next Token = try pa_peek(p)
    if pa_is(p, next, c"}") || pa_decl_start(p, next) { return null }
    return try pa_statement(p)
}

fn pa_statement(p handle[Parser]) handle[Ast] fails { return try pa_statement_in(p, false) }

fn pa_statement_in(p handle[Parser], in_block bool) handle[Ast] fails {
    t Token = try pa_peek(p)
    attrs handle[Attr] = try pa_attributes(p)
    if attrs != null { t = try pa_peek(p) }
    if pa_is(p, t, c"{") { return try pa_block(p, true, false) }
    if pa_asm_word(p, t) { return try pa_asm(p, false) }
    n handle[Ast] = pa_node(ND_STMT, t.loc, TY_VOID)
    n.attrs = attrs
    if try pa_accept(p, c";") { return n }
    n.op = t.payload
    if try pa_accept(p, c"if") {
        pa_enter(p)
        defer { pa_leave(p) }
        n.a = try pa_paren_expr(p)
        try se_scalar(p, n.a)
        n.b = try pa_substatement(p)
        if try pa_accept(p, c"else") { n.c = try pa_substatement(p) }
        return n
    }
    if try pa_accept(p, c"switch") {
        pa_enter(p)
        defer { pa_leave(p) }
        key handle[Ast] = try pa_paren_expr(p)
        n.a = key
        if !ty_is_integer(key.ty) { try pa_error(p, t.loc, c"switch requires integer type") }
        sw SwitchContext = {}
        sw.parent = p.switches
        sw.ty = se_promote_expr(n.a)
        sw.vm = p.vm
        p.switches = &sw
        defer { p.switches = sw.parent }
        n.b = try pa_substatement(p)
        try pa_check_cases(p, &sw)
        return n
    }
    if try pa_accept(p, c"while") {
        pa_enter(p)
        defer { pa_leave(p) }
        n.a = try pa_paren_expr(p)
        try se_scalar(p, n.a)
        p.loops += 1
        defer { p.loops -= 1 }
        n.b = try pa_substatement(p)
        return n
    }
    if try pa_accept(p, c"do") {
        pa_enter(p)
        defer { pa_leave(p) }
        p.loops += 1
        defer { p.loops -= 1 }
        n.b = try pa_substatement(p)
        try pa_expect(p, c"while")
        n.a = try pa_paren_expr(p)
        try se_scalar(p, n.a)
        try pa_expect(p, c";")
        return n
    }
    if try pa_accept(p, c"for") {
        pa_enter(p)
        defer { pa_leave(p) }
        try pa_expect(p, c"(")
        if pa_decl_start(p, try pa_peek(p)) || (try pa_open_attr(p)) { n.a = try pa_declaration(p, false, null) }
        else if !(try pa_accept(p, c";")) { n.a = try pa_expression(p, 1); try pa_expect(p, c";") }
        if !(try pa_accept(p, c";")) {
            n.b = try pa_expression(p, 1)
            try se_scalar(p, n.b)
            try pa_expect(p, c";")
        }
        if !(try pa_accept(p, c")")) { n.c = try pa_expression(p, 1); try pa_expect(p, c")") }
        p.loops += 1
        defer { p.loops -= 1 }
        n.d = try pa_substatement(p)
        return n
    }
    if (try pa_accept(p, c"case")) || (try pa_accept(p, c"default")) {
        try pa_case(p, t, n, in_block)
        return n
    }
    if (try pa_accept(p, c"break")) || (try pa_accept(p, c"continue")) {
        if p.loops == 0 && (p.switches == null || pa_is(p, t, c"continue")) {
            try pa_error(p, t.loc, c"jump statement outside an enclosing loop or switch")
        }
    } else if try pa_accept(p, c"goto") {
        if try pa_accept(p, c"*") {
            try pa_gnu(p, t)
            dest handle[Ast] = try pa_expression(p, 1)
            n.a = dest
            if se_null(dest) { n.a = se_convert(ty_ptr(TY_VOID), dest) }
            else if !ty_is_ptr(se_decay(dest.ty)) { try pa_error(p, t.loc, c"computed goto requires pointer type") }
        } else {
            label Token = try pa_take(p)
            l handle[Label] = try pa_get_label(p, label)
            pa_add_jump(p, l, label.loc)
            n.value = zext[u64](l.name)
            n.extra = handle_addr(l)
        }
    } else if try pa_accept(p, c"return") {
        fun handle[Symbol] = p.function
        ret u32 = ty_node(ty_unqual(fun.ty)).elem
        if try pa_at(p, c";") {
            if !ty_is_void(ret) { try pa_error(p, t.loc, c"non-void function must return a value") }
        } else {
            value handle[Ast] = try pa_expression(p, 1)
            n.a = value
            if ty_is_void(ret) {
                if !ty_is_void(value.ty) || !pa_is_gnu(p) { try pa_error(p, t.loc, c"void function cannot return a value") }
            } else {
                try se_conversion(p, ret, value)
                n.a = se_convert(ret, value)
            }
        }
    } else if t.kind == TK_IDENT && !pa_keyword(p, t) && (try pa_at_second(p, c":")) {
        try pa_take(p)
        try pa_expect(p, c":")
        l handle[Label] = try pa_get_label(p, t)
        if l.defined { try pa_error(p, t.loc, c"duplicate label") }
        l.defined = true
        l.vm = p.vm
        n.op = cc_intern(p.names, bytes_c(c":"))
        n.value = zext[u64](l.name)
        n.extra = handle_addr(l)
        // GNU attributes immediately after a label appertain to the label,
        // including when it is the final item in the compound statement.
        next Token = try pa_peek(p)
        if pa_is(p, next, c"__attribute__") || pa_is(p, next, c"__attribute") {
            n.attrs = pa_join_attrs(try pa_attributes(p), n.attrs)
        }
        if !in_block { n.a = try pa_label_tail(p) }
        return n
    } else {
        n.op = 0
        e handle[Ast] = try pa_expression(p, 1)
        n.a = e
        n.ty = e.ty
    }
    try pa_expect(p, c";")
    return n
}

fn pa_function(p handle[Parser], s handle[Symbol], proto handle[Scope]) handle[Ast] fails {
    p.function = s
    scope handle[Scope] = p.scope
    p.scope = proto
    defer {
        p.function = null
        p.scope = scope
        map_free(&p.labels)
        p.label_list.n = 0
        p.jumps = null
    }
    ret u32 = ty_node(ty_unqual(s.ty)).elem
    if !ty_is_void(ret) && !se_complete(ret) { try pa_error(p, s.loc, c"function returns incomplete type") }
    formal handle[Param] = handle_from_addr(s.params)
    while formal != null {
        if !se_complete(formal.ty) { try pa_error(p, formal.loc, c"parameter has incomplete type") }
        formal = formal.next
    }
    body handle[Ast] = try pa_block(p, false, false)
    for i usize in 0..p.label_list.n {
        l handle[Label] = handle_from_addr(p.label_list.p[addr, i])
        if l.used && !l.defined { try pa_error(p, l.loc, c"use of undefined label") }
    }
    jump handle[Jump] = p.jumps
    while jump != null {
        target handle[Label] = jump.label
        try pa_check_jump(p, jump.vm, target.vm, jump.loc)
        jump = jump.next
    }
    n handle[Ast] = pa_node(ND_DECL, s.loc, s.ty)
    n.flags = NF_DEFINITION
    n.decl = s
    n.a = body
    n.attrs = s.attrs
    if p.on_function != null { try call_addr[fails](p.on_function, handle_addr(p), handle_addr(n), p.user) }
    return n
}
