struct Embed {
    limit usize
    prefix Arg
    suffix Arg
    empty Arg
    has_limit bool
}

fn embed_spec(p handle[Pp], tokens handle[Vec[Token]], start usize, loc u32, spec handle[Embed], query bool) bool fails {
    n handle[CNames] = &p.names
    i usize = start
    while i < tokens.n {
        word Token = tokens.p[Token, i]
        name Bytes = feature_attr(cc_spelling(n, word))
        i += 1
        supported bool = true
        if i < tokens.n && cc_is(n, tokens.p[Token, i], c"::") {
            supported = false
            i += 2
        }
        if i == tokens.n || !cc_is(n, tokens.p[Token, i], c"(") { try cc_error(n, loc, c"expected '(' after embed parameter") }
        i += 1
        first usize = i
        depth usize = 1
        while i < tokens.n {
            t Token = tokens.p[Token, i]
            if cc_is(n, t, c"(") { depth += 1 }
            if cc_is(n, t, c")") { depth -= 1 }
            if depth == 0 { break }
            i += 1
        }
        if depth != 0 { try cc_error(n, loc, c"unterminated embed parameter") }
        a Arg = {first, i - first}
        i += 1
        if supported && bytes_eq_c(name, c"limit") {
            if spec.has_limit { try cc_error(n, loc, c"duplicate embed limit") }
            spec.has_limit = true
            expr Vec[Token] = {}
            expr.p = tokens.p + a.start * sizeof[Token]
            expr.n = a.size
            v PpInt = try pp_int(p, &expr, loc)
            if !v.uns && bitcast[i64](v.bits) < 0 { try cc_error(n, loc, c"negative embed limit") }
            spec.limit = v.bits
        } else if supported && bytes_eq_c(name, c"prefix") {
            if spec.prefix.start != 0 { try cc_error(n, loc, c"duplicate embed prefix") }
            spec.prefix = a
        } else if supported && bytes_eq_c(name, c"suffix") {
            if spec.suffix.start != 0 { try cc_error(n, loc, c"duplicate embed suffix") }
            spec.suffix = a
        } else if supported && bytes_eq_c(name, c"if_empty") {
            if spec.empty.start != 0 { try cc_error(n, loc, c"duplicate embed if_empty") }
            spec.empty = a
        } else {
            if query { return false }
            try cc_error(n, loc, c"unsupported embed parameter")
        }
    }
    return true
}

fn embed_copy(p handle[Pp], tokens handle[Vec[Token]], a Arg) void {
    for j usize in a.start..a.start + a.size { vec_push[Token](&p.pending.tokens, tokens.p[Token, j]) }
}

// Yield resource bytes on demand. Text uses the same source stream as
// the parser, so a large resource needs no materialized token vector.
struct EmbedOutput {
    data Bytes
    at usize
    comma_next bool
    active bool
    comma Token
    value Token
    suffix Span
}

fn embed_next(p handle[Pp]) Token {
    output handle[EmbedOutput] = &p.embedded
    if output.at != output.data.n {
        if output.comma_next {
            output.comma_next = false
            return output.comma
        }
        byte u8 = output.data.p[u8, output.at]
        i usize = zext[usize](byte)
        id u32 = p.byte_spellings[i]
        if id == 0 {
            number Token = pp_number(&p.names, output.value, zext[u64](byte))
            id = number.payload
            p.byte_spellings[i] = id
        }
        output.at += 1
        output.comma_next = true
        t Token = output.value
        t.payload = id
        return t
    }
    if output.suffix.at != output.suffix.n {
        t Token = output.suffix.p[Token, zext[usize](output.suffix.at)]
        output.suffix.at += 1
        return t
    }
    output.active = false
    return cc_token(TK_EOF, 0, 0, 0)
}

fn pp_embed(p handle[Pp], args handle[Vec[Token]], loc u32) void fails {
    n handle[CNames] = &p.names
    expanded Vec[Token] = {}
    start usize = 0
    if args.n > 0 && args.p[Token].kind == TK_HEADER {
        vec_push[Token](&expanded, args.p[Token])
        start = 1
    }
    try expand_list(p, args.p + start * sizeof[Token], args.n - start, &expanded, false)
    h Header = {}
    try pp_header(p, &expanded, loc, &h)
    spec Embed = {}
    spec.limit = ~0
    try embed_spec(p, &expanded, h.used, loc, &spec, false)
    found Found = pp_find(p, h.name, h.quote, false)
    if found.file == null { try cc_error(n, loc, c"embed resource not found") }
    pp_depend(p, found.path, found.system)
    file handle[Input] = handle_from_addr(found.file)
    size usize = if file.content.n < spec.limit { file.content.n } else { spec.limit }
    if size == 0 { embed_copy(p, &expanded, spec.empty); return }
    embed_copy(p, &expanded, spec.prefix)
    stream handle[EmbedOutput] = &p.embedded
    stream.data = bytes(file.content.p, size)
    stream.at = 0
    stream.comma_next = false
    stream.active = true
    stream.value = cc_token(TK_NUM, F_SPACE, loc, 0)
    stream.comma = cc_token(TK_PUNCT, 0, loc, cc_intern(n, bytes_c(c",")))
    stream.suffix = {expanded.p + spec.suffix.start * sizeof[Token], trunc[u32](spec.suffix.size), 0}
}
