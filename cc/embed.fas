// cc2/embed.fas: C23 #embed and __has_embed.

struct Embed {
    limit usize
    prefix Arg
    suffix Arg
    empty Arg
    has_limit bool
}

fn embed_spec(p handle[Pp], tokens handle[Vec[Token]], start usize, loc u32, spec handle[Embed], query bool) bool fails {
    ctx handle[CcCtx] = &p.ctx
    i usize = start
    while i < tokens.n {
        word Token = tokens.p[Token, i]
        name Bytes = feature_attr(tok_spelling(ctx, word))
        i += 1
        supported bool = true
        if i < tokens.n && tokens.p[Token, i].kind == TK_DCOLON {
            supported = false
            i += 2
        }
        if i == tokens.n || tokens.p[Token, i].kind != TK_LPAREN { try cc_error(ctx, loc, c"expected '(' after embed parameter") }
        i += 1
        first usize = i
        depth usize = 1
        while i < tokens.n {
            t Token = tokens.p[Token, i]
            if t.kind == TK_LPAREN { depth += 1 }
            if t.kind == TK_RPAREN { depth -= 1 }
            if depth == 0 { break }
            i += 1
        }
        if depth != 0 { try cc_error(ctx, loc, c"unterminated embed parameter") }
        a Arg = {trunc[u32](first), trunc[u32](i - first), false}
        i += 1
        if supported && bytes_eq_c(name, c"limit") {
            if spec.has_limit { try cc_error(ctx, loc, c"duplicate embed limit") }
            spec.has_limit = true
            expr Vec[Token] = {}
            expr.p = tokens.p + zext[usize](a.start) * sizeof[Token]
            expr.n = zext[usize](a.size)
            v PpInt = try pp_int(p, &expr, loc)
            if !v.uns && bitcast[i64](v.bits) < 0 { try cc_error(ctx, loc, c"negative embed limit") }
            spec.limit = v.bits
        } else if supported && bytes_eq_c(name, c"prefix") {
            if spec.prefix.start != 0 { try cc_error(ctx, loc, c"duplicate embed prefix") }
            spec.prefix = a
        } else if supported && bytes_eq_c(name, c"suffix") {
            if spec.suffix.start != 0 { try cc_error(ctx, loc, c"duplicate embed suffix") }
            spec.suffix = a
        } else if supported && bytes_eq_c(name, c"if_empty") {
            if spec.empty.start != 0 { try cc_error(ctx, loc, c"duplicate embed if_empty") }
            spec.empty = a
        } else {
            if query { return false }
            try cc_error(ctx, loc, c"unsupported embed parameter")
        }
    }
    return true
}

fn embed_copy(p handle[Pp], tokens handle[Vec[Token]], a Arg) void {
    s usize = zext[usize](a.start)
    for j usize in s..s + zext[usize](a.size) { vec_push[Token](&p.pending.tokens, tokens.p[Token, j]) }
}

struct EmbedOutput {
    data Bytes
    at usize
    comma_next bool
    active bool
    comma Token
    value Token
    suffix Vec[Token]
    suffix_at usize
}

fn embed_next(p handle[Pp]) Token {
    output handle[EmbedOutput] = &p.embedded
    if output.at != output.data.n {
        if output.comma_next {
            output.comma_next = false
            return output.comma
        }
        byte u8 = output.data.p[u8, output.at]
        i usize = zext[usize](byte)
        id u32 = p.byte_spellings[i]
        if id == 0 {
            number Token = pp_number(&p.ctx, output.value, zext[u64](byte))
            id = number.val
            p.byte_spellings[i] = id
        }
        output.at += 1
        output.comma_next = true
        t Token = output.value
        t.val = id
        return t
    }
    if output.suffix_at != output.suffix.n {
        t Token = output.suffix.p[Token, output.suffix_at]
        output.suffix_at += 1
        return t
    }
    output.active = false
    return tok_make(TK_EOF, 0, 0, 0, 0)
}

fn pp_embed(p handle[Pp], args handle[Vec[Token]], loc u32) void fails {
    ctx handle[CcCtx] = &p.ctx
    expanded Vec[Token] = {}
    defer { vec_free[Token](&expanded) }
    start usize = 0
    if args.n > 0 && args.p[Token].kind == TK_HEADER {
        vec_push[Token](&expanded, args.p[Token])
        start = 1
    }
    try expand_list(p, args.p + start * sizeof[Token], args.n - start, &expanded, false)
    h Header = {}
    defer { buf_free(&h.owned) }
    try pp_header(p, &expanded, loc, &h)
    spec Embed = {}
    spec.limit = ~0
    try embed_spec(p, &expanded, h.used, loc, &spec, false)
    found Found = pp_find(p, h.name, h.quote, false)
    if found.file == null { try cc_error(ctx, loc, c"embed resource not found") }
    pp_depend(p, found.path, found.system)
    sf handle[SourceFile] = handle_from_addr(found.file)
    size usize = if sf.raw_len < spec.limit { sf.raw_len } else { spec.limit }
    if size == 0 { embed_copy(p, &expanded, spec.empty); return }
    embed_copy(p, &expanded, spec.prefix)
    stream handle[EmbedOutput] = &p.embedded
    stream.data = bytes(sf.raw_data, size)
    stream.at = 0
    stream.comma_next = false
    stream.active = true
    stream.value = tok_make(TK_NUM, F_SPACE | F_SYNTH, 0xFFFF, loc, 0)
    stream.comma = tok_make(TK_COMMA, 0, 1, loc, 0)
    vec_clear[Token](&stream.suffix)
    suf_s usize = zext[usize](spec.suffix.start)
    for j usize in suf_s..suf_s + zext[usize](spec.suffix.size) {
        vec_push[Token](&stream.suffix, expanded.p[Token, j])
    }
    stream.suffix_at = 0
}
