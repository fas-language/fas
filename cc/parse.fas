// Streaming C grammar. Two tokens suffice for label and declarator
// disambiguation. The preprocessor owns spellings and source positions.
use "layout.fas"

const ND_INT u8 = 1
const ND_FLOAT u8 = 2
const ND_STRING u8 = 3
const ND_NAME u8 = 4
const ND_UNARY u8 = 5
const ND_BINARY u8 = 6
const ND_COND u8 = 7
const ND_CAST u8 = 8
const ND_CALL u8 = 9
const ND_MEMBER u8 = 10
const ND_SIZE u8 = 11
const ND_INIT u8 = 12
const ND_DECL u8 = 13
const ND_BLOCK u8 = 14
const ND_STMT u8 = 15
const ND_SUBSCRIPT u8 = 16
const ND_GENERIC u8 = 17
const ND_ASM u8 = 18
const ND_DESIGNATOR u8 = 19
const ND_COMPOUND u8 = 20

const NF_LVALUE u32 = 1
const NF_ICE u32 = 2
const NF_STATIC u32 = 4
const NF_BITFIELD u32 = 8
const NF_OVERFLOW u32 = 16
const NF_DEFINITION u32 = 32
const NF_IMPLICIT u32 = 256
// GNU folding may produce a constant value without meeting C23 ICE syntax.
const NF_FOLD u32 = 512
const NF_TYPEOF_EVAL u32 = 1024 // evaluate ND_DECL.b once for a shared typeof specifier
const NF_PARTIAL_INIT u32 = 2048 // brace elision writes only the listed subobjects
const NF_INFERRED_DECL u32 = 4096 // the initializer supplies variably modified type bounds
const NF_FENV u32 = 8192 // dynamic floating-point environment at this node
const NF_INT_VALUE u32 = NF_ICE | NF_FOLD
const NF_ASM_EXTENDED u32 = 16384 // ND_ASM only: a colon introduces operand sections

struct Ast {
    kind u8
    loc u32
    ty u32
    op u32
    operand_ty u32 // common evaluation type for binary operators
    flags u32
    value u64
    field_offset u64
    field_width u32
    imag u64 // imaginary component of a floating constant
    float_bits handle[FloatBits] // exact bits when the f64 approximation loses information
    wide addr // integer limbs when the constant type exceeds 64 bits
    a handle[Ast]
    b handle[Ast] // exact integer magnitude for an imaginary integer ND_FLOAT
    c handle[Ast]
    d handle[Ast]
    next handle[Ast]
    decl handle[Symbol]
    attrs handle[Attr]
    extra addr
}

struct Attr {
    name u32
    ns u32
    loc u32
    args Vec[Token]
    next handle[Attr]
}

const SC_NONE u8 = 0
const SC_TYPEDEF u8 = 1
const SC_EXTERN u8 = 2
const SC_STATIC u8 = 3
const SC_AUTO u8 = 4
const SC_REGISTER u8 = 5
const SC_CONSTEXPR u8 = 6
const SC_ENUMERATOR u8 = 7

const SF_GNU_EXTERN_INLINE u32 = 4 // a body for inlining before the external definition

struct Symbol {
    name u32
    loc u32
    ty u32
    storage u8
    linkage u8  // 0 none, 1 internal, 2 external
    thread_local bool
    defined bool
    tentative bool
    value addr // Ast
    params addr // Param list
    link_symbol handle[Symbol] // symbol identity for a block declaration with no visible linked declaration
    attrs handle[Attr]
    asm_name u32
    debug_typedef u32 // source spelling of a typedef that names this type
    cleanup addr // Symbol for a GNU cleanup function
    flags u32
}

type SymbolMap = Map[u32, addr, u32_hash, u32_eq]
type TagMap = Map[u32, u32, u32_hash, u32_eq]

struct Scope {
    parent handle[Scope]
    ordinary SymbolMap
    local_labels SymbolMap
    vm_saved handle[VmBarrier]
    tags TagMap
}

struct Label {
    name u32
    defined bool
    used bool
    loc u32
    vm handle[VmBarrier]
}

struct WeakAlias {
    name u32
    target u32
    loc u32
}

struct Parser {
    pp handle[Pp]
    names handle[CNames]
    types TypeCtx
    scope handle[Scope]
    file_scope handle[Scope]
    external SymbolMap
    enum_bodies TagMap
    record_open TagMap
    objects Vec[addr]
    weak_aliases Vec[WeakAlias]
    weak_alias_slots TagMap
    labels SymbolMap
    label_list Vec[addr]
    switches handle[SwitchContext]
    vm handle[VmBarrier]
    jumps handle[Jump]
    init_depth u32
    loops u32
    function handle[Symbol]
    x86_features u64
    x86_feature_stack Vec[u64]
    fenv_access bool
    fenv_default bool
    function_fenv bool
    extension_expr bool
    ahead arr[2, Token]
    pending u32
    replay handle[Vec[Token]] // optional balanced attribute operand
    replay_at usize
    location u32
    pack u32
    packs Vec[u32]
    pack_names Vec[u32]
    vla_bounds Vec[addr]
    // Callback receives (Parser*, Ast*, user). Nodes remain valid in the TU region.
    on_function addr
    on_object addr
    user addr
}

fn pa_trim(s Bytes) Bytes {
    a usize = 0
    b usize = s.n
    while a < b && cc_space(s.p[u8, a]) { a += 1 }
    while b > a && cc_space(s.p[u8, b - 1]) { b -= 1 }
    return bytes_sub(s, a, b - a)
}

fn pa_pragma(p handle[Parser], t Token) void fails {
    s Bytes = pa_trim(cc_spelling(p.names, t))
    if bytes_starts_with(s, bytes_c(c"GCC")) {
        // GCC's intrinsic headers surround their always-inline wrappers with
        // these pragmas. The selection is parser state, not a new TU macro set.
        tokens Vec[Token] = {}
        defer { vec_free(&tokens) }
        try pragma_tokens(p.pp, s, t.loc, &tokens)
        if tokens.n < 2 || !pa_is(p, tokens.p[Token], c"GCC") { return }
        command Token = tokens.p[Token, 1]
        if pa_is(p, command, c"push_options") {
            vec_push(&p.x86_feature_stack, p.x86_features)
        } else if pa_is(p, command, c"pop_options") {
            if p.x86_feature_stack.n > 0 {
                p.x86_features = vec_get(&p.x86_feature_stack, p.x86_feature_stack.n - 1)
                p.x86_feature_stack.n -= 1
            }
        } else if pa_is(p, command, c"reset_options") {
            p.x86_features = p.pp.x86_features
        } else if pa_is(p, command, c"target") {
            for i usize in 2..tokens.n {
                token Token = vec_get(&tokens, i)
                if token.kind == TK_STR {
                    p.x86_features = x86_apply_target(p.x86_features, pp_destringize(cc_spelling(p.names, token)))
                }
            }
        }
        return
    }
    if bytes_starts_with(s, bytes_c(c"STDC")) {
        tokens Vec[Token] = {}
        defer { vec_free(&tokens) }
        try pragma_tokens(p.pp, s, t.loc, &tokens)
        if tokens.n == 3 && pa_is(p, tokens.p[Token, 0], c"STDC") &&
            pa_is(p, tokens.p[Token, 1], c"FENV_ACCESS") {
            mode Token = tokens.p[Token, 2]
            if pa_is(p, mode, c"ON") { p.fenv_access = true }
            else if pa_is(p, mode, c"OFF") { p.fenv_access = false }
            else if pa_is(p, mode, c"DEFAULT") { p.fenv_access = p.fenv_default }
            if p.fenv_access && p.function != null { p.function_fenv = true }
        }
        return
    }
    if bytes_starts_with(s, bytes_c(c"weak")) && s.n > 4 && cc_space(s.p[u8, 4]) {
        tokens Vec[Token] = {}
        defer { vec_free(&tokens) }
        try pragma_tokens(p.pp, s, t.loc, &tokens)
        // The alias target can be declared after the pragma. Resolve it at
        // file scope before finalizing the TU's linker symbols.
        if tokens.n >= 3 && pa_is(p, tokens.p[Token, 2], c"=") {
            if tokens.n != 4 || tokens.p[Token, 1].kind != TK_IDENT || tokens.p[Token, 3].kind != TK_IDENT ||
                pa_keyword(p, tokens.p[Token, 1]) || pa_keyword(p, tokens.p[Token, 3]) {
                try cc_warning(p.names, t.loc, WARN_ON, c"malformed '#pragma weak' ignored")
                return
            }
            name u32 = cc_ident(p.names, tokens.p[Token, 1])
            slot u32 = map_get(&p.weak_alias_slots, name) catch 0xffffffff
            if slot == 0xffffffff {
                slot = trunc[u32](p.weak_aliases.n)
                vec_add(&p.weak_aliases)
                map_put(&p.weak_alias_slots, name, slot)
            }
            entry handle[WeakAlias] = vec_at(&p.weak_aliases, zext[usize](slot))
            // GNU as applies repeated .set directives in order. Use the
            // final target and emit one canonical weak alias definition.
            entry.name = name
            entry.target = cc_ident(p.names, tokens.p[Token, 3])
            entry.loc = t.loc
        }
        return
    }
    if !bytes_starts_with(s, bytes_c(c"pack")) { return }
    s = pa_trim(bytes_from(s, 4))
    if s.n < 2 || s.p[u8] != 40 || s.p[u8, s.n - 1] != 41 { return }
    s = pa_trim(bytes_sub(s, 1, s.n - 2))
    if s.n == 0 { p.pack = 0; return }
    comma usize = bytes_index(s, 44) catch s.n
    op Bytes = pa_trim(bytes_sub(s, 0, comma))
    push bool = bytes_eq_c(op, c"push")
    pop bool = bytes_eq_c(op, c"pop")
    if push || pop { s = if comma == s.n { bytes(null, 0) } else { pa_trim(bytes_from(s, comma + 1)) } }
    name u32 = 0
    n u64 = bytes_to_u64(s) catch ~0
    if (push || pop) && s.n != 0 && n == ~0 {
        split usize = bytes_index(s, 44) catch s.n
        label Bytes = pa_trim(bytes_sub(s, 0, split))
        if label.n == 0 || !cc_id_ascii(label.p[u8], true, p.names.gnu) { return }
        name = cc_intern(p.names, label)
        if split < s.n { n = bytes_to_u64(pa_trim(bytes_from(s, split + 1))) catch { return } }
    }
    if push {
        vec_push[u32](&p.packs, p.pack)
        vec_push[u32](&p.pack_names, name)
    } else if pop {
        // A named pop discards entries through the closest matching push.
        at usize = p.packs.n
        while at != 0 {
            at -= 1
            if name == 0 || vec_get[u32](&p.pack_names, at) == name {
                p.pack = vec_get[u32](&p.packs, at)
                p.packs.n = at
                p.pack_names.n = at
                break
            }
        }
    }
    if n == 0 || n == 1 || n == 2 || n == 4 || n == 8 || n == 16 { p.pack = trunc[u32](n) }
}

fn pa_peek_at(p handle[Parser], i u32) Token fails {
    while p.pending <= i {
        t Token
        input handle[Vec[Token]] = p.replay
        if input == null { t = try pp_next(p.pp) }
        else if p.replay_at < input.n {
            t = input.p[Token, p.replay_at]
            p.replay_at += 1
        } else { t = cc_token(TK_EOF, 0, p.location, 0) }
        if t.kind == TK_PRAGMA { try pa_pragma(p, t); continue }
        if t.kind == TK_DIRECT { continue }
        if t.kind == TK_EOF && t.loc == 0 { t.loc = p.location }
        if t.kind == TK_PUNCT {
            spelling Bytes = cc_spelling(p.names, t)
            if spelling.n == 2 {
                canonical addr = null
                if bytes_eq_c(spelling, c"<:") { canonical = c"[" }
                else if bytes_eq_c(spelling, c":>") { canonical = c"]" }
                else if bytes_eq_c(spelling, c"<%") { canonical = c"{" }
                else if bytes_eq_c(spelling, c"%>") { canonical = c"}" }
                if canonical != null { t.payload = cc_intern(p.names, bytes_c(canonical)) }
            }
        }
        p.ahead[zext[usize](p.pending)] = t
        p.pending += 1
    }
    return p.ahead[zext[usize](i)]
}

fn pa_peek(p handle[Parser]) Token fails { return try pa_peek_at(p, 0) }

fn pa_take(p handle[Parser]) Token fails {
    t Token = try pa_peek(p)
    p.pending -= 1
    if p.pending != 0 { p.ahead[0] = p.ahead[1] }
    p.location = t.loc
    return t
}

fn pa_is_gnu(p handle[Parser]) bool {
    n handle[CNames] = p.names
    return n.gnu || p.extension_expr
}

fn pa_is(p handle[Parser], t Token, word addr) bool {
    if t.kind == TK_EOF || !cc_is(p.names, t, word) { return false }
    standard u8 = p.pp.standard
    if standard == 0 || standard == 23 || t.kind != TK_IDENT { return true }
    name Bytes = bytes_c(word)
    if p.names.gnu && bytes_eq_c(name, c"typeof") { return true }
    if feature_in(C23_KEYWORDS, name) { return false }
    return true
}

fn pa_at(p handle[Parser], word addr) bool fails { return pa_is(p, try pa_peek(p), word) }
fn pa_at_second(p handle[Parser], word addr) bool fails { return pa_is(p, try pa_peek_at(p, 1), word) }

fn pa_accept(p handle[Parser], word addr) bool fails {
    if !(try pa_at(p, word)) { return false }
    try pa_take(p)
    return true
}

fn pa_error(p handle[Parser], loc u32, message addr) void fails {
    try cc_error(p.names, loc, message)
}

fn pa_expect(p handle[Parser], word addr) Token fails {
    t Token = try pa_take(p)
    if pa_is(p, t, word) { return t }
    b Buf = {}
    buf_str(&b, c"expected '")
    buf_str(&b, word)
    buf_str(&b, c"'")
    if t.kind != TK_EOF {
        buf_str(&b, c", got '")
        buf_append(&b, cc_spelling(p.names, t))
        buf_u8(&b, 39)
    }
    try pa_error(p, t.loc, buf_cstr(&b))
    return t
}

fn pa_gnu(p handle[Parser], t Token) void fails {
    if !pa_is_gnu(p) { try pa_error(p, t.loc, c"GNU extension requires -std=gnu23") }
}

fn pa_alloc[T]() handle[T] {
    return handle_from_addr(heap_alloc_zeroed(sizeof[T]))
}

fn pa_node(kind u8, loc u32, ty u32) handle[Ast] {
    n handle[Ast] = pa_alloc[Ast]()
    n.kind = kind
    n.loc = loc
    n.ty = ty
    return n
}

struct AstList { first handle[Ast], last handle[Ast] }

fn pa_append(xs handle[AstList], n handle[Ast]) void {
    if n == null { return }
    if xs.last == null { xs.first = n }
    else {
        last handle[Ast] = xs.last
        last.next = n
    }
    while n.next != null { n = n.next }
    xs.last = n
}

fn pa_enter(p handle[Parser]) void {
    s handle[Scope] = pa_alloc[Scope]()
    s.parent = p.scope
    s.vm_saved = p.vm
    p.scope = s
}

fn pa_leave(p handle[Parser]) void {
    s handle[Scope] = p.scope
    p.scope = s.parent
    p.vm = s.vm_saved
    map_free(&s.ordinary)
    map_free(&s.tags)
    map_free(&s.local_labels)
    heap_free(handle_addr(s))
}

fn pa_lookup(p handle[Parser], name u32) handle[Symbol] {
    s handle[Scope] = p.scope
    while s != null {
        found addr = map_get(&s.ordinary, name) catch {
            s = s.parent
            continue
        }
        return handle_from_addr(found)
    }
    return null
}

fn pa_tag_lookup(p handle[Parser], name u32, local bool) u32 {
    s handle[Scope] = p.scope
    while s != null {
        ty u32 = map_get(&s.tags, name) catch {
            if local { return TY_INVALID }
            s = s.parent
            continue
        }
        return ty
    }
    return TY_INVALID
}

fn pa_typename(p handle[Parser], t Token) bool {
    if t.kind != TK_IDENT { return false }
    s handle[Symbol] = pa_lookup(p, cc_ident(p.names, t))
    return s != null && s.storage == SC_TYPEDEF
}

// Callers may run separate TUs concurrently. A nested callback that starts
// another parser on the same thread restores the outer type context.
fn parse_tu(p handle[Parser], pp handle[Pp]) void fails {
    p.pp = pp
    p.names = &pp.names
    p.x86_features = pp.x86_features
    previous handle[TypeCtx] = tc
    defer { tc = previous }
    tc_init(&p.types)
    tc.unsigned_char = pp.unsigned_char
    tc.ilp32 = pp.ilp32
    pa_enter(p)
    p.file_scope = p.scope
    try pa_builtin_types(p)
    while (try pa_peek(p)).kind != TK_EOF {
        item handle[Ast] = try pa_declaration(p, true, null)
        if item != null && item.kind == ND_ASM && p.on_object != null {
            try call_addr[fails](p.on_object, handle_addr(p), handle_addr(item), p.user)
        }
    }
    try se_finish_weak_aliases(p)
    for i usize in 0..p.objects.n {
        obj handle[Symbol] = handle_from_addr(p.objects.p[addr, i])
        func bool = ty_is_func(obj.ty)
        if !func { try se_finish_object(p, obj) }
        // Alias and IFUNC declarations define linker symbols without a body.
        // Ordinary functions use the streaming function callback instead.
        attr_def bool = pa_has_attr(p, obj.attrs, c"alias") || pa_has_attr(p, obj.attrs, c"ifunc")
        if p.on_object != null && (attr_def || !func && (obj.defined || obj.tentative)) {
            n handle[Ast] = pa_node(ND_DECL, obj.loc, obj.ty)
            n.decl = obj
            n.a = handle_from_addr(obj.value)
            n.attrs = obj.attrs
            try call_addr[fails](p.on_object, handle_addr(p), handle_addr(n), p.user)
        }
    }
}
