// fcc compile & link driver: subprocess runner, tool discovery (fas-fir, fas-ld),
// system glibc crt discovery, and gcc-compatible multi-file compile + link pipeline.


const SYS_FORK u64 = 57
const SYS_EXECVE u64 = 59
const SYS_WAIT4 u64 = 61
const SYS_DUP2 u64 = 33
const SYS_FCNTL u64 = 72
const SYS_KILL u64 = 62
const SYS_PIPE2 u64 = 293
const SYS_MEMFD_CREATE u64 = 319
const F_DUPFD u64 = 0
const O_TMPFILE u64 = 0x410000
const SYS_RT_SIGACTION u64 = 13
const F_DUPFD_CLOEXEC u64 = 1030
const SIGKILL u64 = 9
const SIGPIPE u64 = 13

// Linux x86-64 kernel sigaction, whose signal set is one 64-bit word.
struct DrvSignalAction { handler u64, flags u64, restorer u64, mask u64 }

// Start with the prior disposition in the child. The driver then ignores
// SIGPIPE so a failed backend is reported by wait4, with writes returning EPIPE.
fn drv_ignore_sigpipe(previous handle[DrvSignalAction]) void fails {
    action DrvSignalAction = {}
    action.handler = 1 // SIG_IGN
    _ i64 = try syscall[fails](SYS_RT_SIGACTION, SIGPIPE, &action, handle_addr(previous), 8)
}

fn drv_restore_sigpipe(previous handle[DrvSignalAction]) void {
    _ i64 = syscall(SYS_RT_SIGACTION, SIGPIPE, handle_addr(previous), 0, 8)
}

fn drv_cstr_dup(s Bytes) addr {
    p addr = heap_alloc(s.n + 1)
    if s.n > 0 { mem_copy(p, s.p, s.n) }
    p[u8, s.n] = 0
    return p
}

fn drv_join_path(dir Bytes, name addr) addr {
    b Buf = {}
    defer { buf_free(&b) }
    buf_append(&b, dir)
    if dir.n > 0 && dir.p[u8, dir.n - 1] != 47 { buf_u8(&b, 47) }
    buf_str(&b, name)
    return drv_cstr_dup(buf_bytes(&b))
}

fn drv_dirname(path Bytes) Bytes {
    i usize = path.n
    while i > 0 {
        i -= 1
        if path.p[u8, i] == 47 {
            return if i == 0 { bytes_c(c"/") } else { bytes_sub(path, 0, i) }
        }
    }
    return bytes_c(c".")
}

fn drv_basename(path Bytes) Bytes {
    i usize = path.n
    while i > 0 {
        i -= 1
        if path.p[u8, i] == 47 {
            return bytes_from(path, i + 1)
        }
    }
    return path
}

fn drv_replace_ext(path Bytes, new_ext addr) addr {
    base Bytes = drv_basename(path)
    dot usize = base.n
    i usize = base.n
    while i > 0 {
        i -= 1
        if base.p[u8, i] == 46 { dot = i; break }
    }
    b Buf = {}
    defer { buf_free(&b) }
    buf_append(&b, bytes_sub(base, 0, dot))
    buf_str(&b, new_ext)
    return drv_cstr_dup(buf_bytes(&b))
}

// Start a child process, optionally redirecting a close-on-exec fd to stdin.
fn drv_start(exe addr, args handle[Vec[addr]], input i32) i64 fails {
    // Build null-terminated argv
    n usize = args.n
    argv addr = heap_alloc((n + 2) * 8)
    argv[addr, 0] = exe
    for i usize in 0..n {
        argv[addr, i + 1] = vec_get(args, i)
    }
    argv[addr, n + 1] = null
    envp addr = os_argv + (os_argc + 1) * 8

    pid_r i64 = syscall(SYS_FORK)
    if pid_r < 0 {
        eprint(c"fcc: fork failed\n")
        fail CError
    }
    if pid_r == 0 {
        if input >= 0 && syscall(SYS_DUP2, input, STDIN) < 0 {
            eprint(c"fcc: cannot redirect backend stdin\n")
            os_exit(127)
        }
        _ i64 = syscall(SYS_EXECVE, addr_bits(exe), addr_bits(argv), addr_bits(envp))
        eprint(c"fcc: cannot execute ")
        eprint(exe)
        eprint(c"\n")
        os_exit(127)
    }
    return pid_r
}

// Wait for one child. Report exit status in the same form as a shell.
fn drv_wait(pid i64) i32 fails {
    status i32 = 0
    while true {
        wr i64 = syscall(SYS_WAIT4, bitcast[u64](pid), addr_bits(&status), 0, 0)
        if wr < 0 {
            if wr == -4 { continue } // EINTR
            eprint(c"fcc: wait4 failed\n")
            fail CError
        }
        break
    }
    if (status & 0x7f) != 0 {
        // Killed by signal
        return 128 + (status & 0x7f)
    }
    return (status >> 8) & 0xff
}

fn drv_run(exe addr, args handle[Vec[addr]]) i32 fails {
    return try drv_wait(try drv_start(exe, args, -1))
}

// Locate executable `name` via env var, relative to cwd, or relative to argv[0]
fn drv_find_tool(env_var addr, rel1 addr, rel2 addr, fallback addr) addr {
    ev addr = os_getenv(env_var)
    if ev != null && ev[u8] != 0 && os_exists(ev) { return ev }
    if rel1 != null && os_exists(rel1) { return rel1 }
    if rel2 != null && os_exists(rel2) { return rel2 }
    // Try relative to argv[0]'s directory (and its parent)
    if os_argc > 0 {
        self_p Bytes = bytes_c(os_arg(0))
        d1 Bytes = drv_dirname(self_p)
        if fallback != null {
            p1 addr = drv_join_path(d1, fallback)
            if os_exists(p1) { return p1 }
            d2 Bytes = drv_dirname(d1)
            p2 addr = drv_join_path(d2, rel1)
            if rel1 != null && os_exists(p2) { return p2 }
            p3 addr = drv_join_path(d2, fallback)
            if os_exists(p3) { return p3 }
        }
    }
    if fallback != null { return fallback }
    return rel1
}

fn drv_find_fas_fir() addr {
    return drv_find_tool(c"FCC_FIR", c"_build/default/tools/fas_fir/fas_fir.exe",
                         c"fas-fir", c"fas-fir")
}

fn drv_find_fas_ld() addr {
    return drv_find_tool(c"FCC_LD", c"_build/fas-ld",
                         c"fas-ld", c"fas-ld")
}

fn drv_find_gcc_dir() addr {
    dirs arr[6, addr] = {
        c"/usr/lib/gcc/x86_64-linux-gnu/15",
        c"/usr/lib/gcc/x86_64-linux-gnu/14",
        c"/usr/lib/gcc/x86_64-linux-gnu/13",
        c"/usr/lib/gcc/x86_64-linux-gnu/12",
        c"/usr/lib/gcc/x86_64-linux-gnu/11",
        c"/usr/lib/gcc/x86_64-linux-gnu/10"
    }
    for i usize in 0..6 {
        p addr = drv_join_path(bytes_c(dirs[i]), c"crtbeginS.o")
        if os_exists(p) { return dirs[i] }
    }
    return c"/usr/lib/gcc/x86_64-linux-gnu/15"
}

fn drv_find_crt_dir() addr {
    if os_exists(c"/lib/x86_64-linux-gnu/Scrt1.o") { return c"/lib/x86_64-linux-gnu" }
    if os_exists(c"/usr/lib/x86_64-linux-gnu/Scrt1.o") { return c"/usr/lib/x86_64-linux-gnu" }
    return c"/lib/x86_64-linux-gnu"
}

value struct DrvTempObject { fd i32, path addr }

// The assembler and linker open the same anonymous object by descriptor.
// TMPDIR can put large objects on disk. A memfd handles filesystems without
// O_TMPFILE. Both are reclaimed by the kernel even if fcc is interrupted.
fn drv_temp_object() DrvTempObject fails {
    dir addr = os_getenv(c"TMPDIR")
    if dir == null || dir[u8] == 0 { dir = c"/tmp" }
    raw i64 = syscall(SYS_OPENAT, AT_FDCWD, dir, O_TMPFILE | O_RDWR | O_CLOEXEC, 0o600)
    if raw == -95 || raw == -22 || raw == -21 {
        raw = syscall(SYS_MEMFD_CREATE, c"fcc-object", 1) // MFD_CLOEXEC
    }
    if raw < 0 {
        eprint(c"fcc: cannot create temporary object\n")
        fail CError
    }
    owned i32 = trunc[i32](raw)
    defer { os_close(owned) }
    // Keep the descriptor across exec without taking a standard stream.
    inherited i64 = syscall(SYS_FCNTL, owned, F_DUPFD, 3)
    if inherited < 0 {
        eprint(c"fcc: cannot pass temporary object to backend\n")
        fail CError
    }
    b Buf = {}
    defer { buf_free(&b) }
    buf_str(&b, c"/proc/self/fd/")
    buf_dec_u64(&b, bitcast[u64](inherited))
    return {trunc[i32](inherited), drv_cstr_dup(buf_bytes(&b))}
}

struct DrvCodegenOptions {
    pic u8
    debug bool
    no_red_zone bool
    kernel_model bool
    no_sse bool
    general_regs_only bool
    no_x87 bool // -mno-80387: fas-fir refuses x87 code (long double)
    no_unwind_tables bool
    thunk_calls bool
    thunk_local bool // with thunk_calls: -mretpoline, the object's own thunks
    thunk_cs_prefix bool
    return_thunk bool
    endbr bool
    patch_entry addr // -fpatchable-function-entry=N[,M], passed on as is
    stack_align8 bool // -mstack-alignment=8: stack aligned to 8 at entry
    stack_align4 bool // -mstack-alignment=4: i386 stack aligned to 4 at entry
    regparm u8
    i386 bool
    function_sections bool
}

fn drv_start_fir(fir_path addr, obj_path addr, options handle[DrvCodegenOptions], input i32) i64 fails {
    fir_exe addr = drv_find_fas_fir()
    args Vec[addr] = {}
    defer { vec_free(&args) }
    vec_push(&args, c"-c")
    vec_push(&args, c"--fold-branches")
    if options.debug { vec_push(&args, c"-g") }
    if options.no_unwind_tables { vec_push(&args, c"--no-unwind-tables") }
    if options.no_red_zone { vec_push(&args, c"-mno-red-zone") }
    if options.kernel_model { vec_push(&args, c"-mcmodel=kernel") }
    if options.thunk_calls {
        vec_push(&args, if options.thunk_local { c"-mretpoline" } else { c"-mretpoline-external-thunk" })
    }
    if options.thunk_cs_prefix { vec_push(&args, c"-mindirect-branch-cs-prefix") }
    if options.return_thunk { vec_push(&args, c"-mfunction-return=thunk-extern") }
    if options.endbr { vec_push(&args, c"-fcf-protection=branch") }
    if options.patch_entry != null { vec_push(&args, options.patch_entry) }
    if options.stack_align8 { vec_push(&args, c"-mstack-alignment=8") }
    if options.stack_align4 { vec_push(&args, c"-mstack-alignment=4") }
    if options.regparm == 1 { vec_push(&args, c"-mregparm=1") }
    if options.regparm == 2 { vec_push(&args, c"-mregparm=2") }
    if options.regparm == 3 { vec_push(&args, c"-mregparm=3") }
    if options.i386 && options.function_sections { vec_push(&args, c"-ffunction-sections") }
    if options.no_x87 { vec_push(&args, c"-mno-80387") }
    if options.general_regs_only { vec_push(&args, c"-mgeneral-regs-only") }
    else if options.no_sse { vec_push(&args, c"-mno-sse") }
    if options.pic == 1 { vec_push(&args, c"-fno-pic") }
    // The default Fir object model is position independent with initial-exec
    // TLS. A shared object instead needs general-dynamic TLS.
    else if options.pic == 2 || options.pic == 3 || (options.i386 && options.pic > 3) { vec_push(&args, c"-fPIC") }
    vec_push(&args, fir_path)
    vec_push(&args, c"-o")
    vec_push(&args, obj_path)
    return try drv_start(fir_exe, &args, input)
}

fn drv_finish_fir(pid i64) void fails {
    rc i32 = try drv_wait(pid)
    if rc != 0 {
        eprint(c"fcc: fas-fir failed\n")
        fail CError
    }
}

fn drv_assemble_fir(fir_path addr, obj_path addr, options handle[DrvCodegenOptions]) void fails {
    try drv_finish_fir(try drv_start_fir(fir_path, obj_path, options, -1))
}

value struct DrvFirPipe { pid i64, write_fd i32 }

fn drv_fir_pipe(obj_path addr, options handle[DrvCodegenOptions]) DrvFirPipe fails {
    fds arr[2, i32] = {}
    _ i64 = try syscall[fails](SYS_PIPE2, &fds, O_CLOEXEC)
    // A caller can close stdio. Keep private pipe ends clear of those slots
    // so frontend diagnostics cannot be written into the Fir stream.
    for i usize in 0..2 {
        if fds[i] >= 3 { continue }
        fd i64 = syscall[fails](SYS_FCNTL, fds[i], F_DUPFD_CLOEXEC, 3) catch e {
            os_close(fds[0])
            os_close(fds[1])
            fail e
        }
        os_close(fds[i])
        fds[i] = trunc[i32](fd)
    }
    defer { os_close(fds[0]) }
    pid i64 = drv_start_fir(c"-", obj_path, options, fds[0]) catch e {
        os_close(fds[1])
        fail e
    }
    return {pid, fds[1]}
}

fn drv_abort_fir(child DrvFirPipe) void {
    // Prevent emitting an object from an incomplete translation unit on EOF.
    _ i64 = syscall(SYS_KILL, child.pid, SIGKILL)
    os_close(child.write_fd)
    wait_status i32 = drv_wait(child.pid) catch 0
}

// Take the shared unwinder only when an input references it. Save the
// linker's dependency-selection state around the implicit library.
fn drv_dynamic_gcc(args handle[Vec[addr]]) void {
    vec_push(args, c"-lgcc")
    vec_push(args, c"--push-state")
    vec_push(args, c"--as-needed")
    vec_push(args, c"-lgcc_s")
    vec_push(args, c"--pop-state")
}

// Link inputs (objects, archives, shared libs) + linker args via fas-ld
fn drv_link(out_path addr, link_args handle[Vec[addr]],
            is_shared bool, is_static bool, is_no_pie bool, no_stdlib bool, relocatable bool) void fails {
    ld_exe addr = drv_find_fas_ld()
    crt_dir Bytes = bytes_c(drv_find_crt_dir())
    gcc_dir Bytes = bytes_c(drv_find_gcc_dir())

    args Vec[addr] = {}
    defer { vec_free(&args) }

    if relocatable {
        vec_push(&args, c"-r")
    } else if is_shared {
        vec_push(&args, c"-shared")
    } else if is_static {
        vec_push(&args, c"-static")
    } else if !is_no_pie {
        vec_push(&args, c"-pie")
    }

    if !is_static && !relocatable { vec_push(&args, c"--eh-frame-hdr") }

    if !is_static && !is_shared && !relocatable {
        vec_push(&args, c"--dynamic-linker")
        vec_push(&args, c"/lib64/ld-linux-x86-64.so.2")
    }

    vec_push(&args, c"-o")
    vec_push(&args, out_path)

    if !no_stdlib && !relocatable {
        if !is_shared {
            crt1 addr = if is_static || is_no_pie { c"crt1.o" } else { c"Scrt1.o" }
            vec_push(&args, drv_join_path(crt_dir, crt1))
        }
        vec_push(&args, drv_join_path(crt_dir, c"crti.o"))
        crtbegin addr = if is_static { c"crtbeginT.o" } else if is_no_pie && !is_shared { c"crtbegin.o" } else { c"crtbeginS.o" }
        vec_push(&args, drv_join_path(gcc_dir, crtbegin))
    }

    // Standard library search directories
    vec_push(&args, c"-L")
    vec_push(&args, drv_cstr_dup(gcc_dir))
    vec_push(&args, c"-L")
    vec_push(&args, drv_cstr_dup(crt_dir))
    vec_push(&args, c"-L")
    vec_push(&args, c"/usr/lib/x86_64-linux-gnu")
    vec_push(&args, c"-L")
    vec_push(&args, c"/lib/x86_64-linux-gnu")

    // User object/archive inputs and -L / -l / -Wl args (in order!)
    for i usize in 0..link_args.n {
        vec_push(&args, vec_get(link_args, i))
    }

    if !no_stdlib && !relocatable {
        if is_static {
            vec_push(&args, c"--start-group")
            vec_push(&args, c"-lgcc")
            vec_push(&args, c"-lgcc_eh")
            vec_push(&args, c"-lc")
            vec_push(&args, c"--end-group")
        } else {
            drv_dynamic_gcc(&args)
            vec_push(&args, c"-lc")
            drv_dynamic_gcc(&args)
        }
        crtend addr = if is_static || (is_no_pie && !is_shared) { c"crtend.o" } else { c"crtendS.o" }
        vec_push(&args, drv_join_path(gcc_dir, crtend))
        vec_push(&args, drv_join_path(crt_dir, c"crtn.o"))
    }

    rc i32 = try drv_run(ld_exe, &args)
    if rc != 0 {
        eprint(c"fcc: link failed\n")
        fail CError
    }
}
