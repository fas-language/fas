// cc2/builtin.fas: Preprocessor builtin macros and __has_* query operators.
// Dispatched by pre-interned SymId switch (zero string compares on hot path).

fn pp_destringize(s Bytes, out handle[Buf]) void {
    i usize = literal_prefix(s.p) + 1
    while i + 1 < s.n {
        c u8 = s.p[u8, i]
        if c == 92 && i + 2 < s.n && (s.p[u8, i + 1] == 92 || s.p[u8, i + 1] == 34) {
            i += 1
            c = s.p[u8, i]
        }
        buf_u8(out, c)
        i += 1
    }
}

fn pp_number(ctx handle[CcCtx], t Token, count u64) Token {
    b Buf = {}
    defer { buf_free(&b) }
    buf_dec_u64(&b, count)
    id u32 = sm_add_synth(&ctx.sm, buf_bytes(&b))
    return tok_make(TK_NUM, (t.flags & ~F_SYNTH) | F_SYNTH, 0xFFFF, t.loc, id)
}

fn builtin_map_prefix(p handle[Pp], path Bytes, out handle[Buf]) bool {
    if p.prefix_maps == null { return false }
    best usize = p.prefix_maps.n
    i usize = 0
    while i + 1 < p.prefix_maps.n {
        old Bytes = vec_get(p.prefix_maps, i)
        if bytes_starts_with(path, old) &&
            (best == p.prefix_maps.n || bytes_cmp(old, vec_get(p.prefix_maps, best)) > 0) {
            best = i
        }
        i += 2
    }
    if best == p.prefix_maps.n { return false }
    buf_append(out, vec_get(p.prefix_maps, best + 1))
    buf_append(out, bytes_from(path, vec_get(p.prefix_maps, best).n))
    return true
}

fn pp_quote(b handle[Buf], s Bytes) void {
    buf_u8(b, 34)
    for i usize in 0..s.n {
        c u8 = s.p[u8, i]
        if c == 34 || c == 92 { buf_u8(b, 92) }
        buf_u8(b, c)
    }
    buf_u8(b, 34)
}

fn builtin_two(b handle[Buf], v u64, pad u8) void {
    if v < 10 { buf_u8(b, pad) }
    buf_dec_u64(b, v)
}

fn builtin_hms(b handle[Buf], seconds u64) void {
    builtin_two(b, (seconds / 3600) % 24, 48)
    buf_u8(b, 58)
    builtin_two(b, (seconds / 60) % 60, 48)
    buf_u8(b, 58)
    builtin_two(b, seconds % 60, 48)
}

fn builtin_file_time(p handle[Pp]) u64 {
    if p.timestamp_explicit || p.frames.n == 0 { return p.timestamp }
    f handle[Frame] = vec_at[Frame](&p.frames, p.frames.n - 1)
    b Buf = {}
    defer { buf_free(&b) }
    buf_append(&b, sym_name(&p.ctx.syms, f.physical))
    st Stat = {}
    os_stat(buf_cstr(&b), &st, true) catch { return p.timestamp }
    if st.mtime_sec < 0 { return p.timestamp }
    return bitcast[u64](st.mtime_sec)
}

fn builtin_timestamp(p handle[Pp], b handle[Buf], date bool, full bool) void {
    s u64 = if full { builtin_file_time(p) } else { p.timestamp }
    buf_u8(b, 34)
    if date || full {
        day u64 = s / 86400 + 719468
        era u64 = day / 146097
        doe u64 = day % 146097
        yoe u64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
        doy u64 = doe - (365 * yoe + yoe / 4 - yoe / 100)
        mp u64 = (5 * doy + 2) / 153
        d u64 = doy - (153 * mp + 2) / 5 + 1
        month u64 = if mp < 10 { mp + 2 } else { mp - 10 }
        year u64 = yoe + era * 400
        if month < 2 { year += 1 }
        if full {
            buf_raw(b, c"SunMonTueWedThuFriSat" + ((s / 86400 + 4) % 7) * 3, 3)
            buf_u8(b, 32)
        }
        buf_raw(b, c"JanFebMarAprMayJunJulAugSepOctNovDec" + (month * 3), 3)
        buf_u8(b, 32)
        builtin_two(b, d, 32)
        buf_u8(b, 32)
        if full {
            builtin_hms(b, s)
            buf_u8(b, 32)
        }
        buf_dec_u64(b, year)
    } else {
        builtin_hms(b, s)
    }
    buf_u8(b, 34)
}

fn builtin_defined(p handle[Pp], e handle[Expand], t Token) Token fails {
    ctx handle[CcCtx] = &p.ctx
    a Token = try expand_raw(p, e)
    paren bool = a.kind == TK_LPAREN
    if paren { a = try expand_raw(p, e) }
    if a.kind != TK_IDENT { try cc_error(ctx, t.loc, c"'defined' requires a macro name") }
    if paren {
        stop Token = try expand_raw(p, e)
        if stop.kind != TK_RPAREN { try cc_error(ctx, t.loc, c"missing ')' after defined") }
    }
    return pp_number(ctx, t, if sym_is_defined(&ctx.syms, cc_ident(ctx, a)) { 1 } else { 0 })
}

fn builtin_args(p handle[Pp], e handle[Expand], t Token, args handle[Vec[Token]]) void fails {
    ctx handle[CcCtx] = &p.ctx
    opening Token = try expand_raw(p, e)
    while opening.kind == TK_NL { opening = try expand_raw(p, e) }
    if opening.kind != TK_LPAREN { try cc_error(ctx, t.loc, c"expected '(' after preprocessing operator") }
    depth usize = 0
    while true {
        a Token = try expand_raw(p, e)
        if a.kind == TK_EOF { try cc_error(ctx, t.loc, c"unterminated preprocessing operator") }
        if a.kind == TK_NL { continue }
        if a.kind == TK_LPAREN { depth += 1 }
        if a.kind == TK_RPAREN {
            if depth == 0 { return }
            depth -= 1
        }
        vec_push[Token](args, a)
    }
}

fn builtin_test(p handle[Pp], e handle[Expand], t Token, sym_id u32) Token fails {
    ctx handle[CcCtx] = &p.ctx
    args Vec[Token] = {}
    defer { vec_free[Token](&args) }
    try builtin_args(p, e, t, &args)
    expanded Vec[Token] = {}
    defer { vec_free[Token](&expanded) }
    header bool = sym_id == SYM___HAS_INCLUDE || sym_id == SYM___HAS_INCLUDE_NEXT || sym_id == SYM___HAS_EMBED
    if header && args.n != 0 && args.p[Token].kind == TK_LT {
        i usize = 0
        while i < args.n {
            a Token = args.p[Token, i]
            vec_push[Token](&expanded, a)
            i += 1
            if a.kind == TK_GT { break }
        }
        try expand_list(p, args.p + i * sizeof[Token], args.n - i, &expanded, false)
    } else {
        try expand_list(p, args.p, args.n, &expanded, false)
    }
    value u64 = 0
    if header {
        h Header = {}
        defer { buf_free(&h.owned) }
        try pp_header(p, &expanded, t.loc, &h)
        found Found = pp_find(p, h.name, h.quote, sym_id == SYM___HAS_INCLUDE_NEXT)
        if sym_id == SYM___HAS_EMBED {
            spec Embed = {}
            spec.limit = ~0
            if try embed_spec(p, &expanded, h.used, t.loc, &spec, true) {
                if found.file != null {
                    sf handle[SourceFile] = handle_from_addr(found.file)
                    value = if sf.raw_len == 0 || spec.limit == 0 { 2 } else { 1 }
                }
            }
        } else {
            if h.used != expanded.n { try cc_error(ctx, t.loc, c"extra tokens after header name") }
            if found.file != null { value = 1 }
        }
    } else if expanded.n != 0 {
        a Token = expanded.p[Token]
        name Bytes = tok_spelling(ctx, a)
        if sym_id == SYM___HAS_C_ATTRIBUTE {
            scope Bytes = bytes_empty()
            if expanded.n == 3 && expanded.p[Token, 1].kind == TK_DCOLON {
                scope = name
                name = tok_spelling(ctx, expanded.p[Token, 2])
            }
            value = feature_c_attr(name, scope)
        } else if sym_id == SYM___HAS_ATTRIBUTE {
            value = if feature_in(C_ATTRIBUTES, feature_attr(name)) { 1 } else { 0 }
        } else if sym_id == SYM___HAS_BUILTIN {
            value = if feature_in(C_BUILTINS, name) { 1 } else { 0 }
            required addr = x86_intrinsic_feature(name)
            if required != null { value = if x86_has(p.x86_features, bytes_c(required)) { 1 } else { 0 } }
            if !p.no_library_builtins && feature_in(C_LIBRARY_BUILTINS, name) {
                value = 1
                for i usize in 0..(if p.disabled_builtins == null { 0 } else { p.disabled_builtins.n }) {
                    if bytes_eq(name, vec_get(p.disabled_builtins, i)) { value = 0; break }
                }
            }
        } else if sym_id == SYM___HAS_FEATURE || sym_id == SYM___HAS_EXTENSION {
            value = if feature_in(C_FEATURES, feature_attr(name)) { 1 } else { 0 }
        } else if sym_id == SYM___IS_IDENTIFIER {
            value = if a.kind == TK_IDENT && !feature_in(c" alignas alignof auto bool char const constexpr double enum extern false float int long nullptr register restrict short signed sizeof static struct thread_local true typedef typeof typeof_unqual union unsigned void volatile _Atomic _BitInt ", name) { 1 } else { 0 }
        }
    }
    if value >= 100000 && sym_id == SYM___HAS_C_ATTRIBUTE {
        b Buf = {}
        defer { buf_free(&b) }
        buf_dec_u64(&b, value)
        buf_u8(&b, 76)
        id u32 = sm_add_synth(&ctx.sm, buf_bytes(&b))
        return tok_make(TK_NUM, t.flags | F_SYNTH, 0xFFFF, t.loc, id)
    }
    return pp_number(ctx, t, value)
}

fn builtin_expand(p handle[Pp], e handle[Expand], t Token, sym_id u32) Token fails {
    ctx handle[CcCtx] = &p.ctx
    if sym_id >= SYM___HAS_INCLUDE && sym_id <= SYM___IS_IDENTIFIER {
        return try builtin_test(p, e, t, sym_id)
    }
    if sym_id == SYM__PRAGMA {
        args Vec[Token] = {}
        defer { vec_free[Token](&args) }
        try builtin_args(p, e, t, &args)
        expanded Vec[Token] = {}
        defer { vec_free[Token](&expanded) }
        try expand_list(p, args.p, args.n, &expanded, false)
        if expanded.n != 1 || expanded.p[Token].kind != TK_STR {
            try cc_error(ctx, t.loc, c"_Pragma requires one string literal")
        }
        destr Buf = {}
        defer { buf_free(&destr) }
        pp_destringize(tok_spelling(ctx, expanded.p[Token]), &destr)
        contents Vec[Token] = {}
        defer { vec_free[Token](&contents) }
        try pragma_tokens(p, buf_bytes(&destr), t.loc, &contents)
        pragma Token = try pp_pragma(p, &contents, t.loc)
        if pragma.kind == TK_PLACE { return try expand_next(p, e) }
        return pragma
    }
    if sym_id == SYM___COUNTER__ {
        k u64 = p.counter
        p.counter += 1
        return pp_number(ctx, t, k)
    }
    pos ResolvedLoc = sm_resolve(&ctx.sm, t.loc)
    if sym_id == SYM___LINE__ { return pp_number(ctx, t, zext[u64](pos.line)) }
    if sym_id == SYM___INCLUDE_LEVEL__ { return pp_number(ctx, t, zext[u64](pos.level)) }
    b Buf = {}
    defer { buf_free(&b) }
    if sym_id == SYM___DATE__ || sym_id == SYM___TIME__ || sym_id == SYM___TIMESTAMP__ {
        builtin_timestamp(p, &b, sym_id == SYM___DATE__, sym_id == SYM___TIMESTAMP__)
    } else {
        f u32 = if sym_id == SYM___BASE_FILE__ { p.base_logical } else { pos.file }
        path Bytes = sym_name(&ctx.syms, f)
        mapped Buf = {}
        defer { buf_free(&mapped) }
        if sym_id == SYM___FILE_NAME__ { path = path_basename(path) }
        else if builtin_map_prefix(p, path, &mapped) { path = buf_bytes(&mapped) }
        pp_quote(&b, path)
    }
    id u32 = sm_add_synth(&ctx.sm, buf_bytes(&b))
    return tok_make(TK_STR, t.flags | F_SYNTH, 0xFFFF, t.loc, id)
}
