// Preprocessing arithmetic uses only the two intmax_t representations. Bits
// are unsigned so wraparound and the conversion to uintmax_t are explicit.
value struct PpInt { bits u64, uns bool }
struct Expr { tokens Vec[Token], at usize, loc u32, warn_undef u8 }

fn expr_peek(x handle[Expr]) Token {
    if x.at < x.tokens.n { return x.tokens.p[Token, x.at] }
    return cc_token(TK_EOF, 0, x.loc, 0)
}

fn expr_accept(n handle[CNames], x handle[Expr], spelling addr) bool {
    t Token = expr_peek(x)
    if t.kind != TK_EOF && cc_is(n, t, spelling) { x.at += 1; return true }
    return false
}

fn expr_integer(n handle[CNames], t Token) PpInt fails {
    s Bytes = cc_spelling(n, t)
    i usize = 0
    radix u64 = 10
    if s.p[u8] == 48 && s.n > 1 {
        b u8 = s.p[u8, 1] | 32
        radix = 8
        if b == 120 || b == 98 {
            radix = if b == 120 { 16 } else { 2 }
            i = 2
        }
    }
    start usize = i
    value u64 = 0
    while i < s.n {
        ch u8 = s.p[u8, i]
        if ch == 39 && i > start && i + 1 < s.n && zext[u64](cc_hex(s.p[u8, i + 1])) < radix { i += 1; continue }
        d u64 = zext[u64](cc_hex(ch))
        if d >= radix { break }
        if value > (~0 - d) / radix { try cc_error(n, t.loc, c"integer literal too large in preprocessor expression") }
        value = value * radix + d
        i += 1
    }
    if i == start { try cc_error(n, t.loc, c"invalid integer literal in preprocessor expression") }
    uns bool = false
    rank bool = false
    while i < s.n {
        ch u8 = s.p[u8, i]
        c u8 = ch | 32
        if c == 117 && !uns {
            uns = true
        } else if c == 108 && !rank {
            rank = true
            if i + 1 < s.n && s.p[u8, i + 1] == ch { i += 1 }
        } else if c == 119 && !rank && i + 1 < s.n &&
            ((ch == 119 && s.p[u8, i + 1] == 98) || (ch == 87 && s.p[u8, i + 1] == 66)) {
            rank = true
            i += 1
        } else {
            try cc_error(n, t.loc, c"invalid integer suffix in preprocessor expression")
        }
        i += 1
    }
    return {value, uns || (value >> 63) != 0}
}

value struct Escape { cp u32, width usize }
fn expr_escape(n handle[CNames], s Bytes, loc u32) Escape fails {
    ch u8 = s.p[u8]
    if n.gnu && s.n >= 3 && s.p[u8, 1] == 123 && (ch == 117 || ch == 120 || ch == 111) {
        // In GNU mode accept the delimited forms also recognized by the
        // reference preprocessors. A numeric escape is a code unit, while
        // a universal character name must be a Unicode scalar value.
        radix u32 = if ch == 111 { 8 } else { 16 }
        cp u32 = 0
        i usize = 2
        while i < s.n && s.p[u8, i] != 125 {
            d u32 = cc_hex(s.p[u8, i])
            if d >= radix || cp > (0xffffffff - d) / radix {
                try cc_error(n, loc, c"invalid digit or value in delimited escape sequence")
            }
            cp = cp * radix + d
            i += 1
        }
        if i == 2 || i == s.n { try cc_error(n, loc, c"empty or unterminated delimited escape sequence") }
        if ch == 117 && !cc_scalar(cp) {
            try cc_error(n, loc, c"invalid universal character name")
        }
        return {cp, i + 1}
    }
    if ch == 117 || ch == 85 {
        r Rune = cc_ucn(s.p - 1)
        if r.width == 0 || !cc_scalar(r.cp) { try cc_error(n, loc, c"invalid universal character name") }
        return {r.cp, zext[usize](r.width) - 1}
    }
    if ch == 120 || (ch >= 48 && ch <= 55) {
        radix u32 = if ch == 120 { 16 } else { 8 }
        i usize = if ch == 120 { 1 } else { 0 }
        start usize = i
        max usize = if ch == 120 || s.n < 3 { s.n } else { 3 }
        cp u32 = 0
        while i < max {
            d u32 = cc_hex(s.p[u8, i])
            if d >= radix { break }
            cp = cp * radix + d
            i += 1
        }
        if i == start { try cc_error(n, loc, c"expected digit in escape sequence") }
        return {cp, i}
    }
    c u32 = zext[u32](ch)
    if ch == 97 { c = 7 }
    else if ch == 98 { c = 8 }
    else if (ch | 32) == 101 && n.gnu { c = 27 }
    else if ch == 102 { c = 12 }
    else if ch == 110 { c = 10 }
    else if ch == 114 { c = 13 }
    else if ch == 116 { c = 9 }
    else if ch == 118 { c = 11 }
    return {c, 1}
}

fn expr_char(n handle[CNames], t Token) PpInt fails {
    s Bytes = cc_spelling(n, t)
    first usize = literal_prefix(s.p)
    short_wide bool = n.short_wchar && s.p[u8] == 76
    i usize = first + 1
    count usize = 0
    value u32 = 0
    while i + 1 < s.n {
        c u8 = s.p[u8, i]
        cp u32 = zext[u32](c)
        i += 1
        if c == 92 {
            escape Escape = try expr_escape(n, bytes_from(s, i), t.loc)
            cp = escape.cp
            i += escape.width
        } else if c >= 128 {
            r Rune = utf8(s.p + i - 1)
            if r.width == 0 { try cc_error(n, t.loc, c"invalid UTF-8 in character constant") }
            cp = r.cp
            i += zext[usize](r.width) - 1
        }
        if first != 0 {
            if count != 0 || (first == 2 && cp > 255) ||
                ((short_wide || (s.p[u8] == 117 && first == 1)) && cp > 65535) {
                try cc_error(n, t.loc, c"invalid prefixed character constant")
            }
            value = cp
        } else {
            if cp > 255 { try cc_error(n, t.loc, c"character too large for character constant") }
            value = (value << 8) | cp
        }
        count += 1
    }
    if count == 0 { try cc_error(n, t.loc, c"empty character constant") }
    if first == 0 && count == 1 && value >= 128 { value |= 0xffffff00 }
    if first == 0 || s.p[u8] == 76 {
        // Both int and unsigned short wchar_t promote to signed int in #if.
        return {bitcast[u64](sext[i64](bitcast[i32](value))), false}
    }
    return {zext[u64](value), true}
}

fn expr_prefix(n handle[CNames], x handle[Expr], live bool) PpInt fails {
    t Token = expr_peek(x)
    if expr_accept(n, x, c"(") {
        a PpInt = try expr_parse(n, x, 1, live)
        if !expr_accept(n, x, c")") { try cc_error(n, expr_peek(x).loc, c"expected ')'") }
        return a
    }
    if t.kind == TK_EOF { try cc_error(n, t.loc, c"expected expression") }
    x.at += 1
    if t.kind == TK_PUNCT {
        neg bool = cc_is(n, t, c"-")
        plus bool = cc_is(n, t, c"+")
        logical bool = cc_is(n, t, c"!")
        complement bool = cc_is(n, t, c"~")
        if neg || plus || logical || complement {
            a PpInt = try expr_prefix(n, x, live)
            if neg { a.bits = 0 - a.bits }
            if complement { a.bits = ~a.bits }
            if logical { return {if a.bits == 0 { 1 } else { 0 }, false} }
            return a
        }
    }
    if t.kind == TK_NUM { return try expr_integer(n, t) }
    if t.kind == TK_CHAR { return try expr_char(n, t) }
    if t.kind == TK_IDENT {
        if cc_is(n, t, c"true") { return {1, false} }
        if live && !cc_is(n, t, c"false") {
            try cc_warning(n, t.loc, x.warn_undef, c"undefined macro evaluates to zero")
        }
        return {0, false}
    }
    try cc_error(n, t.loc, c"invalid token in preprocessor expression")
    return {0, false}
}

fn expr_prec(n handle[CNames], t Token) u8 {
    if t.kind != TK_PUNCT { return 0 }
    if cc_is(n, t, c",") { return 1 }
    if cc_is(n, t, c"?") { return 2 }
    if cc_is(n, t, c"||") { return 3 }
    if cc_is(n, t, c"&&") { return 4 }
    if cc_is(n, t, c"|") { return 5 }
    if cc_is(n, t, c"^") { return 6 }
    if cc_is(n, t, c"&") { return 7 }
    if cc_is(n, t, c"==") || cc_is(n, t, c"!=") { return 8 }
    if cc_is(n, t, c"<") || cc_is(n, t, c">") || cc_is(n, t, c"<=") || cc_is(n, t, c">=") { return 9 }
    if cc_is(n, t, c"<<") || cc_is(n, t, c">>") { return 10 }
    if cc_is(n, t, c"+") || cc_is(n, t, c"-") { return 11 }
    if cc_is(n, t, c"*") || cc_is(n, t, c"/") || cc_is(n, t, c"%") { return 12 }
    return 0
}

fn expr_binary(n handle[CNames], t Token, a PpInt, b PpInt, prec u8, live bool) PpInt fails {
    signless bool = a.uns || b.uns
    x u64 = a.bits
    y u64 = b.bits
    sx i64 = bitcast[i64](x)
    sy i64 = bitcast[i64](y)
    if prec == 1 { return b }
    if prec == 3 { return {if x != 0 || y != 0 { 1 } else { 0 }, false} }
    if prec == 4 { return {if x != 0 && y != 0 { 1 } else { 0 }, false} }
    if prec == 5 { return {x | y, signless} }
    if prec == 6 { return {x ^ y, signless} }
    if prec == 7 { return {x & y, signless} }
    if prec == 8 { return {if (x == y) == cc_is(n, t, c"==") { 1 } else { 0 }, false} }
    if prec == 9 {
        less bool = if signless { x < y } else { sx < sy }
        gt bool = if signless { x > y } else { sx > sy }
        yes bool = if cc_is(n, t, c"<") { less } else if cc_is(n, t, c">") { gt }
            else if cc_is(n, t, c"<=") { !gt } else { !less }
        return {if yes { 1 } else { 0 }, false}
    }
    if prec == 10 {
        shift u64 = y & 63
        if cc_is(n, t, c"<<") { return {x << shift, a.uns} }
        return {if a.uns { x >> shift } else { bitcast[u64](sx >> shift) }, a.uns}
    }
    if prec == 11 { return {if cc_is(n, t, c"+") { x + y } else { x - y }, signless} }
    if cc_is(n, t, c"*") { return {x * y, signless} }
    if y == 0 {
        if live { try cc_error(n, t.loc, c"division by zero in preprocessor expression") }
        return {0, signless}
    }
    quot bool = cc_is(n, t, c"/")
    if signless { return {if quot { x / y } else { x % y }, true} }
    if x == 0x8000000000000000 && sy == -1 { return {if quot { x } else { 0 }, false} }
    return {bitcast[u64](if quot { sx / sy } else { sx % sy }), false}
}

fn expr_parse(n handle[CNames], x handle[Expr], min u8, live bool) PpInt fails {
    a PpInt = try expr_prefix(n, x, live)
    while true {
        t Token = expr_peek(x)
        prec u8 = expr_prec(n, t)
        if prec < min { return a }
        x.at += 1
        if prec == 2 {
            b PpInt = try expr_parse(n, x, 1, live && a.bits != 0)
            if !expr_accept(n, x, c":") { try cc_error(n, expr_peek(x).loc, c"expected ':'") }
            c PpInt = try expr_parse(n, x, prec, live && a.bits == 0)
            a = {if a.bits != 0 { b.bits } else { c.bits }, b.uns || c.uns}
        } else {
            next bool = live && !(prec == 3 && a.bits != 0) && !(prec == 4 && a.bits == 0)
            b PpInt = try expr_parse(n, x, prec + 1, next)
            a = try expr_binary(n, t, a, b, prec, live)
        }
    }
}

fn pp_int(p handle[Pp], args handle[Vec[Token]], loc u32) PpInt fails {
    x Expr = {}
    x.loc = loc
    x.warn_undef = p.warning_modes.undef
    copy_into[Vec[Token]](&x.tokens, args)
    a PpInt = try expr_parse(&p.names, &x, 1, true)
    if x.at != x.tokens.n { try cc_error(&p.names, expr_peek(&x).loc, c"extra tokens in preprocessor expression") }
    return a
}

fn pp_eval(p handle[Pp], args handle[Vec[Token]], loc u32) PpInt fails {
    expanded Vec[Token] = {}
    try expand_list(p, args.p, args.n, &expanded, true)
    return try pp_int(p, &expanded, loc)
}
