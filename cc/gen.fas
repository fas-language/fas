// C23 -> Fir 0.3 code generator: core context, block-based function builder,
// Fir instruction emitters, symbol/attribute helpers, and TU streaming callbacks.

use "../lib/core.fas"
use "../lib/mem.fas"
use "../lib/vec.fas"
use "../lib/buf.fas"
use "../lib/bytes.fas"
use "../lib/table.fas"
use "../lib/intern.fas"
use "../lib/os.fas"
use "types.fas"
use "layout.fas"
use "abi.fas"
use "fir_out.fas"
use "parse.fas"

// ---------- Hash helpers for pointer/u64 tables ----------

struct U64Key { v u64 }

fn gen_u64_hash(k handle[U64Key]) u64 {
    x u64 = k.v
    x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9
    x = (x ^ (x >> 27)) * 0x94d049bb133111eb
    return x ^ (x >> 31)
}

fn gen_u64_eq(a handle[U64Key], b handle[U64Key]) bool {
    return a.v == b.v
}

// ---------- Per-function CFG block ----------

struct GenBlock {
    id u32
    code Buf
    term Buf
    succs Vec[u32]
    terminated bool
    pinned bool
    _pad u16
}

struct LoopFrame {
    break_blk u32
    continue_blk u32
    cleanup_depth usize
    vla_depth usize
    is_switch bool
    _pad u8
    _pad2 u16
}

struct CleanupItem {
    ptr_v u32
    scope_depth u32
    fn_sym handle[Symbol]
}

struct VlaScope {
    sp_v u32
    scope_depth u32
}

struct ExternFnRef {
    name_id u32
    _pad u32
    decl_line addr
}

struct ExternObjRef {
    name_id u32
    size u64
    align u64
    linkage u8
    tls bool
    _pad u16
}

struct TentativeRef {
    name_id u32
    size u64
    align u64
    linkage u8
    vis u8
    tls bool
    _pad u8
    section addr
}

struct BlockAddrPatch {
    blk_id u32        // GenBlock id containing the placeholder (or 0xffffffff if in gc.deferred)
    off usize         // byte offset in blk.code (or gc.deferred) where placeholder digits live
    target_blk u32    // target GenBlock id
}

struct GnuInlineDef {
    code Buf
    ext_fns Vec[ExternFnRef]
    ext_objs Vec[ExternObjRef]
}

struct GlobalBlockAddr {
    fn_sym handle[Symbol]
    target_lbl handle[Label]
}

// ---------- Main codegen context ----------

struct GenCtx {
    p handle[Parser]
    out FirOut
    deferred Buf
    sym_names Intern

    defined Table[U64Key, u8, gen_u64_hash, gen_u64_eq]
    ext_fn_seen Table[U64Key, u8, gen_u64_hash, gen_u64_eq]
    ext_obj_seen Table[U64Key, u8, gen_u64_hash, gen_u64_eq]
    ext_fns Vec[ExternFnRef]
    ext_objs Vec[ExternObjRef]

    // Maps Symbol addr -> interned Fir symbol name (in sym_names) for static locals
    static_locals Table[U64Key, u32, gen_u64_hash, gen_u64_eq]
    // Pending tentative definitions emitted at TU end if not defined
    tentatives Vec[TentativeRef]

    // Buffered `extern inline __attribute__((gnu_inline))` definitions emitted only if referenced
    gnu_inlines Vec[GnuInlineDef]
    gnu_inline_map Table[U64Key, u32, gen_u64_hash, gen_u64_eq] // sym_name_id -> 1-based idx
    cur_gnu_inline_idx u32

    // String literal deduplication pool (keyed by Intern id of align_byte + data)
    str_pool_keys Intern
    str_pool_nids Table[U64Key, u32, gen_u64_hash, gen_u64_eq]

    str_counter u32
    tmp_counter u32
    ctor_counter u32
    had_error bool
    has_alloca bool
    _pad1 u16

    // Per-function state
    in_func bool
    _pad2 u8
    _pad3 u16
    cur_fn handle[Symbol]
    cur_fn_name u32
    cur_ret_ty u32
    next_ssa u32
    cur_blk u32
    scope_depth u32
    blocks Vec[GenBlock]
    locals Table[U64Key, u32, gen_u64_hash, gen_u64_eq]      // Symbol addr -> entry alloca %vN
    vla_ptrs Table[U64Key, u32, gen_u64_hash, gen_u64_eq]    // VLA Symbol addr -> alloca holding ptr
    vla_sizes Table[U64Key, u32, gen_u64_hash, gen_u64_eq]   // TypeId -> alloca holding u64 byte size
    labels Table[U64Key, u32, gen_u64_hash, gen_u64_eq]      // Label addr -> GenBlock id
    addr_taken_labels Vec[u32]
    ba_patches Vec[BlockAddrPatch]
    loops Vec[LoopFrame]
    cleanups Vec[CleanupItem]
    vla_stack Vec[VlaScope]
}

thread var gc handle[GenCtx] = null

// ---------- Lifecycle ----------

fn gen_init(ctx handle[GenCtx], p handle[Parser], fd i32) void {
    mem_set(handle_addr(ctx), 0, sizeof[GenCtx])
    gc = ctx
    ctx.p = p
    if fd >= 0 { fir_init_fd(&ctx.out, fd) }
    else { fir_init_buf(&ctx.out) }
    _ u32 = intern(&ctx.sym_names, bytes_c(c""))
    fir_module_header(&ctx.out, c"x86_64-unknown-linux-gnu", false)
}

fn gen_free(ctx handle[GenCtx]) void {
    fir_free(&ctx.out)
    buf_free(&ctx.deferred)
    intern_free(&ctx.sym_names)
    table_free(&ctx.defined)
    table_free(&ctx.ext_fn_seen)
    table_free(&ctx.ext_obj_seen)
    vec_free(&ctx.ext_fns)
    vec_free(&ctx.ext_objs)
    table_free(&ctx.static_locals)
    vec_free(&ctx.tentatives)
    for i usize in 0..ctx.gnu_inlines.n {
        gi handle[GnuInlineDef] = vec_at(&ctx.gnu_inlines, i)
        buf_free(&gi.code)
        vec_free(&gi.ext_fns)
        vec_free(&gi.ext_objs)
    }
    vec_free(&ctx.gnu_inlines)
    table_free(&ctx.gnu_inline_map)
    intern_free(&ctx.str_pool_keys)
    table_free(&ctx.str_pool_nids)
    gen_reset_func_state(ctx)
    vec_free(&ctx.blocks)
    table_free(&ctx.locals)
    table_free(&ctx.vla_ptrs)
    table_free(&ctx.vla_sizes)
    table_free(&ctx.labels)
    vec_free(&ctx.addr_taken_labels)
    vec_free(&ctx.ba_patches)
    vec_free(&ctx.loops)
    vec_free(&ctx.cleanups)
    vec_free(&ctx.vla_stack)
    if gc == ctx { gc = null }
}

fn gen_reset_func_state(ctx handle[GenCtx]) void {
    for i usize in 0..ctx.blocks.n {
        b handle[GenBlock] = vec_at(&ctx.blocks, i)
        buf_free(&b.code)
        buf_free(&b.term)
        vec_free(&b.succs)
    }
    vec_clear(&ctx.blocks)
    table_free(&ctx.locals)
    table_free(&ctx.vla_ptrs)
    table_free(&ctx.vla_sizes)
    table_free(&ctx.labels)
    vec_clear(&ctx.addr_taken_labels)
    vec_clear(&ctx.ba_patches)
    vec_clear(&ctx.loops)
    vec_clear(&ctx.cleanups)
    vec_clear(&ctx.vla_stack)
    ctx.in_func = false
    ctx.has_alloca = false
    ctx.cur_fn = null
    ctx.cur_fn_name = 0
    ctx.cur_ret_ty = TY_VOID
    ctx.next_ssa = 0
    ctx.cur_blk = 0
    ctx.scope_depth = 0
}

// ---------- Symbol & Attribute Helpers ----------

fn gen_intern_sym(s Bytes) u32 {
    return intern(&gc.sym_names, s)
}

fn gen_sym_bytes(id u32) Bytes {
    return intern_name(&gc.sym_names, id)
}

fn gen_sym_fir_name_id(s handle[Symbol]) u32 {
    if s.asm_name != 0 {
        raw_nm Bytes = cc_name(gc.p.names, s.asm_name)
        start usize = 0
        end usize = raw_nm.n
        if end >= 2 && raw_nm.p[u8, 0] == 34 && raw_nm.p[u8, end - 1] == 34 {
            start = 1
            end -= 1
        }
        if end > start {
            return gen_intern_sym(bytes_sub(raw_nm, start, end - start))
        }
    }
    // Check if it is a static local already assigned a mangled name
    key U64Key = {addr_bits(handle_addr(s))}
    existing u32 = table_get(&gc.static_locals, &key) catch 0
    if existing != 0 { return existing }
    return gen_intern_sym(cc_name(gc.p.names, s.name))
}

fn gen_sym_fir_name(s handle[Symbol]) Bytes {
    return gen_sym_bytes(gen_sym_fir_name_id(s))
}

fn gen_make_static_local_name(s handle[Symbol]) u32 {
    key U64Key = {addr_bits(handle_addr(s))}
    existing u32 = table_get(&gc.static_locals, &key) catch 0
    if existing != 0 { return existing }
    b Buf = {}
    defer { buf_free(&b) }
    buf_str(&b, c".Lstatic.")
    if gc.cur_fn != null {
        buf_append(&b, gen_sym_bytes(gc.cur_fn_name))
        buf_u8(&b, 46)
    }
    buf_append(&b, cc_name(gc.p.names, s.name))
    buf_u8(&b, 46)
    buf_dec_u64(&b, zext[u64](gc.tmp_counter))
    gc.tmp_counter += 1
    id u32 = gen_intern_sym(buf_bytes(&b))
    _ bool = table_put(&gc.static_locals, &key, id)
    return id
}

fn gen_make_anon_name(prefix addr) u32 {
    b Buf = {}
    defer { buf_free(&b) }
    buf_str(&b, prefix)
    buf_dec_u64(&b, zext[u64](gc.tmp_counter))
    gc.tmp_counter += 1
    return gen_intern_sym(buf_bytes(&b))
}

fn gen_mark_defined(name_id u32) void {
    k U64Key = {zext[u64](name_id)}
    _ bool = table_put(&gc.defined, &k, 1)
}

fn gen_is_defined(name_id u32) bool {
    k U64Key = {zext[u64](name_id)}
    v u8 = table_get(&gc.defined, &k) catch 0
    return v != 0
}

// Attribute inspection on Symbol.attrs
fn gen_has_attr(attrs handle[Attr], name addr) bool {
    a handle[Attr] = attrs
    while a != null {
        if pa_attr_name(gc.p, a, name) { return true }
        a = a.next
    }
    return false
}

fn gen_attr_str_arg(attrs handle[Attr], name addr, out handle[Buf]) bool {
    a handle[Attr] = attrs
    while a != null {
        if pa_attr_name(gc.p, a, name) && a.args.n > 0 {
            t Token = a.args.p[Token]
            if t.kind == TK_STR {
                src Bytes = cc_name(gc.p.names, t.payload)
                // Strip surrounding quotes if present
                start usize = 0
                while start < src.n && src.p[u8, start] != 34 { start += 1 }
                if start < src.n { start += 1 }
                end usize = src.n
                if end > start && src.p[u8, end - 1] == 34 { end -= 1 }
                buf_append(out, bytes_sub(src, start, end - start))
                return true
            }
        }
        a = a.next
    }
    return false
}

fn gen_attr_int_arg(attrs handle[Attr], name addr, fallback u64) u64 {
    a handle[Attr] = attrs
    while a != null {
        if pa_attr_name(gc.p, a, name) {
            if a.args.n == 0 { return fallback }
            t Token = a.args.p[Token]
            if t.kind == TK_NUM {
                s Bytes = cc_name(gc.p.names, t.payload)
                return bytes_to_u64(s) catch fallback
            }
            return fallback
        }
        a = a.next
    }
    return 0
}

fn gen_sym_linkage(s handle[Symbol]) u8 {
    if gen_has_attr(s.attrs, c"weak") { return FIR_WEAK }
    if s.linkage == 1 || s.storage == SC_STATIC || s.storage == SC_CONSTEXPR { return FIR_LOCAL }
    return FIR_GLOBAL
}

fn gen_sym_visibility(s handle[Symbol]) u8 {
    b Buf = {}
    defer { buf_free(&b) }
    if gen_attr_str_arg(s.attrs, c"visibility", &b) {
        v Bytes = buf_bytes(&b)
        if bytes_eq_c(v, c"hidden") { return FIR_VIS_HIDDEN }
        if bytes_eq_c(v, c"protected") { return FIR_VIS_PROTECTED }
    }
    return FIR_VIS_DEFAULT
}

fn gen_is_returns_twice(s handle[Symbol]) bool {
    if s == null { return false }
    if gen_has_attr(s.attrs, c"returns_twice") { return true }
    nm Bytes = gen_sym_fir_name(s)
    return bytes_eq_c(nm, c"setjmp") || bytes_eq_c(nm, c"_setjmp") ||
           bytes_eq_c(nm, c"sigsetjmp") || bytes_eq_c(nm, c"__sigsetjmp") ||
           bytes_eq_c(nm, c"vfork") || bytes_eq_c(nm, c"getcontext")
}

fn gen_sym_needs_quote(s Bytes) bool {
    if s.n == 0 { return true }
    for i usize in 0..s.n {
        c u8 = s.p[u8, i]
        ok bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) ||
                  (c >= 48 && c <= 57) || c == 95 || c == 46 || c == 36
        if !ok { return true }
    }
    return false
}

fn gen_emit_sym_name(b handle[Buf], s Bytes) void {
    buf_u8(b, 64) // '@'
    if gen_sym_needs_quote(s) {
        fir_emit_quoted_bytes(b, s.p, s.n)
    } else {
        buf_append(b, s)
    }
}

fn gen_format_declare(name Bytes, fn_ty u32, linkage u8, is_noreturn bool) addr {
    fn_node handle[TypeNode] = ty_node(ty_unqual(fn_ty))
    if fn_node.kind != TYK_FUNC { return null }
    ret_ty u32 = fn_node.elem
    n_params u32 = fn_node.aux2
    is_var bool = (fn_node.flags & TYF_VARIADIC) != 0
    pstart usize = zext[usize](fn_node.aux1)
    params_ptr addr = if n_params > 0 { tc.fn_params.p + pstart * 4 } else { null }
    b Buf = {}
    defer { buf_free(&b) }
    buf_str(&b, c"declare ")
    gen_emit_sym_name(&b, name)
    buf_u8(&b, 32)
    abi_emit_fir_sig(&b, ret_ty, params_ptr, n_params, is_var)
    buf_u8(&b, 32)
    fir_emit_linkage(&b, linkage, FIR_VIS_DEFAULT)
    if is_noreturn { buf_str(&b, c" noreturn") }
    buf_u8(&b, 10)
    p addr = heap_alloc(b.n + 1)
    mem_copy(p, b.p, b.n)
    p[u8, b.n] = 0
    return p
}

fn gen_note_extern_fn(s handle[Symbol]) void {
    nid u32 = gen_sym_fir_name_id(s)
    if gen_sym_bytes(nid).n == 0 { return }
    if gen_is_defined(nid) { return }
    alias_buf Buf = {}
    if gen_attr_str_arg(s.attrs, c"alias", &alias_buf) {
        gen_mark_defined(nid)
        gen_emit_alias(gen_sym_bytes(nid), buf_bytes(&alias_buf), gen_sym_linkage(s), gen_sym_visibility(s))
        buf_free(&alias_buf)
        return
    }
    buf_free(&alias_buf)
    link u8 = if gen_has_attr(s.attrs, c"weak") { FIR_WEAK } else { FIR_GLOBAL }
    noret bool = gen_has_attr(s.attrs, c"noreturn") || gen_has_attr(s.attrs, c"_Noreturn")
    if gc.cur_gnu_inline_idx != 0 {
        gi handle[GnuInlineDef] = vec_at(&gc.gnu_inlines, zext[usize](gc.cur_gnu_inline_idx - 1))
        r handle[ExternFnRef] = vec_add(&gi.ext_fns)
        r.name_id = nid
        r.decl_line = gen_format_declare(gen_sym_bytes(nid), s.ty, link, noret)
        return
    }
    k U64Key = {zext[u64](nid)}
    seen u8 = table_get(&gc.ext_fn_seen, &k) catch 0
    if seen != 0 { return }
    _ bool = table_put(&gc.ext_fn_seen, &k, 1)
    r handle[ExternFnRef] = vec_add(&gc.ext_fns)
    r.name_id = nid
    r.decl_line = gen_format_declare(gen_sym_bytes(nid), s.ty, link, noret)
}

fn gen_note_extern_fn_raw(name Bytes, fn_ty u32) void {
    nid u32 = gen_intern_sym(name)
    if gen_is_defined(nid) { return }
    if gc.cur_gnu_inline_idx != 0 {
        gi handle[GnuInlineDef] = vec_at(&gc.gnu_inlines, zext[usize](gc.cur_gnu_inline_idx - 1))
        r handle[ExternFnRef] = vec_add(&gi.ext_fns)
        r.name_id = nid
        r.decl_line = gen_format_declare(name, fn_ty, FIR_GLOBAL, false)
        return
    }
    k U64Key = {zext[u64](nid)}
    seen u8 = table_get(&gc.ext_fn_seen, &k) catch 0
    if seen != 0 { return }
    _ bool = table_put(&gc.ext_fn_seen, &k, 1)
    r handle[ExternFnRef] = vec_add(&gc.ext_fns)
    r.name_id = nid
    r.decl_line = gen_format_declare(name, fn_ty, FIR_GLOBAL, false)
}

fn gen_note_extern_obj(s handle[Symbol]) void {
    nid u32 = gen_sym_fir_name_id(s)
    if gen_sym_bytes(nid).n == 0 { return }
    if gen_is_defined(nid) { return }
    alias_buf Buf = {}
    if gen_attr_str_arg(s.attrs, c"alias", &alias_buf) {
        gen_mark_defined(nid)
        gen_emit_alias(gen_sym_bytes(nid), buf_bytes(&alias_buf), gen_sym_linkage(s), gen_sym_visibility(s))
        buf_free(&alias_buf)
        return
    }
    buf_free(&alias_buf)
    sz u64 = ty_size(s.ty)
    al u64 = ty_align(s.ty)
    if gc.cur_gnu_inline_idx != 0 {
        gi handle[GnuInlineDef] = vec_at(&gc.gnu_inlines, zext[usize](gc.cur_gnu_inline_idx - 1))
        r handle[ExternObjRef] = vec_add(&gi.ext_objs)
        r.name_id = nid
        r.size = if sz > 0 { sz } else { 1 }
        r.align = if al > 0 { al } else { 1 }
        r.linkage = if gen_has_attr(s.attrs, c"weak") { FIR_WEAK } else { FIR_GLOBAL }
        r.tls = s.thread_local
        return
    }
    k U64Key = {zext[u64](nid)}
    seen u8 = table_get(&gc.ext_obj_seen, &k) catch 0
    if seen != 0 { return }
    _ bool = table_put(&gc.ext_obj_seen, &k, 1)
    r handle[ExternObjRef] = vec_add(&gc.ext_objs)
    r.name_id = nid
    r.size = if sz > 0 { sz } else { 1 }
    r.align = if al > 0 { al } else { 1 }
    r.linkage = if gen_has_attr(s.attrs, c"weak") { FIR_WEAK } else { FIR_GLOBAL }
    r.tls = s.thread_local
}

// ---------- Type Classification for Fir SSA ----------

// Returns true if C type `tid` is represented as an in-memory `ptr` in our codegen
// (structs, unions, _Complex, arrays, or _BitInt > 64? Note: Fir supports iN of ANY width directly!).
fn gen_is_mem_ty(tid u32) bool {
    k u8 = ty_kind(tid)
    return k == TYK_STRUCT || k == TYK_UNION || k == TYK_COMPLEX || k == TYK_ARRAY
}

// Emit the Fir scalar/vector value type for a non-memory C type `tid`.
// Note: _Bool is i1 in SSA (stored/loaded as i8 or i1 — Fir i1 stores as 1 byte 0/1!).
// _BitInt(N) is iN directly (Fir supports any iN up to 2^23-1 natively!).
fn gen_emit_fir_ty(b handle[Buf], tid u32) void {
    u u32 = ty_unqual(tid)
    n handle[TypeNode] = ty_node(u)
    k u8 = n.kind
    if k == TYK_BOOL { buf_str(b, c"i1"); return }
    if k == TYK_CHAR || k == TYK_SCHAR || k == TYK_UCHAR { buf_str(b, c"i8"); return }
    if k == TYK_SHORT || k == TYK_USHORT { buf_str(b, c"i16"); return }
    if k == TYK_INT || k == TYK_UINT { buf_str(b, c"i32"); return }
    if k == TYK_LONG || k == TYK_ULONG || k == TYK_LLONG || k == TYK_ULLONG { buf_str(b, c"i64"); return }
    if k == TYK_INT128 || k == TYK_UINT128 { buf_str(b, c"i128"); return }
    if k == TYK_BITINT {
        buf_u8(b, 105) // 'i'
        buf_dec_u64(b, zext[u64](n.aux1))
        return
    }
    if k == TYK_ENUM { gen_emit_fir_ty(b, ty_enum(n.aux1).underlying); return }
    if k == TYK_FLOAT16 { buf_str(b, c"f16"); return }
    if k == TYK_BFLOAT16 { buf_str(b, c"i16"); return }
    if k == TYK_FLOAT { buf_str(b, c"f32"); return }
    if k == TYK_DOUBLE { buf_str(b, c"f64"); return }
    if k == TYK_LDOUBLE { buf_str(b, c"f80"); return }
    if k == TYK_PTR || k == TYK_NULLPTR || k == TYK_FUNC { buf_str(b, c"ptr"); return }
    if k == TYK_VECTOR {
        abi_emit_fir_leaf(b, u)
        return
    }
    buf_str(b, c"ptr")
}

// Emit Fir type string for a scalar integer of bit width `bits`
fn gen_emit_int_ty(b handle[Buf], bits u32) void {
    buf_u8(b, 105)
    buf_dec_u64(b, zext[u64](bits))
}

fn gen_is_volatile(tid u32) bool {
    return (ty_quals(tid) & Q_VOLATILE) != 0
}

fn gen_is_atomic(tid u32) bool {
    return (ty_quals(tid) & Q_ATOMIC) != 0
}

// ---------- Block & SSA Management ----------

fn gen_new_val() u32 {
    v u32 = gc.next_ssa
    gc.next_ssa += 1
    return v
}

fn gen_new_block() u32 {
    id u32 = trunc[u32](gc.blocks.n)
    b handle[GenBlock] = vec_add(&gc.blocks)
    b.id = id
    return id
}

fn gen_cur_block() handle[GenBlock] {
    return vec_at(&gc.blocks, zext[usize](gc.cur_blk))
}

fn gen_cur_buf() handle[Buf] {
    return &gen_cur_block().code
}

fn gen_entry_buf() handle[Buf] {
    return &vec_at(&gc.blocks, 0).code
}

fn gen_is_terminated() bool {
    return gen_cur_block().terminated
}

fn gen_switch_block(blk_id u32) void {
    gc.cur_blk = blk_id
}

fn gen_add_succ(blk handle[GenBlock], target u32) void {
    vec_push(&blk.succs, target)
}

fn gen_emit_val(b handle[Buf], v u32) void {
    buf_str(b, c"%v")
    buf_dec_u64(b, zext[u64](v))
}

fn gen_emit_lbl(b handle[Buf], blk_id u32) void {
    buf_str(b, c"^bb")
    buf_dec_u64(b, zext[u64](blk_id))
}

// ---------- Entry-block & Dynamic Alloca ----------

fn gen_alloca_entry(size u64, align u64) u32 {
    sz u64 = if size > 0 { size } else { 1 }
    al u64 = if align > 0 { align } else { 1 }
    v u32 = gen_new_val()
    b handle[Buf] = gen_entry_buf()
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = alloca ptr i64 ")
    buf_dec_u64(b, sz)
    buf_str(b, c", align ")
    buf_dec_u64(b, al)
    buf_u8(b, 10)
    return v
}

fn gen_alloca_dyn(size_v u32, align u64) u32 {
    al u64 = if align > 0 { align } else { 1 }
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = alloca ptr ")
    gen_emit_val(b, size_v)
    buf_str(b, c", align ")
    buf_dec_u64(b, al)
    buf_u8(b, 10)
    return v
}

