fn gen_load_ty(tid u32, ptr_v u32, align u64, is_vol bool, is_atom bool) u32 {
    al u64 = if align > 0 { align } else { 1 }
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = load ")
    gen_emit_fir_ty(b, tid)
    buf_u8(b, 32)
    gen_emit_val(b, ptr_v)
    buf_str(b, c", align ")
    buf_dec_u64(b, al)
    if is_vol { buf_str(b, c" volatile") }
    if is_atom { buf_str(b, c" seq_cst") }
    buf_u8(b, 10)
    return v
}

fn gen_store_ty(val_v u32, ptr_v u32, align u64, is_vol bool, is_atom bool) void {
