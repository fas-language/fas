// ---------- Terminators ----------

fn gen_term_jump(target_blk u32) void {
    blk handle[GenBlock] = gen_cur_block()
    if blk.terminated { return }
    blk.terminated = true
    gen_add_succ(blk, target_blk)
    buf_str(&blk.term, c"  jump ")
    gen_emit_lbl(&blk.term, target_blk)
    buf_u8(&blk.term, 10)
}

fn gen_term_br(cond_v u32, t_blk u32, f_blk u32) void {
    blk handle[GenBlock] = gen_cur_block()
    if blk.terminated { return }
    blk.terminated = true
    gen_add_succ(blk, t_blk)
    gen_add_succ(blk, f_blk)
    buf_str(&blk.term, c"  br ")
    gen_emit_val(&blk.term, cond_v)
    buf_str(&blk.term, c", ")
    gen_emit_lbl(&blk.term, t_blk)
    buf_str(&blk.term, c", ")
    gen_emit_lbl(&blk.term, f_blk)
    buf_u8(&blk.term, 10)
}

fn gen_term_ret_void() void {
    blk handle[GenBlock] = gen_cur_block()
    if blk.terminated { return }
    blk.terminated = true
    buf_str(&blk.term, c"  ret\n")
}

fn gen_term_ret_val(v u32) void {
    blk handle[GenBlock] = gen_cur_block()
    if blk.terminated { return }
    blk.terminated = true
    buf_str(&blk.term, c"  ret ")
    gen_emit_val(&blk.term, v)
    buf_u8(&blk.term, 10)
}

fn gen_term_unreachable() void {
    blk handle[GenBlock] = gen_cur_block()
    if blk.terminated { return }
    blk.terminated = true
    buf_str(&blk.term, c"  unreachable\n")
}

fn gen_emit_trap() void {
    if gen_is_terminated() { return }
    buf_str(gen_cur_buf(), c"  trap\n")
}

// ---------- Deferred Globals & Aliases ----------

fn gen_global_buf() handle[Buf] {
    if gc.in_func { return &gc.deferred }
    return &gc.out.buf
}

fn gen_flush_if_top() void {
    if !gc.in_func { fir_flush(&gc.out) }
}

fn gen_is_wide_bitint(tid u32) bool {
    return ty_is_bitint(tid) && ty_int_bits(tid) > 64
}

fn gen_emit_alias(name Bytes, target Bytes, linkage u8, vis u8) void {
    b handle[Buf] = gen_global_buf()
    buf_str(b, c"alias ")
    gen_emit_sym_name(b, name)
    buf_u8(b, 32)
    fir_emit_linkage(b, linkage, vis)
    buf_str(b, c" = ")
    gen_emit_sym_name(b, target)
    buf_u8(b, 10)
    gen_flush_if_top()
}

fn gen_emit_ctor_dtor(fn_name Bytes, is_dtor bool, prio u64) void {
    nm_buf Buf = {}
    defer { buf_free(&nm_buf) }
    buf_str(&nm_buf, if is_dtor { c".Ldtor." } else { c".Lctor." })
    buf_dec_u64(&nm_buf, zext[u64](gc.str_counter))
    gc.str_counter += 1
    nid u32 = gen_intern_sym(buf_bytes(&nm_buf))
    gen_mark_defined(nid)
    nm Bytes = gen_sym_bytes(nid)
    sec Buf = {}
    defer { buf_free(&sec) }
    buf_str(&sec, if is_dtor { c".fini_array" } else { c".init_array" })
    if prio > 0 {
        buf_u8(&sec, 46)
        p u64 = prio
        if p > 65535 { p = 65535 }
        d u64 = 10000
        while d > 0 {
            buf_u8(&sec, trunc[u8](48 + (p / d) % 10))
            d /= 10
        }
    }
    b handle[Buf] = gen_global_buf()
    buf_str(b, c"global @")
    buf_append(b, nm)
    buf_str(b, c" size 8 align 8 local section \"")
    buf_append(b, buf_bytes(&sec))
    buf_str(b, c"\" = { reloc @")
    buf_append(b, fn_name)
    buf_str(b, c" w8 }\n")
    gen_flush_if_top()
}

// ---------- String Literal Pool ----------

// Emit a read-only local global holding raw bytes `data` and return its interned symbol name id
fn gen_emit_string_global(data Bytes, align u64) u32 {
    al u64 = if align > 0 { align } else { 1 }
    if gc.cur_gnu_inline_idx == 0 {
        kb Buf = {}
        defer { buf_free(&kb) }
        buf_u8(&kb, trunc[u8](al & 0xff))
        buf_append(&kb, data)
        kid u32 = intern(&gc.str_pool_keys, buf_bytes(&kb))
        k U64Key = {zext[u64](kid)}
        prev u32 = table_get(&gc.str_pool_nids, &k) catch 0
        if prev != 0 { return prev }
    }
    nm_buf Buf = {}
    defer { buf_free(&nm_buf) }
    buf_str(&nm_buf, c".Lstr.")
    buf_dec_u64(&nm_buf, zext[u64](gc.str_counter))
    gc.str_counter += 1
    nid u32 = gen_intern_sym(buf_bytes(&nm_buf))
    gen_mark_defined(nid)
    if gc.cur_gnu_inline_idx == 0 {
        kb2 Buf = {}
        defer { buf_free(&kb2) }
        buf_u8(&kb2, trunc[u8](al & 0xff))
        buf_append(&kb2, data)
        kid2 u32 = intern(&gc.str_pool_keys, buf_bytes(&kb2))
        k2 U64Key = {zext[u64](kid2)}
        _ bool = table_put(&gc.str_pool_nids, &k2, nid)
    }
    nm Bytes = gen_sym_bytes(nid)
    b handle[Buf] = gen_global_buf()
    sz u64 = data.n
    buf_str(b, c"global @")
    buf_append(b, nm)
    buf_str(b, c" size ")
    buf_dec_u64(b, sz)
    buf_str(b, c" align ")
    buf_dec_u64(b, al)
    buf_str(b, c" local readonly = ")
    if sz == 0 {
        buf_str(b, c"zero\n")
    } else {
        buf_str(b, c"{ bytes ")
        fir_emit_quoted_bytes(b, data.p, data.n)
        buf_str(b, c" }\n")
    }
    gen_flush_if_top()
    return nid
}

// ---------- TU Streaming Callbacks & Finalization ----------

fn gen_on_function_cb(ctx addr, node addr, user addr) void fails {
    n handle[Ast] = handle_from_addr(node)
    if n == null || n.decl == null { return }
    try gen_function(n)
}

fn gen_on_object_cb(ctx addr, node addr, user addr) void fails {
    n handle[Ast] = handle_from_addr(node)
    if n == null { return }
    if n.kind == ND_ASM {
        // File-scope module_asm
        if n.a != null {
            tmp Buf = {}
            defer { buf_free(&tmp) }
            gen_decode_string_ast(n.a, &tmp, false)
            fir_module_asm(&gc.out, buf_bytes(&tmp))
        }
        return
    }
    if n.kind == ND_DECL && n.decl != null {
        s handle[Symbol] = n.decl
        // Check for alias attribute
        alias_buf Buf = {}
        defer { buf_free(&alias_buf) }
        if gen_attr_str_arg(s.attrs, c"alias", &alias_buf) {
            nid u32 = gen_sym_fir_name_id(s)
            if !gen_is_defined(nid) {
                gen_mark_defined(nid)
                gen_emit_alias(gen_sym_bytes(nid), buf_bytes(&alias_buf), gen_sym_linkage(s), gen_sym_visibility(s))
            }
            return
        }
        if ty_is_func(s.ty) { return }
        // Tentative definition: defer until TU end in case a real definition follows
        if (s.flags & 1) == 0 && s.value == null {
            tr handle[TentativeRef] = vec_add(&gc.tentatives)
            tr.name_id = gen_sym_fir_name_id(s)
            sz u64 = ty_size(s.ty)
            al u64 = ty_align(s.ty)
            tr.size = if sz > 0 { sz } else { 1 }
            tr.align = if al > 0 { al } else { 1 }
            tr.linkage = gen_sym_linkage(s)
            tr.vis = gen_sym_visibility(s)
            tr.tls = s.thread_local
            sec_buf Buf = {}
            if gen_attr_str_arg(s.attrs, c"section", &sec_buf) && sec_buf.n > 0 {
                sp addr = heap_alloc(sec_buf.n + 1)
                mem_copy(sp, sec_buf.p, sec_buf.n)
                sp[u8, sec_buf.n] = 0
                tr.section = sp
            }
            buf_free(&sec_buf)
            return
        }
        try gen_global_object(s)
    }
}

fn gen_finish_tu() void fails {
    // 0. Emit any `extern inline __attribute__((gnu_inline))` functions transitively referenced
    gi_i usize = 0
    while gi_i < gc.ext_fns.n {
        r handle[ExternFnRef] = vec_at(&gc.ext_fns, gi_i)
        gi_i += 1
        rnid u32 = r.name_id
        if gen_is_defined(rnid) { continue }
        gk U64Key = {zext[u64](rnid)}
        gidx u32 = table_get(&gc.gnu_inline_map, &gk) catch 0
        if gidx == 0 { continue }
        gen_mark_defined(rnid)
        gi handle[GnuInlineDef] = vec_at(&gc.gnu_inlines, zext[usize](gidx - 1))
        if gi.code.n > 0 {
            buf_append(&gc.out.buf, buf_bytes(&gi.code))
            fir_flush(&gc.out)
        }
        for fi usize in 0..gi.ext_fns.n {
            fr handle[ExternFnRef] = vec_at(&gi.ext_fns, fi)
            if gen_is_defined(fr.name_id) { continue }
            fk U64Key = {zext[u64](fr.name_id)}
            seen u8 = table_get(&gc.ext_fn_seen, &fk) catch 0
            if seen != 0 { continue }
            _ bool = table_put(&gc.ext_fn_seen, &fk, 1)
            nr handle[ExternFnRef] = vec_add(&gc.ext_fns)
            nr.name_id = fr.name_id
            nr.decl_line = fr.decl_line
        }
        for oi usize in 0..gi.ext_objs.n {
            or_ handle[ExternObjRef] = vec_at(&gi.ext_objs, oi)
            if gen_is_defined(or_.name_id) { continue }
            ok_ U64Key = {zext[u64](or_.name_id)}
            seen u8 = table_get(&gc.ext_obj_seen, &ok_) catch 0
            if seen != 0 { continue }
            _ bool = table_put(&gc.ext_obj_seen, &ok_, 1)
            no handle[ExternObjRef] = vec_add(&gc.ext_objs)
            no.name_id = or_.name_id
            no.size = or_.size
            no.align = or_.align
            no.linkage = or_.linkage
            no.tls = or_.tls
        }
    }
    // 1. Emit tentative definitions that were not subsequently defined
    for i usize in 0..gc.tentatives.n {
        tr handle[TentativeRef] = vec_at(&gc.tentatives, i)
        if !gen_is_defined(tr.name_id) {
            gen_mark_defined(tr.name_id)
            sec Bytes = if tr.section != null { bytes_c(tr.section) } else { bytes_empty() }
            fir_global_zero(&gc.out, gen_sym_bytes(tr.name_id), tr.size, tr.align,
                            tr.linkage, tr.vis, sec, false, tr.tls)
        }
    }
    // 2. Emit extern object declarations for undefined referenced globals
    for i usize in 0..gc.ext_objs.n {
        r handle[ExternObjRef] = vec_at(&gc.ext_objs, i)
        if !gen_is_defined(r.name_id) {
            fir_global_extern(&gc.out, gen_sym_bytes(r.name_id), r.size, r.align,
                              r.linkage, FIR_VIS_DEFAULT, bytes_empty(), false, r.tls)
        }
    }
    // 3. Emit function declarations for undefined referenced functions
    for i usize in 0..gc.ext_fns.n {
        r handle[ExternFnRef] = vec_at(&gc.ext_fns, i)
        if !gen_is_defined(r.name_id) && r.decl_line != null {
            buf_str(&gc.out.buf, r.decl_line)
            fir_flush(&gc.out)
        }
    }
    fir_flush(&gc.out)
}
