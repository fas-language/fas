    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = stacksave\n")
    return v
}

fn gen_stackrestore(sp_v u32) void {
