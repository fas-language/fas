}

// ---------- Constant Emitters ----------

fn gen_const_int(tid u32, val u64) u32 {
    if ty_is_void(tid) { return gen_const_i32(0) }
    k u8 = ty_kind(tid)
    if k == TYK_PTR || k == TYK_NULLPTR || k == TYK_FUNC {
        if val == 0 { return gen_const_zero(tid) }
        iv u32 = gen_const_u64(val)
        return gen_cast_raw(c"inttoptr", c"ptr", iv)
    }
    if k == TYK_VECTOR {
        et u32 = ty_node(ty_unqual(tid)).elem
        ev u32 = gen_const_int(et, val)
        v u32 = gen_new_val()
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  ")
        gen_emit_val(b, v)
        buf_str(b, c" = splat ")
        gen_emit_fir_ty(b, tid)
        buf_u8(b, 32)
        gen_emit_val(b, ev)
        buf_u8(b, 10)
        return v
    }
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    bits u32 = ty_int_bits(tid)
    if bits == 0 { bits = 64 }
    masked u64 = val
    if bits < 64 {
        mask u64 = (1 << bits) - 1
        masked = val & mask
    }
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = add ")
    gen_emit_fir_ty(b, tid)
    buf_u8(b, 32)
    gen_emit_fir_ty(b, tid)
    buf_str(b, c" 0x")
    buf_hex(b, masked, 1)
    buf_str(b, c", ")
    gen_emit_fir_ty(b, tid)
    buf_str(b, c" 0\n")
    return v
}

fn gen_const_i64(val i64) u32 {
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = add i64 i64 ")
    buf_dec_i64(b, val)
    buf_str(b, c", i64 0\n")
    return v
}

fn gen_const_u64(val u64) u32 {
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = add i64 i64 0x")
    buf_hex(b, val, 1)
    buf_str(b, c", i64 0\n")
    return v
}

fn gen_const_i32(val i32) u32 {
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = add i32 i32 ")
    buf_dec_i64(b, sext[i64](val))
    buf_str(b, c", i32 0\n")
    return v
}

fn gen_const_i8(val u8) u32 {
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = add i8 i8 ")
    buf_dec_u64(b, zext[u64](val))
    buf_str(b, c", i8 0\n")
    return v
}

fn gen_const_i1(val bool) u32 {
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, if val { c" = add i1 i1 1, i1 0\n" } else { c" = add i1 i1 0, i1 0\n" })
    return v
}

fn gen_const_zero(tid u32) u32 {
    if ty_is_void(tid) { return gen_const_i32(0) }
    if gen_is_mem_ty(tid) {
        sz u64 = ty_size(tid)
        slot u32 = gen_alloca_entry(sz, ty_align(tid))
        if sz > 0 { gen_memset_const(slot, 0, sz, false) }
        return slot
    }
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    k u8 = ty_kind(tid)
    if k == TYK_PTR || k == TYK_NULLPTR || k == TYK_FUNC {
        buf_str(b, c"  ")
        gen_emit_val(b, v)
        buf_str(b, c" = ptradd ptr ptr null, i64 0, 1, 0\n")
        return v
    }
    if ty_is_real_float(tid) {
        buf_str(b, c"  ")
        gen_emit_val(b, v)
        buf_str(b, c" = fadd ")
        gen_emit_fir_ty(b, tid)
        buf_u8(b, 32)
        gen_emit_fir_ty(b, tid)
        buf_str(b, c" zero, ")
        gen_emit_fir_ty(b, tid)
        buf_str(b, c" zero\n")
        return v
    }
    if k == TYK_VECTOR {
        buf_str(b, c"  ")
        gen_emit_val(b, v)
        buf_str(b, c" = freeze ")
        gen_emit_fir_ty(b, tid)
        buf_u8(b, 32)
        gen_emit_fir_ty(b, tid)
        buf_str(b, c" zero\n")
        return v
    }
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = add ")
    gen_emit_fir_ty(b, tid)
    buf_u8(b, 32)
    gen_emit_fir_ty(b, tid)
    buf_str(b, c" zero, ")
    gen_emit_fir_ty(b, tid)
    buf_str(b, c" zero\n")
    return v
}

fn gen_const_wide_int(tid u32, limbs addr, width u32) u32 {
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    words u32 = (width + 31) / 32
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = add ")
    gen_emit_fir_ty(b, tid)
    buf_u8(b, 32)
    gen_emit_fir_ty(b, tid)
    buf_str(b, c" 0x")
    // Emit hex from most-significant 32-bit word down to 0
    started bool = false
    i u32 = words
    while i > 0 {
        i -= 1
        w u32 = limbs[u32, zext[usize](i)]
        if !started {
            if w != 0 || i == 0 {
                buf_hex(b, zext[u64](w), 1)
                started = true
            }
        } else {
            buf_hex(b, zext[u64](w), 8)
        }
    }
    buf_str(b, c", ")
    gen_emit_fir_ty(b, tid)
    buf_str(b, c" zero\n")
    return v
}

// Convert f64 bits to IEEE f16 bits (round-to-nearest-even)
fn gen_f64_to_f16_bits(bits u64) u16 {
    f f64 = bitcast[f64](bits)
    f32v f32 = cvt[f32](f)
    u u32 = bitcast[u32](f32v)
    sign u32 = (u >> 16) & 0x8000
    exp i32 = bitcast[i32]((u >> 23) & 0xff) - 127 + 15
    mant u32 = u & 0x7fffff
    if exp <= 0 {
        if exp < -10 { return trunc[u16](sign) }
        mant = (mant | 0x800000) >> bitcast[u32](1 - exp)
        return trunc[u16](sign | ((mant + 0x1000) >> 13))
    }
    if exp >= 31 {
        if ((u >> 23) & 0xff) == 0xff && mant != 0 {
            return trunc[u16](sign | 0x7e00 | (mant >> 13))
        }
        return trunc[u16](sign | 0x7c00)
    }
    return trunc[u16](sign | (bitcast[u32](exp) << 10) | ((mant + 0x1000) >> 13))
}

// Convert f64 bits to x87 80-bit extended (lo64 = significand, hi16 = sign+exp)
fn gen_f64_to_f80_bits(bits u64, out_lo addr, out_hi addr) void {
    sign u16 = trunc[u16]((bits >> 48) & 0x8000)
    exp u64 = (bits >> 52) & 0x7ff
    frac u64 = bits & 0x000fffffffffffff
    if exp == 0 {
        if frac == 0 {
            out_lo[u64] = 0
            out_hi[u16] = sign
            return
        }
        // Subnormal f64 -> normal f80
        shift u32 = trunc[u32](clz(frac)) - 11
        out_lo[u64] = frac << (shift + 11)
        out_hi[u16] = sign | trunc[u16](16383 - 1022 - zext[u64](shift))
        return
    }
    if exp == 0x7ff {
        out_hi[u16] = sign | 0x7fff
        out_lo[u64] = 0x8000000000000000 | (frac << 11)
        return
    }
    out_hi[u16] = sign | trunc[u16](exp - 1023 + 16383)
    out_lo[u64] = 0x8000000000000000 | (frac << 11)
}

fn gen_const_float(tid u32, f64_bits u64) u32 {
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    k u8 = ty_kind(tid)
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = freeze ")
    gen_emit_fir_ty(b, tid)
    buf_u8(b, 32)
    gen_emit_fir_ty(b, tid)
    buf_str(b, c" 0x")
    if k == TYK_FLOAT16 {
        buf_hex(b, zext[u64](gen_f64_to_f16_bits(f64_bits)), 4)
    } else if k == TYK_FLOAT {
        f32v f32 = cvt[f32](bitcast[f64](f64_bits))
        buf_hex(b, zext[u64](bitcast[u32](f32v)), 8)
    } else if k == TYK_DOUBLE {
        buf_hex(b, f64_bits, 16)
    } else if k == TYK_LDOUBLE {
        lo u64 = 0
        hi u16 = 0
        gen_f64_to_f80_bits(f64_bits, &lo, &hi)
        buf_hex(b, zext[u64](hi), 4)
        buf_hex(b, lo, 16)
    } else {
        buf_hex(b, f64_bits, 16)
    }
    buf_u8(b, 10)
    return v
}

fn gen_sym_addr(sym Bytes) u32 {
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = ptradd ptr ptr ")
    gen_emit_sym_name(b, sym)
    buf_str(b, c", i64 0, 1, 0\n")
    return v
}

