// Constants use the target type's width even where the host Fas arithmetic
// wraps at 64 bits. Overflow is carried on nodes until a context requires
// a constant, so an unselected short-circuit branch cannot diagnose it.
const NF_FLOAT_CONST u32 = 64
const NF_ADDR u32 = 128

fn se_negative(ty u32, value u64) bool {
    return !ty_is_unsigned(ty) && bitcast[i64](value) < 0
}

fn se_fp(a handle[Ast]) f64 {
    if (a.flags & NF_FLOAT_CONST) != 0 { return bitcast[f64](a.value) }
    if a.wide != null {
        w WideInt = wi_from_ast(a, ty_int_bits(a.ty))
        negative bool = !ty_is_unsigned(a.ty) && wi_bit(w, w.width - 1) != 0
        if negative { wi_negate(w) }
        v f64 = 0.0
        i u32 = w.words
        while i > 0 {
            i -= 1
            v = v * 4294967296.0 + cvt[f64](w.p[u32, zext[usize](i)])
        }
        return if negative { -v } else { v }
    }
    if ty_is_unsigned(a.ty) { return cvt[f64](a.value) }
    return cvt[f64](bitcast[i64](a.value))
}

fn se_set_fp(a handle[Ast], v f64) void {
    if ty_real_part(a.ty) == TY_FLOAT { v = cvt[f64](cvt[f32](v)) }
    a.value = bitcast[u64](v)
    a.flags |= NF_FLOAT_CONST | NF_STATIC
}

fn se_make_union(ty u32, member u64, elem u32, value handle[Ast]) handle[Ast] {
    xs AstList = {}
    pa_add_init(&xs, se_convert(elem, value), null, member)
    init handle[Ast] = pa_node(ND_INIT, value.loc, ty)
    init.a = xs.first
    init.flags = value.flags & NF_STATIC
    n handle[Ast] = pa_node(ND_COMPOUND, value.loc, ty)
    n.a = init
    n.flags = init.flags
    return n
}

// Match exact types first, followed by ordinary pointer compatibility.
// A null pointer or an unqualified void pointer can select any pointer
// member when no member provides a more specific match.
fn se_transparent_arg(ty u32, a handle[Ast]) handle[Ast] {
    if ty_transparent_first(ty) == TY_INVALID || ty_compatible(ty_unqual(ty), ty_unqual(a.ty)) { return a }
    r handle[RecordDef] = ty_record(ty_node(ty_unqual(ty)).aux1)
    from u32 = se_decay(a.ty)
    fallback u32 = r.fields_len
    for i u32 in 0..r.fields_len {
        f handle[FieldDef] = ty_field(r.fields_start + i)
        if ty_compatible(ty_unqual(f.ty), ty_unqual(from)) {
            return se_make_union(ty, zext[u64](i), f.ty, a)
        }
        if fallback == r.fields_len && ty_is_ptr(f.ty) &&
            (se_null(a) || (ty_is_ptr(from) && se_ptr_compatible(f.ty, from, true))) { fallback = i }
    }
    if fallback < r.fields_len { return se_make_union(ty, zext[u64](fallback), ty_field(r.fields_start + fallback).ty, a) }
    return a
}

fn se_cast(p handle[Parser], t Token, ty u32, a handle[Ast]) handle[Ast] fails {
    from u32 = se_decay(a.ty)
    n handle[Ast] = pa_node(ND_CAST, t.loc, ty)
    n.a = a
    if from == TY_INVALID || ty_is_void(ty) { return n }
    if !ty_is_scalar(ty) || !ty_is_scalar(from) ||
        (ty_is_ptr(ty) && ty_is_floating(from)) || (ty_is_floating(ty) && ty_is_ptr(from)) ||
        (ty_is_nullptr(ty) && !ty_is_nullptr(from)) {
        if pa_is_gnu(p) && (ty_is_vector(ty) || ty_is_vector(from)) && ty_size(ty) == ty_size(from) {
            n.flags = a.flags & NF_STATIC
            return n
        }
        if pa_is_gnu(p) {
            if ty_compatible(ty_unqual(ty), ty_unqual(from)) { return n }
            if ty_kind(ty) == TYK_UNION {
                r handle[RecordDef] = ty_record(ty_node(ty_unqual(ty)).aux1)
                for i u32 in 0..r.fields_len {
                    f handle[FieldDef] = ty_field(r.fields_start + i)
                    if f.name_id == 0 || !ty_compatible(ty_unqual(f.ty), ty_unqual(from)) { continue }
                    // A GNU cast to a union constructs a value with the
                    // first compatible named member as its active member.
                    return se_make_union(ty, zext[u64](i), f.ty, a)
                }
            }
        }
        try pa_error(p, t.loc, c"invalid cast between these types")
    }
    se_cast_constant(n, a)
    if pa_is_gnu(p) && ty_is_integer(ty) && ty_is_ptr(from) {
        absolute AddressValue = {}
        if se_address_value(p, a, &absolute) && absolute.symbol == null {
            raw u64 = bitcast[u64](absolute.offset)
            n.flags |= NF_STATIC | NF_FOLD
            if ty_is_bool(ty) { n.value = if raw == 0 { 0 } else { 1 } }
            else {
                n.value = se_value(ty, raw)
                if ty_int_bits(ty) > 64 { wi_store(n, wi_from_ast(n, ty_int_bits(ty))) }
            }
        }
    }
    return n
}

fn se_cast_constant(n handle[Ast], a handle[Ast]) void {
    ty u32 = n.ty
    from u32 = se_decay(a.ty)
    n.flags |= a.flags & (NF_STATIC | NF_OVERFLOW)
    if ty_is_integer(ty) && (a.flags & NF_INT_VALUE) != 0 {
        n.flags |= a.flags & NF_INT_VALUE
        if ty_is_bool(ty) { n.value = if se_truth(a) { 1 } else { 0 } }
        else if ty_int_bits(ty) > 64 { wi_store(n, wi_from_ast(a, ty_int_bits(ty))) }
        else { n.value = se_value(ty, a.value) }
    } else if ty_is_integer(ty) && (a.flags & NF_FLOAT_CONST) != 0 {
        v f64 = se_fp(a)
        if ty_is_bool(ty) { n.value = if se_truth(a) { 1 } else { 0 } }
        else { n.value = se_value(ty, if ty_is_unsigned(ty) { cvt[u64](v) } else { bitcast[u64](cvt[i64](v)) }) }
        if ty_is_real_float(from) && a.kind == ND_FLOAT { n.flags |= NF_ICE }
        else { n.flags |= NF_FOLD }
    } else if (ty_is_real_float(ty) || ty_is_complex(ty)) && (a.flags & (NF_INT_VALUE | NF_FLOAT_CONST)) != 0 {
        se_set_complex(n, se_fp(a), if ty_is_complex(ty) { se_im(a) } else { 0.0 })
    } else if ty_is_ptr(ty) && se_null(a) {
        n.flags |= NF_STATIC
        if ty_is_integer(from) { n.flags |= NF_ICE }
    } else if ty_is_ptr(ty) && ty_is_integer(from) && (a.flags & NF_INT_VALUE) != 0 {
        // A cast of an integer constant to a pointer is an address constant.
        n.flags |= NF_STATIC
    }
    if ty_is_nullptr(from) && ty_is_bool(ty) { n.flags |= NF_STATIC; n.value = 0 }
}

fn se_convert(dest u32, src handle[Ast]) handle[Ast] {
    if dest == TY_INVALID || src.ty == TY_INVALID || src.ty == dest { return src }
    n handle[Ast] = pa_node(ND_CAST, src.loc, dest)
    n.flags = NF_IMPLICIT
    n.a = src
    se_cast_constant(n, src)
    return n
}

fn se_im(a handle[Ast]) f64 {
    if ty_is_complex(a.ty) && (a.flags & NF_FLOAT_CONST) != 0 { return bitcast[f64](a.imag) }
    return 0.0
}

fn se_set_complex(a handle[Ast], real f64, imag f64) void {
    se_set_fp(a, real)
    if ty_is_complex(a.ty) {
        if ty_real_part(a.ty) == TY_FLOAT { imag = cvt[f64](cvt[f32](imag)) }
        a.imag = bitcast[u64](imag)
    }
}

fn se_promote_expr(a handle[Ast]) u32 {
    if (a.flags & NF_BITFIELD) != 0 && a.field_width < 32 && !ty_is_bitint(a.ty) { return TY_INT }
    return ty_integer_promote(se_decay(a.ty))
}

fn se_arith_type(a handle[Ast], b handle[Ast]) u32 {
    return ty_usual_arith_conv(se_promote_expr(a), se_promote_expr(b))
}

fn se_assign_word(p handle[Parser], t Token) bool {
    return pa_is(p, t, c"=") || pa_is(p, t, c"+=") || pa_is(p, t, c"-=") || pa_is(p, t, c"*=") ||
        pa_is(p, t, c"/=") || pa_is(p, t, c"%=") || pa_is(p, t, c"<<=") ||
        pa_is(p, t, c">>=") || pa_is(p, t, c"&=") || pa_is(p, t, c"^=") || pa_is(p, t, c"|=")
}

fn se_prec(p handle[Parser], t Token) u8 {
    k u8 = expr_prec(p.names, t)
    if k == 1 { return 1 }
    if k != 0 { return k + 1 }
    if se_assign_word(p, t) { return 2 }
    return 0
}

fn se_addressable(e handle[Ast]) bool {
    return (e.flags & NF_LVALUE) != 0 || ty_is_func(e.ty)
}

fn se_unary(p handle[Parser], t Token, a handle[Ast], postfix bool) handle[Ast] fails {
    ty u32 = se_decay(a.ty)
    n handle[Ast] = pa_node(ND_UNARY, t.loc, ty)
    n.op = t.payload
    n.a = a
    if postfix { n.b = a }
    if pa_is(p, t, c"&") {
        s handle[Symbol] = a.decl
        if !se_addressable(a) || (a.flags & NF_BITFIELD) != 0 ||
            (s != null && s.storage == SC_REGISTER) || (a.kind == ND_COMPOUND && a.op == zext[u32](SC_REGISTER)) {
            try pa_error(p, t.loc, c"cannot take the address of this expression")
        }
        n.ty = ty_ptr(a.ty)
        if (a.flags & NF_ADDR) != 0 || ty_is_func(a.ty) && (a.flags & NF_STATIC) != 0 { n.flags |= NF_STATIC }
        return n
    }
    if pa_is(p, t, c"*") {
        if !ty_is_ptr(ty) { try pa_error(p, t.loc, c"indirection requires a pointer") }
        n.ty = ty_node(ty_unqual(ty)).elem
        if !ty_is_func(n.ty) { n.flags = NF_LVALUE }
        if (a.flags & NF_STATIC) != 0 {
            n.flags |= NF_ADDR
            if ty_is_func(n.ty) || ty_is_array(n.ty) { n.flags |= NF_STATIC }
        }
        return n
    }
    if pa_is(p, t, c"++") || pa_is(p, t, c"--") {
        try se_modifiable(p, a)
        if !ty_is_arith(ty) && !ty_is_ptr(ty) {
            try pa_error(p, t.loc, c"invalid increment or decrement operand")
        }
        return n
    }
    if pa_is(p, t, c"!") {
        try se_scalar(p, a)
        n.ty = TY_INT
        n.flags = a.flags & (NF_INT_VALUE | NF_OVERFLOW)
        if (a.flags & NF_FLOAT_CONST) != 0 { n.flags |= NF_FOLD }
        if (n.flags & NF_INT_VALUE) != 0 {
            n.flags |= NF_STATIC
            n.value = if se_truth(a) { 0 } else { 1 }
        }

        return n
    }
    tilde bool = pa_is(p, t, c"~")
    negate bool = pa_is(p, t, c"-")
    if !ty_is_vector(ty) && ((!tilde && !ty_is_arith(ty)) || (tilde && !ty_is_integer(ty) && !(pa_is_gnu(p) && ty_is_complex(ty)))) {
        try pa_error(p, t.loc, c"invalid unary arithmetic operand")
    }
    n.ty = se_promote_expr(a)
    n.flags = a.flags & (NF_INT_VALUE | NF_STATIC | NF_OVERFLOW)
    if (a.flags & NF_INT_VALUE) != 0 && ty_int_bits(n.ty) > 64 { wi_unary(n, a, negate, tilde) }
    else if (a.flags & NF_INT_VALUE) != 0 {
        raw u64 = se_value(n.ty, a.value)
        n.value = raw
        if tilde { n.value = se_value(n.ty, ~raw) }
        if negate {
            n.value = se_value(n.ty, 0 - raw)
            if !ty_is_unsigned(n.ty) && n.value == raw && raw != 0 && ty_int_bits(n.ty) <= 64 { n.flags |= NF_OVERFLOW }
        }
    } else if (a.flags & NF_FLOAT_CONST) != 0 {
        v f64 = se_fp(a)
        im f64 = se_im(a)
        if negate { v = -v; im = -im }
        if tilde { im = -im }
        se_set_complex(n, v, im)
    }
    return n
}

fn se_truth(a handle[Ast]) bool {
    if (a.flags & NF_FLOAT_CONST) != 0 { return se_fp(a) != 0.0 || se_im(a) != 0.0 }
    if ty_is_nullptr(a.ty) { return false }
    if a.wide != null { return wi_ast_length(a) != 0 }
    return a.value != 0
}

fn se_fold_float(p handle[Parser], t Token, n handle[Ast], a handle[Ast], b handle[Ast], k u8) void {
    x f64 = se_fp(a)
    y f64 = se_fp(b)
    ix f64 = se_im(a)
    iy f64 = se_im(b)
    if k == 8 {
        eq bool = x == y && ix == iy
        if pa_is(p, t, c"!=") { eq = !eq }
        n.value = if eq { 1 } else { 0 }
        return
    }
    if k == 9 {
        yes bool = x < y
        if pa_is(p, t, c">") { yes = x > y }
        if pa_is(p, t, c"<=") { yes = x <= y }
        if pa_is(p, t, c">=") { yes = x >= y }
        n.value = if yes { 1 } else { 0 }
        return
    }
    real f64 = 0.0
    imag f64 = 0.0
    if !ty_is_complex(n.ty) {
        if pa_is(p, t, c"+") { real = x + y }
        else if pa_is(p, t, c"-") { real = x - y }
        else if pa_is(p, t, c"*") { real = x * y }
        else { real = x / y }
    } else if pa_is(p, t, c"+") { real = x + y; imag = ix + iy }
    else if pa_is(p, t, c"-") { real = x - y; imag = ix - iy }
    else if pa_is(p, t, c"*") { real = x * y - ix * iy; imag = x * iy + ix * y }
    else {
        norm f64 = y * y + iy * iy
        real = (x * y + ix * iy) / norm
        imag = (ix * y - x * iy) / norm
    }
    se_set_complex(n, real, imag)
}

fn se_fold_int(p handle[Parser], t Token, n handle[Ast], a handle[Ast], b handle[Ast], ty u32, k u8) void {
    x u64 = se_value(ty, a.value)
    y u64 = se_value(ty, b.value)
    sx i64 = bitcast[i64](x)
    sy i64 = bitcast[i64](y)
    uns bool = ty_is_unsigned(ty)
    width u32 = ty_int_bits(ty)
    raw u64 = 0
    over bool = false
    if k == 5 { raw = x | y }
    else if k == 6 { raw = x ^ y }
    else if k == 7 { raw = x & y }
    else if k == 8 || k == 9 {
        less bool = if uns { x < y } else { sx < sy }
        equal bool = x == y
        yes bool = equal
        if pa_is(p, t, c"!=") { yes = !equal }
        else if pa_is(p, t, c"<") { yes = less }
        else if pa_is(p, t, c">") { yes = !less && !equal }
        else if pa_is(p, t, c"<=") { yes = less || equal }
        else if pa_is(p, t, c">=") { yes = !less }
        n.value = if yes { 1 } else { 0 }
        return
    } else if k == 10 {
        y = se_value(se_promote_expr(b), b.value)
        if y >= zext[u64](width) || y >= 64 { n.flags |= NF_OVERFLOW; return }
        shift u32 = trunc[u32](y)
        if pa_is(p, t, c"<<") {
            raw = x << shift
            if !uns && (sx < 0 || raw >> shift != x || (width < 64 && raw >> width != 0)) { over = true }
            // Shift into the sign bit is accepted by Clang for C.
        } else {
            raw = if uns { x >> shift } else { bitcast[u64](sx >> shift) }
        }
    } else if pa_is(p, t, c"+") {
        raw = x + y
        over = ((x ^ raw) & (y ^ raw)) >> 63 != 0
    } else if pa_is(p, t, c"-") {
        raw = x - y
        over = ((x ^ y) & (x ^ raw)) >> 63 != 0
    } else if pa_is(p, t, c"*") {
        raw = x * y
        if !uns && y != 0 {
            if y == ~0 { over = x == 0x8000000000000000 }
            else { over = bitcast[i64](raw) / sy != sx }
        }
    } else {
        if y == 0 || (!uns && sx < 0 && y == ~0 && se_value(ty, 0 - x) == x) {
            n.flags |= NF_OVERFLOW
            return
        }
        if pa_is(p, t, c"/") { raw = if uns { x / y } else { bitcast[u64](sx / sy) } }
        else { raw = if uns { x % y } else { bitcast[u64](sx % sy) } }
    }
    n.value = se_value(n.ty, raw)
    if !uns && (over || ((k == 11 || k == 12) && n.value != raw)) { n.flags |= NF_OVERFLOW }
}

fn se_pointer_math(p handle[Parser], t Token, ty u32) void fails {
    elem u32 = ty_node(ty_unqual(ty)).elem
    if !se_complete(elem) && !(pa_is_gnu(p) && (ty_is_void(elem) || ty_is_func(elem))) {
        try pa_error(p, t.loc, c"pointer arithmetic requires a complete object type")
    }
}

// Keep relocatable pointers in the AST. Fold only comparisons and arithmetic
// that are independent of linker placement. A null symbol denotes an absolute
// address, so the offset then represents the whole address.
struct AddressValue { symbol handle[Symbol], offset i64 }

fn se_address_add(out handle[AddressValue], index handle[Ast], size u64, sub bool) bool {
    if (index.flags & NF_INT_VALUE) == 0 || (index.flags & NF_OVERFLOW) != 0 ||
        index.wide != null || size == 0 { return false }
    negative bool = !ty_is_unsigned(index.ty) && bitcast[i64](index.value) < 0
    mag u64 = if negative { 0 - index.value } else { index.value }
    if mag > 0x7fffffffffffffff / size { return false }
    delta u64 = mag * size
    offset u64 = bitcast[u64](out.offset)
    if negative != sub {
        if delta > offset { return false }
        offset -= delta
    } else {
        if delta > 0x7fffffffffffffff - offset { return false }
        offset += delta
    }
    symbol handle[Symbol] = out.symbol
    if symbol != null && offset > ty_size(symbol.ty) { return false }
    out.offset = bitcast[i64](offset)
    return true
}

fn se_address_object(p handle[Parser], a handle[Ast], out handle[AddressValue]) bool {
    base handle[Ast] = a.a
    if a.kind == ND_NAME {
        s handle[Symbol] = a.decl
        if s != null && s.link_symbol != null { s = s.link_symbol }
        if s == null || ty_is_func(s.ty) || s.asm_name != 0 || pa_has_attr(p, s.attrs, c"weak") ||
            pa_has_attr(p, s.attrs, c"alias") || pa_has_attr(p, s.attrs, c"weakref") { return false }
        out.symbol = s
        out.offset = 0
        return true
    }
    if a.kind == ND_MEMBER && (a.flags & NF_BITFIELD) == 0 {
        if ty_is_ptr(base.ty) {
            if !se_address_value(p, base, out) { return false }
        } else if !se_address_object(p, base, out) { return false }
        offset u64 = a.field_offset / 8
        if offset > 0x7fffffffffffffff - bitcast[u64](out.offset) { return false }
        out.offset += bitcast[i64](offset)
        return true
    }
    if a.kind == ND_UNARY && bytes_eq_c(cc_name(p.names, a.op), c"*") {
        return se_address_value(p, base, out)
    }
    if a.kind == ND_SUBSCRIPT {
        index handle[Ast] = a.b
        if ty_is_integer(base.ty) { base = a.b; index = a.a }
        return se_address_value(p, base, out) && se_address_add(out, index, ty_size(a.ty), false)
    }
    return false
}

fn se_address_value(p handle[Parser], a handle[Ast], out handle[AddressValue]) bool {
    base handle[Ast] = a.a
    if ty_is_array(a.ty) { return se_address_object(p, a, out) }
    if a.kind == ND_CAST {
        if ty_is_ptr(se_decay(base.ty)) { return se_address_value(p, base, out) }
        if se_null(base) && ty_is_ptr(a.ty) {
            out.symbol = null
            out.offset = 0
            return true
        }
        if ty_is_ptr(a.ty) && ty_is_integer(base.ty) && (base.flags & NF_INT_VALUE) != 0 &&
            (base.flags & NF_OVERFLOW) == 0 && base.wide == null && base.value <= 0x7fffffffffffffff {
            out.symbol = null
            out.offset = bitcast[i64](base.value)
            return true
        }
    }
    if a.kind == ND_UNARY && bytes_eq_c(cc_name(p.names, a.op), c"&") {
        return se_address_object(p, base, out)
    }
    if a.kind != ND_BINARY { return false }
    op Bytes = cc_name(p.names, a.op)
    sub bool = bytes_eq_c(op, c"-")
    if !sub && !bytes_eq_c(op, c"+") { return false }
    index handle[Ast] = a.b
    if !sub && ty_is_integer(base.ty) { base = a.b; index = a.a }
    ptr u32 = se_decay(base.ty)
    if !ty_is_ptr(ptr) || !se_address_value(p, base, out) { return false }
    elem u32 = ty_node(ty_unqual(ptr)).elem
    stride u64 = if ty_is_void(elem) || ty_is_func(elem) { 1 } else { ty_size(elem) }
    return se_address_add(out, index, stride, sub)
}

fn se_fold_pointer(p handle[Parser], t Token, n handle[Ast], a handle[Ast], b handle[Ast], ty u32, k u8) void {
    if !pa_is_gnu(p) || ((a.flags & b.flags) & NF_STATIC) == 0 { return }
    if k == 11 && a.kind == ND_UNARY && b.kind == ND_UNARY &&
        bytes_eq_c(cc_name(p.names, a.op), c"&&") && bytes_eq_c(cc_name(p.names, b.op), c"&&") {
        // Differences between local labels remain symbolic until code
        // placement, except when both operands name the same label.
        n.flags |= NF_STATIC
        if a.extra == b.extra { n.flags |= NF_FOLD }
        return
    }
    x AddressValue = {}
    y AddressValue = {}
    if !se_address_value(p, a, &x) || !se_address_value(p, b, &y) { return }
    equal bool = x.symbol == y.symbol
    if !equal && (k != 8 || x.offset != 0 || y.offset != 0) { return }
    if k == 11 {
        elem u32 = ty_node(ty_unqual(ty)).elem
        stride u64 = if ty_is_void(elem) || ty_is_func(elem) { 1 } else { ty_size(elem) }
        if stride == 0 || stride > 0x7fffffffffffffff { return }
        delta i64 = x.offset - y.offset
        step i64 = bitcast[i64](stride)
        if delta % step != 0 { return }
        n.value = bitcast[u64](delta / step)
    } else {
        eq bool = equal && x.offset == y.offset
        less bool = x.offset < y.offset
        yes bool = eq
        if pa_is(p, t, c"!=") { yes = !eq }
        else if pa_is(p, t, c"<") { yes = less }
        else if pa_is(p, t, c">") { yes = !less && !eq }
        else if pa_is(p, t, c"<=") { yes = less || eq }
        else if pa_is(p, t, c">=") { yes = !less }
        n.value = if yes { 1 } else { 0 }
    }
    n.flags |= NF_STATIC | NF_FOLD
}

fn se_binary(p handle[Parser], t Token, a handle[Ast], b handle[Ast]) handle[Ast] fails {
    x u32 = se_decay(a.ty)
    y u32 = se_decay(b.ty)
    k u8 = expr_prec(p.names, t)
    n handle[Ast] = pa_node(ND_BINARY, t.loc, TY_INVALID)
    n.op = t.payload
    n.a = a
    n.b = b
    if x == TY_INVALID || y == TY_INVALID { return n }
    if se_assign_word(p, t) {
        try se_modifiable(p, a)
        if pa_is(p, t, c"=") { try se_conversion(p, x, b); n.b = se_convert(x, b) }
        else {
            word Bytes = cc_spelling(p.names, t)
            base u32 = cc_intern(p.names, bytes_sub(word, 0, word.n - 1))
            calc handle[Ast] = try se_binary(p, cc_token(TK_PUNCT, 0, t.loc, base), a, b)
            try se_conversion(p, x, calc)
            n.operand_ty = calc.operand_ty
        }
        n.ty = x
        return n
    }
    if k == 1 { n.ty = y; return n }
    if k == 3 || k == 4 {
        try se_scalar(p, a)
        try se_scalar(p, b)
        n.ty = TY_INT
        known u32 = NF_INT_VALUE | NF_FLOAT_CONST
        stop bool = (a.flags & known) != 0 && (if k == 3 { se_truth(a) } else { !se_truth(a) })
        n.flags = (a.flags | b.flags) & NF_OVERFLOW
        if stop { n.flags = a.flags & NF_OVERFLOW }
        if stop || ((a.flags & known) != 0 && (b.flags & known) != 0) {
            ice bool = (a.flags & NF_ICE) != 0 && (stop || (b.flags & NF_ICE) != 0)
            n.flags |= NF_STATIC | (if ice { NF_ICE } else { NF_FOLD })
            n.value = if (if k == 3 { se_truth(a) || se_truth(b) } else { se_truth(a) && se_truth(b) }) { 1 } else { 0 }
        }
        return n
    }
    compare bool = k == 8 || k == 9
    if ty_is_vector(x) || ty_is_vector(y) {
        vec_ty u32 = if ty_is_vector(x) { x } else { y }
        other u32 = if ty_is_vector(x) { y } else { x }
        v handle[TypeNode] = ty_node(ty_unqual(vec_ty))
        elem u32 = v.elem
        other_elem u32 = other
        if ty_is_vector(other) {
            other_vec handle[TypeNode] = ty_node(ty_unqual(other))
            other_elem = other_vec.elem
            // GNU integer vectors with the same lane widths may differ in
            // signedness. The left vector supplies the result type.
            if !ty_compatible(vec_ty, other) && !(pa_is_gnu(p) && v.aux1 == other_vec.aux1 &&
                ty_is_integer(elem) && ty_is_integer(other_elem) &&
                ty_int_bits(elem) == ty_int_bits(other_elem)) {
                try pa_error(p, t.loc, c"incompatible vector operands")
            }
        } else if !ty_is_arith(other) { try pa_error(p, t.loc, c"incompatible vector operands") }
        if ((k >= 5 && k <= 7) || k == 10 || pa_is(p, t, c"%")) &&
            (!ty_is_integer(elem) || !ty_is_integer(other_elem)) {
            try pa_error(p, t.loc, c"vector operator requires integer operands")
        }
        n.ty = vec_ty
        if compare {
            n.operand_ty = vec_ty
            // A floating-point comparison produces signed integer mask lanes.
            if ty_is_real_float(elem) {
                size u64 = ty_size(elem)
                elem = if size == 2 { TY_SHORT } else if size == 4 { TY_INT } else if size == 8 { TY_LONG } else { TY_INT128 }
                n.ty = ty_vector(elem, v.aux1)
            }
        }
        return n
    }
    ptr_x bool = ty_is_ptr(x)
    ptr_y bool = ty_is_ptr(y)
    if (ptr_x || ptr_y) && k == 11 {
        if ptr_x && ptr_y && pa_is(p, t, c"-") && se_ptr_compatible(x, y, false) {
            try se_pointer_math(p, t, x)
            try se_pointer_math(p, t, y)
            n.ty = TY_LONG
            se_fold_pointer(p, t, n, a, b, x, k)
            return n
        }
        if (ptr_x && ty_is_integer(y)) || (ptr_y && ty_is_integer(x) && pa_is(p, t, c"+")) {
            n.ty = if ptr_x { x } else { y }
            try se_pointer_math(p, t, n.ty)
            if (a.flags & NF_STATIC) != 0 && (b.flags & NF_STATIC) != 0 { n.flags |= NF_STATIC }
            return n
        }
    }
    if compare && (ptr_x || ptr_y || ty_is_nullptr(x) || ty_is_nullptr(y)) {
        if (ptr_x && ptr_y && se_ptr_compatible(x, y, false)) ||
            (k == 8 && ((ptr_x && se_null(b)) || (ptr_y && se_null(a)) || (se_null(a) && se_null(b)))) {
            n.ty = TY_INT
            se_fold_pointer(p, t, n, a, b, x, k)
            return n
        }
        if pa_is_gnu(p) && ptr_x && ptr_y {
            cc_diag(p.names, t.loc, c"warning: ", bytes_c(c"comparison of distinct pointer types"))
            n.ty = TY_INT
            return n
        }
        if pa_is_gnu(p) && ((ptr_x && ty_is_integer(y)) || (ptr_y && ty_is_integer(x))) {
            cc_diag(p.names, t.loc, c"warning: ", bytes_c(c"comparison between pointer and integer"))
            n.ty = TY_INT
            return n
        }
        try pa_error(p, t.loc, c"incompatible operands to pointer comparison")
    }
    integer bool = (k >= 5 && k <= 7) || k == 10 || pa_is(p, t, c"%")
    if !ty_is_arith(x) || !ty_is_arith(y) || (integer && (!ty_is_integer(x) || !ty_is_integer(y))) ||
        (k == 9 && (ty_is_complex(x) || ty_is_complex(y))) {
        try pa_error(p, t.loc, c"invalid binary arithmetic operands")
    }
    ty u32 = if k == 10 { se_promote_expr(a) } else { se_arith_type(a, b) }
    n.ty = if compare { TY_INT } else { ty }
    n.operand_ty = ty
    n.flags = (a.flags | b.flags) & NF_OVERFLOW
    if pa_is_gnu(p) && (a.flags & NF_STATIC) != 0 && (b.flags & NF_STATIC) != 0 && k == 11 { n.flags |= NF_STATIC }
    if ty_is_integer(ty) && (a.flags & NF_INT_VALUE) != 0 && (b.flags & NF_INT_VALUE) != 0 {
        n.flags |= NF_STATIC | (if (a.flags & b.flags & NF_ICE) != 0 { NF_ICE } else { NF_FOLD })
        if ty_int_bits(ty) > 64 { wi_binary(p, t, n, a, b, ty, k) }
        else { se_fold_int(p, t, n, a, b, ty, k) }
    } else if (ty_is_real_float(ty) || ty_is_complex(ty)) && (a.flags & (NF_INT_VALUE | NF_FLOAT_CONST)) != 0 &&
        (b.flags & (NF_INT_VALUE | NF_FLOAT_CONST)) != 0 {
        n.flags |= NF_STATIC
        se_fold_float(p, t, n, a, b, k)
        if compare { n.flags |= NF_FOLD }
    }
    return n
}

fn se_conditional(p handle[Parser], t Token, cond handle[Ast], a handle[Ast], b handle[Ast]) handle[Ast] fails {
    try se_scalar(p, cond)
    x u32 = se_decay(a.ty)
    y u32 = se_decay(b.ty)
    ty u32 = TY_INVALID
    if pa_is_gnu(p) && (ty_is_void(x) || ty_is_void(y)) { ty = TY_VOID }
    else if ty_is_arith(x) && ty_is_arith(y) { ty = se_arith_type(a, b) }
    else if ty_compatible(x, y) { ty = ty_composite(x, y) }
    else if ty_is_ptr(x) && se_null(b) { ty = x }
    else if ty_is_ptr(y) && se_null(a) { ty = y }
    else if ty_is_ptr(x) && ty_is_ptr(y) && se_ptr_compatible(x, y, false) {
        px u32 = ty_node(ty_unqual(x)).elem
        py u32 = ty_node(ty_unqual(y)).elem
        elem u32 = TY_VOID
        if !ty_is_void(px) && !ty_is_void(py) {
            unqual_x u32 = if ty_is_array(px) { ty_typeof_unqual(px) } else { ty_unqual(px) }
            unqual_y u32 = if ty_is_array(py) { ty_typeof_unqual(py) } else { ty_unqual(py) }
            elem = ty_composite(unqual_x, unqual_y)
        }
        ty = ty_ptr(ty_qual(elem, se_array_quals(px) | se_array_quals(py)))
    } else if x != TY_INVALID && y != TY_INVALID { try pa_error(p, t.loc, c"incompatible conditional operands") }
    n handle[Ast] = pa_node(ND_COND, t.loc, ty)
    n.a = cond
    n.b = a
    n.c = b
    if (cond.flags & (NF_INT_VALUE | NF_FLOAT_CONST)) != 0 {
        chosen handle[Ast] = if se_truth(cond) { a } else { b }
        se_cast_constant(n, chosen)
        n.flags |= cond.flags & NF_OVERFLOW
        if (cond.flags & NF_ICE) == 0 && (n.flags & NF_ICE) != 0 {
            n.flags = (n.flags & ~NF_ICE) | NF_FOLD
        }
    }
    return n
}
