// Lower a direct call's body into the caller using the normal C lowering
// rules. Parameter slots, return edges and labels are private to this copy.

fn gen_direct_callee(n handle[Ast]) handle[Symbol] {
    if n == null { return null }
    while n != null && n.kind == ND_UNARY {
        op Bytes = sym_name(&gc.p.ctx.syms, n.op)
        if !bytes_eq_c(op, c"&") && !bytes_eq_c(op, c"*") { return null }
        n = n.a
    }
    if n != null && n.kind == ND_NAME && n.decl != null && ty_is_func(n.decl.ty) {
        return n.decl
    }
    return null
}

// Recover a function designator after substituting an immutable pointer
// argument, or from the final expression of a GNU statement expression.
// The caller still evaluates the statement expression for its side effects.
fn gen_known_callee(n handle[Ast], callee_ty u32) handle[Symbol] fails {
    if !ty_is_func(callee_ty) { return null }
    if n.kind == ND_BLOCK {
        tail handle[Ast] = n.a
        if tail == null { return null }
        while tail.next != null { tail = tail.next }
        if tail.kind != ND_STMT || tail.op != 0 || tail.a == null { return null }
        n = tail.a
    } else {
        n = try gen_inline_fold(n, false)
    }
    while n != null {
        if n.kind == ND_CAST {
            from u32 = se_decay(n.a.ty)
            if !ty_is_ptr(from) || !ty_compatible(ty_node(from).elem, callee_ty) { return null }
        } else if n.kind == ND_UNARY {
            op Bytes = sym_name(&gc.p.ctx.syms, n.op)
            if !bytes_eq_c(op, c"&") && !bytes_eq_c(op, c"*") { return null }
        } else {
            break
        }
        n = n.a
    }
    if n == null || n.kind != ND_NAME || n.decl == null || !ty_is_func(n.decl.ty) { return null }
    sym handle[Symbol] = n.decl
    if ty_node(ty_unqual(sym.ty)).flags != ty_node(callee_ty).flags ||
       !ty_compatible(ty_unqual(sym.ty), callee_ty) || gen_is_returns_twice(sym) { return null }
    // An indirect use of an always_inline function remains valid when
    // its body cannot be substituted, for example on an indirect recursion.
    name u32 = gen_sym_fir_name_id(sym)
    key U64Key = {zext[u64](name)}
    def handle[GenInlineDef] = handle_from_addr(table_get(&gc.inline_defs, &key) catch null)
    if gen_has_attr(sym.attrs, c"always_inline") ||
       (def != null && gen_has_attr(def.node.decl.attrs, c"always_inline")) {
        if def == null || def.refuse != null || gen_inline_active(name, def) { return null }
    }
    return sym
}

fn gen_lazy_inline(s handle[Symbol]) bool {
    return (s.flags & SF_GNU_EXTERN_INLINE) != 0 ||
        ((s.flags & 1) != 0 && gen_sym_linkage(s) == FIR_LOCAL &&
         !gen_has_attr(s.attrs, c"used") && !gen_has_attr(s.attrs, c"retain") &&
         !gen_has_attr(s.attrs, c"constructor") && !gen_has_attr(s.attrs, c"destructor"))
}

// These constructs observe the callee's own stack frame or can expose
// its code addresses. Give a diagnostic if a required call uses them.
fn gen_inline_blocker(n handle[Ast], def handle[GenInlineDef], budget handle[U64Key], optional bool) addr {
    while n != null {
        if optional && budget.v == 0 { return c"body exceeds the inline size limit" }
        if optional { budget.v -= 1 }
        if n.kind == ND_CALL {
            callee handle[Symbol] = gen_direct_callee(n.a)
            if callee != null && gen_is_returns_twice(callee) { return c"body calls a returns_twice function" }
            if n.a != null && n.a.kind == ND_NAME {
                name Bytes = sym_name(&gc.p.ctx.syms, n.a.op)
                if bytes_eq_c(name, c"__builtin_setjmp") { return c"body calls a returns_twice function" }
                if bytes_eq_c(name, c"__builtin_alloca") || bytes_eq_c(name, c"__builtin_alloca_with_align") ||
                   (bytes_eq_c(name, c"alloca") && (callee == null || !callee.defined)) {
                    if optional { return c"body allocates dynamic stack storage" }
                    def.uses_alloca = true
                }
            }
        } else if n.kind == ND_UNARY && ast_extra(n) != null && bytes_eq_c(sym_name(&gc.p.ctx.syms, n.op), c"&&") {
            return c"body takes the address of a label"
        } else if (n.kind == ND_DECL && n.decl != null && se_variably_modified(n.decl.ty)) ||
                   (n.kind == ND_CAST && se_variably_modified(n.ty)) ||
                   (n.kind == ND_SIZE && (n.flags & NF_ICE) == 0) {
            if optional { return c"body uses a variably modified type" }
            def.uses_vla = true
        }
        for i u32 in 0..4 {
            child handle[Ast] = if i == 0 { n.a } else if i == 1 { n.b } else if i == 2 { ast_c(n) } else { ast_d(n) }
            why addr = gen_inline_blocker(child, def, budget, optional)
            if why != null { return why }
        }
        n = n.next
    }
    return null
}

fn gen_register_inline(node handle[Ast]) void fails {
    s handle[Symbol] = node.decl
    key U64Key = {zext[u64](gen_sym_fir_name_id(s))}
    if gen_lazy_inline(s) {
        _ bool = table_put(&gc.lazy_bodies, &key, handle_addr(node))
    }
    gen_note_inline_constant(s, node.a, trunc[u32](key.v))
    required bool = gen_has_attr(s.attrs, c"always_inline")
    optional bool = gc.optimize_inline && (s.flags & 1) != 0 && gen_sym_linkage(s) == FIR_LOCAL
    if !required && !optional { return }
    def handle[GenInlineDef] = pa_tu_alloc[GenInlineDef](gc.p)
    def.node = node
    signature handle[TypeNode] = ty_node(ty_unqual(node.ty))
    if gen_has_attr(s.attrs, c"noinline") { def.refuse = c"function is marked noinline" }
    else if (signature.flags & TYF_VARIADIC) != 0 { def.refuse = c"function is variadic" }
    else if gen_has_attr(s.attrs, c"naked") || gen_has_attr(s.attrs, c"interrupt") {
        def.refuse = c"function has a special entry or return sequence"
    } else if gen_is_returns_twice(s) { def.refuse = c"function is marked returns_twice" }
    else {
        pm handle[Param] = handle_from_addr(s.params)
        while pm != null {
            if se_variably_modified(pm.ty) || (pm.declared_ty != TY_INVALID && se_variably_modified(pm.declared_ty)) {
                if !required {
                    def.refuse = c"function has a variably modified parameter"
                    break
                }
                def.uses_vla = true
            }
            pm = pm.next
        }
        if def.refuse == null {
            // The count includes both branch arms and the syntax of each
            // asm operand. Keep small arithmetic and asm helpers eligible.
            budget U64Key = {96}
            def.refuse = gen_inline_blocker(node.a, def, &budget, !required)
        }
    }
    if def.refuse != null && !required { return }
    def.protect = gc.stack_protector != 0 && (gen_has_attr(s.attrs, c"stack_protect") ||
        (gc.stack_protector <= 2 && gen_protect_body(node.a, gc.stack_protector == 2)))
    _ bool = table_put(&gc.inline_defs, &key, handle_addr(def))
}

fn gen_inline_active(name u32, def handle[GenInlineDef]) bool {
    if gc.cur_fn_name == name { return true }
    active handle[GenInlineFrame] = gc.inline_frame
    while active != null {
        if active.fn_sym == def.node.decl { return true }
        active = active.parent
    }
    return false
}

// Decline an optional expansion if doing it would make a later required
// call recursive. Traverse only required calls: another optional call
// can make its own decision when it is reached.
fn gen_required_reaches_active(n handle[Ast], seen handle[Vec[u32]]) bool {
    while n != null {
        if n.kind == ND_CALL {
            s handle[Symbol] = gen_direct_callee(n.a)
            if s != null {
                name u32 = gen_sym_fir_name_id(s)
                key U64Key = {zext[u64](name)}
                def handle[GenInlineDef] = handle_from_addr(table_get(&gc.inline_defs, &key) catch null)
                if def != null && def.refuse == null &&
                   (gen_has_attr(s.attrs, c"always_inline") || gen_has_attr(def.node.decl.attrs, c"always_inline")) {
                    if gen_inline_active(name, def) { return true }
                    visited bool = false
                    for i usize in 0..seen.n {
                        if vec_get(seen, i) == name { visited = true; break }
                    }
                    if !visited {
                        vec_push(seen, name)
                        if gen_required_reaches_active(def.node.a, seen) { return true }
                    }
                }
            }
        }
        if gen_required_reaches_active(n.a, seen) || gen_required_reaches_active(n.b, seen) ||
           gen_required_reaches_active(ast_c(n), seen) || gen_required_reaches_active(ast_d(n), seen) { return true }
        n = n.next
    }
    return false
}

fn gen_inline_target(s handle[Symbol], loc u32) handle[GenInlineDef] fails {
    key U64Key = {zext[u64](gen_sym_fir_name_id(s))}
    value addr = table_get(&gc.inline_defs, &key) catch null
    required bool = gen_has_attr(s.attrs, c"always_inline")
    if value == null && !required { return null }
    def handle[GenInlineDef] = handle_from_addr(value)
    why addr = if def == null { c"definition is unavailable" } else { def.refuse }
    if def != null { required = required || gen_has_attr(def.node.decl.attrs, c"always_inline") }
    if why == null {
        if !required && (gc.optional_inlines >= 96 || gc.inline_depth >= 4) { return null }
        if gen_inline_active(trunc[u32](key.v), def) { why = c"recursive call" }
    }
    if why != null {
        if required {
            message Buf = {}
            defer { buf_free(&message) }
            buf_str(&message, c"cannot inline always_inline function '")
            buf_append(&message, gen_sym_bytes(trunc[u32](key.v)))
            buf_str(&message, c"': ")
            buf_str(&message, why)
            buf_u8(&message, 0)
            try pa_error(gc.p, loc, message.p)
        }
        return null
    }
    if !required {
        seen Vec[u32] = {}
        defer { vec_free(&seen) }
        if (gc.inline_frame != null || gen_has_attr(gc.cur_fn.attrs, c"always_inline")) &&
            gen_required_reaches_active(def.node.a, &seen) { return null }
        gc.optional_inlines += 1
    }
    return def
}

// An internal inline configuration stub can be replaced by its constant
// after evaluating the call's arguments. Keep its body for address-taking.
fn gen_note_inline_constant(s handle[Symbol], body handle[Ast], nid u32) void {
    if s.linkage != 1 || (s.flags & 1) == 0 || gen_has_attr(s.attrs, c"noinline") { return }
    if body.kind != ND_BLOCK { return }
    ty u32 = ty_node(ty_unqual(s.ty)).elem
    stmt handle[Ast] = body.a
    expr handle[Ast] = body
    if stmt != null {
        // A constant guard may return before the ordinary fallback.
        while stmt.kind == ND_STMT && stmt.op != 0 &&
              bytes_eq_c(sym_name(&gc.p.ctx.syms, stmt.op), c"if") && stmt.a != null &&
              ty_is_integer(stmt.a.ty) && (stmt.a.flags & (NF_ICE | NF_OVERFLOW)) == NF_ICE {
            if se_truth(stmt.a) { stmt = stmt.b; break }
            if ast_c(stmt) != null { return }
            stmt = stmt.next
            if stmt == null { return }
        }
        if stmt == null || stmt.kind != ND_STMT || stmt.op == 0 ||
            !bytes_eq_c(sym_name(&gc.p.ctx.syms, stmt.op), c"return") { return }
        if stmt.a != null { expr = stmt.a }
    }
    if !ty_is_void(ty) {
        if expr == body { return }
        if ty_is_ptr(ty) {
            if se_variably_modified(expr.ty) { return }
            if (expr.flags & (NF_ICE | NF_OVERFLOW)) != NF_ICE &&
                !(expr.kind == ND_CAST && expr.b == null && expr.a != null &&
                  (expr.a.flags & (NF_ICE | NF_OVERFLOW)) == NF_ICE && se_null(expr.a)) { return }
            if !se_null(expr) && !(expr.kind == ND_CAST && expr.a != null && se_null(expr.a)) { return }
        } else if !ty_is_integer(ty) || !ty_is_integer(expr.ty) ||
            (expr.flags & (NF_ICE | NF_OVERFLOW)) != NF_ICE { return }
    } else if expr != body { return }
    pm handle[Param] = handle_from_addr(s.params)
    while pm != null {
        if se_variably_modified(pm.ty) || se_variably_modified(pm.declared_ty) { return }
        pm = pm.next
    }
    key U64Key = {zext[u64](nid)}
    _ bool = table_put(&gc.inline_constants, &key, handle_addr(expr))
}

fn gen_inline_constant(s handle[Symbol]) handle[Ast] {
    if gc.inline_constants.n == 0 { return null }
    key U64Key = {zext[u64](gen_sym_fir_name_id(s))}
    expr addr = table_get(&gc.inline_constants, &key) catch null
    return handle_from_addr(expr)
}

fn gen_inline_param_lvalue(n handle[Ast], param handle[Symbol]) bool {
    if n == null { return false }
    if n.kind == ND_GENERIC { return gen_inline_param_lvalue(n.b, param) }
    return n.kind == ND_NAME && n.decl == param
}

// Treat a parameter as constant only if its initial value cannot be
// replaced before the asm, including through an escaped address.
fn gen_inline_param_fixed(n handle[Ast], param handle[Symbol]) bool {
    if n == null { return true }
    if (n.kind == ND_DECL && n.decl != null && se_variably_modified(n.decl.ty)) ||
       (n.kind == ND_CAST && se_variably_modified(n.ty)) ||
       (n.kind == ND_SIZE && (n.flags & NF_ICE) == 0) { return false }
    if n.kind == ND_UNARY {
        op Bytes = sym_name(&gc.p.ctx.syms, n.op)
        if (bytes_eq_c(op, c"&") || bytes_eq_c(op, c"++") || bytes_eq_c(op, c"--")) &&
           gen_inline_param_lvalue(n.a, param) { return false }
    } else if n.kind == ND_BINARY && se_is_assign(n.op_kind) {
        if gen_inline_param_lvalue(n.a, param) { return false }
    } else if n.kind == ND_ASM && ty_is_void(n.ty) {
        out handle[Ast] = n.b
        while out != null {
            if gen_inline_param_lvalue(out.b, param) { return false }
            out = out.next
        }
        inp handle[Ast] = ast_c(n)
        while inp != null {
            if gen_inline_param_lvalue(inp.b, param) {
                constraint Buf = {}
                gen_asm_constraint(inp, &constraint)
                needs_slot bool = gen_asm_memory_input(buf_bytes(&constraint))
                buf_free(&constraint)
                if needs_slot { return false }
            }
            inp = inp.next
        }
    } else if n.kind == ND_CALL && gen_inline_param_lvalue(n.b, param) {
        if n.a == null && bytes_eq_c(sym_name(&gc.p.ctx.syms, n.op), c"__builtin_va_arg") { return false }
        if n.a != null && n.a.kind == ND_NAME && n.a.decl == null {
            name Bytes = sym_name(&gc.p.ctx.syms, n.a.op)
            if bytes_eq_c(name, c"__builtin_ms_va_copy") || bytes_eq_c(name, c"__builtin_ms_va_start") {
                return false
            }
        }
    }
    return gen_inline_param_fixed(n.a, param) && gen_inline_param_fixed(n.b, param) &&
           gen_inline_param_fixed(ast_c(n), param) && gen_inline_param_fixed(ast_d(n), param) &&
           gen_inline_param_fixed(n.next, param)
}

// Leading declarations dominate the rest of the block when control can
// only enter at its start. Keep immutable scalar initializers for asm
// immediates, including locals initialized from an inlined parameter.
fn gen_asm_block_locals(body handle[Ast]) void fails {
    decl handle[Ast] = body.a
    checked_labels bool = false
    while decl != null && decl.kind == ND_DECL {
        s handle[Symbol] = decl.decl
        if s != null && s.linkage == 0 && (s.storage == SC_NONE || s.storage == SC_AUTO ||
           s.storage == SC_REGISTER || s.storage == SC_CONSTEXPR) && s.cleanup == null &&
           !s.thread_local && (ty_quals(s.ty) & (Q_VOLATILE | Q_ATOMIC)) == 0 && s.value != null &&
           (ty_is_ptr(s.ty) || ty_is_integer(s.ty)) {
            value handle[Ast] = try gen_inline_fold(handle_from_addr(s.value), false)
            constant bool = if ty_is_ptr(s.ty) { (value.flags & NF_STATIC) != 0 }
                            else { (value.flags & NF_INT_VALUE) != 0 && (value.flags & NF_OVERFLOW) == 0 }
            if constant && gen_inline_param_fixed(body.a, s) {
                if !checked_labels {
                    if cur_switch != null || gen_defines_label(body) { return }
                    checked_labels = true
                }
                key U64Key = {addr_bits(handle_addr(s))}
                converted handle[Ast] = se_convert(gc.p, s.ty, value)
                if gc.inline_frame != null {
                    _ bool = table_put(&gc.inline_frame.constants, &key, handle_addr(converted))
                } else {
                    _ bool = table_put(&gc.immediate_locals, &key, handle_addr(converted))
                }
            }
        }
        decl = decl.next
    }
}

// Reapply only the normal scalar constant rules. Leave the original trees
// intact for later calls with different arguments and for diagnostic locations.
fn gen_inline_fold(n handle[Ast], at_entry bool) handle[Ast] fails {
    if n == null || (n.flags & NF_INT_VALUE) != 0 ||
       (gc.inline_frame == null && gc.immediate_locals.n == 0) { return n }
    if n.kind == ND_NAME && n.decl != null {
        key U64Key = {addr_bits(handle_addr(n.decl))}
        value addr = table_get(&gc.immediate_locals, &key) catch null
        if gc.inline_frame != null && value == null {
            value = table_get(&gc.inline_frame.constants, &key) catch null
            if at_entry && value == null { value = table_get(&gc.inline_frame.entry_constants, &key) catch null }
        }
        if value != null { return handle_from_addr(value) }
        return n
    }
    if n.kind == ND_COND {
        cond handle[Ast] = try gen_inline_fold(n.a, at_entry)
        if (cond.flags & NF_INT_VALUE) == 0 || (cond.flags & NF_OVERFLOW) != 0 { return n }
        return se_convert(gc.p, n.ty, try gen_inline_fold(if se_truth(cond) { n.b } else { ast_c(n) }, at_entry))
    }
    if n.kind == ND_GENERIC { return try gen_inline_fold(n.b, at_entry) }
    if n.kind != ND_CAST && n.kind != ND_UNARY && n.kind != ND_BINARY &&
       n.kind != ND_SUBSCRIPT && n.kind != ND_MEMBER { return n }
    a handle[Ast] = try gen_inline_fold(n.a, at_entry)
    b handle[Ast] = try gen_inline_fold(n.b, at_entry)
    if a == n.a && b == n.b { return n }
    op Token = tok_make(n.op_kind, 0, 0, n.loc, 0)
    if n.kind == ND_UNARY {
        if op.kind == TK_INC || op.kind == TK_DEC { return n }
        return try se_unary(gc.p, op, a, false)
    }
    if n.kind == ND_BINARY {
        if se_is_assign(op.kind) { return n }
        return try se_binary(gc.p, op, a, b)
    }

    rewritten handle[Ast] = pa_tu_alloc[Ast](gc.p)
    copy_into(rewritten, n)
    rewritten.a = a
    rewritten.b = b
    if n.kind == ND_CAST {
        rewritten.flags &= NF_IMPLICIT
        se_cast_constant(gc.p, rewritten, a)
    } else {
        address bool = if n.kind == ND_SUBSCRIPT { (a.flags & b.flags & NF_STATIC) != 0 }
                       else if ty_is_ptr(a.ty) { (a.flags & NF_STATIC) != 0 }
                       else { (a.flags & NF_ADDR) != 0 }
        if address {
            rewritten.flags |= NF_ADDR
            if ty_is_array(rewritten.ty) { rewritten.flags |= NF_STATIC }
        }
    }
    return rewritten
}

value struct GenInlineArg {
    value u32
    ty u32
    expr handle[Ast]
}

fn gen_inline_call(call handle[Ast], def handle[GenInlineDef]) u32 fails {
    args Vec[GenInlineArg] = {}
    defer { vec_free(&args) }
    arg handle[Ast] = call.b
    while arg != null {
        av u32 = try gen_rvalue(arg)
        if gen_is_terminated() { return gen_const_zero(call.ty) }
        folded handle[Ast] = try gen_inline_fold(arg, false)
        vec_push[GenInlineArg](&args, {av, arg.ty, folded})
        arg = arg.next
    }
    return try gen_inline_body(def, &args)
}

fn gen_inline_body(def handle[GenInlineDef], args handle[Vec[GenInlineArg]]) u32 fails {
    node handle[Ast] = def.node
    s handle[Symbol] = node.decl
    signature handle[TypeNode] = ty_node(ty_unqual(node.ty))
    outer handle[GenInlineFrame] = gc.inline_frame
    frame GenInlineFrame = {}
    frame.parent = outer
    frame.fn_sym = s
    frame.ret_ty = signature.elem
    frame.cleanup_depth = gc.cleanups.n
    frame.vla_depth = gc.vla_stack.n
    frame.return_block = gen_new_block()
    if !ty_is_void(frame.ret_ty) {
        frame.result = gen_alloca_entry(ty_size(frame.ret_ty), ty_align(frame.ret_ty))
    }
    defer {
        table_free(&frame.constants)
        table_free(&frame.pointer_args)
        table_free(&frame.entry_constants)
        table_free(&frame.vla_sizes)
        table_free(&frame.labels)
        vec_free(&frame.addr_taken)
    }
    pm handle[Param] = handle_from_addr(s.params)
    // A bare first asm reads the incoming arguments before any of its own
    // outputs can overwrite them. It cannot be reentered through a C label.
    if !def.uses_vla && node.a.kind == ND_BLOCK && node.a.a != null && node.a.a.kind == ND_ASM {
        frame.entry_asm = node.a.a
    }
    for i usize in 0..args.n {
        if pm == null { break }
        ps handle[Symbol] = pm.decl
        pm = pm.next
        if ps == null { continue }
        arg GenInlineArg = vec_get(args, i)
        av u32 = gen_convert(arg.value, arg.ty, ps.ty)
        key U64Key = {addr_bits(handle_addr(ps))}
        pointer bool = ty_is_ptr(ps.ty)
        unqualified bool = (ty_quals(ps.ty) & (Q_VOLATILE | Q_ATOMIC)) == 0 && !def.uses_vla
        folded handle[Ast] = arg.expr
        constant handle[Ast] = null
        if folded != null && unqualified {
            if ty_is_integer(ps.ty) && ty_int_bits(ps.ty) <= 64 &&
               ty_is_integer(folded.ty) && (folded.flags & NF_INT_VALUE) != 0 && (folded.flags & NF_OVERFLOW) == 0 {
                constant = pa_node(gc.p, ND_INT, folded.loc, ps.ty)
                constant.value = se_convert(gc.p, ps.ty, folded).value
                constant.flags = NF_ICE | NF_STATIC
            } else if pointer && (folded.flags & NF_STATIC) != 0 {
                constant = se_convert(gc.p, ps.ty, folded)
            }
        }
        fixed bool = unqualified && (pointer || constant != null) && gen_inline_param_fixed(node.a, ps)
        if pointer && fixed {
            // Keep a read-only pointer argument in SSA. Storing it in a
            // private home would look like an escape of the pointee to Fir.
            _ bool = table_put(&frame.pointer_args, &key, av)
        } else {
            slot u32 = gen_alloca_entry(ty_size(ps.ty), ty_align(ps.ty))
            if gen_is_mem_ty(ps.ty) {
                gen_memcpy_const(slot, av, ty_size(ps.ty), gen_is_volatile(ps.ty))
            } else { gen_store_ty(av, slot, ty_align(ps.ty), gen_is_volatile(ps.ty), gen_is_atomic(ps.ty)) }
            _ bool = table_put(&gc.locals, &key, slot)
        }
        if constant != null {
            if fixed {
                _ bool = table_put(&frame.constants, &key, handle_addr(constant))
            } else if frame.entry_asm != null {
                _ bool = table_put(&frame.entry_constants, &key, handle_addr(constant))
            }
        }
    }

    if def.protect { gc.inline_needs_guard = true }
    if (node.flags & NF_FENV) != 0 { gc.has_fenv = true }
    saved_switch handle[SwitchInfo] = cur_switch
    cur_switch = null
    caller_has_alloca bool = gc.has_alloca
    gc.has_alloca = def.uses_alloca
    gc.inline_frame = &frame
    gc.inline_depth += 1
    defer {
        gc.inline_depth -= 1
        gc.inline_frame = outer
        gc.has_alloca = caller_has_alloca
        cur_switch = saved_switch
    }
    // Dynamic storage allocated by the helper belongs to this invocation.
    saved_sp u32 = if def.uses_alloca || def.uses_vla { gen_stacksave() } else { 0 }
    if def.uses_vla {
        frame.entry_block = gen_new_block()
        start u32 = gen_new_block()
        gen_term_jump(frame.entry_block)
        gen_switch_block(frame.entry_block)
        gen_term_jump(start)
        gen_switch_block(start)
        bound handle[Param] = handle_from_addr(s.params)
        while bound != null {
            if bound.declared_ty != TY_INVALID { try gen_eval_vm_type(bound.declared_ty) }
            bound = bound.next
        }
    }
    try gen_stmt(node.a)
    if !gen_is_terminated() { gen_term_jump(frame.return_block) }
    gen_switch_block(frame.return_block)
    if saved_sp != 0 { gen_stackrestore(saved_sp) }
    if frame.result == 0 { return gen_const_i32(0) }
    if gen_is_mem_ty(frame.ret_ty) { return frame.result }
    return gen_load_ty(frame.ret_ty, frame.result, ty_align(frame.ret_ty), false, false)
}

fn gen_inline_return(n handle[Ast]) void fails {
    frame handle[GenInlineFrame] = gc.inline_frame
    if n.a != null {
        v u32 = try gen_rvalue(n.a)
        if frame.result != 0 {
            converted u32 = gen_convert(v, n.a.ty, frame.ret_ty)
            if gen_is_mem_ty(frame.ret_ty) {
                gen_memcpy_const(frame.result, converted, ty_size(frame.ret_ty), false)
            } else { gen_store_ty(converted, frame.result, ty_align(frame.ret_ty), false, false) }
        }
    }
    try gen_run_cleanups_to(frame.cleanup_depth)
    gen_restore_vlas_to(frame.vla_depth)
    gen_term_jump(frame.return_block)
}
