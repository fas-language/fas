// Builtins that have no ordinary function prototype still have argument
// constraints. Keep their typed call nodes intact for code generation.
fn se_builtin_count(p handle[Parser], t Token, n u32, min u32, max u32) void fails {
    if n < min || n > max { try pa_error(p, t.loc, c"wrong number of builtin arguments") }
}

fn se_builtin_va_list(p handle[Parser], e handle[Ast]) void fails {
    name u32 = cc_intern(p.names, bytes_c(c"__builtin_va_list"))
    sysv handle[Symbol] = pa_lookup(p, name)
    name = cc_intern(p.names, bytes_c(c"__builtin_ms_va_list"))
    ms handle[Symbol] = pa_lookup(p, name)
    if ty_compatible(se_decay(e.ty), se_decay(sysv.ty)) || ty_compatible(se_decay(e.ty), se_decay(ms.ty)) { return }
    try pa_error(p, e.loc, c"variadic builtin requires a va_list argument")
}

fn se_builtin_overflow(name Bytes) bool {
    return bytes_eq_c(name, c"__builtin_add_overflow") || bytes_eq_c(name, c"__builtin_sub_overflow") ||
        bytes_eq_c(name, c"__builtin_mul_overflow")
}

fn se_builtin_checked(name Bytes) bool {
    return bytes_eq_c(name, c"__builtin_ckd_add") || bytes_eq_c(name, c"__builtin_ckd_sub") ||
        bytes_eq_c(name, c"__builtin_ckd_mul")
}

// GCC's classification values, with Clang's bool result. The caller
// performs the ordinary array and function conversions before classifying.
fn se_builtin_type_class(ty u32) u64 {
    if ty_is_void(ty) { return 0 }
    if ty_is_bool(ty) { return 4 }
    if ty_is_integer(ty) { return 1 }
    if ty_is_ptr(ty) { return 5 }
    if ty_is_real_float(ty) { return 8 }
    if ty_is_complex(ty) { return 9 }
    if ty_kind(ty) == TYK_STRUCT { return 12 }
    if ty_kind(ty) == TYK_UNION { return 13 }
    if ty_is_vector(ty) { return 19 }
    return ~0
}

fn se_checked_integer(ty u32) bool {
    return ty_is_integer(ty) && ty_unqual(ty) != TY_CHAR && !ty_is_bool(ty) &&
        !ty_is_enum(ty) && !ty_is_bitint(ty)
}

fn se_check_overflow(p handle[Parser], t Token, args handle[Ast], count u32, checked bool) void fails {
    try se_builtin_count(p, t, count, 3, 3)
    b handle[Ast] = args.next
    out handle[Ast] = b.next
    if !ty_is_integer(args.ty) || !ty_is_integer(b.ty) ||
        (checked && (!se_checked_integer(args.ty) || !se_checked_integer(b.ty))) {
        try pa_error(p, t.loc, c"overflow builtin requires integer operands")
    }
    ptr u32 = se_decay(out.ty)
    if !ty_is_ptr(ptr) { try pa_error(p, out.loc, c"overflow builtin result requires a pointer to integer") }
    elem u32 = ty_node(ty_unqual(ptr)).elem
    if !ty_is_integer(elem) || ty_is_bool(elem) || ty_is_enum(elem) || (ty_quals(elem) & (Q_CONST | Q_ATOMIC)) != 0 ||
        (checked && !se_checked_integer(elem)) {
        try pa_error(p, out.loc, c"invalid integer type for overflow builtin result")
    }
}

fn se_builtin_predicate(name Bytes) bool {
    return bytes_eq_c(name, c"__builtin_isnan") || bytes_eq_c(name, c"__builtin_isinf") ||
        bytes_eq_c(name, c"__builtin_isinf_sign") || bytes_eq_c(name, c"__builtin_isfinite") ||
        bytes_eq_c(name, c"__builtin_isnormal") || bytes_eq_c(name, c"__builtin_issignaling")
}

fn se_builtin_ordered(name Bytes) bool {
    return bytes_eq_c(name, c"__builtin_isgreater") || bytes_eq_c(name, c"__builtin_isgreaterequal") ||
        bytes_eq_c(name, c"__builtin_isless") || bytes_eq_c(name, c"__builtin_islessequal") ||
        bytes_eq_c(name, c"__builtin_islessgreater") || bytes_eq_c(name, c"__builtin_isunordered")
}

fn se_builtin_alignment(p handle[Parser], e handle[Ast], bits bool) void fails {
    if !ty_is_integer(e.ty) || (e.flags & (NF_INT_VALUE | NF_OVERFLOW)) != NF_ICE {
        try pa_error(p, e.loc, c"builtin alignment requires a constant integer")
    }
    n u64 = e.value
    if n == 0 || (n & (n - 1)) != 0 || (bits && n < 8) ||
        (!ty_is_unsigned(e.ty) && bitcast[i64](n) < 0) {
        try pa_error(p, e.loc, c"builtin alignment is not a supported power of two")
    }
}

fn se_check_builtin_call(p handle[Parser], t Token, name Bytes, args handle[Ast], count u32) void fails {
    if se_builtin_overflow(name) || se_builtin_checked(name) {
        try se_check_overflow(p, t, args, count, se_builtin_checked(name))
    } else if bytes_eq_c(name, c"__builtin_va_start") || bytes_eq_c(name, c"__builtin_c23_va_start") ||
        bytes_eq_c(name, c"__builtin_ms_va_start") || bytes_eq_c(name, c"__builtin_va_end") ||
        bytes_eq_c(name, c"__builtin_ms_va_end") || bytes_eq_c(name, c"__builtin_va_copy") ||
        bytes_eq_c(name, c"__builtin_ms_va_copy") {
        copy_args bool = bytes_ends_with(name, bytes_c(c"_copy"))
        start bool = bytes_ends_with(name, bytes_c(c"_start"))
        try se_builtin_count(p, t, count, if copy_args { 2 } else { 1 }, if copy_args || start { 2 } else { 1 })
        try se_builtin_va_list(p, args)
        if copy_args { try se_builtin_va_list(p, args.next) }
        if start {
            func handle[Symbol] = p.function
            if func == null || (ty_node(ty_unqual(func.ty)).flags & TYF_VARIADIC) == 0 {
                try pa_error(p, t.loc, c"va_start requires a variadic function")
            }
        }
    } else if se_builtin_ordered(name) {
        try se_builtin_count(p, t, count, 2, 2)
        b handle[Ast] = args.next
        if !(ty_is_real_float(args.ty) || ty_is_real_float(b.ty)) ||
            !ty_is_arith(args.ty) || !ty_is_arith(b.ty) || ty_is_complex(args.ty) || ty_is_complex(b.ty) {
            try pa_error(p, t.loc, c"ordered comparison builtin requires real floating arguments")
        }
    } else if se_builtin_predicate(name) {
        try se_builtin_count(p, t, count, 1, 1)
        if !ty_is_real_float(args.ty) { try pa_error(p, args.loc, c"expected a real floating argument") }
    } else if bytes_eq_c(name, c"__builtin_assume_aligned") ||
        bytes_eq_c(name, c"__builtin_alloca_with_align") || bytes_eq_c(name, c"__builtin_alloca_with_align_and_max") {
        assume bool = bytes_eq_c(name, c"__builtin_assume_aligned")
        max u32 = if assume || bytes_ends_with(name, bytes_c(c"_max")) { 3 } else { 2 }
        try se_builtin_count(p, t, count, if max == 3 && !assume { 3 } else { 2 }, max)
        if assume {
            try se_conversion(p, ty_ptr(ty_qual(TY_VOID, Q_CONST | Q_VOLATILE)), args)
        } else if !ty_is_integer(args.ty) { try pa_error(p, args.loc, c"alloca size must be an integer") }
        try se_builtin_alignment(p, args.next, !assume)
    } else if bytes_eq_c(name, c"__builtin_assume_separate_storage") {
        try se_builtin_count(p, t, count, 2, 2)
        ptr u32 = ty_ptr(ty_qual(TY_VOID, Q_CONST | Q_VOLATILE))
        try se_conversion(p, ptr, args)
        try se_conversion(p, ptr, args.next)
    } else if bytes_eq_c(name, c"__builtin_set_flt_rounds") || bytes_eq_c(name, c"__builtin_popcount") ||
        bytes_eq_c(name, c"__builtin_clz") || bytes_eq_c(name, c"__builtin_ctz") {
        try se_builtin_count(p, t, count, 1, 1)
        try se_conversion(p, TY_INT, args)
    } else if bytes_eq_c(name, c"__builtin_cpu_supports") || bytes_eq_c(name, c"__builtin_cpu_is") {
        try se_builtin_count(p, t, count, 1, 1)
        if args.kind != ND_STRING { try pa_error(p, args.loc, c"CPU query requires a string literal") }
    } else if bytes_eq_c(name, c"__builtin_call_with_static_chain") {
        try se_builtin_count(p, t, count, 2, 2)
        if args.kind != ND_CALL { try pa_error(p, args.loc, c"expected a function call for the static chain builtin") }
        try se_conversion(p, ty_ptr(TY_VOID), args.next)
    }
}
