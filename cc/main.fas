// fcc: freestanding C23 compiler & gcc-compatible driver.
use "../lib/core.fas"
use "../as/regs.fas"
use "token.fas"
use "unicode.fas"
use "lex.fas"
use "pp.fas"
use "macro.fas"
use "directive.fas"
use "expr.fas"
use "builtin.fas"
use "features.fas"
use "embed.fas"
use "target.fas"
use "x86_target.fas"
use "x86_target_data.fas"
use "search.fas"
use "output.fas"
use "parse.fas"
use "parse_decl.fas"
use "parse_expr.fas"
use "x86_results.fas"
use "parse_stmt.fas"
use "sema.fas"
use "sema_expr.fas"
use "sema_builtin.fas"
use "sema_wide.fas"
use "sema_float.fas"
use "sema_init.fas"
use "parse_dump.fas"
use "gen.fas"
use "gen_debug.fas"
use "gen_init.fas"
use "gen_expr.fas"
use "gen_quad.fas"
use "gen_stmt.fas"
use "gen_driver.fas"

const MODE_LINK u8        = 0
const MODE_PREPROCESS u8  = 1
const MODE_SYNTAX u8      = 2
const MODE_EMIT_FIR u8    = 3
const MODE_COMPILE_OBJ u8 = 4

const IN_C u8   = 0
const IN_OBJ u8 = 1
const IN_FIR u8 = 2

value struct Command { value addr, kind u8 }
value struct InputFile { path addr, link_at u32, kind u8 }

struct Options {
    path addr
    output addr
    dep_file addr
    inputs Vec[InputFile]
    link_args Vec[addr]
    targets Vec[addr]
    macros Vec[Command]
    force Vec[Command]
    dirs Vec[SearchDir]
    mode u8
    gnu bool
    standard u8
    x86_cpu u32
    x86_options Vec[u32]
    unsigned_char bool
    short_wchar bool
    common bool
    x86_native bool
    native_features u64
    stack_protector u8 // 0 = off, 1 = basic, 2 = strong, 3 = all, 4 = explicit
    overflow_mode u8 // 0 = default, 1 = wrap, 2 = trap
    short_enums bool
    freestanding bool
    no_stdinc bool
    no_library_builtins bool
    disabled_builtins Vec[Bytes]
    default_hidden bool
    suppress_warnings bool
    pic_mode u8 // 0 = default, 1 = disabled, 2/3 = PIC, 4/5 = PIE
    relocatable bool
    save_temps bool
    no_markers bool
    no_builtins bool
    macro_dump bool
    syntax_only bool
    dump_ast bool
    debug bool
    deps u8  // 1 = only dependencies, 2 = side output
    user_deps bool
    phony bool
    is_shared bool
    is_static bool
    is_no_pie bool
    no_stdlib bool
    exceptions bool
    rounding_math bool
    force_lang u8 // 0 = auto, 1 = c
}

fn cli_error(message addr, arg addr) void fails {
    eprint(message)
    if arg != null { eprint(arg) }
    eprint(c"\n")
    fail CError
}

fn cli_arg(argc usize, pos handle[ArgPosition], arg addr, word addr) addr fails {
    if arg[u8, cstr_len(word)] != 0 { return arg + cstr_len(word) }
    pos.i += 1
    if pos.i == argc { try cli_error(c"fcc: missing argument for ", word) }
    return os_arg(pos.i)
}

struct ArgPosition { i usize }

fn cli_classify_input(path addr, force_lang u8) u8 {
    if force_lang == 1 { return IN_C }
    s Bytes = bytes_c(path)
    if bytes_eq_c(s, c"-") || bytes_eq_c(s, c"/dev/null") { return IN_C }
    if bytes_ends_with(s, bytes_c(c".c")) || bytes_ends_with(s, bytes_c(c".i")) ||
       bytes_ends_with(s, bytes_c(c".h")) { return IN_C }
    if bytes_ends_with(s, bytes_c(c".fir")) { return IN_FIR }
    if bytes_ends_with(s, bytes_c(c".o")) || bytes_ends_with(s, bytes_c(c".a")) ||
       bytes_ends_with(s, bytes_c(c".so")) { return IN_OBJ }
    // Check `.so.N` versioned shared libraries
    i usize = 0
    while i + 3 < s.n {
        if s.p[u8, i] == 46 && s.p[u8, i + 1] == 115 && s.p[u8, i + 2] == 111 && s.p[u8, i + 3] == 46 {
            return IN_OBJ
        }
        i += 1
    }
    return IN_C
}

fn cli_push_wl(o handle[Options], payload Bytes) void {
    start usize = 0
    while start < payload.n {
        end usize = start
        while end < payload.n && payload.p[u8, end] != 44 { end += 1 }
        if end > start {
            vec_push(&o.link_args, drv_cstr_dup(bytes_sub(payload, start, end - start)))
        }
        start = end + 1
    }
}

fn cli_warn_option(o handle[Options], arg addr) void {
    if o.suppress_warnings { return }
    eprint(c"fcc: warning: unsupported option '")
    eprint(arg)
    eprint(c"' ignored\n")
}

fn cli_standard(o handle[Options], word Bytes) void fails {
    if bytes_eq_c(word, c"-ansi") {
        o.gnu = false
        o.standard = 90
        return
    }
    name Bytes = bytes_from(word, 5)
    o.gnu = bytes_starts_with(name, bytes_c(c"gnu"))
    if o.gnu { name = bytes_from(name, 3) }
    else if bytes_starts_with(name, bytes_c(c"c")) { name = bytes_from(name, 1) }
    else { try cli_error(c"fcc: unsupported C standard ", word.p) }
    if bytes_eq_c(name, c"23") || bytes_eq_c(name, c"2x") { o.standard = 23 }
    else if bytes_eq_c(name, c"17") || bytes_eq_c(name, c"18") { o.standard = 17 }
    else if bytes_eq_c(name, c"11") { o.standard = 11 }
    else if bytes_eq_c(name, c"99") || bytes_eq_c(name, c"9x") { o.standard = 99 }
    else if bytes_eq_c(name, c"89") || bytes_eq_c(name, c"90") { o.standard = 90 }
    else { try cli_error(c"fcc: unsupported C standard ", word.p) }
}

fn cli_parse(p handle[Pp], o handle[Options], argc usize) void fails {
    pos ArgPosition = {1}
    options bool = true
    o.gnu = true
    o.standard = 23
    o.mode = MODE_LINK
    // -w applies to the entire invocation, regardless of its position.
    for i usize in 1..argc {
        w Bytes = bytes_c(os_arg(i))
        if bytes_eq_c(w, c"--") { break }
        if bytes_eq_c(w, c"-w") { o.suppress_warnings = true }
    }
    while pos.i < argc {
        arg addr = os_arg(pos.i)
        word Bytes = bytes_c(arg)
        if !options || arg[u8] != 45 || arg[u8, 1] == 0 {
            kind u8 = cli_classify_input(arg, o.force_lang)
            // Reserve this position among the options forwarded to the linker.
            vec_push[InputFile](&o.inputs, {arg, trunc[u32](o.link_args.n), kind})
            vec_push[addr](&o.link_args, arg)
            if o.path == null { o.path = arg }
        } else if bytes_eq_c(word, c"--") { options = false }
        else if bytes_eq_c(word, c"-E") { o.mode = MODE_PREPROCESS }
        else if bytes_eq_c(word, c"-S") || bytes_eq_c(word, c"--emit-fir") { o.mode = MODE_EMIT_FIR }
        else if bytes_eq_c(word, c"-c") { o.mode = MODE_COMPILE_OBJ }
        else if bytes_eq_c(word, c"-save-temps") { o.save_temps = true }
        else if bytes_eq_c(word, c"-fsyntax-only") { o.syntax_only = true; o.mode = MODE_SYNTAX }
        else if bytes_eq_c(word, c"-fexceptions") || bytes_eq_c(word, c"-fnon-call-exceptions") { o.exceptions = true }
        else if bytes_eq_c(word, c"-fno-exceptions") { o.exceptions = false }
        else if bytes_eq_c(word, c"-frounding-math") { o.rounding_math = true }
        else if bytes_eq_c(word, c"-fno-rounding-math") { o.rounding_math = false }
        else if bytes_eq_c(word, c"-Xfcc-dump-ast") { o.syntax_only = true; o.dump_ast = true; o.mode = MODE_SYNTAX }
        else if bytes_starts_with(word, bytes_c(c"-x")) {
            lang addr = try cli_arg(argc, &pos, arg, c"-x")
            if bytes_eq_c(bytes_c(lang), c"c") || bytes_eq_c(bytes_c(lang), c"c-header") { o.force_lang = 1 }
            else if bytes_eq_c(bytes_c(lang), c"none") { o.force_lang = 0 }
            else { try cli_error(c"fcc: unsupported input language ", lang) }
        } else if bytes_eq_c(word, c"-pipe") || bytes_eq_c(word, c"-v") || bytes_eq_c(word, c"-w") ||
                  bytes_eq_c(word, c"-pedantic") || bytes_eq_c(word, c"-pedantic-errors") {}
        else if bytes_eq_c(word, c"-P") { o.no_markers = true }
        else if bytes_eq_c(word, c"-dM") { o.macro_dump = true; if o.mode == MODE_LINK { o.mode = MODE_PREPROCESS } }
        else if bytes_eq_c(word, c"-undef") { o.no_builtins = true }
        else if bytes_starts_with(word, bytes_c(c"-std=")) || bytes_eq_c(word, c"-ansi") {
            try cli_standard(o, word)
        } else if bytes_eq_c(word, c"-funsigned-char") || bytes_eq_c(word, c"-fno-signed-char") { o.unsigned_char = true
        } else if bytes_eq_c(word, c"-fsigned-char") || bytes_eq_c(word, c"-fno-unsigned-char") { o.unsigned_char = false
        } else if bytes_eq_c(word, c"-fshort-wchar") { o.short_wchar = true
        } else if bytes_eq_c(word, c"-fno-short-wchar") { o.short_wchar = false
        } else if bytes_eq_c(word, c"-fcommon") { o.common = true
        } else if bytes_eq_c(word, c"-fno-common") { o.common = false
        } else if bytes_eq_c(word, c"-fwrapv") || bytes_eq_c(word, c"-fno-strict-overflow") { o.overflow_mode = 1
        } else if bytes_eq_c(word, c"-ftrapv") { o.overflow_mode = 2
        } else if bytes_eq_c(word, c"-fno-wrapv") || bytes_eq_c(word, c"-fstrict-overflow") {
            if o.overflow_mode == 1 { o.overflow_mode = 0 }
        } else if bytes_eq_c(word, c"-fno-trapv") {
            if o.overflow_mode == 2 { o.overflow_mode = 0 }
        } else if bytes_eq_c(word, c"-fshort-enums") { o.short_enums = true
        } else if bytes_eq_c(word, c"-fno-short-enums") { o.short_enums = false
        } else if bytes_eq_c(word, c"-ffreestanding") { o.freestanding = true
        } else if bytes_eq_c(word, c"-fhosted") { o.freestanding = false
        } else if bytes_eq_c(word, c"-nostdinc") { o.no_stdinc = true
        } else if bytes_eq_c(word, c"-fno-builtin") { o.no_library_builtins = true
        } else if bytes_eq_c(word, c"-fbuiltin") { o.no_library_builtins = false
        } else if bytes_starts_with(word, bytes_c(c"-fno-builtin-")) {
            vec_push(&o.disabled_builtins, bytes_from(word, 13))
        } else if bytes_eq_c(word, c"-fvisibility=hidden") { o.default_hidden = true
        } else if bytes_eq_c(word, c"-fvisibility=default") { o.default_hidden = false
        } else if bytes_starts_with(word, bytes_c(c"-fvisibility=")) {
            try cli_error(c"fcc: unsupported visibility option ", arg)
        } else if bytes_eq_c(word, c"-fstack-protector") { o.stack_protector = 1
        } else if bytes_eq_c(word, c"-fstack-protector-strong") { o.stack_protector = 2
        } else if bytes_eq_c(word, c"-fstack-protector-all") { o.stack_protector = 3
        } else if bytes_eq_c(word, c"-fstack-protector-explicit") { o.stack_protector = 4
        } else if bytes_eq_c(word, c"-fno-stack-protector") { o.stack_protector = 0
        } else if bytes_eq_c(word, c"-ffast-math") || bytes_eq_c(word, c"-Ofast") {
            try cli_error(c"fcc: fast-math semantics are unsupported: ", arg)
        } else if bytes_starts_with(word, bytes_c(c"-march=")) {
            o.x86_native = bytes_eq_c(word, c"-march=native")
            if o.x86_native {
                o.x86_cpu = x86_detect_host(&o.native_features)
            } else {
                o.x86_cpu = x86_cpu(bytes_from(word, 7))
                if o.x86_cpu == 0 { try cli_error(c"fcc: unsupported x86-64 architecture: ", arg) }
            }
        } else if bytes_eq_c(word, c"-m16") || bytes_eq_c(word, c"-m32") || bytes_eq_c(word, c"-mx32") {
            try cli_error(c"fcc: only the x86-64 LP64 target is supported: ", arg)
        } else if bytes_eq_c(word, c"-M") || bytes_eq_c(word, c"-MM") || bytes_eq_c(word, c"-MD") || bytes_eq_c(word, c"-MMD") {
            o.deps = if bytes_eq_c(word, c"-M") || bytes_eq_c(word, c"-MM") { 1 } else { 2 }
            o.user_deps = word.n > 2 && arg[u8, 2] == 77
            if o.deps == 1 { o.mode = MODE_PREPROCESS }
        } else if bytes_starts_with(word, bytes_c(c"-Wp,-MD,")) || bytes_starts_with(word, bytes_c(c"-Wp,-MMD,")) {
            o.deps = 2
            o.user_deps = arg[u8, 6] == 77
            file Bytes = bytes_from(word, if o.user_deps { 9 } else { 8 })
            if file.n == 0 { try cli_error(c"fcc: missing dependency file in ", arg) }
            o.dep_file = drv_cstr_dup(file)
        } else if bytes_eq_c(word, c"-MP") { o.phony = true }
        else if bytes_starts_with(word, bytes_c(c"-MF")) { o.dep_file = try cli_arg(argc, &pos, arg, c"-MF") }
        else if bytes_starts_with(word, bytes_c(c"-MT")) { vec_push[addr](&o.targets, try cli_arg(argc, &pos, arg, c"-MT")) }
        else if bytes_starts_with(word, bytes_c(c"-o")) { o.output = try cli_arg(argc, &pos, arg, c"-o") }
        else if bytes_starts_with(word, bytes_c(c"-D")) { vec_push[Command](&o.macros, {try cli_arg(argc, &pos, arg, c"-D"), 0}) }
        else if bytes_starts_with(word, bytes_c(c"-U")) { vec_push[Command](&o.macros, {try cli_arg(argc, &pos, arg, c"-U"), 1}) }
        else if bytes_eq_c(word, c"-include") || bytes_eq_c(word, c"-imacros") {
            kind u8 = if bytes_eq_c(word, c"-include") { 0 } else { 1 }
            vec_push[Command](&o.force, {try cli_arg(argc, &pos, arg, arg), kind})
        } else if bytes_eq_c(word, c"-r") { o.relocatable = true }
        else if bytes_eq_c(word, c"-shared") { o.is_shared = true }
        else if bytes_eq_c(word, c"-static") { o.is_static = true }
        else if bytes_eq_c(word, c"-no-pie") { o.is_no_pie = true }
        else if bytes_eq_c(word, c"-pie") { o.is_no_pie = false }
        else if bytes_eq_c(word, c"-fpic") { o.pic_mode = 2 }
        else if bytes_eq_c(word, c"-fPIC") { o.pic_mode = 3 }
        else if bytes_eq_c(word, c"-fpie") { o.pic_mode = 4 }
        else if bytes_eq_c(word, c"-fPIE") { o.pic_mode = 5 }
        else if bytes_eq_c(word, c"-fno-pic") || bytes_eq_c(word, c"-fno-PIC") ||
                bytes_eq_c(word, c"-fno-pie") || bytes_eq_c(word, c"-fno-PIE") {
            o.pic_mode = 1
        } else if bytes_eq_c(word, c"-nostdlib") { o.no_stdlib = true }
        else if bytes_eq_c(word, c"-pthread") {
            vec_push[Command](&o.macros, {c"_REENTRANT=1", 0})
            vec_push(&o.link_args, c"-lpthread")
        } else if bytes_eq_c(word, c"-rdynamic") {
            vec_push(&o.link_args, c"--export-dynamic")
        } else if bytes_eq_c(word, c"-Xlinker") {
            vec_push[addr](&o.link_args, try cli_arg(argc, &pos, arg, arg))
        } else if bytes_starts_with(word, bytes_c(c"-Wl,")) {
            cli_push_wl(o, bytes_from(word, 4))
        } else if bytes_starts_with(word, bytes_c(c"-L")) {
            dir addr = try cli_arg(argc, &pos, arg, c"-L")
            vec_push(&o.link_args, c"-L")
            vec_push(&o.link_args, dir)
        } else if bytes_starts_with(word, bytes_c(c"-l")) {
            lib addr = try cli_arg(argc, &pos, arg, c"-l")
            b Buf = {}
            buf_str(&b, c"-l")
            buf_str(&b, lib)
            vec_push(&o.link_args, drv_cstr_dup(buf_bytes(&b)))
            buf_free(&b)
        } else if bytes_eq_c(word, c"-g0") || bytes_eq_c(word, c"-ggdb0") { o.debug = false }
        else if bytes_starts_with(word, bytes_c(c"-g")) { o.debug = true }
        else if bytes_starts_with(word, bytes_c(c"-O")) ||
                  bytes_starts_with(word, bytes_c(c"-W")) || bytes_eq_c(word, c"-m64") ||
                  bytes_eq_c(word, c"-fstrict-aliasing") || bytes_eq_c(word, c"-fno-strict-aliasing") ||
                  bytes_eq_c(word, c"-fno-fast-math") {
            // These optimization and diagnostic settings have no effect on current code generation.
        } else if bytes_starts_with(word, bytes_c(c"-m")) {
            disable bool = bytes_starts_with(word, bytes_c(c"-mno-"))
            name Bytes = bytes_from(word, if disable { 5 } else { 2 })
            feature u32 = x86_flag(name)
            if feature == 0 { cli_warn_option(o, arg) }
            else { vec_push(&o.x86_options, feature * 2 + (if disable { 1 } else { 0 })) }
        } else if bytes_starts_with(word, bytes_c(c"-f")) {
            cli_warn_option(o, arg)
        } else {
            prefix addr = c"-I"
            rank u8 = 1
            if bytes_starts_with(word, bytes_c(c"-iquote")) { rank = 0; prefix = c"-iquote" }
            else if bytes_starts_with(word, bytes_c(c"-isystem")) { rank = 2; prefix = c"-isystem" }
            else if bytes_starts_with(word, bytes_c(c"-idirafter")) { rank = 3; prefix = c"-idirafter" }
            else if !bytes_starts_with(word, bytes_c(c"-I")) { try cli_error(c"fcc: unknown option ", arg) }
            path addr = try cli_arg(argc, &pos, arg, prefix)
            vec_push[SearchDir](&o.dirs, {cc_intern(&p.names, bytes_c(path)), rank})
        }
        pos.i += 1
    }
    if o.inputs.n == 0 {
        try cli_error(c"usage: fcc [-E | -S | -c | -fsyntax-only] [-save-temps] [options] inputs...", null)
    }
    if (o.mode == MODE_PREPROCESS || o.mode == MODE_SYNTAX) && o.inputs.n > 1 {
        try cli_error(c"fcc: expected one input file, got ", vec_get(&o.inputs, 1).path)
    }
}

fn cli_dir(p handle[Pp], path addr, rank u8) void {
    vec_push[SearchDir](&p.dirs, {cc_intern(&p.names, bytes_c(path)), rank})
}

fn cli_search_paths(p handle[Pp], o handle[Options]) void {
    for rank u8 in 0..4 {
        for i usize in 0..o.dirs.n {
            d SearchDir = o.dirs.p[SearchDir, i]
            if d.rank == rank { vec_push[SearchDir](&p.dirs, d) }
        }
        if rank == 2 && !o.no_stdinc {
            include addr = os_getenv(c"FCC_INCLUDE")
            if include == null { include = c"cc/include" }
            cli_dir(p, include, rank)
            cli_dir(p, c"/usr/local/include", rank)
            cli_dir(p, c"/usr/include/x86_64-linux-gnu", rank)
            cli_dir(p, c"/usr/include", rank)
            gcc addr = gcc_include()
            if gcc != null && gcc[u8] != 0 { cli_dir(p, gcc, rank) }
        }
    }
}

fn cli_definitions(p handle[Pp], source Bytes, filename addr) void fails {
    b addr = heap_alloc_zeroed(source.n + 8)
    mem_copy(b, source.p, source.n)
    f CFile = {}
    splice_source(&f, bytes(b, source.n), p.names.gnu)
    l Lexer = {}
    l.file = &f
    l.path = cc_intern(&p.names, bytes_c(filename))
    l.flags = F_BOL
    tokens Vec[Token] = {}
    while l.at < f.data.n {
        vec_clear[Token](&tokens)
        try pp_lex_line(&p.names, &l, &tokens, false)
        if tokens.n != 0 { try pp_define(p, &tokens, tokens.p[Token].loc, false) }
    }
}

fn cli_setup(p handle[Pp], o handle[Options]) void fails {
    p.names.gnu = o.gnu
    p.names.short_wchar = o.short_wchar
    p.standard = o.standard
    p.unsigned_char = o.unsigned_char
    p.short_enums = o.short_enums
    p.no_library_builtins = o.no_library_builtins || o.freestanding
    p.disabled_builtins = &o.disabled_builtins
    p.wrapv = o.overflow_mode == 1
    p.stream.source = true
    p.timestamp = os_clock_ns(0) / 1000000000
    epoch addr = os_getenv(c"SOURCE_DATE_EPOCH")
    if epoch != null {
        p.timestamp = bytes_to_u64(bytes_c(epoch)) catch p.timestamp
        p.timestamp_explicit = true
    }
    cpu handle[X86Cpu] = &X86_CPUS[zext[usize](o.x86_cpu)]
    p.x86_features = if o.x86_native { o.native_features } else { cpu.features }
    last arr[X86_FLAG_COUNT, usize] = {}
    for i usize in 0..o.x86_options.n {
        feature usize = zext[usize](vec_get(&o.x86_options, i) >> 1) - 1
        last[feature] = i + 1
    }
    for i usize in 0..o.x86_options.n {
        option u32 = vec_get(&o.x86_options, i)
        feature u32 = option >> 1
        if last[zext[usize](feature) - 1] != i + 1 { continue }
        p.x86_features = x86_flag_apply(p.x86_features, feature, (option & 1) == 0)
    }
    independent arr[2, addr] = {c"popcnt", c"crc32"}
    for j usize in 0..2 {
        name addr = independent[j]
        feature u32 = x86_flag(bytes_c(name))
        at usize = last[zext[usize](feature) - 1]
        if at != 0 && (vec_get(&o.x86_options, at - 1) & 1) != 0 {
            p.x86_features = x86_flag_apply(p.x86_features, feature, false)
        }
    }
    if !o.no_builtins {
        for i usize in 0..19 { try cli_definitions(p, bytes_c(C_TARGET[i]), c"<built-in>") }
        try cli_definitions(p, bytes_c(if o.gnu { C_TARGET_GNU } else { C_TARGET_STRICT }), c"<built-in>")
        try cli_definitions(p, bytes_c(cpu.defines), c"<built-in>")
        for i usize in 0..X86_MACRO_COUNT {
            if (p.x86_features & (1 << trunc[u32](i))) != 0 {
                try cli_definitions(p, bytes_c(X86_MACROS[i]), c"<built-in>")
            }
        }
    } else {
        try cli_definitions(p, bytes_c(c"__STDC__ 1\n"), c"<built-in>")
    }
    version addr = if o.standard == 23 { c"__STDC_VERSION__ 202311L\n" }
                   else if o.standard == 17 { c"__STDC_VERSION__ 201710L\n" }
                   else if o.standard == 11 { c"__STDC_VERSION__ 201112L\n" }
                   else if o.standard == 99 { c"__STDC_VERSION__ 199901L\n" }
                   else { null }
    if version != null { try cli_definitions(p, bytes_c(version), c"<built-in>") }
    hosted addr = if o.freestanding { c"__STDC_HOSTED__ 0\n" } else { c"__STDC_HOSTED__ 1\n" }
    try cli_definitions(p, bytes_c(hosted), c"<built-in>")
    if !o.no_builtins {
        ssp addr = if o.stack_protector == 1 { c"__SSP__ 1\n" }
                   else if o.stack_protector == 2 { c"__SSP_STRONG__ 2\n" }
                   else if o.stack_protector == 3 { c"__SSP_ALL__ 3\n" }
                   else if o.stack_protector == 4 { c"__SSP_EXPLICIT__ 4\n" }
                   else { null }
        if ssp != null { try cli_definitions(p, bytes_c(ssp), c"<built-in>") }
        if o.unsigned_char { try cli_definitions(p, bytes_c(c"__CHAR_UNSIGNED__ 1\n"), c"<built-in>") }
        if o.short_wchar {
            try cli_definitions(p, bytes_c(C_TARGET_SHORT_WCHAR), c"<built-in>")
        }
        pic u8 = if o.pic_mode != 0 { o.pic_mode } else if o.is_shared { 3 } else { 5 }
        if pic >= 2 {
            pic_def addr = if (pic & 1) == 0 { c"__PIC__ 1\n__pic__ 1\n" } else { c"__PIC__ 2\n__pic__ 2\n" }
            try cli_definitions(p, bytes_c(pic_def), c"<built-in>")
        }
        if pic >= 4 {
            pie_def addr = if pic == 4 { c"__PIE__ 1\n__pie__ 1\n" } else { c"__PIE__ 2\n__pie__ 2\n" }
            try cli_definitions(p, bytes_c(pie_def), c"<built-in>")
        }
    }
    if o.exceptions { try cli_definitions(p, bytes_c(c"__EXCEPTIONS 1\n"), c"<built-in>") }
    for i usize in 0..o.macros.n {
        m Command = o.macros.p[Command, i]
        s Bytes = bytes_c(m.value)
        if m.kind == 1 {
            id u32 = cc_intern(&p.names, s)
            p.names.macros.p[addr, zext[usize](id)] = null
            p.names.undefined.p[u8, zext[usize](id)] = 1
        } else {
            b Buf = {}
            sep usize = bytes_index(s, 61) catch s.n
            buf_append(&b, bytes_sub(s, 0, sep))
            if sep == s.n { buf_str(&b, c" 1") }
            else {
                buf_u8(&b, 32)
                buf_append(&b, bytes_from(s, sep + 1))
            }
            try cli_definitions(p, buf_bytes(&b), c"<command line>")
        }
    }
    cli_search_paths(p, o)
}

fn stdin_file() handle[Input] fails {
    f handle[Input] = handle_from_addr(heap_alloc_zeroed(sizeof[Input]))
    b Buf = {}
    while true {
        buf_reserve(&b, 16384)
        got usize = try os_read(STDIN, b.p + b.n, 16384)
        if got == 0 { break }
        b.n += got
    }
    size usize = b.n
    buf_zeros(&b, 8)
    f.content = bytes(b.p, size)
    return f
}

fn cli_main(p handle[Pp], o handle[Options], argc usize) void fails {
    cc_intern(&p.names, bytes_empty())
    try cli_parse(p, o, argc)

    // Mode 1: Preprocess (-E) or Syntax-only (-fsyntax-only / -Xfcc-dump-ast)
    if o.mode == MODE_PREPROCESS || o.mode == MODE_SYNTAX {
        try cli_setup(p, o)
        name Bytes = bytes_c(o.path)
        stdin bool = bytes_eq_c(name, c"-")
        p.base_file = cc_intern(&p.names, if stdin { bytes_c(c"<stdin>") } else { name })
        p.base_logical = p.base_file
        p.line_markers = !o.syntax_only && !o.no_markers && !o.macro_dump && o.deps != 1
        main_input handle[Input]
        if stdin { main_input = try stdin_file() }
        else if bytes_eq_c(name, c"/dev/null") {
            main_input = handle_from_addr(heap_alloc_zeroed(sizeof[Input]))
        } else {
            main_input = pp_read(p, name) catch {
                try cli_error(c"fcc: cannot open ", o.path)
                return
            }
        }
        pp_depend(p, p.base_file, false)
        out Output = {}
        for order u8 in 0..2 {
            for i usize in 0..o.force.n {
                inc Command = o.force.p[Command, i]
                if inc.kind != 1 - order { continue }
                path Bytes = bytes_c(inc.value)
                found Found = pp_lookup(p, path, -1, false)
                if found.file == null { found = pp_find(p, path, true, false) }
                if found.file == null { try cli_error(c"fcc: cannot open forced include ", inc.value) }
                if o.syntax_only && inc.kind == 0 && o.deps != 1 {
                    root handle[PpRoot] = vec_add[PpRoot](&p.roots)
                    root.input_handle = handle_from_addr(found.file)
                    root.path = found.path
                    root.directory = found.dir
                    root.system = found.system
                    continue
                }
                try pp_push_file(p, handle_from_addr(found.file), found.path, sext[i32](found.dir), found.system, 0)
                try output_stream(p, &out, o.macro_dump || o.deps == 1 || inc.kind == 1)
            }
        }
        if o.syntax_only && o.deps != 1 {
            root handle[PpRoot] = vec_add[PpRoot](&p.roots)
            root.input_handle = main_input
            root.path = p.base_file
            root.directory = -1
            parser Parser = {}
            parser.fenv_access = o.rounding_math
            parser.fenv_default = o.rounding_math
            fd i32 = STDOUT
            if o.dump_ast {
                if o.output != null && !bytes_eq_c(bytes_c(o.output), c"-") {
                    fd = try os_open(o.output, O_WRONLY | O_CREAT | O_TRUNC, 0o666)
                }
                parser.on_function = &pa_dump_callback
                parser.on_object = &pa_dump_callback
                parser.user = &fd
            }
            defer { if fd != STDOUT { os_close(fd) } }
            try parse_tu(&parser, p)
            if o.deps != 0 { try output_dependencies(p, o) }
            return
        }
        try pp_push_file(p, main_input, p.base_file, -1, false, 0)
        try output_stream(p, &out, o.macro_dump || o.deps == 1)
        if o.macro_dump { output_macros(p, &out.text) }
        if o.deps != 1 { try output_file(o.output, buf_bytes(&out.text)) }
        if o.deps != 0 { try output_dependencies(p, o) }
        return
    }

    // Save raw search-dir strings from main's Pp so multi-file compilation re-interns them per TU
    pic u8 = if o.pic_mode != 0 { o.pic_mode } else if o.is_shared { 3 } else { 5 }
    dir_strs Vec[addr] = {}
    dir_ranks Vec[u8] = {}
    defer { vec_free(&dir_strs); vec_free(&dir_ranks) }
    for i usize in 0..o.dirs.n {
        d SearchDir = o.dirs.p[SearchDir, i]
        vec_push(&dir_strs, drv_cstr_dup(cc_name(&p.names, d.path)))
        vec_push(&dir_ranks, d.rank)
    }

    // Mode 2: -S / --emit-fir
    if o.mode == MODE_EMIT_FIR {
        for i usize in 0..o.inputs.n {
            inp InputFile = o.inputs.p[InputFile, i]
            if inp.kind != IN_C { continue }
            out_p addr = if o.output != null { o.output } else { drv_replace_ext(bytes_c(inp.path), c".s") }
            if !(try cli_compile_one_c(o, &dir_strs, &dir_ranks, inp.path, out_p, -1)) {
                try cli_error(c"fcc: could not write Fir output", null)
            }
        }
        return
    }

    // Mode 3: -c (compile to .o)
    if o.mode == MODE_COMPILE_OBJ {
        for i usize in 0..o.inputs.n {
            inp InputFile = o.inputs.p[InputFile, i]
            out_p addr = if o.output != null { o.output } else { drv_replace_ext(bytes_c(inp.path), c".o") }
            if inp.kind == IN_FIR {
                try drv_assemble_fir(inp.path, out_p, pic, o.debug)
            } else if inp.kind == IN_C {
                saved addr = if o.save_temps { cli_saved_fir(out_p, 0, false) } else { null }
                try cli_object_c(o, &dir_strs, &dir_ranks, inp.path, out_p, saved, pic)
            }
        }
        return
    }

    // Compile and link, keeping per-source temporary objects until the link.
    out_exe addr = if o.output != null { o.output } else { c"a.out" }
    temp_files Vec[i32] = {}
    defer {
        for i usize in 0..temp_files.n { os_close(vec_get(&temp_files, i)) }
        vec_free(&temp_files)
    }
    for i usize in 0..o.inputs.n {
        inp InputFile = o.inputs.p[InputFile, i]
        if inp.kind == IN_OBJ { continue }
        temp DrvTempObject = try drv_temp_object()
        vec_push(&temp_files, temp.fd)
        if inp.kind == IN_FIR {
            try drv_assemble_fir(inp.path, temp.path, pic, o.debug)
        } else {
            saved addr = if o.save_temps { cli_saved_fir(out_exe, i, o.inputs.n > 1) } else { null }
            try cli_object_c(o, &dir_strs, &dir_ranks, inp.path, temp.path, saved, pic)
        }
        vec_set(&o.link_args, zext[usize](inp.link_at), temp.path)
    }
    try drv_link(out_exe, &o.link_args, o.is_shared, o.is_static, o.is_no_pie, o.no_stdlib, o.relocatable)
}

// Save the text alongside the requested output. Number multiple inputs so
// sources with the same basename each keep their own Fir file.
fn cli_saved_fir(output addr, index usize, multiple bool) addr {
    path Buf = {}
    defer { buf_free(&path) }
    buf_str(&path, output)
    if multiple {
        buf_u8(&path, 46)
        buf_dec_u64(&path, index)
    }
    buf_str(&path, c".fir")
    return drv_cstr_dup(buf_bytes(&path))
}

// Saved Fir is named by the driver. Check aliases of command-line inputs
// before truncating an existing path, including sources yet to be compiled.
fn cli_check_saved_fir(o handle[Options], saved addr) void fails {
    st Stat = {}
    os_stat(saved, &st, true) catch { return }
    for i usize in 0..o.inputs.n {
        input addr = o.inputs.p[InputFile, i].path
        if bytes_eq_c(bytes_c(input), c"-") { continue }
        source Stat = {}
        os_stat(input, &source, true) catch { continue }
        if source.dev == st.dev && source.ino == st.ino {
            try cli_error(c"fcc: saved Fir would overwrite ", input)
        }
    }
}

fn cli_object_c(o handle[Options], dirs handle[Vec[addr]], ranks handle[Vec[u8]], in_path addr,
                obj_path addr, saved addr, pic u8) void fails {
    if saved != null {
        try cli_check_saved_fir(o, saved)
        if !(try cli_compile_one_c(o, dirs, ranks, in_path, saved, -1)) {
            try cli_error(c"fcc: could not write Fir output", null)
        }
        try drv_assemble_fir(saved, obj_path, pic, o.debug)
        return
    }

    child DrvFirPipe = try drv_fir_pipe(obj_path, pic, o.debug)
    running bool = true
    defer { if running { drv_abort_fir(child) } }
    previous DrvSignalAction = {}
    try drv_ignore_sigpipe(&previous)
    defer { drv_restore_sigpipe(&previous) }

    wrote bool = try cli_compile_one_c(o, dirs, ranks, in_path, null, child.write_fd)
    os_close(child.write_fd)
    running = false
    try drv_finish_fir(child.pid)
    if !wrote { try cli_error(c"fcc: could not write Fir output", null) }
}

fn cli_compile_one_c(command handle[Options], dir_strs handle[Vec[addr]], dir_ranks handle[Vec[u8]],
                     in_path addr, fir_out_path addr, output_fd i32) bool fails {
    // The command owns the input and output paths. Everything built from
    // the source is only needed until this translation unit is emitted.
    region Region = {}
    previous handle[Region] = region_switch(&region)
    defer { region_switch(previous); region_dispose(&region) }

    options Options = {}
    copy_into(&options, command)
    o handle[Options] = &options
    dirs handle[Vec[SearchDir]] = &o.dirs
    mem_set(handle_addr(dirs), 0, sizeof[Vec[SearchDir]])
    p Pp = {}
    defer { expand_release(&p.stream) }
    cc_intern(&p.names, bytes_empty())
    // Include-directory IDs belong to this TU's interner.
    for i usize in 0..dir_strs.n {
        vec_push[SearchDir](&o.dirs, {cc_intern(&p.names, bytes_c(vec_get(dir_strs, i))), vec_get(dir_ranks, i)})
    }
    try cli_setup(&p, o)
    name Bytes = bytes_c(in_path)
    stdin bool = bytes_eq_c(name, c"-")
    p.base_file = cc_intern(&p.names, if stdin { bytes_c(c"<stdin>") } else { name })
    p.base_logical = p.base_file
    p.line_markers = false
    main_input handle[Input]
    if stdin { main_input = try stdin_file() }
    else if bytes_eq_c(name, c"/dev/null") {
        main_input = handle_from_addr(heap_alloc_zeroed(sizeof[Input]))
    } else {
        main_input = pp_read(&p, name) catch {
            try cli_error(c"fcc: cannot open ", in_path)
            return false
        }
    }
    pp_depend(&p, p.base_file, false)
    out Output = {}
    for order u8 in 0..2 {
        for i usize in 0..o.force.n {
            inc Command = o.force.p[Command, i]
            if inc.kind != 1 - order { continue }
            path Bytes = bytes_c(inc.value)
            found Found = pp_lookup(&p, path, -1, false)
            if found.file == null { found = pp_find(&p, path, true, false) }
            if found.file == null { try cli_error(c"fcc: cannot open forced include ", inc.value) }
            if inc.kind == 0 {
                root handle[PpRoot] = vec_add[PpRoot](&p.roots)
                root.input_handle = handle_from_addr(found.file)
                root.path = found.path
                root.directory = found.dir
                root.system = found.system
                continue
            }
            try pp_push_file(&p, handle_from_addr(found.file), found.path, sext[i32](found.dir), found.system, 0)
            try output_stream(&p, &out, true)
        }
    }
    root handle[PpRoot] = vec_add[PpRoot](&p.roots)
    root.input_handle = main_input
    root.path = p.base_file
    root.directory = -1

    fd i32 = if output_fd >= 0 { output_fd } else { STDOUT }
    open_file bool = output_fd < 0 && fir_out_path != null && !bytes_eq_c(bytes_c(fir_out_path), c"-")
    if open_file {
        fd = try os_open(fir_out_path, O_WRONLY | O_CREAT | O_TRUNC, 0o666)
    }
    defer { if open_file { os_close(fd) } }

    parser Parser = {}
    parser.fenv_access = o.rounding_math
    parser.fenv_default = o.rounding_math
    gctx GenCtx = {}
    gen_init(&gctx, &parser, fd)
    gctx.exceptions = o.exceptions
    gctx.debug.enabled = o.debug
    gctx.default_hidden = o.default_hidden
    gctx.common = o.common
    gctx.trapv = o.overflow_mode == 2
    gctx.stack_protector = o.stack_protector
    defer { gen_free(&gctx) }
    parser.on_function = &gen_on_function_cb
    parser.on_object = &gen_on_object_cb
    parser.user = &gctx
    try parse_tu(&parser, &p)
    try gen_finish_tu()
    if o.deps != 0 { try output_dependencies(&p, o) }
    return !gctx.out.write_failed
}

fn main(argc i32, argv addr) i32 {
    os_init(argc, argv)
    region Region = {}
    region_switch(&region)
    defer { region_switch(null); region_dispose(&region) }
    pp Pp = {}
    defer { expand_release(&pp.stream) }
    options Options = {}
    cli_main(&pp, &options, zext[usize](bitcast[u32](argc))) catch e {
        if e != CError { eprint(c"fcc: I/O error\n") }
        return 1
    }
    return 0
}
