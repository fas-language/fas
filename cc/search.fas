// Find the newest native GCC installation's ordinary include directory.
// It is a fallback for target intrinsics and distro headers that use them.
// GCC's include-fixed is deliberately outside the search chain.
fn gcc_version(directory Bytes) u64 {
    score u64 = 0
    at usize = 0
    for part usize in 0..4 {
        num u64 = 0
        first usize = at
        while at < directory.n && cc_digit(directory.p[u8, at]) {
            num = num * 10 + zext[u64](directory.p[u8, at] - 48)
            at += 1
        }
        if at == first && (at != directory.n || part == 0) { return 0 }
        if num > 999 { return 0 }
        score = score * 1000 + num
        if at < directory.n {
            if directory.p[u8, at] != 46 || at + 1 == directory.n { return 0 }
            at += 1
        }
    }
    return if at == directory.n { score } else { 0 }
}

fn gcc_include_under(root addr, best handle[GccInclude]) void {
    dir i32 = os_open(root, O_RDONLY | O_DIRECTORY, 0) catch { return }
    defer { os_close(dir) }
    records addr = heap_alloc(4096)
    while true {
        n usize = syscall[usize fails](217, dir, records, 4096) catch { return }
        if n == 0 { break }
        at usize = 0
        while at < n {
            record addr = records + at
            size usize = zext[usize]((record + 16)[u16])
            if size < 20 || size > n - at { return }
            at += size
            version Bytes = bytes_c(record + 19)
            rank u64 = gcc_version(version)
            if rank <= best.version { continue }
            path Buf = {}
            path_concat(&path, bytes_c(root), version)
            buf_str(&path, c"/include")
            name addr = buf_cstr(&path)
            fd i32 = os_open(name, O_RDONLY | O_DIRECTORY, 0) catch { continue }
            os_close(fd)
            best.version = rank
            best.path = name
        }
    }
}

struct GccInclude { version u64, path addr }
fn gcc_include() addr {
    override addr = os_getenv(c"FCC_GCC_INCLUDE")
    if override != null { return override }
    best GccInclude = {}
    gcc_include_under(c"/usr/lib/gcc/x86_64-linux-gnu", &best)
    gcc_include_under(c"/usr/local/lib/gcc/x86_64-linux-gnu", &best)
    return best.path
}
