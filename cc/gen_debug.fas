// Use independent Fir ids. Resolve types at TU end so a pointer to a
// forward declaration can describe its completed record layout.
struct GenDebugType {
    ty u32
    alias u32
}

struct GenDebugMark {
    offset usize
    loc u32
}

struct GenDebug {
    enabled bool
    scope u32
    loc u32
    next_scope u32
    next_loc u32
    loc_ids Table[U64Key, u32, gen_u64_hash, gen_u64_eq]
    type_ids Table[U64Key, u32, gen_u64_hash, gen_u64_eq]
    types Vec[GenDebugType]
    vars Buf
}

fn gen_debug_uint(b handle[Buf], v u32) void {
    buf_dec_u64(b, zext[u64](v))
}

fn gen_debug_quote(b handle[Buf], s Bytes) void {
    fir_emit_quoted_bytes(b, s.p, s.n)
}

fn gen_debug_scope(parent u32) u32 {
    gc.debug.next_scope += 1
    id u32 = gc.debug.next_scope
    b handle[Buf] = &gc.out.buf
    buf_str(b, c"scope ")
    gen_debug_uint(b, id)
    buf_str(b, c" parent ")
    gen_debug_uint(b, parent)
    buf_u8(b, 10)
    return id
}

fn gen_debug_loc(source u32, scope u32) u32 {
    if source == 0 || source >= trunc[u32](gc.p.names.locations.n) { return 0 }
    key U64Key = {(zext[u64](scope) << 32) | zext[u64](source)}
    id u32 = table_get(&gc.debug.loc_ids, &key) catch {
        gc.debug.next_loc += 1
        id u32 = gc.debug.next_loc
        _ bool = table_put(&gc.debug.loc_ids, &key, id)
        loc CLoc = vec_get(&gc.p.names.locations, zext[usize](source))
        b handle[Buf] = &gc.out.buf
        buf_str(b, c"loc ")
        gen_debug_uint(b, id)
        buf_u8(b, 32)
        gen_debug_quote(b, cc_name(gc.p.names, loc.file))
        buf_u8(b, 32)
        gen_debug_uint(b, loc.line)
        buf_u8(b, 32)
        gen_debug_uint(b, loc.column)
        if scope != 0 {
            buf_str(b, c" !scope ")
            gen_debug_uint(b, scope)
        }
        buf_u8(b, 10)
        return id
    }
    return id
}

fn gen_debug_type(ty u32, alias u32) u32 {
    base u32 = ty_unqual(ty)
    if base == TY_INVALID || (base == TY_VOID && alias == 0) { return 0 }
    key U64Key = {(zext[u64](alias) << 32) | zext[u64](base)}
    id u32 = table_get(&gc.debug.type_ids, &key) catch {
        t handle[GenDebugType] = vec_add(&gc.debug.types)
        t.ty = base
        t.alias = alias
        id u32 = trunc[u32](gc.debug.types.n)
        _ bool = table_put(&gc.debug.type_ids, &key, id)
        return id
    }
    return id
}

fn gen_debug_suffix(b handle[Buf], loc u32) void {
    if loc != 0 {
        buf_str(b, c" !loc ")
        gen_debug_uint(b, loc)
    }
}

fn gen_debug_local(s handle[Symbol], slot u32, arg u32, indir bool, symbol u32) void {
    if !gc.debug.enabled || s.name == 0 { return }
    b handle[Buf] = &gc.debug.vars
    scope u32 = if arg == 0 { gc.debug.scope } else { 0 }
    buf_str(b, c"  var ")
    gen_debug_quote(b, cc_name(gc.p.names, s.name))
    buf_u8(b, 32)
    gen_debug_uint(b, gen_debug_type(s.ty, s.debug_typedef))
    if scope != 0 {
        buf_str(b, c" scope ")
        gen_debug_uint(b, scope)
    }
    if arg != 0 {
        buf_str(b, c" arg ")
        gen_debug_uint(b, arg)
    }
    gen_debug_suffix(b, gen_debug_loc(s.loc, scope))
    if symbol != 0 {
        buf_str(b, c" at ")
        gen_emit_sym_name(b, gen_sym_bytes(symbol))
        if s.thread_local { buf_str(b, c" tls") }
    } else if slot != 0 {
        buf_str(b, c" at ")
        gen_emit_val(b, slot)
        buf_str(b, if indir { c" stack indirect" } else { c" stack" })
    }
    buf_u8(b, 10)
}

fn gen_debug_var(s handle[Symbol], slot u32, arg u32) void {
    gen_debug_local(s, slot, arg, false, 0)
}

fn gen_debug_global(s handle[Symbol], symbol u32) void {
    if !gc.debug.enabled || s.name == 0 { return }
    loc u32 = gen_debug_loc(s.loc, 0)
    b handle[Buf] = gen_global_buf()
    buf_str(b, c"dglobal ")
    gen_debug_quote(b, cc_name(gc.p.names, s.name))
    buf_u8(b, 32)
    gen_debug_uint(b, gen_debug_type(s.ty, s.debug_typedef))
    buf_u8(b, 32)
    gen_debug_uint(b, loc)
    buf_u8(b, 32)
    gen_emit_sym_name(b, gen_sym_bytes(symbol))
    if s.thread_local { buf_str(b, c" tls") }
    buf_u8(b, 10)
}

fn gen_debug_mark(blk handle[GenBlock]) void {
    offset usize = blk.code.n
    if blk.debug_marks.n != 0 {
        prev handle[GenDebugMark] = vec_at(&blk.debug_marks, blk.debug_marks.n - 1)
        if prev.offset == offset { prev.loc = gc.debug.loc; return }
        if prev.loc == gc.debug.loc { return }
    }
    if blk.debug_marks.n == 0 && gc.debug.loc == 0 { return }
    m handle[GenDebugMark] = vec_add(&blk.debug_marks)
    m.offset = offset
    m.loc = gc.debug.loc
}

fn gen_debug_write_code(out_b handle[Buf], blk handle[GenBlock]) void {
    code Bytes = buf_bytes(&blk.code)
    if blk.debug_marks.n == 0 { buf_append(out_b, code); return }
    row usize = 0
    mark usize = 0
    loc u32 = 0
    for i usize in 0..code.n {
        if code.p[u8, i] != 10 { continue }
        while mark < blk.debug_marks.n && vec_at(&blk.debug_marks, mark).offset <= row {
            loc = vec_at(&blk.debug_marks, mark).loc
            mark += 1
        }
        buf_append(out_b, bytes_sub(code, row, i - row))
        gen_debug_suffix(out_b, loc)
        buf_u8(out_b, 10)
        row = i + 1
    }
    if row < code.n { buf_append(out_b, bytes_from(code, row)) }
}

fn gen_debug_basename(t handle[TypeNode]) addr {
    switch t.kind {
        case TYK_BOOL: return c"bool"
        case TYK_CHAR: return c"char"
        case TYK_SCHAR: return c"signed char"
        case TYK_UCHAR: return c"unsigned char"
        case TYK_SHORT: return c"short"
        case TYK_USHORT: return c"unsigned short"
        case TYK_INT: return c"int"
        case TYK_UINT: return c"unsigned int"
        case TYK_LONG: return c"long"
        case TYK_ULONG: return c"unsigned long"
        case TYK_LLONG: return c"long long"
        case TYK_ULLONG: return c"unsigned long long"
        case TYK_INT128: return c"__int128"
        case TYK_UINT128: return c"unsigned __int128"
        case TYK_FLOAT16: return c"_Float16"
        case TYK_BFLOAT16: return c"__bf16"
        case TYK_FLOAT: return c"float"
        case TYK_DOUBLE: return c"double"
        case TYK_LDOUBLE: return c"long double"
        case TYK_FLOAT128: return c"_Float128"
        default: return c""
    }
}

fn gen_debug_write_type(b handle[Buf], ty u32, alias u32) void {
    t handle[TypeNode] = ty_node(ty)
    if alias != 0 {
        buf_str(b, c"typedef ")
        gen_debug_quote(b, cc_name(gc.p.names, alias))
        buf_u8(b, 32)
        gen_debug_uint(b, gen_debug_type(ty, 0))
    } else if t.kind == TYK_PTR || t.kind == TYK_NULLPTR {
        buf_str(b, c"pointer ")
        gen_debug_uint(b, gen_debug_type(t.elem, 0))
    } else if t.kind == TYK_ARRAY || t.kind == TYK_VECTOR {
        buf_str(b, if t.kind == TYK_ARRAY { c"array " } else { c"vector " })
        gen_debug_uint(b, gen_debug_type(t.elem, 0))
        buf_str(b, c" count ")
        n u64 = if t.kind == TYK_ARRAY { t.arr_len } else { zext[u64](t.aux1) / ty_size(t.elem) }
        if t.kind == TYK_ARRAY && t.aux1 == ARR_VLA { buf_str(b, c"-1") }
        else { buf_dec_u64(b, n) }
    } else if t.kind == TYK_FUNC {
        buf_str(b, c"subroutine ")
        gen_debug_uint(b, gen_debug_type(t.elem, 0))
        buf_str(b, c" {")
        for i u32 in 0..t.aux2 {
            if i != 0 { buf_str(b, c", ") }
            gen_debug_uint(b, gen_debug_type(vec_get(&tc.fn_params, zext[usize](t.aux1 + i)), 0))
        }
        buf_u8(b, 125)
        if (t.flags & TYF_VARIADIC) != 0 { buf_str(b, c" variadic") }
    } else if t.kind == TYK_STRUCT || t.kind == TYK_UNION {
        rec handle[RecordDef] = ty_record(t.aux1)
        buf_str(b, if rec.is_union { c"union " } else { c"struct " })
        gen_debug_quote(b, cc_name(gc.p.names, rec.tag_id))
        if !rec.is_complete {
            buf_str(b, c" declared")
            return
        }
        buf_str(b, c" size ")
        buf_dec_u64(b, ty_size(ty))
        buf_str(b, c" {")
        first bool = true
        for i u32 in 0..rec.fields_len {
            f handle[FieldDef] = ty_field(rec.fields_start + i)
            if f.is_bitfield && f.name_id == 0 { continue }
            if !first { buf_str(b, c", ") }
            first = false
            gen_debug_quote(b, cc_name(gc.p.names, f.name_id))
            buf_u8(b, 32)
            gen_debug_uint(b, gen_debug_type(f.ty, 0))
            buf_u8(b, 32)
            if f.is_bitfield {
                buf_dec_u64(b, f.bit_off)
                buf_str(b, c" bits ")
                gen_debug_uint(b, f.bit_width)
            } else { buf_dec_u64(b, f.byte_off) }
        }
        buf_u8(b, 125)
    } else if t.kind == TYK_ENUM {
        e handle[EnumDef] = ty_enum(t.aux1)
        buf_str(b, c"enum ")
        gen_debug_quote(b, cc_name(gc.p.names, e.tag_id))
        buf_u8(b, 32)
        gen_debug_uint(b, gen_debug_type(e.underlying, 0))
        buf_str(b, c" {")
        for i u32 in 0..e.members_len {
            if i != 0 { buf_str(b, c", ") }
            m handle[EnumMember] = ty_enum_member_at(e, i)
            gen_debug_quote(b, cc_name(gc.p.names, m.name))
            buf_u8(b, 32)
            bits u64 = if m.negative { 0 - m.value } else { m.value }
            buf_dec_i64(b, bitcast[i64](bits))
        }
        buf_u8(b, 125)
    } else {
        buf_str(b, c"base ")
        if t.kind == TYK_BITINT {
            buf_u8(b, 34)
            if ty_is_unsigned(ty) { buf_str(b, c"unsigned ") }
            buf_str(b, c"_BitInt(")
            gen_debug_uint(b, t.aux1)
            buf_str(b, c")\"")
        } else if t.kind == TYK_COMPLEX {
            buf_u8(b, 34)
            buf_str(b, gen_debug_basename(ty_node(t.elem)))
            buf_str(b, c" _Complex\"")
        } else {
            gen_debug_quote(b, bytes_c(gen_debug_basename(t)))
        }
        enc addr = if t.kind == TYK_BOOL { c" boolean " }
                   else if t.kind == TYK_CHAR || t.kind == TYK_SCHAR || t.kind == TYK_UCHAR {
                       if ty_is_unsigned(ty) { c" unsigned_char " } else { c" signed_char " }
                   } else if ty_is_real_float(ty) || t.kind == TYK_COMPLEX { c" float " }
                   else if ty_is_unsigned(ty) { c" unsigned " } else { c" signed " }
        buf_str(b, enc)
        buf_dec_u64(b, ty_size(ty))
    }
}

fn gen_debug_finish() void {
    if !gc.debug.enabled { return }
    previous handle[TypeCtx] = tc
    tc = &gc.p.types
    defer { tc = previous }
    // Allocate the id before looking at references. This supports recursive
    // records without duplicating their debug types.
    i usize = 0
    while i < gc.debug.types.n {
        d handle[GenDebugType] = vec_at(&gc.debug.types, i)
        ty u32 = d.ty
        alias u32 = d.alias
        b handle[Buf] = &gc.out.buf
        buf_str(b, c"dtype ")
        i += 1
        buf_dec_u64(b, i)
        buf_u8(b, 32)
        gen_debug_write_type(b, ty, alias)
        buf_u8(b, 10)
    }
    fir_flush(&gc.out)
}
