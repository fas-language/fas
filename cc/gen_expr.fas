        ord u64 = if a2 != null { gen_eval_const_int(a2) } else { 5 }
        al u64 = max_u64(1, ty_align(et))
        lty u32 = if gen_is_mem_ty(et) { gen_atomic_int_ty_for_size(ty_size(et)) } else { et }
        val u32 = if gen_is_mem_ty(et) {
            gen_load_ty(lty, try gen_rvalue(a1), al, false, false)
        } else {
            gen_convert(try gen_rvalue(a1), a1.ty, et)
        }
        v u32 = gen_new_val()
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  ")
        gen_emit_val(b, v)
        buf_str(b, c" = atomic_rmw xchg ")
        gen_emit_fir_ty(b, lty)
        buf_u8(b, 32)
        gen_emit_val(b, p)
        buf_str(b, c", ")
        gen_emit_val(b, val)
        buf_str(b, c", align ")
        buf_dec_u64(b, al)
        buf_u8(b, 32)
        buf_str(b, gen_atomic_order_cstr(ord, false, false))
