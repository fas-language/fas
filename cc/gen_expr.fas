// C23 -> Fir 0.3 expression lowering:
// lvalues, rvalues, conditions, conversions, bitfields, complex, vectors,
// calls (direct/indirect/variadic/returns_twice), and GCC/C23 builtins + atomics.

use "../lib/core.fas"
use "../lib/mem.fas"
use "../lib/vec.fas"
use "../lib/buf.fas"
use "../lib/bytes.fas"
use "../lib/table.fas"
use "types.fas"
use "layout.fas"
use "abi.fas"
use "fir_out.fas"
use "parse.fas"
use "sema_builtin.fas"
use "gen.fas"
use "gen_init.fas"

// ---------- VLA Runtime Size ----------

fn gen_vla_type_size(tid u32) u32 fails {
    u u32 = ty_unqual(tid)
    n handle[TypeNode] = ty_node(u)
    if n.kind == TYK_ARRAY && n.aux1 == ARR_VLA {
        // Check if we already cached this VLA type's size in the current function
        key U64Key = {zext[u64](u)}
        slot u32 = table_get(&gc.vla_sizes, &key) catch 0
        if slot != 0 {
            return gen_load_raw(c"i64", slot, 8, false)
        }
        // Evaluate bound expression from p.vla_bounds
        cnt_v u32 = gen_const_u64(1)
        if n.aux2 > 0 && zext[usize](n.aux2) <= gc.p.vla_bounds.n {
            bound_ast handle[Ast] = handle_from_addr(vec_get(&gc.p.vla_bounds, zext[usize](n.aux2 - 1)))
            if bound_ast != null {
                bv u32 = try gen_rvalue(bound_ast)
                cnt_v = gen_convert(bv, bound_ast.ty, ty_uint64_type())
            }
        }
        elem_sz_v u32 = try gen_vla_type_size(n.elem)
        return gen_binop_raw(c"mul", c"i64", cnt_v, elem_sz_v)
    }
    if n.kind == TYK_ARRAY && n.aux1 == ARR_FIXED {
        if gen_type_is_vla(n.elem) {
            elem_sz_v u32 = try gen_vla_type_size(n.elem)
            cnt_v u32 = gen_const_u64(n.arr_len)
            return gen_binop_raw(c"mul", c"i64", cnt_v, elem_sz_v)
        }
    }
    return gen_const_u64(ty_size(u))
}

fn gen_type_is_vla(tid u32) bool {
    u u32 = ty_unqual(tid)
    n handle[TypeNode] = ty_node(u)
    if n.kind == TYK_ARRAY {
        if n.aux1 == ARR_VLA { return true }
        return gen_type_is_vla(n.elem)
    }
    return false
}

// Evaluate any variably-modified (VLA) bound expressions inside a type (e.g. cast to int (*)[k++])
fn gen_eval_vm_type(tid u32) void fails {
    u u32 = ty_unqual(tid)
    n handle[TypeNode] = ty_node(u)
    if n.kind == TYK_PTR {
        try gen_eval_vm_type(n.elem)
        return
    }
    if n.kind == TYK_ARRAY {
        if n.aux1 == ARR_VLA {
            _ u32 = try gen_eval_vla_size_and_cache(u)
            return
        }
        try gen_eval_vm_type(n.elem)
    }
}

fn gen_eval_vla_size_and_cache(tid u32) u32 fails {
    u u32 = ty_unqual(tid)
    n handle[TypeNode] = ty_node(u)
    if n.kind != TYK_ARRAY { return gen_const_u64(ty_size(u)) }
    // A typedef, typeof operand or inner expression can already own this
    // bound. Its size slot survives even when the bound's locals leave scope.
    key U64Key = {zext[u64](u)}
    cached u32 = table_get(&gc.vla_sizes, &key) catch 0
    if cached != 0 { return gen_load_raw(c"i64", cached, 8, false) }
    elem_sz_v u32 = if gen_type_is_vla(n.elem) {
        try gen_eval_vla_size_and_cache(n.elem)
    } else {
        gen_const_u64(ty_size(n.elem))
    }
    if n.aux1 == ARR_VLA {
        cnt_v u32 = gen_const_u64(1)
        if n.aux2 > 0 && zext[usize](n.aux2) <= gc.p.vla_bounds.n {
            bound_ast handle[Ast] = handle_from_addr(vec_get(&gc.p.vla_bounds, zext[usize](n.aux2 - 1)))
            if bound_ast != null {
                bv u32 = try gen_rvalue(bound_ast)
                cnt_v = gen_convert(bv, bound_ast.ty, ty_uint64_type())
            }
        }
        tot_v u32 = gen_binop_raw(c"mul", c"i64", cnt_v, elem_sz_v)
        slot u32 = gen_alloca_entry(8, 8)
        gen_store_ty(tot_v, slot, 8, false, false)
        _ bool = table_put(&gc.vla_sizes, &key, slot)
        return tot_v
    }
    cnt_v u32 = gen_const_u64(n.arr_len)
    return gen_binop_raw(c"mul", c"i64", cnt_v, elem_sz_v)
}

// ---------- Bitfield Load & Store ----------

fn gen_bitfield_storage_ty(span_bytes u64) u32 {
    if span_bytes == 1 { return TY_UCHAR }
    if span_bytes == 2 { return TY_USHORT }
    if span_bytes == 4 { return TY_UINT }
    if span_bytes == 8 { return ty_uint64_type() }
    return ty_bitint(trunc[u32](span_bytes * 8), true)
}

// Load exactly `span_bytes` bytes into `acc_ty` without reading past `bp + span_bytes`.
// Uses 1 load for exact Fir widths (1, 2, 4, or any multiple of 8 bytes), and at most
// 4 loads (8-byte-multiple prefix + 4/2/1-byte tail) for any other span.
fn gen_load_exact_bytes(bp u32, span_bytes u64, acc_ty u32, is_vol bool) u32 {
    if span_bytes == 1 || span_bytes == 2 || span_bytes == 4 || (span_bytes % 8) == 0 {
        return gen_load_ty(acc_ty, bp, 1, is_vol, false)
    }
    acc u32 = gen_const_zero(acc_ty)
    off u64 = 0
    if span_bytes > 8 {
        prefix_bytes u64 = (span_bytes / 8) * 8
        pt u32 = if prefix_bytes == 8 { ty_uint64_type() } else { ty_bitint(trunc[u32](prefix_bytes * 8), true) }
        pv u32 = gen_load_ty(pt, bp, 1, is_vol, false)
        acc = gen_cast(c"zext", acc_ty, pv)
        off = prefix_bytes
    }
    rem u64 = span_bytes - off
    if rem >= 4 {
        p u32 = if off > 0 { gen_ptradd_const(bp, bitcast[i64](off)) } else { bp }
        cv u32 = gen_cast(c"zext", acc_ty, gen_load_raw(c"i32", p, 1, is_vol))
        if off > 0 { cv = gen_binop(c"shl", acc_ty, cv, gen_const_int(acc_ty, off * 8)) }
        acc = gen_binop(c"or", acc_ty, acc, cv)
        off += 4
        rem -= 4
    }
    if rem >= 2 {
        p u32 = if off > 0 { gen_ptradd_const(bp, bitcast[i64](off)) } else { bp }
        cv u32 = gen_cast(c"zext", acc_ty, gen_load_raw(c"i16", p, 1, is_vol))
        if off > 0 { cv = gen_binop(c"shl", acc_ty, cv, gen_const_int(acc_ty, off * 8)) }
        acc = gen_binop(c"or", acc_ty, acc, cv)
        off += 2
        rem -= 2
    }
    if rem >= 1 {
        p u32 = if off > 0 { gen_ptradd_const(bp, bitcast[i64](off)) } else { bp }
        cv u32 = gen_cast(c"zext", acc_ty, gen_load_raw(c"i8", p, 1, is_vol))
        if off > 0 { cv = gen_binop(c"shl", acc_ty, cv, gen_const_int(acc_ty, off * 8)) }
        acc = gen_binop(c"or", acc_ty, acc, cv)
    }
    return acc
}

// Store exactly `span_bytes` bytes from `acc_ty` without writing past `bp + span_bytes`.
fn gen_store_exact_bytes(bp u32, span_bytes u64, acc_ty u32, acc u32, is_vol bool) void {
    if span_bytes == 1 || span_bytes == 2 || span_bytes == 4 || (span_bytes % 8) == 0 {
        gen_store_ty(acc, bp, 1, is_vol, false)
        return
    }
    off u64 = 0
    if span_bytes > 8 {
        prefix_bytes u64 = (span_bytes / 8) * 8
        pt u32 = if prefix_bytes == 8 { ty_uint64_type() } else { ty_bitint(trunc[u32](prefix_bytes * 8), true) }
        pv u32 = gen_cast(c"trunc", pt, acc)
        gen_store_ty(pv, bp, 1, is_vol, false)
        off = prefix_bytes
    }
    rem u64 = span_bytes - off
    if rem >= 4 {
        p u32 = if off > 0 { gen_ptradd_const(bp, bitcast[i64](off)) } else { bp }
        part u32 = if off > 0 { gen_binop(c"lshr", acc_ty, acc, gen_const_int(acc_ty, off * 8)) } else { acc }
        gen_store_ty(gen_cast_raw(c"trunc", c"i32", part), p, 1, is_vol, false)
        off += 4
        rem -= 4
    }
    if rem >= 2 {
        p u32 = if off > 0 { gen_ptradd_const(bp, bitcast[i64](off)) } else { bp }
        part u32 = if off > 0 { gen_binop(c"lshr", acc_ty, acc, gen_const_int(acc_ty, off * 8)) } else { acc }
        gen_store_ty(gen_cast_raw(c"trunc", c"i16", part), p, 1, is_vol, false)
        off += 2
        rem -= 2
    }
    if rem >= 1 {
        p u32 = if off > 0 { gen_ptradd_const(bp, bitcast[i64](off)) } else { bp }
        part u32 = if off > 0 { gen_binop(c"lshr", acc_ty, acc, gen_const_int(acc_ty, off * 8)) } else { acc }
        gen_store_ty(gen_cast_raw(c"trunc", c"i8", part), p, 1, is_vol, false)
    }
}

fn gen_load_bitfield(base_ptr u32, bit_off u64, bit_width u32, field_ty u32) u32 {
    if bit_width == 0 { return gen_const_int(field_ty, 0) }
    byte_off u64 = bit_off / 8
    bit_in_byte u32 = trunc[u32](bit_off % 8)
    span_bytes u64 = (zext[u64](bit_in_byte) + zext[u64](bit_width) + 7) / 8
    acc_bits u32 = trunc[u32](span_bytes * 8)
    acc_ty u32 = gen_bitfield_storage_ty(span_bytes)
    bp u32 = if byte_off > 0 { gen_ptradd_const(base_ptr, bitcast[i64](byte_off)) } else { base_ptr }
    acc u32 = gen_load_exact_bytes(bp, span_bytes, acc_ty, gen_is_volatile(field_ty))
    if bit_in_byte > 0 {
        sh u32 = gen_const_int(acc_ty, zext[u64](bit_in_byte))
        acc = gen_binop(c"lshr", acc_ty, acc, sh)
    }
    is_s bool = ty_is_signed(field_ty)
    if bit_width < acc_bits {
        narrow_ty u32 = ty_bitint(bit_width, !is_s)
        narrow u32 = gen_cast(c"trunc", narrow_ty, acc)
        return gen_convert(narrow, narrow_ty, field_ty)
    }
    src_ty u32 = if is_s {
        if span_bytes == 1 { TY_SCHAR }
        else if span_bytes == 2 { TY_SHORT }
        else if span_bytes == 4 { TY_INT }
        else if span_bytes == 8 { ty_int64_type() }
        else { ty_bitint(acc_bits, false) }
    } else {
        acc_ty
    }
    return gen_convert(acc, src_ty, field_ty)
}

fn gen_store_bitfield(base_ptr u32, bit_off u64, bit_width u32, field_ty u32, val_v u32) void {
    if bit_width == 0 { return }
    byte_off u64 = bit_off / 8
    bit_in_byte u32 = trunc[u32](bit_off % 8)
    span_bytes u64 = (zext[u64](bit_in_byte) + zext[u64](bit_width) + 7) / 8
    acc_bits u32 = trunc[u32](span_bytes * 8)
    acc_ty u32 = gen_bitfield_storage_ty(span_bytes)
    bp u32 = if byte_off > 0 { gen_ptradd_const(base_ptr, bitcast[i64](byte_off)) } else { base_ptr }
    is_vol bool = gen_is_volatile(field_ty)
    // Fast path: byte-aligned full-width bitfield needs no read-modify-write or shifting
    if bit_in_byte == 0 && bit_width == acc_bits {
        v_acc u32 = gen_convert(val_v, field_ty, acc_ty)
        gen_store_exact_bytes(bp, span_bytes, acc_ty, v_acc, is_vol)
        return
    }
    narrow_ty u32 = ty_bitint(bit_width, true)
    v_narrow u32 = gen_convert(val_v, field_ty, narrow_ty)
    v_acc u32 = if bit_width < acc_bits { gen_cast(c"zext", acc_ty, v_narrow) } else { v_narrow }
    acc u32 = gen_load_exact_bytes(bp, span_bytes, acc_ty, is_vol)
    ones_w u32 = gen_binop(c"sub", narrow_ty, gen_const_zero(narrow_ty), gen_const_int(narrow_ty, 1))
    fmask u32 = if bit_width < acc_bits { gen_cast(c"zext", acc_ty, ones_w) } else { ones_w }
    if bit_in_byte > 0 {
        fmask = gen_binop(c"shl", acc_ty, fmask, gen_const_int(acc_ty, zext[u64](bit_in_byte)))
    }
    all_ones u32 = gen_binop(c"sub", acc_ty, gen_const_zero(acc_ty), gen_const_int(acc_ty, 1))
    clear_v u32 = gen_binop(c"xor", acc_ty, all_ones, fmask)
    acc = gen_binop(c"and", acc_ty, acc, clear_v)
    shifted u32 = v_acc
    if bit_in_byte > 0 {
        sh u32 = gen_const_int(acc_ty, zext[u64](bit_in_byte))
        shifted = gen_binop(c"shl", acc_ty, v_acc, sh)
    }
    acc = gen_binop(c"or", acc_ty, acc, shifted)
    gen_store_exact_bytes(bp, span_bytes, acc_ty, acc, is_vol)
}

// ---------- Type Conversions ----------

fn gen_to_bool(val_v u32, from_ty u32) u32 {
    u u32 = ty_unqual(from_ty)
    k u8 = ty_kind(u)
    if k == TYK_BOOL { return val_v }
    if k == TYK_PTR || k == TYK_NULLPTR || k == TYK_FUNC {
        z u32 = gen_const_zero(TY_NULLPTR)
        return gen_icmp(c"ne", val_v, z)
    }
    if u == TY_FLOAT128 { return gen_quad_compare(c"une", val_v, gen_const_zero(u)) }
    if ty_is_real_float(u) {
        z u32 = gen_const_zero(u)
        return gen_fcmp(c"une", val_v, z)
    }
    if k == TYK_COMPLEX {
        et u32 = ty_node(u).elem
        esz u64 = ty_size(et)
        re u32 = gen_load_ty(et, val_v, ty_align(et), false, false)
        im_p u32 = gen_ptradd_const(val_v, bitcast[i64](esz))
        im u32 = gen_load_ty(et, im_p, ty_align(et), false, false)
        b1 u32 = gen_to_bool(re, et)
        b2 u32 = gen_to_bool(im, et)
        return gen_binop_raw(c"or", c"i1", b1, b2)
    }
    z u32 = gen_const_zero(u)
    return gen_icmp(c"ne", val_v, z)
}

fn gen_convert(val_v u32, from_ty u32, to_ty u32) u32 {
    fu u32 = ty_unqual(from_ty)
    tu u32 = ty_unqual(to_ty)
    if fu == tu || ty_is_void(tu) { return val_v }
    fk u8 = ty_kind(fu)
    tk u8 = ty_kind(tu)

    // To _Bool
    if tk == TYK_BOOL {
        return gen_to_bool(val_v, fu)
    }

    // Complex conversions
    if tk == TYK_COMPLEX {
        et u32 = ty_node(tu).elem
        esz u64 = ty_size(et)
        eal u64 = ty_align(et)
        dst u32 = gen_alloca_entry(2 * esz, eal)
        if fk == TYK_COMPLEX {
            fet u32 = ty_node(fu).elem
            fesz u64 = ty_size(fet)
            feal u64 = ty_align(fet)
            re u32 = gen_load_ty(fet, val_v, feal, false, false)
            im u32 = gen_load_ty(fet, gen_ptradd_const(val_v, bitcast[i64](fesz)), feal, false, false)
            gen_store_ty(gen_convert(re, fet, et), dst, eal, false, false)
            gen_store_ty(gen_convert(im, fet, et), gen_ptradd_const(dst, bitcast[i64](esz)), eal, false, false)
        } else {
            re u32 = gen_convert(val_v, fu, et)
            gen_store_ty(re, dst, eal, false, false)
            gen_store_ty(gen_const_zero(et), gen_ptradd_const(dst, bitcast[i64](esz)), eal, false, false)
        }
        return dst
    }
    if fk == TYK_COMPLEX {
        fet u32 = ty_node(fu).elem
        re u32 = gen_load_ty(fet, val_v, ty_align(fet), false, false)
        return gen_convert(re, fet, tu)
    }

    // Pointer <-> Pointer / Array / Func / nullptr
    f_is_ptr bool = fk == TYK_PTR || fk == TYK_NULLPTR || fk == TYK_FUNC || fk == TYK_ARRAY
    t_is_ptr bool = tk == TYK_PTR || tk == TYK_NULLPTR || tk == TYK_FUNC
    if f_is_ptr && t_is_ptr { return val_v }

    // Pointer -> Integer
    if f_is_ptr && ty_is_integer(tu) {
        p64 u32 = gen_cast_raw(c"ptrtoint", c"i64", val_v)
        return gen_convert(p64, ty_uint64_type(), tu)
    }
    // Integer -> Pointer
    if ty_is_integer(fu) && t_is_ptr {
        i64v u32 = gen_convert(val_v, fu, if ty_is_signed(fu) { ty_int64_type() } else { ty_uint64_type() })
        return gen_cast_raw(c"inttoptr", c"ptr", i64v)
    }

    // Integer -> Integer
    if ty_is_integer(fu) && ty_is_integer(tu) {
        fb u32 = ty_int_bits(fu)
        tb u32 = ty_int_bits(tu)
        if fb == tb { return val_v }
        if tb < fb { return gen_cast(c"trunc", tu, val_v) }
        if ty_is_unsigned(fu) { return gen_cast(c"zext", tu, val_v) }
        return gen_cast(c"sext", tu, val_v)
    }

    if tu == TY_FLOAT128 && (ty_is_integer(fu) || ty_is_real_float(fu)) {
        return gen_to_quad(val_v, fu)
    }
    if fu == TY_FLOAT128 && (ty_is_integer(tu) || ty_is_real_float(tu)) {
        return gen_from_quad(val_v, tu)
    }

    // Integer -> Real Float
    if ty_is_integer(fu) && ty_is_real_float(tu) {
        if ty_is_unsigned(fu) { return gen_cast(c"uitofp", tu, val_v) }
        return gen_cast(c"sitofp", tu, val_v)
    }

    // Real Float -> Integer
    if ty_is_real_float(fu) && ty_is_integer(tu) {
        if ty_is_unsigned(tu) { return gen_cast(c"fptoui", tu, val_v) }
        return gen_cast(c"fptosi", tu, val_v)
    }

    // Real Float -> Real Float
    if ty_is_real_float(fu) && ty_is_real_float(tu) {
        fr u32 = ty_float_rank(fu)
        tr u32 = ty_float_rank(tu)
        if fr == tr { return val_v }
        if tr > fr { return gen_cast(c"fpext", tu, val_v) }
        return gen_cast(c"fptrunc", tu, val_v)
    }

    // GNU cast to aggregate/union (e.g. `(union { V v; U u[2]; }) e`)
    if gen_is_mem_ty(tu) && !gen_is_mem_ty(fu) {
        slot u32 = gen_alloca_entry(ty_size(tu), ty_align(tu))
        if ty_size(tu) > 0 { gen_memset_const(slot, 0, ty_size(tu), false) }
        gen_store_ty(val_v, slot, ty_align(fu), false, false)
        return slot
    }

    // Vector <-> Vector / Integer bitcast (same total size, non-memory types)
    if !gen_is_mem_ty(fu) && !gen_is_mem_ty(tu) &&
       (fk == TYK_VECTOR || tk == TYK_VECTOR) && ty_size(fu) == ty_size(tu) {
        return gen_cast(c"bitcast", tu, val_v)
    }

    // Scalar -> Vector splat (for GNU vector-scalar binary ops where sizes differ)
    if tk == TYK_VECTOR && fk != TYK_VECTOR {
        et u32 = ty_node(tu).elem
        ev u32 = gen_convert(val_v, fu, et)
        v u32 = gen_new_val()
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  ")
        gen_emit_val(b, v)
        buf_str(b, c" = splat ")
        gen_emit_fir_ty(b, tu)
        buf_u8(b, 32)
        gen_emit_val(b, ev)
        buf_u8(b, 10)
        return v
    }

    return val_v
}

fn gen_splat(val_v u32, from_ty u32, vec_ty u32) u32 {
    tu u32 = ty_unqual(vec_ty)
    et u32 = ty_node(tu).elem
    ev u32 = gen_convert(val_v, from_ty, et)
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = splat ")
    gen_emit_fir_ty(b, tu)
    buf_u8(b, 32)
    gen_emit_val(b, ev)
    buf_u8(b, 10)
    return v
}

fn gen_convert_for_binop(val_v u32, from_ty u32, eval_ty u32) u32 {
    if ty_is_vector(eval_ty) && !ty_is_vector(from_ty) {
        return gen_splat(val_v, from_ty, eval_ty)
    }
    return gen_convert(val_v, from_ty, eval_ty)
}

// ---------- Complex Arithmetic ----------

fn gen_complex_binop(op Bytes, tid u32, lhs_p u32, rhs_p u32) u32 {
    et u32 = ty_node(ty_unqual(tid)).elem
    esz u64 = ty_size(et)
    eal u64 = ty_align(et)
    is_flt bool = ty_is_real_float(et)
    a u32 = gen_load_ty(et, lhs_p, eal, false, false)
    b u32 = gen_load_ty(et, gen_ptradd_const(lhs_p, bitcast[i64](esz)), eal, false, false)
    c u32 = gen_load_ty(et, rhs_p, eal, false, false)
    d u32 = gen_load_ty(et, gen_ptradd_const(rhs_p, bitcast[i64](esz)), eal, false, false)
    dst u32 = gen_alloca_entry(2 * esz, eal)
    re u32 = 0
    im u32 = 0
    if bytes_eq_c(op, c"+") {
        re = gen_binop(if is_flt { c"fadd" } else { c"add" }, et, a, c)
        im = gen_binop(if is_flt { c"fadd" } else { c"add" }, et, b, d)
    } else if bytes_eq_c(op, c"-") {
        re = gen_binop(if is_flt { c"fsub" } else { c"sub" }, et, a, c)
        im = gen_binop(if is_flt { c"fsub" } else { c"sub" }, et, b, d)
    } else if bytes_eq_c(op, c"*") {
        mul_op addr = if is_flt { c"fmul" } else { c"mul" }
        add_op addr = if is_flt { c"fadd" } else { c"add" }
        sub_op addr = if is_flt { c"fsub" } else { c"sub" }
        ac u32 = gen_binop(mul_op, et, a, c)
        bd u32 = gen_binop(mul_op, et, b, d)
        ad u32 = gen_binop(mul_op, et, a, d)
        bc u32 = gen_binop(mul_op, et, b, c)
        re = gen_binop(sub_op, et, ac, bd)
        im = gen_binop(add_op, et, ad, bc)
    } else if bytes_eq_c(op, c"/") {
        etk u8 = ty_kind(et)
        if is_flt && (etk == TYK_FLOAT || etk == TYK_DOUBLE || etk == TYK_LDOUBLE) {
            // Call libgcc's C99 Annex G complex division (__divsc3 / __divdc3 / __divxc3)
            fn_nm Bytes = if etk == TYK_FLOAT { bytes_c(c"__divsc3") }
                          else if etk == TYK_LDOUBLE { bytes_c(c"__divxc3") }
                          else { bytes_c(c"__divdc3") }
            // Use the C complex result type so the native ABI can select
            // SSE registers or, for long double, the x87 register pair.
            ptids arr[4, u32] = {et, et, et, et}
            values arr[4, u32] = {a, b, c, d}
            return gen_emit_helper_call(fn_nm, tid, &ptids, &values, 4)
        }
        mul_op addr = if is_flt { c"fmul" } else { c"mul" }
        add_op addr = if is_flt { c"fadd" } else { c"add" }
        sub_op addr = if is_flt { c"fsub" } else { c"sub" }
        div_op addr = if is_flt { c"fdiv" } else if ty_is_unsigned(et) { c"udiv" } else { c"sdiv" }
        ac u32 = gen_binop(mul_op, et, a, c)
        bd u32 = gen_binop(mul_op, et, b, d)
        bc u32 = gen_binop(mul_op, et, b, c)
        ad u32 = gen_binop(mul_op, et, a, d)
        cc u32 = gen_binop(mul_op, et, c, c)
        dd u32 = gen_binop(mul_op, et, d, d)
        den u32 = gen_binop(add_op, et, cc, dd)
        re = gen_binop(div_op, et, gen_binop(add_op, et, ac, bd), den)
        im = gen_binop(div_op, et, gen_binop(sub_op, et, bc, ad), den)
    }
    gen_store_ty(re, dst, eal, false, false)
    gen_store_ty(im, gen_ptradd_const(dst, bitcast[i64](esz)), eal, false, false)
    return dst
}

fn gen_is_ptr_like(tid u32) bool {
    k u8 = ty_kind(tid)
    return k == TYK_PTR || k == TYK_ARRAY || k == TYK_FUNC || k == TYK_NULLPTR
}

fn gen_ptr_elem(tid u32) u32 {
    u u32 = ty_unqual(tid)
    n handle[TypeNode] = ty_node(u)
    if n.kind == TYK_PTR || n.kind == TYK_ARRAY { return n.elem }
    return TY_CHAR
}

// ---------- Lvalue Lowering ----------

fn gen_lvalue(n handle[Ast]) u32 fails {
    if n == null { return gen_const_zero(TY_NULLPTR) }
    if n.kind == ND_NAME && n.decl != null {
        s handle[Symbol] = n.decl
        if gen_stack_pointer_symbol(s) {
            try pa_error(gc.p, n.loc, c"the stack pointer register variable has no address")
        }
        key U64Key = {addr_bits(handle_addr(s))}
        // VLA local? Load pointer from its slot
        vla_slot u32 = table_get(&gc.vla_ptrs, &key) catch 0
        if vla_slot != 0 {
            return gen_load_raw(c"ptr", vla_slot, 8, false)
        }
        // Normal local / param?
        loc_slot u32 = table_get(&gc.locals, &key) catch 0
        if loc_slot != 0 { return loc_slot }
        // Static local?
        sl_nid u32 = table_get(&gc.static_locals, &key) catch 0
        if sl_nid != 0 { return gen_sym_addr(gen_sym_bytes(sl_nid)) }
        // Global function or object
        if ty_is_func(s.ty) {
            gen_note_extern_fn(s)
        } else {
            gen_note_extern_obj(s)
        }
        return gen_sym_addr(gen_sym_fir_name(s))
    }
    if n.kind == ND_UNARY {
        op Bytes = cc_name(gc.p.names, n.op)
        if bytes_eq_c(op, c"*") {
            return try gen_rvalue(n.a)
        }
        if bytes_eq_c(op, c"__real__") || bytes_eq_c(op, c"__real") {
            return try gen_lvalue(n.a)
        }
        if bytes_eq_c(op, c"__imag__") || bytes_eq_c(op, c"__imag") {
            base u32 = try gen_lvalue(n.a)
            et u32 = ty_node(ty_unqual(n.a.ty)).elem
            return gen_ptradd_const(base, bitcast[i64](ty_size(et)))
        }
    }
    if n.kind == ND_MEMBER {
        base u32 = 0
        if ty_is_ptr(n.a.ty) {
            base = try gen_rvalue(n.a)
        } else {
            base = try gen_lvalue(n.a)
        }
        if (n.flags & NF_BITFIELD) != 0 {
            // For bitfields, gen_lvalue returns the base struct pointer; callers use n.field_offset / n.field_width
            return base
        }
        return gen_ptradd_const(base, bitcast[i64](n.field_offset / 8))
    }
    if n.kind == ND_SUBSCRIPT {
        base_ast handle[Ast] = n.a
        idx_ast handle[Ast] = n.b
        if !ty_is_ptr(base_ast.ty) && !ty_is_array(base_ast.ty) && !ty_is_vector(base_ast.ty) {
            base_ast = n.b
            idx_ast = n.a
        }
        base_p u32 = if ty_is_array(base_ast.ty) || ty_is_vector(base_ast.ty) {
            try gen_lvalue(base_ast)
        } else {
            try gen_rvalue(base_ast)
        }
        idx_v u32 = try gen_rvalue(idx_ast)
        idx64 u32 = gen_convert(idx_v, idx_ast.ty, if ty_is_signed(idx_ast.ty) { ty_int64_type() } else { ty_uint64_type() })
        if gen_type_is_vla(n.ty) {
            esz_v u32 = try gen_vla_type_size(n.ty)
            off_v u32 = gen_binop_raw(c"mul", c"i64", idx64, esz_v)
            return gen_ptradd_scaled(base_p, off_v, 1)
        }
        esz u64 = ty_size(n.ty)
        return gen_ptradd_scaled(base_p, idx64, bitcast[i64](if esz > 0 { esz } else { 1 }))
    }
    if n.kind == ND_STRING {
        tmp Buf = {}
        defer { buf_free(&tmp) }
        gen_decode_string_ast(n, &tmp, true)
        nid u32 = gen_emit_string_global(buf_bytes(&tmp), ty_align(n.ty))
        return gen_sym_addr(gen_sym_bytes(nid))
    }
    if n.kind == ND_COMPOUND {
        if n.b != null { _ u32 = try gen_rvalue(n.b) }
        try gen_eval_vm_type(n.ty)
        if (n.op & 255) == zext[u32](SC_STATIC) || (n.op & 255) == zext[u32](SC_CONSTEXPR) {
            nid u32 = gen_emit_static_compound(n)
            return gen_sym_addr(gen_sym_bytes(nid))
        }
        slot u32 = gen_alloca_entry(ty_size(n.ty), ty_align(n.ty))
        try gen_auto_init(slot, n.ty, n.a, true)
        return slot
    }
    if n.kind == ND_GENERIC && n.b != null {
        return try gen_lvalue(n.b)
    }
    // Rvalue aggregate (e.g. function returning struct, then `.field`): already a ptr!
    if gen_is_mem_ty(n.ty) {
        return try gen_rvalue(n)
    }
    // Fallback: materialize rvalue in a temp slot
    rv u32 = try gen_rvalue(n)
    slot u32 = gen_alloca_entry(ty_size(n.ty), ty_align(n.ty))
    gen_store_ty(rv, slot, ty_align(n.ty), false, false)
    return slot
}

// Helper to store a value to an lvalue AST (handling bitfields, aggregates, scalars)
fn gen_store_lvalue(lhs handle[Ast], rhs_v u32, rhs_ty u32) u32 fails {
    if lhs.kind == ND_MEMBER && (lhs.flags & NF_BITFIELD) != 0 {
        base u32 = if ty_is_ptr(lhs.a.ty) { try gen_rvalue(lhs.a) } else { try gen_lvalue(lhs.a) }
        cv u32 = gen_convert(rhs_v, rhs_ty, lhs.ty)
        gen_store_bitfield(base, lhs.field_offset, lhs.field_width, lhs.ty, cv)
        // Return the truncated/sign-extended value stored in the bitfield
        return gen_load_bitfield(base, lhs.field_offset, lhs.field_width, lhs.ty)
    }
    ptr_v u32 = try gen_lvalue(lhs)
    if gen_is_mem_ty(lhs.ty) {
        src_v u32 = if ty_is_complex(lhs.ty) && ty_unqual(rhs_ty) != ty_unqual(lhs.ty) {
            gen_convert(rhs_v, rhs_ty, lhs.ty)
        } else {
            rhs_v
        }
        sz u64 = ty_size(lhs.ty)
        if sz > 0 { gen_memcpy_const(ptr_v, src_v, sz, gen_is_volatile(lhs.ty)) }
        return ptr_v
    }
    cv u32 = gen_convert(rhs_v, rhs_ty, lhs.ty)
    gen_store_ty(cv, ptr_v, ty_align(lhs.ty), gen_is_volatile(lhs.ty), gen_is_atomic(lhs.ty))
    return cv
}

fn gen_load_lvalue(lhs handle[Ast]) u32 fails {
    if lhs.kind == ND_MEMBER && (lhs.flags & NF_BITFIELD) != 0 {
        base u32 = if ty_is_ptr(lhs.a.ty) { try gen_rvalue(lhs.a) } else { try gen_lvalue(lhs.a) }
        return gen_load_bitfield(base, lhs.field_offset, lhs.field_width, lhs.ty)
    }
    ptr_v u32 = try gen_lvalue(lhs)
    if gen_is_mem_ty(lhs.ty) || ty_is_func(lhs.ty) {
        return ptr_v
    }
    return gen_load_ty(lhs.ty, ptr_v, ty_align(lhs.ty), gen_is_volatile(lhs.ty), gen_is_atomic(lhs.ty))
}

// ---------- Binary Arithmetic Helper (also used by compound assign) ----------

// Widen a signed operation and compare with its truncated, sign-extended
// result. This also covers integer widths without a hardware overflow flag.
fn gen_signed_op(op addr, ty u32, lhs u32, rhs u32) u32 {
    if !gc.trapv || !ty_is_signed(ty) { return gen_binop(op, ty, lhs, rhs) }
    bits u32 = ty_int_bits(ty)
    wide_ty u32 = ty_bitint(if op[u8] == 109 { bits * 2 } else { bits + 1 }, false)
    a u32 = gen_convert(lhs, ty, wide_ty)
    b u32 = gen_convert(rhs, ty, wide_ty)
    result u32 = gen_binop(op, wide_ty, a, b)
    narrow u32 = gen_convert(result, wide_ty, ty)
    back u32 = gen_convert(narrow, ty, wide_ty)
    overflow u32 = gen_icmp(c"ne", result, back)
    trap_blk u32 = gen_new_block()
    ok_blk u32 = gen_new_block()
    gen_term_br(overflow, trap_blk, ok_blk)
    gen_switch_block(trap_blk)
    gen_emit_trap()
    gen_term_unreachable()
    gen_switch_block(ok_blk)
    return narrow
}

fn gen_arith_op(op Bytes, eval_ty u32, lhs u32, rhs u32) u32 fails {
    u u32 = ty_unqual(eval_ty)
    k u8 = ty_kind(u)

    if k == TYK_COMPLEX {
        return gen_complex_binop(op, u, lhs, rhs)
    }

    // Pointer arithmetic: ptr +/- int, ptr - ptr
    if k == TYK_PTR || k == TYK_ARRAY {
        elem_ty u32 = gen_ptr_elem(u)
        if bytes_eq_c(op, c"+") {
            idx u32 = rhs
            if gen_type_is_vla(elem_ty) {
                esz_v u32 = try gen_vla_type_size(elem_ty)
                off_v u32 = gen_binop_raw(c"mul", c"i64", idx, esz_v)
                return gen_ptradd_scaled(lhs, off_v, 1)
            }
            esz u64 = ty_size(elem_ty)
            return gen_ptradd_scaled(lhs, idx, bitcast[i64](if esz > 0 { esz } else { 1 }))
        }
        if bytes_eq_c(op, c"-") {
            neg u32 = gen_binop_raw(c"sub", c"i64", gen_const_i64(0), rhs)
            if gen_type_is_vla(elem_ty) {
                esz_v u32 = try gen_vla_type_size(elem_ty)
                off_v u32 = gen_binop_raw(c"mul", c"i64", neg, esz_v)
                return gen_ptradd_scaled(lhs, off_v, 1)
            }
            esz u64 = ty_size(elem_ty)
            return gen_ptradd_scaled(lhs, neg, bitcast[i64](if esz > 0 { esz } else { 1 }))
        }
    }

    if u == TY_FLOAT128 {
        helper addr = c"__divtf3"
        if bytes_eq_c(op, c"+") { helper = c"__addtf3" }
        else if bytes_eq_c(op, c"-") { helper = c"__subtf3" }
        else if bytes_eq_c(op, c"*") { helper = c"__multf3" }
        return gen_quad_binary(helper, TY_FLOAT128, lhs, rhs)
    }
    // Float or float-vector
    is_flt bool = ty_is_real_float(u) || (k == TYK_VECTOR && ty_is_real_float(ty_node(u).elem))
    if is_flt {
        if bytes_eq_c(op, c"+") { return gen_binop(c"fadd", u, lhs, rhs) }
        if bytes_eq_c(op, c"-") { return gen_binop(c"fsub", u, lhs, rhs) }
        if bytes_eq_c(op, c"*") { return gen_binop(c"fmul", u, lhs, rhs) }
        if bytes_eq_c(op, c"/") { return gen_binop(c"fdiv", u, lhs, rhs) }
    }

    is_uns bool = if k == TYK_VECTOR { ty_is_unsigned(ty_node(u).elem) } else { ty_is_unsigned(u) }
    if bytes_eq_c(op, c"+") { return gen_signed_op(c"add", u, lhs, rhs) }
    if bytes_eq_c(op, c"-") { return gen_signed_op(c"sub", u, lhs, rhs) }
    if bytes_eq_c(op, c"*") { return gen_signed_op(c"mul", u, lhs, rhs) }
    if bytes_eq_c(op, c"/") { return gen_binop(if is_uns { c"udiv" } else { c"sdiv" }, u, lhs, rhs) }
    if bytes_eq_c(op, c"%") { return gen_binop(if is_uns { c"urem" } else { c"srem" }, u, lhs, rhs) }
    if bytes_eq_c(op, c"&") { return gen_binop(c"and", u, lhs, rhs) }
    if bytes_eq_c(op, c"|") { return gen_binop(c"or", u, lhs, rhs) }
    if bytes_eq_c(op, c"^") { return gen_binop(c"xor", u, lhs, rhs) }
    if bytes_eq_c(op, c"<<") { return gen_binop(c"shl", u, lhs, rhs) }
    if bytes_eq_c(op, c">>") { return gen_binop(if is_uns { c"lshr" } else { c"ashr" }, u, lhs, rhs) }
    return lhs
}

// ---------- Rvalue Lowering ----------

fn gen_rvalue(n handle[Ast]) u32 fails {
    if n == null || gen_is_terminated() { return gen_const_i32(0) }

    if n.kind == ND_INT {
        if n.wide != null && ty_int_bits(n.ty) > 64 {
            return gen_const_wide_int(n.ty, n.wide, ty_int_bits(n.ty))
        }
        return gen_const_int(n.ty, n.value)
    }
    if n.kind == ND_FLOAT {
        if ty_is_complex(n.ty) {
            et u32 = ty_node(ty_unqual(n.ty)).elem
            esz u64 = ty_size(et)
            eal u64 = ty_align(et)
            slot u32 = gen_alloca_entry(2 * esz, eal)
            imag_ptr u32 = gen_ptradd_const(slot, bitcast[i64](esz))
            if n.b != null {
                gen_store_ty(gen_const_int(et, 0), slot, eal, false, false)
                gen_store_ty(gen_const_int(et, n.b.value), imag_ptr, eal, false, false)
            } else {
                gen_store_ty(gen_const_float(et, n.value), slot, eal, false, false)
                gen_store_ty(gen_const_float_exact(et, n.imag, n.float_bits), imag_ptr, eal, false, false)
            }
            return slot
        }
        return gen_const_float_exact(n.ty, n.value, n.float_bits)
    }
    if n.kind == ND_STRING {
        return try gen_lvalue(n)
    }
    if n.kind == ND_NAME {
        if gen_stack_pointer_symbol(n.decl) {
            v u32 = gen_new_val()
            b handle[Buf] = gen_cur_buf()
            buf_str(b, c"  ")
            gen_emit_val(b, v)
            buf_str(b, c" = asm volatile \"movq %%rsp, %q0\" out(\"=r\" i64)\n")
            return gen_convert(v, ty_uint64_type(), n.ty)
        }
        if n.decl != null && n.decl.storage == SC_ENUMERATOR {
            if n.wide != null && ty_int_bits(n.ty) > 64 {
                return gen_const_wide_int(n.ty, n.wide, ty_int_bits(n.ty))
            }
            return gen_const_int(n.ty, n.value)
        }
        if n.decl != null && n.decl.storage == SC_CONSTEXPR && (n.flags & NF_ICE) != 0 && ty_is_integer(n.ty) {
            if n.wide != null && ty_int_bits(n.ty) > 64 {
                return gen_const_wide_int(n.ty, n.wide, ty_int_bits(n.ty))
            }
            return gen_const_int(n.ty, n.value)
        }
        return try gen_load_lvalue(n)
    }
    if n.kind == ND_MEMBER || n.kind == ND_SUBSCRIPT {
        return try gen_load_lvalue(n)
    }
    if n.kind == ND_COMPOUND {
        ptr_v u32 = try gen_lvalue(n)
        if gen_is_mem_ty(n.ty) { return ptr_v }
        return gen_load_ty(n.ty, ptr_v, ty_align(n.ty), false, false)
    }
    if n.kind == ND_GENERIC {
        if n.b != null { return try gen_rvalue(n.b) }
        return gen_const_i32(0)
    }
    if n.kind == ND_SIZE {
        if (n.flags & NF_ICE) != 0 {
            return gen_const_int(n.ty, n.value)
        }
        if n.a != null {
            if gen_is_mem_ty(n.a.ty) { _ u32 = try gen_lvalue(n.a) }
            else { _ u32 = try gen_rvalue(n.a) }
        }
        if n.b != null { _ u32 = try gen_rvalue(n.b) }
        sz_v u32 = try gen_vla_type_size(n.op)
        return gen_convert(sz_v, ty_uint64_type(), n.ty)
    }
    if n.kind == ND_CAST {
        // Explicit casts to variably-modified types must evaluate VLA bounds at the cast
        if (n.flags & NF_IMPLICIT) == 0 {
            if n.b != null { _ u32 = try gen_rvalue(n.b) }
            try gen_eval_vm_type(n.ty)
        }
        if ty_is_void(n.ty) {
            _ u32 = try gen_rvalue(n.a)
            return gen_const_i32(0)
        }
        rv u32 = try gen_rvalue(n.a)
        return gen_convert(rv, n.a.ty, n.ty)
    }
    if n.kind == ND_BLOCK {
        // GNU statement expression `({ ... })`
        return try gen_stmt_expr(n)
    }
    if n.kind == ND_UNARY {
        return try gen_unary(n)
    }
    if n.kind == ND_BINARY {
        return try gen_binary(n)
    }
    if n.kind == ND_COND {
        return try gen_cond_expr(n)
    }
    if n.kind == ND_CALL {
        return try gen_call(n)
    }
    return gen_const_i32(0)
}

fn gen_unary(n handle[Ast]) u32 fails {
    op Bytes = cc_name(gc.p.names, n.op)
    if bytes_eq_c(op, c"&") {
        return try gen_lvalue(n.a)
    }
    if bytes_eq_c(op, c"*") {
        ptr_v u32 = try gen_rvalue(n.a)
        if gen_is_mem_ty(n.ty) || ty_is_func(n.ty) { return ptr_v }
        return gen_load_ty(n.ty, ptr_v, ty_align(n.ty), gen_is_volatile(n.ty), gen_is_atomic(n.ty))
    }
    if bytes_eq_c(op, c"+") {
        rv u32 = try gen_rvalue(n.a)
        return gen_convert(rv, n.a.ty, n.ty)
    }
    if bytes_eq_c(op, c"-") {
        rv u32 = try gen_rvalue(n.a)
        rv = gen_convert(rv, n.a.ty, n.ty)
        if ty_is_complex(n.ty) {
            et u32 = ty_node(ty_unqual(n.ty)).elem
            esz u64 = ty_size(et)
            eal u64 = ty_align(et)
            re u32 = gen_load_ty(et, rv, eal, false, false)
            im u32 = gen_load_ty(et, gen_ptradd_const(rv, bitcast[i64](esz)), eal, false, false)
            dst u32 = gen_alloca_entry(2 * esz, eal)
            if ty_is_real_float(et) {
                gen_store_ty(gen_unop(c"fneg", et, re), dst, eal, false, false)
                gen_store_ty(gen_unop(c"fneg", et, im), gen_ptradd_const(dst, bitcast[i64](esz)), eal, false, false)
            } else {
                z u32 = gen_const_zero(et)
                gen_store_ty(gen_binop(c"sub", et, z, re), dst, eal, false, false)
                gen_store_ty(gen_binop(c"sub", et, z, im), gen_ptradd_const(dst, bitcast[i64](esz)), eal, false, false)
            }
            return dst
        }
        if ty_unqual(n.ty) == TY_FLOAT128 { return gen_quad_unary(c"__negtf2", TY_FLOAT128, TY_FLOAT128, rv) }
        if ty_is_real_float(n.ty) || (ty_is_vector(n.ty) && ty_is_real_float(ty_node(ty_unqual(n.ty)).elem)) {
            return gen_unop(c"fneg", n.ty, rv)
        }
        return gen_signed_op(c"sub", n.ty, gen_const_zero(n.ty), rv)
    }
    if bytes_eq_c(op, c"~") {
        rv u32 = try gen_rvalue(n.a)
        rv = gen_convert(rv, n.a.ty, n.ty)
        if ty_is_complex(n.ty) {
            // GNU complex conjugate
            et u32 = ty_node(ty_unqual(n.ty)).elem
            esz u64 = ty_size(et)
            eal u64 = ty_align(et)
            re u32 = gen_load_ty(et, rv, eal, false, false)
            im u32 = gen_load_ty(et, gen_ptradd_const(rv, bitcast[i64](esz)), eal, false, false)
            dst u32 = gen_alloca_entry(2 * esz, eal)
            gen_store_ty(re, dst, eal, false, false)
            nim u32 = if ty_is_real_float(et) { gen_unop(c"fneg", et, im) } else { gen_binop(c"sub", et, gen_const_zero(et), im) }
            gen_store_ty(nim, gen_ptradd_const(dst, bitcast[i64](esz)), eal, false, false)
            return dst
        }
        all_ones u32 = gen_binop(c"sub", n.ty, gen_const_zero(n.ty), gen_const_int(n.ty, 1))
        return gen_binop(c"xor", n.ty, rv, all_ones)
    }
    if bytes_eq_c(op, c"!") {
        rv u32 = try gen_rvalue(n.a)
        b1 u32 = gen_to_bool(rv, n.a.ty)
        nb u32 = gen_binop_raw(c"xor", c"i1", b1, gen_const_i1(true))
        return gen_convert(nb, TY_BOOL, n.ty)
    }
    if bytes_eq_c(op, c"__real__") || bytes_eq_c(op, c"__real") {
        rv u32 = try gen_rvalue(n.a)
        if ty_is_complex(n.a.ty) {
            return gen_load_ty(n.ty, rv, ty_align(n.ty), false, false)
        }
        return rv
    }
    if bytes_eq_c(op, c"__imag__") || bytes_eq_c(op, c"__imag") {
        rv u32 = try gen_rvalue(n.a)
        if ty_is_complex(n.a.ty) {
            return gen_load_ty(n.ty, gen_ptradd_const(rv, bitcast[i64](ty_size(n.ty))), ty_align(n.ty), false, false)
        }
        return gen_const_zero(n.ty)
    }
    if bytes_eq_c(op, c"&&") {
        // GNU address-of-label `&&label` resolves the exact scoped label.
        if n.extra != null {
            blk_id u32 = gen_get_label_block(handle_from_addr(n.extra))
            gen_mark_addr_taken(blk_id)
            return gen_emit_blockaddr(blk_id)
        }
        return gen_const_zero(TY_NULLPTR)
    }
    if bytes_eq_c(op, c"++") || bytes_eq_c(op, c"--") {
        is_post bool = n.b != null
        is_inc bool = bytes_eq_c(op, c"++")
        t u32 = ty_unqual(n.a.ty)
        if ty_is_complex(t) {
            ptr_v u32 = try gen_lvalue(n.a)
            et u32 = ty_node(t).elem
            esz u64 = ty_size(et)
            eal u64 = ty_align(et)
            old_re u32 = gen_load_ty(et, ptr_v, eal, gen_is_volatile(n.a.ty), false)
            old_im u32 = gen_load_ty(et, gen_ptradd_const(ptr_v, bitcast[i64](esz)), eal, gen_is_volatile(n.a.ty), false)
            old_slot u32 = 0
            if is_post {
                old_slot = gen_alloca_entry(2 * esz, eal)
                gen_store_ty(old_re, old_slot, eal, false, false)
                gen_store_ty(old_im, gen_ptradd_const(old_slot, bitcast[i64](esz)), eal, false, false)
            }
            new_re u32 = 0
            if ty_is_real_float(et) {
                one u32 = gen_const_float(et, 0x3ff0000000000000)
                new_re = gen_binop(if is_inc { c"fadd" } else { c"fsub" }, et, old_re, one)
            } else {
                one u32 = gen_const_int(et, 1)
                new_re = gen_binop(if is_inc { c"add" } else { c"sub" }, et, old_re, one)
            }
            gen_store_ty(new_re, ptr_v, eal, gen_is_volatile(n.a.ty), false)
            if is_post { return old_slot }
            new_slot u32 = gen_alloca_entry(2 * esz, eal)
            gen_store_ty(new_re, new_slot, eal, false, false)
            gen_store_ty(old_im, gen_ptradd_const(new_slot, bitcast[i64](esz)), eal, false, false)
            return new_slot
        }
        old_v u32 = 0
        new_v u32 = 0
        is_bf bool = n.a.kind == ND_MEMBER && (n.a.flags & NF_BITFIELD) != 0
        ptr_v u32 = 0
        if is_bf {
            ptr_v = if ty_is_ptr(n.a.a.ty) { try gen_rvalue(n.a.a) } else { try gen_lvalue(n.a.a) }
            old_v = gen_load_bitfield(ptr_v, n.a.field_offset, n.a.field_width, n.a.ty)
        } else {
            ptr_v = try gen_lvalue(n.a)
            old_v = gen_load_ty(n.a.ty, ptr_v, ty_align(n.a.ty), gen_is_volatile(n.a.ty), gen_is_atomic(n.a.ty))
        }
        if ty_is_bool(t) {
            new_v = if is_inc { gen_const_i1(true) } else { gen_binop_raw(c"xor", c"i1", old_v, gen_const_i1(true)) }
        } else if ty_is_ptr(t) {
            one u32 = gen_const_i64(1)
            new_v = try gen_arith_op(if is_inc { bytes_c(c"+") } else { bytes_c(c"-") }, t, old_v, one)
        } else if ty_is_real_float(t) {
            one u32 = gen_const_float(t, 0x3ff0000000000000)
            new_v = try gen_arith_op(bytes_c(if is_inc { c"+" } else { c"-" }), t, old_v, one)
        } else {
            promoted u32 = se_promote_expr(n.a)
            one u32 = gen_const_int(promoted, 1)
            old u32 = gen_convert(old_v, t, promoted)
            updated u32 = gen_signed_op(if is_inc { c"add" } else { c"sub" }, promoted, old, one)
            new_v = gen_convert(updated, promoted, t)
        }
        if is_bf {
            gen_store_bitfield(ptr_v, n.a.field_offset, n.a.field_width, n.a.ty, new_v)
            if !is_post { new_v = gen_load_bitfield(ptr_v, n.a.field_offset, n.a.field_width, n.a.ty) }
        } else {
            gen_store_ty(new_v, ptr_v, ty_align(n.a.ty), gen_is_volatile(n.a.ty), gen_is_atomic(n.a.ty))
        }
        return if is_post { old_v } else { new_v }
    }
    return try gen_rvalue(n.a)
}

fn gen_binary(n handle[Ast]) u32 fails {
    op Bytes = cc_name(gc.p.names, n.op)

    // Comma operator
    if bytes_eq_c(op, c",") {
        _ u32 = try gen_rvalue(n.a)
        return try gen_rvalue(n.b)
    }

    // Short-circuit && and ||
    if bytes_eq_c(op, c"&&") || bytes_eq_c(op, c"||") {
        is_and bool = bytes_eq_c(op, c"&&")
        lv u32 = try gen_rvalue(n.a)
        if gen_is_terminated() { return gen_const_zero(n.ty) }
        lb u32 = gen_to_bool(lv, n.a.ty)
        rhs_blk u32 = gen_new_block()
        end_blk u32 = gen_new_block()
        res_b u32 = gen_new_val()
        vec_at(&gc.blocks, zext[usize](end_blk)).bool_param = res_b
        short_value u32 = gen_const_i1(!is_and)
        if is_and { gen_term_br_args(lb, rhs_blk, 0, end_blk, short_value) }
        else { gen_term_br_args(lb, end_blk, short_value, rhs_blk, 0) }
        gen_switch_block(rhs_blk)
        rv u32 = try gen_rvalue(n.b)
        if !gen_is_terminated() { gen_term_jump_arg(end_blk, gen_to_bool(rv, n.b.ty)) }
        gen_switch_block(end_blk)
        return gen_convert(res_b, TY_BOOL, n.ty)
    }

    // Simple assignment `=`
    if bytes_eq_c(op, c"=") {
        rv u32 = try gen_rvalue(n.b)
        return try gen_store_lvalue(n.a, rv, n.b.ty)
    }

    // Compound assignment `+=`, `-=`, `*=`, `/=`, `%=`, `<<=`, `>>=`, `&=`, `^=`, `|=`
    if op.n >= 2 && op.p[u8, op.n - 1] == 61 &&
       !bytes_eq_c(op, c"==") && !bytes_eq_c(op, c"!=") &&
       !bytes_eq_c(op, c"<=") && !bytes_eq_c(op, c">=") {
        base_op Bytes = bytes_sub(op, 0, op.n - 1)
        is_bf bool = n.a.kind == ND_MEMBER && (n.a.flags & NF_BITFIELD) != 0
        ptr_v u32 = if is_bf {
            if ty_is_ptr(n.a.a.ty) { try gen_rvalue(n.a.a) } else { try gen_lvalue(n.a.a) }
        } else {
            try gen_lvalue(n.a)
        }
        rv u32 = try gen_rvalue(n.b)
        old_v u32 = if is_bf {
            gen_load_bitfield(ptr_v, n.a.field_offset, n.a.field_width, n.a.ty)
        } else if gen_is_mem_ty(n.a.ty) {
            ptr_v
        } else {
            gen_load_ty(n.a.ty, ptr_v, ty_align(n.a.ty), gen_is_volatile(n.a.ty), gen_is_atomic(n.a.ty))
        }
        eval_ty u32 = if n.operand_ty != TY_INVALID { n.operand_ty } else { n.a.ty }
        lv_c u32 = gen_convert(old_v, n.a.ty, eval_ty)
        rv_c u32 = if ty_is_ptr(eval_ty) {
            gen_convert(rv, n.b.ty, if ty_is_signed(n.b.ty) { ty_int64_type() } else { ty_uint64_type() })
        } else {
            gen_convert(rv, n.b.ty, eval_ty)
        }
        res_v u32 = try gen_arith_op(base_op, eval_ty, lv_c, rv_c)
        if is_bf {
            cv u32 = gen_convert(res_v, eval_ty, n.a.ty)
            gen_store_bitfield(ptr_v, n.a.field_offset, n.a.field_width, n.a.ty, cv)
            return gen_load_bitfield(ptr_v, n.a.field_offset, n.a.field_width, n.a.ty)
        }
        if gen_is_mem_ty(n.a.ty) {
            sz u64 = ty_size(n.a.ty)
            if sz > 0 { gen_memcpy_const(ptr_v, res_v, sz, gen_is_volatile(n.a.ty)) }
            return ptr_v
        }
        cv u32 = gen_convert(res_v, eval_ty, n.a.ty)
        gen_store_ty(cv, ptr_v, ty_align(n.a.ty), gen_is_volatile(n.a.ty), gen_is_atomic(n.a.ty))
        return cv
    }

    // Comparisons `==`, `!=`, `<`, `<=`, `>`, `>=`
    if bytes_eq_c(op, c"==") || bytes_eq_c(op, c"!=") ||
       bytes_eq_c(op, c"<") || bytes_eq_c(op, c"<=") ||
       bytes_eq_c(op, c">") || bytes_eq_c(op, c">=") {
        // Rvalue lowering decays arrays and functions, and finalizes the
        // result type of certain builtins. Use those types for conversions.
        lv u32 = try gen_rvalue(n.a)
        lhs_ty u32 = se_decay(n.a.ty)
        rv u32 = try gen_rvalue(n.b)
        rhs_ty u32 = se_decay(n.b.ty)
        eval_ty u32 = if n.operand_ty != TY_INVALID { n.operand_ty }
                      else if ty_is_ptr(lhs_ty) { lhs_ty }
                      else if ty_is_ptr(rhs_ty) { rhs_ty }
                      else { lhs_ty }
        lv = gen_convert(lv, lhs_ty, eval_ty)
        rv = gen_convert(rv, rhs_ty, eval_ty)
        u u32 = ty_unqual(eval_ty)
        if ty_is_complex(u) {
            et u32 = ty_node(u).elem
            esz u64 = ty_size(et)
            eal u64 = ty_align(et)
            a u32 = gen_load_ty(et, lv, eal, false, false)
            b u32 = gen_load_ty(et, gen_ptradd_const(lv, bitcast[i64](esz)), eal, false, false)
            c u32 = gen_load_ty(et, rv, eal, false, false)
            d u32 = gen_load_ty(et, gen_ptradd_const(rv, bitcast[i64](esz)), eal, false, false)
            c1 u32 = if ty_is_real_float(et) { gen_fcmp(c"oeq", a, c) } else { gen_icmp(c"eq", a, c) }
            c2 u32 = if ty_is_real_float(et) { gen_fcmp(c"oeq", b, d) } else { gen_icmp(c"eq", b, d) }
            eq u32 = gen_binop_raw(c"and", c"i1", c1, c2)
            if bytes_eq_c(op, c"!=") { eq = gen_binop_raw(c"xor", c"i1", eq, gen_const_i1(true)) }
            return gen_convert(eq, TY_BOOL, n.ty)
        }
        if ty_is_vector(u) {
            ve u32 = ty_node(u).elem
            cnt u64 = ty_size(u) / ty_size(ve)
            is_vflt bool = ty_is_real_float(ve)
            is_vuns bool = ty_is_unsigned(ve)
            pred addr = if is_vflt { c"oeq" } else { c"eq" }
            if bytes_eq_c(op, c"!=") { pred = if is_vflt { c"une" } else { c"ne" } }
            else if bytes_eq_c(op, c"<") { pred = if is_vflt { c"olt" } else if is_vuns { c"ult" } else { c"slt" } }
            else if bytes_eq_c(op, c"<=") { pred = if is_vflt { c"ole" } else if is_vuns { c"ule" } else { c"sle" } }
            else if bytes_eq_c(op, c">") { pred = if is_vflt { c"ogt" } else if is_vuns { c"ugt" } else { c"sgt" } }
            else if bytes_eq_c(op, c">=") { pred = if is_vflt { c"oge" } else if is_vuns { c"uge" } else { c"sge" } }
            cv u32 = gen_new_val()
            b handle[Buf] = gen_cur_buf()
            buf_str(b, c"  ")
            gen_emit_val(b, cv)
            buf_str(b, if is_vflt { c" = fcmp " } else { c" = icmp " })
            buf_str(b, pred)
            if is_vflt && (n.flags & NF_FENV) != 0 { buf_str(b, c" signaling") }
            buf_str(b, c" <")
            buf_dec_u64(b, cnt)
            buf_str(b, c" x i1> ")
            gen_emit_val(b, lv)
            buf_str(b, c", ")
            gen_emit_val(b, rv)
            buf_u8(b, 10)
            return gen_cast(c"sext", n.ty, cv)
        }
        cmp_v u32 = 0
        if ty_is_real_float(u) {
            pred addr = c"oeq"
            if bytes_eq_c(op, c"!=") { pred = c"une" }
            else if bytes_eq_c(op, c"<") { pred = c"olt" }
            else if bytes_eq_c(op, c"<=") { pred = c"ole" }
            else if bytes_eq_c(op, c">") { pred = c"ogt" }
            else if bytes_eq_c(op, c">=") { pred = c"oge" }
            cmp_v = if u == TY_FLOAT128 {
                gen_quad_compare(pred, lv, rv)
            } else {
                gen_float_compare(pred, lv, rv, (n.flags & NF_FENV) != 0)
            }
        } else {
            is_uns bool = ty_is_unsigned(u) || ty_is_ptr(u) || ty_is_nullptr(u)
            pred addr = c"eq"
            if bytes_eq_c(op, c"!=") { pred = c"ne" }
            else if bytes_eq_c(op, c"<") { pred = if is_uns { c"ult" } else { c"slt" } }
            else if bytes_eq_c(op, c"<=") { pred = if is_uns { c"ule" } else { c"sle" } }
            else if bytes_eq_c(op, c">") { pred = if is_uns { c"ugt" } else { c"sgt" } }
            else if bytes_eq_c(op, c">=") { pred = if is_uns { c"uge" } else { c"sge" } }
            cmp_v = gen_icmp(pred, lv, rv)
        }
        return gen_convert(cmp_v, TY_BOOL, n.ty)
    }

    // Pointer difference `ptr - ptr` (including array decay!)
    if bytes_eq_c(op, c"-") && gen_is_ptr_like(n.a.ty) && gen_is_ptr_like(n.b.ty) {
        lp u32 = try gen_rvalue(n.a)
        rp u32 = try gen_rvalue(n.b)
        li u32 = gen_cast_raw(c"ptrtoint", c"i64", lp)
        ri u32 = gen_cast_raw(c"ptrtoint", c"i64", rp)
        diff u32 = gen_binop_raw(c"sub", c"i64", li, ri)
        elem_ty u32 = gen_ptr_elem(n.a.ty)
        esz_v u32 = 0
        if gen_type_is_vla(elem_ty) {
            esz_v = try gen_vla_type_size(elem_ty)
        } else {
            esz u64 = ty_size(elem_ty)
            esz_v = gen_const_i64(bitcast[i64](if esz > 0 { esz } else { 1 }))
        }
        q u32 = gen_binop_raw(c"sdiv", c"i64", diff, esz_v)
        return gen_convert(q, ty_int64_type(), n.ty)
    }

    // Use the result pointer type after array or function designator decay.
    if bytes_eq_c(op, c"+") && (gen_is_ptr_like(n.a.ty) || gen_is_ptr_like(n.b.ty)) {
        if gen_is_ptr_like(n.a.ty) {
            lp u32 = try gen_rvalue(n.a)
            rv u32 = gen_convert(try gen_rvalue(n.b), n.b.ty, if ty_is_signed(n.b.ty) { ty_int64_type() } else { ty_uint64_type() })
            return try gen_arith_op(op, n.ty, lp, rv)
        } else {
            lv u32 = gen_convert(try gen_rvalue(n.a), n.a.ty, if ty_is_signed(n.a.ty) { ty_int64_type() } else { ty_uint64_type() })
            rp u32 = try gen_rvalue(n.b)
            return try gen_arith_op(op, n.ty, rp, lv)
        }
    }
    if bytes_eq_c(op, c"-") && gen_is_ptr_like(n.a.ty) {
        lp u32 = try gen_rvalue(n.a)
        rv u32 = gen_convert(try gen_rvalue(n.b), n.b.ty, if ty_is_signed(n.b.ty) { ty_int64_type() } else { ty_uint64_type() })
        return try gen_arith_op(op, n.ty, lp, rv)
    }

    // Standard arithmetic / bitwise / shift
    eval_ty u32 = if n.operand_ty != TY_INVALID { n.operand_ty } else { n.ty }
    lv u32 = gen_convert_for_binop(try gen_rvalue(n.a), n.a.ty, eval_ty)
    rv u32 = gen_convert_for_binop(try gen_rvalue(n.b), n.b.ty, eval_ty)
    res u32 = try gen_arith_op(op, eval_ty, lv, rv)
    return gen_convert(res, eval_ty, n.ty)
}

fn gen_cond_expr(n handle[Ast]) u32 fails {
    // An unevaluated arm can contain asm with an immediate constraint that
    // is only valid in the selected arm of a __builtin_constant_p test.
    if ty_is_integer(n.a.ty) && (n.a.flags & (NF_ICE | NF_OVERFLOW)) == NF_ICE {
        chosen handle[Ast] = if se_truth(n.a) { n.b } else { n.c }
        v u32 = try gen_rvalue(chosen)
        return gen_convert(v, se_decay(chosen.ty), n.ty)
    }
    is_void bool = ty_is_void(n.ty)
    is_mem bool = gen_is_mem_ty(n.ty)
    res_slot u32 = 0
    if !is_void {
        if is_mem { res_slot = gen_alloca_entry(ty_size(n.ty), ty_align(n.ty)) }
        else { res_slot = gen_alloca_entry(ty_size(n.ty), ty_align(n.ty)) }
    }
    // GNU `a ?: c` encodes n.b == n.a — evaluate n.a once!
    gnu_elided bool = n.b == n.a
    cond_val u32 = try gen_rvalue(n.a)
    cond_b u32 = gen_to_bool(cond_val, n.a.ty)
    t_blk u32 = gen_new_block()
    f_blk u32 = gen_new_block()
    end_blk u32 = gen_new_block()
    gen_term_br(cond_b, t_blk, f_blk)

    gen_switch_block(t_blk)
    tv u32 = if gnu_elided { cond_val } else { try gen_rvalue(n.b) }
    if !is_void && !gen_is_terminated() {
        if is_mem { gen_memcpy_const(res_slot, tv, ty_size(n.ty), false) }
        else { gen_store_ty(gen_convert(tv, n.b.ty, n.ty), res_slot, ty_align(n.ty), false, false) }
    }
    gen_term_jump(end_blk)

    gen_switch_block(f_blk)
    fv u32 = try gen_rvalue(n.c)
    if !is_void && !gen_is_terminated() {
        if is_mem { gen_memcpy_const(res_slot, fv, ty_size(n.ty), false) }
        else { gen_store_ty(gen_convert(fv, n.c.ty, n.ty), res_slot, ty_align(n.ty), false, false) }
    }
    gen_term_jump(end_blk)

    gen_switch_block(end_blk)
    if is_void { return gen_const_i32(0) }
    if is_mem { return res_slot }
    return gen_load_ty(n.ty, res_slot, ty_align(n.ty), false, false)
}

// ---------- Function Calls & Builtins ----------

fn gen_call(n handle[Ast]) u32 fails {
    // Type-taking builtins: n.a == null, n.op = name
    if n.a == null {
        return try gen_type_builtin(n)
    }
    // Name-based builtins: n.a.ty == TY_INVALID && n.a.kind == ND_NAME && n.a.decl == null
    if n.a.ty == TY_INVALID && n.a.kind == ND_NAME && n.a.decl == null {
        bname Bytes = cc_name(gc.p.names, n.a.op)
        return try gen_builtin_call(n, bname)
    }

    // Determine callee function type
    callee_ty u32 = ty_unqual(n.a.ty)
    if ty_is_ptr(callee_ty) { callee_ty = ty_unqual(ty_node(callee_ty).elem) }
    fn_node handle[TypeNode] = ty_node(callee_ty)
    ret_ty u32 = n.ty
    n_fixed u32 = 0
    is_var bool = false
    pstart usize = 0
    if fn_node.kind == TYK_FUNC {
        ret_ty = fn_node.elem
        n_fixed = fn_node.aux2
        is_var = (fn_node.flags & (TYF_VARIADIC | TYF_NO_PROTO)) != 0
        pstart = zext[usize](fn_node.aux1)
    }

    direct_sym handle[Symbol] = gen_direct_callee(n.a)
    is_direct bool = direct_sym != null

    if is_direct {
        definition handle[Ast] = gen_inline_def(direct_sym)
        if definition != null { return try gen_inline_call(n, definition) }
        gen_note_extern_fn(direct_sym)
    }

    // Special case: direct call to `alloca(...)` when not defined in this TU
    if is_direct && direct_sym != null && bytes_eq_c(gen_sym_fir_name(direct_sym), c"alloca") &&
       !gen_is_defined(gen_sym_fir_name_id(direct_sym)) && n.b != null {
        sz_v u32 = gen_convert(try gen_rvalue(n.b), n.b.ty, ty_uint64_type())
        return gen_alloca_dyn(sz_v, 16)
    }

    fp_v u32 = 0
    if !is_direct {
        fp_v = try gen_rvalue(n.a)
    }

    // Evaluate all arguments
    arg_vals Vec[u32] = {}
    arg_tids Vec[u32] = {}
    defer { vec_free(&arg_vals); vec_free(&arg_tids) }
    arg handle[Ast] = n.b
    ai u32 = 0
    while arg != null {
        av u32 = try gen_rvalue(arg)
        at u32 = arg.ty
        if ai < n_fixed {
            pt u32 = vec_get(&tc.fn_params, pstart + zext[usize](ai))
            av = gen_convert(av, at, pt)
            at = pt
        } else {
            // Default argument promotions for variadic args
            if ty_kind(at) == TYK_FLOAT {
                av = gen_convert(av, at, TY_DOUBLE)
                at = TY_DOUBLE
            } else if ty_is_integer(at) && ty_int_bits(at) < 32 && !ty_is_bitint(at) {
                pt u32 = ty_integer_promote(at)
                av = gen_convert(av, at, pt)
                at = pt
            }
        }
        vec_push(&arg_vals, av)
        vec_push(&arg_tids, at)
        arg = arg.next
        ai += 1
    }

    if is_direct {
        result handle[Ast] = gen_inline_constant(direct_sym)
        if result != null {
            if ty_is_void(ret_ty) { return gen_const_i32(0) }
            if ty_is_ptr(ret_ty) { return gen_const_zero(ret_ty) }
            return gen_convert(try gen_rvalue(result), result.ty, ret_ty)
        }
    }

    // If K&R / unprototyped call with more args than fixed params and !is_var, mark variadic or use arg_tids
    sig_params addr = if n_fixed > 0 { tc.fn_params.p + pstart * 4 } else { null }
    sig_n_fixed u32 = n_fixed
    sig_var bool = is_var
    if n_fixed == 0 && arg_tids.n > 0 && !is_var {
        sig_params = arg_tids.p
        sig_n_fixed = trunc[u32](arg_tids.n)
    }

    // Spill any wide _BitInt(>64) arguments BEFORE writing the call instruction!
    for i usize in 0..arg_vals.n {
        at u32 = vec_get(&arg_tids, i)
        if gen_is_wide_bitint(at) {
            slot u32 = gen_alloca_entry(ty_size(at), ty_align(at))
            gen_store_ty(vec_get(&arg_vals, i), slot, ty_align(at), false, false)
            arg_vals.p[u32, i] = slot
        }
    }

    has_ret bool = !ty_is_void(ret_ty)
    res_v u32 = 0
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    if has_ret {
        res_v = gen_new_val()
        gen_emit_val(b, res_v)
        buf_str(b, c" = ")
    }
    buf_str(b, c"call ")
    if direct_sym != null && gen_is_returns_twice(direct_sym) {
        buf_str(b, c"returns_twice ")
    }
    if direct_sym != null && (gen_has_attr(direct_sym.attrs, c"noreturn") || gen_has_attr(direct_sym.attrs, c"_Noreturn")) {
        buf_str(b, c"noreturn ")
    }
    if fn_node.kind == TYK_FUNC && (fn_node.flags & TYF_MS_ABI) != 0 { buf_str(b, c"ms_abi ") }
    abi_emit_fir_sig(b, ret_ty, sig_params, sig_n_fixed, sig_var)
    buf_u8(b, 32)
    if is_direct {
        gen_emit_sym_name(b, gen_sym_fir_name(direct_sym))
    } else {
        gen_emit_val(b, fp_v)
    }
    buf_u8(b, 40) // '('
    for i u32 in 0..trunc[u32](arg_vals.n) {
        if i > 0 { buf_str(b, c", ") }
        at u32 = vec_get(&arg_tids, zext[usize](i))
        av u32 = vec_get(&arg_vals, zext[usize](i))
        if sig_var && i >= sig_n_fixed {
            if ty_is_record(at) {
                abi_emit_fir_agg(b, at)
                buf_u8(b, 32)
            } else if ty_is_complex(at) || gen_is_wide_bitint(at) {
                abi_emit_fir_abi_ty(b, at)
                buf_u8(b, 32)
            }
        }
        gen_emit_val(b, av)
    }
    buf_str(b, c")\n")
    if has_ret && gen_is_wide_bitint(ret_ty) {
        return gen_load_ty(ret_ty, res_v, ty_align(ret_ty), false, false)
    }
    return res_v
}

// ---------- Builtins & Atomics ----------

fn gen_type_builtin(n handle[Ast]) u32 fails {
    bname Bytes = cc_name(gc.p.names, n.op)
    if bytes_eq_c(bname, c"__builtin_va_arg") {
        try gen_eval_vm_type(n.ty)
        if se_is_ms_va_list(gc.p, n.b) {
            // An MS va_list is a cursor over eight-byte slots. The caller
            // stores a pointer in slots whose object cannot fit by value.
            ap u32 = try gen_lvalue(n.b)
            ptr_ty u32 = ty_ptr(TY_VOID)
            slot u32 = gen_load_ty(ptr_ty, ap, 8, false, false)
            gen_store_ty(gen_ptradd_const(slot, 8), ap, 8, false, false)
            size u64 = ty_size(n.ty)
            indirect bool = ty_is_vector(n.ty) || (size != 1 && size != 2 && size != 4 && size != 8)
            src u32 = if indirect { gen_load_ty(ptr_ty, slot, 8, false, false) } else { slot }
            if gen_is_mem_ty(n.ty) {
                dst u32 = gen_alloca_entry(size, ty_align(n.ty))
                if size != 0 { gen_memcpy_const(dst, src, size, false) }
                return dst
            }
            return gen_load_ty(n.ty, src, ty_align(n.ty), false, false)
        }
        ap_v u32 = if tc.ilp32 { try gen_lvalue(n.b) } else { try gen_rvalue(n.b) }
        v u32 = gen_new_val()
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  ")
        gen_emit_val(b, v)
        buf_str(b, c" = va_arg ")
        if ty_is_record(n.ty) {
            abi_emit_fir_agg(b, n.ty)
        } else if ty_is_complex(n.ty) {
            abi_emit_fir_abi_ty(b, n.ty)
        } else {
            gen_emit_fir_ty(b, n.ty)
        }
        buf_u8(b, 32)
        gen_emit_val(b, ap_v)
        buf_u8(b, 10)
        return v
    }
    if bytes_eq_c(bname, c"__builtin_bit_cast") {
        src_ty u32 = n.b.ty
        dst_ty u32 = n.ty
        sz u64 = ty_size(dst_ty)
        al u64 = max_u64(ty_align(src_ty), ty_align(dst_ty))
        slot u32 = gen_alloca_entry(sz, al)
        if gen_is_mem_ty(src_ty) {
            sp u32 = try gen_rvalue(n.b)
            gen_memcpy_const(slot, sp, sz, false)
        } else {
            sv u32 = try gen_rvalue(n.b)
            gen_store_ty(sv, slot, al, false, false)
        }
        if gen_is_mem_ty(dst_ty) { return slot }
        return gen_load_ty(dst_ty, slot, al, false, false)
    }
    if bytes_eq_c(bname, c"__builtin_convertvector") {
        src_v u32 = try gen_rvalue(n.b)
        dst_u u32 = ty_unqual(n.ty)
        src_u u32 = ty_unqual(n.b.ty)
        dn handle[TypeNode] = ty_node(dst_u)
        sn handle[TypeNode] = ty_node(src_u)
        de u32 = dn.elem
        se u32 = sn.elem
        cnt u64 = ty_size(dst_u) / ty_size(de)
        src_slot u32 = gen_alloca_entry(ty_size(src_u), ty_align(src_u))
        dst_slot u32 = gen_alloca_entry(ty_size(dst_u), ty_align(dst_u))
        gen_store_ty(src_v, src_slot, ty_align(src_u), false, false)
        for i u64 in 0..cnt {
            sp u32 = gen_ptradd_const(src_slot, bitcast[i64](i * ty_size(se)))
            dp u32 = gen_ptradd_const(dst_slot, bitcast[i64](i * ty_size(de)))
            ev u32 = gen_load_ty(se, sp, ty_align(se), false, false)
            gen_store_ty(gen_convert(ev, se, de), dp, ty_align(de), false, false)
        }
        return gen_load_ty(dst_u, dst_slot, ty_align(dst_u), false, false)
    }
    return gen_const_zero(n.ty)
}

fn gen_atomic_order_cstr(ord u64, is_load bool, is_store bool) addr {
    // C11 memory_order: 0=relaxed, 1=consume, 2=acquire, 3=release, 4=acq_rel, 5=seq_cst
    if ord == 0 { return c"relaxed" }
    if ord == 1 || ord == 2 {
        if is_store { return c"seq_cst" }
        return c"acquire"
    }
    if ord == 3 {
        if is_load { return c"seq_cst" }
        return c"release"
    }
    if ord == 4 {
        if is_load { return c"acquire" }
        if is_store { return c"release" }
        return c"acq_rel"
    }
    return c"seq_cst"
}

fn gen_builtin_call(n handle[Ast], bname Bytes) u32 fails {
    a0 handle[Ast] = n.b
    a1 handle[Ast] = if a0 != null { a0.next } else { null }
    a2 handle[Ast] = if a1 != null { a1.next } else { null }
    a3 handle[Ast] = if a2 != null { a2.next } else { null }
    a4 handle[Ast] = if a3 != null { a3.next } else { null }

    if bytes_eq_c(bname, c"__builtin_expect") || bytes_eq_c(bname, c"__builtin_expect_with_probability") {
        v u32 = try gen_rvalue(a0)
        // Evaluate remaining arguments for side effects (e.g. __builtin_expect(x, z++))
        rem handle[Ast] = a1
        while rem != null { _ u32 = try gen_rvalue(rem); rem = rem.next }
        return gen_convert(v, a0.ty, n.ty)
    }
    if bytes_eq_c(bname, c"__builtin_unreachable") {
        gen_term_unreachable()
        return gen_const_i32(0)
    }
    if bytes_eq_c(bname, c"__builtin_trap") {
        gen_emit_trap()
        gen_term_unreachable()
        return gen_const_i32(0)
    }
    if bytes_eq_c(bname, c"__builtin_constant_p") {
        return gen_const_i32(0)
    }
    if bytes_eq_c(bname, c"__builtin_assume") {
        return gen_const_i32(0)
    }
    if bytes_eq_c(bname, c"__builtin_prefetch") {
        // Evaluate arguments for side effects
        a handle[Ast] = n.b
        while a != null { _ u32 = try gen_rvalue(a); a = a.next }
        return gen_const_i32(0)
    }
    if bytes_eq_c(bname, c"__builtin_va_start") || bytes_eq_c(bname, c"__builtin_c23_va_start") ||
        bytes_eq_c(bname, c"__builtin_ms_va_start") {
        ap_v u32 = if tc.ilp32 || se_is_ms_va_list(gc.p, a0) { try gen_lvalue(a0) } else { try gen_rvalue(a0) }
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  va_start ")
        gen_emit_val(b, ap_v)
        buf_u8(b, 10)
        return gen_const_i32(0)
    }
    if bytes_eq_c(bname, c"__builtin_va_end") || bytes_eq_c(bname, c"__builtin_ms_va_end") {
        if a0 != null { _ u32 = try gen_rvalue(a0) }
        return gen_const_i32(0)
    }
    if bytes_eq_c(bname, c"__builtin_ms_va_copy") {
        dst u32 = try gen_lvalue(a0)
        src u32 = try gen_rvalue(a1)
        gen_store_ty(src, dst, 8, false, false)
        return gen_const_i32(0)
    }
    if bytes_eq_c(bname, c"__builtin_va_copy") {
        if tc.ilp32 {
            dst u32 = try gen_lvalue(a0)
            src u32 = try gen_rvalue(a1)
            gen_store_ty(src, dst, 4, false, false)
        } else {
            d_v u32 = try gen_rvalue(a0)
            s_v u32 = try gen_rvalue(a1)
            gen_memcpy_const(d_v, s_v, 24, false)
        }
        return gen_const_i32(0)
    }
    if bytes_eq_c(bname, c"__builtin_alloca") || bytes_eq_c(bname, c"__builtin_alloca_with_align") {
        gc.has_alloca = true
        sz_v u32 = gen_convert(try gen_rvalue(a0), a0.ty, ty_uint64_type())
        al u64 = 16
        if a1 != null { al = gen_eval_const_int(a1) / 8; if al < 1 { al = 1 } }
        return gen_alloca_dyn(sz_v, al)
    }
    if bytes_eq_c(bname, c"__builtin_memcpy") {
        d u32 = try gen_rvalue(a0)
        s u32 = try gen_rvalue(a1)
        cnt u32 = gen_convert(try gen_rvalue(a2), a2.ty, ty_uint64_type())
        gen_memcpy_dyn(d, s, cnt, false)
        return d
    }
    if bytes_eq_c(bname, c"__builtin_memmove") {
        d u32 = try gen_rvalue(a0)
        s u32 = try gen_rvalue(a1)
        cnt u32 = gen_convert(try gen_rvalue(a2), a2.ty, ty_uint64_type())
        gen_memmove_dyn(d, s, cnt, false)
        return d
    }
    if bytes_eq_c(bname, c"__builtin_memset") {
        d u32 = try gen_rvalue(a0)
        c_v u32 = gen_convert(try gen_rvalue(a1), a1.ty, TY_UCHAR)
        cnt u32 = gen_convert(try gen_rvalue(a2), a2.ty, ty_uint64_type())
        gen_memset_dyn(d, c_v, cnt, false)
        return d
    }
    // Bit-manipulation builtins (convert argument to the builtin's exact parameter width!)
    if bytes_eq_c(bname, c"__builtin_popcount") || bytes_eq_c(bname, c"__builtin_popcountl") ||
       bytes_eq_c(bname, c"__builtin_popcountll") || bytes_eq_c(bname, c"__builtin_popcountg") {
        pt u32 = if bytes_eq_c(bname, c"__builtin_popcountg") { a0.ty }
                 else if bytes_eq_c(bname, c"__builtin_popcountll") { TY_ULLONG }
                 else if bytes_eq_c(bname, c"__builtin_popcountl") { TY_ULONG }
                 else { TY_UINT }
        v u32 = gen_convert(try gen_rvalue(a0), a0.ty, pt)
        r u32 = gen_unop(c"popcnt", pt, v)
        return gen_convert(r, pt, n.ty)
    }
    clz_ty u32 = se_clz_argument_type(bname)
    if clz_ty != TY_INVALID || bytes_eq_c(bname, c"__builtin_clzg") {
        pt u32 = if clz_ty == TY_INVALID { a0.ty } else { clz_ty }
        v u32 = gen_convert(try gen_rvalue(a0), a0.ty, pt)
        r u32 = gen_convert(gen_unop(c"clz", pt, v), pt, n.ty)
        if a1 != null {
            def_v u32 = gen_convert(try gen_rvalue(a1), a1.ty, n.ty)
            is_z u32 = gen_icmp(c"eq", v, gen_const_zero(pt))
            return gen_select(n.ty, is_z, def_v, r)
        }
        return r
    }
    ctz_ty u32 = se_ctz_argument_type(bname)
    if ctz_ty != TY_INVALID || bytes_eq_c(bname, c"__builtin_ctzg") {
        pt u32 = if ctz_ty == TY_INVALID { a0.ty } else { ctz_ty }
        v u32 = gen_convert(try gen_rvalue(a0), a0.ty, pt)
        r u32 = gen_convert(gen_unop(c"ctz", pt, v), pt, n.ty)
        if a1 != null {
            def_v u32 = gen_convert(try gen_rvalue(a1), a1.ty, n.ty)
            is_z u32 = gen_icmp(c"eq", v, gen_const_zero(pt))
            return gen_select(n.ty, is_z, def_v, r)
        }
        return r
    }
    if bytes_eq_c(bname, c"__builtin_bswap16") || bytes_eq_c(bname, c"__builtin_bswap32") ||
       bytes_eq_c(bname, c"__builtin_bswap64") || bytes_eq_c(bname, c"__builtin_bswap128") {
        v u32 = gen_convert(try gen_rvalue(a0), a0.ty, n.ty)
        return gen_unop(c"bswap", n.ty, v)
    }
    pt u32 = se_ffs_argument_type(bname)
    if pt != TY_INVALID {
        v u32 = gen_convert(try gen_rvalue(a0), a0.ty, pt)
        is_z u32 = gen_icmp(c"eq", v, gen_const_zero(pt))
        cz u32 = gen_convert(gen_unop(c"ctz", pt, v), pt, n.ty)
        p1 u32 = gen_binop(c"add", n.ty, cz, gen_const_int(n.ty, 1))
        return gen_select(n.ty, is_z, gen_const_int(n.ty, 0), p1)
    }
    if bytes_eq_c(bname, c"__builtin_parity") || bytes_eq_c(bname, c"__builtin_parityl") || bytes_eq_c(bname, c"__builtin_parityll") {
        pt u32 = if bytes_eq_c(bname, c"__builtin_parityll") { TY_ULLONG }
                 else if bytes_eq_c(bname, c"__builtin_parityl") { TY_ULONG }
                 else { TY_UINT }
        v u32 = gen_convert(try gen_rvalue(a0), a0.ty, pt)
        pc u32 = gen_convert(gen_unop(c"popcnt", pt, v), pt, n.ty)
        return gen_binop(c"and", n.ty, pc, gen_const_int(n.ty, 1))
    }
    if bytes_eq_c(bname, c"__builtin_object_size") || bytes_eq_c(bname, c"__builtin_dynamic_object_size") {
        // -O0 semantics: upper bound (type & 2 == 0) -> (size_t)-1, lower bound (type & 2 != 0) -> 0
        tval u64 = if a1 != null { gen_eval_const_int(a1) } else { 0 }
        res u64 = if (tval & 2) != 0 { 0 } else { ~0 }
        return gen_const_int(n.ty, res)
    }
    if bytes_eq_c(bname, c"__builtin_assume_aligned") {
        return try gen_rvalue(a0)
    }
    if bytes_eq_c(bname, c"__builtin_ia32_emms") {
        return gen_const_i32(0)
    }
    if bytes_eq_c(bname, c"__builtin_flt_rounds") {
        // The x87 rounding field orders the modes nearest, down, up,
        // toward zero. FLT_ROUNDS reports these as 1, 3, 2, 0.
        slot u32 = gen_alloca_entry(2, 2)
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  asm volatile \"fnstcw %0\" out(\"=m\" ptr ")
        gen_emit_val(b, slot)
        buf_str(b, c")\n")
        cw u32 = gen_convert(gen_load_raw(c"i16", slot, 2, false), TY_USHORT, TY_INT)
        shifted u32 = gen_binop_raw(c"lshr", c"i32", cw, gen_const_i32(9))
        bit_index u32 = gen_binop_raw(c"and", c"i32", shifted, gen_const_i32(6))
        modes u32 = gen_binop_raw(c"lshr", c"i32", gen_const_i32(45), bit_index)
        return gen_binop_raw(c"and", c"i32", modes, gen_const_i32(3))
    }
    if bytes_eq_c(bname, c"__builtin_ia32_pause") {
        // This spin-loop hint also acts as a compiler memory barrier.
        buf_str(gen_cur_buf(), c"  asm volatile \"pause\" clobber(\"memory\")\n")
        return 0
    }
    if bytes_eq_c(bname, c"__builtin_ia32_vec_ext_v4si") {
        v u32 = try gen_rvalue(a0)
        i u32 = try gen_rvalue(a1)
        i = gen_convert(i, a1.ty, TY_INT)
        result u32 = gen_new_val()
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  ")
        gen_emit_val(b, result)
        buf_str(b, c" = extract i32 ")
        gen_emit_val(b, v)
        buf_str(b, c", ")
        gen_emit_val(b, i)
        buf_u8(b, 10)
        return result
    }
    mask128 bool = bytes_eq_c(bname, c"__builtin_ia32_pmovmskb128")
    if mask128 || bytes_eq_c(bname, c"__builtin_ia32_pmovmskb256") {
        // Lane i contributes its sign bit to bit i of the unsigned mask.
        v u32 = try gen_rvalue(a0)
        zero u32 = gen_const_zero(a0.ty)
        signs u32 = gen_new_val()
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  ")
        gen_emit_val(b, signs)
        buf_str(b, if mask128 { c" = icmp slt <16 x i1> " } else { c" = icmp slt <32 x i1> " })
        gen_emit_val(b, v)
        buf_str(b, c", ")
        gen_emit_val(b, zero)
        buf_u8(b, 10)
        if mask128 { return gen_cast(c"zext", n.ty, gen_cast(c"bitcast", TY_USHORT, signs)) }
        return gen_cast(c"bitcast", n.ty, signs)
    }
    is_sat_sub bool = bytes_eq_c(bname, c"__builtin_ia32_psubusb128")
    is_avg bool = bytes_eq_c(bname, c"__builtin_ia32_pavgb128")
    if is_sat_sub || is_avg || bytes_eq_c(bname, c"__builtin_ia32_pminub128") {
        lhs u32 = try gen_rvalue(a0)
        rhs u32 = try gen_rvalue(a1)
        if is_sat_sub { return gen_binop(c"usub_sat", n.ty, lhs, rhs) }
        if is_avg {
            // Rounded unsigned average, without overflowing the byte lanes.
            union_bits u32 = gen_binop(c"or", n.ty, lhs, rhs)
            diff_bits u32 = gen_binop(c"xor", n.ty, lhs, rhs)
            ones u32 = gen_splat(gen_const_i32(1), TY_INT, n.ty)
            half_diff u32 = gen_binop(c"lshr", n.ty, diff_bits, ones)
            return gen_binop(c"sub", n.ty, union_bits, half_diff)
        }
        mask u32 = gen_new_val()
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  ")
        gen_emit_val(b, mask)
        // GCC's intrinsic uses signed-char vector types, but compares unsigned lanes.
        buf_str(b, c" = icmp ult <16 x i1> ")
        gen_emit_val(b, lhs)
        buf_str(b, c", ")
        gen_emit_val(b, rhs)
        buf_u8(b, 10)
        return gen_select(n.ty, mask, lhs, rhs)
    }
    if bytes_starts_with(bname, bytes_c(c"__builtin_nans")) &&
        se_math_family(bytes_from(bname, 10), c"nans") != TY_INVALID {
        return gen_const_float_exact(n.ty, n.value, n.float_bits)
    }
    if bytes_eq_c(bname, c"__builtin_shufflevector") {
        v0 u32 = try gen_rvalue(a0)
        v1 u32 = try gen_rvalue(a1)
        res u32 = gen_new_val()
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  ")
        gen_emit_val(b, res)
        buf_str(b, c" = shuffle ")
        gen_emit_fir_ty(b, n.ty)
        buf_u8(b, 32)
        gen_emit_val(b, v0)
        buf_str(b, c", ")
        gen_emit_val(b, v1)
        buf_str(b, c", [")
        idx handle[Ast] = a2
        first_k bool = true
        while idx != null {
            if !first_k { buf_str(b, c", ") }
            first_k = false
            buf_dec_i64(b, bitcast[i64](gen_eval_const_int(idx)))
            idx = idx.next
        }
        buf_str(b, c"]\n")
        return res
    }
    // C23 <stdckdint.h> ckd_add / ckd_sub / ckd_mul (cc/include/stdckdint.h passes (a, b, res); direct ckd_*(res, a, b) also supported)
    if bytes_eq_c(bname, c"__builtin_ckd_add") || bytes_eq_c(bname, c"__builtin_ckd_sub") ||
       bytes_eq_c(bname, c"__builtin_ckd_mul") || bytes_eq_c(bname, c"ckd_add") ||
       bytes_eq_c(bname, c"ckd_sub") || bytes_eq_c(bname, c"ckd_mul") {
        is_sub bool = bytes_ends_with(bname, bytes_c(c"_sub"))
        is_mul bool = bytes_ends_with(bname, bytes_c(c"_mul"))
        res_ast handle[Ast] = if ty_is_ptr(a0.ty) { a0 } else { a2 }
        lhs_ast handle[Ast] = if ty_is_ptr(a0.ty) { a1 } else { a0 }
        rhs_ast handle[Ast] = if ty_is_ptr(a0.ty) { a2 } else { a1 }
        res_ptr u32 = try gen_rvalue(res_ast)
        res_ty u32 = ty_node(ty_unqual(res_ast.ty)).elem
        v0 u32 = try gen_rvalue(lhs_ast)
        v1 u32 = try gen_rvalue(rhs_ast)
        wide_ty u32 = ty_bitint(129, false)
        w0 u32 = gen_convert(v0, lhs_ast.ty, wide_ty)
        w1 u32 = gen_convert(v1, rhs_ast.ty, wide_ty)
        op_cstr addr = if is_sub { c"sub" } else if is_mul { c"mul" } else { c"add" }
        wres u32 = gen_binop(op_cstr, wide_ty, w0, w1)
        narrow u32 = gen_convert(wres, wide_ty, res_ty)
        gen_store_ty(narrow, res_ptr, ty_align(res_ty), gen_is_volatile(res_ty), false)
        back u32 = gen_convert(narrow, res_ty, wide_ty)
