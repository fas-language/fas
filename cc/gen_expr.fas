            buf_str(b, c"  ")
            gen_emit_val(b, v)
            buf_str(b, c" = load ")
            gen_emit_fir_ty(b, ity)
            buf_u8(b, 32)
            gen_emit_val(b, p)
            buf_str(b, c", align ")
            buf_dec_u64(b, max_u64(1, ty_align(et)))
            buf_u8(b, 32)
            buf_str(b, gen_atomic_order_cstr(ord, true, false))
            buf_u8(b, 10)
            slot u32 = gen_alloca_entry(sz, ty_align(et))
            gen_store_ty(v, slot, ty_align(et), false, false)
            return slot
        }
        v u32 = gen_new_val()
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  ")
        gen_emit_val(b, v)
        buf_str(b, c" = load ")
        gen_emit_fir_ty(b, et)
        buf_u8(b, 32)
        gen_emit_val(b, p)
        buf_str(b, c", align ")
        buf_dec_u64(b, max_u64(1, ty_align(et)))
        buf_u8(b, 32)
        buf_str(b, gen_atomic_order_cstr(ord, true, false))
        buf_u8(b, 10)
        if ty_size(n.ty) != ty_size(et) {
