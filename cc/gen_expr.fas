        z u32 = gen_const_i8(0)
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  store ")
        gen_emit_val(b, z)
        buf_str(b, c", ")
        gen_emit_val(b, p)
        buf_str(b, c", align 1 ")
        buf_str(b, gen_atomic_order_cstr(ord, false, true))
        buf_u8(b, 10)
