        ret_p u32 = try gen_rvalue(a1)
        et u32 = gen_atomic_elem_ty(a0)
        ord u64 = if a2 != null { gen_eval_const_int(a2) } else { 5 }
        sz u64 = ty_size(et)
        al u64 = max_u64(1, ty_align(et))
        lty u32 = if gen_is_mem_ty(et) { gen_atomic_int_ty_for_size(sz) } else { et }
        v u32 = gen_new_val()
