    if bytes_eq_c(bname, c"__atomic_always_lock_free") || bytes_eq_c(bname, c"__atomic_is_lock_free") ||
       bytes_eq_c(bname, c"__c11_atomic_is_lock_free") {
        sz u64 = if a0 != null { gen_eval_const_int(a0) } else { 0 }
        ok bool = sz == 1 || sz == 2 || sz == 4 || sz == 8 || sz == 16
