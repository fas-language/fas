    if bytes_eq_c(bname, c"__sync_val_compare_and_swap") || bytes_eq_c(bname, c"__sync_bool_compare_and_swap") {
        p u32 = try gen_rvalue(a0)
        et u32 = ty_unqual(ty_node(ty_unqual(a0.ty)).elem)
        exp_v u32 = gen_convert(try gen_rvalue(a1), a1.ty, et)
        des u32 = gen_convert(try gen_rvalue(a2), a2.ty, et)
        old_v u32 = gen_new_val()
        ok_v u32 = gen_new_val()
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  ")
        gen_emit_val(b, old_v)
        buf_str(b, c", ")
        gen_emit_val(b, ok_v)
        buf_str(b, c" = cmpxchg (")
        gen_emit_fir_ty(b, et)
        buf_str(b, c", i1) ")
        gen_emit_val(b, p)
        buf_str(b, c", ")
        gen_emit_val(b, exp_v)
        buf_str(b, c", ")
        gen_emit_val(b, des)
        buf_str(b, c", align ")
        buf_dec_u64(b, max_u64(1, ty_align(et)))
        buf_str(b, c" seq_cst, fail seq_cst\n")
        if bytes_eq_c(bname, c"__sync_bool_compare_and_swap") {
            return gen_convert(ok_v, TY_BOOL, n.ty)
        }
        if ty_size(n.ty) != ty_size(et) {
            n.ty = et
            return old_v
        }
        return gen_convert(old_v, et, n.ty)
    }
    if bytes_eq_c(bname, c"__sync_lock_release") {
        p u32 = try gen_rvalue(a0)
        et u32 = ty_unqual(ty_node(ty_unqual(a0.ty)).elem)
        z u32 = gen_const_zero(et)
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  store ")
        gen_emit_val(b, z)
        buf_str(b, c", ")
        gen_emit_val(b, p)
        buf_str(b, c", align ")
        buf_dec_u64(b, max_u64(1, ty_align(et)))
        buf_str(b, c" release\n")
        return gen_const_i32(0)
    }
    // Atomic fetch_OP / OP_fetch (including __c11_atomic_fetch_* and nand)
    is_nand bool = bytes_eq_c(bname, c"__atomic_fetch_nand") || bytes_eq_c(bname, c"__sync_fetch_and_nand") ||
                   bytes_eq_c(bname, c"__atomic_nand_fetch") || bytes_eq_c(bname, c"__sync_nand_and_fetch")
    if is_nand {
        ret_new_n bool = bytes_eq_c(bname, c"__atomic_nand_fetch") || bytes_eq_c(bname, c"__sync_nand_and_fetch")
        p u32 = try gen_rvalue(a0)
        et u32 = gen_atomic_elem_ty(a0)
        al u64 = max_u64(1, ty_align(et))
        val u32 = gen_convert(try gen_rvalue(a1), a1.ty, et)
        ord u64 = if a2 != null { gen_eval_const_int(a2) } else { 5 }
        all_ones u32 = gen_binop(c"sub", et, gen_const_zero(et), gen_const_int(et, 1))
        old_slot u32 = gen_alloca_entry(ty_size(et), al)
        new_slot u32 = gen_alloca_entry(ty_size(et), al)
        init_v u32 = gen_load_ty(et, p, al, false, true)
        gen_store_ty(init_v, old_slot, al, false, false)
        loop_blk u32 = gen_new_block()
        done_blk u32 = gen_new_block()
        gen_term_jump(loop_blk)
        gen_switch_block(loop_blk)
        cur u32 = gen_load_ty(et, old_slot, al, false, false)
        and_v u32 = gen_binop(c"and", et, cur, val)
        nv u32 = gen_binop(c"xor", et, and_v, all_ones)
        gen_store_ty(nv, new_slot, al, false, false)
        ov u32 = gen_new_val()
        ok u32 = gen_new_val()
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  ")
        gen_emit_val(b, ov)
        buf_str(b, c", ")
        gen_emit_val(b, ok)
        buf_str(b, c" = cmpxchg (")
        gen_emit_fir_ty(b, et)
        buf_str(b, c", i1) ")
        gen_emit_val(b, p)
        buf_str(b, c", ")
        gen_emit_val(b, cur)
        buf_str(b, c", ")
        gen_emit_val(b, nv)
        buf_str(b, c", align ")
        buf_dec_u64(b, al)
        buf_u8(b, 32)
        buf_str(b, gen_atomic_order_cstr(ord, false, false))
        buf_str(b, c", fail relaxed\n")
        gen_store_ty(ov, old_slot, al, false, false)
        gen_term_br(ok, done_blk, loop_blk)
        gen_switch_block(done_blk)
        res_v u32 = gen_load_ty(et, if ret_new_n { new_slot } else { old_slot }, al, false, false)
        if ty_size(n.ty) != ty_size(et) {
            n.ty = et
            return res_v
        }
        return gen_convert(res_v, et, n.ty)
    }
    rmw_op addr = null
    ret_new bool = false
    if bytes_eq_c(bname, c"__atomic_fetch_add") || bytes_eq_c(bname, c"__sync_fetch_and_add") || bytes_eq_c(bname, c"__c11_atomic_fetch_add") { rmw_op = c"add" }
    else if bytes_eq_c(bname, c"__atomic_fetch_sub") || bytes_eq_c(bname, c"__sync_fetch_and_sub") || bytes_eq_c(bname, c"__c11_atomic_fetch_sub") { rmw_op = c"sub" }
    else if bytes_eq_c(bname, c"__atomic_fetch_and") || bytes_eq_c(bname, c"__sync_fetch_and_and") || bytes_eq_c(bname, c"__c11_atomic_fetch_and") { rmw_op = c"and" }
    else if bytes_eq_c(bname, c"__atomic_fetch_or") || bytes_eq_c(bname, c"__sync_fetch_and_or") || bytes_eq_c(bname, c"__c11_atomic_fetch_or") { rmw_op = c"or" }
    else if bytes_eq_c(bname, c"__atomic_fetch_xor") || bytes_eq_c(bname, c"__sync_fetch_and_xor") || bytes_eq_c(bname, c"__c11_atomic_fetch_xor") { rmw_op = c"xor" }
    else if bytes_eq_c(bname, c"__atomic_add_fetch") || bytes_eq_c(bname, c"__sync_add_and_fetch") { rmw_op = c"add"; ret_new = true }
    else if bytes_eq_c(bname, c"__atomic_sub_fetch") || bytes_eq_c(bname, c"__sync_sub_and_fetch") { rmw_op = c"sub"; ret_new = true }
    else if bytes_eq_c(bname, c"__atomic_and_fetch") || bytes_eq_c(bname, c"__sync_and_and_fetch") { rmw_op = c"and"; ret_new = true }
    else if bytes_eq_c(bname, c"__atomic_or_fetch") || bytes_eq_c(bname, c"__sync_or_and_fetch") { rmw_op = c"or"; ret_new = true }
    else if bytes_eq_c(bname, c"__atomic_xor_fetch") || bytes_eq_c(bname, c"__sync_xor_and_fetch") { rmw_op = c"xor"; ret_new = true }
    if rmw_op != null {
        p u32 = try gen_rvalue(a0)
        et u32 = gen_atomic_elem_ty(a0)
        // Pointer atomic fetch_add/sub scales by sizeof(*et)!
        is_ptr_et bool = ty_is_ptr(et)
        rmw_ty u32 = if is_ptr_et { TY_ULONG } else { et }
        val u32 = gen_convert(try gen_rvalue(a1), a1.ty, rmw_ty)
        if is_ptr_et {
            esz u64 = ty_size(ty_node(ty_unqual(et)).elem)
            if esz > 1 { val = gen_binop(c"mul", rmw_ty, val, gen_const_int(rmw_ty, esz)) }
        }
        ord u64 = if a2 != null { gen_eval_const_int(a2) } else { 5 }
        old_v u32 = gen_new_val()
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  ")
        gen_emit_val(b, old_v)
        buf_str(b, c" = atomic_rmw ")
        buf_str(b, rmw_op)
        buf_u8(b, 32)
        gen_emit_fir_ty(b, rmw_ty)
        buf_u8(b, 32)
        gen_emit_val(b, p)
        buf_str(b, c", ")
        gen_emit_val(b, val)
        buf_str(b, c", align ")
        buf_dec_u64(b, max_u64(1, ty_align(et)))
        buf_u8(b, 32)
        buf_str(b, gen_atomic_order_cstr(ord, false, false))
        buf_u8(b, 10)
        if ret_new {
            nv u32 = gen_binop(rmw_op, rmw_ty, old_v, val)
            if ty_size(n.ty) != ty_size(et) {
                n.ty = et
                return gen_convert(nv, rmw_ty, et)
            }
            return gen_convert(nv, rmw_ty, n.ty)
        }
        if ty_size(n.ty) != ty_size(et) {
            n.ty = et
            return gen_convert(old_v, rmw_ty, et)
        }
        return gen_convert(old_v, rmw_ty, n.ty)
    }
    return gen_const_zero(n.ty)
}
