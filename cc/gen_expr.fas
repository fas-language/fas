        gen_emit_val(b, s1)
        buf_str(b, c", ")
        gen_emit_val(b, vc)
        buf_u8(b, 10)
        cout1 u32 = gen_binop_raw(c"or", c"i1", c1, c2)
        cout u32 = gen_convert(cout1, TY_BOOL, t)
        gen_store_ty(cout, cp, ty_align(t), false, false)
        return s2
    }
    if bytes_eq_c(bname, c"__builtin_classify_type") {
        cls i32 = -1
        if a0 != null {
            ak u8 = ty_kind(a0.ty)
            if ak == TYK_VOID { cls = 0 }
            else if ak == TYK_BOOL { cls = 4 }
            else if ty_is_integer(a0.ty) { cls = 1 }
            else if ak == TYK_PTR || ak == TYK_ARRAY || ak == TYK_FUNC || ak == TYK_NULLPTR { cls = 5 }
            else if ty_is_real_float(a0.ty) { cls = 8 }
            else if ak == TYK_COMPLEX { cls = 9 }
            else if ak == TYK_STRUCT { cls = 12 }
            else if ak == TYK_UNION { cls = 13 }
        }
        return gen_const_i32(cls)
    }
    if se_math_family(bname, c"__builtin_nan") != TY_INVALID {
        return gen_const_float(n.ty, 0x7ff8000000000000)
    }
    if se_math_family(bname, c"__builtin_inf") != TY_INVALID ||
       se_math_family(bname, c"__builtin_huge_val") != TY_INVALID {
        return gen_const_float(n.ty, 0x7ff0000000000000)
    }

    // Checked overflow builtins: __builtin_add_overflow / sub / mul (and typed variants)
    if bytes_starts_with(bname, bytes_c(c"__builtin_")) &&
       (bytes_ends_with(bname, bytes_c(c"_overflow")) || bytes_ends_with(bname, bytes_c(c"_overflow_p"))) {
        is_sub bool = bytes_starts_with(bname, bytes_c(c"__builtin_sub")) || bytes_starts_with(bname, bytes_c(c"__builtin_ssub")) || bytes_starts_with(bname, bytes_c(c"__builtin_usub"))
        is_mul bool = bytes_starts_with(bname, bytes_c(c"__builtin_mul")) || bytes_starts_with(bname, bytes_c(c"__builtin_smul")) || bytes_starts_with(bname, bytes_c(c"__builtin_umul"))
        is_p bool = bytes_ends_with(bname, bytes_c(c"_overflow_p"))
        v0 u32 = try gen_rvalue(a0)
        v1 u32 = try gen_rvalue(a1)
        res_ptr u32 = if !is_p { try gen_rvalue(a2) } else { 0 }
        res_ty u32 = if !is_p { ty_node(ty_unqual(a2.ty)).elem } else { a2.ty }
        // Widen both operands so any integer / _BitInt fits without overflow
        b0 u32 = ty_int_bits(a0.ty)
        b1 u32 = ty_int_bits(a1.ty)
        br u32 = ty_int_bits(res_ty)
        mb u32 = if b0 > b1 { b0 } else { b1 }
        if br > mb { mb = br }
        wide_bits u32 = if is_mul { mb * 2 + 2 } else { mb + 2 }
        if wide_bits < 129 { wide_bits = 129 }
        wide_ty u32 = ty_bitint(wide_bits, false)
        w0 u32 = gen_convert(v0, a0.ty, wide_ty)
        w1 u32 = gen_convert(v1, a1.ty, wide_ty)
        op_cstr addr = if is_sub { c"sub" } else if is_mul { c"mul" } else { c"add" }
        wres u32 = gen_binop(op_cstr, wide_ty, w0, w1)
        narrow u32 = gen_convert(wres, wide_ty, res_ty)
        if !is_p {
            gen_store_ty(narrow, res_ptr, ty_align(res_ty), gen_is_volatile(res_ty), false)
        }
        back u32 = gen_convert(narrow, res_ty, wide_ty)
        ovf u32 = gen_icmp(c"ne", wres, back)
        return gen_convert(ovf, TY_BOOL, n.ty)
    }

    if bytes_eq_c(bname, c"__builtin_issignaling") {
        v u32 = try gen_rvalue(a0)
        ak u8 = ty_kind(a0.ty)
        is_nan u32 = gen_fcmp(c"uno", v, v)
        qbit_zero u32 = gen_const_i1(false)
        if ak == TYK_FLOAT16 {
            iv u32 = gen_cast_raw(c"bitcast", c"i16", v)
            q u32 = gen_binop_raw(c"and", c"i16", iv, gen_const_int(TY_USHORT, 0x0200))
            qbit_zero = gen_icmp(c"eq", q, gen_const_int(TY_USHORT, 0))
        } else if ak == TYK_FLOAT {
            iv u32 = gen_cast_raw(c"bitcast", c"i32", v)
            q u32 = gen_binop_raw(c"and", c"i32", iv, gen_const_i32(0x00400000))
            qbit_zero = gen_icmp(c"eq", q, gen_const_i32(0))
        } else if ak == TYK_DOUBLE {
            iv u32 = gen_cast_raw(c"bitcast", c"i64", v)
            q u32 = gen_binop_raw(c"and", c"i64", iv, gen_const_u64(0x0008000000000000))
            qbit_zero = gen_icmp(c"eq", q, gen_const_u64(0))
        } else if ak == TYK_LDOUBLE {
            slot u32 = gen_alloca_entry(16, 16)
            gen_store_ty(v, slot, 16, false, false)
            lo u32 = gen_load_raw(c"i64", slot, 8, false)
            q u32 = gen_binop_raw(c"and", c"i64", lo, gen_const_u64(0x4000000000000000))
            qbit_zero = gen_icmp(c"eq", q, gen_const_u64(0))
        }
        res u32 = gen_binop_raw(c"and", c"i1", is_nan, qbit_zero)
        return gen_convert(res, TY_BOOL, n.ty)
    }
    // __atomic_*, __c11_atomic_*, and __sync_* builtins
    if bytes_starts_with(bname, bytes_c(c"__atomic_")) ||
       bytes_starts_with(bname, bytes_c(c"__c11_atomic_")) ||
       bytes_starts_with(bname, bytes_c(c"__sync_")) {
        return try gen_atomic_builtin(n, bname, a0, a1, a2, a3, a4)
    }

    // Fallback: strip `__builtin_` prefix and call the corresponding libc symbol!
    if bytes_starts_with(bname, bytes_c(c"__builtin_")) && bname.n > 10 {
        libc_name Bytes = bytes_from(bname, 10)
        return try gen_direct_helper_call(libc_name, n.ty, n.b)
    }
    return gen_const_zero(n.ty)
}

fn gen_direct_helper_call(cname Bytes, ret_ty u32, args handle[Ast]) u32 fails {
    arg_vals Vec[u32] = {}
    arg_tids Vec[u32] = {}
    defer { vec_free(&arg_vals); vec_free(&arg_tids) }
    a handle[Ast] = args
    while a != null {
        vec_push(&arg_vals, try gen_rvalue(a))
        vec_push(&arg_tids, a.ty)
        a = a.next
    }
    return gen_emit_helper_call(cname, ret_ty, arg_tids.p, arg_vals.p, trunc[u32](arg_tids.n))
}

fn gen_emit_helper_call(cname Bytes, ret_ty u32, arg_tids addr, arg_vals addr, n_args u32) u32 {
    fn_ty u32 = ty_func(ret_ty, arg_tids, n_args, false)
    gen_note_extern_fn_raw(cname, fn_ty)
    has_ret bool = !ty_is_void(ret_ty)
    res_v u32 = 0
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    if has_ret {
        res_v = gen_new_val()
        gen_emit_val(b, res_v)
        buf_str(b, c" = ")
    }
    buf_str(b, c"call ")
    abi_emit_fir_sig(b, ret_ty, arg_tids, n_args, false)
    buf_str(b, c" @")
    buf_append(b, cname)
    buf_u8(b, 40)
    for i u32 in 0..n_args {
        if i > 0 { buf_str(b, c", ") }
        gen_emit_val(b, arg_vals[u32, zext[usize](i)])
    }
    buf_str(b, c")\n")
    return res_v
}

fn gen_atomic_elem_ty(ptr_ast handle[Ast]) u32 {
    et u32 = ty_unqual(ty_node(ty_unqual(ptr_ast.ty)).elem)
    if ty_is_void(et) { return TY_UCHAR }
    return et
}

fn gen_atomic_int_ty_for_size(sz u64) u32 {
    if sz <= 1 { return TY_UCHAR }
    if sz == 2 { return TY_USHORT }
    if sz == 4 { return TY_UINT }
    if sz == 8 { return ty_uint64_type() }
    if sz == 16 { return TY_UINT128 }
    return ty_bitint(trunc[u32](sz * 8), true)
}

fn gen_atomic_builtin(n handle[Ast], bname Bytes, a0 handle[Ast], a1 handle[Ast], a2 handle[Ast], a3 handle[Ast], a4 handle[Ast]) u32 fails {
    a5 handle[Ast] = if a4 != null { a4.next } else { null }
    if bytes_eq_c(bname, c"__atomic_thread_fence") || bytes_eq_c(bname, c"__atomic_signal_fence") ||
       bytes_eq_c(bname, c"__c11_atomic_thread_fence") || bytes_eq_c(bname, c"__c11_atomic_signal_fence") ||
       bytes_eq_c(bname, c"__sync_synchronize") {
        ord u64 = if a0 != null { gen_eval_const_int(a0) } else { 5 }
        if ord == 0 { return gen_const_i32(0) } // relaxed fence is a no-op
        ord_s addr = if ord <= 2 { c"acquire" } else if ord == 3 { c"release" } else if ord == 4 { c"acq_rel" } else { c"seq_cst" }
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  fence ")
        buf_str(b, ord_s)
        buf_u8(b, 10)
        return gen_const_i32(0)
