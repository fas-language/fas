        val_p u32 = try gen_rvalue(a1)
        et u32 = gen_atomic_elem_ty(a0)
        ord u64 = if a2 != null { gen_eval_const_int(a2) } else { 5 }
        al u64 = max_u64(1, ty_align(et))
        lty u32 = if gen_is_mem_ty(et) { gen_atomic_int_ty_for_size(ty_size(et)) } else { et }
        val u32 = gen_load_ty(lty, val_p, al, false, false)
        b handle[Buf] = gen_cur_buf()
        buf_str(b, c"  store ")
        gen_emit_val(b, val)
        buf_str(b, c", ")
        gen_emit_val(b, p)
        buf_str(b, c", align ")
        buf_dec_u64(b, al)
        buf_u8(b, 32)
        buf_str(b, gen_atomic_order_cstr(ord, false, true))
        buf_u8(b, 10)
