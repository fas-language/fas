fn combining_class(cp u32) u32 {
    lo usize = 0
    hi usize = 1164 / 3
    while lo < hi {
        mid usize = lo + (hi - lo) / 2
        if cp < CANONICAL_CLASS[mid * 3] { hi = mid }
        else if cp > CANONICAL_CLASS[mid * 3 + 1] { lo = mid + 1 }
        else { return CANONICAL_CLASS[mid * 3 + 2] }
    }
    return 0
}

fn canonical_pair(a u32, b u32) bool {
    // The Hangul compositions are algorithmic, not part of UnicodeData.
    if a >= 0x1100 && a < 0x1113 && b >= 0x1161 && b < 0x1176 { return true }
    if a >= 0xac00 && a <= 0xd7a3 && (a - 0xac00) % 28 == 0 && b > 0x11a7 && b < 0x11c3 { return true }
    lo usize = 0
    hi usize = 1882 / 2
    while lo < hi {
        mid usize = lo + (hi - lo) / 2
        x u32 = CANONICAL_PAIRS[mid * 2]
        y u32 = CANONICAL_PAIRS[mid * 2 + 1]
        if x < a || (x == a && y < b) { lo = mid + 1 }
        else if x != a || y != b { hi = mid }
        else { return true }
    }
    return false
}
