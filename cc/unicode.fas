fn unicode_range(table addr, count usize, cp u32) bool {
    lo usize = 0
    hi usize = count / 2
    while lo < hi {
        mid usize = lo + (hi - lo) / 2
        if cp < table[u32, mid * 2] { hi = mid }
        else if cp > table[u32, mid * 2 + 1] { lo = mid + 1 }
        else { return true }
    }
    return false
}

fn xid(cp u32, first bool) bool {
    if first { return unicode_range(&XID_START, len(XID_START), cp) }
    return unicode_range(&XID_CONTINUE, len(XID_CONTINUE), cp)
}

value struct Rune {
    cp u32
    width u32
}

// The input has eight zero sentinel bytes. A width of zero denotes malformed UTF-8.
fn utf8(p addr) Rune {
    b u32 = zext[u32](p[u8])
    if b < 128 { return {b, 1} }
    if b < 194 || b > 244 { return {0, 0} }
    width u32 = if b < 224 { 2 } else if b < 240 { 3 } else { 4 }
    cp u32 = b & (127 >> width)
    for i u32 in 1..width {
        c u32 = zext[u32](p[u8, zext[usize](i)])
        if (c & 192) != 128 { return {0, 0} }
        cp = (cp << 6) | (c & 63)
    }
    if (width == 3 && cp < 2048) || (width == 4 && cp < 65536) ||
        (cp >= 55296 && cp <= 57343) || cp > 1114111 { return {0, 0} }
    return {cp, width}
}

fn utf8_append(out handle[Buf], cp u32) void {
    if cp < 128 { buf_u8(out, trunc[u8](cp)); return }
    width u32 = if cp < 2048 { 2 } else if cp < 65536 { 3 } else { 4 }
    mask u32 = 255
    buf_u8(out, trunc[u8]((mask << (8 - width)) | (cp >> (6 * (width - 1)))))
    i u32 = width - 1
    while i > 0 {
        i -= 1
        buf_u8(out, trunc[u8](128 | ((cp >> (i * 6)) & 63)))
    }
}

