// Convert a spelling to bits by dividing an exact integer ratio. Rounding
// the numerator through f64 first loses bits both in f64 and in wider formats.
value struct FloatFormat { precision u32, min_exp i32, max_exp i32, explicit_int bool }
value struct FloatBits { lo u64, hi u64 }

fn flt_mul_add(n WideInt, used u32, factor u64, carry u64) u32 {
    for i u32 in 0..used {
        at usize = zext[usize](i)
        carry += zext[u64](n.p[u32, at]) * factor
        n.p[u32, at] = trunc[u32](carry)
        carry >>= 32
    }
    if carry == 0 { return used }
    n.p[u32, zext[usize](used)] = trunc[u32](carry)
    return used + 1
}

fn flt_infinity(f FloatFormat) FloatBits {
    exp u64 = zext[u64](bitcast[u32](f.max_exp - f.min_exp + 2))
    if f.explicit_int { return {0x8000000000000000, exp} }
    if f.precision <= 64 { return {exp << (f.precision - 1), 0} }
    return {0, exp << (f.precision - 65)}
}

fn flt_ratio_exp(n WideInt, d WideInt) i32 {
    power i32 = bitcast[i32](wi_length(n)) - bitcast[i32](wi_length(d))
    if power >= 0 {
        shifted WideInt = wi_shift(d, bitcast[u32](power), true, false)
        defer { heap_free(shifted.p) }
        return if wi_cmp(n, shifted) < 0 { power - 1 } else { power }
    }
    shifted WideInt = wi_shift(n, bitcast[u32](-power), true, false)
    defer { heap_free(shifted.p) }
    return if wi_cmp(shifted, d) < 0 { power - 1 } else { power }
}

fn flt_round_ratio(n WideInt, d WideInt, sticky bool) WideInt {
    q WideInt = wi_new(128)
    top i32 = bitcast[i32](wi_length(n)) - bitcast[i32](wi_length(d))
    if top >= 0 {
        // The scaled quotient has at most precision + 1 bits. Start
        // division there instead of shifting the entire numerator one bit
        // at a time, which would walk all the limbs even for a tiny quotient.
        shifted WideInt = wi_shift(d, bitcast[u32](top), true, false)
        defer { heap_free(shifted.p) }
        while top >= 0 {
            if wi_cmp(n, shifted) >= 0 {
                wi_add(n, shifted, true)
                wi_set(q, bitcast[u32](top))
            }
            for i u32 in 0..shifted.words {
                at usize = zext[usize](i)
                carry u32 = if i + 1 < shifted.words { shifted.p[u32, at + 1] << 31 } else { 0 }
                shifted.p[u32, at] = (shifted.p[u32, at] >> 1) | carry
            }
            top -= 1
        }
    }
    twice WideInt = wi_shift(n, 1, true, false)
    cmp i32 = wi_cmp(twice, d)
    heap_free(twice.p)
    if cmp > 0 || (cmp == 0 && (sticky || wi_bit(q, 0) != 0)) { flt_mul_add(q, q.words, 1, 1) }
    return q
}

fn flt_pack(n WideInt, d WideInt, scale i32, sticky bool, f FloatFormat) FloatBits {
    exp i32 = flt_ratio_exp(n, d) + scale
    if exp > f.max_exp { return flt_infinity(f) }
    if exp < f.min_exp - bitcast[i32](f.precision) { return {0, 0} }
    if exp < f.min_exp { exp = f.min_exp }
    fraction u32 = f.precision - 1
    shift i32 = scale + bitcast[i32](fraction) - exp
    a WideInt = wi_shift(n, if shift > 0 { bitcast[u32](shift) } else { 0 }, true, false)
    b WideInt = wi_shift(d, if shift < 0 { bitcast[u32](-shift) } else { 0 }, true, false)
    defer { heap_free(a.p); heap_free(b.p) }
    q WideInt = flt_round_ratio(a, b, sticky)
    if wi_bit(q, f.precision) != 0 {
        reduced WideInt = wi_shift(q, 1, false, false)
        heap_free(q.p)
        q = reduced
        exp += 1
    }
    defer { heap_free(q.p) }
    if exp > f.max_exp { return flt_infinity(f) }
    field u64 = if wi_bit(q, fraction) != 0 { zext[u64](bitcast[u32](exp - f.min_exp + 1)) } else { 0 }
    lo u64 = wi_low(q)
    if f.explicit_int { return {lo, field} }
    one u64 = 1
    if fraction < 64 { return {(lo & ((one << fraction) - 1)) | (field << fraction), 0} }
    high_bits u32 = fraction - 64
    hi u64 = q.p[u64, 1] & ((one << high_bits) - 1)
    return {lo, hi | (field << high_bits)}
}

fn flt_literal(s Bytes, first usize, end usize, digits i64, exponent i64, hex bool, f FloatFormat) FloatBits {
    // The caller counts digits starting with the first nonzero digit.
    if digits == 0 { return {0, 0} }
    step i64 = if hex { 4 } else { 1 }
    magnitude i64 = exponent + step * (digits - 1)
    // The leading digit bounds the magnitude without constructing the
    // ratio. In decimal, 2^3 < 10 gives conservative binary bounds.
    halfway i64 = sext[i64](f.min_exp) - zext[i64](f.precision)
    if hex {
        if magnitude > sext[i64](f.max_exp) { return flt_infinity(f) }
        if magnitude + 4 <= halfway { return {0, 0} }
    } else {
        if magnitude > 5000 || magnitude * 3 > sext[i64](f.max_exp) { return flt_infinity(f) }
        if magnitude < -5100 || (magnitude + 1) * 3 <= halfway { return {0, 0} }
    }

    // Even the smallest binary128 rounding boundaries terminate within
    // 16,495 decimal places. Past 20,000 significant digits, the remaining
    // suffix can only distinguish a midpoint from a value just above it.
    kept i64 = if digits < 20000 { digits } else { 20000 }
    scale i64 = exponent + step * (digits - kept)
    extra i64 = if hex { 0 } else if scale >= 0 { scale } else { -scale }
    // 4 bits per mantissa digit and 3 per factor of 5, with headroom
    // for quotient normalization and the remainder comparison.
    width u32 = trunc[u32](kept * 4 + extra * 3) + f.precision * 2 + 16
    n WideInt = wi_new(width)
    d WideInt = wi_new(width)
    defer { heap_free(n.p); heap_free(d.p) }
    nu u32 = 1
    du u32 = 1
    radix u64 = if hex { 16 } else { 10 }
    sticky bool = false
    for i usize in first..end {
        ch u8 = s.p[u8, i]
        if ch == 39 || ch == 46 { continue }
        digit u64 = zext[u64](cc_hex(ch))
        if kept > 0 {
            nu = flt_mul_add(n, nu, radix, digit)
            kept -= 1
        } else if digit != 0 { sticky = true }
    }
    d.p[u32] = 1
    if !hex {
        if scale >= 0 {
            for i i64 in 0..extra { nu = flt_mul_add(n, nu, 5, 0) }
        } else {
            for i i64 in 0..extra { du = flt_mul_add(d, du, 5, 0) }
        }
    }
    return flt_pack(n, d, trunc[i32](scale), sticky, f)
}

fn flt_narrow_value(bits u64, ty u32) f64 {
    if ty == TY_FLOAT { return cvt[f64](bitcast[f32](trunc[u32](bits))) }
    if ty != TY_FLOAT16 { return bitcast[f64](bits) }
    exp u64 = bits >> 10
    frac u64 = bits & 1023
    if exp == 0 { return cvt[f64](frac) / 16777216.0 }
    inf u64 = 0x7ff0000000000000
    if exp == 31 { return bitcast[f64](inf) }
    return bitcast[f64](((exp + 1008) << 52) | (frac << 42))
}
