fn pa_number(p handle[Parser], t Token) handle[Ast] fails {
    s Bytes = cc_spelling(p.names, t)
    hex bool = s.n > 2 && s.p[u8] == 48 && (s.p[u8, 1] | 32) == 120
    fp bool = false
    for i usize in 0..s.n {
        ch u8 = s.p[u8, i] | 32
        if s.p[u8, i] == 46 || (!hex && ch == 101) || (hex && ch == 112) { fp = true; break }
    }
    if fp { return try pa_float(p, t, s, hex) }
    base u64 = 10
    i usize = 0
    if hex { base = 16; i = 2 }
    else if s.n >= 2 && s.p[u8] == 48 {
        if (s.p[u8, 1] | 32) == 98 { base = 2; i = 2 }
        else { base = 8 }
    }
    first usize = i
    v u64 = 0
    overflow bool = false
    while i < s.n {
        d u64 = zext[u64](cc_hex(s.p[u8, i]))
        if d >= base {
            if s.p[u8, i] == 39 && i > first && i + 1 < s.n && zext[u64](cc_hex(s.p[u8, i + 1])) < base {
                i += 1
                continue
            }
            break
        }
        if v > (~0 - d) / base { overflow = true }
        v = v * base + d
        i += 1
    }
    if i == first { try pa_error(p, t.loc, c"invalid integer literal") }
    end usize = i
    uns bool = false
    ranks u32 = 0
    bitint bool = false
    while i < s.n {
        ch u8 = s.p[u8, i]
        if (ch | 32) == 117 && !uns { uns = true }
        else if (ch | 32) == 108 && ranks == 0 && !bitint {
            ranks = 1
            if i + 1 < s.n && s.p[u8, i + 1] == ch { ranks = 2; i += 1 }
        } else if ((ch == 119 && i + 1 < s.n && s.p[u8, i + 1] == 98) ||
            (ch == 87 && i + 1 < s.n && s.p[u8, i + 1] == 66)) && ranks == 0 && !bitint {
            bitint = true
            i += 1
        } else if pa_is_gnu(p) && ((ch | 32) == 105 || (ch | 32) == 106) && i + 1 == s.n {
            n handle[Ast] = pa_node(ND_FLOAT, t.loc, TY_COMPLEX_F64)
            n.op = t.payload
            se_set_fp(n, 0.0)
            n.imag = bitcast[u64](cvt[f64](v))
            return n
        } else { try pa_error(p, t.loc, c"invalid integer literal suffix") }
        i += 1
    }
    ty u32 = TY_INT
    if overflow && !bitint { try pa_error(p, t.loc, c"integer literal too large for the standard integer types") }
    if bitint {
        width u32 = 64 - trunc[u32](clz(v))
        wide WideInt = {}
        if overflow || (width == 64 && !uns) {
            wide = wi_literal(s, first, end, base)
            width = wi_length(wide)
        }
        if width == 0 { width = 1 }
        if !uns { width += 1 }
        if width > 8388608 { try pa_error(p, t.loc, c"integer literal exceeds the supported _BitInt width") }
        ty = ty_bitint(width, uns)
        if width > 64 {
            n handle[Ast] = se_int(t.loc, ty, v)
            wide.width = width
            wide.words = (width + 31) / 32
            wi_store(n, wide)
            return n
        }
    } else if ranks == 0 && !uns && v <= 2147483647 { ty = TY_INT }
    else if ranks == 0 && (uns || base != 10) && v <= 0xffffffff { ty = TY_UINT }
    else if !uns && v <= 0x7fffffffffffffff { ty = if ranks == 2 { TY_LLONG } else { TY_LONG } }
    else if uns || base != 10 || pa_is_gnu(p) { ty = if ranks == 2 { TY_ULLONG } else { TY_ULONG } }
    else { try pa_error(p, t.loc, c"decimal literal cannot be represented by a signed integer type") }
    return se_int(t.loc, ty, v)
}

fn pa_float(p handle[Parser], t Token, s Bytes, hex bool) handle[Ast] fails {
    i usize = if hex { 2 } else { 0 }
    radix f64 = if hex { 16.0 } else { 10.0 }
    expchar u8 = if hex { 112 } else { 101 }
    value f64 = 0.0
    fraction f64 = 1.0
    dot bool = false
    digits u32 = 0
    while i < s.n {
        ch u8 = s.p[u8, i]
        if ch == 46 && !dot { dot = true; i += 1; continue }
        if (ch | 32) == expchar { break }
        if ch == 39 && digits != 0 { i += 1; continue }
        d u32 = cc_hex(ch)
        if d >= (if hex { 16 } else { 10 }) { break }
        digits += 1
        if dot { fraction /= radix; value += cvt[f64](d) * fraction }
        else { value = value * radix + cvt[f64](d) }
        i += 1
    }
    if digits == 0 { try pa_error(p, t.loc, c"invalid floating literal") }
    if i < s.n && (s.p[u8, i] | 32) == expchar {
        i += 1
        negative bool = i < s.n && s.p[u8, i] == 45
        if i < s.n && (negative || s.p[u8, i] == 43) { i += 1 }
        j usize = i
        power u32 = 0
        while i < s.n && s.p[u8, i] >= 48 && s.p[u8, i] <= 57 {
            if power < 100000 { power = power * 10 + zext[u32](s.p[u8, i] - 48) }
            i += 1
            if i < s.n && s.p[u8, i] == 39 { i += 1 }
        }
        if j == i { try pa_error(p, t.loc, c"invalid floating exponent") }
        scale f64 = if hex { 2.0 } else { 10.0 }
        if negative { scale = 1.0 / scale }
        while power != 0 {
            if (power & 1) != 0 { value *= scale }
            scale *= scale
            power >>= 1
        }
    } else if hex { try pa_error(p, t.loc, c"hexadecimal floating literal requires an exponent") }
    ty u32 = TY_DOUBLE
    imaginary bool = false
    if pa_is_gnu(p) && i < s.n && pa_imaginary(s.p[u8, i]) { imaginary = true; i += 1 }
    if i < s.n {
        suffix u8 = s.p[u8, i] | 32
        if suffix == 102 {
            ty = TY_FLOAT
            i += 1
            if i + 1 < s.n && s.p[u8, i] == 49 && s.p[u8, i + 1] == 54 {
                ty = TY_FLOAT16
                i += 2
            }
        }
        else if suffix == 108 { ty = TY_LDOUBLE; i += 1 }
        else if suffix == 113 && pa_is_gnu(p) { ty = TY_LDOUBLE; i += 1 }
        if i < s.n && !imaginary && pa_is_gnu(p) && pa_imaginary(s.p[u8, i]) { imaginary = true; i += 1 }
        if i != s.n { try pa_error(p, t.loc, c"invalid floating literal suffix") }
    }
    if imaginary {
        if ty == TY_FLOAT { value = cvt[f64](cvt[f32](value)) }
        ty = ty_complex(ty)
    }
    n handle[Ast] = pa_node(ND_FLOAT, t.loc, ty)
    n.op = t.payload
    if imaginary {
        se_set_fp(n, 0.0)
        n.imag = bitcast[u64](value)
    } else { se_set_fp(n, value) }
    return n
}

fn pa_imaginary(ch u8) bool {
    return (ch | 32) == 105 || (ch | 32) == 106
}

fn pa_prefix_width(s Bytes) u8 {
    if s.p[u8] == 117 {
        if s.p[u8, 1] == 56 { return 1 }
        return 2
    }
    if s.p[u8] == 85 || s.p[u8] == 76 { return 4 }
    return 0
}

fn pa_string_length(p handle[Parser], t Token, s Bytes, code_width u8) u64 fails {
    i usize = 0
    while s.p[u8, i] != 34 { i += 1 }
    i += 1
    count u64 = 0
    while i + 1 < s.n {
        byte u8 = s.p[u8, i]
        if byte == 92 {
            i += 1
            ch u8 = s.p[u8, i]
            esc Escape = try expr_escape(p.names, bytes_from(s, i), t.loc)
            i += esc.width
            universal bool = ch == 117 || ch == 85 || ch == 78
            if universal && code_width <= 1 && esc.cp >= 128 {
                if esc.cp < 2048 { count += 1 }
                else if esc.cp < 65536 { count += 2 }
                else { count += 3 }
            }
            if code_width == 2 && universal && esc.cp > 65535 { count += 1 }
            if !universal && ((code_width <= 1 && esc.cp > 255) || (code_width == 2 && esc.cp > 65535)) {
                try pa_error(p, t.loc, c"numeric escape is out of range for this character type")
            }
        } else if byte >= 128 && code_width >= 2 {
            rune Rune = utf8(s.p + i)
            i += zext[usize](rune.width)
            if rune.width == 0 { try pa_error(p, t.loc, c"invalid UTF-8 in literal") }
            if code_width == 2 && rune.cp > 65535 { count += 1 }
        } else { i += 1 }
        count += 1
    }
    return count
}

fn pa_strings(p handle[Parser]) handle[Ast] fails {
    first Token = try pa_peek(p)
    if first.kind != TK_STR { try pa_error(p, first.loc, c"expected a string literal") }
    pieces AstList = {}
    width u8 = 0
    t Token = first
    while t.kind == TK_STR {
        try pa_take(p)
        s Bytes = cc_spelling(p.names, t)
        w u8 = pa_prefix_width(s)
        if width != 0 && w != 0 && width != w { try pa_error(p, t.loc, c"incompatible string literal prefixes") }
        if w != 0 { width = w }
        piece handle[Ast] = pa_node(ND_STRING, t.loc, TY_INVALID)
        piece.op = t.payload
        pa_append(&pieces, piece)
        t = try pa_peek(p)
    }
    count u64 = 1
    piece handle[Ast] = pieces.first
    elem u32 = TY_CHAR
    if width == 1 { elem = TY_UCHAR }
    if width == 2 { elem = TY_USHORT }
    if width == 4 {
        elem = TY_UINT
        x handle[Ast] = pieces.first
        while x != null {
            if cc_name(p.names, x.op).p[u8] == 76 { elem = TY_INT; break }
            x = x.next
        }
    }
    while piece != null {
        count += try pa_string_length(p, cc_token(TK_STR, 0, piece.loc, piece.op), cc_name(p.names, piece.op), width)
        piece = piece.next
    }
    n handle[Ast] = pa_node(ND_STRING, first.loc, ty_array(elem, count))
    n.op = first.payload
    n.a = pieces.first
    n.value = count
    n.flags = NF_LVALUE | NF_STATIC | NF_ADDR
    return n
}

fn pa_offsetof(p handle[Parser], t Token) handle[Ast] fails {
    try pa_expect(p, c"(")
    ty u32 = try pa_type_name(p)
    try pa_expect(p, c",")
    total u64 = 0
    expr handle[Ast] = null
    while true {
        member Token = try pa_take(p)
        id u32 = try pa_ident(p, member)
        field FieldLookup = {}
        if !ty_is_record(ty) || !se_complete(ty) || !ty_offsetof(ty, id, &field) || field.is_bitfield {
            try pa_error(p, member.loc, c"offsetof requires a non-bit-field member")
        }
        ty = field.ty
        total += field.byte_off
        while try pa_accept(p, c"[") {
            e handle[Ast] = try pa_expression(p, 1)
            try pa_expect(p, c"]")
            if !ty_is_array(ty) || !ty_is_integer(e.ty) { try pa_error(p, e.loc, c"invalid offsetof subscript") }
            ty = ty_node(ty_unqual(ty)).elem
            if (e.flags & NF_ICE) != 0 { total += e.value * ty_size(ty) }
            else { expr = e }
        }
        if !(try pa_accept(p, c".")) { break }
    }
    try pa_expect(p, c")")
    n handle[Ast] = se_int(t.loc, TY_ULONG, total)
    if expr != null { n.flags = 0; n.a = expr }
    return n
}

fn pa_generic(p handle[Parser], t Token) handle[Ast] fails {
    try pa_expect(p, c"(")
    key handle[Ast] = try pa_expression(p, 2)
    try pa_expect(p, c",")
    chosen handle[Ast] = null
    fallback handle[Ast] = null
    alternatives AstList = {}
    types Vec[u32] = {}
    while true {
        ty u32 = TY_INVALID
        loc u32 = (try pa_peek(p)).loc
        if !(try pa_accept(p, c"default")) {
            ty = try pa_type_name(p)
            if !se_complete(ty) || se_vla(ty) { try pa_error(p, loc, c"generic association requires a complete non-VLA type") }
            for i usize in 0..types.n {
                if ty_compatible(ty, types.p[u32, i]) { try pa_error(p, loc, c"duplicate compatible generic association") }
            }
            vec_push[u32](&types, ty)
        }
        try pa_expect(p, c":")
        e handle[Ast] = try pa_expression(p, 2)
        assoc handle[Ast] = pa_node(ND_GENERIC, loc, ty)
        assoc.a = e
        pa_append(&alternatives, assoc)
        if ty == TY_INVALID {
            if fallback != null { try pa_error(p, loc, c"duplicate default generic association") }
            fallback = e
        } else if ty_compatible(se_decay(key.ty), ty) { chosen = e }
        if !(try pa_accept(p, c",")) { break }
    }
    try pa_expect(p, c")")
    if chosen == null { chosen = fallback }
    if chosen == null { try pa_error(p, t.loc, c"no matching generic association") }
    n handle[Ast] = pa_node(ND_GENERIC, t.loc, chosen.ty)
    n.flags = chosen.flags
    n.value = chosen.value
    n.wide = chosen.wide
    n.imag = chosen.imag
    n.a = key
    n.b = chosen
    n.c = alternatives.first
    return n
}

fn pa_builtin_call(p handle[Parser], t Token) handle[Ast] fails {
    if pa_is(p, t, c"__builtin_offsetof") { return try pa_offsetof(p, t) }
    if pa_is(p, t, c"__builtin_types_compatible_p") {
        try pa_expect(p, c"(")
        a u32 = try pa_type_name(p)
        try pa_expect(p, c",")
        b u32 = try pa_type_name(p)
        try pa_expect(p, c")")
        return se_int(t.loc, TY_INT, if ty_compatible(ty_unqual(a), ty_unqual(b)) { 1 } else { 0 })
    }
    if pa_is(p, t, c"__builtin_choose_expr") {
        try pa_expect(p, c"(")
        key handle[Ast] = try pa_expression(p, 2)
        selected bool = (try se_ice(p, key)) != 0
        try pa_expect(p, c",")
        a handle[Ast] = try pa_expression(p, 2)
        try pa_expect(p, c",")
        b handle[Ast] = try pa_expression(p, 2)
        try pa_expect(p, c")")
        return if selected { a } else { b }
    }
    if pa_is(p, t, c"__builtin_va_arg") || pa_is(p, t, c"__builtin_bit_cast") ||
        pa_is(p, t, c"__builtin_convertvector") {
        type_first bool = pa_is(p, t, c"__builtin_bit_cast")
        try pa_expect(p, c"(")
        ty u32
        a handle[Ast]
        if type_first { ty = try pa_type_name(p) }
        else { a = try pa_expression(p, 2) }
        try pa_expect(p, c",")
        if type_first { a = try pa_expression(p, 2) }
        else { ty = try pa_type_name(p) }
        try pa_expect(p, c")")
        if pa_is(p, t, c"__builtin_va_arg") {
            try se_builtin_va_list(p, a)
            if !se_complete(ty) || ty_is_array(ty) { try pa_error(p, t.loc, c"va_arg requires a complete scalar or record type") }
        } else if pa_is(p, t, c"__builtin_convertvector") {
            if !ty_is_vector(a.ty) || !ty_is_vector(ty) {
                try pa_error(p, t.loc, c"convertvector requires two vector types")
            }
            x u32 = ty_node(ty_unqual(a.ty)).elem
            y u32 = ty_node(ty_unqual(ty)).elem
            if ty_size(a.ty) / ty_size(x) != ty_size(ty) / ty_size(y) {
                try pa_error(p, t.loc, c"convertvector cannot change lane count")
            }
        }
        n handle[Ast] = pa_node(ND_CALL, t.loc, ty)
        n.op = t.payload
        n.b = a
        return n
    }
    if pa_is(p, t, c"__builtin_constant_p") {
        try pa_expect(p, c"(")
        a handle[Ast] = try pa_expression(p, 2)
        try pa_expect(p, c")")
        folded bool = (a.flags & (NF_INT_VALUE | NF_FLOAT_CONST)) != 0 && (a.flags & NF_OVERFLOW) == 0
        return se_int(t.loc, TY_INT, if folded || a.kind == ND_STRING { 1 } else { 0 })
    }
    if pa_is(p, t, c"__builtin_classify_type") {
        try pa_expect(p, c"(")
        a handle[Ast] = try pa_expression(p, 2)
        try pa_expect(p, c")")
        return se_int(t.loc, TY_INT, se_builtin_type_class(se_decay(a.ty)))
    }
    n handle[Ast] = pa_node(ND_NAME, t.loc, TY_INVALID)
    n.op = t.payload
    return n
}

// GCC intrinsic headers use builtins directly in casts and return statements,
// so treating their results as int changes both vector and pointer types.
fn pa_x86_result(name Bytes) u32 {
    prefix Bytes = bytes_c(c"__builtin_ia32_")
    if !bytes_starts_with(name, prefix) { return TY_INVALID }
    suffix Bytes = {name.p + prefix.n, name.n - prefix.n}
    lo usize = 0
    hi usize = X86_RESULT_COUNT
    while lo < hi {
        i usize = lo + (hi - lo) / 2
        cmp i32 = bytes_cmp(suffix, bytes_c(X86_RESULT_NAMES[i]))
        if cmp < 0 { hi = i }
        else if cmp > 0 { lo = i + 1 }
        else {
            code u32 = X86_RESULT_TYPES[i]
            base u32 = code & 255
            if (code & 256) != 0 { return ty_ptr(base) }
            lanes u32 = code >> 9
            if lanes != 0 { return ty_vector(base, lanes * trunc[u32](ty_size(base))) }
            return base
        }
    }
    return TY_INVALID
}

fn pa_builtin_result(p handle[Parser], name Bytes, a handle[Ast], count u32) u32 {
    if se_builtin_overflow(name) || se_builtin_checked(name) { return TY_BOOL }
    target u32 = pa_x86_result(name)
    if target != TY_INVALID { return target }
    if a != null && ty_is_vector(a.ty) {
        // GCC takes a vector mask; Clang takes one index per result lane.
        if bytes_eq_c(name, c"__builtin_shuffle") && (count == 2 || count == 3) {
            mask handle[Ast] = a.next
            if count == 3 { mask = mask.next }
            if ty_is_vector(mask.ty) {
                elem u32 = ty_node(ty_unqual(a.ty)).elem
                m handle[TypeNode] = ty_node(ty_unqual(mask.ty))
                lanes u64 = ty_size(mask.ty) / ty_size(m.elem)
                return ty_vector(elem, trunc[u32](lanes * ty_size(elem)))
            }
        }
        if bytes_eq_c(name, c"__builtin_shufflevector") && count >= 3 {
            elem u32 = ty_node(ty_unqual(a.ty)).elem
            return ty_vector(elem, (count - 2) * trunc[u32](ty_size(elem)))
        }
    }
    if bytes_eq_c(name, c"__builtin_stpcpy") || bytes_eq_c(name, c"__builtin_stpncpy") { return ty_ptr(TY_CHAR) }
    if bytes_eq_c(name, c"__builtin_call_with_static_chain") && a != null { return a.ty }
    if bytes_eq_c(name, c"__builtin_extract_return_addr") || bytes_eq_c(name, c"__builtin_frob_return_addr") {
        return ty_ptr(TY_VOID)
    }
    if bytes_eq_c(name, c"__builtin_complex") && a != null && ty_is_real_float(a.ty) {
        return ty_complex(a.ty)
    }
    if bytes_eq_c(name, c"__builtin_printf") || bytes_eq_c(name, c"__builtin_sprintf") ||
        bytes_eq_c(name, c"__builtin_fprintf") { return TY_INT }
    if bytes_starts_with(name, bytes_c(c"__c11_atomic_")) {
        if bytes_eq_c(name, c"__c11_atomic_init") || bytes_eq_c(name, c"__c11_atomic_store") ||
            bytes_eq_c(name, c"__c11_atomic_thread_fence") || bytes_eq_c(name, c"__c11_atomic_signal_fence") { return TY_VOID }
        if bytes_eq_c(name, c"__c11_atomic_is_lock_free") ||
            bytes_starts_with(name, bytes_c(c"__c11_atomic_compare_exchange_")) { return TY_BOOL }
        if a != null {
            ptr u32 = se_decay(a.ty)
            if ty_is_ptr(ptr) { return ty_unqual(ty_node(ty_unqual(ptr)).elem) }
        }
    }
    if bytes_starts_with(name, bytes_c(c"__builtin_va_")) || bytes_starts_with(name, bytes_c(c"__builtin_ms_va_")) ||
        bytes_eq_c(name, c"__builtin_unreachable") || bytes_eq_c(name, c"__builtin_trap") ||
        bytes_eq_c(name, c"__builtin_prefetch") || bytes_eq_c(name, c"__builtin_free") { return TY_VOID }
    if bytes_eq_c(name, c"__builtin_expect") || bytes_eq_c(name, c"__builtin_expect_with_probability") { return TY_LONG }
    if bytes_eq_c(name, c"__builtin_strlen") || bytes_eq_c(name, c"__builtin_object_size") ||
        bytes_eq_c(name, c"__builtin_dynamic_object_size") || bytes_eq_c(name, c"__builtin_bswap64") { return TY_ULONG }
    if bytes_eq_c(name, c"__builtin_bswap32") { return TY_UINT }
    if bytes_eq_c(name, c"__builtin_bswap16") { return TY_USHORT }
    if bytes_eq_c(name, c"__builtin_memchr") || bytes_eq_c(name, c"__builtin_memcpy") ||
        bytes_eq_c(name, c"__builtin_memmove") || bytes_eq_c(name, c"__builtin_mempcpy") ||
        bytes_eq_c(name, c"__builtin_memset") || bytes_eq_c(name, c"__builtin_memrchr") ||
        bytes_eq_c(name, c"__builtin_malloc") || bytes_eq_c(name, c"__builtin_calloc") ||
        bytes_eq_c(name, c"__builtin_realloc") || bytes_eq_c(name, c"__builtin_aligned_alloc") ||
        bytes_eq_c(name, c"__builtin_alloca") ||
        bytes_eq_c(name, c"__builtin_alloca_with_align") || bytes_eq_c(name, c"__builtin_frame_address") ||
        bytes_eq_c(name, c"__builtin_return_address") || bytes_eq_c(name, c"__builtin_assume_aligned") {
        return ty_ptr(TY_VOID)
    }
    if bytes_eq_c(name, c"__builtin___memcpy_chk") || bytes_eq_c(name, c"__builtin___memmove_chk") ||
        bytes_eq_c(name, c"__builtin___mempcpy_chk") || bytes_eq_c(name, c"__builtin___memset_chk") {
        return ty_ptr(TY_VOID)
    }
    if bytes_eq_c(name, c"__builtin_strcpy") || bytes_eq_c(name, c"__builtin_strncpy") ||
        bytes_eq_c(name, c"__builtin_strcat") || bytes_eq_c(name, c"__builtin_strncat") ||
        bytes_eq_c(name, c"__builtin_strchr") || bytes_eq_c(name, c"__builtin_strrchr") ||
        bytes_eq_c(name, c"__builtin_strstr") || bytes_eq_c(name, c"__builtin_strpbrk") ||
        bytes_eq_c(name, c"__builtin_strdup") || bytes_eq_c(name, c"__builtin_strndup") ||
        bytes_eq_c(name, c"__builtin___strcpy_chk") || bytes_eq_c(name, c"__builtin___strncpy_chk") ||
        bytes_eq_c(name, c"__builtin___strcat_chk") || bytes_eq_c(name, c"__builtin___strncat_chk") ||
        bytes_eq_c(name, c"__builtin___stpcpy_chk") || bytes_eq_c(name, c"__builtin___stpncpy_chk") {
        return ty_ptr(TY_CHAR)
    }
    if bytes_eq_c(name, c"__builtin_strspn") || bytes_eq_c(name, c"__builtin_strcspn") { return TY_ULONG }
    if bytes_starts_with(name, bytes_c(c"__builtin_huge_val")) || bytes_starts_with(name, bytes_c(c"__builtin_inf")) || bytes_starts_with(name, bytes_c(c"__builtin_nan")) ||
        bytes_starts_with(name, bytes_c(c"__builtin_fabs")) || bytes_starts_with(name, bytes_c(c"__builtin_sqrt")) {
        ch u8 = name.p[u8, name.n - 1]
        if bytes_ends_with(name, bytes_c(c"f16")) { return TY_FLOAT16 }
        if ch == 102 && !bytes_eq_c(name, c"__builtin_inf") { return TY_FLOAT }
        if ch == 108 { return TY_LDOUBLE }
        return TY_DOUBLE
    }
    if bytes_eq_c(name, c"__atomic_compare_exchange") || bytes_eq_c(name, c"__atomic_compare_exchange_n") ||
        bytes_eq_c(name, c"__atomic_test_and_set") || bytes_eq_c(name, c"__sync_bool_compare_and_swap") {
        return TY_BOOL
    }
    if bytes_eq_c(name, c"__atomic_load") || bytes_eq_c(name, c"__atomic_store") || bytes_eq_c(name, c"__atomic_store_n") ||
        bytes_eq_c(name, c"__atomic_exchange") || bytes_eq_c(name, c"__atomic_clear") ||
        bytes_eq_c(name, c"__sync_lock_release") || bytes_eq_c(name, c"__sync_synchronize") {
        return TY_VOID
    }
    if a != null && (bytes_eq_c(name, c"__atomic_load_n") || bytes_eq_c(name, c"__atomic_exchange_n") ||
        se_builtin_atomic_fetch(name) || bytes_eq_c(name, c"__sync_lock_test_and_set") ||
        bytes_eq_c(name, c"__sync_val_compare_and_swap")) {
        return se_builtin_atomic_result(a.ty)
    }
    return TY_INT
}

fn pa_call(p handle[Parser], t Token, a handle[Ast]) handle[Ast] fails {
    xs AstList = {}
    count u32 = 0
    if !(try pa_at(p, c")")) {
        while true {
            pa_append(&xs, try pa_expression(p, 2))
            count += 1
            if !(try pa_accept(p, c",")) { break }
        }
    }
    try pa_expect(p, c")")
    fn_ty u32 = se_decay(a.ty)
    if ty_is_ptr(fn_ty) { fn_ty = ty_node(ty_unqual(fn_ty)).elem }
    ret u32
    if a.ty == TY_INVALID && a.kind == ND_NAME && a.decl == null {
        word Bytes = cc_name(p.names, a.op)
        try se_check_builtin_call(p, t, word, xs.first, count)
        ret = pa_builtin_result(p, word, xs.first, count)
        if bytes_eq_c(word, c"__builtin_strcmp") {
            if count != 2 { try pa_error(p, t.loc, c"wrong number of strcmp builtin arguments") }
            folded handle[Ast] = try se_builtin_strcmp(p, t.loc, xs.first, xs.first.next)
            if folded != null { return folded }
        }
        if bytes_eq_c(word, c"__builtin_ia32_paddq") || bytes_eq_c(word, c"__builtin_ia32_psubq") {
            // GCC's MMX arithmetic takes one-lane vectors. A scalar of the
            // same width can be explicitly cast, but cannot be passed as-is.
            if count != 2 { try pa_error(p, t.loc, c"wrong number of MMX builtin arguments") }
            arg handle[Ast] = xs.first
            while arg != null {
                try se_conversion(p, ret, arg)
                arg = arg.next
            }
        }
    } else {
        if !ty_is_func(fn_ty) { try pa_error(p, a.loc, c"called expression is not a function") }
        f handle[TypeNode] = ty_node(ty_unqual(fn_ty))
        fixed u32 = f.aux2
        start u32 = f.aux1
        ret = f.elem
        if count < fixed || (count > fixed && (f.flags & TYF_VARIADIC) == 0) { try pa_error(p, t.loc, c"wrong number of function arguments") }
        converted AstList = {}
        x handle[Ast] = xs.first
        for i u32 in 0..count {
            next handle[Ast] = x.next
            x.next = null
            if !se_complete(se_decay(x.ty)) { try pa_error(p, x.loc, c"function argument has incomplete or void type") }
            ty u32
            if i < fixed {
                ty = tc.fn_params.p[u32, zext[usize](start + i)]
                x = se_transparent_arg(ty, x)
                try se_conversion(p, ty, x)
            } else {
                ty = if se_decay(x.ty) == TY_FLOAT { TY_DOUBLE } else { se_promote_expr(x) }
            }
            pa_append(&converted, se_convert(ty, x))
            x = next
        }
        xs.first = converted.first
    }
    n handle[Ast] = pa_node(ND_CALL, t.loc, ret)
    n.a = a
    n.b = xs.first
    if a.ty == TY_INVALID {
        word Bytes = cc_name(p.names, a.op)
        if bytes_starts_with(word, bytes_c(c"__builtin_inf")) ||
            bytes_starts_with(word, bytes_c(c"__builtin_huge_val")) ||
            bytes_starts_with(word, bytes_c(c"__builtin_nan")) {
            fp u64 = if bytes_starts_with(word, bytes_c(c"__builtin_nan")) { 0x7ff8000000000000 } else { 0x7ff0000000000000 }
            se_set_fp(n, bitcast[f64](fp))
        }
        if bytes_eq_c(word, c"__builtin_complex") {
            real handle[Ast] = xs.first
            if count != 2 || !ty_is_complex(ret) {
                try pa_error(p, t.loc, c"__builtin_complex requires two real floating operands")
            }
            imag handle[Ast] = real.next
            if ty_unqual(real.ty) != ty_unqual(imag.ty) {
                try pa_error(p, t.loc, c"__builtin_complex requires matching operand types")
            }
            if (real.flags & imag.flags & NF_FLOAT_CONST) != 0 { se_set_complex(n, se_fp(real), se_fp(imag)) }
        }
    }
    return n
}

fn pa_primary(p handle[Parser], t Token) handle[Ast] fails {
    if t.kind == TK_NUM { return try pa_number(p, t) }
    if t.kind == TK_CHAR {
        s Bytes = cc_spelling(p.names, t)
        width u8 = pa_prefix_width(s)
        ty u32 = TY_INT
        if width == 1 { ty = TY_UCHAR }
        if width == 2 { ty = TY_USHORT }
        if width == 4 && s.p[u8] != 76 { ty = TY_UINT }
        v PpInt = try expr_char(p.names, t)
        return se_int(t.loc, ty, v.bits)
    }
    if pa_is(p, t, c"true") { return se_int(t.loc, TY_BOOL, 1) }
    if pa_is(p, t, c"false") { return se_int(t.loc, TY_BOOL, 0) }
    if pa_is(p, t, c"nullptr") { return se_int(t.loc, TY_NULLPTR, 0) }
    if pa_is(p, t, c"_Generic") { return try pa_generic(p, t) }
    if t.kind == TK_IDENT && !pa_keyword(p, t) {
        name u32 = cc_ident(p.names, t)
        s handle[Symbol] = pa_lookup(p, name)
        if s == null {
            word Bytes = cc_spelling(p.names, t)
            if (p.function != null || pa_is_gnu(p)) && (bytes_eq_c(word, c"__func__") || bytes_eq_c(word, c"__FUNCTION__") ||
                bytes_eq_c(word, c"__PRETTY_FUNCTION__")) {
                fn_sym handle[Symbol] = p.function
                fn_name Bytes
                if fn_sym == null {
                    cc_diag(p.names, t.loc, c"warning: ", bytes_c(c"predefined identifier is only valid inside a function"))
                    fn_name = if bytes_eq_c(word, c"__PRETTY_FUNCTION__") { bytes_c(c"top level") } else { bytes_empty() }
                } else { fn_name = cc_name(p.names, fn_sym.name) }
                n handle[Ast] = pa_node(ND_STRING, t.loc, ty_array(ty_qual(TY_CHAR, Q_CONST), fn_name.n + 1))
                n.op = cc_intern(p.names, fn_name)
                n.value = fn_name.n + 1
                n.flags = NF_LVALUE | NF_STATIC | NF_ADDR
                return n
            }
            if bytes_starts_with(word, bytes_c(c"__builtin_")) || bytes_starts_with(word, bytes_c(c"__atomic_")) ||
                bytes_starts_with(word, bytes_c(c"__sync_")) || bytes_starts_with(word, bytes_c(c"__c11_atomic_")) {
                if try pa_at(p, c"(") { return try pa_builtin_call(p, t) }
            }
            b Buf = {}
            buf_str(&b, c"use of undeclared identifier '")
            buf_append(&b, word)
            buf_u8(&b, 39)
            try pa_error(p, t.loc, buf_cstr(&b))
        }
        if s.storage == SC_TYPEDEF { try pa_error(p, t.loc, c"typedef name used as an expression") }
        if pa_has_attr(p, s.attrs, c"deprecated") {
            cc_diag(p.names, t.loc, c"warning: ", bytes_c(c"use of a deprecated declaration"))
        }
        n handle[Ast] = pa_node(ND_NAME, t.loc, s.ty)
        n.op = name
        n.decl = s
        val handle[Ast] = handle_from_addr(s.value)
        if s.storage == SC_ENUMERATOR {
            n.value = val.value
            n.wide = val.wide
            n.flags = NF_ICE | NF_STATIC
        } else {
            if !ty_is_func(s.ty) { n.flags = NF_LVALUE }
            if s.storage == SC_CONSTEXPR && s.value != null {
                n.flags |= val.flags & (NF_STATIC | NF_ICE | NF_FLOAT_CONST)
                n.imag = val.imag
                if ty_is_integer(s.ty) && ty_int_bits(s.ty) > 64 && (n.flags & NF_ICE) != 0 {
                    wi_store(n, wi_from_ast(val, ty_int_bits(s.ty)))
                } else {
                    n.value = se_value(s.ty, val.value)
                }
            } else if s.linkage != 0 || s.storage == SC_STATIC {
                if !s.thread_local { n.flags |= NF_ADDR }
                if ty_is_func(s.ty) || ty_is_array(s.ty) { n.flags |= NF_STATIC }
            }
            if s.storage != SC_CONSTEXPR { se_const_load(p, n) }
        }
        return n
    }
    try pa_error(p, t.loc, c"expected an expression")
    return null
}

// A parenthesized type can introduce a cast, a type operand or a compound
// literal. Only the last form can carry a C23 storage class.
fn pa_paren_type(p handle[Parser], spec handle[DeclSpec]) u32 fails {
    try pa_specs(p, spec)
    d Declarator = {}
    try pa_declarator(p, &d, true)
    if d.name != 0 || spec.inferred || spec.auto_seen || spec.alignment != 0 ||
        spec.is_inline || spec.is_noreturn ||
        (spec.storage != SC_NONE && spec.storage != SC_STATIC &&
         spec.storage != SC_REGISTER && spec.storage != SC_CONSTEXPR) {
        try pa_error(p, spec.loc, c"invalid parenthesized type name")
    }
    try pa_expect(p, c")")
    if (spec.storage != SC_NONE || spec.thread_local) && !(try pa_at(p, c"{")) {
        try pa_error(p, spec.loc, c"storage class requires a compound literal")
    }
    return try pa_apply_attrs(p, d.first, spec.ty, pa_join_attrs(d.attrs, pa_copy_attrs(spec.attrs)), 0)
}

fn pa_size_expr(p handle[Parser], t Token) handle[Ast] fails {
    align bool = !pa_is(p, t, c"sizeof")
    ty u32
    a handle[Ast] = null
    if (try pa_at(p, c"(")) && pa_decl_start(p, try pa_peek_at(p, 1)) {
        try pa_take(p)
        spec DeclSpec = {}
        ty = try pa_paren_type(p, &spec)
        if try pa_at(p, c"{") {
            a = try pa_compound(p, t, ty, &spec)
            a = try pa_postfix(p, a)
            ty = a.ty
        }
    } else {
        if align && !pa_is_gnu(p) { try pa_error(p, t.loc, c"alignof requires a type name") }
        a = try pa_unary(p)
        ty = a.ty
    }
    if a != null && (a.flags & NF_BITFIELD) != 0 { try pa_error(p, t.loc, c"size or alignment of a bit-field is invalid") }
    gnu_size bool = pa_is_gnu(p) && (ty_is_void(ty) || ty_is_func(ty))
    if !se_complete(ty) && !gnu_size { try pa_error(p, t.loc, c"size or alignment requires a complete object type") }
    n handle[Ast] = pa_node(ND_SIZE, t.loc, TY_ULONG)
    n.op = ty
    n.a = a
    if align || !se_vla(ty) {
        n.flags = NF_ICE | NF_STATIC
        n.value = if align { ty_align(ty) } else { ty_size(ty) }
        if gnu_size && n.value == 0 { n.value = 1 }
    }
    return n
}

fn pa_compound(p handle[Parser], t Token, ty u32, spec handle[DeclSpec]) handle[Ast] fails {
    file_scope bool = p.scope == p.file_scope
    if !ty_is_array(ty) && !se_complete(ty) { try pa_error(p, t.loc, c"compound literal requires a complete object type") }
    if se_vla(ty) || (file_scope && (spec.storage == SC_REGISTER || spec.thread_local)) ||
        (spec.thread_local && spec.storage != SC_STATIC) {
        try pa_error(p, t.loc, c"invalid compound literal storage class or type")
    }
    static_duration bool = file_scope || spec.storage == SC_STATIC
    result InitResult = {}
    try pa_initializer(p, ty, static_duration || spec.storage == SC_CONSTEXPR, &result)
    n handle[Ast] = pa_node(ND_COMPOUND, t.loc, result.ty)
    n.a = result.tree
    n.flags = NF_LVALUE
    n.op = zext[u32](spec.storage)
    if spec.thread_local { n.op |= 256 }
    if static_duration && !spec.thread_local { n.flags |= NF_ADDR }
    if spec.storage == SC_CONSTEXPR {
        try se_constexpr_type(p, result.ty, t.loc)
        try se_check_constexpr(p, result.tree)
        if ty_is_scalar(result.ty) { se_cast_constant(n, result.tree) }
    }
    init handle[Ast] = result.tree
    if pa_is_gnu(p) && (init.flags & NF_STATIC) != 0 {
        if ty_is_scalar(result.ty) {
            se_cast_constant(n, init)
            if spec.storage != SC_CONSTEXPR && (n.flags & NF_ICE) != 0 {
                n.flags = (n.flags & ~NF_ICE) | NF_FOLD
            }
        } else if !ty_is_array(result.ty) { n.flags |= NF_STATIC }
    }
    if (n.flags & NF_ADDR) != 0 && ty_is_array(result.ty) { n.flags |= NF_STATIC }
    return n
}

fn pa_unary(p handle[Parser]) handle[Ast] fails {
    t Token = try pa_peek(p)
    if t.kind == TK_STR { return try pa_postfix(p, try pa_strings(p)) }
    try pa_take(p)
    if pa_is(p, t, c"__extension__") { return try pa_unary(p) }
    if pa_is(p, t, c"sizeof") || pa_is(p, t, c"alignof") || pa_is(p, t, c"_Alignof") ||
        pa_is(p, t, c"__alignof") || pa_is(p, t, c"__alignof__") {
        return try pa_size_expr(p, t)
    }
    if pa_is(p, t, c"&&") {
        try pa_gnu(p, t)
        label Token = try pa_take(p)
        l handle[Label] = try pa_get_label(p, label)
        l.used = true
        n handle[Ast] = pa_node(ND_UNARY, t.loc, ty_ptr(TY_VOID))
        n.op = t.payload
        n.value = zext[u64](l.name)
        n.extra = handle_addr(l)
        n.flags = NF_STATIC
        return n
    }
    if pa_is(p, t, c"++") || pa_is(p, t, c"--") || pa_is(p, t, c"&") || pa_is(p, t, c"*") ||
        pa_is(p, t, c"+") || pa_is(p, t, c"-") || pa_is(p, t, c"!") || pa_is(p, t, c"~") {
        return try se_unary(p, t, try pa_unary(p), false)
    }
    if pa_is(p, t, c"__real__") || pa_is(p, t, c"__imag__") || pa_is(p, t, c"__real") || pa_is(p, t, c"__imag") {
        a handle[Ast] = try pa_unary(p)
        n handle[Ast] = pa_node(ND_UNARY, t.loc, ty_real_part(a.ty))
        n.op = t.payload
        n.a = a
        n.flags = a.flags & NF_LVALUE
        if (a.flags & NF_FLOAT_CONST) != 0 {
            im bool = pa_is(p, t, c"__imag__") || pa_is(p, t, c"__imag")
            se_set_fp(n, if im { se_im(a) } else { se_fp(a) })
        } else if (a.flags & NF_ICE) != 0 {
            n.flags |= NF_STATIC | NF_ICE
            if pa_is(p, t, c"__real__") || pa_is(p, t, c"__real") { n.value = a.value; n.wide = a.wide }
        }
        return n
    }
    if pa_is(p, t, c"(") {
        if try pa_at(p, c"{") {
            try pa_gnu(p, t)
            if p.function == null { try pa_error(p, t.loc, c"statement expression outside a function") }
            block handle[Ast] = try pa_block(p, true)
            try pa_expect(p, c")")
            return try pa_postfix(p, block)
        }
        if pa_decl_start(p, try pa_peek(p)) {
            spec DeclSpec = {}
            ty u32 = try pa_paren_type(p, &spec)
            if try pa_at(p, c"{") { return try pa_postfix(p, try pa_compound(p, t, ty, &spec)) }
            return try se_cast(p, t, ty, try pa_unary(p))
        }
        a handle[Ast] = try pa_expression(p, 1)
        try pa_expect(p, c")")
        return try pa_postfix(p, a)
    }
    return try pa_postfix(p, try pa_primary(p, t))
}

fn pa_postfix(p handle[Parser], a handle[Ast]) handle[Ast] fails {
    while true {
        t Token = try pa_peek(p)
        if try pa_accept(p, c"(") { a = try pa_call(p, t, a) }
        else if try pa_accept(p, c"[") {
            b handle[Ast] = try pa_expression(p, 1)
            try pa_expect(p, c"]")
            x u32 = se_decay(a.ty)
            y u32 = se_decay(b.ty)
            elem u32
            if ty_is_vector(a.ty) && ty_is_integer(y) { elem = ty_node(ty_unqual(a.ty)).elem }
            else if ty_is_ptr(x) && ty_is_integer(y) { elem = ty_node(ty_unqual(x)).elem }
            else if ty_is_ptr(y) && ty_is_integer(x) { elem = ty_node(ty_unqual(y)).elem }
            else { try pa_error(p, t.loc, c"invalid array subscript"); elem = TY_INVALID }
            n handle[Ast] = pa_node(ND_SUBSCRIPT, t.loc, elem)
            n.flags = NF_LVALUE
            if (a.flags & NF_STATIC) != 0 && (b.flags & NF_STATIC) != 0 {
                n.flags |= NF_ADDR
                if ty_is_array(elem) { n.flags |= NF_STATIC }
            }
            n.a = a
            n.b = b
            if ty_is_array(a.ty) && (b.flags & NF_ICE) != 0 && b.wide == null {
                se_const_load(p, n)
            }
            a = n
        } else if (try pa_accept(p, c".")) || (try pa_accept(p, c"->")) {
            ty u32 = a.ty
            arrow bool = pa_is(p, t, c"->")
            if arrow {
                ty = se_decay(ty)
                if !ty_is_ptr(ty) { try pa_error(p, t.loc, c"'->' requires a pointer to a record") }
                ty = ty_node(ty_unqual(ty)).elem
            }
            m Token = try pa_take(p)
            name u32 = try pa_ident(p, m)
            field FieldLookup = {}
            if !ty_is_record(ty) || !se_complete(ty) || !ty_offsetof(ty, name, &field) { try pa_error(p, m.loc, c"no such member in record") }
            n handle[Ast] = pa_node(ND_MEMBER, t.loc, ty_qual(field.ty, ty_quals(ty) & (Q_CONST | Q_VOLATILE | Q_ATOMIC)))
            n.op = field.field_idx
            n.a = a
            if arrow || (a.flags & NF_LVALUE) != 0 { n.flags |= NF_LVALUE }
            n.field_offset = field.bit_off
            if field.is_bitfield { n.flags |= NF_BITFIELD; n.field_width = field.bit_width }
            if (arrow && (a.flags & NF_STATIC) != 0) || (!arrow && (a.flags & NF_ADDR) != 0) {
                n.flags |= NF_ADDR
                if ty_is_array(n.ty) { n.flags |= NF_STATIC }
            }
            if !arrow { se_const_load(p, n) }
            a = n
        } else if (try pa_accept(p, c"++")) || (try pa_accept(p, c"--")) { a = try se_unary(p, t, a, true) }
        else { return a }
    }
}

fn pa_expression(p handle[Parser], min u8) handle[Ast] fails {
    a handle[Ast] = try pa_unary(p)
    while true {
        t Token = try pa_peek(p)
        k u8 = se_prec(p, t)
        if k < min { return a }
        try pa_take(p)
        if k == 3 {
            b handle[Ast] = a
            if try pa_at(p, c":") { try pa_gnu(p, t) }
            else { b = try pa_expression(p, 1) }
            try pa_expect(p, c":")
            c handle[Ast] = try pa_expression(p, 3)
            a = try se_conditional(p, t, a, b, c)
        } else {
            right_min u8 = if k == 2 { k } else { k + 1 }
            b handle[Ast] = try pa_expression(p, right_min)
            a = try se_binary(p, t, a, b)
        }
    }
}
