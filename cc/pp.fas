// cc2/pp.fas: Translation-unit preprocessor state, file cache, include guards,
// and token pull stream.

struct Frame {
    lexer Lexer
    file handle[SourceFile]
    physical u32       // physical path SymId
    logical_path u32   // current logical filename SymId (#line can change this)
    directory i32
    system bool
    base usize         // p.conditions.n when this frame was pushed
    guard u32
    guard_stage u8     // 0=init, 1=seen #ifndef G, 2=seen #define G, 3=seen #endif, 4=invalid
}

value struct Cond { loc u32, parent bool, active bool, taken bool, otherwise bool }
value struct SearchDir { path u32, rank u8 }
value struct Dependency { path u32, system bool }

struct PendingTokens { tokens Vec[Token], at usize }

struct PpRoot {
    file handle[SourceFile]
    path u32
    directory i16
    system bool
}

value struct SavedMacro { macro addr, id u32, flags u8 }
value struct DevIno { dev u64, ino u64 }
fn devino_hash(k DevIno) u64 { return hash_mix(k.dev ^ (k.ino * 0x9e3779b185ebca87)) }
fn devino_eq(a DevIno, b DevIno) bool { return a.dev == b.dev && a.ino == b.ino }

struct DirEntries {
    missing bool
    hashes Map[u64, u8, u64_hash, u64_eq]
}

const SYS_GETDENTS64 u64 = 217

struct Pp {
    ctx CcCtx
    standard u8
    ilp32 bool
    unsigned_char bool
    short_enums bool
    no_library_builtins bool
    disabled_builtins handle[Vec[Bytes]]
    prefix_maps handle[Vec[Bytes]]
    wrapv bool
    x86_features u64
    frames Vec[Frame]
    roots Vec[PpRoot]
    root_at usize
    conditions Vec[Cond]
    dirs Vec[SearchDir]
    inputs Map[DevIno, addr, devino_hash, devino_eq]
    aliases Map[Bytes, addr, bytes_hash, bytes_eq]
    dir_cache Map[u32, addr, u32_hash, u32_eq]
    visited Map[u32, usize, u32_hash, u32_eq]
    dependencies Vec[Dependency]
    hides Vec[Hide]
    recent_hides arr[2048, u32]
    pastes Map[u64, PastedToken, u64_hash, u64_eq]
    stream Expand
    pending PendingTokens
    embedded EmbedOutput
    byte_spellings arr[256, u32]
    macro_stack Vec[SavedMacro]
    warning_modes WarningModes
    warning_stack Vec[WarningModes]
    base_file u32
    base_logical u32
    counter u64
    timestamp u64
    timestamp_explicit bool
    line_markers bool
    gcc_inc_probed bool
    no_stdinc bool
    // Reusable scratch buffers (watermark save/restore => zero heap_alloc/os_lock!)
    dir_args Vec[Token]
    arg_data Vec[Token]
    arg_spans Vec[Arg]
    subst_out Vec[Token]
    gap_buf Vec[Token]
    cache_toks Vec[Token]
    // Lock-free bump arena for transient macro expansion buffers; reset at depth 0
    macro_arena Arena
}

fn pp_macro_arena_reset(p handle[Pp]) void {
    a handle[Arena] = &p.macro_arena
    if a.chunk == null { return }
    // Free any extra overflow chunks, keep the first hot chunk!
    c addr = a.chunk
    while c[addr, 0] != null {
        prev addr = c[addr, 0]
        os_munmap(c, c[u64, 1])
        c = prev
    }
    a.chunk = c
    a.used = 16
    a.cap = c[u64, 1]
    a.total = 0
}

error MissingInput

fn pp_dir_might_have(p handle[Pp], dir_sym u32, file Bytes) bool {
    if file.n == 0 || file.p[u8, 0] == 46 { return true }
    // Extract top-level component before first '/'
    comp_len usize = 0
    while comp_len < file.n && file.p[u8, comp_len] != 47 { comp_len += 1 }
    if comp_len == 0 { return true }
    comp Bytes = bytes(file.p, comp_len)

    de_addr addr = map_get(&p.dir_cache, dir_sym) catch {
        dir_b Bytes = sym_name(&p.ctx.syms, dir_sym)
        de handle[DirEntries] = handle_from_addr(heap_alloc_zeroed(sizeof[DirEntries]))
        stack_p arr[512, u8]
        cstr addr
        dyn_p Buf = {}
        defer { buf_free(&dyn_p) }
        if dir_b.n < 512 {
            mem_copy(&stack_p[0], dir_b.p, dir_b.n)
            stack_p[dir_b.n] = 0
            cstr = &stack_p[0]
        } else {
            buf_append(&dyn_p, dir_b)
            cstr = buf_cstr(&dyn_p)
        }
        fd i32 = os_open(cstr, O_RDONLY | O_DIRECTORY, 0) catch {
            de.missing = true
            map_put(&p.dir_cache, dir_sym, handle_addr(de))
            return false
        }
        defer { os_close(fd) }
        dbuf arr[8192, u8]
        while true {
            nr i64 = syscall(SYS_GETDENTS64, fd, &dbuf[0], 8192)
            if nr <= 0 { break }
            off usize = 0
            limit usize = bitcast[usize](nr)
            while off < limit {
                reclen usize = zext[usize]((&dbuf[0] + off + 16)[u16])
                if reclen == 0 { break }
                name_p addr = &dbuf[0] + off + 19
                nlen usize = 0
                while name_p[u8, nlen] != 0 { nlen += 1 }
                if nlen != 0 {
                    map_put(&de.hashes, bytes_hash(bytes(name_p, nlen)), 1)
                }
                off += reclen
            }
        }
        map_put(&p.dir_cache, dir_sym, handle_addr(de))
        _ u8 = map_get(&de.hashes, bytes_hash(comp)) catch { return false }
        return true
    }
    de handle[DirEntries] = handle_from_addr(de_addr)
    if de.missing { return false }
    _ u8 = map_get(&de.hashes, bytes_hash(comp)) catch { return false }
    return true
}

fn pp_read(p handle[Pp], path Bytes) handle[SourceFile] fails {
    cache handle[Map[Bytes, addr, bytes_hash, bytes_eq]] = &p.aliases
    cached addr = map_get(cache, path) catch {
        stack_p arr[512, u8]
        cstr addr
        dyn_p Buf = {}
        defer { buf_free(&dyn_p) }
        if path.n < 512 {
            mem_copy(&stack_p[0], path.p, path.n)
            stack_p[path.n] = 0
            cstr = &stack_p[0]
        } else {
            buf_append(&dyn_p, path)
            cstr = buf_cstr(&dyn_p)
        }
        fd i32 = os_open(cstr, O_RDONLY | O_NONBLOCK, 0) catch {
            map_put(cache, bytes_dup(&p.ctx.syms.arena, path), null)
            fail MissingInput
        }
        defer { os_close(fd) }
        st Stat = {}
        os_fstat(fd, &st) catch {
            map_put(cache, bytes_dup(&p.ctx.syms.arena, path), null)
            fail MissingInput
        }
        if (st.mode & S_IFMT) != S_IFREG {
            map_put(cache, bytes_dup(&p.ctx.syms.arena, path), null)
            fail MissingInput
        }
        key DevIno = {st.dev, st.ino}
        files handle[Map[DevIno, addr, devino_hash, devino_eq]] = &p.inputs
        v addr = map_get(files, key) catch {
            size usize = bitcast[usize](st.size)
            if size > 1073741824 {
                map_put(cache, bytes_dup(&p.ctx.syms.arena, path), null)
                fail MissingInput
            }
            raw addr = heap_alloc(size + 64)
            got usize = os_read_full(fd, raw, size) catch {
                map_put(cache, bytes_dup(&p.ctx.syms.arena, path), null)
                fail MissingInput
            }
            if got != size {
                map_put(cache, bytes_dup(&p.ctx.syms.arena, path), null)
                fail MissingInput
            }
            mem_set(raw + size, 0, 64)
            fresh addr = heap_alloc_zeroed(sizeof[SourceFile])
            sf handle[SourceFile] = handle_from_addr(fresh)
            sf.raw_data = raw
            sf.raw_len = size
            map_put(files, key, fresh)
            map_put(cache, bytes_dup(&p.ctx.syms.arena, path), fresh)
            return sf
        }
        map_put(cache, bytes_dup(&p.ctx.syms.arena, path), v)
        return handle_from_addr(v)
    }
    if cached == null { fail MissingInput }
    return handle_from_addr(cached)
}

fn pp_depend(p handle[Pp], path u32, system bool) void {
    visited handle[Map[u32, usize, u32_hash, u32_eq]] = &p.visited
    i usize = map_get(visited, path) catch {
        map_put(visited, path, p.dependencies.n)
        vec_push[Dependency](&p.dependencies, {path, system})
        return
    }
    if !system {
        item handle[Dependency] = vec_at[Dependency](&p.dependencies, i)
        item.system = false
    }
}

fn pp_push_file(p handle[Pp], sf handle[SourceFile], path u32, dir i32, system bool, loc u32) void fails {
    pp_depend(p, path, system)
    if sf.once && sf.read { return }
    if sf.guard != 0 && sym_is_defined(&p.ctx.syms, sf.guard) { return }
    if p.frames.n == 200 { try cc_error(&p.ctx, loc, c"include nesting too deep") }
    if !sf.read {
        sf_prepare(sf, p.ctx.gnu)
    }
    level u32 = trunc[u32](p.frames.n)
    inst_idx u32 = sm_alloc_inst(&p.ctx.sm, sf, path, level)
    inst handle[SourceInst] = vec_at[SourceInst](&p.ctx.sm.insts, zext[usize](inst_idx))

    frame handle[Frame] = vec_add[Frame](&p.frames)
    l handle[Lexer] = &frame.lexer
    frame.file = sf
    frame.physical = path
    frame.logical_path = path
    frame.directory = dir
    frame.system = system
    frame.base = p.conditions.n
    frame.guard = 0
    frame.guard_stage = 0
    l.p = sf.data
    l.n = zext[usize](sf.len)
    l.at = 0
    l.base = inst.base
    l.inst_idx = inst_idx
    l.line = 1
    l.splice_idx = 0
    l.flags = F_BOL
    l.in_comment = false
    l.header = false
    l.pragma_line = false
    l.skipping = false
    vec_push[Token](&p.pending.tokens, tok_make(TK_ENTER, if system { F_SYSTEM } else { 0 }, 0, inst.base, 0))
}

value struct Found { file addr, path u32, dir i16, system bool }

fn pp_lookup(p handle[Pp], path Bytes, dir i16, system bool) Found {
    f handle[SourceFile] = pp_read(p, path) catch { return {null, 0, 0, false} }
    return {handle_addr(f), sym_intern_b(&p.ctx.syms, path), dir, system}
}

fn pp_find(p handle[Pp], file Bytes, quote bool, next bool) Found {
    if !path_is_relative(file) { return pp_lookup(p, file, -1, false) }
    path Buf = {}
    defer { buf_free(&path) }
    start usize = 0
    if p.frames.n != 0 {
        frame handle[Frame] = vec_at[Frame](&p.frames, p.frames.n - 1)
        if next {
            if frame.directory >= 0 { start = zext[usize](bitcast[u32](frame.directory)) + 1 }
        } else if quote {
            dir_b Bytes = path_dirname(sym_name(&p.ctx.syms, frame.physical))
            dir_sym u32 = sym_intern_b(&p.ctx.syms, dir_b)
            if pp_dir_might_have(p, dir_sym, file) {
                path_concat(&path, dir_b, file)
                f Found = pp_lookup(p, buf_bytes(&path), -1, frame.system)
                if f.file != null { return f }
            }
        }
    }
    for i usize in start..p.dirs.n {
        d SearchDir = vec_get[SearchDir](&p.dirs, i)
        if !quote && d.rank == 0 { continue }
        if !pp_dir_might_have(p, d.path, file) { continue }
        buf_clear(&path)
        path_concat(&path, sym_name(&p.ctx.syms, d.path), file)
        f Found = pp_lookup(p, buf_bytes(&path), bitcast[i16](trunc[u16](i)), d.rank >= 2)
        if f.file != null { return f }
    }
    // Lazy GCC include discovery: only probe /usr/lib/gcc on an actual miss!
    if !p.gcc_inc_probed && !p.no_stdinc {
        p.gcc_inc_probed = true
        gcc addr = gcc_include()
        if gcc != null && gcc[u8] != 0 {
            dir_idx usize = p.dirs.n
            vec_push[SearchDir](&p.dirs, {sym_intern_c(&p.ctx.syms, gcc), 2})
            buf_clear(&path)
            path_concat(&path, bytes_c(gcc), file)
            f Found = pp_lookup(p, buf_bytes(&path), bitcast[i16](trunc[u16](dir_idx)), true)
            if f.file != null { return f }
        }
    }
    return {null, 0, 0, false}
}

fn pp_active(p handle[Pp]) bool {
    return p.conditions.n == 0 || vec_last[Cond](&p.conditions).active
}

// Fast AVX2 skipper for inactive #if 0 lines (when not at BOL and not in comment).
// Skips to the end of the current line, respecting /* */ and // comments and
// string/char literals so `/*` inside a string doesn't falsely open a comment.
fn pp_skip_inactive_rest_of_line(l handle[Lexer]) void {
    p addr = l.p
    n usize = l.n
    at usize = l.at
    v_nl vec[32, u8] = splat(10)
    v_sl vec[32, u8] = splat(47)
    v_dq vec[32, u8] = splat(34)
    v_sq vec[32, u8] = splat(39)
    v_zero vec[32, u8] = splat(0)
    while true {
        v vec[32, u8] = (p + at)[vec[32, u8]]
        m u32 = bitcast[u32]((v == v_nl) | (v == v_sl) | (v == v_dq) | (v == v_sq) | (v == v_zero))
        if m == 0 {
            at += 32
            continue
        }
        at += zext[usize](ctz(m))
        ch u8 = p[u8, at]
        if ch == 10 {
            l.at = at + 1
            l.line += 1
            l.flags = F_BOL
            return
        }
        if ch == 0 {
            if at >= n {
                l.at = n
                return
            }
            at += 1
            continue
        }
        if ch == 47 {
            nxt u8 = p[u8, at + 1]
            if nxt == 47 {
                at = lex_skip_line_comment(p, at + 2)
                continue
            }
            if nxt == 42 {
                l.comment_loc = l.base + trunc[u32](at)
                l.in_comment = true
                l.at = at + 2
                if !lex_skip_block_comment(l) { return }
                at = l.at
                continue
            }
            at += 1
            continue
        }
        // '"' or '\''
        w usize = lex_scan_string(p + at, 1, ch)
        if p[u8, at + w] == ch {
            at += w + 1
        } else {
            // Unterminated literal in skipped region: just step past the quote
            at += 1
        }
    }
}

fn pp_asm_comment(ctx handle[CcCtx], l handle[Lexer], hash Token, start usize) Token {
    while l.at < l.n && l.p[u8, l.at] != 10 { l.at += 1 }
    id u32 = sm_add_synth(&ctx.sm, bytes(l.p + start, l.at - start))
    return tok_make(TK_OTHER, hash.flags | F_SYNTH, 0xFFFF, hash.loc, id)
}

fn pp_raw(p handle[Pp]) Token fails {
    while true {
        if p.pending.at < p.pending.tokens.n {
            t Token = p.pending.tokens.p[Token, p.pending.at]
            p.pending.at += 1
            return t
        }
        if p.pending.tokens.n != 0 {
            vec_clear[Token](&p.pending.tokens)
            p.pending.at = 0
        }
        if p.embedded.active {
            item Token = embed_next(p)
            if item.kind != TK_EOF { return item }
        }
        if p.frames.n == 0 {
            if p.root_at == p.roots.n { return tok_make(TK_EOF, 0, 0, 0, 0) }
            root handle[PpRoot] = vec_at[PpRoot](&p.roots, p.root_at)
            p.root_at += 1
            try pp_push_file(p, root.file, root.path, sext[i32](root.directory), root.system, 0)
            continue
        }
        frame handle[Frame] = vec_at[Frame](&p.frames, p.frames.n - 1)
        l handle[Lexer] = &frame.lexer
        active bool = pp_active(p)
        l.skipping = !active
        // Fast AVX2 block skip inside inactive #if 0 / #ifdef UNDEF regions!
        if !active && !l.in_comment && l.at < l.n {
            if (l.flags & F_BOL) == 0 {
                pp_skip_inactive_rest_of_line(l)
            }
            // Skip entire inactive lines until a '#' (or '%:' digraph) at BOL or EOF
            while !l.in_comment && l.at < l.n {
                src addr = l.p
                at usize = l.at
                while src[u8, at] == 32 || src[u8, at] == 9 || src[u8, at] == 11 || src[u8, at] == 12 {
                    at += 1
                }
                c u8 = src[u8, at]
                if c == 10 {
                    l.at = at + 1
                    l.line += 1
                    l.flags = F_BOL
                    continue
                }
                if c == 35 || (c == 37 && src[u8, at + 1] == 58) || c == 0 {
                    l.at = at
                    l.flags = F_BOL
                    break
                }
                l.at = at
                pp_skip_inactive_rest_of_line(l)
            }
            if l.in_comment { continue }
        }
        t Token = try lex_next(&p.ctx, l, false)
        if t.kind == TK_EOF {
            if p.conditions.n != frame.base {
                stop Cond = vec_last[Cond](&p.conditions)
                try cc_error(&p.ctx, stop.loc, c"unterminated conditional directive")
            }
            if frame.guard_stage == 3 {
                sf handle[SourceFile] = frame.file
                sf.guard = frame.guard
            }
            vec_truncate[Frame](&p.frames, p.frames.n - 1)
            if p.frames.n != 0 {
                prev handle[Frame] = vec_at[Frame](&p.frames, p.frames.n - 1)
                parent handle[Lexer] = &prev.lexer
                return tok_make(TK_LEAVE, if prev.system { F_SYSTEM } else { 0 }, 0, parent.base + trunc[u32](parent.at), 0)
            }
            continue
        }
        if (t.flags & F_BOL) != 0 && tok_is_hash(t.kind) {
            try pp_directive(p, frame, t)
            continue
        }
        if p.ctx.assembler && t.kind == TK_HASH {
            t = pp_asm_comment(&p.ctx, l, t, l.at - 1)
        }
        if t.kind != TK_NL && frame.guard_stage != 2 { frame.guard_stage = 4 }
        if active {
            if frame.system { t.flags |= F_SYSTEM }
            return t
        }
    }
    return tok_make(TK_EOF, 0, 0, 0, 0)
}

fn pp_next_text(p handle[Pp]) Token fails {
    return try expand_next(p, &p.stream)
}

fn pp_next(p handle[Pp]) Token fails {
    while true {
        t Token = try pp_next_text(p)
        if t.kind != TK_NL && t.kind != TK_ENTER && t.kind != TK_LEAVE && t.kind != TK_MARK { return t }
    }
    return tok_make(TK_EOF, 0, 0, 0, 0)
}
