// Correctly rounded fused multiply-add for the native backend.
//
// Baseline x86-64 (SSE2) has no FMA instruction and a freestanding program
// has no libm, so the native backend compiles `fma` to calls to these
// functions. They are compiled once to Fir (native_runtime.ml embeds the text)
// and added to a module only when it uses `fma`. They round in the current
// rounding mode and raise the IEEE flags as one operation would
// (FENV_ACCESS): every rounding is done by the hardware.
//
// fma64 follows musl's fma.c: unpack both operands to integers, form the exact
// 106-bit product, align and add the third operand with a sticky bit, keep the
// top 63 bits (bit 0 sticky) and let one signed int->double conversion do the
// only rounding (with the result's sign, so directed modes round the right
// way), then scale by multiplications (exact, or the one overflow). Results
// below the normal range keep only the bits the subnormal can hold, so the
// final scaling rounds once instead.

// Significand of a finite nonzero x scaled to [2^53, 2^54).
fn unpack_m(x f64) u64 {
  ix u64 = bitcast[u64](x)
  if (ix >> 52) & 0x7ff == 0 {
    ix = bitcast[u64](x * 9223372036854775808.0)   // * 2^63 normalizes
  }
  return ((ix & 0xfffffffffffff) | 0x10000000000000) << 1
}

// Exponent with x == unpack_m(x) * 2^unpack_e(x); 0x800 - 1076 for zero and
// 0x7ff - 1076 for infinities and NaN, so both are >= ZEROINFNAN.
fn unpack_e(x f64) i32 {
  ix u64 = bitcast[u64](x)
  e i32 = bitcast[i32](trunc[u32]((ix >> 52) & 0x7ff))
  if e == 0 {
    if ix & 0x7fffffffffffffff == 0 {
      e = 0x800
    } else {
      ix = bitcast[u64](x * 9223372036854775808.0)
      e = bitcast[i32](trunc[u32]((ix >> 52) & 0x7ff)) - 63
    }
  }
  return e - 1076
}

const ZEROINFNAN i32 = 0x7ff - 1076

const P2M189 u64 = 0x3420000000000000         // 2^-189
const JUST_BELOW_1 u64 = 0x3feffffff0000000   // 1 - 2^-25

// 2^k for -1022 <= k <= 1023
fn pow2(k i32) f64 {
  return bitcast[f64](zext[u64](bitcast[u32](k + 1023)) << 52)
}

// x * 2^n as musl's scalbn: multiplications by powers of two, exact unless
// the result overflows or is below the normal range; then the last one
// rounds (in the current mode, raising the flags). n is at least -1200.
fn scale2(x f64, n i32) f64 {
  y f64 = x
  k i32 = n
  if k > 1023 {
    y = y * pow2(1023)
    k = k - 1023
    if k > 1023 {
      y = y * pow2(1023)
      k = k - 1023
      if k > 1023 {
        k = 1023
      }
    }
  } else if k < -1022 {
    y = y * pow2(-969)          // 2^-1022 * 2^53: still exact
    k = k + 969
  }
  return y * pow2(k)
}

// fma of f64 operands. With odd set the operands are f32 values and the
// result is the exact value rounded to odd at 53 bits (truncated, with bit
// 0 set when bits were lost): converting that to f32 rounds as the exact
// value would, in every mode (Boldo and Melquiond), flags included.
fn fma_core(x f64, y f64, z f64, odd bool) f64 {
  ex i32 = unpack_e(x)
  ey i32 = unpack_e(y)
  ez i32 = unpack_e(z)
  // A NaN z goes through the addition too, which quiets a signaling NaN.
  // (For f32 operands x * y is exact, and so is the sum here.)
  if ex >= ZEROINFNAN || ey >= ZEROINFNAN || z != z {
    return x * y + z
  }
  if ez >= ZEROINFNAN {
    if ez > ZEROINFNAN {
      // z is zero and the product is not: the exact sum is the product, so
      // its rounding keeps the product's sign even when it underflows to
      // zero (x * y + z would turn -0 + +0 into +0).
      return x * y
    }
    return z                  // z is infinite and the product finite
  }
  mx u64 = unpack_m(x)
  my u64 = unpack_m(y)
  mz u64 = unpack_m(z)
  rhi u64 = mul_hi(mx, my)
  rlo u64 = mx * my
  zhi u64 = 0
  zlo u64 = 0
  // Align: shift z left or the product right so both share exponent e.
  e i32 = ex + ey
  d i32 = ez - e
  if d > 0 {
    if d < 64 {
      s u64 = zext[u64](bitcast[u32](d))
      zlo = mz << s
      zhi = mz >> (64 - s)
    } else {
      zlo = 0
      zhi = mz
      e = ez - 64
      d = d - 64
      if d == 0 {
      } else if d < 64 {
        s u64 = zext[u64](bitcast[u32](d))
        sticky u64 = zext[u64](rlo << (64 - s) != 0)
        rlo = (rhi << (64 - s)) | (rlo >> s) | sticky
        rhi = rhi >> s
      } else {
        rlo = 1
        rhi = 0
      }
    }
  } else {
    zhi = 0
    d = -d
    if d == 0 {
      zlo = mz
    } else if d < 64 {
      s u64 = zext[u64](bitcast[u32](d))
      zlo = (mz >> s) | zext[u64](mz << (64 - s) != 0)
    } else {
      zlo = 1
    }
  }
  // Add or subtract z.
  negative bool = (bitcast[u64](x) ^ bitcast[u64](y)) >> 63 != 0
  z_negative bool = bitcast[u64](z) >> 63 != 0
  nonzero bool = true
  if negative == z_negative {
    rlo = rlo + zlo
    rhi = rhi + zhi + zext[u64](rlo < zlo)
  } else {
    t u64 = rlo
    rlo = rlo - zlo
    rhi = rhi - zhi - zext[u64](t < rlo)
    if rhi >> 63 != 0 {
      rlo = 0 - rlo
      rhi = 0 - rhi - zext[u64](rlo != 0)
      negative = !negative
    }
    nonzero = rhi != 0
  }
  // Keep the top 63 bits, bit 0 sticky.
  if nonzero {
    e = e + 64
    n u64 = clz(rhi) - 1
    d = bitcast[i32](trunc[u32](n))
    rhi = (rhi << n) | (rlo >> (64 - n)) | zext[u64](rlo << n != 0)
  } else if rlo != 0 {
    n u64 = clz(rlo)
    if n == 0 {
      rhi = (rlo >> 1) | (rlo & 1)
      d = -1
    } else {
      rhi = rlo << (n - 1)
      d = bitcast[i32](trunc[u32](n)) - 1
    }
  } else {
    // An exact zero: x * y is exact (it is -z), and the sum gives the
    // zero's sign by the rounding mode.
    return x * y + z
  }
  e = e - d
  // value = rhi * 2^e with rhi in [2^62, 2^63)
  if e < -1200 {
    e = -1200                 // far below half the smallest subnormal either way
  }
  if odd {
    // round to odd at 53 bits; f32 magnitudes keep this in the normal range
    q u64 = (rhi >> 10) | zext[u64](rhi & 0x3ff != 0)
    qi i64 = bitcast[i64](q)
    if negative {
      qi = 0 - qi
    }
    return scale2(cvt[f64](qi), e + 10)
  }
  if e < -1084 {
    // Below the normal range before rounding: the subnormal holds fewer
    // than 53 of the bits.
    if e == -1085 {
      // 52 bits held: one less than the conversion keeps
      i i64 = bitcast[i64](rhi)
      if negative {
        i = 0 - i
      }
      r f64 = cvt[f64](i)
      c f64 = pow2(63)
      if negative {
        c = 0.0 - c
      }
      if r == c {
        // Rounded up to the smallest normal: underflow is raised or not
        // as the CPU detects tininess, imitated on the f32 just below
        // FLT_MIN (2^-126 - 2^-151), which rounds the same way.
        tf f64 = r * bitcast[f64](P2M189)      // r * 2^-189
        fm f32 = cvt[f32](tf * bitcast[f64](JUST_BELOW_1))
        return cvt[f64](fm) * pow2(-896)
      }
      if rhi << 53 != 0 {
        // inexact: an extra top bit makes the conversion round at the
        // subnormal's last bit, then it is taken off again (exactly)
        i = bitcast[i64]((rhi >> 1) | (rhi & 1) | 0x4000000000000000)
        if negative {
          i = 0 - i
        }
        r = cvt[f64](i)
        r = 2.0 * r - c
        // the result is tiny and inexact: raise underflow (the scaling
        // below is exact and would not)
        tiny f64 = r * pow2(-1022)
        r = r + (tiny * tiny) * (r - r)
      }
      return scale2(r, e)
    }
    // at most 51 bits held: keep 53 with bit 0 sticky, the conversion is
    // exact and the scaling rounds once
    rhi = ((rhi >> 10) | zext[u64](rhi & 0x3ff != 0)) << 10
  }
  i i64 = bitcast[i64](rhi)
  if negative {
    i = 0 - i
  }
  return scale2(cvt[f64](i), e)
}

extern "C" {
fn fas_rt_fma64(x f64, y f64, z f64) f64 {
  return fma_core(x, y, z, false)
}
}

// f32: the operands convert exactly; the exact result rounded to odd at 53
// bits then rounds once to f32.
extern "C" {
fn fas_rt_fma32(x f32, y f32, z f32) f32 {
  return cvt[f32](fma_core(cvt[f64](x), cvt[f64](y), cvt[f64](z), true))
}
}
