// Source-frame stack, .macro/.endm, .rept/.irp/.irpc/.endr,
// .if/.ifdef/.ifndef/.else/.elseif/.endif, .include, and .incbin.

struct SourceFrame {
    filename Bytes
    src Bytes
    pos u64
    line u32
    pad u32
}

struct MacroParam {
    name Bytes
    def_val Bytes
    has_default bool
    pad arr[7, u8]
}

struct MacroDef {
    name Bytes
    params Vec[MacroParam]
    body Bytes
}

fn push_source_frame(filename Bytes, text Bytes) void {
    fr handle[SourceFrame] = vec_add(&ac.src_stack)
    fr.filename = ac.filename
    fr.src = ac.src
    fr.pos = ac.pos
    fr.line = ac.line
    ac.filename = filename
    ac.src = text
    ac.pos = 0
    ac.line = 1
}

fn pop_source_frame() bool {
    if ac.src_stack.n == 0 { return false }
    fr handle[SourceFrame] = vec_at(&ac.src_stack, ac.src_stack.n - 1)
    ac.filename = fr.filename
    ac.src = fr.src
    ac.pos = fr.pos
    ac.line = fr.line
    ac.src_stack.n -= 1
    return true
}

// Reads raw lines until the matching end directive (handling nested blocks).
// `open_kind`: 0 = .macro/.endm, 1 = .rept/.irp/.irpc/.endr
fn capture_block_body(open_kind u8) Bytes fails {
    body Buf = {}
    depth u32 = 1
    p addr = ac.src.p
    n u64 = ac.src.n
    while ac.pos < n {
        line_start u64 = ac.pos
        while ac.pos < n && p[u8, ac.pos] != 10 { ac.pos += 1 }
        line_end u64 = ac.pos
        if ac.pos < n && p[u8, ac.pos] == 10 { ac.pos += 1; ac.line += 1 }

        // Check first directive token on this line
        i u64 = line_start
        while i < line_end && is_hspace(p[u8, i]) { i += 1 }
        if i < line_end && p[u8, i] == 46 {
            j u64 = i
            while j < line_end && is_ident_char(p[u8, j]) { j += 1 }
            d Bytes = bytes(p + i, j - i)
            if open_kind == 0 {
                if bytes_is(d, c".macro") { depth += 1 }
                else if bytes_is(d, c".endm") {
                    depth -= 1
                    if depth == 0 {
                        iid u32 = intern(&ac.names, buf_bytes(&body))
                        return intern_name(&ac.names, iid)
                    }
                }
            } else {
                if bytes_is(d, c".rept") || bytes_is(d, c".irp") || bytes_is(d, c".irpc") { depth += 1 }
                else if bytes_is(d, c".endr") {
                    depth -= 1
                    if depth == 0 {
                        iid u32 = intern(&ac.names, buf_bytes(&body))
                        return intern_name(&ac.names, iid)
                    }
                }
            }
        }
        buf_append(&body, bytes(p + line_start, line_end - line_start))
        buf_u8(&body, 10)
    }
    try as_err(if open_kind == 0 { c"unterminated .macro (missing .endm)" } else { c"unterminated .rept/.irp/.irpc (missing .endr)" })
    return bytes_empty()
}

fn parse_macro_def() void fails {
    name Bytes = try parse_ident()
    mid u32 = trunc[u32](ac.macros.n)
    m handle[MacroDef] = vec_add(&ac.macros)
    iid u32 = intern(&ac.names, name)
    m.name = intern_name(&ac.names, iid)

    // Parse optional parameter list: p1, p2=default, ...
    while !at_eol() {
        skip_hspace()
        if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 44 { ac.pos += 1; continue }
        if at_eol() { break }
        pname Bytes = try parse_ident()
        mp handle[MacroParam] = vec_add(&m.params)
        piid u32 = intern(&ac.names, pname)
        mp.name = intern_name(&ac.names, piid)
        skip_hspace()
        if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 58 { // optional :req / :vararg
            ac.pos += 1
            try parse_ident()
            skip_hspace()
        }
        if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 61 { // =default
            ac.pos += 1
            skip_hspace()
            dstart u64 = ac.pos
            while ac.pos < ac.src.n {
                c u8 = ac.src.p[u8, ac.pos]
                if c == 44 || c == 10 || c == 59 || c == 35 || is_hspace(c) { break }
                ac.pos += 1
            }
            diid u32 = intern(&ac.names, bytes(ac.src.p + dstart, ac.pos - dstart))
            mp.def_val = intern_name(&ac.names, diid)
            mp.has_default = true
        }
        skip_hspace()
        if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 44 { ac.pos += 1 }
    }
    skip_to_eol()
    if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 10 { ac.pos += 1; ac.line += 1 }
    m.body = try capture_block_body(0)
    map_put(&ac.macro_map, m.name, mid)
}

fn expand_macro_body(body Bytes, pnames handle[Vec[Bytes]], pvals handle[Vec[Bytes]], uid u64, out handle[Buf]) void {
    p addr = body.p
    n u64 = body.n
    i u64 = 0
    while i < n {
        if p[u8, i] == 92 && i + 1 < n { // '\'
            c1 u8 = p[u8, i + 1]
            if c1 == 64 { // \@ -> unique invocation id
                buf_dec_u64(out, uid)
                i += 2
                continue
            }
            if c1 == 40 && i + 2 < n && p[u8, i + 2] == 41 { // \() token paste separator
                i += 3
                continue
            }
            if is_ident_start(c1) {
                j u64 = i + 1
                while j < n && is_ident_char(p[u8, j]) { j += 1 }
                cand Bytes = bytes(p + i + 1, j - (i + 1))
                found bool = false
                for k u64 in 0..pnames.n {
                    if bytes_eq(vec_get(pnames, k), cand) {
                        buf_append(out, vec_get(pvals, k))
                        found = true
                        break
                    }
                }
                if found {
                    i = j
                    continue
                }
            }
        }
        buf_u8(out, p[u8, i])
        i += 1
    }
}

fn try_invoke_macro(name Bytes) bool fails {
    mid u32 = map_get(&ac.macro_map, name) catch AS_NONE
    if mid == AS_NONE { return false }
    m handle[MacroDef] = vec_at(&ac.macros, zext[u64](mid))

    // Parse comma-separated raw argument strings up to EOL
    args Vec[Bytes] = {}
    p addr = ac.src.p
    n u64 = ac.src.n
    while !at_eol() {
        skip_hspace()
        if at_eol() { break }
        astart u64 = ac.pos
        depth u32 = 0
        in_str bool = false
        while ac.pos < n {
            c u8 = p[u8, ac.pos]
            if in_str {
                if c == 92 && ac.pos + 1 < n { ac.pos += 2; continue }
                if c == 34 { in_str = false }
                ac.pos += 1
                continue
            }
            if c == 34 { in_str = true; ac.pos += 1; continue }
            if c == 40 { depth += 1; ac.pos += 1; continue }
            if c == 41 && depth > 0 { depth -= 1; ac.pos += 1; continue }
            if depth == 0 && (c == 44 || c == 10 || c == 59 || c == 35) { break }
            ac.pos += 1
        }
        aend u64 = ac.pos
        while aend > astart && is_hspace(p[u8, aend - 1]) { aend -= 1 }
        vec_push(&args, bytes(p + astart, aend - astart))
        if ac.pos < n && p[u8, ac.pos] == 44 { ac.pos += 1 }
    }

    pnames Vec[Bytes] = {}
    pvals Vec[Bytes] = {}
    for k u64 in 0..m.params.n {
        mp handle[MacroParam] = vec_at(&m.params, k)
        vec_push(&pnames, mp.name)
        if k < args.n && vec_get(&args, k).n != 0 {
            vec_push(&pvals, vec_get(&args, k))
        } else if mp.has_default {
            vec_push(&pvals, mp.def_val)
        } else {
            vec_push(&pvals, bytes_empty())
        }
    }

    ac.macro_uid += 1
    expanded Buf = {}
    expand_macro_body(m.body, &pnames, &pvals, ac.macro_uid, &expanded)
    iid u32 = intern(&ac.names, buf_bytes(&expanded))
    push_source_frame(m.name, intern_name(&ac.names, iid))
    return true
}

fn parse_rept_directive() void fails {
    cnt i64 = try eval_const_now(try parse_expr())
    skip_to_eol()
    if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 10 { ac.pos += 1; ac.line += 1 }
    body Bytes = try capture_block_body(1)
    if cnt <= 0 { return }
    expanded Buf = {}
    for i i64 in 0..cnt { buf_append(&expanded, body) }
    iid u32 = intern(&ac.names, buf_bytes(&expanded))
    push_source_frame(bytes_c(c"<rept>"), intern_name(&ac.names, iid))
}

fn parse_irp_directive(is_irpc bool) void fails {
    vname Bytes = try parse_ident()
    skip_hspace()
    if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 44 { ac.pos += 1 }
    vals Vec[Bytes] = {}
    p addr = ac.src.p
    n u64 = ac.src.n
    if is_irpc {
        skip_hspace()
        sstart u64 = ac.pos
        while ac.pos < n && !at_eol() { ac.pos += 1 }
        send u64 = ac.pos
        while send > sstart && is_hspace(p[u8, send - 1]) { send -= 1 }
        for k u64 in sstart..send {
            vec_push(&vals, bytes(p + k, 1))
        }
    } else {
        while !at_eol() {
            skip_hspace()
            if at_eol() { break }
            astart u64 = ac.pos
            while ac.pos < n {
                c u8 = p[u8, ac.pos]
                if c == 44 || c == 10 || c == 59 || c == 35 { break }
                ac.pos += 1
            }
            aend u64 = ac.pos
            while aend > astart && is_hspace(p[u8, aend - 1]) { aend -= 1 }
            vec_push(&vals, bytes(p + astart, aend - astart))
            if ac.pos < n && p[u8, ac.pos] == 44 { ac.pos += 1 }
        }
    }
    skip_to_eol()
    if ac.pos < n && p[u8, ac.pos] == 10 { ac.pos += 1; ac.line += 1 }
    body Bytes = try capture_block_body(1)
    if vals.n == 0 { return }
    pnames Vec[Bytes] = {}
    vec_push(&pnames, vname)
    expanded Buf = {}
    for i u64 in 0..vals.n {
        pvals Vec[Bytes] = {}
        vec_push(&pvals, vec_get(&vals, i))
        ac.macro_uid += 1
        expand_macro_body(body, &pnames, &pvals, ac.macro_uid, &expanded)
    }
    iid u32 = intern(&ac.names, buf_bytes(&expanded))
    push_source_frame(bytes_c(c"<irp>"), intern_name(&ac.names, iid))
}

// Skips lines in a false .if branch until matching .else, .elseif, or .endif.
fn skip_false_branch(stop_at_else bool) void fails {
    depth u32 = 1
    p addr = ac.src.p
    n u64 = ac.src.n
    while ac.pos < n {
        line_start u64 = ac.pos
        while ac.pos < n && p[u8, ac.pos] != 10 { ac.pos += 1 }
        line_end u64 = ac.pos
        i u64 = line_start
        while i < line_end && is_hspace(p[u8, i]) { i += 1 }
        if i < line_end && p[u8, i] == 46 {
            j u64 = i
            while j < line_end && is_ident_char(p[u8, j]) { j += 1 }
            d Bytes = bytes(p + i, j - i)
            if bytes_is(d, c".if") || bytes_is(d, c".ifdef") || bytes_is(d, c".ifndef") ||
               bytes_is(d, c".ifb") || bytes_is(d, c".ifnb") || bytes_is(d, c".ifeqs") || bytes_is(d, c".ifnes") {
                depth += 1
            } else if bytes_is(d, c".endif") {
                depth -= 1
                if depth == 0 {
                    if ac.pos < n && p[u8, ac.pos] == 10 { ac.pos += 1; ac.line += 1 }
                    return
                }
            } else if depth == 1 && stop_at_else && bytes_is(d, c".else") {
                if ac.pos < n && p[u8, ac.pos] == 10 { ac.pos += 1; ac.line += 1 }
                vec_push(&ac.if_stack, 1) // active else branch
                return
            } else if depth == 1 && stop_at_else && bytes_is(d, c".elseif") {
                ac.pos = j
                cond i64 = try eval_const_now(try parse_expr())
                skip_to_eol()
                if ac.pos < n && p[u8, ac.pos] == 10 { ac.pos += 1; ac.line += 1 }
                if cond != 0 {
                    vec_push(&ac.if_stack, 1)
                    return
                }
                continue
            }
        }
        if ac.pos < n && p[u8, ac.pos] == 10 { ac.pos += 1; ac.line += 1 }
    }
    try as_err(c"unterminated .if (missing .endif)")
}

fn resolve_include_file(rel Bytes, out handle[Buf]) Bytes fails {
    // 1. Try relative to current file's directory
    if ac.filename.n != 0 {
        slash usize = bytes_rindex(ac.filename, 47) catch ac.filename.n
        if slash != ac.filename.n {
            cand Buf = {}
            buf_append(&cand, bytes(ac.filename.p, slash + 1))
            buf_append(&cand, rel)
            cstr addr = buf_cstr(&cand)
            if os_exists(cstr) {
                try file_read(cstr, 64 * 1024 * 1024, out)
                iid u32 = intern(&ac.names, buf_bytes(&cand))
                return intern_name(&ac.names, iid)
            }
        }
    }
    // 2. Try path as-is
    pbuf Buf = {}
    buf_append(&pbuf, rel)
    if os_exists(buf_cstr(&pbuf)) {
        try file_read(buf_cstr(&pbuf), 64 * 1024 * 1024, out)
        iid u32 = intern(&ac.names, rel)
        return intern_name(&ac.names, iid)
    }
    // 3. Try -I include directories
    dirs handle[Vec[Bytes]] = ac.inc_dirs
    if dirs != null {
        for k u64 in 0..dirs.n {
            cand Buf = {}
            dir Bytes = vec_get(dirs, k)
            buf_append(&cand, dir)
            if dir.n != 0 && dir.p[u8, dir.n - 1] != 47 { buf_u8(&cand, 47) }
            buf_append(&cand, rel)
            cstr addr = buf_cstr(&cand)
            if os_exists(cstr) {
                try file_read(cstr, 64 * 1024 * 1024, out)
                iid u32 = intern(&ac.names, buf_bytes(&cand))
                return intern_name(&ac.names, iid)
            }
        }
    }
    try as_err_b(c"cannot find included file: ", rel)
    return bytes_empty()
}

fn parse_include_directive() void fails {
    fb Buf = {}
    try parse_string_lit(&fb)
    skip_to_eol()
    if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 10 { ac.pos += 1; ac.line += 1 }
    data Buf = {}
    fname Bytes = try resolve_include_file(buf_bytes(&fb), &data)
    push_source_frame(fname, buf_bytes(&data))
}

fn parse_incbin_directive() void fails {
    fb Buf = {}
    try parse_string_lit(&fb)
    skip_n u64 = 0
    has_count bool = false
    count_n u64 = 0
    skip_hspace()
    if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 44 {
        ac.pos += 1
        skip_n = bitcast[u64](try eval_const_now(try parse_expr()))
        skip_hspace()
        if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 44 {
            ac.pos += 1
            count_n = bitcast[u64](try eval_const_now(try parse_expr()))
            has_count = true
        }
    }
    data Buf = {}
    try resolve_include_file(buf_bytes(&fb), &data)
    if skip_n >= data.n { return }
    avail u64 = data.n - skip_n
    take u64 = if has_count && count_n < avail { count_n } else { avail }
    emit_bytes(bytes(data.p + skip_n, take))
}
