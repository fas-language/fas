// Source-frame stack, .macro/.endm, .rept/.irp/.irpc/.endr,
// .if/.ifdef/.ifndef/.else/.elseif/.endif, .include, and .incbin.

struct SourceFrame {
    filename Bytes
    src Bytes
    pos u64
    line u32
    pad u32
}

struct MacroParam {
    name Bytes
    def_val Bytes
    has_default bool
    required bool
    vararg bool
    pad arr[5, u8]
}

struct MacroDef {
    name Bytes
    params Vec[MacroParam]
    body Bytes
}

fn push_source_frame(filename Bytes, text Bytes) void {
    fr handle[SourceFrame] = vec_add(&ac.src_stack)
    fr.filename = ac.filename
    fr.src = ac.src
    fr.pos = ac.pos
    fr.line = ac.line
    ac.filename = filename
    ac.src = text
    ac.pos = 0
    ac.line = 1
}

fn pop_source_frame() bool {
    if ac.src_stack.n == 0 { return false }
    fr handle[SourceFrame] = vec_at(&ac.src_stack, ac.src_stack.n - 1)
    ac.filename = fr.filename
    ac.src = fr.src
    ac.pos = fr.pos
    ac.line = fr.line
    ac.src_stack.n -= 1
    return true
}

// Advance to the next statement without interpreting the current one.
fn advance_statement() void {
    p addr = ac.src.p
    n u64 = ac.src.n
    quoted bool = false
    while ac.pos < n {
        c u8 = p[u8, ac.pos]
        ac.pos += 1
        if c == 10 { ac.line += 1; return }
        if quoted {
            if c == 34 { quoted = false }
            else if c == 92 && ac.pos < n && p[u8, ac.pos] != 10 { ac.pos += 1 }
            continue
        }
        if c == 34 { quoted = true }
        else if c == 59 { return }
        else if c == 35 || (c == 47 && ac.pos < n && p[u8, ac.pos] == 47) {
            while ac.pos < n && p[u8, ac.pos] != 10 { ac.pos += 1 }
        } else if c == 47 && ac.pos < n && p[u8, ac.pos] == 42 {
            ac.pos -= 1
            skip_hspace()
        } else if c == 39 && ac.pos < n && p[u8, ac.pos] != 10 {
            if p[u8, ac.pos] == 92 && ac.pos + 1 < n && p[u8, ac.pos + 1] != 10 { ac.pos += 1 }
            ac.pos += 1
            if ac.pos < n && p[u8, ac.pos] == 39 { ac.pos += 1 }
        }
    }
}

fn statement_directive() Bytes {
    skip_hspace()
    start u64 = ac.pos
    p addr = ac.src.p
    if start >= ac.src.n || p[u8, start] != 46 { return bytes_empty() }
    while ac.pos < ac.src.n && is_ident_char(p[u8, ac.pos]) { ac.pos += 1 }
    return bytes(p + start, ac.pos - start)
}

// Captures statements until the matching end directive, handling nesting.
// `open_kind`: 0 = .macro/.endm, 1 = .rept/.irp/.irpc/.endr
fn capture_block_body(open_kind u8) Bytes fails {
    start u64 = ac.pos
    depth u32 = 1
    p addr = ac.src.p
    while ac.pos < ac.src.n {
        stmt u64 = ac.pos
        d Bytes = statement_directive()
        if open_kind == 0 {
            if bytes_is(d, c".macro") { depth += 1 }
            else if bytes_is(d, c".endm") || bytes_is(d, c".endmacro") { depth -= 1 }
        } else {
            if bytes_is(d, c".rept") || bytes_is(d, c".irp") || bytes_is(d, c".irpc") { depth += 1 }
            else if bytes_is(d, c".endr") { depth -= 1 }
        }
        advance_statement()
        if depth == 0 { return bytes(p + start, stmt - start) }
    }
    try as_err(if open_kind == 0 { c"unterminated .macro (missing .endm)" } else { c"unterminated .rept/.irp/.irpc (missing .endr)" })
    return bytes_empty()
}

fn macro_operator(c u8) bool {
    return c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 38 ||
           c == 124 || c == 94 || c == 60 || c == 62 || c == 61 || c == 33 || c == 126
}

// Commas and whitespace separate arguments outside strings and parentheses.
// Whitespace around an expression operator is part of the argument.
fn macro_argument(rest bool, split_space bool) Bytes {
    skip_hspace()
    p addr = ac.src.p
    n u64 = ac.src.n
    start u64 = ac.pos
    end u64 = start
    depth u32 = 0
    quoted bool = false
    while ac.pos < n {
        c u8 = p[u8, ac.pos]
        if c == 10 { break }
        if quoted {
            if c == 92 && ac.pos + 1 < n && p[u8, ac.pos + 1] != 10 { ac.pos += 1 }
            else if c == 34 { quoted = false }
        } else if c == 34 { quoted = true }
        else if depth == 0 && (c == 59 || c == 35 || (!rest && c == 44)) { break }
        else if c == 40 { depth += 1 }
        else if c == 41 && depth > 0 { depth -= 1 }
        else if depth == 0 && !rest && split_space && is_hspace(c) {
            skip_hspace()
            if ac.pos >= n { break }
            left bool = end > start && macro_operator(p[u8, end - 1])
            next u8 = p[u8, ac.pos]
            // A '%' followed by a name starts a register, not an operator.
            right bool = macro_operator(next) && !(next == 37 && ac.pos + 1 < n && is_ident_start(p[u8, ac.pos + 1]))
            if !left && !right { break }
            continue
        }
        ac.pos += 1
        if quoted || !is_hspace(c) { end = ac.pos }
    }
    return bytes(p + start, end - start)
}

fn parse_macro_def() void fails {
    name Bytes = try parse_ident()
    mid u32 = trunc[u32](ac.macros.n)
    m handle[MacroDef] = vec_add(&ac.macros)
    iid u32 = intern(&ac.names, name)
    m.name = intern_name(&ac.names, iid)

    // Parse optional parameter list: p1, p2=default, ...
    while !at_eol() {
        skip_hspace()
        if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 44 { ac.pos += 1; continue }
        if at_eol() { break }
        pname Bytes = try parse_ident()
        mp handle[MacroParam] = vec_add(&m.params)
        piid u32 = intern(&ac.names, pname)
        mp.name = intern_name(&ac.names, piid)
        skip_hspace()
        if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 58 { // optional :req / :vararg
            ac.pos += 1
            qualifier Bytes = try parse_ident()
            if bytes_is(qualifier, c"req") { mp.required = true }
            else if bytes_is(qualifier, c"vararg") { mp.vararg = true }
            else { try as_err_b(c"unknown macro parameter qualifier: ", qualifier) }
            skip_hspace()
        }
        if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 61 { // =default
            ac.pos += 1
            def_val Bytes = macro_argument(false, true)
            diid u32 = intern(&ac.names, def_val)
            mp.def_val = intern_name(&ac.names, diid)
            mp.has_default = true
        }
        skip_hspace()
        if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 44 { ac.pos += 1 }
        if mp.vararg && !at_eol() { try as_err(c"variadic parameter must be last") }
    }
    advance_statement()
    m.body = try capture_block_body(0)
    map_put(&ac.macro_map, m.name, mid)
}

fn expand_macro_body(body Bytes, pnames handle[Vec[Bytes]], pvals handle[Vec[Bytes]], uid u64, out handle[Buf]) void {
    p addr = body.p
    n u64 = body.n
    i u64 = 0
    while i < n {
        if p[u8, i] == 92 && i + 1 < n { // '\'
            c1 u8 = p[u8, i + 1]
            if c1 == 64 { // \@ -> unique invocation id
                buf_dec_u64(out, uid)
                i += 2
                continue
            }
            if c1 == 40 && i + 2 < n && p[u8, i + 2] == 41 { // \() token paste separator
                i += 3
                continue
            }
            if is_ident_start(c1) {
                j u64 = i + 1
                while j < n && is_ident_char(p[u8, j]) { j += 1 }
                cand Bytes = bytes(p + i + 1, j - (i + 1))
                found bool = false
                for k u64 in 0..pnames.n {
                    if bytes_eq(vec_get(pnames, k), cand) {
                        buf_append(out, vec_get(pvals, k))
                        found = true
                        break
                    }
                }
                if found {
                    i = j
                    continue
                }
            }
        }
        buf_u8(out, p[u8, i])
        i += 1
    }
}

fn try_invoke_macro(name Bytes) bool fails {
    mid u32 = map_get(&ac.macro_map, name) catch AS_NONE
    if mid == AS_NONE { return false }
    m handle[MacroDef] = vec_at(&ac.macros, zext[u64](mid))

    args Vec[Bytes] = {}
    for k u64 in 0..m.params.n { vec_push(&args, bytes_empty()) }
    p addr = ac.src.p
    n u64 = ac.src.n
    position u64 = 0
    keyword bool = false
    while !at_eol() {
        start u64 = ac.pos
        end u64 = start
        if is_ident_start(p[u8, start]) {
            while end < n && is_ident_char(p[u8, end]) { end += 1 }
        }
        sep u64 = end
        while sep < n && is_hspace(p[u8, sep]) { sep += 1 }
        index u64 = position
        if end != start && sep < n && p[u8, sep] == 61 && (sep + 1 == n || p[u8, sep + 1] != 61) {
            param Bytes = bytes(p + start, end - start)
            if position != 0 && !keyword { try as_err(c"cannot mix positional and keyword arguments") }
            keyword = true
            index = 0
            while index < m.params.n && !bytes_eq(vec_at(&m.params, index).name, param) { index += 1 }
            if index == m.params.n { try as_err_b(c"unknown macro parameter: ", param) }
            ac.pos = sep + 1
        } else if keyword { try as_err(c"cannot mix positional and keyword arguments") }
        if index >= m.params.n { try as_err(c"too many macro arguments") }
        mp handle[MacroParam] = vec_at(&m.params, index)
        args.p[Bytes, index] = macro_argument(mp.vararg, true)
        position += 1
        skip_hspace()
        if ac.pos < n && p[u8, ac.pos] == 44 { ac.pos += 1 }
    }

    pnames Vec[Bytes] = {}
    pvals Vec[Bytes] = {}
    for k u64 in 0..m.params.n {
        mp handle[MacroParam] = vec_at(&m.params, k)
        vec_push(&pnames, mp.name)
        value Bytes = vec_get(&args, k)
        if value.n == 0 && mp.required { try as_err_b(c"missing required macro argument: ", mp.name) }
        if value.n == 0 && mp.has_default { value = mp.def_val }
        if !mp.vararg && value.n >= 2 && value.p[u8] == 34 && value.p[u8, value.n - 1] == 34 {
            value = bytes(value.p + 1, value.n - 2)
        }
        vec_push(&pvals, value)
    }

    expanded Buf = {}
    expand_macro_body(m.body, &pnames, &pvals, ac.macro_uid, &expanded)
    ac.macro_uid += 1
    iid u32 = intern(&ac.names, buf_bytes(&expanded))
    push_source_frame(m.name, intern_name(&ac.names, iid))
    return true
}

fn parse_rept_directive() void fails {
    cnt i64 = try eval_const_now(try parse_expr())
    advance_statement()
    body Bytes = try capture_block_body(1)
    if cnt <= 0 { return }
    expanded Buf = {}
    for i i64 in 0..cnt { buf_append(&expanded, body) }
    iid u32 = intern(&ac.names, buf_bytes(&expanded))
    push_source_frame(bytes_c(c"<rept>"), intern_name(&ac.names, iid))
}

fn parse_irp_directive(is_irpc bool) void fails {
    vname Bytes = try parse_ident()
    skip_hspace()
    if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 44 { ac.pos += 1 }
    vals Vec[Bytes] = {}
    p addr = ac.src.p
    n u64 = ac.src.n
    if is_irpc {
        skip_hspace()
        sstart u64 = ac.pos
        while ac.pos < n && !at_eol() { ac.pos += 1 }
        send u64 = ac.pos
        while send > sstart && is_hspace(p[u8, send - 1]) { send -= 1 }
        for k u64 in sstart..send {
            vec_push(&vals, bytes(p + k, 1))
        }
    } else {
        while !at_eol() {
            skip_hspace()
            if at_eol() { break }
            astart u64 = ac.pos
            while ac.pos < n {
                c u8 = p[u8, ac.pos]
                if c == 44 || c == 10 || c == 59 || c == 35 { break }
                ac.pos += 1
            }
            aend u64 = ac.pos
            while aend > astart && is_hspace(p[u8, aend - 1]) { aend -= 1 }
            vec_push(&vals, bytes(p + astart, aend - astart))
            if ac.pos < n && p[u8, ac.pos] == 44 { ac.pos += 1 }
        }
    }
    advance_statement()
    body Bytes = try capture_block_body(1)
    if vals.n == 0 { return }
    pnames Vec[Bytes] = {}
    vec_push(&pnames, vname)
    expanded Buf = {}
    for i u64 in 0..vals.n {
        pvals Vec[Bytes] = {}
        vec_push(&pvals, vec_get(&vals, i))
        ac.macro_uid += 1
        expand_macro_body(body, &pnames, &pvals, ac.macro_uid, &expanded)
    }
    iid u32 = intern(&ac.names, buf_bytes(&expanded))
    push_source_frame(bytes_c(c"<irp>"), intern_name(&ac.names, iid))
}

// Skips statements in a false branch until .else, .elseif or .endif.
fn skip_false_branch(stop_at_else bool) void fails {
    depth u32 = 1
    while ac.pos < ac.src.n {
        d Bytes = statement_directive()
        if bytes_is(d, c".if") || bytes_is(d, c".ifdef") || bytes_is(d, c".ifndef") ||
           bytes_is(d, c".ifb") || bytes_is(d, c".ifnb") || bytes_is(d, c".ifeqs") || bytes_is(d, c".ifnes") ||
           bytes_is(d, c".ifc") || bytes_is(d, c".ifnc") {
            depth += 1
        } else if bytes_is(d, c".endif") {
            depth -= 1
        } else if depth == 1 && stop_at_else {
            active bool = bytes_is(d, c".else")
            if bytes_is(d, c".elseif") { active = try eval_const_now(try parse_expr()) != 0 }
            if active {
                advance_statement()
                vec_push(&ac.if_stack, 1)
                return
            }
        }
        advance_statement()
        if depth == 0 { return }
    }
    try as_err(c"unterminated .if (missing .endif)")
}

fn begin_asm_if(active bool) void fails {
    advance_statement()
    if active { vec_push(&ac.if_stack, 1) } else { try skip_false_branch(true) }
}

fn resolve_include_file(rel Bytes, out handle[Buf]) Bytes fails {
    // 1. Try relative to current file's directory
    if ac.filename.n != 0 {
        slash usize = bytes_rindex(ac.filename, 47) catch ac.filename.n
        if slash != ac.filename.n {
            cand Buf = {}
            buf_append(&cand, bytes(ac.filename.p, slash + 1))
            buf_append(&cand, rel)
            cstr addr = buf_cstr(&cand)
            if os_exists(cstr) {
                try file_read(cstr, 64 * 1024 * 1024, out)
                iid u32 = intern(&ac.names, buf_bytes(&cand))
                return intern_name(&ac.names, iid)
            }
        }
    }
    // 2. Try path as-is
    pbuf Buf = {}
    buf_append(&pbuf, rel)
    if os_exists(buf_cstr(&pbuf)) {
        try file_read(buf_cstr(&pbuf), 64 * 1024 * 1024, out)
        iid u32 = intern(&ac.names, rel)
        return intern_name(&ac.names, iid)
    }
    // 3. Try -I include directories
    dirs handle[Vec[Bytes]] = ac.inc_dirs
    if dirs != null {
        for k u64 in 0..dirs.n {
            cand Buf = {}
            dir Bytes = vec_get(dirs, k)
            buf_append(&cand, dir)
            if dir.n != 0 && dir.p[u8, dir.n - 1] != 47 { buf_u8(&cand, 47) }
            buf_append(&cand, rel)
            cstr addr = buf_cstr(&cand)
            if os_exists(cstr) {
                try file_read(cstr, 64 * 1024 * 1024, out)
                iid u32 = intern(&ac.names, buf_bytes(&cand))
                return intern_name(&ac.names, iid)
            }
        }
    }
    try as_err_b(c"cannot find included file: ", rel)
    return bytes_empty()
}

fn parse_include_directive() void fails {
    fb Buf = {}
    try parse_string_lit(&fb)
    skip_to_eol()
    if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 10 { ac.pos += 1; ac.line += 1 }
    data Buf = {}
    fname Bytes = try resolve_include_file(buf_bytes(&fb), &data)
    push_source_frame(fname, buf_bytes(&data))
}

fn parse_incbin_directive() void fails {
    fb Buf = {}
    try parse_string_lit(&fb)
    skip_n u64 = 0
    has_count bool = false
    count_n u64 = 0
    skip_hspace()
    if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 44 {
        ac.pos += 1
        skip_n = bitcast[u64](try eval_const_now(try parse_expr()))
        skip_hspace()
        if ac.pos < ac.src.n && ac.src.p[u8, ac.pos] == 44 {
            ac.pos += 1
            count_n = bitcast[u64](try eval_const_now(try parse_expr()))
            has_count = true
        }
    }
    data Buf = {}
    try resolve_include_file(buf_bytes(&fb), &data)
    if skip_n >= data.n { return }
    avail u64 = data.n - skip_n
    take u64 = if has_count && count_n < avail { count_n } else { avail }
    emit_bytes(bytes(data.p + skip_n, take))
}
