// Memory: raw byte helpers, a heap for blocks that grow and shrink, and
// arenas for data that lives until the arena is dropped.
//
// Allocation never fails: when the kernel refuses memory, the library
// writes "out of memory" to stderr and exits with status 2 (like OCaml's
// Out_of_memory in the tools it replaces). Callers never write `try` for
// memory.

use "os.fas"

fn mem_out_of_memory() void {
    os_write_all(STDERR, c"fas library: out of memory\n", 27) catch {}
    os_exit(2)
}

// Fresh zeroed pages from the kernel, `n` rounded up to the page size.
// The arena functions are for one thread at a time: give each worker its
// own arena.
// bytes mem_pages has mapped so far (statistics)
var mem_mapped u64 = 0

fn mem_pages(n usize) addr {
    p addr = os_mmap(null, n, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0) catch {
        mem_out_of_memory()
        return null
    }
    atomic_add[u64, relaxed](&mem_mapped, n)
    return p
}

fn mem_round_pages(n usize) usize { return (n + 4095) & ~4095 }

// Copies `n` bytes; the ranges must not overlap.
fn mem_copy(dst addr, src addr, n usize) void {
    i usize = 0
    while i + 8 <= n {
        dst[u64, 0] = src[u64, 0]
        dst = dst + 8
        src = src + 8
        i += 8
    }
    while i < n {
        dst[u8] = src[u8]
        dst = dst + 1
        src = src + 1
        i += 1
    }
}

// Copies a whole struct between non-overlapping regions of the same type.
fn copy_into[T](dst handle[T], src handle[T]) void {
    mem_copy(handle_addr(dst), handle_addr(src), sizeof[T])
}

// Copies `n` bytes; the ranges may overlap.
fn mem_move(dst addr, src addr, n usize) void {
    if addr_bits(dst) <= addr_bits(src) || addr_bits(dst) >= addr_bits(src) + n {
        mem_copy(dst, src, n)
        return
    }
    // dst inside (src, src + n): copy from the end
    i usize = n
    while i >= 8 {
        i -= 8
        (dst + i)[u64] = (src + i)[u64]
    }
    while i > 0 {
        i -= 1
        (dst + i)[u8] = (src + i)[u8]
    }
}

fn mem_set(dst addr, byte u8, n usize) void {
    i usize = 0
    w u64 = zext[u64](byte) * 0x0101010101010101
    while i + 8 <= n {
        (dst + i)[u64] = w
        i += 8
    }
    while i < n {
        dst[u8, i] = byte
        i += 1
    }
}

fn mem_eq(a addr, b addr, n usize) bool {
    i usize = 0
    while i + 8 <= n {
        if (a + i)[u64] != (b + i)[u64] { return false }
        i += 8
    }
    while i < n {
        if a[u8, i] != b[u8, i] { return false }
        i += 1
    }
    return true
}

// ---------- heap ----------
//
// Blocks of up to HEAP_SMALL_MAX bytes come from 13 power-of-two size
// classes (16 B .. 64 KiB) carved from 1 MiB slabs, and go back on a free
// list per class. Bigger blocks are their own mapping, so they return to
// the kernel when freed and grow with mremap. Each block has a 16-byte
// header just before it: the class index, or HEAP_LARGE and the mapping's
// size. Payloads are 16-byte aligned.

const HEAP_CLASSES usize = 13
const HEAP_SMALL_MAX usize = 65536
const HEAP_LARGE u64 = 0xffff
const HEAP_REGION u64 = 0xfffe
const HEAP_SLAB usize = 1048576

var heap_free_lists arr[13, addr] = {}
var heap_slab addr = null
var heap_slab_left usize = 0
// one lock for the whole heap: hot multithreaded paths use per-worker
// arenas instead
var heap_lock u32 = 0

fn heap_class(n usize) usize {
    k usize = 0
    while (zext[usize](16) << k) < n { k += 1 }
    return k
}

// `n` bytes, not zeroed. Any thread may call the heap functions.
fn heap_alloc(n usize) addr {
    r handle[Region] = current_region
    if r == null { return heap_alloc_plain(n) }
    block addr = arena_alloc(&r.arena, n + 16, 16)
    block[u64, 0] = HEAP_REGION
    block[u64, 1] = n
    return block + 16
}

// Allocates on the ordinary heap even inside a region, for values that escape it.
fn heap_alloc_plain(n usize) addr {
    if n > HEAP_SMALL_MAX {
        size usize = mem_round_pages(n + 16)
        p addr = mem_pages(size)
        p[u64, 0] = HEAP_LARGE
        p[u64, 1] = size
        return p + 16
    }
    k usize = heap_class(n)
    os_lock(&heap_lock)
    head addr = heap_free_lists[k]
    if head != null {
        heap_free_lists[k] = head[addr]
        os_unlock(&heap_lock)
        return head
    }
    block usize = (zext[usize](16) << k) + 16
    if heap_slab_left < block {
        // the rest of the old slab is dropped: at most one block's worth
        heap_slab = mem_pages(HEAP_SLAB)
        heap_slab_left = HEAP_SLAB
    }
    p addr = heap_slab
    heap_slab = heap_slab + block
    heap_slab_left -= block
    os_unlock(&heap_lock)
    p[u64, 0] = k
    return p + 16
}

// `n` zeroed bytes.
fn heap_alloc_zeroed(n usize) addr {
    p addr = heap_alloc(n)
    // a large block is always a fresh mapping, which the kernel has
    // zeroed; clearing it again would touch every page up front
    if n <= HEAP_SMALL_MAX { mem_set(p, 0, n) }
    return p
}

// the usable size of a block from heap_alloc
fn heap_size(p addr) usize {
    k u64 = (p - 16)[u64]
    if k == HEAP_LARGE { return (p - 16)[u64, 1] - 16 }
    if k == HEAP_REGION { return (p - 16)[u64, 1] }
    return zext[usize](16) << k
}

fn heap_free(p addr) void {
    if p == null { return }
    k u64 = (p - 16)[u64]
    if k == HEAP_REGION { return }
    if k == HEAP_LARGE {
        os_munmap(p - 16, (p - 16)[u64, 1])
        return
    }
    os_lock(&heap_lock)
    p[addr] = heap_free_lists[k]
    heap_free_lists[k] = p
    os_unlock(&heap_lock)
}

// Resizes to `n` bytes, keeping the first min(old, n) bytes; null `p`
// allocates. The block may move.
fn heap_realloc(p addr, n usize) addr {
    if p == null { return heap_alloc(n) }
    have usize = heap_size(p)
    if n <= have && (n > HEAP_SMALL_MAX || have <= HEAP_SMALL_MAX) { return p }
    if (p - 16)[u64] == HEAP_LARGE && n > HEAP_SMALL_MAX {
        size usize = mem_round_pages(n + 16)
        q addr = os_mremap(p - 16, (p - 16)[u64, 1], size) catch {
            mem_out_of_memory()
            return null
        }
        q[u64, 1] = size
        return q + 16
    }
    // Growing an ordinary heap block must not tie it to a temporary region.
    q addr = if (p - 16)[u64] == HEAP_REGION { heap_alloc(n) } else { heap_alloc_plain(n) }
    mem_copy(q, p, if have < n { have } else { n })
    heap_free(p)
    return q
}

// Allocates `n` bytes at a power-of-two alignment, optionally zeroed.
fn heap_alloc_aligned(n usize, alignment usize, zeroed bool) addr {
    if alignment <= 16 {
        return if zeroed { heap_alloc_zeroed(n) } else { heap_alloc(n) }
    }
    // Save the original allocation immediately before the aligned payload.
    size usize = n + alignment - 1 + sizeof[addr]
    base addr = if zeroed { heap_alloc_zeroed(size) } else { heap_alloc(size) }
    start addr = base + sizeof[addr]
    offset usize = (0 - addr_bits(start)) & (alignment - 1)
    p addr = start + offset
    (p - sizeof[addr])[addr] = base
    return p
}

// Frees a block allocated with heap_alloc_aligned using the same alignment.
fn heap_free_aligned(p addr, alignment usize) void {
    if p == null { return }
    if alignment > 16 { p = (p - sizeof[addr])[addr] }
    heap_free(p)
}

// ---------- arenas ----------
//
// An arena hands out zeroed memory from 1 MiB chunks (a bigger request
// gets a chunk of its own) and frees all of it at once. Chunks are linked
// through their first 16 bytes: the previous chunk and this chunk's size.

const ARENA_CHUNK usize = 1048576

struct Arena {
    chunk addr      // the current chunk, or null
    used usize      // bytes used in it, header included
    cap usize       // its size
    total usize     // bytes handed out, for statistics
}

fn arena_new_chunk(a handle[Arena], need usize) void {
    size usize = if need + 16 > ARENA_CHUNK { mem_round_pages(need + 16) } else { ARENA_CHUNK }
    c addr = mem_pages(size)
    c[addr, 0] = a.chunk
    c[u64, 1] = size
    a.chunk = c
    a.used = 16
    a.cap = size
}

// `n` zeroed bytes aligned to `align` (a power of two, at most 4096).
fn arena_alloc(a handle[Arena], n usize, align usize) addr {
    start usize = (a.used + align - 1) & ~(align - 1)
    if a.chunk == null || start + n > a.cap {
        arena_new_chunk(a, n + align)
        start = (a.used + align - 1) & ~(align - 1)
    }
    a.used = start + n
    a.total += n
    return a.chunk + start
}

// Unmaps every chunk; the arena is empty and usable again.
fn arena_free(a handle[Arena]) void {
    c addr = a.chunk
    while c != null {
        prev addr = c[addr, 0]
        os_munmap(c, c[u64, 1])
        c = prev
    }
    a.chunk = null
    a.used = 0
    a.cap = 0
    a.total = 0
}

// a copy of `n` bytes at `p`, plus a NUL after them
fn arena_dup(a handle[Arena], p addr, n usize) addr {
    q addr = arena_alloc(a, n + 1, 1)
    mem_copy(q, p, n)
    return q
}

// A heap allocation scope owns a bump arena. Individual frees of its blocks
// are deferred until disposal, including frees on a different thread. A
// region may be installed on only one thread at a time.
struct Region {
    arena Arena
}

thread var current_region handle[Region] = null

// Installs r (null selects the regular heap) and returns the previous scope.
// Restore it before disposing of r.
fn region_switch(r handle[Region]) handle[Region] {
    previous handle[Region] = current_region
    current_region = r
    return previous
}

// Releases all memory in an inactive region and empties it for reuse.
fn region_dispose(r handle[Region]) void {
    arena_free(&r.arena)
}

// Transfers all blocks from an inactive child after its worker has joined.
// The parent's current bump chunk stays at the head of its list.
fn region_adopt(parent handle[Region], child handle[Region]) void {
    first addr = child.arena.chunk
    if first == null { return }
    if parent.arena.chunk == null {
        copy_into[Arena](&parent.arena, &child.arena)
    } else {
        last addr = first
        while last[addr, 0] != null { last = last[addr, 0] }
        last[addr, 0] = parent.arena.chunk[addr, 0]
        parent.arena.chunk[addr, 0] = first
        parent.arena.total += child.arena.total
    }
    mem_set(&child.arena, 0, sizeof[Arena])
}
