// String interning: each distinct byte string gets a dense u32 id (0, 1,
// 2, ... in first-seen order), and its bytes live in the table's arena
// until intern_free.

use "map.fas"

struct Intern {
    ids Map[Bytes, u32, bytes_hash, bytes_eq]
    names Vec[Bytes]
    arena Arena
}

// the id of `s`, adding a copy of it when it is new
fn intern(t handle[Intern], s Bytes) u32 {
    id u32 = map_get(&t.ids, s) catch {
        dup Bytes = bytes_dup(&t.arena, s)
        fresh u32 = trunc[u32](t.names.n)
        vec_push(&t.names, dup)
        r bool = map_put(&t.ids, dup, fresh)
        return fresh
    }
    return id
}

// the id of `s`, or NotFound when it was never interned
fn intern_find(t handle[Intern], s Bytes) u32 fails {
    return try map_get(&t.ids, s)
}

fn intern_name(t handle[Intern], id u32) Bytes {
    return vec_get(&t.names, zext[usize](id))
}

fn intern_count(t handle[Intern]) usize { return t.names.n }

fn intern_free(t handle[Intern]) void {
    map_free(&t.ids)
    vec_free(&t.names)
    arena_free(&t.arena)
}
