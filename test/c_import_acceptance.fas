fn main() i32 {
  if c.pointer_record_value(&c.pointer_record) != 17 { return 1 }
  if c.pointer_union_value(&c.pointer_union) != 23 { return 2 }
  if c.anonymous_pointer_is_null(null) == 0 { return 3 }
  if c.pointer_collision_value(c.pointer_collision_pointer) != 31 { return 4 }
