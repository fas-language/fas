use "C" "c_import/pointer_enum_macro_types.h" as c

fn accept_usize(value usize) i32 { return 0 }
fn accept_isize(value isize) i32 { return 0 }
fn accept_u64(value u64) i32 { return 0 }
fn accept_i32(value i32) i32 { return 0 }
