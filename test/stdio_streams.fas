use "C" <stdio.h> as c
use "C" as c <<C
int counter = 37;
#define counter counter
#define ANSWER 42
C
fn main() i32 {
  if c.counter != 37 || c.ANSWER != 42 { return 1 }
  if c.fprintf(c.stderr, c"error:%d\n", c.counter) < 0 { return 2 }
