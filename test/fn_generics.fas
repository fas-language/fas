// function generic arguments `fn f[F fn(T) R]` (LANGUAGE.md "Function
// arguments"): main returns the number of wrong results, 0 when all agree;
// run by test/fn_generics.sh
use "C" <ctype.h> as c

error Bad

value struct Player { score i32  id i32 }
struct Buf[T] { items arr[8, T] }

fn by_score(a Player, b Player) bool { return a.score < b.score }
fn less[T](a T, b T) bool { return a < b }
fn greater[T](a T, b T) bool { return a > b }

fn sort[T, LESS fn(T, T) bool](xs handle[Buf[T]], n usize) void {
    for i usize in 1..n {
        j usize = i
        while j > 0 && LESS(xs.items[j], xs.items[j - 1]) {
            tmp T = xs.items[j]
            xs.items[j] = xs.items[j - 1]
            xs.items[j - 1] = tmp
            j -= 1
        }
    }
}

// a specialised generic as the argument, inside another generic
fn sort_down[T](xs handle[Buf[T]], n usize) void { sort[T, greater[T]](xs, n) }

fn twice[F fn(i32) i32](x i32) i32 { return F(F(x)) }
// a function parameter passed down
fn apply[F fn(i32) i32](x i32) i32 { return twice[F](x) }
fn inc(x i32) i32 { return x + 1 }
fn sq(x i32) i32 { return x * x }

fn rep[F fn(i32) i32](n i32, x i32) i32 {
    if n == 0 { return x }
    return rep[F](n - 1, F(x))
}

fn check_pos(x i32) i32 fails {
    if x < 0 { fail Bad }
    return x
}
fn run[G fn(i32) i32 fails](x i32) i32 fails {
    y i32 = try G(x)
    return y + 100
}

fn via_addr[F fn(i32) i32](x i32) i32 {
    p addr = &F
    return call_addr[i32](p, x)
}

struct Arr[T, N const usize] { v arr[N, T] }
fn mapn[T, N const usize, F fn(T) T](xs handle[Arr[T, N]]) void {
    for i usize in 0..N { xs.v[i] = F(xs.v[i]) }
}

// a struct with function parameters; calls infer them from the handle
struct Map[K, V, HASH fn(K) u64, EQ fn(K, K) bool] {
    keys arr[16, K]
    vals arr[16, V]
    used arr[16, bool]
}
fn hash_i32(k i32) u64 { return zext[u64](bitcast[u32](k)) * 2654435761 }
fn eq_i32(a i32, b i32) bool { return a == b }
fn map_put[K, V, HASH fn(K) u64, EQ fn(K, K) bool](m handle[Map[K, V, HASH, EQ]], k K, v V) void {
    i usize = HASH(k) % 16
    while m.used[i] && !EQ(m.keys[i], k) { i = (i + 1) % 16 }
    m.used[i] = true
    m.keys[i] = k
    m.vals[i] = v
}
fn map_get[K, V, HASH fn(K) u64, EQ fn(K, K) bool](m handle[Map[K, V, HASH, EQ]], k K) V {
    i usize = HASH(k) % 16
    while m.used[i] && !EQ(m.keys[i], k) { i = (i + 1) % 16 }
    return m.vals[i]
}

fn main() i32 {
    bad i32 = 0

    ps Buf[Player] = {}
    for i usize in 0..8 {
        ps.items[i].score = trunc[i32]((i * 5) % 8)
        ps.items[i].id = trunc[i32](i)
    }
    sort[Player, by_score](handle_from_addr[Buf[Player]](&ps), 8)
    for i usize in 0..8 {
        if ps.items[i].score != trunc[i32](i) { bad += 1 }
        // score i belongs to id (i * 5) % 8: 5 is its own inverse mod 8
        if ps.items[i].id != trunc[i32]((i * 5) % 8) { bad += 1 }
    }

    ns Buf[i32] = {}
    for i usize in 0..8 { ns.items[i] = trunc[i32]((i * 3) % 8) }
    nh handle[Buf[i32]] = handle_from_addr[Buf[i32]](&ns)
    sort[i32, less[i32]](nh, 8)
    for i usize in 0..8 { if ns.items[i] != trunc[i32](i) { bad += 1 } }
    sort_down(nh, 8)
    for i usize in 0..8 { if ns.items[i] != trunc[i32](7 - i) { bad += 1 } }

    if twice[inc](1) != 3 { bad += 1 }
    if apply[sq](3) != 81 { bad += 1 }
    if twice[c.toupper](97) != 65 { bad += 1 }
    if twice[twice[inc]](0) != 4 { bad += 1 }
    if rep[twice[inc]](5, 0) != 10 { bad += 1 }
    if (run[check_pos](5) catch -1) != 105 { bad += 1 }
    if (run[check_pos](-5) catch -1) != -1 { bad += 1 }
    if via_addr[inc](41) != 42 { bad += 1 }

    a Arr[i32, 3] = {}
    mapn[i32, 3, inc](handle_from_addr[Arr[i32, 3]](&a))
    for i usize in 0..3 { if a.v[i] != 1 { bad += 1 } }

    m Map[i32, i32, hash_i32, eq_i32] = {}
    mh handle[Map[i32, i32, hash_i32, eq_i32]] = handle_from_addr[Map[i32, i32, hash_i32, eq_i32]](&m)
    map_put(mh, 3, 30)
    map_put(mh, 19, 190)
    map_put(mh, 3, 31)
    if map_get(mh, 3) != 31 { bad += 1 }
    if map_get(mh, 19) != 190 { bad += 1 }

    return bad
}
