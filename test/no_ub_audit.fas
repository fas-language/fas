// C4 no-UB audit: every rule LANGUAGE.md makes defined where C has
// undefined behaviour, with inputs read through volatile_load so that no
// backend can fold them. Each failed check sets one bit of the result,
// printed as "fails=N" (0 when all agree); no_ub_audit.sh runs it on both
// backends at -O0 and -O2. The trapping rules are separate programs there.
use "C" <stdio.h> as c
use "C" <stdlib.h> as lib

var I32 arr[4, i32] = {2147483647, -2147483647 - 1, -1, 33}
var U32 arr[4, u32] = {1, 32, 33, 4294967295}
var I64 arr[2, i64] = {-9223372036854775807 - 1, -1}
var U8 arr[2, u8] = {255, 1}
var F64 arr[4, f64] = {0.0, 1e300, -1e300, -5.0}
var BYTES arr[24, u8] = {}
var BOOLS arr[4, u8] = {2, 0, 128, 255}
var ACOUNT arr[16, u8] = {}

enum Tok u8 { A = 1, B = 2, C = 7 }

fn vi32(i u64) i32 { return volatile_load[i32](&I32 + i * 4) }
fn vu32(i u64) u32 { return volatile_load[u32](&U32 + i * 4) }
fn vf64(i u64) f64 { return volatile_load[f64](&F64 + i * 8) }

// rule 5: integer arithmetic wraps; shift counts are taken modulo the width
fn wraps() u32 {
    r u32 = 0
    max i32 = vi32(0)
    min i32 = vi32(1)
    m1 i32 = vi32(2)
    if max + 1 != min { r = r | 1 }
    if min - 1 != max { r = r | 2 }
    if min * m1 != min { r = r | 4 }
    if -min != min { r = r | 8 }
    b u8 = volatile_load[u8](&U8)
    if b + volatile_load[u8](&U8 + 1) != 0 { r = r | 16 }
    lmin i64 = volatile_load[i64](&I64)
    if lmin * volatile_load[i64](&I64 + 8) != lmin { r = r | 32 }
    // only `/` traps on MIN / -1: the remainder is 0
    if lmin % volatile_load[i64](&I64 + 8) != 0 { r = r | 1024 }
    if min % m1 != 0 { r = r | 2048 }
    // the comparison must not assume no overflow (C's x + 1 > x)
    if max + 1 > max { r = r | 64 }
    // truncating division and the dividend's sign for %
    if (min + 7) % 3 != -1 { r = r | 128 }
    if (vi32(3) - 40) % 3 != -1 { r = r | 256 }
    if (vi32(3) - 40) / 2 != -3 { r = r | 512 }
    return r
}

fn shifts() u32 {
    r u32 = 0
    one u32 = vu32(0)
    if one << vu32(1) != 1 { r = r | 1 }
    if one << vu32(2) != 2 { r = r | 2 }
    if vu32(3) >> vu32(2) != 2147483647 { r = r | 4 }
    if vi32(1) >> vu32(2) != -1073741824 { r = r | 8 }
    big u64 = 1
    if big << (zext[u64](vu32(1)) + 33) != 2 { r = r | 16 }
    b u8 = volatile_load[u8](&U8 + 1)
    if b << trunc[u8](vu32(2)) != 2 { r = r | 32 }
    return r
}

// conversions: cvt saturates and NaN becomes 0; float division by zero is IEEE
fn conversions() u32 {
    r u32 = 0
    z f64 = vf64(0)
    nan f64 = z / z
    inf f64 = 1.0 / z
    if cvt[i32](nan) != 0 { r = r | 1 }
    if cvt[i32](vf64(1)) != 2147483647 { r = r | 2 }
    if cvt[i32](vf64(2)) != -2147483647 - 1 { r = r | 4 }
    if cvt[u32](vf64(3)) != 0 { r = r | 8 }
    if cvt[u64](inf) != 18446744073709551615 { r = r | 16 }
    if cvt[i64](-inf) != -9223372036854775807 - 1 { r = r | 32 }
    if cvt[u8](nan) != 0 { r = r | 64 }
    if !(inf > 1e308) { r = r | 128 }
    if nan == nan { r = r | 256 }
    return r
}

// rule 13: memory nobody initialized holds fixed bytes (never undef)
fn reads_same(p addr) bool {
    x u64 = p[u64]
    y u64 = p[u64]
    return x == y
}

fn fresh_memory() u32 {
    r u32 = 0
    q addr = lib.malloc(64)
    if !reads_same(q) { r = r | 1 }
    a u64 = (q + 8)[u64]
    if a != a { r = r | 2 }
    if (a ^ a) != 0 { r = r | 4 }
    if (a | 1) == 0 { r = r | 8 }
    b u8 = (q + 17)[u8]
    if b != b || zext[u32](b) > 255 { r = r | 16 }
    lib.free(q)
    return r
}

// bool memory: any nonzero byte reads as true
fn bools() u32 {
    r u32 = 0
    i u64 = 0
    while i < 4 {
        b bool = (&BOOLS + i)[bool]
        want bool = volatile_load[u8](&BOOLS + i) != 0
        if b != want { r = r | 1 }
        if !b == want { r = r | 2 }
        if zext[u32](b) > 1 { r = r | 4 }
        i = i + 1
    }
    return r
}

// misaligned plain and atomic accesses happen (A5: not UB)
fn misaligned() u32 {
    r u32 = 0
    p addr = &BYTES + zext[u64](vu32(0))
    p[u64] = 0x0102030405060708
    if p[u64] != 0x0102030405060708 { r = r | 1 }
    if (p + 2)[u32] != 0x03040506 { r = r | 2 }
    q addr = &ACOUNT + zext[u64](vu32(0)) + 2
    atomic_store[u64, relaxed](q, 5)
    old u64 = atomic_add[u64, seq_cst](q, 3)
    if old != 5 { r = r | 4 }
    if atomic_load[u64, acquire](q) != 8 { r = r | 8 }
    if atomic_cas[u64, seq_cst](q, 8, 9) != 8 { r = r | 16 }
    if q[u64] != 9 { r = r | 32 }
    return r
}

// enums: membership is testable without trapping
fn enums() u32 {
    r u32 = 0
    if enum_is[Tok](volatile_load[u8](&U8 + 1) + 2) { r = r | 1 }
    if !enum_is[Tok](volatile_load[u8](&U8 + 1) + 6) { r = r | 2 }
    return r
}

fn main() i32 {
    w u32 = wraps()
    s u32 = shifts()
    v u32 = conversions()
    f u32 = fresh_memory()
    b u32 = bools()
    m u32 = misaligned()
    e u32 = enums()
    c.printf(c"wraps=%u shifts=%u conversions=%u fresh=%u bools=%u misaligned=%u enums=%u\n", w, s, v, f, b, m, e)
    return 0
}
