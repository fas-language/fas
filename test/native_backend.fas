// Differential program for `--backend=native`: prints through `syscall` only,
// so the native build and the LLVM build must print the same bytes.

struct Point { x i32 y i64 tag u8 }
struct Pair { a Point b Point }

var counter u64 = 7
const TABLE arr[5, u32] = {3, 1, 4, 1, 5}
var scratch arr[16, u8] = {}

fn write_str(s addr, n usize) void {
  r i64 = syscall(1, 1, s, n)
}

fn write_u64(x u64) void {
  buf arr[20, u8] = {}
  i usize = 20
  v u64 = x
  while true {
    i = i - 1
    buf[i] = trunc[u8](v % 10) + 48
    v = v / 10
    if v == 0 { break }
  }
  r i64 = syscall(1, 1, &buf[i], 20 - i)
}

fn write_i64(x i64) void {
  if x < 0 {
    write_str("-", 1)
    write_u64(bitcast[u64](0 - x))
  } else {
    write_u64(bitcast[u64](x))
  }
}

fn line(x i64) void {
  write_i64(x)
  write_str("\n", 1)
}

fn sum8(a u64, b u64, c u64, d u64, e u64, f u64, g u64, h u64) u64 {
  return a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f + 7 * g + 8 * h
}

fn sum7(a i32, b i32, c i32, d i32, e i32, f i32, g i32) i64 {
  return sext[i64](a - b + c - d + e - f + g)
}

fn classify(x u64) u64 {
  switch x {
    case 0: { return 100 }
    case 3: { return 300 }
    case 9: { return 900 }
    default: { return x }
  }
}

fn move(p addr, dx i32) void {
  q Point = {}
  copy(q, p[Point])
  q.x = q.x + dx
  q.tag = q.tag + 1
  copy(p[Point], q)
}

fn swap_pair(dst addr, src addr) void {
  p Pair = {}
  copy(p, src[Pair])
  out Pair = {}
  copy(out.a, p.b)
  copy(out.b, p.a)
  copy(dst[Pair], out)
}

fn gcd(a u64, b u64) u64 {
  x u64 = a
  y u64 = b
  while y != 0 {
    t u64 = x % y
    x = y
    y = t
  }
  return x
}

var g8 u8 = 5
var g16 u16 = 1000
var g32 u32 = 70000
var g64 u64 = 5000000000
var cells arr[64, u8] = {}

// Read-modify-write of globals and of indexed memory at every width, with
// indices folded into scaled, displaced address operands.
fn bump(p addr, i usize, k u32) void {
  g8 |= 0x80
  g16 ^= 0xfff0
  g32 &= 0xfffffff0
  g64 += 0x7fffffff
  p[u32, i] += k
  p[u32, i + 1] -= 7
  p[u8, i] ^= trunc[u8](k)
  p[u16, i + 5] |= 0x8001
  p[u64, (i << 1) + 3] &= 0xffffffff0000ffff
  p[u64, (i << 1) + 3] -= 1
}

fn memops() void {
  for i usize = 0; i < 3; i += 1 { bump(&cells, i, trunc[u32](i * 977 + 3)) }
  line(zext[i64](g8))
  line(zext[i64](g16))
  line(zext[i64](g32))
  line(bitcast[i64](g64))
  for i usize = 0; i < 8; i += 1 { q addr = &cells; line(bitcast[i64](q[u64, i])) }
}

// Local arrays: constant indices only (scalar replacement), a runtime index
// (stays in memory), address elements; division by powers of two.
fn arrays(x u64, n usize) void {
  offs arr[4, u64] = {}
  for const k usize in 0..4 { offs[k] = x / 4 + k * x }
  small arr[3, u8] = {}
  small[1] = trunc[u8](x)
  ptrs arr[2, addr] = {}
  t u64 = 0
  for i usize = 0; i < n; i += 1 {
    for const k usize in 0..4 { t += offs[k] ^ i }
  }
  line(bitcast[i64](t))
  line(zext[i64](small[0]) + zext[i64](small[1]) + zext[i64](small[2]))
  if ptrs[1] == null { line(1) } else { line(0) }
  mixed arr[4, u64] = {}
  mixed[0] = 7
  mixed[n & 3] = 9
  line(bitcast[i64](mixed[0] + mixed[1] + mixed[2] + mixed[3]))
  big u64 = 0xffff_ffff_ffff_fff5
  line(bitcast[i64](big / 8))
  line(bitcast[i64](big % 16))
  b8 u8 = 251
  line(zext[i64](b8 / 4))
  line(zext[i64](b8 % 8))
  // Byte accesses sharing base + b: one address, then [q + o]
  q addr = &cells
  o1 usize = n - 4
  o2 usize = n + 2
  o3 usize = n * 2
  for b usize = 0; b < 48; b += 16 {
    q[u8, b + o1] |= 0x11
    q[u8, b + o2] ^= 0x22
    q[u8, o3 + b] += 3
  }
  for i usize = 0; i < 8; i += 1 { line(bitcast[i64](q[u64, i])) }
  // Constant stores of every width, including negative immediates
  q[u8, 1] = 0xfe
  q[u16, 1] = 0xfffd
  q[u32, 1] = 0x8000_0001
  q[i64, 1] = -5
  q[u64, 2] = 0x7fff_ffff
  q[u64, 3] = 0x1_0000_0000
  for i usize = 0; i < 4; i += 1 { line(bitcast[i64](q[u64, i])) }
  // Repeated subexpressions and multiplication by powers of two
  h usize = (n >> 1) - 1
  line(bitcast[i64](((n >> 1) - 1) * 4 + ((n >> 1) - 1) * 2 + h * 8))
  m8 u8 = trunc[u8](x) * 16
  line(zext[i64](m8))
}

// Inlining: several returns, a callee alloca with a runtime index, a call
// in a loop body, nested inline calls and a void callee
fn pick(a u64, b u64, c usize) u64 @inline {
  t arr[4, u64] = {}
  t[c & 3] = a
  if a > b { return t[c & 3] - b }
  if a == b { return 7 }
  return b * 3
}

fn twice(x u64) u64 @inline { return pick(x, 10, 1) + pick(x, 20, 2) }

fn bump_inl(p addr, k usize) void @inline {
  if k == 0 { return }
  p[u64, 0] += k
}

fn inlined(n usize) void {
  s u64 = 0
  for i usize = 0; i < n; i += 1 { s += twice(i) ^ pick(i, n, i) }
  line(bitcast[i64](s))
  cell arr[1, u64] = {}
  for i usize = 0; i < 5; i += 1 { bump_inl(&cell, i) }
  line(bitcast[i64](cell[0]))
}

fn main() i32 {
  write_str("native backend\n", 15)
  memops()
  arrays(1000003, 5)
  inlined(30)
  line(bitcast[i64](sum8(1, 2, 3, 4, 5, 6, 7, 8)))
  line(sum7(10, 20, 30, 40, 50, 60, -70))
  line(bitcast[i64](classify(0) + classify(3) + classify(9) + classify(4)))
  // Signed and unsigned narrow arithmetic
  a i8 = -100
  b i8 = 3
  line(sext[i64](a / b))
  line(sext[i64](a % b))
  line(sext[i64](a >> 2))
  c u8 = 200
  line(zext[i64](c + c))
  line(zext[i64](c >> 3))
  d i16 = -30000
  line(sext[i64](d - 10000))
  line(zext[i64](add_sat(c, c)))
  line(sext[i64](sub_sat(a, b * 20)))
  h u16 = 0xf0f0
  one u32 = 1
  bit u32 = 0x80
  byte u8 = 0x81
  word u32 = 0x12345678
  line(zext[i64](popcount(h)))
  line(zext[i64](clz(one)))
  line(zext[i64](ctz(bit)))
  line(zext[i64](rotl(byte, 1)))
  line(zext[i64](rotr(word, 8)))
  // Structs and memory
  p Point = {}
  p.x = -5
  p.y = 1 << 40
  p.tag = 255
  move(&p, 12)
  line(sext[i64](p.x))
  line(p.y)
  line(zext[i64](p.tag))
  pair Pair = {}
  pair.a.x = 1
  pair.b.x = 2
  swapped Pair = {}
  swap_pair(&swapped, &pair)
  line(sext[i64](swapped.a.x * 10 + swapped.b.x))
  // Globals
  counter = counter * 6
  line(bitcast[i64](counter))
  total u32 = 0
  for i usize = 0; i < 5; i += 1 { total = total + TABLE[i] }
  line(zext[i64](total))
  scratch[3] = 42
  line(zext[i64](scratch[3]) + zext[i64](scratch[4]))
  line(bitcast[i64](gcd(1071, 462)))
  // Comparisons across signedness
  m i32 = -1
  n u32 = 1
  if m < 0 && n > 0 { write_str("cmp ok\n", 7) }
  return 3
}
