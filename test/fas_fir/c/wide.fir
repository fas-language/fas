func @fir_loop_100 (ptr, ptr) -> () global {
^e(%r: ptr, %pa: ptr):
  %a = load i100 %pa, align 8
  jump ^l(%a, i100 0)
^l(%i: i100, %s: i100):
  %z = icmp eq i1 %i, i100 0
  br %z, ^d, ^b
^b:
  %s1 = add i100 %s, %i
  %i1 = sub i100 %i, i100 1
  jump ^l(%i1, %s1)
^d:
  switch %a, ^o, [3: ^t3, 5: ^t5, -1: ^tm]
^t3:
  %m3 = mul i100 %s, i100 3
  jump ^st(%m3)
^t5:
  %m5 = mul i100 %s, i100 5
  jump ^st(%m5)
^tm:
  jump ^st(i100 42)
^o:
  %big = icmp ugt i1 %s, i100 100
  %v = select i100 %big, %s, i100 7
  jump ^st(%v)
^st(%res: i100):
  store %res, %r, align 8
  ret
}
