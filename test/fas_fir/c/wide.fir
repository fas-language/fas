func @fir_loop_256 (ptr, ptr) -> () global {
^e(%r: ptr, %pa: ptr):
  %a = load i256 %pa, align 8
  jump ^l(%a, i256 0)
^l(%i: i256, %s: i256):
  %z = icmp eq i1 %i, i256 0
  br %z, ^d, ^b
^b:
  %s1 = add i256 %s, %i
  %i1 = sub i256 %i, i256 1
  jump ^l(%i1, %s1)
^d:
  switch %a, ^o, [3: ^t3, 5: ^t5, -1: ^tm]
^t3:
  %m3 = mul i256 %s, i256 3
  jump ^st(%m3)
^t5:
  %m5 = mul i256 %s, i256 5
  jump ^st(%m5)
^tm:
  jump ^st(i256 42)
^o:
  %big = icmp ugt i1 %s, i256 100
  %v = select i256 %big, %s, i256 7
  jump ^st(%v)
^st(%res: i256):
  store %res, %r, align 8
  ret
}
