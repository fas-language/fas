func @fir_loop_65 (ptr, ptr) -> () global {
^e(%r: ptr, %pa: ptr):
  %a = load i65 %pa, align 8
  jump ^l(%a, i65 0)
^l(%i: i65, %s: i65):
  %z = icmp eq i1 %i, i65 0
  br %z, ^d, ^b
^b:
  %s1 = add i65 %s, %i
  %i1 = sub i65 %i, i65 1
  jump ^l(%i1, %s1)
^d:
  switch %a, ^o, [3: ^t3, 5: ^t5, -1: ^tm]
^t3:
  %m3 = mul i65 %s, i65 3
  jump ^st(%m3)
^t5:
  %m5 = mul i65 %s, i65 5
  jump ^st(%m5)
^tm:
  jump ^st(i65 42)
^o:
  %big = icmp ugt i1 %s, i65 100
  %v = select i65 %big, %s, i65 7
  jump ^st(%v)
^st(%res: i65):
  store %res, %r, align 8
  ret
}
