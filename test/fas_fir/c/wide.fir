  %i1 = sub i200 %i, i200 1
  jump ^l(%i1, %s1)
^d:
  switch %a, ^o, [3: ^t3, 5: ^t5, -1: ^tm]
^t3:
  %m3 = mul i200 %s, i200 3
  jump ^st(%m3)
^t5:
