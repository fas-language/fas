func @fir_loop_129 (ptr, ptr) -> () global {
^e(%r: ptr, %pa: ptr):
  %a = load i129 %pa, align 8
  jump ^l(%a, i129 0)
^l(%i: i129, %s: i129):
  %z = icmp eq i1 %i, i129 0
  br %z, ^d, ^b
^b:
  %s1 = add i129 %s, %i
  %i1 = sub i129 %i, i129 1
  jump ^l(%i1, %s1)
^d:
  switch %a, ^o, [3: ^t3, 5: ^t5, -1: ^tm]
^t3:
  %m3 = mul i129 %s, i129 3
  jump ^st(%m3)
^t5:
  %m5 = mul i129 %s, i129 5
  jump ^st(%m5)
^tm:
  jump ^st(i129 42)
^o:
  %big = icmp ugt i1 %s, i129 100
  %v = select i129 %big, %s, i129 7
  jump ^st(%v)
^st(%res: i129):
  store %res, %r, align 8
  ret
}
