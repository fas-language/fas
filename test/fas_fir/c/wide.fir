  jump ^st(%m5)
^tm:
  jump ^st(i200 42)
^o:
  %big = icmp ugt i1 %s, i200 100
  %v = select i200 %big, %s, i200 7
  jump ^st(%v)
^st(%res: i200):
  store %res, %r, align 8
  ret
}
