func @fir_loop_128 (ptr, ptr) -> () global {
^e(%r: ptr, %pa: ptr):
  %a = load i128 %pa, align 8
  jump ^l(%a, i128 0)
^l(%i: i128, %s: i128):
  %z = icmp eq i1 %i, i128 0
  br %z, ^d, ^b
^b:
  %s1 = add i128 %s, %i
  %i1 = sub i128 %i, i128 1
  jump ^l(%i1, %s1)
^d:
  switch %a, ^o, [3: ^t3, 5: ^t5, -1: ^tm]
^t3:
  %m3 = mul i128 %s, i128 3
  jump ^st(%m3)
^t5:
  %m5 = mul i128 %s, i128 5
  jump ^st(%m5)
^tm:
  jump ^st(i128 42)
^o:
  %big = icmp ugt i1 %s, i128 100
  %v = select i128 %big, %s, i128 7
  jump ^st(%v)
^st(%res: i128):
  store %res, %r, align 8
  ret
}
