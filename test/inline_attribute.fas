// `@inline` after the signature: LLVM `alwaysinline` on every instance.
fn add3(a u64, b u64, c u64) u64 @inline {
  return a + b + c
}

fn scale[T](x T, k T) T @inline {
  return x * k
}

fn plain(x u64) u64 {
  return x ^ 1
}

fn main() i32 {
  s u64 = add3(1, 2, 3)
  if s != 6 { return 1 }
  if scale(s, 7) != 42 { return 2 }
  if scale[u32](3, 5) != 15 { return 3 }
  if plain(s) != 7 { return 4 }
  return 0
}
