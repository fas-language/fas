// Differential vector program for `--backend=native`: the native build and
// the LLVM build must print the same bytes. Inputs come from tables indexed
// at run time so that most work happens in the generated code, not in
// constant folding.

const SEED arr[16, u64] = {
  0x0123456789abcdef, 0xfedcba9876543210, 0x8000000000000000, 0x7fffffffffffffff,
  0x00000000ffffffff, 0xffffffff00000000, 0x0000000000000001, 0xffffffffffffffff,
  0x5555555555555555, 0xaaaaaaaaaaaaaaaa, 0x00ff00ff00ff00ff, 0x8080808080808080,
  0x0000000000000000, 0x1234000000005678, 0x7f7f7f7f80808080, 0x0102030405060708
}

fn write_hex(x u64) void {
  buf arr[17, u8] = {}
  for i usize = 0; i < 16; i += 1 {
    d u8 = trunc[u8]((x >> (60 - 4 * i)) & 15)
    if d < 10 { buf[i] = d + 48 } else { buf[i] = d + 87 }
  }
  buf[16] = 10
  r i64 = syscall(1, 1, &buf[0], 17)
}

fn mix(h u64, x u64) u64 { return (h ^ x) * 0x100000001b3 }

fn hash64(h u64, v vec[2, u64]) u64 { return mix(mix(h, v[0]), v[1]) }

fn seed(i usize) u64 { return SEED[i & 15] }

fn v8(i usize) vec[8, u8] { return bitcast[vec[8, u8]](seed(i)) }
fn v16(i usize) vec[4, u16] { return bitcast[vec[4, u16]](seed(i)) }
fn v32(i usize) vec[4, u32] { return bitcast[vec[4, u32]](v64(i)) }
fn v64(i usize) vec[2, u64] { return {seed(i), seed(i + 1)} }

fn flag(c bool) u64 {
  if c { return 1 }
  return 0
}

fn mask_bits(m vec[8, bool]) u64 { return zext[u64](bitcast[u8](m)) }

fn ints8(i usize, j usize) u64 {
  a vec[8, u8] = v8(i)
  b vec[8, u8] = v8(j)
  sa vec[8, i8] = bitcast[vec[8, i8]](a)
  sb vec[8, i8] = bitcast[vec[8, i8]](b)
  h u64 = 0
  h = mix(h, bitcast[u64](a + b))
  h = mix(h, bitcast[u64](a - b))
  h = mix(h, bitcast[u64](a * b))
  h = mix(h, bitcast[u64](a & b))
  h = mix(h, bitcast[u64](a | b))
  h = mix(h, bitcast[u64](a ^ b))
  h = mix(h, bitcast[u64](~a))
  h = mix(h, bitcast[u64](a >> 3))
  h = mix(h, bitcast[u64](a << 5))
  h = mix(h, bitcast[u64](sa >> 2))
  h = mix(h, bitcast[u64](-sa))
  h = mix(h, mask_bits(a < b))
  h = mix(h, mask_bits(sa < sb))
  h = mix(h, mask_bits(a == b))
  h = mix(h, mask_bits(sa >= sb))
  h = mix(h, bitcast[u64](select(a > b, a, b)))
  h = mix(h, bitcast[u64](add_sat(a, b)))
  h = mix(h, bitcast[u64](sub_sat(a, b)))
  h = mix(h, bitcast[u64](add_sat(sa, sb)))
  h = mix(h, bitcast[u64](sub_sat(sa, sb)))
  h = mix(h, bitcast[u64](mul_hi(a, b)))
  h = mix(h, bitcast[u64](mul_hi(sa, sb)))
  h = mix(h, bitcast[u64](rotl(a, 3)))
  h = mix(h, bitcast[u64](rotr(a, 5)))
  h = mix(h, bitcast[u64](popcount(a)))
  h = mix(h, bitcast[u64](clz(a)))
  h = mix(h, bitcast[u64](ctz(a)))
  h = mix(h, zext[u64](reduce_sum(a)))
  h = mix(h, zext[u64](reduce_xor(a)))
  h = mix(h, zext[u64](reduce_and(a)))
  h = mix(h, zext[u64](reduce_or(a)))
  h = mix(h, zext[u64](reduce_min(a)))
  h = mix(h, zext[u64](reduce_max(a)))
  h = mix(h, zext[u64](bitcast[u8](reduce_min(sa))))
  h = mix(h, zext[u64](bitcast[u8](reduce_max(sa))))
  h = mix(h, flag(any(a > b)))
  h = mix(h, flag(all(a >= splat(1))))
  return h
}

fn ints_wide(i usize, j usize) u64 {
  a vec[4, u16] = v16(i)
  b vec[4, u16] = v16(j)
  c vec[4, u32] = v32(i)
  d vec[4, u32] = v32(j)
  e vec[2, u64] = v64(i)
  f vec[2, u64] = v64(j)
  sc vec[4, i32] = bitcast[vec[4, i32]](c)
  sd vec[4, i32] = bitcast[vec[4, i32]](d)
  se vec[2, i64] = bitcast[vec[2, i64]](e)
  h u64 = 0
  h = mix(h, bitcast[u64](a * b + splat(7)))
  h = mix(h, bitcast[u64](mul_hi(a, b)))
  h = mix(h, bitcast[u64](a >> (b & splat(15))))
  h = hash64(h, bitcast[vec[2, u64]](c * d))
  h = hash64(h, bitcast[vec[2, u64]](c >> (d & splat(31))))
  h = hash64(h, bitcast[vec[2, u64]](sc >> (d & splat(31))))
  h = hash64(h, bitcast[vec[2, u64]](mul_hi(c, d)))
  h = hash64(h, bitcast[vec[2, u64]](mul_hi(sc, sd)))
  h = hash64(h, bitcast[vec[2, u64]](select(sc < sd, c, d)))
  h = hash64(h, bitcast[vec[2, u64]](rotl(c, 7)))
  h = hash64(h, bitcast[vec[2, u64]](popcount(c) + clz(d) + ctz(c)))
  h = hash64(h, e * f + splat(11))
  h = hash64(h, e >> (f & splat(63)))
  h = hash64(h, bitcast[vec[2, u64]](se >> 9))
  h = hash64(h, mul_hi(e, f))
  h = hash64(h, rotr(e, 13))
  h = hash64(h, select(e == f, e, ~f))
  h = mix(h, reduce_sum(e))
  h = mix(h, zext[u64](reduce_sum(c)))
  h = mix(h, zext[u64](reduce_max(d)))
  h = mix(h, bitcast[u64](zext[i64](bitcast[u32](reduce_min(sc)))))
  // Width changes
  w vec[4, u64] = zext[vec[4, u64]](a)
  h = mix(h, w[0] + w[1] * 3 + w[2] * 5 + w[3] * 7)
  x vec[4, i64] = sext[vec[4, i64]](sc)
  h = mix(h, bitcast[u64](x[0] ^ x[1] ^ x[2] ^ x[3]))
  n vec[4, u8] = trunc[vec[4, u8]](c)
  h = mix(h, zext[u64](bitcast[u32](n)))
  return h
}

fn shuffles(i usize, j usize) u64 {
  a vec[4, u32] = v32(i)
  b vec[4, u32] = v32(j)
  h u64 = 0
  h = hash64(h, bitcast[vec[2, u64]](shuffle(a, b, {3, 2, 1, 0})))
  h = hash64(h, bitcast[vec[2, u64]](shuffle(a, b, {7, 0, 5, 2})))
  r vec[6, u32] = shuffle(a, b, {3, 2, 1, 0, 4, 7})
  h = mix(h, zext[u64](r[4]) + zext[u64](r[5]))
  idx vec[4, u32] = b & splat(3)
  h = hash64(h, bitcast[vec[2, u64]](permute(a, idx)))
  // Runtime lane indices, reads and writes
  k usize = j & 3
  h = mix(h, zext[u64](a[k]))
  c vec[4, u32] = a
  c[k] = 99
  c[(k + 1) & 3] += 5
  h = hash64(h, bitcast[vec[2, u64]](c))
  m vec[4, bool] = a > b
  h = hash64(h, bitcast[vec[2, u64]](compress(a, m)))
  return h
}

fn floats(i usize, j usize) u64 {
  a vec[4, f32] = cvt[vec[4, f32]](bitcast[vec[4, i32]](v32(i)) >> 8)
  b vec[4, f32] = cvt[vec[4, f32]](bitcast[vec[4, i32]](v32(j)) >> 12)
  c vec[2, f64] = cvt[vec[2, f64]](bitcast[vec[2, i64]](v64(i)) >> 20)
  d vec[2, f64] = cvt[vec[2, f64]](bitcast[vec[2, i64]](v64(j)) >> 24)
  h u64 = 0
  h = hash64(h, bitcast[vec[2, u64]](a + b))
  h = hash64(h, bitcast[vec[2, u64]](a * b - a))
  h = hash64(h, bitcast[vec[2, u64]](a / (abs(b) + splat(1.0))))
  h = hash64(h, bitcast[vec[2, u64]](-a))
  h = hash64(h, bitcast[vec[2, u64]](sqrt(abs(a))))
  h = hash64(h, bitcast[vec[2, u64]](floor(a / splat(3.0))))
  h = hash64(h, bitcast[vec[2, u64]](select(a < b, a, b)))
  h = mix(h, flag(any(a < b)) + 2 * flag(all(a < b)))
  h = hash64(h, bitcast[vec[2, u64]](c + d))
  h = hash64(h, bitcast[vec[2, u64]](c * d))
  h = hash64(h, bitcast[vec[2, u64]](sqrt(abs(c))))
  h = hash64(h, bitcast[vec[2, u64]](cvt[vec[2, i64]](d)))
  h = hash64(h, bitcast[vec[2, u64]](cvt[vec[4, i32]](a)))
  h = hash64(h, bitcast[vec[2, u64]](cvt[vec[2, f64]](cvt[vec[2, f32]](c))))
  h = mix(h, bitcast[u64](c[0] + c[1]))
  return h
}

fn bools(i usize, j usize) u64 {
  a vec[16, u8] = bitcast[vec[16, u8]](v64(i))
  b vec[16, u8] = bitcast[vec[16, u8]](v64(j))
  m vec[16, bool] = a < b
  n vec[16, bool] = a == b
  h u64 = 0
  h = mix(h, zext[u64](bitcast[u16](m)))
  h = mix(h, zext[u64](bitcast[u16](m & !n)))
  h = mix(h, zext[u64](bitcast[u16](m | n)))
  h = mix(h, zext[u64](bitcast[u16](m ^ n)))
  h = mix(h, flag(any(m)) + 2 * flag(all(m | !n)))
  // Bool vectors through memory
  store arr[4, vec[16, bool]] = {}
  store[j & 3] = m
  store[(j + 1) & 3] = n
  h = mix(h, zext[u64](bitcast[u16](store[j & 3])))
  h = mix(h, zext[u64](bitcast[u16](store[(j + 1) & 3] ^ store[j & 3])))
  back vec[16, bool] = bitcast[vec[16, bool]](trunc[u16](seed(i)))
  h = mix(h, zext[u64](bitcast[u16](back & m)))
  h = mix(h, zext[u64](select(m, a, b)[3]))
  return h
}

struct Particle { pos vec[4, f32] tag u32 vel vec[4, f32] }

fn step(p addr, dt f32) void {
  p[Particle].pos = p[Particle].pos + p[Particle].vel * splat(dt)
  p[Particle].vel = p[Particle].vel * splat(0.5) + splat(1.0)
}

fn add4(a vec[4, u64], b vec[4, u64]) vec[4, u64] { return a + b }

// Vector phis, memory, struct fields and calls in loops
fn loops() void {
  acc vec[4, u64] = splat(0)
  x vec[4, u64] = {1, 2, 3, 4}
  for i usize = 0; i < 100; i += 1 {
    x = (x * splat(0x5deece66d) + splat(11)) & splat(0xffffffffffff)
    acc = add4(acc, x ^ (x >> 17))
  }
  write_hex(acc[0] ^ acc[1] ^ acc[2] ^ acc[3])
  // Unaligned vector loads and stores through addresses
  buf arr[64, u8] = {}
  for i usize = 0; i < 64; i += 1 { buf[i] = trunc[u8](i * 37 + 5) }
  s vec[4, u32] = splat(0)
  for i usize = 0; i + 16 <= 64; i += 3 {
    v vec[4, u32] = (&buf[i])[vec[4, u32]]
    s ^= v * splat(3)
    (&buf[i])[vec[4, u32]] = v + splat(1)
  }
  write_hex(bitcast[vec[2, u64]](s)[0] ^ bitcast[vec[2, u64]](s)[1])
  write_hex((&buf[0])[u64] ^ (&buf[56])[u64])
  // Arrays of vectors with runtime indices
  table arr[8, vec[2, u64]] = {}
  for i usize = 0; i < 8; i += 1 { table[i] = v64(i) }
  t vec[2, u64] = splat(0)
  for i usize = 0; i < 32; i += 1 { t = t + table[(i * 5) & 7] }
  write_hex(t[0] ^ t[1])
  p Particle = {}
  p.pos = {1.0, 2.0, 3.0, 4.0}
  p.vel = {0.5, -0.5, 0.25, -0.25}
  p.tag = 7
  for i usize = 0; i < 50; i += 1 { step(&p, 0.125) }
  write_hex(bitcast[vec[2, u64]](p.pos)[0] ^ bitcast[vec[2, u64]](p.vel)[1] ^ zext[u64](p.tag))
}

// Masked tails: lanes past the end are neither read nor written
fn masked(n usize) u64 {
  src arr[11, u32] = {}
  dst arr[11, u32] = {}
  for i usize = 0; i < 11; i += 1 { src[i] = trunc[u32](seed(i)) }
  i usize = 0
  while n - i >= 8 {
    (&dst[i])[vec[8, u32]] = (&src[i])[vec[8, u32]] * splat(3)
    i += 8
  }
  if n - i > 0 {
    r usize = n - i
    mask vec[8, bool] = {r > 0, r > 1, r > 2, r > 3, r > 4, r > 5, r > 6, r > 7}
    v vec[8, u32] = masked_load[u32](&src[i], mask, splat(5))
    masked_store[u32](&dst[i], mask, v + splat(1))
  }
  h u64 = 0
  for k usize = 0; k < 11; k += 1 { h = mix(h, zext[u64](dst[k])) }
  return h
}

// Demanded bits: inner masks that the outer mask makes redundant, and ones
// it does not (a wider use, a too-narrow mask, a right shift); an inlined
// vector helper with a scalar splat inside a loop
fn lcg_step(v vec[4, u64]) vec[4, u64] {
  s vec[4, u64] = ((v >> 16) ^ splat(0x5deece66d)) & splat(0xffffffffffff)
  return ((s * splat(0x5deece66d) + splat(11)) & splat(0xffffffffffff)) >> 7
}

fn masks(i usize, j usize) u64 {
  x u64 = seed(i) ^ seed(j + 3)
  a u64 = ((x & 0xffffffffffff) * 0x5deece66d + 11) & 0xffffffffffff
  w u64 = x & 0xffffffffff
  b u64 = ((w * 0x5deece66d) & 0xffffffffffff) ^ (w >> 3)
  c u64 = (((x & 0xffff) << 8) + x) & 0xffffff
  d u64 = ((x & 0xffffffffffff) >> 4) & 0xfff
  v vec[4, u64] = {seed(i), seed(j), seed(i + j), seed(i ^ j)}
  acc vec[4, u64] = splat(0)
  for k u64 = 0; k < 5; k += 1 {
    bit u64 = zext[u64](1) << (k ^ x & 31)
    v = lcg_step(v)
    acc |= (splat(0) - (v & splat(1))) & splat(bit)
  }
  return a ^ b ^ (c << 1) ^ (d << 2) ^ acc[0] ^ acc[1] ^ acc[2] ^ acc[3]
}

// SSE2 chunk mode: whole-function vector code on 128-bit pieces
fn vrot(v vec[4, u64], k u64) vec[4, u64] { return (v << k) | (v >> (64 - k)) }

fn chunks(i usize, j usize) u64 {
  a vec[2, u64] = v64(i)
  b vec[2, u64] = v64(j)
  w vec[4, u64] = {seed(i), seed(j), seed(i + 3), seed(j + 5)}
  h u64 = 0
  for k usize = 0; k < 6; k += 1 {
    a = a * splat(0x5deece66d) + b
    b = (b ^ (a >> 13)) * splat(0x9e3779b97f4a7c15)
    w = vrot(w * splat(0xff51afd7) ^ splat(seed(k)), 7 + k)
    w = w - (w >> (k + 3))
  }
  h = hash64(h, a)
  h = hash64(h, b)
  h = mix(mix(mix(mix(h, w[0]), w[1]), w[2]), w[3])
  x vec[4, u32] = bitcast[vec[4, u32]](a)
  y vec[4, u32] = bitcast[vec[4, u32]](b)
  sx vec[4, i32] = bitcast[vec[4, i32]](x ^ y)
  z vec[4, u32] = (x + y) ^ (x - y) & (x | y)
  z = (z << 3) ^ (z >> 5) ^ bitcast[vec[4, u32]](sx >> 9)
  z[2] = trunc[u32](seed(i + j))
  h = hash64(h, bitcast[vec[2, u64]](z))
  p vec[8, u16] = bitcast[vec[8, u16]](a ^ b)
  q vec[8, u16] = bitcast[vec[8, u16]](z)
  r vec[8, u16] = p * q + (p >> 2) - (q << 1)
  sr vec[8, i16] = bitcast[vec[8, i16]](r) >> 3
  r[5] = trunc[u16](seed(i))
  h = hash64(h, bitcast[vec[2, u64]](r))
  h = hash64(h, bitcast[vec[2, u64]](sr))
  h = mix(h, zext[u64](r[1]) ^ zext[u64](q[6]) ^ zext[u64](x[3]))
  bs vec[16, u8] = bitcast[vec[16, u8]](a) + bitcast[vec[16, u8]](b)
  bs = bs ^ bitcast[vec[16, u8]](z) & splat(trunc[u8](seed(j)))
  h = hash64(h, bitcast[vec[2, u64]](bs))
  h = mix(h, zext[u64](bs[0]) ^ zext[u64](bs[9]) << 8 ^ zext[u64](bs[15]) << 16)
  t arr[4, vec[2, u64]] = {}
  for k usize = 0; k < 4; k += 1 { t[k] = a + splat(k) }
  s vec[2, u64] = splat(0)
  for k usize = 0; k < 9; k += 1 { s = s ^ t[(k * 3 + i) & 3] }
  h = hash64(h, s)
  m vec[2, u64] = a * splat(0xffffffff) + b * splat(0x100000001)
  h = hash64(h, m)
  return h
}

fn main() i32 {
  for n usize = 0; n <= 11; n += 1 { write_hex(masked(n)) }
  for i usize = 0; i < 16; i += 1 {
    h u64 = 0
    for j usize = 0; j < 16; j += 1 {
      h = mix(h, ints8(i, j))
      h = mix(h, ints_wide(i, j))
      h = mix(h, shuffles(i, j))
      h = mix(h, floats(i, j))
      h = mix(h, bools(i, j))
      h = mix(h, masks(i, j))
      h = mix(h, chunks(i, j))
    }
    write_hex(h)
  }
  loops()
  return 0
}
