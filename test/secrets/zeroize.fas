// Zeroization at return (LANGUAGE.md "Secrets"): `work` handles a secret
// key and leaves none of it in its frame, the red zone or a caller-saved
// register; `work_public` does the same work on a public key, and its
// leftovers prove the probe can see them. zeroize.c calls both from inline
// asm and scans the stack below its own rsp and every register.
use "C" "zeroize.h" as c

// public and non-leaf: values live across its own calls take callee-saved
// registers, which its prologue pushes (below the caller's frame)
fn spin(n u64) u64 {
    if n == 0 { return 1 }
    a u64 = n * 3
    b u64 = spin(n - 1)
    d u64 = spin(n - 1)
    return a + b + d
}

extern "C" {
    fn work(k secret[u64]) u64 {
        buf arr[16, secret[u64]] = {}
        for i u64 = 0; i < 16; i += 1 {
            buf[i] = k + i
        }
        acc secret[u64] = 0
        for i u64 = 0; i < 16; i += 1 {
            acc = acc ^ rotl(buf[i], 7)
            acc = acc + spin(2)         // acc and k live across the call
        }
        return declassify(acc + k) & 0
    }

    fn work_public(k u64) u64 {
        buf arr[16, u64] = {}
        for i u64 = 0; i < 16; i += 1 {
            buf[i] = k + i
        }
        acc u64 = 0
        for i u64 = 0; i < 16; i += 1 {
            acc = acc ^ rotl(buf[i], 7)
            acc = acc + spin(2)
        }
        return (acc + k) & 0
    }
}

fn main() i32 {
    return c.probe()
}
