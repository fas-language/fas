use "C" <pthread.h> as c
use "C" <stdlib.h> as c
use "split_worker.fas"
fn main() i32 {
  first c.pthread_t
  second c.pthread_t
  if c.pthread_create(&first, null, &split_worker, null) != 0 { c.abort() }
  if c.pthread_join(first, null) != 0 { c.abort() }
  if c.pthread_create(&second, null, &split_worker, null) != 0 { c.abort() }
  if c.pthread_join(second, null) != 0 { c.abort() }
  return split_calls()
}
