// Linker scripts (Linker_script) and the sysroot (Sysroot). The script
// grammar is the deliberately bounded implicit input-script grammar of the
// glibc sysroot: INPUT, GROUP, AS_NEEDED, OUTPUT_FORMAT(elf64-x86-64) and
// SEARCH_DIR. Unknown commands are errors, never silently ignored. The
// lexer mirrors the OCaml one token for token: a diagnostic names the
// byte the cursor was at when it was raised.

// ---------- sysroot ----------


// Sysroot.validate
fn root_validate(path Bytes) void fails {
    if path.n > 65536 || bytes_contains(path, 0) { try input_die_c(c"invalid or oversized sysroot/search path") }
}

// the lexical normalization of an absolute path when it does not exist
fn path_simplify(p Bytes, out handle[Buf]) void {
    parts Vec[Bytes] = {}
    i u64 = 0
    while i <= p.n {
        j u64 = i
        while j < p.n && p.p[u8, j] != 47 { j += 1 }
        seg Bytes = bytes(p.p + i, j - i)
        if seg.n == 0 || bytes_is(seg, c".") {
        } else if bytes_is(seg, c"..") {
            if parts.n != 0 { vec_pop(&parts) }
        } else {
            vec_push(&parts, seg)
        }
        i = j + 1
    }
    bs(out, c"/")
    for k u64 in 0..parts.n {
        if k != 0 { bs(out, c"/") }
        bb(out, vec_get(&parts, k))
    }
    vec_free(&parts)
}

// Sysroot.normalize of --sysroot
fn sysroot_normalize(path Bytes) void fails {
    try root_validate(path)
    if path.n == 0 { return }
    full Buf = {}
    fh handle[Buf] = &full
    if path_is_relative(path) {
        cwd arr[4096, u8] = {}
        n usize = os_getcwd(&cwd, 4096) catch e {
            try input_die_io(c"getcwd", bytes_empty(), e)
            return
        }
        // the kernel's length counts the terminating NUL
        if n != 0 && cwd[n - 1] == 0 { n -= 1 }
        path_concat(fh, bytes(&cwd, n), path)
    } else {
        bb(fh, path)
    }
    out Buf = {}
    oh handle[Buf] = &out
    path_realpath(buf_cstr(fh), oh) catch e {
        if e == NotFound || e == NotDir {
            buf_clear(oh)
            path_simplify(buf_bytes(fh), oh)
        } else {
            try input_die_io(c"realpath", nul_dup(fh.p, fh.n), e)
        }
    }
    ld.sysroot = nul_dup(oh.p, oh.n)
    try root_validate(ld.sysroot)
    ld.has_root = true
}

// Sysroot.prefixed: the path after "=" or "$SYSROOT", or false
fn root_prefixed(path Bytes, suffix handle[Bytes]) bool {
    if bytes_prefix(path, c"=") {
        suffix.p = path.p + 1
        suffix.n = path.n - 1
        return true
    }
    if bytes_prefix(path, c"$SYSROOT") {
        suffix.p = path.p + 8
        suffix.n = path.n - 8
        return true
    }
    return false
}

// Sysroot.target: root ^ path
fn root_target(path Bytes) Bytes fails {
    try root_validate(path)
    if !ld.has_root { return nul_dup(path.p, path.n) }
    b Buf = {}
    bb(&b, ld.sysroot)
    bb(&b, path)
    r Bytes = nul_dup(b.p, b.n)
    buf_free(&b)
    try root_validate(r)
    return r
}

// Sysroot.directory: a -L or SEARCH_DIR path
fn root_directory(path Bytes) Bytes fails {
    try root_validate(path)
    suffix Bytes = {}
    if !root_prefixed(path, &suffix) { return path }
    if !ld.has_root { return nul_dup(suffix.p, suffix.n) }
    i u64 = 0
    while i < suffix.n && suffix.p[u8, i] == 47 { i += 1 }
    b Buf = {}
    path_concat(&b, ld.sysroot, bytes(suffix.p + i, suffix.n - i))
    r Bytes = nul_dup(b.p, b.n)
    buf_free(&b)
    try root_validate(r)
    return r
}

// Sysroot.contains
fn root_contains(canonical Bytes) bool {
    if !ld.has_root { return false }
    if bytes_is(ld.sysroot, c"/") { return true }
    if bytes_eq(canonical, ld.sysroot) { return true }
    return canonical.n > ld.sysroot.n && bytes_starts_with(canonical, ld.sysroot) && canonical.p[u8, ld.sysroot.n] == 47
}

// the Resolver's add_directory
fn add_directory(path Bytes) void fails {
    if ld.ldirs.n >= 4096 { try input_die_c(c"library search exceeds 4096 directories") }
    vec_push(&ld.ldirs, try root_directory(path))
}

// ---------- the lexer ----------

const T_WORD u8 = 0
const T_LEFT u8 = 1
const T_RIGHT u8 = 2
const T_COMMA u8 = 3
const T_SEMI u8 = 4
const T_END u8 = 5

struct Lex {
    path Bytes
    d addr
    n u64
    cursor u64
    tokens u64
    kind u8         // the lookahead token
    word Bytes      // its text, NUL-terminated
}

fn lfail2(l handle[Lex], text addr, extra Bytes) void fails {
    m handle[Buf] = msg()
    bb(m, l.path)
    bs(m, c": linker script byte ")
    bu(m, l.cursor)
    bs(m, c": ")
    bs(m, text)
    bb(m, extra)
    try input_die()
}

fn lfail(l handle[Lex], text addr) void fails { try lfail2(l, text, bytes_empty()) }

fn lstarts(l handle[Lex], a u8, b u8) bool {
    return l.cursor + 2 <= l.n && l.d[u8, l.cursor] == a && l.d[u8, l.cursor + 1] == b
}

fn lspace(l handle[Lex]) void fails {
    while l.cursor < l.n {
        c u8 = l.d[u8, l.cursor]
        if c == 32 || c == 10 || c == 13 || c == 9 {
            l.cursor += 1
        } else if c == 35 {
            while l.cursor < l.n && l.d[u8, l.cursor] != 10 { l.cursor += 1 }
        } else if c == 47 && lstarts(l, 47, 42) {
            l.cursor += 2
            while l.cursor < l.n && !lstarts(l, 42, 47) { l.cursor += 1 }
            if l.cursor == l.n { try lfail(l, c"unterminated comment") }
            l.cursor += 2
        } else {
            return
        }
    }
}

fn ldelim(c u8) bool {
    return c == 32 || c == 10 || c == 13 || c == 9 || c == 40 || c == 41 || c == 44 || c == 59 || c == 34 || c == 39
}

fn lnext(l handle[Lex]) void fails {
    try lspace(l)
    l.tokens += 1
    if l.tokens > 100000 { try lfail(l, c"token count exceeds 100000") }
    l.word = bytes_empty()
    if l.cursor == l.n {
        l.kind = T_END
        return
    }
    c u8 = l.d[u8, l.cursor]
    l.cursor += 1
    if c == 40 {
        l.kind = T_LEFT
    } else if c == 41 {
        l.kind = T_RIGHT
    } else if c == 44 {
        l.kind = T_COMMA
    } else if c == 59 {
        l.kind = T_SEMI
    } else if c == 34 || c == 39 {
        text Buf = {}
        while l.cursor < l.n && l.d[u8, l.cursor] != c {
            if l.d[u8, l.cursor] == 92 {
                l.cursor += 1
                if l.cursor == l.n { try lfail(l, c"unterminated quoted escape") }
            }
            buf_u8(&text, l.d[u8, l.cursor])
            l.cursor += 1
        }
        if l.cursor == l.n { try lfail(l, c"unterminated quoted filename") }
        l.cursor += 1
        l.kind = T_WORD
        l.word = nul_dup(text.p, text.n)
        buf_free(&text)
    } else {
        start u64 = l.cursor - 1
        while l.cursor < l.n && !ldelim(l.d[u8, l.cursor]) && !lstarts(l, 47, 42) { l.cursor += 1 }
        l.kind = T_WORD
        l.word = nul_dup(l.d + start, l.cursor - start)
    }
}

fn lexpect(l handle[Lex], kind u8) void fails {
    if l.kind != kind { try lfail(l, c"unexpected token") }
    try lnext(l)
}

fn lword(l handle[Lex], s addr) bool { return l.kind == T_WORD && bytes_is(l.word, s) }

// ---------- the parser ----------

// the commands, flattened: INPUT/GROUP/AS_NEEDED open a list that END
// closes
const SC_INPUT u8 = 0
const SC_GROUP u8 = 1
const SC_AS_NEEDED u8 = 2
const SC_END u8 = 3
const SC_FILE u8 = 4
const SC_SEARCH u8 = 5

struct SCmd {
    kind u8
    text Bytes
}

fn scmd(out handle[Vec[SCmd]], kind u8, text Bytes) void {
    e handle[SCmd] = vec_add(out)
    e.kind = kind
    e.text = text
}

fn script_items(l handle[Lex], out handle[Vec[SCmd]], depth u64) void fails {
    if depth > 16 { try lfail(l, c"AS_NEEDED nesting exceeds 16") }
    while true {
        if l.kind == T_RIGHT {
            try lnext(l)
            scmd(out, SC_END, bytes_empty())
            return
        }
        if l.kind == T_END { try lfail(l, c"missing closing parenthesis") }
        if l.kind == T_COMMA {
            try lnext(l)
        } else if lword(l, c"AS_NEEDED") {
            try lnext(l)
            try lexpect(l, T_LEFT)
            scmd(out, SC_AS_NEEDED, bytes_empty())
            try script_items(l, out, depth + 1)
        } else if l.kind == T_WORD {
            name Bytes = l.word
            if name.n == 0 || name.n > 65535 || bytes_contains(name, 0) { try lfail(l, c"invalid or oversized filename") }
            try lnext(l)
            scmd(out, SC_FILE, name)
        } else {
            try lfail(l, c"expected input filename")
        }
    }
}

// Linker_script.parse
fn script_parse(path Bytes, data Bytes, out handle[Vec[SCmd]]) void fails {
    if data.n > 4 * 1024 * 1024 {
        m handle[Buf] = msg()
        bb(m, path)
        bs(m, c": script exceeds 4 MiB")
        try input_die()
    }
    lex Lex = {}
    l handle[Lex] = &lex
    l.path = path
    l.d = data.p
    l.n = data.n
    try lnext(l)
    while l.kind != T_END {
        if l.kind == T_SEMI {
            try lnext(l)
        } else if lword(l, c"INPUT") || lword(l, c"GROUP") {
            kind u8 = if bytes_is(l.word, c"INPUT") { SC_INPUT } else { SC_GROUP }
            try lnext(l)
            try lexpect(l, T_LEFT)
            scmd(out, kind, bytes_empty())
            try script_items(l, out, 0)
        } else if lword(l, c"OUTPUT_FORMAT") {
            try lnext(l)
            try lexpect(l, T_LEFT)
            if !lword(l, c"elf64-x86-64") { try lfail(l, c"only OUTPUT_FORMAT(elf64-x86-64) is supported") }
            try lnext(l)
            try lexpect(l, T_RIGHT)
        } else if lword(l, c"SEARCH_DIR") {
            try lnext(l)
            try lexpect(l, T_LEFT)
            if l.kind != T_WORD || l.word.n == 0 || bytes_contains(l.word, 0) { try lfail(l, c"expected search directory") }
            if l.word.n > 65535 { try lfail(l, c"oversized search directory") }
            dir Bytes = l.word
            try lnext(l)
            try lexpect(l, T_RIGHT)
            scmd(out, SC_SEARCH, dir)
        } else if l.kind == T_WORD {
            try lfail2(l, c"unsupported command ", l.word)
        } else {
            try lfail(l, c"expected INPUT, GROUP, OUTPUT_FORMAT or SEARCH_DIR")
        }
    }
}

// ---------- script inputs (Resolver.prepare) ----------

// the file a script names
fn script_locate(path Bytes, canonical Bytes, name Bytes) Bytes fails {
    if bytes_prefix(name, c"-l") {
        return try library_find(bytes(name.p + 2, name.n - 2), library_dynamic(), &ld.ldirs)
    }
    cands Vec[Bytes] = {}
    suffix Bytes = {}
    if root_prefixed(name, &suffix) {
        vec_push(&cands, try root_target(suffix))
    } else {
        try root_validate(name)
        if !path_is_relative(name) {
            vec_push(&cands, if root_contains(canonical) { try root_target(name) } else { name })
        } else {
            b Buf = {}
            path_concat(&b, path_dirname(path), name)
            vec_push(&cands, nul_dup(b.p, b.n))
            vec_push(&cands, name)
            for k u64 in 0..ld.ldirs.n {
                buf_clear(&b)
                path_concat(&b, vec_get(&ld.ldirs, k), name)
                vec_push(&cands, nul_dup(b.p, b.n))
            }
            buf_free(&b)
        }
    }
    for k u64 in 0..cands.n {
        candidate Bytes = vec_get(&cands, k)
        if try lib_exists(candidate) {
            vec_free(&cands)
            return candidate
        }
    }
    m handle[Buf] = msg()
    bb(m, path)
    bs(m, c": cannot find script input ")
    bb(m, name)
    try input_die()
    return name
}

// the items of one list, from cmds[i] to its END; the index after it
fn script_walk(cmds handle[Vec[SCmd]], i u64, path Bytes, canonical Bytes, whole bool, as_needed bool, depth u64, scripts handle[Vec[Bytes]]) u64 fails {
    while true {
        e handle[SCmd] = vec_at(cmds, i)
        if e.kind == SC_END { return i + 1 }
        if e.kind == SC_FILE {
            try read_input(try script_locate(path, canonical, e.text), whole, as_needed, depth + 1, scripts)
            i += 1
        } else {
            i = try script_walk(cmds, i + 1, path, canonical, whole, true, depth, scripts)
        }
    }
    return i
}

// a script input: its commands become inputs in place of the script
fn script_input(path Bytes, data Bytes, whole bool, as_needed bool, depth u64, scripts handle[Vec[Bytes]]) void fails {
    if depth >= 16 {
        m handle[Buf] = msg()
        bb(m, path)
        bs(m, c": script nesting exceeds 16")
        try input_die()
    }
    real Buf = {}
    ld_realpath(path, &real) catch e { try input_die_io(c"realpath", path, e) }
    canonical Bytes = nul_dup(real.p, real.n)
    buf_free(&real)
    for k u64 in 0..scripts.n {
        if bytes_eq(vec_get(scripts, k), canonical) {
            m handle[Buf] = msg()
            bb(m, path)
            bs(m, c": cyclic linker script")
            try input_die()
        }
    }
    stat_add(ST_LINKER_SCRIPTS, 1)
    cmds Vec[SCmd] = {}
    try script_parse(path, data, &cmds)
    if !config().nostdlib {
        for k u64 in 0..cmds.n {
            e handle[SCmd] = vec_at(&cmds, k)
            if e.kind == SC_SEARCH { try add_directory(e.text) }
        }
    }
    vec_push(scripts, canonical)
    i u64 = 0
    while i < cmds.n {
        e handle[SCmd] = vec_at(&cmds, i)
        if e.kind == SC_SEARCH {
            i += 1
        } else if e.kind == SC_GROUP {
            g u64 = ld.pnodes.n
            pnode_add(P_GROUP, 0)
            i = try script_walk(&cmds, i + 1, path, canonical, whole, as_needed, depth, scripts)
            vec_at(&ld.pnodes, g).count = trunc[u32](ld.pnodes.n - g - 1)
        } else {
            i = try script_walk(&cmds, i + 1, path, canonical, whole, as_needed, depth, scripts)
        }
    }
    vec_pop(scripts)
    vec_free(&cmds)
}
