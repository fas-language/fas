// The ELF64 x86-64 relocatable object reader: a literal port of
// src/linker/elf_reader.ml. Every check runs in the same order and fails
// with the same message, so the first diagnostic for a bad object is the
// OCaml linker's.
//
// Objects are parsed in parallel, one per pool item. A parse never prints:
// it leaves its message in the object's own `msg` and fails, and the
// caller reports the failure of the lowest-numbered input, which is the
// one the serial OCaml linker reports. Nothing is copied: names are Bytes
// into the input mapping.

const MAX_FILE_SIZE u64 = 134217728      // 128 MiB
const MAX_ALIGNMENT u64 = 2097152        // 2 MiB
const MAX_SECTION_SIZE u64 = 1073741824  // 1 GiB

error Bad       // the message is in the object's msg
error Refused   // a feature this linker does not handle yet (msg names it)

struct Sec {
    name Bytes
    kind u32
    link u32
    info u32
    group i32           // index of the group this section belongs to, or -1
    flags u64
    offset u64
    size u64
    alignment u64       // at least 1
    entsize u64
}

struct Sym {
    name Bytes
    value u64
    size u64
    section u32         // st_shndx as read (SHN_* values kept)
    binding u8
    kind u8
    visibility u8       // the whole st_other byte (validated to be <= 3)
    pad u8
}

struct Rel {
    offset u64
    addend u64
    target u32          // the relocated section
    symbol u32
    kind u32
    pad u32
}

struct Group {
    signature Bytes
    comdat bool
    members addr        // u32 section indices
    n u32
}

struct Obj {
    path Bytes
    data addr
    len u64
    secs addr           // Sec
    nsec u32
    symtab u32          // 0 when there is none
    syms addr           // Sym
    nsym u32
    rels addr           // Rel
    nrel u32
    groups addr         // Group
    ngroup u32
    name_bytes u64
    dec addr            // u64 sizes of the decoded debug sections, in order
    ndec u32            // not yet charged to the combined input budget
    msg Buf             // the failure message, when the parse failed
}

fn sec(o handle[Obj], i u64) handle[Sec] { return handle_from_addr[Sec](o.secs + i * sizeof[Sec]) }
fn sym(o handle[Obj], i u64) handle[Sym] { return handle_from_addr[Sym](o.syms + i * sizeof[Sym]) }
fn rel(o handle[Obj], i u64) handle[Rel] { return handle_from_addr[Rel](o.rels + i * sizeof[Rel]) }

// ---------- failures ----------

// the object's message buffer, cleared and started with "path: "
fn ef(o handle[Obj]) handle[Buf] {
    b handle[Buf] = handle_from_addr[Buf](&o.msg)
    buf_clear(b)
    bb(b, o.path)
    bs(b, c": ")
    return b
}

fn efail(o handle[Obj], s addr) void fails {
    m handle[Buf] = ef(o)
    bs(m, s)
    fail Bad
}

// "path: section NAME: <s>"
fn sfail(o handle[Obj], s handle[Sec], text addr) void fails {
    m handle[Buf] = ef(o)
    bs(m, c"section ")
    bb(m, s.name)
    bs(m, c": ")
    bs(m, text)
    fail Bad
}

// "path: symbol NAME: <s>"
fn yfail(o handle[Obj], name Bytes, text addr) void fails {
    m handle[Buf] = ef(o)
    bs(m, c"symbol ")
    bb(m, name)
    bs(m, c": ")
    bs(m, text)
    fail Bad
}

fn erefuse(o handle[Obj], what addr) void fails {
    b handle[Buf] = handle_from_addr[Buf](&o.msg)
    buf_clear(b)
    bs(b, what)
    bs(b, c" (")
    bb(b, o.path)
    bs(b, c")")
    fail Refused
}

// the `idx` of elf_reader: a field that must lie in 0..limit
fn idx(o handle[Obj], what addr, limit i64, v u64) u64 fails {
    if limit < 0 || v > bitcast[u64](limit) {
        m handle[Buf] = ef(o)
        bs(m, what)
        bs(m, c": value 0x")
        bx(m, v)
        bs(m, c" exceeds supported limit ")
        bd(m, limit)
        fail Bad
    }
    return v
}

// Binary.span with the context "path: <what>"
fn span_fail(o handle[Obj], what Bytes, offset u64, size u64, length u64) void fails {
    m handle[Buf] = ef(o)
    bb(m, what)
    bs(m, c": byte range (")
    bd(m, bitcast[i64](offset))
    bs(m, c", ")
    bd(m, bitcast[i64](size))
    bs(m, c") exceeds size ")
    bd(m, bitcast[i64](length))
    fail Bad
}

fn span(o handle[Obj], what addr, offset u64, size u64) void fails {
    if offset > o.len || size > o.len - offset { try span_fail(o, bytes_c(what), offset, size, o.len) }
}

fn span_section(o handle[Obj], index u64, offset u64, size u64) void fails {
    if offset > o.len || size > o.len - offset {
        t Buf = {}
        th handle[Buf] = handle_from_addr[Buf](&t)
        defer { buf_free(th) }
        bs(th, c"section ")
        bu(th, index)
        try span_fail(o, buf_bytes(th), offset, size, o.len)
    }
}

// Binary.string_at plus the decoded name budget
fn name_at(o handle[Obj], offset u64, size u64, name_offset u64) Bytes fails {
    if name_offset >= size {
        m handle[Buf] = ef(o)
        bs(m, c"name: string offset ")
        bu(m, name_offset)
        bs(m, c" exceeds string table size ")
        bu(m, size)
        fail Bad
    }
    start u64 = offset + name_offset
    limit u64 = umin(offset + size, start + 65536)
    e u64 = start
    while e < limit && o.data[u8, e] != 0 { e += 1 }
    if e == limit { try efail(o, c"name: unterminated string or name exceeds 65535 bytes") }
    n u64 = e - start
    lim u64 = 67108864
    if o.name_bytes > lim || n > lim - o.name_bytes {
        m handle[Buf] = ef(o)
        bs(m, c"decoded name storage: size exceeds supported limit 67108864")
        fail Bad
    }
    o.name_bytes += n
    return bytes(o.data + start, n)
}

fn string_table(o handle[Obj], index u64) void fails {
    s handle[Sec] = sec(o, index)
    if s.kind != 3 || s.size == 0 || o.data[u8, s.offset] != 0 || o.data[u8, s.offset + s.size - 1] != 0 {
        m handle[Buf] = ef(o)
        bs(m, c"section ")
        bu(m, index)
        bs(m, c": invalid string table")
        fail Bad
    }
}

// ---------- SDT notes (Sdt_note.pointers) ----------

fn sdt_fail(o handle[Obj], text addr) void fails {
    m handle[Buf] = ef(o)
    bs(m, c".note.stapsdt: ")
    bs(m, text)
    fail Bad
}

// Nonallocatable SystemTap v3 probe metadata. Appends (section, offset)
// pairs of the three address fields per probe, the only places that
// accept relocations.
fn sdt_pointers(o handle[Obj], index u64, offset u64, size u64, out handle[Vec[u64]]) void fails {
    if offset > o.len || size > o.len - offset { try span_fail(o, bytes_c(c"SDT notes"), offset, size, o.len) }
    d addr = o.data
    ending u64 = offset + size
    cursor u64 = offset
    count u64 = 0
    while cursor < ending {
        count += 1
        if count > 1000000 { try sdt_fail(o, c"probe count exceeds 1000000") }
        if ending - cursor < 20 { try sdt_fail(o, c"truncated probe header") }
        if rd32(d, cursor) != 8 || rd32(d, cursor + 8) != 3 || !mem_eq(d + cursor + 12, c"stapsdt", 8) {
            try sdt_fail(o, c"invalid probe owner or type")
        }
        length u64 = rd32(d, cursor + 4)
        if length < 27 || length > ending - cursor - 20 { try sdt_fail(o, c"invalid probe descriptor length") }
        descriptor u64 = cursor + 20
        for n u64 in 0..3 {
            vec_push[u64](out, index)
            vec_push[u64](out, descriptor - offset + n * 8)
        }
        text u64 = descriptor + 24
        for n u64 in 0..3 {
            tsize u64 = descriptor + length - text
            if tsize == 0 {
                m handle[Buf] = ef(o)
                bs(m, c"SDT string: string offset 0 exceeds string table size 0")
                fail Bad
            }
            limit u64 = umin(text + tsize, text + 65536)
            e u64 = text
            while e < limit && d[u8, e] != 0 { e += 1 }
            if e == limit { try efail(o, c"SDT string: unterminated string or name exceeds 65535 bytes") }
            if n < 2 && e == text { try sdt_fail(o, c"empty probe provider or name") }
            text = e + 1
        }
        if text != descriptor + length { try sdt_fail(o, c"trailing probe descriptor bytes") }
        // Binary.align ~limit:(ending - descriptor) length 4
        padding u64 = (0 - length) & 3
        limit u64 = ending - descriptor
        if padding > limit - length {
            m handle[Buf] = ef(o)
            bs(m, c"SDT descriptor: size exceeds supported limit ")
            bu(m, limit)
            fail Bad
        }
        cursor = descriptor + length + padding
    }
}

// binary search of the sorted (section, offset) pairs
fn sdt_has(v handle[Vec[u64]], index u64, offset u64) bool {
    lo u64 = 0
    hi u64 = v.n / 2
    while lo < hi {
        mid u64 = (lo + hi) / 2
        s u64 = vec_get[u64](v, mid * 2)
        f u64 = vec_get[u64](v, mid * 2 + 1)
        if s == index && f == offset { return true }
        if s < index || (s == index && f < offset) { lo = mid + 1 } else { hi = mid }
    }
    return false
}

fn relocation_width(kind u32) u64 {
    switch kind {
        case 0: return 0
        case 35: return 0
        case 1: return 8
        case 17: return 8
        case 24: return 8
        case 29: return 8
        case 2: return 4
        case 4: return 4
        case 9: return 4
        case 10: return 4
        case 11: return 4
        case 19: return 4
        case 20: return 4
        case 21: return 4
        case 22: return 4
        case 23: return 4
        case 26: return 4
        case 34: return 4
        case 41: return 4
        case 42: return 4
        default: return 99
    }
}

// ---------- the parse ----------

// end << 24 | (who + 2): ends are below 2^31 (offsets are inside the file,
// sizes at most 1 GiB) and section indexes below 0xff00
value struct Range { start u64, rest u64 }

fn range(start u64, end u64, who i64) Range { return {start, (end << 24) | (bitcast[u64](who + 2))} }
fn range_end(r Range) u64 { return r.rest >> 24 }
fn range_who(r Range) i64 { return bitcast[i64](r.rest & 0xffffff) - 2 }

fn range_less(a Range, b Range) bool { return a.start < b.start }

value struct RelKey { target u32, kind u32, offset u64 }

fn relkey_less(a RelKey, b RelKey) bool {
    if a.target != b.target { return a.target < b.target }
    return a.offset < b.offset
}

fn range_name(m handle[Buf], who i64) void {
    if who == -2 {
        bs(m, c"ELF header")
    } else if who == -1 {
        bs(m, c"section table")
    } else {
        bs(m, c"section ")
        bd(m, who)
    }
}

fn is_digits(b Bytes) bool {
    for i usize in 0..b.n {
        c u8 = b.p[u8, i]
        if c < 48 || c > 57 { return false }
    }
    return true
}

// Elf_reader: SHF_COMPRESSED debug sections are decoded, in section
// order, and appended to a copy of the object's data. Each decoded size
// is recorded for the combined input budget, charged in input order by
// the caller (decoded_charge).
fn decompress(o handle[Obj], count u64) void fails {
    original addr = o.data
    total u64 = o.len
    cap u64 = total + 64
    data addr = heap_alloc(cap)
    mem_copy(data, original, total)
    o.dec = heap_alloc(count * 8)
    o.ndec = 0
    decoded u64 = 0
    for index u64 in 0..count {
        s handle[Sec] = sec(o, index)
        if (s.flags & 0x800) == 0 { continue }
        if s.kind != 1 || (s.flags & 2) != 0 || !bytes_prefix(s.name, c".debug_") {
            try sfail(o, s, c"compression requires non-allocatable debug PROGBITS")
        }
        if s.size < 24 { try sfail(o, s, c"truncated compression header") }
        if rd32(original, s.offset) != 1 { try sfail(o, s, c"unsupported compression type (only zlib)") }
        if rd32(original, s.offset + 4) != 0 { try sfail(o, s, c"nonzero compression reserved field") }
        size u64 = try idx(o, c"uncompressed debug size", bitcast[i64](MAX_FILE_SIZE), rd64(original, s.offset + 8))
        if decoded > MAX_FILE_SIZE || size > MAX_FILE_SIZE - decoded {
            m handle[Buf] = ef(o)
            bs(m, c"decoded debug storage: size exceeds supported limit 134217728")
            fail Bad
        }
        decoded += size
        o.dec[u64, zext[u64](o.ndec)] = size
        o.ndec += 1
        alignment u64 = try idx(o, c"uncompressed debug alignment", bitcast[i64](MAX_ALIGNMENT), rd64(original, s.offset + 16))
        if alignment != 0 && (alignment & (alignment - 1)) != 0 { try sfail(o, s, c"invalid uncompressed alignment") }
        if size > cap - total {
            cap = umax(cap * 2, total + size)
            data = heap_realloc(data, cap)
        }
        try zlib_decode(o, s.name, original, s.offset + 24, s.size - 24, data + total, size)
        s.flags = s.flags & ~0x800
        s.offset = total
        s.size = size
        s.alignment = umax(1, alignment)
        total += size
    }
    o.data = data
    o.len = total
}

// whether an input object may have compressed sections (a cheap header
// scan; anything unexpected answers true)
fn may_compress(data Bytes) bool {
    if data.n < 64 || !mem_eq(data.p, c"\x7fELF", 4) { return false }
    shoff u64 = rd64(data.p, 40)
    count u64 = rd16(data.p, 60)
    if shoff > data.n || data.n - shoff < 64 { return true }
    if count == 0 { count = rd64(data.p, shoff + 32) }
    if count > (data.n - shoff) / 64 { return true }
    for i u64 in 0..count {
        if (rd64(data.p, shoff + i * 64 + 8) & 0x800) != 0 { return true }
    }
    return false
}

// Parses o.data (o.len bytes) into o's tables.
fn elf_parse(o handle[Obj]) void fails {
    d addr = o.data
    length u64 = o.len
    if length >= 4 {
        m0 u32 = d[u32]
        // "BC\xc0\xde" and the bitcode wrapper "\xde\xc0\x17\x0b"
        if m0 == 0xdec04342 || m0 == 0x0b17c0de {
            try efail(o, c"LLVM bitcode LTO is unsupported; compile native objects without -flto")
        }
    }
    if length > MAX_FILE_SIZE { try efail(o, c"input exceeds 134217728 byte limit") }
    try span(o, c"ELF header", 0, 64)
    if d[u32] != 0x464c457f { try efail(o, c"expected an ELF object") }
    if rd8(d, 4) != 2 { try efail(o, c"unsupported ELF class (expected ELF64)") }
    if rd8(d, 5) != 1 { try efail(o, c"unsupported ELF byte order (expected little-endian)") }
    if rd8(d, 6) != 1 { try efail(o, c"invalid ELF identification version") }
    if (rd8(d, 7) != 0 && rd8(d, 7) != 3) || rd8(d, 8) != 0 {
        try efail(o, c"unsupported ELF OS ABI or ABI version")
    }
    for n u64 in 9..16 {
        if rd8(d, n) != 0 { try efail(o, c"nonzero ELF identification padding") }
    }
    if rd16(d, 16) != 1 { try efail(o, c"unsupported ELF type (expected ET_REL)") }
    if rd16(d, 18) != 62 { try efail(o, c"unsupported ELF machine (expected x86-64)") }
    if rd32(d, 20) != 1 { try efail(o, c"invalid ELF version") }
    if rd64(d, 24) != 0 || rd64(d, 32) != 0 || rd16(d, 56) != 0 {
        try efail(o, c"ET_REL input must not have an entry point or program headers")
    }
    if rd16(d, 54) != 0 { try efail(o, c"unsupported ET_REL program header entry size") }
    if rd32(d, 48) != 0 { try efail(o, c"unsupported ELF flags") }
    if rd16(d, 52) != 64 || rd16(d, 58) != 64 { try efail(o, c"invalid ELF header or section entry size") }
    count u64 = rd16(d, 60)
    names_index u64 = rd16(d, 62)
    if count == 0 || count >= 0xff00 || names_index == 0xffff {
        try efail(o, c"unsupported extended section numbering")
    }
    if names_index == 0 || names_index >= count { try efail(o, c"missing or invalid section name table index") }
    shoff u64 = try idx(o, c"section table offset", bitcast[i64](length), rd64(d, 40))
    if shoff < 64 || (shoff & 7) != 0 { try efail(o, c"invalid section table offset") }
    try span(o, c"section table", shoff, count * 64)
    for n u64 in 0..64 {
        if rd8(d, shoff + n) != 0 { try efail(o, c"invalid null section header") }
    }

    o.nsec = trunc[u32](count)
    o.secs = heap_alloc_zeroed(count * sizeof[Sec])
    for index u64 in 0..count {
        at u64 = shoff + index * 64
        s handle[Sec] = sec(o, index)
        s.group = -1
        kind u64 = try idx(o, c"section type", bitcast[i64](OCAML_MAX_INT), rd32(d, at + 4))
        s.kind = trunc[u32](kind)
        s.flags = try idx(o, c"section flags", bitcast[i64](OCAML_MAX_INT), rd64(d, at + 8))
        // NOBITS sh_offset has no file interpretation: never index input by it
        s.offset = if kind == 8 { 0 } else { try idx(o, c"section offset", bitcast[i64](length), rd64(d, at + 24)) }
        s.size = try idx(o, c"section size", bitcast[i64](MAX_SECTION_SIZE), rd64(d, at + 32))
        s.link = trunc[u32](try idx(o, c"section link", bitcast[i64](count) - 1, rd32(d, at + 40)))
        s.info = trunc[u32](try idx(o, c"section info", bitcast[i64](OCAML_MAX_INT), rd32(d, at + 44)))
        alignment u64 = try idx(o, c"section alignment", bitcast[i64](MAX_ALIGNMENT), rd64(d, at + 48))
        s.entsize = try idx(o, c"section entry size", bitcast[i64](MAX_FILE_SIZE), rd64(d, at + 56))
        if rd64(d, at + 16) != 0 {
            m handle[Buf] = ef(o)
            bs(m, c"section ")
            bu(m, index)
            bs(m, c": ET_REL section address must be zero")
            fail Bad
        }
        if alignment != 0 && (alignment & (alignment - 1)) != 0 {
            m handle[Buf] = ef(o)
            bs(m, c"section ")
            bu(m, index)
            bs(m, c": alignment must be a power of two")
            fail Bad
        }
        if kind != 8 { try span_section(o, index, s.offset, s.size) }
        s.alignment = if alignment == 0 { 1 } else { alignment }
    }

    // no two file ranges overlap
    ranges Vec[Range] = {}
    rh handle[Vec[Range]] = handle_from_addr[Vec[Range]](&ranges)
    defer { vec_free(rh) }
    vec_push(rh, range(0, 64, -2))
    vec_push(rh, range(shoff, shoff + count * 64, -1))
    for index u64 in 0..count {
        s handle[Sec] = sec(o, index)
        if s.kind != 8 && s.size != 0 { vec_push(rh, range(s.offset, s.offset + s.size, bitcast[i64](index))) }
    }
    sort[Range, range_less](ranges.p, ranges.n)
    previous_end u64 = 0
    previous_who i64 = -3
    for i usize in 0..ranges.n {
        r Range = vec_get(rh, i)
        if r.start < previous_end {
            m handle[Buf] = ef(o)
            range_name(m, range_who(r))
            bs(m, c" overlaps ")
            range_name(m, previous_who)
            fail Bad
        }
        previous_end = range_end(r)
        previous_who = range_who(r)
    }

    names handle[Sec] = sec(o, names_index)
    if names.kind != 3 || names.size == 0 { try efail(o, c"invalid section name string table") }
    try string_table(o, names_index)
    for index u64 in 0..count {
        name_offset u64 = try idx(o, c"section name offset", bitcast[i64](names.size) - 1, rd32(d, shoff + index * 64))
        sec(o, index).name = try name_at(o, names.offset, names.size, name_offset)
    }
    for index u64 in 0..count {
        s handle[Sec] = sec(o, index)
        if s.kind == 0x70000001 {
            if !bytes_is(s.name, c".eh_frame") { try sfail(o, s, c"unsupported x86-64 unwind section") }
            s.kind = 1
        }
    }
    for index u64 in 0..count {
        if (sec(o, index).flags & 0x800) != 0 {
            try decompress(o, count)
            d = o.data
            break
        }
    }

    // per-section validation
    symtab_index u64 = 0
    sdt Vec[u64] = {}
    sdth handle[Vec[u64]] = handle_from_addr[Vec[u64]](&sdt)
    defer { vec_free[u64](sdth) }
    for index u64 in 0..count {
        s handle[Sec] = sec(o, index)
        if bytes_prefix(s.name, c".gnu.lto") || bytes_prefix(s.name, c".llvm.lto") {
            try sfail(o, s, c"LTO objects are unsupported; compile without -flto")
        }
        if (bytes_is(s.name, c".eh_frame") && s.kind != 1) ||
            ((bytes_is(s.name, c".note.stapsdt") || bytes_is(s.name, c".note.gnu.property") ||
                bytes_is(s.name, c".note.ABI-tag")) && s.kind != 7) {
            try sfail(o, s, c"invalid metadata section type")
        }
        allowed u64 = if s.kind == 4 { 0x240 } else if s.kind == 0x6fff4c03 { 0x80000000 }
            else if s.kind == 1 || s.kind == 8 { 0x200637 }
            else if s.kind == 14 || s.kind == 15 || s.kind == 16 { 0x200003 } else { 7 }
        if (s.flags & ~allowed) != 0 {
            m handle[Buf] = ef(o)
            bs(m, c"section ")
            bb(m, s.name)
            bs(m, c": unsupported flags 0x")
            bx(m, s.flags)
            fail Bad
        }
        if (s.flags & 5) == 5 { try sfail(o, s, c"writable executable sections are unsupported") }
        k u32 = s.kind
        if k == 0 && index == 0 {
        } else if k == 1 || k == 8 {
            if (s.flags & 0x400) != 0 && (s.flags & ~0x200) != 0x403 { try sfail(o, s, c"invalid TLS flags") }
            if k == 8 && (s.flags & 2) == 0 { try sfail(o, s, c"non-allocatable NOBITS is unsupported") }
            if bytes_is(s.name, c".note.GNU-stack") && (s.size != 0 || s.flags != 0) {
                try efail(o, c"section .note.GNU-stack: executable stack or nonempty stack marker is unsupported")
            }
            if bytes_is(s.name, c".eh_frame") && ((s.flags & ~0x200) != 2 || s.alignment > 8) {
                try efail(o, c"section .eh_frame: unsupported unwind flags or alignment")
            }
            merge bool = (s.flags & 0x10) != 0
            strings bool = (s.flags & 0x20) != 0
            if strings && !merge { try sfail(o, s, c"SHF_STRINGS requires SHF_MERGE") }
            if merge {
                if s.kind != 1 || s.entsize == 0 || s.size % s.entsize != 0 { try sfail(o, s, c"invalid merge entry size") }
                if strings && s.entsize != 1 && s.entsize != 2 && s.entsize != 4 {
                    try sfail(o, s, c"unsupported merge string character width")
                }
                if strings && s.size != 0 {
                    for i u64 in s.size - s.entsize..s.size {
                        if o.data[u8, s.offset + i] != 0 { try sfail(o, s, c"unterminated merge strings") }
                    }
                }
            }
            if s.link != 0 || s.info != 0 || (!merge && s.entsize != 0) { try sfail(o, s, c"unsupported section metadata") }
        } else if k == 14 || k == 15 || k == 16 {
            expected addr = if k == 14 { c".init_array" } else if k == 15 { c".fini_array" } else { c".preinit_array" }
            if !bytes_is(s.name, expected) {
                e Bytes = bytes_c(expected)
                if s.name.n <= e.n || !bytes_starts_with(s.name, e) || s.name.p[u8, e.n] != 46 {
                    try sfail(o, s, c"unexpected initialization array name")
                }
                suffix Bytes = bytes_from(s.name, e.n + 1)
                bad bool = suffix.n == 0 || !is_digits(suffix)
                if !bad {
                    v u64 = 0
                    for i usize in 0..suffix.n {
                        v = v * 10 + zext[u64](suffix.p[u8, i] - 48)
                        if v > 65535 {
                            bad = true
                            break
                        }
                    }
                }
                if bad { try sfail(o, s, c"invalid initialization priority") }
            }
            if (s.flags & ~0x200) != 3 || s.link != 0 || s.info != 0 || (s.entsize != 0 && s.entsize != 8) ||
                s.size % 8 != 0 || s.alignment > 8 {
                try sfail(o, s, c"invalid initialization array metadata")
            }
        } else if k == 2 {
            if symtab_index != 0 { try efail(o, c"multiple symbol tables are unsupported") }
            symtab_index = index
            if s.flags != 0 { try sfail(o, s, c"allocatable symbol table is unsupported") }
        } else if k == 3 {
            try string_table(o, index)
            if s.flags != 0 || s.link != 0 || s.info != 0 || s.entsize != 0 {
                try sfail(o, s, c"unsupported string table metadata")
            }
        } else if k == 4 {
        } else if k == 7 {
            if bytes_is(s.name, c".note.stapsdt") {
                if s.flags != 0 || s.alignment != 4 || s.link != 0 || s.info != 0 || s.entsize != 0 {
                    try sfail(o, s, c"unsupported SDT note metadata")
                }
                try sdt_pointers(o, index, s.offset, s.size, sdth)
            } else if bytes_is(s.name, c".note.ABI-tag") {
                if s.flags != 2 || s.alignment != 4 || s.link != 0 || s.info != 0 || s.entsize != 0 || s.size != 32 ||
                    rd32(d, s.offset) != 4 || rd32(d, s.offset + 4) != 16 || rd32(d, s.offset + 8) != 1 ||
                    rd32(d, s.offset + 12) != 0x00554e47 || rd32(d, s.offset + 16) != 0 {
                    try sfail(o, s, c"invalid GNU Linux ABI note")
                }
            } else {
                if !bytes_is(s.name, c".note.gnu.property") || s.flags != 2 || s.alignment != 8 || s.link != 0 ||
                    s.info != 0 || s.entsize != 0 {
                    try sfail(o, s, c"unsupported note metadata")
                }
                try gp_check(o, s)
            }
        } else if k == 17 {
            if s.flags != 0 || s.entsize != 4 || s.size < 8 || s.size % 4 != 0 {
                try sfail(o, s, c"invalid section group metadata")
            }
        } else if k == 0x6fff4c03 {
            if (s.flags != 0 && s.flags != 0x80000000) || s.info != 0 || s.entsize != 0 || s.alignment != 1 {
                try sfail(o, s, c"invalid LLVM address-significance metadata")
            }
        } else {
            m handle[Buf] = ef(o)
            bs(m, c"section ")
            bb(m, s.name)
            bs(m, c": unsupported section type ")
            bu(m, zext[u64](s.kind))
            fail Bad
        }
    }
    o.symtab = trunc[u32](symtab_index)

    // symbols
    if symtab_index != 0 {
        symtab handle[Sec] = sec(o, symtab_index)
        if symtab.entsize != 24 || symtab.size % 24 != 0 || symtab.size == 0 {
            try efail(o, c"invalid symbol table entry size")
        }
        symbol_count u64 = symtab.size / 24
        if symbol_count > 1000000 { try efail(o, c"symbol count exceeds supported limit") }
        first_global u64 = zext[u64](symtab.info)
        if first_global < 1 || first_global > symbol_count { try efail(o, c"invalid first global symbol index") }
        try string_table(o, zext[u64](symtab.link))
        strings handle[Sec] = sec(o, zext[u64](symtab.link))
        for n u64 in 0..24 {
            if rd8(d, symtab.offset + n) != 0 { try efail(o, c"invalid null symbol") }
        }
        o.nsym = trunc[u32](symbol_count)
        o.syms = heap_alloc_zeroed(symbol_count * sizeof[Sym])
        for index u64 in 0..symbol_count {
            at u64 = symtab.offset + index * 24
            name_offset u64 = try idx(o, c"symbol name offset", bitcast[i64](strings.size) - 1, rd32(d, at))
            name Bytes = try name_at(o, strings.offset, strings.size, name_offset)
            info u64 = rd8(d, at + 4)
            binding u64 = info >> 4
            kind u64 = info & 15
            section u64 = rd16(d, at + 6)
            value u64 = rd64(d, at + 8)
            size u64 = rd64(d, at + 16)
            if binding > 2 {
                m handle[Buf] = ef(o)
                bs(m, c"symbol ")
                bb(m, name)
                bs(m, c": unsupported binding ")
                bu(m, binding)
                fail Bad
            }
            if (index < first_global) != (binding == 0) { try yfail(o, name, c"invalid local/global ordering") }
            visibility u64 = rd8(d, at + 5)
            if (kind > 6 && kind != 10) || visibility > 3 { try yfail(o, name, c"unsupported type or visibility") }
            if binding != 0 && name.n == 0 { try efail(o, c"global symbol has an empty name") }
            if kind == 5 && section != 0xfff2 { try yfail(o, name, c"STT_COMMON requires SHN_COMMON") }
            if section == 0 {
                if index != 0 && binding == 0 { try yfail(o, name, c"undefined local symbol") }
                if value != 0 { try yfail(o, name, c"invalid undefined symbol value") }
            } else if section == 0xfff1 {
                if kind == 6 { try yfail(o, name, c"absolute TLS definition") }
                if kind == 10 { try yfail(o, name, c"absolute IFUNC definition") }
            } else if section == 0xfff2 {
                if kind == 10 { try yfail(o, name, c"common IFUNC definition") }
                if kind == 6 { try yfail(o, name, c"common TLS is unsupported") }
                if binding != 1 { try yfail(o, name, c"common symbol must be global") }
                alignment u64 = try idx(o, c"common alignment", bitcast[i64](MAX_ALIGNMENT), value)
                if alignment != 0 && (alignment & (alignment - 1)) != 0 {
                    try yfail(o, name, c"common alignment must be a power of two")
                }
                cs u64 = try idx(o, c"common size", bitcast[i64](MAX_SECTION_SIZE), size)
            } else if section >= 0xff00 {
                m handle[Buf] = ef(o)
                bs(m, c"symbol ")
                bb(m, name)
                bs(m, c": unsupported special section index 0x")
                bx(m, section)
                fail Bad
            } else {
                if section >= count {
                    m handle[Buf] = ef(o)
                    bs(m, c"symbol ")
                    bb(m, name)
                    bs(m, c": invalid section index ")
                    bu(m, section)
                    fail Bad
                }
                target handle[Sec] = sec(o, section)
                if ((kind == 6) != ((target.flags & 0x400) != 0)) && kind != 3 {
                    try yfail(o, name, c"TLS type does not match defining section")
                }
                tk u32 = target.kind
                if !(tk == 1 || tk == 7 || tk == 8 || tk == 14 || tk == 15 || tk == 16) &&
                    !(tk == 17 && binding == 0) &&
                    !(tk == 0x6fff4c03 && binding == 0 && kind == 3 && value == 0 && size == 0) {
                    try yfail(o, name, c"unsupported defining section")
                }
                if value > target.size || size > target.size - value {
                    try yfail(o, name, c"value or size exceeds its section")
                }
                if bytes_is(target.name, c".note.GNU-stack") && (kind != 3 || binding != 0 || value != 0 || size != 0) {
                    try yfail(o, name, c"definition in discarded stack marker")
                }
                if kind == 10 && ((target.flags & 6) != 6 || value >= target.size) {
                    try yfail(o, name, c"IFUNC resolver must be inside executable code")
                }
            }
            y handle[Sym] = sym(o, index)
            y.name = name
            y.binding = trunc[u8](binding)
            y.kind = trunc[u8](kind)
            y.visibility = trunc[u8](visibility)
            y.section = trunc[u32](section)
            y.value = value
            y.size = size
        }
    }
    symbol_count u64 = zext[u64](o.nsym)

    // groups
    groups Vec[Group] = {}
    gh handle[Vec[Group]] = handle_from_addr[Vec[Group]](&groups)
    for index u64 in 0..count {
        s handle[Sec] = sec(o, index)
        if s.kind != 17 { continue }
        if zext[u64](s.link) != symtab_index || s.info == 0 || zext[u64](s.info) >= symbol_count {
            try sfail(o, s, c"invalid group signature symbol")
        }
        y handle[Sym] = sym(o, zext[u64](s.info))
        signature Bytes = if y.name.n == 0 && y.kind == 3 && y.section != 0 && zext[u64](y.section) < count {
            sec(o, zext[u64](y.section)).name
        } else { y.name }
        if signature.n == 0 { try sfail(o, s, c"empty group signature") }
        flags u64 = rd32(d, s.offset)
        if flags != 0 && flags != 1 { try sfail(o, s, c"unsupported group flags") }
        nm u64 = s.size / 4 - 1
        if nm >= count { try sfail(o, s, c"group member count exceeds section count") }
        members addr = heap_alloc(nm * 4 + 4)
        for i u64 in 0..nm {
            member u64 = try idx(o, c"group member", bitcast[i64](count) - 1, rd32(d, s.offset + 4 + i * 4))
            t handle[Sec] = sec(o, member)
            tk u32 = t.kind
            if member <= index || (t.flags & 0x200) == 0 ||
                !(tk == 1 || tk == 8 || tk == 4 || tk == 14 || tk == 15 || tk == 16) || t.group != -1 {
                m handle[Buf] = ef(o)
                bs(m, c"section ")
                bb(m, s.name)
                bs(m, c": invalid or repeated group member ")
                bu(m, member)
                fail Bad
            }
            t.group = trunc[i32](bitcast[i64](groups.n))
            members[u32, i] = trunc[u32](member)
        }
        g handle[Group] = vec_new[Group](gh)
        g.signature = signature
        g.comdat = flags == 1
        g.members = members
        g.n = trunc[u32](nm)
    }
    o.groups = groups.p
    o.ngroup = trunc[u32](groups.n)
    for index u64 in 0..count {
        s handle[Sec] = sec(o, index)
        if (s.flags & 0x200) != 0 && s.group == -1 { try sfail(o, s, c"SHF_GROUP section has no group") }
        if s.kind == 4 && zext[u64](s.info) < count && s.group != sec(o, zext[u64](s.info)).group {
            try sfail(o, s, c"relocation and target group membership differ")
        }
    }

    // address-significance tables
    for index u64 in 0..count {
        s handle[Sec] = sec(o, index)
        if s.kind != 0x6fff4c03 || s.link == 0 { continue }
        // GNU/LLD -r invalidate unremapped addrsig tables with sh_link=0:
        // such contents cannot be read as current symbol indices
        if symtab_index == 0 || zext[u64](s.link) != symtab_index {
            try sfail(o, s, c"invalid address-significance symbol table")
        }
        at u64 = s.offset
        ending u64 = s.offset + s.size
        while at < ending {
            value u64 = 0
            shift u64 = 0
            more bool = true
            while more {
                if at == ending || shift >= 21 { try sfail(o, s, c"malformed address-significance ULEB128") }
                byte u64 = rd8(d, at)
                at += 1
                value = value | ((byte & 127) << shift)
                shift += 7
                more = (byte & 128) != 0
            }
            if value >= symbol_count { try sfail(o, s, c"address-significance symbol index out of range") }
        }
    }

    // relocations
    relocation_count u64 = 0
    for index u64 in 0..count {
        s handle[Sec] = sec(o, index)
        if s.kind != 4 { continue }
        if s.entsize != 24 || s.size % 24 != 0 { try sfail(o, s, c"invalid RELA entry size") }
        if symtab_index == 0 || zext[u64](s.link) != symtab_index { try sfail(o, s, c"invalid relocation symbol table") }
        if s.info == 0 || zext[u64](s.info) >= count { try sfail(o, s, c"invalid relocation target index") }
        t handle[Sec] = sec(o, zext[u64](s.info))
        tk u32 = t.kind
        if (!(tk == 1 || tk == 14 || tk == 15 || tk == 16) && !(tk == 7 && bytes_is(t.name, c".note.stapsdt"))) ||
            bytes_is(t.name, c".note.GNU-stack") {
            try sfail(o, s, c"unsupported relocation target")
        }
        n u64 = s.size / 24
        if relocation_count > 1000000 || n > 1000000 - relocation_count {
            m handle[Buf] = ef(o)
            bs(m, c"relocation count: size exceeds supported limit 1000000")
            fail Bad
        }
        relocation_count += n
    }
    o.rels = heap_alloc(relocation_count * sizeof[Rel] + 8)
    o.nrel = trunc[u32](relocation_count)
    next u64 = 0
    sorted bool = true
    for index u64 in 0..count {
        s handle[Sec] = sec(o, index)
        if s.kind != 4 { continue }
        t handle[Sec] = sec(o, zext[u64](s.info))
        for n u64 in 0..s.size / 24 {
            at u64 = s.offset + n * 24
            info u64 = rd64(d, at + 8)
            kind u64 = info & 0xffffffff
            symbol u64 = try idx(o, c"relocation symbol index", bitcast[i64](symbol_count) - 1, info >> 32)
            offset u64 = try idx(o, c"relocation offset", bitcast[i64](t.size), rd64(d, at))
            if kind != 0 && bytes_is(t.name, c".note.stapsdt") &&
                (kind != 1 || !sdt_has(sdth, zext[u64](s.info), offset)) {
                try efail(o, c"section .note.stapsdt: relocation must target a probe address field")
            }
            width u64 = relocation_width(trunc[u32](kind))
            if width == 99 {
                m handle[Buf] = ef(o)
                bs(m, c"section ")
                bb(m, t.name)
                bs(m, c"+0x")
                bx(m, offset)
                bs(m, c": unsupported x86-64 relocation ")
                bu(m, kind)
                fail Bad
            }
            if width > t.size - offset {
                m handle[Buf] = ef(o)
                bs(m, c"relocation in ")
                bb(m, t.name)
                bs(m, c": byte range (")
                bu(m, offset)
                bs(m, c", ")
                bu(m, width)
                bs(m, c") exceeds size ")
                bu(m, t.size)
                fail Bad
            }
            r handle[Rel] = rel(o, next)
            r.offset = offset
            r.addend = rd64(d, at + 16)
            r.target = s.info
            r.symbol = trunc[u32](symbol)
            r.kind = trunc[u32](kind)
            if next > 0 {
                p handle[Rel] = rel(o, next - 1)
                if p.target > r.target || (p.target == r.target && p.offset > r.offset) { sorted = false }
            }
            next += 1
        }
    }
    // Toolchains usually emit ordered relocations; sort a copy otherwise
    // (diagnostics keep the original order)
    keys Vec[RelKey] = {}
    kh handle[Vec[RelKey]] = handle_from_addr[Vec[RelKey]](&keys)
    defer { vec_free(kh) }
    if !sorted {
        for i u64 in 0..relocation_count {
            r handle[Rel] = rel(o, i)
            vec_push(kh, {r.target, r.kind, r.offset})
        }
        sort[RelKey, relkey_less](keys.p, keys.n)
    }
    previous_target u64 = 0xffffffffffffffff
    previous_end_r u64 = 0
    for i u64 in 0..relocation_count {
        k RelKey = {0, 0, 0}
        if sorted {
            r handle[Rel] = rel(o, i)
            k = {r.target, r.kind, r.offset}
        } else {
            k = vec_get(kh, i)
        }
        if k.kind == 0 { continue }
        if zext[u64](k.target) == previous_target && k.offset < previous_end_r {
            m handle[Buf] = ef(o)
            bs(m, c"section ")
            bb(m, sec(o, zext[u64](k.target)).name)
            bs(m, c"+0x")
            bx(m, k.offset)
            bs(m, c": overlapping relocations are unsupported")
            fail Bad
        }
        previous_target = zext[u64](k.target)
        previous_end_r = k.offset + relocation_width(k.kind)
    }
}
