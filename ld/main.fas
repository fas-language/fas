// fas-ld: the Fas linker. A rewrite of the OCaml linker (src/linker) that
// produces byte-identical output with the same diagnostics and exit codes;
// see ld/DESIGN.md. Features not ported yet are refused with exit code 3
// ("not yet supported by the Fas linker").
//
// FAS_LD_THREADS sets the thread count (default: one per CPU). The output
// never depends on it.

use "../lib/core.fas"
use "../lib/thread.fas"
use "util.fas"
use "elf.fas"
use "shared.fas"
use "cli.fas"
use "verscript.fas"
use "resolve.fas"
use "archive.fas"
use "shdeps.fas"
use "layout.fas"
use "link.fas"
use "unwind.fas"
use "symver.fas"
use "property.fas"
use "gc.fas"
use "buildid.fas"
use "tls.fas"
use "ifunc.fas"
use "relax.fas"
use "dynamic.fas"
use "zlib.fas"
use "script.fas"
use "map.fas"
use "stats.fas"
use "partial.fas"

fn main(argc i32, argv addr) i32 {
    os_init(argc, argv)
    objs = heap_alloc_zeroed(MAX_OBJECTS * sizeof[Obj])
    lxs = heap_alloc_zeroed(MAX_OBJECTS * sizeof[Lx])
    parse_command_line()
    c handle[Config] = config()
    if c.statistics { stats_start() }
    if c.print_version { print_version() }
    // features the skeleton does not have yet
    if !c.relocatable && c.mode == MODE_DYNAMIC { refuse(c"dynamic output") }
    threads u32 = 0
    t addr = os_getenv(c"FAS_LD_THREADS")
    if t != null { threads = trunc[u32](bytes_to_u64(bytes_c(t)) catch 0) }
    pool = pool_start(threads)
    if c.relocatable { partial_link_and_publish() } else { link_and_publish() }
    stats_print()
    pool_stop(pool)
    return 0
}
