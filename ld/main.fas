// fas-ld: the Fas linker. A rewrite of the OCaml linker (src/linker) that
// produces byte-identical output with the same diagnostics and exit codes;
// see ld/DESIGN.md. Features not ported yet are refused with exit code 3
// ("not yet supported by the Fas linker").
//
// FAS_LD_THREADS sets the thread count (default: one per CPU). The output
// never depends on it.

use "../lib/core.fas"
use "../lib/thread.fas"
use "util.fas"
use "elf.fas"
use "shared.fas"
use "cli.fas"
use "verscript.fas"
use "resolve.fas"
use "archive.fas"
use "shdeps.fas"
use "layout.fas"
use "link.fas"
use "unwind.fas"
use "symver.fas"
use "property.fas"
use "gc.fas"
use "buildid.fas"
use "tls.fas"
use "ifunc.fas"
use "relax.fas"
use "copy.fas"
use "dynamic.fas"
use "zlib.fas"
use "script.fas"
use "lscript.fas"
use "limage.fas"
use "map.fas"
use "stats.fas"
use "partial.fas"
use "api.fas"
use "ctx.fas"

fn main(argc i32, argv addr) i32 {
    os_init(argc, argv)
    run_cli() catch e { return ld_exit_code(e) }
    return 0
}

fn run_cli() void fails {
    reg Region = {}
    prev_reg handle[Region] = region_switch(&reg)
    prev_ld handle[Ld] = ld
    ctx handle[Ld] = handle_from_addr(heap_alloc_zeroed(sizeof[Ld]))
    ld_init(ctx)
    ld = ctx
    defer {
        intern_free(&ld.names)
        ld_unmap_all()
        ld = prev_ld
        region_switch(prev_reg)
        region_dispose(&reg)
    }
    ld.objs = heap_alloc_zeroed(MAX_OBJECTS * sizeof[Obj])
    ld.lxs = heap_alloc_zeroed(MAX_OBJECTS * sizeof[Lx])
    try parse_command_line()
    c handle[Config] = config()
    if c.statistics { stats_start() }
    if c.print_version { print_version() }
    threads u32 = 0
    t addr = os_getenv(c"FAS_LD_THREADS")
    if t != null { threads = trunc[u32](bytes_to_u64(bytes_c(t)) catch 0) }
    pool_p handle[Pool] = handle_from_addr(heap_alloc_zeroed(sizeof[Pool]))
    ld.pool = pool_start_on(pool_p, threads)
    defer { pool_stop(ld.pool) }
    if c.relocatable { try partial_link_and_publish() } else { try link_and_publish() }
    stats_print()
}
