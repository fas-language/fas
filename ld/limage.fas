// Final ELF image for the executable linker-script subset.

struct LsRela {
    target u64
    size u64
    offset u64
    cursor u64
    name u64
}

struct LsOutSym {
    file u64
    symbol u64
    name u64
    section u64
    binding u8
    visibility u8
}

struct LsImage {
    relas Vec[LsRela]
    rela_by_section addr
    symbol_indices addr      // per input: u32 output index per symbol
    symbols Vec[LsOutSym]
    local_end u64
    strtab Buf
    shstrtab Buf
    section_names addr      // u32 per script section
    symtab_name u64
    strtab_name u64
    shstrtab_name u64
    symtab_section u64
    strtab_section u64
    shstrtab_section u64
    symtab_offset u64
    strtab_offset u64
    shstrtab_offset u64
    shoff u64
    section_count u64
    symtab_size u64
}

fn ls_section_flags(s handle[LsSection]) u64 {
    return 4 | ((s.flags & 4) >> 2) | ((s.flags & 1) << 1)
}

fn ls_add_to_phdr(i u64, pidx u64) void fails {
    s handle[LsSection] = ls_sec(i)
    p handle[LsPhdr] = ls_phdr(pidx)
    if p.kind == 1 {
        if s.load != 0 { try refuse(c"section belongs to multiple PT_LOAD segments") }
        s.load = pidx
        if p.first != 0 && s.lma != ls_sec(p.first).lma {
            try refuse(c"different load-address offsets in one PT_LOAD segment")
        }
        p.alignment = umax(p.alignment, config().page)
    }
    if p.first == 0 { p.first = i }
    p.last = i
    p.alignment = umax(p.alignment, s.alignment)
    if !p.explicit_flags { p.flags |= ls_section_flags(s) }
}

fn ls_make_phdrs() void fails {
    sc handle[Lscript] = &ld.lscript
    automatic u64 = 0
    for i u64 in 1..sc.sections.n + 1 {
        s handle[LsSection] = ls_sec(i)
        if !s.keep || (s.flags & 2) == 0 { continue }
        if sc.explicit_phdrs {
            if s.phdr_source != 0 {
                source handle[LsSection] = ls_sec(s.phdr_source)
                for j u64 in 0..source.phdrs.n { try ls_add_to_phdr(i, vec_get(&source.phdrs, j)) }
            }
            if s.load == 0 && s.size != 0 { try refuse(c"allocatable section outside a PT_LOAD segment") }
        } else {
            new_load bool = true
            if automatic != 0 {
                p handle[LsPhdr] = ls_phdr(automatic)
                prev handle[LsSection] = ls_sec(p.last)
                new_load = p.flags != ls_section_flags(s) || s.lma != prev.lma ||
                    (prev.kind == 8 && s.kind != 8)
            }
            if new_load {
                p handle[LsPhdr] = vec_add(&sc.phdrs)
                p.kind = 1
                automatic = sc.phdrs.n
            }
            try ls_add_to_phdr(i, automatic)
        }
    }
    if !sc.explicit_phdrs {
        // The script's default segment layout adds a NOTE around each
        // contiguous run of allocatable note sections.
        note u64 = 0
        for i u64 in 1..sc.sections.n + 1 {
            s handle[LsSection] = ls_sec(i)
            if !s.keep || (s.flags & 2) == 0 { continue }
            if s.kind != 7 {
                note = 0
                continue
            }
            if note == 0 {
                p handle[LsPhdr] = vec_add(&sc.phdrs)
                p.kind = 4
                note = sc.phdrs.n
            }
            try ls_add_to_phdr(i, note)
        }
        p handle[LsPhdr] = vec_add(&sc.phdrs)
        p.kind = 0x6474e551
        p.flags = 6
        p.alignment = 0
    }
}

fn ls_file_place(i u64, cursor u64) u64 fails {
    s handle[LsSection] = ls_sec(i)
    if s.load != 0 {
        p handle[LsPhdr] = ls_phdr(s.load)
        first handle[LsSection] = ls_sec(p.first)
        if i == p.first {
            s.offset = try out_add(cursor, (s.address - cursor) & (p.alignment - 1))
        } else if s.kind == 8 {
            // NOBITS has a memory extent and consumes no file space.
            s.offset = cursor
        } else {
            if s.address < first.address { try die_c(c"section address precedes its PT_LOAD segment") }
            s.offset = try out_add(first.offset, s.address - first.address)
            if s.offset < cursor { try die_c(c"overlapping linker-script sections in output file") }
        }
    } else {
        s.offset = try out_align(cursor, s.alignment)
    }
    if s.kind == 8 { return cursor }
    return try out_add(s.offset, s.size)
}

fn ls_content_layout() void fails {
    sc handle[Lscript] = &ld.lscript
    try ls_make_phdrs()
    cursor u64 = 64 + sc.phdrs.n * 56
    // Segment members are laid out ahead of non-allocatable data, even
    // when the script places some of the latter between two load sections.
    for pass u64 in 0..2 {
        for i u64 in 1..sc.sections.n + 1 {
            s handle[LsSection] = ls_sec(i)
            if !s.keep || ((s.flags & 2) == 0) != (pass == 1) { continue }
            cursor = try ls_file_place(i, cursor)
        }
    }
    sc.file_end = cursor
    n u64 = 1
    for i u64 in 1..sc.sections.n + 1 {
        s handle[LsSection] = ls_sec(i)
        if !s.keep { continue }
        s.number = n
        n += 1
        for j u64 in 0..s.body.n {
            c handle[LsCmd] = ls_cmd(vec_get(&s.body, j))
            for k u64 in 0..c.inputs.n {
                x u64 = vec_get(&c.inputs, k)
                p handle[Place] = place(pk_file(x), pk_sec(x))
                p.offset = if s.kind == 8 { s.offset } else { s.offset + p.address - s.address }
                vec_push(&ld.content, x)
            }
        }
    }
}

fn ls_write_phdrs() void fails {
    for i u64 in 1..ld.lscript.phdrs.n + 1 {
        p handle[LsPhdr] = ls_phdr(i)
        if p.first == 0 {
            program_header(i - 1, p.kind, p.flags, 0, 0, 0, 0, 0)
            continue
        }
        first handle[LsSection] = ls_sec(p.first)
        last handle[LsSection] = ls_sec(p.last)
        if last.address + last.size < first.address || last.offset < first.offset {
            try die_c(c"invalid linker-script segment extent")
        }
        fsize u64 = last.offset - first.offset
        if last.kind != 8 { fsize += last.size }
        msize u64 = last.address + last.size - first.address
        program_header(i - 1, p.kind, p.flags, first.offset, first.address, fsize, msize, p.alignment)
        wr64(ld.image, 64 + (i - 1) * 56 + 24, first.address + first.lma)
    }
}

fn ls_fill_gap(s handle[LsSection], first u64, last u64) void {
    if first >= last || s.fill_bytes == 0 { return }
    p addr = ld.image + s.offset + first - s.address
    n u64 = last - first
    word u64 = s.fill
    hi u8 = trunc[u8](word >> 24)
    if word == zext[u64](hi) * 0x01010101 {
        mem_set(p, hi, n)
    } else {
        for i u64 in 0..n { p[u8, i] = trunc[u8](word >> ((3 - (i & 3)) * 8)) }
    }
}

fn ls_fill() void {
    for i u64 in 1..ld.lscript.sections.n + 1 {
        s handle[LsSection] = ls_sec(i)
        if !s.keep || s.kind == 8 { continue }
        if s.fill_bytes == 0 && (s.flags & 4) != 0 {
            s.fill_bytes = 4
            s.fill = 0xcccccccc
        }
        if s.fill_bytes == 0 { continue }
        cursor u64 = s.address
        for j u64 in 0..s.body.n {
            c handle[LsCmd] = ls_cmd(vec_get(&s.body, j))
            for k u64 in 0..c.inputs.n {
                x u64 = vec_get(&c.inputs, k)
                f u64 = pk_file(x)
                si u64 = pk_sec(x)
                at u64 = place(f, si).address
                ls_fill_gap(s, cursor, at)
                cursor = at + sec(obj(f), si).size
            }
        }
        ls_fill_gap(s, cursor, s.address + s.size)
    }
}

fn ls_rela_layout(im handle[LsImage]) void fails {
    im.rela_by_section = heap_alloc_zeroed((ld.lscript.sections.n + 1) * 8)
    if !config().emit_relocs { return }
    for f u64 in 0..ld.ninput_objects {
        o handle[Obj] = obj(f)
        for k u64 in 1..zext[u64](o.nsec) {
            h handle[Sec] = sec(o, k)
            if h.kind != 4 || h.size == 0 || !kept(f, zext[u64](h.info)) { continue }
            p handle[Place] = place(f, zext[u64](h.info))
            si u64 = zext[u64](p.output_index)
            if si == 0 { continue }
            x u64 = im.rela_by_section[u64, si]
            if x == 0 {
                r handle[LsRela] = vec_add(&im.relas)
                r.target = si
                x = im.relas.n
                im.rela_by_section[u64, si] = x
            }
            r handle[LsRela] = vec_at(&im.relas, x - 1)
            r.size = try out_add(r.size, h.size)
        }
    }
}

fn ls_sym_section(f u64, i u64) u64 {
    y handle[Sym] = sym(obj(f), i)
    if f == ld.script_file { return ld.lscript.synth_sections[u64, i] }
    if y.section == 0xfff1 { return 0 }
    return zext[u64](place(f, zext[u64](y.section)).output_index)
}

fn ls_add_sym(im handle[LsImage], f u64, i u64, binding u8, vis u8) void fails {
    y handle[Sym] = sym(obj(f), i)
    offset u64 = 0
    // Keep each symbol's name as a separate string, as ld.lld does.
    if y.name.n != 0 { offset = zext[u64](try add_string(&im.strtab, y.name)) }
    o handle[LsOutSym] = vec_add(&im.symbols)
    o.file = f
    o.symbol = i
    o.section = ls_sym_section(f, i)
    o.name = offset
    o.binding = binding
    o.visibility = vis
    map_addr addr = im.symbol_indices[addr, f]
    map_addr[u32, i] = trunc[u32](im.symbols.n)
}

fn ls_make_symbols(im handle[LsImage]) void fails {
    im.symbol_indices = heap_alloc_zeroed(ld.nobj * 8)
    hidden Vec[u64] = {}
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        im.symbol_indices[addr, f] = heap_alloc_zeroed(zext[u64](o.nsym) * 4 + 4)
        hidden.n = 0
        for i u64 in 1..zext[u64](o.nsym) {
            y handle[Sym] = sym(o, i)
            if y.kind == 3 || !live(f, y) { continue }
            if y.binding == 0 {
                try ls_add_sym(im, f, i, 0, y.visibility)
            } else {
                g handle[GSym] = gsym(gid_of(f, i))
                if g.has_res != 0 && zext[u64](g.res_file) == f && zext[u64](g.res_sym) == i &&
                    (g.res_vis == 1 || g.res_vis == 2) {
                    vec_push(&hidden, i)
                }
            }
        }
        if config().emit_relocs {
            for si u64 in 1..ld.lscript.sections.n + 1 {
                s handle[LsSection] = ls_sec(si)
                if !s.keep || s.count == 0 || s.first_file != f { continue }
                e handle[LsOutSym] = vec_add(&im.symbols)
                e.file = NONE64
                e.section = si
                s.sec_sym = im.symbols.n
            }
        }
        for j u64 in 0..hidden.n {
            i u64 = vec_get(&hidden, j)
            try ls_add_sym(im, f, i, 0, gsym(gid_of(f, i)).res_vis)
        }
    }
    im.local_end = im.symbols.n + 1
    for id u64 in 0..ld.gsyms.n {
        g handle[GSym] = gsym(trunc[u32](id))
        if g.has_res == 0 || g.res_vis == 1 || g.res_vis == 2 { continue }
        f u64 = zext[u64](g.res_file)
        i u64 = zext[u64](g.res_sym)
        y handle[Sym] = sym(obj(f), i)
        if live(f, y) { try ls_add_sym(im, f, i, y.binding, g.res_vis) }
    }
}

fn ls_emit_symbols(im handle[LsImage]) void {
    for j u64 in 0..im.symbols.n {
        s handle[LsOutSym] = vec_at(&im.symbols, j)
        at u64 = im.symtab_offset + (j + 1) * 24
        si u64 = s.section
        shndx u64 = if si == 0 { 0xfff1 } else { ls_sec(si).number }
        wr32(ld.image, at, s.name)
        wr16(ld.image, at + 6, shndx)
        if s.file == NONE64 {
            wr8(ld.image, at + 4, 3)
            wr64(ld.image, at + 8, ls_sec(si).address)
        } else {
            y handle[Sym] = sym(obj(s.file), s.symbol)
            wr8(ld.image, at + 4, (zext[u64](s.binding) << 4) | zext[u64](y.kind))
            wr8(ld.image, at + 5, zext[u64](s.visibility))
            wr64(ld.image, at + 8, sym_address(s.file, y))
            wr64(ld.image, at + 16, y.size)
        }
    }
    mem_copy(ld.image + im.strtab_offset, im.strtab.p, im.strtab.n)
    mem_copy(ld.image + im.shstrtab_offset, im.shstrtab.p, im.shstrtab.n)
}

fn ls_emit_relas(im handle[LsImage]) void {
    if !config().emit_relocs { return }
    for f u64 in 0..ld.ninput_objects {
        o handle[Obj] = obj(f)
        for i u64 in 0..zext[u64](o.nrel) {
            r handle[Rel] = rel(o, i)
            p handle[Place] = place(f, zext[u64](r.target))
            if p.valid == 0 { continue }
            si u64 = zext[u64](p.output_index)
            x u64 = im.rela_by_section[u64, si]
            if x == 0 { continue }
            re handle[LsRela] = vec_at(&im.relas, x - 1)
            at u64 = re.offset + re.cursor
            re.cursor += 24
            addend u64 = r.addend
            index u64 = 0
            kind u64 = zext[u64](r.kind)
            df u64 = 0
            ds u64 = 0
            if definition(f, zext[u64](r.symbol), &df, &ds) {
                y handle[Sym] = sym(obj(df), ds)
                if y.kind == 3 && y.section != 0xfff1 {
                    if live(df, y) {
                        src handle[Place] = place(df, zext[u64](y.section))
                        target handle[LsSection] = ls_sec(zext[u64](src.output_index))
                        index = target.sec_sym
                        addend += src.address + y.value - target.address
                    } else {
                        // A discarded input section has no output section symbol.
                        kind = 0
                    }
                } else {
                    m addr = im.symbol_indices[addr, df]
                    index = zext[u64](m[u32, ds])
                }
            }
            wr64(ld.image, at, p.address + r.offset)
            wr64(ld.image, at + 8, (index << 32) | kind)
            wr64(ld.image, at + 16, addend)
        }
    }
}

// Support the kernel's metadata placeholders at the tail of SECTIONS.
fn ls_explicit_metadata() bool fails {
    names handle[BytesU32Map] = &ld.lscript.section_names
    symtab u64 = ls_lookup(names, bytes_c(c".symtab"))
    strtab u64 = ls_lookup(names, bytes_c(c".strtab"))
    shstrtab u64 = ls_lookup(names, bytes_c(c".shstrtab"))
    if symtab == 0 && strtab == 0 && shstrtab == 0 { return false }
    if symtab == 0 || symtab >= strtab || strtab >= shstrtab {
        try refuse(c"scripted metadata requires .symtab, .strtab, .shstrtab in order")
    }
    for i u64 in symtab..ld.lscript.sections.n + 1 {
        s handle[LsSection] = ls_sec(i)
        if s.keep { try refuse(c"scripted metadata must follow all content sections") }
        if i != symtab && i != strtab && i != shstrtab { continue }
        if s.addr_expr == 0 || s.align_expr != 0 || s.lma_expr != 0 || s.info ||
            s.mentioned || s.phdrs.n != 0 || s.fill_bytes != 0 || s.body.n != 1 {
            try refuse(c"unsupported scripted metadata section attributes")
        }
        e handle[LsExpr] = ls_expr(s.addr_expr)
        c handle[LsCmd] = ls_cmd(vec_get(&s.body, 0))
        if e.kind != LS_NUMBER || e.number != 0 || c.kind != LS_INPUT || c.patterns.n != 1 {
            try refuse(c"unsupported scripted metadata section body")
        }
        p handle[LsPattern] = vec_at(&c.patterns, 0)
        if p.sorted || !bytes_eq(p.name, s.name) { try refuse(c"unsupported scripted metadata section pattern") }
    }
    return true
}

fn ls_image_layout(im handle[LsImage]) void fails {
    sc handle[Lscript] = &ld.lscript
    im.section_names = heap_alloc_zeroed((sc.sections.n + 1) * 4)
    buf_u8(&im.strtab, 0)
    buf_u8(&im.shstrtab, 0)
    try ls_make_symbols(im)
    n u64 = 1
    for i u64 in 1..sc.sections.n + 1 {
        s handle[LsSection] = ls_sec(i)
        if !s.keep { continue }
        im.section_names[u32, i] = try add_string(&im.shstrtab, s.name)
        n += 1
    }
    im.symtab_name = zext[u64](try add_string(&im.shstrtab, bytes_c(c".symtab")))
    im.symtab_section = n
    im.symtab_offset = try out_align(sc.file_end, 8)
    im.symtab_size = (im.symbols.n + 1) * 24
    after_symtab u64 = try out_add(im.symtab_offset, im.symtab_size)
    // The kernel explicitly places .strtab before .shstrtab. With neither
    // mentioned, follow the default metadata order used by ld.lld.
    explicit_strtab bool = try ls_explicit_metadata()
    if explicit_strtab {
        im.strtab_name = zext[u64](try add_string(&im.shstrtab, bytes_c(c".strtab")))
        im.shstrtab_name = zext[u64](try add_string(&im.shstrtab, bytes_c(c".shstrtab")))
        im.strtab_section = n + 1
        im.shstrtab_section = n + 2
    } else {
        im.shstrtab_name = zext[u64](try add_string(&im.shstrtab, bytes_c(c".shstrtab")))
        im.strtab_name = zext[u64](try add_string(&im.shstrtab, bytes_c(c".strtab")))
        im.shstrtab_section = n + 1
        im.strtab_section = n + 2
    }
    for i u64 in 0..im.relas.n {
        r handle[LsRela] = vec_at(&im.relas, i)
        name Bytes = ls_sec(r.target).name
        r.name = im.shstrtab.n
        bs(&im.shstrtab, c".rela")
        bb(&im.shstrtab, name)
        buf_u8(&im.shstrtab, 0)
    }
    cursor u64 = 0
    if explicit_strtab {
        im.strtab_offset = after_symtab
        im.shstrtab_offset = try out_add(im.strtab_offset, im.strtab.n)
        cursor = try out_add(im.shstrtab_offset, im.shstrtab.n)
    } else {
        im.shstrtab_offset = after_symtab
        im.strtab_offset = try out_add(im.shstrtab_offset, im.shstrtab.n)
        cursor = try out_add(im.strtab_offset, im.strtab.n)
    }
    for i u64 in 0..im.relas.n {
        r handle[LsRela] = vec_at(&im.relas, i)
        r.offset = try out_align(cursor, 8)
        cursor = try out_add(r.offset, r.size)
    }
    im.shoff = try out_align(cursor, 8)
    im.section_count = n + 3 + im.relas.n
    if im.section_count >= 0xff00 || sc.phdrs.n >= 0xffff { try refuse(c"extended ELF header counts in scripted output") }
    ld.image_size = try out_add(im.shoff, im.section_count * 64)
    ld.image = heap_alloc_zeroed(ld.image_size + 8)
}

fn ls_write_shdrs(im handle[LsImage]) void {
    for i u64 in 1..ld.lscript.sections.n + 1 {
        s handle[LsSection] = ls_sec(i)
        if !s.keep { continue }
        section_header(im.shoff + s.number * 64, zext[u64](im.section_names[u32, i]),
            zext[u64](s.kind), s.flags, s.address, s.offset, s.size, 0, 0, s.alignment, s.entsize)
    }
    section_header(im.shoff + im.symtab_section * 64, im.symtab_name, 2, 0, 0,
        im.symtab_offset, im.symtab_size, im.strtab_section, im.local_end, 8, 24)
    section_header(im.shoff + im.strtab_section * 64, im.strtab_name, 3, 0, 0,
        im.strtab_offset, im.strtab.n, 0, 0, 1, 0)
    section_header(im.shoff + im.shstrtab_section * 64, im.shstrtab_name, 3, 0, 0,
        im.shstrtab_offset, im.shstrtab.n, 0, 0, 1, 0)
    first_rela u64 = im.section_count - im.relas.n
    for i u64 in 0..im.relas.n {
        r handle[LsRela] = vec_at(&im.relas, i)
        section_header(im.shoff + (first_rela + i) * 64, r.name, 4, 0x40, 0,
            r.offset, r.size, im.symtab_section, ls_sec(r.target).number, 8, 24)
    }
}
