// The static executable: a port of the Static paths of
// src/linker/static_link.ml, got.ml and merge_sections.ml, and of
// File_io.publish.

// ---------- per-object tables ----------

fn alloc_tables() void {
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        l handle[Lx] = lx(f)
        n u64 = zext[u64](o.nsec)
        // Section_gc: every section not discarded, or under --gc-sections
        // only the non-allocated ones; gc_sections marks the rest
        gc bool = config().gc_sections
        l.kept = heap_alloc_zeroed(n + 1)
        for k u64 in 0..n {
            if l.discarded[u8, k] != 0 { continue }
            if !gc || (sec(o, k).flags & 2) == 0 { l.kept[u8, k] = 1 }
        }
        l.alias = heap_alloc_zeroed(n * 8 + 8)
    }
}

// the defining (file, symbol) of a symbol: itself when local, else the
// resolved definition; false when there is none
fn definition(f u64, i u64, out_file addr, out_sym addr) bool {
    y handle[Sym] = sym(obj(f), i)
    if y.binding == 0 {
        out_file[u64] = f
        out_sym[u64] = i
        return true
    }
    id u32 = gid_of(f, i)
    if id == NONE { return false }
    g handle[GSym] = gsym(id)
    if g.has_res == 0 { return false }
    out_file[u64] = zext[u64](g.res_file)
    out_sym[u64] = zext[u64](g.res_sym)
    return true
}

// Hashtbl.mem definitions name, for any symbol (locals look up by name too)
fn name_defined(name Bytes) bool {
    id u32 = find(name)
    return id != NONE && gsym(id).has_res != 0
}

fn check_legacy_sections() void fails {
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for k u64 in 0..zext[u64](o.nsec) {
            s handle[Sec] = sec(o, k)
            if s.size != 0 && (s.flags & 2) != 0 && lx(f).discarded[u8, k] == 0 &&
                (bytes_is(s.name, c".ctors") || bytes_prefix(s.name, c".ctors.") ||
                    bytes_is(s.name, c".dtors") || bytes_prefix(s.name, c".dtors.")) {
                m handle[Buf] = msg()
                bb(m, o.path)
                bs(m, c": legacy lifecycle section ")
                bb(m, s.name)
                bs(m, c" is unsupported in final output; use .init_array/.fini_array")
                try die()
            }
        }
    }
}

fn check_non_alloc_references() void fails {
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for k u64 in 0..zext[u64](o.nrel) {
            r handle[Rel] = rel(o, k)
            t u64 = zext[u64](r.target)
            if r.kind == 0 || !kept(f, t) || (sec(o, t).flags & 2) == 0 { continue }
            df u64 = 0
            ds u64 = 0
            if !definition(f, zext[u64](r.symbol), &df, &ds) { continue }
            d handle[Sym] = sym(obj(df), ds)
            if d.section != 0 && d.section < 0xff00 && (sec(obj(df), zext[u64](d.section)).flags & 2) == 0 {
                m handle[Buf] = msg()
                bb(m, o.path)
                bs(m, c": allocatable section ")
                bb(m, sec(o, t).name)
                bs(m, c" references non-allocatable symbol ")
                bb(m, d.name)
                try die()
            }
        }
    }
}

// ---------- the GOT ----------

// Got.canonical_ifuncs: IFUNC definitions whose address is taken by PC32

const GM_ADDRESS u8 = 0
const GM_THREAD u8 = 1              // Thread_offset
const GM_MODULE_ID u8 = 2
const GM_DYNAMIC_OFFSET u8 = 3
const GM_LOCAL_MODULE u8 = 4
const GM_LOCAL_OFFSET u8 = 5
const GM_DESCRIPTOR u8 = 6
const GM_DESCRIPTOR_ARGUMENT u8 = 7
const GM_IFUNC u8 = 8

fn got_relocation(kind u32) bool {
    return kind == 9 || kind == 19 || kind == 20 || kind == 22 || kind == 34 || kind == 41 || kind == 42
}

fn base_relocation(kind u32) bool { return kind == 26 || kind == 29 }

// Hashtbl.mem resolved.imports
fn dyn_imported(name Bytes) bool { return ld.imps.n != 0 && import_id(name) != NONE }

fn got_prepare(static_ifunc bool) void fails {
    canon handle[U64Map] = &ld.got_canonical
    indices U64Map = {}
    ih handle[U64Map] = &indices
    needs_base bool = false
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        l handle[Lx] = lx(f)
        l.gotref = heap_alloc(zext[u64](o.nrel) * 4 + 4)
        for k u64 in 0..zext[u64](o.nrel) {
            r handle[Rel] = rel(o, k)
            l.gotref[u32, k] = NONE
            if base_relocation(r.kind) { needs_base = true }
            si u64 = zext[u64](r.symbol)
            t u64 = zext[u64](r.target)
            wanted bool = got_relocation(r.kind)
            if !wanted && !static_ifunc && (r.kind == 4 || r.kind == 2) && (sec(o, t).flags & 2) != 0 {
                ifn bool = is_ifunc(f, si)
                if (r.kind == 4 || (!bytes_is(sec(o, t).name, c".eh_frame") && ifn)) &&
                    (ifn || (sym(o, si).binding != 0 && dyn_imported(sym(o, si).name))) {
                    wanted = true
                }
            }
            if !wanted || !kept(f, t) { continue }
            if r.kind == 2 && is_ifunc(f, si) {
                df u64 = 0
                ds u64 = 0
                if definition(f, si, &df, &ds) { map_put(canon, pk(df, ds), 1) }
            }
            key u64 = 0
            if si == 0 || r.kind == 20 {
                key = NONE64
            } else if sym(o, si).binding == 0 {
                key = (1 << 63) | pk(f, si)
            } else {
                key = zext[u64](gid_of(f, si))
            }
            model u8 = GM_ADDRESS
            if r.kind == 19 {
                model = GM_MODULE_ID
            } else if r.kind == 20 {
                model = GM_LOCAL_MODULE
            } else if r.kind == 22 {
                model = GM_THREAD
            } else if r.kind == 34 {
                model = GM_DESCRIPTOR
            } else if (r.kind == 2 || r.kind == 4) && is_ifunc(f, si) {
                model = GM_IFUNC
            }
            // the (key, model) pair: the model in bits 56..63
            key = key ^ (zext[u64](model) << 56)
            a addr = map_val_addr(ih, key)
            slot u32 = 0
            if a == null {
                slot = trunc[u32](ld.got_slots.n)
                map_put(ih, key, slot)
                vec_push(&ld.got_slots, pk(f, si))
                vec_push(&ld.got_model, model)
                if r.kind == 19 || r.kind == 20 || r.kind == 34 {
                    vec_push(&ld.got_slots, pk(f, si))
                    second u8 = GM_LOCAL_OFFSET
                    if r.kind == 19 {
                        second = GM_DYNAMIC_OFFSET
                    } else if r.kind == 34 {
                        second = GM_DESCRIPTOR_ARGUMENT
                    }
                    vec_push(&ld.got_model, second)
                }
            } else {
                slot = a[u32]
            }
            l.gotref[u32, k] = slot
        }
    }
    map_free(ih)
    if ld.predefined_file != NONE64 {
        id u32 = find(bytes_c(c"_GLOBAL_OFFSET_TABLE_"))
        if id != NONE && gsym(id).has_res != 0 && zext[u64](gsym(id).res_file) == ld.predefined_file { needs_base = true }
    }
    if ld.got_slots.n == 0 && !needs_base { return }
    size u64 = ld.got_slots.n * 8
    file u64 = ld.nobj
    o handle[Obj] = try new_object(c"<GOT>")
    stat_add(ST_GOT_ENTRIES, ld.got_slots.n)
    o.nsec = 2
    o.secs = heap_alloc_zeroed(2 * sizeof[Sec])
    n0 handle[Sec] = sec(o, 0)
    n0.alignment = 8
    n0.group = -1
    g handle[Sec] = sec(o, 1)
    g.name = bytes_c(c".got")
    g.kind = 1
    g.flags = 3
    g.size = size
    g.alignment = 8
    g.entsize = 8
    g.group = -1
    o.data = heap_alloc_zeroed(size + 1)
    o.len = size
    o.nsym = 1
    o.syms = heap_alloc_zeroed(sizeof[Sym])
    l handle[Lx] = lx(file)
    l.discarded = heap_alloc_zeroed(2)
    l.gid = heap_alloc_zeroed(4)
    l.gid[u32, 0] = NONE
    l.kept = heap_alloc_zeroed(2)
    l.kept[u8, 1] = 1
    l.alias = heap_alloc_zeroed(16)
    l.gotref = heap_alloc_zeroed(4)
    ld.got_file = file
}

// ---------- merged sections (Merge_sections.plan) ----------

// Merge_sections' key: (name, flags, entsize, alignment, bytes)
fn merge_hash(o_file u64, s handle[Sec]) u64 {
    return hash_mix(bytes_hash(s.name) ^ bytes_hash(bytes(sec_data(o_file, s), s.size)) ^
        hash_mix((s.flags & ~0x200) ^ (s.entsize << 20) ^ (s.alignment << 40)))
}

fn merge_same(o_file u64, s handle[Sec], x u64) bool {
    c_file u64 = pk_file(x)
    co handle[Obj] = obj(c_file)
    c handle[Sec] = sec(co, pk_sec(x))
    return (c.flags & ~0x200) == (s.flags & ~0x200) && c.entsize == s.entsize && c.alignment == s.alignment &&
        c.size == s.size && bytes_eq(c.name, s.name) && mem_eq(sec_data(c_file, c), sec_data(o_file, s), s.size)
}

fn merge_plan() void {
    index KeyIndex = {}
    canonical Vec[u64] = {}
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        n u64 = zext[u64](o.nsec)
        relocated addr = heap_alloc_zeroed(n + 1)
        for k u64 in 0..zext[u64](o.nrel) {
            r handle[Rel] = rel(o, k)
            if r.kind != 0 { relocated[u8, zext[u64](r.target)] = 1 }
        }
        for k u64 in 0..n {
            s handle[Sec] = sec(o, k)
            if !kept(f, k) || s.kind != 1 || (s.flags & 0x11) != 0x10 || s.size == 0 ||
                registry_eligible(s) || relocated[u8, k] != 0 {
                continue
            }
            hash u64 = merge_hash(f, s)
            id u32 = kx_first(&index, hash)
            while id != NONE && !merge_same(f, s, canonical.p[u64, zext[u64](id)]) { id = kx_next(&index, id) }
            if id == NONE {
                kx_add(&index, hash, trunc[u32](canonical.n))
                vec_push(&canonical, pk(f, k))
            } else {
                lx(f).alias[u64, k] = canonical.p[u64, zext[u64](id)] + 1
                stat_add(ST_MERGED_SECTIONS, 1)
                stat_add(ST_MERGED_BYTES, s.size)
            }
        }
        heap_free(relocated)
    }
    kx_free(&index)
    vec_free(&canonical)
}

// ---------- symbol values ----------

fn get_placement(f u64, s u64) handle[Place] fails {
    p handle[Place] = place(f, s)
    if p.valid == 0 {
        m handle[Buf] = msg()
        bb(m, obj(f).path)
        bs(m, c": symbol references a section excluded from output")
        try die()
    }
    return p
}

fn live(f u64, y handle[Sym]) bool {
    if y.section == 0xfff1 { return true }
    if y.section == 0 || y.section >= 0xff00 { return false }
    k u64 = zext[u64](y.section)
    kind u32 = sec(obj(f), k).kind
    return (kind == 1 || kind == 7 || kind == 8 || kind == 14 || kind == 15 || kind == 16) &&
        kept(f, k) && place(f, k).valid != 0
}

// for live symbols only (their placement exists)
fn sym_address(f u64, y handle[Sym]) u64 {
    if y.section == 0xfff1 { return y.value }
    if y.kind == 6 {
        if ld.module_base != NONE64 && f == pk_file(ld.module_base) && handle_addr(y) == handle_addr(sym(obj(f), pk_sec(ld.module_base))) { return 0 }
        return place(f, zext[u64](y.section)).address - (ld.lay_base + ld.tls_seg.offset) + y.value
    }
    return place(f, zext[u64](y.section)).address + y.value
}

// values: per object, a u64 per symbol and a u8 "has a value"
struct Values {
    v addr
    has addr
}


fn vals(f u64) handle[Values] { return handle_from_addr(ld.values + f * sizeof[Values]) }

fn values_job(ctx addr, b u64, e u64, worker u32) void {
    for f u64 in b..e {
        o handle[Obj] = obj(f)
        n u64 = zext[u64](o.nsym)
        vv handle[Values] = vals(f)
        vv.v = heap_alloc_zeroed(n * 8 + 8)
        vv.has = heap_alloc_zeroed(n + 1)
        if n != 0 { vv.has[u8, 0] = 1 }
        for i u64 in 1..n {
            y handle[Sym] = sym(o, i)
            if y.binding == 0 {
                if live(f, y) {
                    vv.v[u64, i] = sym_address(f, y)
                    vv.has[u8, i] = 1
                }
                continue
            }
            g handle[GSym] = gsym(gid_of(f, i))
            if g.has_res != 0 {
                df u64 = zext[u64](g.res_file)
                d handle[Sym] = sym(obj(df), zext[u64](g.res_sym))
                if live(df, d) {
                    vv.v[u64, i] = sym_address(df, d)
                    vv.has[u8, i] = 1
                }
            } else if g.imp != 0 || (y.binding == 2 && g.strong == 0) {
                // an import's value is 0 (dynamic output only has imports)
                vv.has[u8, i] = 1
            }
        }
    }
}

// ---------- predefined symbols ----------

fn seg_ending(text_only bool, memory bool) u64 {
    value u64 = ld.lay_base + ld.lay_page
    for i u64 in 0..ld.segments.n {
        s handle[Seg] = vec_at(&ld.segments, i)
        if text_only && (s.flags & 1) == 0 { continue }
        e u64 = ld.lay_base + s.offset + (if memory { s.memory_size } else { s.file_size })
        value = umax(value, e)
    }
    return value
}

fn array_boundary(kind u32, last bool) u64 {
    found bool = false
    value u64 = 0
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for k u64 in 0..zext[u64](o.nsec) {
            s handle[Sec] = sec(o, k)
            if s.kind != kind { continue }
            p handle[Place] = place(f, k)
            if p.valid == 0 { continue }
            a u64 = p.address + (if last { s.size } else { 0 })
            if !found {
                value = a
                found = true
            } else if last {
                value = umax(value, a)
            } else {
                value = umin(value, a)
            }
        }
    }
    return value
}

fn predefined_value(n Bytes) u64 {
    if bytes_is(n, c"__executable_start") || bytes_is(n, c"__ehdr_start") { return ld.lay_base }
    if bytes_is(n, c"__rela_iplt_start") { return ifunc_boundary(false) }
    if bytes_is(n, c"__rela_iplt_end") { return ifunc_boundary(true) }
    if bytes_is(n, c"__bss_start") || bytes_is(n, c"_edata") || bytes_is(n, c"edata") { return seg_ending(false, false) }
    if bytes_is(n, c"_etext") || bytes_is(n, c"etext") { return seg_ending(true, true) }
    if bytes_is(n, c"_end") || bytes_is(n, c"end") { return seg_ending(false, true) }
    if bytes_is(n, c"__preinit_array_start") { return array_boundary(16, false) }
    if bytes_is(n, c"__preinit_array_end") { return array_boundary(16, true) }
    if bytes_is(n, c"__init_array_start") { return array_boundary(14, false) }
    if bytes_is(n, c"__init_array_end") { return array_boundary(14, true) }
    if bytes_is(n, c"__fini_array_start") { return array_boundary(15, false) }
    if bytes_is(n, c"__fini_array_end") { return array_boundary(15, true) }
    if bytes_is(n, c"_GLOBAL_OFFSET_TABLE_") { return place(ld.got_file, 1).address }
    if bytes_is(n, c"_DYNAMIC") { return place(ld.dyn_file, DYN_DYNAMIC).address }
    last u8 = 0
    section Bytes = boundary(n, &last)
    // the last output header with that name
    k u64 = ld.headers.n
    while k > 0 {
        k -= 1
        o handle[OutSec] = vec_at(&ld.headers, k)
        if bytes_eq(o.name, section) {
            return o.address + (if last != 0 { o.size } else { 0 })
        }
    }
    return 0
}

fn set_predefined() void {
    if ld.predefined_file == NONE64 { return }
    o handle[Obj] = obj(ld.predefined_file)
    for i u64 in 1..zext[u64](o.nsym) {
        y handle[Sym] = sym(o, i)
        y.value = predefined_value(y.name)
    }
}

// ---------- relocations (X86_64.apply_lazy) ----------

fn reloc_name(b handle[Buf], kind u32) void {
    s addr = null
    switch kind {
        case 0: s = c"NONE"
        case 1: s = c"64"
        case 2: s = c"PC32"
        case 4: s = c"PLT32"
        case 9: s = c"GOTPCREL"
        case 17: s = c"DTPOFF64"
        case 19: s = c"TLSGD"
        case 20: s = c"TLSLD"
        case 21: s = c"DTPOFF32"
        case 22: s = c"GOTTPOFF"
        case 23: s = c"TPOFF32"
        case 24: s = c"PC64"
        case 26: s = c"GOTPC32"
        case 29: s = c"GOTPC64"
        case 34: s = c"GOTPC32_TLSDESC"
        case 35: s = c"TLSDESC_CALL"
        case 41: s = c"GOTPCRELX"
        case 42: s = c"REX_GOTPCRELX"
        case 10: s = c"32"
        case 11: s = c"32S"
        default:
    }
    if s == null {
        bs(b, c"x86-64 relocation ")
        bu(b, zext[u64](kind))
    } else {
        bs(b, c"R_X86_64_")
        bs(b, s)
    }
}

// "path: section+0xoffset referencing name"
fn reloc_context(b handle[Buf], f u64, r handle[Rel]) void {
    o handle[Obj] = obj(f)
    buf_clear(b)
    bb(b, o.path)
    bs(b, c": ")
    bb(b, sec(o, zext[u64](r.target)).name)
    bs(b, c"+0x")
    bx(b, r.offset)
    bs(b, c" referencing ")
    y handle[Sym] = sym(o, zext[u64](r.symbol))
    if y.name.n == 0 {
        bs(b, c"symbol #")
        bu(b, zext[u64](r.symbol))
    } else {
        bb(b, y.name)
    }
}


// Relocates one object; on failure its message is in the object's msg and
// the result is false. The OCaml linker stops at the first failure in
// (file, relocation) order: each object stops at its own first one, and
// the caller reports the lowest object's.
fn relocate_object(f u64) bool {
    o handle[Obj] = obj(f)
    m handle[Buf] = &o.msg
    vv handle[Values] = vals(f)
    got_address u64 = if ld.got_file != NONE64 { place(ld.got_file, 1).address } else { 0 }
    for k u64 in 0..zext[u64](o.nrel) {
        r handle[Rel] = rel(o, k)
        t u64 = zext[u64](r.target)
        if r.kind == 0 || r.kind == 35 || !kept(f, t) { continue }
        target handle[Place] = place(f, t)
        if target.valid == 0 {
            buf_clear(m)
            bb(m, o.path)
            bs(m, c": symbol references a section excluded from output")
            return false
        }
        ts handle[Sec] = sec(o, t)
        si u64 = zext[u64](r.symbol)
        y handle[Sym] = sym(o, si)
        value u64 = 0
        stub bool = !bytes_is(ts.name, c".eh_frame") && !got_relocation(r.kind) && !base_relocation(r.kind) &&
            ifunc_stub(f, si, &value)
        if !stub && ld.dyn_file != NONE64 && !config().has_script {
            if (r.kind == 4 || r.kind == 2) && lx(f).gotref[u32, k] != NONE {
                stub = dyn_stub_address(lx(f).gotref[u32, k], &value)
            } else if r.kind == 1 && canonical_ifunc(f, si) {
                stub = dyn_ifunc_stub(f, si, &value)
            }
        }
        if stub {
        } else if base_relocation(r.kind) {
            value = got_address
        } else if got_relocation(r.kind) {
            value = got_address + zext[u64](lx(f).gotref[u32, k]) * 8
        } else if vv.has[u8, si] != 0 {
            value = vv.v[u64, si]
        } else if (y.section != 0 || name_defined(y.name)) &&
            ((ts.flags & 2) == 0 || bytes_is(ts.name, c".eh_frame")) {
            value = 0
        } else {
            reloc_context(m, f, r)
            bs(m, c": undefined symbol ")
            bb(m, y.name)
            return false
        }
        if r.kind == 23 && !thread_offset(m, value, &value) { return false }
        addend u64 = r.addend
        if (bytes_is(ts.name, c".eh_frame") || bytes_is(ts.name, c".note.stapsdt")) && vv.has[u8, si] == 0 {
            addend = 0
        }
        width u64 = relocation_width(r.kind)
        if width == 99 {
            reloc_context(m, f, r)
            bs(m, c": unsupported ")
            reloc_name(m, r.kind)
            return false
        }
        offset u64 = target.offset + r.offset
        if offset > ld.image_size || width > ld.image_size - offset {
            reloc_context(m, f, r)
            bs(m, c": byte range (")
            bu(m, offset)
            bs(m, c", ")
            bu(m, width)
            bs(m, c") exceeds size ")
            bu(m, ld.image_size)
            return false
        }
        x u64 = value + addend
        kind u32 = r.kind
        if kind == 2 || kind == 4 || kind == 24 || got_relocation(kind) || base_relocation(kind) {
            x = x - (target.address + r.offset)
        }
        sx i64 = bitcast[i64](x)
        fits bool = true
        if kind == 1 || kind == 17 || kind == 24 || kind == 29 {
            fits = true
        } else if kind == 10 {
            fits = x <= 0xffffffff
        } else {
            fits = sx >= -2147483648 && sx <= 2147483647
        }
        if !fits {
            reloc_context(m, f, r)
            bs(m, c": ")
            reloc_name(m, kind)
            bs(m, c" overflow: result 0x")
            bx(m, x)
            return false
        }
        if width == 8 {
            wr64(ld.image, offset, x)
        } else if width == 4 {
            wr32(ld.image, offset, x)
        } else if width == 2 {
            wr16(ld.image, offset, x)
        } else if width == 1 {
            wr8(ld.image, offset, x)
        }
    }
    return true
}

fn relocate_object_32(f u64) bool {
    o handle[Obj] = obj(f)
    m handle[Buf] = &o.msg
    vv handle[Values] = vals(f)
    for k u64 in 0..zext[u64](o.nrel) {
        r handle[Rel] = rel(o, k)
        t u64 = zext[u64](r.target)
        kind u32 = r.kind
        if kind == 0 || !kept(f, t) { continue }
        target handle[Place] = place(f, t)
        si u64 = zext[u64](r.symbol)
        y handle[Sym] = sym(o, si)
        if kind != 10 && vv.has[u8, si] == 0 &&
            ((sec(o, t).flags & 2) != 0 || !(y.section != 0 || name_defined(y.name))) {
            reloc_context(m, f, r)
            bs(m, c": undefined symbol ")
            bb(m, y.name)
            return false
        }
        x u64 = vv.v[u64, si] + r.addend
        if kind == 9 { x -= dyn_place(DYN_GOTPLT).address }
        if kind == 10 { x = dyn_place(DYN_GOTPLT).address + r.addend }
        pc_relative bool = kind == 2 || kind == 4 || kind == 10 || kind == 21 || kind == 23
        if pc_relative { x -= target.address + r.offset }
        width u64 = reloc32_width(kind)
        if width < 4 {
            sx i64 = bitcast[i64](x)
            limit i64 = 1 << (width * 8 - 1)
            upper i64 = if pc_relative { limit } else { limit * 2 }
            if sx < 0 - limit || sx >= upper {
                reloc_context(m, f, r)
                bs(m, c": i386 relocation ")
                bu(m, zext[u64](kind))
                bs(m, c" overflow: result 0x")
                bx(m, x)
                return false
            }
        }
        offset u64 = target.offset + r.offset
        if target.valid == 0 || offset > ld.image_size || width > ld.image_size - offset {
            reloc_context(m, f, r)
            bs(m, c": relocation exceeds its output section")
            return false
        }
        if width == 4 { wr32(ld.image, offset, x) }
        else if width == 2 { wr16(ld.image, offset, x) }
        else { wr8(ld.image, offset, x) }
    }
    return true
}

fn relocate_job(ctx addr, b u64, e u64, worker u32) void {
    for f u64 in b..e {
        ok bool = if config().elf32 { relocate_object_32(f) } else { relocate_object(f) }
        lx(f).status = if ok { 0 } else { 1 }
    }
}

// copies every placed section's bytes into the image
fn blit_job(ctx addr, b u64, e u64, worker u32) void {
    for i u64 in b..e {
        x u64 = ld.content.p[u64, i]
        f u64 = pk_file(x)
        k u64 = pk_sec(x)
        s handle[Sec] = sec(obj(f), k)
        if s.kind == 8 || s.size == 0 { continue }
        mem_copy(ld.image + place(f, k).offset, sec_data(f, s), s.size)
    }
}

// ---------- the image ----------

struct SymOut {
    file u32
    name u32       // strtab offset
    sym u64
}

fn add_string(b handle[Buf], s Bytes) u32 fails {
    offset u64 = b.n
    try out_add(offset, s.n + 1)
    bb(b, s)
    buf_u8(b, 0)
    return trunc[u32](offset)
}

fn section_header(at u64, name u64, kind u64, flags u64, address u64, offset u64, size u64,
    link u64, info u64, alignment u64, entsize u64) void {
    wr32(ld.image, at, name)
    wr32(ld.image, at + 4, kind)
    wr64(ld.image, at + 8, flags)
    wr64(ld.image, at + 16, address)
    wr64(ld.image, at + 24, offset)
    wr64(ld.image, at + 32, size)
    wr32(ld.image, at + 40, link)
    wr32(ld.image, at + 44, info)
    wr64(ld.image, at + 48, alignment)
    wr64(ld.image, at + 56, entsize)
}

fn program_header(index u64, kind u64, flags u64, offset u64, address u64, file_size u64,
    memory_size u64, alignment u64) void {
    at u64 = 64 + index * 56
    wr32(ld.image, at, kind)
    wr32(ld.image, at + 4, flags)
    wr64(ld.image, at + 8, offset)
    wr64(ld.image, at + 16, address)
    wr64(ld.image, at + 24, address)
    wr64(ld.image, at + 32, file_size)
    wr64(ld.image, at + 40, memory_size)
    wr64(ld.image, at + 48, alignment)
}

fn entry_address() u64 fails {
    c handle[Config] = config()
    if c.mode == MODE_SHARED { return 0 }
    entry Bytes = c.entry
    id u32 = find(entry)
    if id == NONE || gsym(id).has_res == 0 {
        m handle[Buf] = msg()
        bs(m, c"undefined entry symbol ")
        bb(m, entry)
        try die()
    }
    g handle[GSym] = gsym(id)
    f u64 = zext[u64](g.res_file)
    y handle[Sym] = sym(obj(f), zext[u64](g.res_sym))
    if y.kind == 10 {
        m handle[Buf] = msg()
        bs(m, c"entry symbol ")
        bb(m, entry)
        bs(m, c" cannot be an IFUNC")
        try die()
    }
    if y.section == 0xfff1 {
        m handle[Buf] = msg()
        bs(m, c"entry symbol ")
        bb(m, entry)
        bs(m, c" must be defined in executable code")
        try die()
    }
    s handle[Sec] = sec(obj(f), zext[u64](y.section))
    if (s.flags & 6) != 6 || y.value >= s.size {
        m handle[Buf] = msg()
        bs(m, c"entry symbol ")
        bb(m, entry)
        bs(m, c" must be inside an executable section")
        try die()
    }
    return (try get_placement(f, zext[u64](y.section))).address + y.value
}


fn shdeps_find_def(name Bytes) i32 {
    id u32 = find(name)
    if id == NONE { return -1 }
    g handle[GSym] = gsym(id)
    if g.has_res == 0 || (g.res_vis != 0 && g.res_vis != 3) { return -1 }
    return zext[i32](sym(obj(zext[u64](g.res_file)), zext[u64](g.res_sym)).kind)
}

fn shdeps_defined_cb(name Bytes, version Bytes) i32 {
    if version.n == SH_NONE { return shdeps_find_def(name) }
    b Buf = {}
    bb(&b, name)
    buf_u8(&b, 64)
    bb(&b, version)
    k i32 = shdeps_find_def(buf_bytes(&b))
    buf_free(&b)
    if k >= 0 { return k }
    id u32 = find(name)
    if id != NONE {
        key Bytes = {}
        if sv_version(id, &key) != NONE64 { return -1 }
    }
    return shdeps_find_def(name)
}

fn build_image() void fails {
    c handle[Config] = config()
    phase_begin(PH_EMIT, &ld.emit_start)
    try check_legacy_sections()
    tls_prepare()
    symver_plan()
    try shared_output_prepare()
    try shdeps_validate[shdeps_defined_cb](&ld.shdeps_graph)
    ut PhaseStart = {}
    phase_begin(PH_UNWIND, &ut)
    try unwind_normalize()
    phase_end(PH_UNWIND, &ut)
    gt PhaseStart = {}
    phase_begin(PH_GC, &gt)
    alloc_tables()
    if c.gc_sections { gc_sections() }
    if ld.stats_on {
        // Section_gc counts the discarded progbits/nobits/array sections
        for f u64 in 0..ld.nobj {
            o handle[Obj] = obj(f)
            for k u64 in 0..zext[u64](o.nsec) {
                kd u32 = sec(o, k).kind
                if (kd == 1 || kd == 7 || kd == 8 || kd == 14 || kd == 15 || kd == 16) && !kept(f, k) {
                    stat_add(ST_DISCARDED_SECTIONS, 1)
                }
            }
        }
    }
    phase_end(PH_GC, &gt)
    try copy_prepare()
    try check_non_alloc_references()
    try tls_validate()
    if c.mode == MODE_STATIC_PIE { relax_static_pie() }
    try properties_prepare()
    try build_id_prepare()
    try got_prepare(c.mode == MODE_STATIC)
    try unwind_prepare()
    if c.mode == MODE_STATIC {
        try ifunc_prepare()
        if c.runpath != 0 { try die_c(c"-rpath requires dynamic output") }
    } else {
        try dyn_prepare()
    }
    // Dynamic.pie: shared output is position independent too
    ld.lay_base = if c.pie || c.mode == MODE_SHARED { 0 } else { LAYOUT_BASE }
    ld.lay_relro = ld.dyn_file != NONE64 && c.relro
    ld.lay_page = c.page
    if ld.nobj == 0 { try die_c(c"no input objects") }
    mt PhaseStart = {}
    phase_begin(PH_MERGE, &mt)
    merge_plan()
    phase_end(PH_MERGE, &mt)
    try layout_make()
    set_predefined()

    ld.values = heap_alloc_zeroed(ld.nobj * sizeof[Values])
    ld_pool_for(ld.nobj, 1, &values_job, null)
    entry u64 = try entry_address()

    // the symbol table: live canonical symbols, locals first
    strtab Buf = {}
    buf_u8(&strtab, 0)
    shstrtab Buf = {}
    buf_u8(&shstrtab, 0)
    locals Vec[SymOut] = {}
    globals Vec[SymOut] = {}
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for i u64 in 1..zext[u64](o.nsym) {
            y handle[Sym] = sym(o, i)
            if !live(f, y) { continue }
            if y.binding != 0 {
                g handle[GSym] = gsym(gid_of(f, i))
                if g.has_res == 0 || zext[u64](g.res_file) != f || zext[u64](g.res_sym) != i { continue }
            }
            name u32 = try add_string(&strtab, y.name)
            e handle[SymOut] = vec_add(if y.binding == 0 { &locals } else { &globals })
            e.file = trunc[u32](f)
            e.name = name
            e.sym = i
        }
    }
    symbol_count u64 = locals.n + globals.n + 1
    symtab_size u64 = try chk_add(c"output symbol count", MAX_OUTPUT / 24, 0, symbol_count) * 24
    content_count u64 = ld.headers.n
    name_offsets addr = heap_alloc(content_count * 4 + 4)
    for k u64 in 0..content_count {
        name_offsets[u32, k] = try add_string(&shstrtab, vec_at(&ld.headers, k).name)
    }
    symtab_name u64 = zext[u64](try add_string(&shstrtab, bytes_c(c".symtab")))
    strtab_name u64 = zext[u64](try add_string(&shstrtab, bytes_c(c".strtab")))
    shstrtab_name u64 = zext[u64](try add_string(&shstrtab, bytes_c(c".shstrtab")))
    symtab_offset u64 = try out_align(ld.lay_cursor, 8)
    strtab_offset u64 = try out_add(symtab_offset, symtab_size)
    shstrtab_offset u64 = try out_add(strtab_offset, strtab.n)
    shoff u64 = try out_align(try out_add(shstrtab_offset, shstrtab.n), 8)
    section_count u64 = content_count + 4
    size u64 = try out_add(shoff, section_count * 64)
    ld.image_size = size
    ld.image = heap_alloc_zeroed(size + 8)

    for k u64 in 0..content_count {
        s handle[OutSec] = vec_at(&ld.headers, k)
        if (s.flags & 4) != 0 && (bytes_is(s.name, c".init") || bytes_is(s.name, c".fini")) {
            mem_set(ld.image + s.offset, 144, s.size)
        }
    }
    ld_pool_for(ld.content.n, 64, &blit_job, null)

    // GOT slots
    if ld.got_file != NONE64 {
        p handle[Place] = try get_placement(ld.got_file, 1)
        for slot u64 in 0..ld.got_slots.n {
            x u64 = ld.got_slots.p[u64, slot]
            sf u64 = pk_file(x)
            si u64 = pk_sec(x)
            vv handle[Values] = vals(sf)
            sv u64 = 0
            if ifunc_stub(sf, si, &sv) {
                wr64(ld.image, p.offset + slot * 8, sv)
                continue
            }
            model u8 = ld.got_model.p[u8, slot]
            if model == GM_LOCAL_MODULE || model == GM_LOCAL_OFFSET || model == GM_DESCRIPTOR || model == GM_DESCRIPTOR_ARGUMENT {
                wr64(ld.image, p.offset + slot * 8, if model == GM_LOCAL_MODULE { 1 } else { 0 })
                continue
            }
            if model == GM_ADDRESS && canonical_ifunc(sf, si) {
                if !dyn_ifunc_stub(sf, si, &sv) { try die_c(c"missing canonical IFUNC stub") }
                wr64(ld.image, p.offset + slot * 8, sv)
                continue
            }
            if vv.has[u8, si] == 0 {
                m handle[Buf] = msg()
                bb(m, obj(sf).path)
                bs(m, c": GOT references undefined symbol ")
                bb(m, sym(obj(sf), si).name)
                try die()
            }
            v u64 = vv.v[u64, si]
            if model != GM_ADDRESS && dyn_imported(sym(obj(sf), si).name) {
                wr64(ld.image, p.offset + slot * 8, 0)
                continue
            }
            if model == GM_THREAD && c.mode != MODE_SHARED && !thread_offset(msg(), v, &v) { try die() }
            if model == GM_MODULE_ID { v = 1 }
            wr64(ld.image, p.offset + slot * 8, v)
        }
    }

    rt PhaseStart = {}

    phase_begin(PH_RELOCATE, &rt)
    ld_pool_for(ld.nobj, 1, &relocate_job, null)
    for f u64 in 0..ld.nobj {
        if lx(f).status != 0 { try die_buf(&obj(f).msg) }
    }
    phase_end(PH_RELOCATE, &rt)
    try unwind_emit()
    try ifunc_emit()
    try dyn_emit()

    // the ELF header
    ident arr[7, u8] = b"\x7fELF\x02\x01\x01"
    mem_copy(ld.image, &ident, 7)
    wr16(ld.image, 16, if c.pie || c.mode == MODE_SHARED { 3 } else { 2 })
    wr16(ld.image, 18, 62)
    wr32(ld.image, 20, 1)
    wr64(ld.image, 24, entry)
    wr64(ld.image, 32, 64)
    wr64(ld.image, 40, shoff)
    wr16(ld.image, 52, 64)
    wr16(ld.image, 54, 56)
    phnum u64 = ld.segments.n + 2
    if ld.unwind_file != NONE64 { phnum += 1 }
    if ld.property_file != NONE64 { phnum += 2 }
    if ld.tls_seg.alignment != 0 { phnum += 1 }
    if ld.build_id_file != NONE64 { phnum += 1 }
    if ld.has_relro_seg { phnum += 1 }
    prefix u64 = 0
    if ld.dyn_file != NONE64 {
        if c.mode == MODE_SHARED {
            phnum += 1
        } else if c.mode == MODE_STATIC_PIE {
            phnum += 2
            prefix = 1
        } else {
            phnum += 3
            prefix = 2
        }
    }
    header_size u64 = 64 + phnum * 56
    wr16(ld.image, 56, phnum)
    wr16(ld.image, 58, 64)
    wr16(ld.image, 60, section_count)
    wr16(ld.image, 62, content_count + 3)
    if ld.dyn_file != NONE64 && c.mode != MODE_SHARED {
        program_header(0, 6, 4, 64, ld.lay_base + 64, phnum * 56, phnum * 56, 8)
        if c.mode != MODE_STATIC_PIE {
            ip handle[Place] = dyn_place(DYN_INTERP)
            is u64 = sec(obj(ld.dyn_file), DYN_INTERP).size
            program_header(1, 3, 4, ip.offset, ip.address, is, is, 1)
        }
    }
    program_header(prefix, 1, 4, 0, ld.lay_base, header_size, header_size, ld.lay_page)
    for i u64 in 0..ld.segments.n {
        s handle[Seg] = vec_at(&ld.segments, i)
        program_header(prefix + i + 1, 1, s.flags, s.offset, ld.lay_base + s.offset, s.file_size, s.memory_size, s.alignment)
    }
    extra_header u64 = prefix + ld.segments.n + 1
    if ld.has_relro_seg {
        program_header(extra_header, 0x6474e552, 4, ld.relro_seg.offset, ld.lay_base + ld.relro_seg.offset, ld.relro_seg.file_size,
            ld.relro_seg.memory_size, 1)
        extra_header += 1
    }
    if ld.tls_seg.alignment != 0 {
        program_header(extra_header, 7, 4, ld.tls_seg.offset, ld.lay_base + ld.tls_seg.offset, ld.tls_seg.file_size,
            ld.tls_seg.memory_size, ld.tls_seg.alignment)
        extra_header += 1
    }
    if ld.dyn_file != NONE64 {
        dp handle[Place] = dyn_place(DYN_DYNAMIC)
        dz u64 = sec(obj(ld.dyn_file), DYN_DYNAMIC).size
        program_header(extra_header, 2, 6, dp.offset, dp.address, dz, dz, 8)
        extra_header += 1
    }
    if ld.unwind_file != NONE64 {
        hp handle[Place] = try get_placement(ld.unwind_file, 1)
        hs u64 = sec(obj(ld.unwind_file), 1).size
        program_header(extra_header, 0x6474e550, 4, hp.offset, hp.address, hs, hs, 4)
        extra_header += 1
    }
    if ld.property_file != NONE64 {
        pp handle[Place] = try get_placement(ld.property_file, 1)
        ps u64 = sec(obj(ld.property_file), 1).size
        program_header(extra_header, 4, 4, pp.offset, pp.address, ps, ps, 8)
        program_header(extra_header + 1, 0x6474e553, 4, pp.offset, pp.address, ps, ps, 8)
        extra_header += 2
    }
    if ld.build_id_file != NONE64 {
        bp handle[Place] = try get_placement(ld.build_id_file, 1)
        bz u64 = sec(obj(ld.build_id_file), 1).size
        program_header(extra_header, 4, 4, bp.offset, bp.address, bz, bz, 4)
        extra_header += 1
    }
    program_header(phnum - 1, 0x6474e551, 6, 0, 0, 0, 0, 16)

    // symbols
    for j u64 in 0..locals.n + globals.n {
        e handle[SymOut] = if j < locals.n { vec_at(&locals, j) } else { vec_at(&globals, j - locals.n) }
        f u64 = zext[u64](e.file)
        y handle[Sym] = sym(obj(f), e.sym)
        at u64 = symtab_offset + (j + 1) * 24
        wr32(ld.image, at, zext[u64](e.name))
        wr8(ld.image, at + 4, (zext[u64](y.binding) << 4) | zext[u64](y.kind))
        vis u8 = y.visibility
        if y.binding != 0 { vis = gsym(gid_of(f, e.sym)).res_vis }
        wr8(ld.image, at + 5, zext[u64](vis))
        shndx u64 = if y.section == 0xfff1 { 0xfff1 } else { zext[u64]((try get_placement(f, zext[u64](y.section))).output_index) }
        wr16(ld.image, at + 6, shndx)
        wr64(ld.image, at + 8, sym_address(f, y))
        wr64(ld.image, at + 16, y.size)
    }
    mem_copy(ld.image + strtab_offset, strtab.p, strtab.n)
    mem_copy(ld.image + shstrtab_offset, shstrtab.p, shstrtab.n)

    for k u64 in 0..content_count {
        s handle[OutSec] = vec_at(&ld.headers, k)
        link u64 = 0
        info u64 = 0
        if !dyn_metadata(k + 1, &link, &info) {
            link = 0
            info = 0
        }
        section_header(shoff + (k + 1) * 64, zext[u64](name_offsets[u32, k]), zext[u64](s.kind), s.flags, s.address,
            s.offset, s.size, link, info, s.alignment, s.entsize)
    }
    section_header(shoff + (content_count + 1) * 64, symtab_name, 2, 0, 0, symtab_offset, symtab_size,
        content_count + 2, locals.n + 1, 8, 24)
    section_header(shoff + (content_count + 2) * 64, strtab_name, 3, 0, 0, strtab_offset, strtab.n, 0, 0, 1, 0)
    section_header(shoff + (content_count + 3) * 64, shstrtab_name, 3, 0, 0, shstrtab_offset, shstrtab.n, 0, 0, 1, 0)
    if c.has_map { try map_build(entry, &locals, &globals) }
    stat_add(ST_OUTPUT_BYTES, ld.image_size)
}

// ---------- publishing (File_io) ----------

// Only static relocations are allowed in an executable linker script.
fn script_check_inputs() void fails {
    if ld.shlibs.n != 0 { try refuse(c"shared library input in a linker script") }
    for f u64 in 0..ld.ninput_objects {
        o handle[Obj] = obj(f)
        for k u64 in 1..zext[u64](o.nsec) {
            h handle[Sec] = sec(o, k)
            if !kept(f, k) { continue }
            unsupported u64 = if config().elf32 || config().shared { 0x480 } else { 0x4b0 }
            if ls_input_kind(h.kind) && (h.flags & unsupported) != 0 {
                try refuse(c"merge, link-order or TLS sections in a linker script")
            }
            if (!config().shared && bytes_is(h.name, c".eh_frame")) || bytes_is(h.name, c".note.gnu.property") {
                try refuse(c"unwind or GNU property output in a linker script")
            }
            if h.kind == 9 && !config().elf32 { try refuse(c"REL input relocations in an ELF64 script") }
            if config().shared && h.size != 0 &&
                (h.kind == 14 || h.kind == 15 || h.kind == 16 || bytes_is(h.name, c".init") || bytes_is(h.name, c".fini")) {
                try refuse(c"initialization and finalization require a dynamic loader")
            }
        }
        for i u64 in 1..zext[u64](o.nsym) {
            y handle[Sym] = sym(o, i)
            if (y.kind == 6 || y.kind == 10) && (y.section == 0 || live(f, y)) {
                try refuse(c"TLS or IFUNC symbols in a linker script")
            }
        }
        for i u64 in 0..zext[u64](o.nrel) {
            r handle[Rel] = rel(o, i)
            if !kept(f, zext[u64](r.target)) { continue }
            kind u32 = r.kind
            if config().elf32 && (kind == 9 || kind == 10) && !config().shared {
                try refuse(c"i386 GOT relocations require a scripted shared object")
            }
            if kind != 0 && bytes_prefix(sec(o, zext[u64](r.target)).name, c".debug") {
                df u64 = 0
                ds u64 = 0
                if definition(f, zext[u64](r.symbol), &df, &ds) && !live(df, sym(obj(df), ds)) {
                    try refuse(c"DWARF relocations to discarded sections in a linker script")
                }
            }
            if !config().elf32 && kind != 0 && kind != 1 && kind != 2 && kind != 4 && kind != 10 && kind != 11 && kind != 24 {
                if config().mode == MODE_STATIC_PIE || config().shared {
                    m handle[Buf] = msg()
                    bb(m, o.path)
                    bs(m, c": unsupported scripted PIE relocation ")
                    bu(m, zext[u64](kind))
                    bs(m, c" against ")
                    bb(m, sym(o, zext[u64](r.symbol)).name)
                    try refuse(cstr_dup(buf_bytes(m)))
                }
                try refuse(c"non-static relocation in a linker script")
            }
        }
    }
}

fn script_entry() u64 fails {
    name Bytes = config().entry
    id u32 = find(name)
    if id != NONE && gsym(id).has_res != 0 {
        g handle[GSym] = gsym(id)
        f u64 = zext[u64](g.res_file)
        y handle[Sym] = sym(obj(f), zext[u64](g.res_sym))
        if live(f, y) { return sym_address(f, y) }
    }
    if config().entry_set || ld.lscript.entry_seen {
        m handle[Buf] = msg()
        bs(m, c"undefined entry symbol ")
        bb(m, name)
        try die()
    }
    if config().shared { return 0 }
    i u64 = ls_lookup(&ld.lscript.section_names, bytes_c(c".text"))
    if i != 0 && ls_sec(i).keep { return ls_sec(i).address }
    return 0
}

fn script_pie_metadata() void fails {
    if config().elf32 || config().emit_relocs { try refuse(c"scripted PIE requires ELF64 without retained relocations") }
    for k u64 in 0..5 {
        name addr = c".dynamic"
        if k == 1 { name = c".dynsym" }
        if k == 2 { name = c".dynstr" }
        if k == 3 { name = c".hash" }
        if k == 4 { name = c".gnu.hash" }
        if !ls_discards(bytes_c(name)) { try refuse(c"scripted PIE requires discarded dynamic metadata") }
    }
}

fn script_check_pic() void fails {
    for f u64 in 0..ld.ninput_objects {
        o handle[Obj] = obj(f)
        for i u64 in 0..zext[u64](o.nrel) {
            r handle[Rel] = rel(o, i)
            t u64 = zext[u64](r.target)
            p handle[Place] = place(f, t)
            if r.kind == 0 || !kept(f, t) || p.valid == 0 || (ls_sec(zext[u64](p.output_index)).flags & 2) == 0 { continue }
            if config().elf32 && r.kind == 10 {
                y handle[Sym] = sym(o, zext[u64](r.symbol))
                if y.section != 0 || !bytes_is(y.name, c"_GLOBAL_OFFSET_TABLE_") ||
                    name_defined(y.name) || dyn_place(DYN_GOTPLT).valid == 0 {
                    try refuse(c"i386 GOTPC requires the synthetic GOT base symbol")
                }
                continue
            }
            df u64 = 0
            ds u64 = 0
            relative bool = false
            if definition(f, zext[u64](r.symbol), &df, &ds) {
                if df == ld.script_file {
                    s u64 = ld.lscript.synth_sections[u64, ds]
                    relative = s != 0 && (ls_sec(s).flags & 2) != 0
                } else {
                    y handle[Sym] = sym(obj(df), ds)
                    if y.section != 0 && y.section < 0xff00 {
                        q handle[Place] = place(df, zext[u64](y.section))
                        relative = q.valid != 0 && (ls_sec(zext[u64](q.output_index)).flags & 2) != 0
                    }
                }
            } else if config().shared {
                try refuse(c"undefined symbol in scripted shared output")
            }
            pc_relative bool = if config().elf32 { r.kind == 2 || r.kind == 4 || r.kind == 9 || r.kind == 21 || r.kind == 23 }
                else { r.kind == 2 || r.kind == 4 || r.kind == 24 }
            if relative != pc_relative {
                if config().shared { try refuse(c"scripted shared output requires a run-time relocation") }
                try refuse(c"scripted PIE requires a run-time relocation")
            }
        }
    }
}

fn script_prepare_shared() void fails {
    if ld.shlibs.n != 0 { try refuse(c"scripted shared objects cannot use shared library inputs") }
    sc handle[Lscript] = &ld.lscript
    if !sc.explicit_phdrs || sc.phdrs.n == 0 || !ls_phdr(1).filehdr {
        try refuse(c"scripted shared output requires an initial PT_LOAD with FILEHDR PHDRS")
    }
    for f u64 in 0..ld.ninput_objects {
        o handle[Obj] = obj(f)
        for k u64 in 1..zext[u64](o.nsec) {
            if ls_discards(sec(o, k).name) { lx(f).kept[u8, k] = 0 }
        }
    }
    symver_plan()
    try shared_output_prepare()
    try unwind_normalize()
    try unwind_prepare()
    try dyn_prepare()
}

fn script_shared_metadata() void fails {
    for k u64 in 1..DYN_SECTION_COUNT {
        if !kept(ld.dyn_file, k) && sec(obj(ld.dyn_file), k).size == 0 { continue }
        if k == DYN_INTERP || k == DYN_PLT || k == DYN_RELA || k == DYN_VERSYM && ld.dyn_verdef_count == 0 { continue }
        p handle[Place] = dyn_place(k)
        if p.valid == 0 { try refuse(c"scripted shared metadata is missing from SECTIONS") }
        s handle[LsSection] = ls_sec(zext[u64](p.output_index))
        h handle[Sec] = sec(obj(ld.dyn_file), k)
        if k != DYN_GOTPLT && (s.kind != h.kind || s.size != h.size || (s.flags & 2) == 0) {
            try refuse(c"scripted dynamic metadata must occupy a dedicated allocatable section")
        }
    }
    dynamic u64 = zext[u64](dyn_place(DYN_DYNAMIC).output_index)
    unwind u64 = 0
    if ld.unwind_file != NONE64 { unwind = zext[u64](place(ld.unwind_file, 1).output_index) }
    found_dynamic bool = false
    found_unwind bool = false
    for j u64 in 1..ld.lscript.phdrs.n + 1 {
        p handle[LsPhdr] = ls_phdr(j)
        if p.kind == 2 {
            if found_dynamic || p.first != dynamic || p.last != dynamic {
                try refuse(c"scripted PT_DYNAMIC must contain only the dynamic table")
            }
            found_dynamic = true
        } else if p.kind == 0x6474e550 && unwind != 0 {
            if found_unwind || p.first != unwind || p.last != unwind {
                try refuse(c"scripted PT_GNU_EH_FRAME must contain only the unwind index")
            }
            found_unwind = true
        }
    }
    if !found_dynamic { try refuse(c"scripted shared output requires PT_DYNAMIC") }
    if ld.unwind_file != NONE64 && !found_unwind {
        try refuse(c"scripted unwind index requires its own PT_GNU_EH_FRAME")
    }
}

fn build_image_script() void fails {
    if ld.ninput_objects == 0 { try die_c(c"no input objects") }
    phase_begin(PH_EMIT, &ld.emit_start)
    alloc_tables()
    if config().gc_sections { gc_sections() }
    shared bool = config().shared
    pie bool = config().mode == MODE_STATIC_PIE
    if shared { try script_prepare_shared() }
    try build_id_prepare()
    try ls_match_inputs()
    if shared { try unwind_script_layout() }
    if !pie && !shared { try script_check_inputs() }
    try check_non_alloc_references()
    try ls_addresses()
    if pie { try script_pie_metadata() }
    if pie || shared {
        if !config().elf32 { relax_static_pie() }
        try script_check_inputs()
        try script_check_pic()
    }
    try ls_content_layout()
    if shared { try script_shared_metadata() }
    entry u64 = try script_entry()
    im LsImage = {}
    try ls_rela_layout(&im)
    try ls_image_layout(&im)
    ls_fill()
    ls_emit_data()
    ld_pool_for(ld.content.n, 64, &blit_job, null)
    ld.values = heap_alloc_zeroed(ld.nobj * sizeof[Values])
    ld_pool_for(ld.nobj, 1, &values_job, null)
    rt PhaseStart = {}
    phase_begin(PH_RELOCATE, &rt)
    ld_pool_for(ld.nobj, 1, &relocate_job, null)
    for f u64 in 0..ld.nobj {
        if lx(f).status != 0 { try die_buf(&obj(f).msg) }
    }
    phase_end(PH_RELOCATE, &rt)
    if shared {
        try unwind_emit()
        try dyn_emit()
    }
    try ls_write_header(&im, entry)
    try ls_write_phdrs()
    ls_emit_symbols(&im)
    ls_emit_relas(&im)
    ls_write_shdrs(&im)
}

fn stat_or_die(path Bytes, st handle[Stat]) void fails {
    os_stat(path.p, st, true) catch e { try die_io(c"stat", path, e) }
}

// File_io.null_output
fn null_output(path Bytes, st handle[Stat]) bool fails {
    if (st.mode & S_IFMT) != 0x2000 { return false }
    real Buf = {}
    path_realpath(path.p, &real) catch e { try die_io(c"realpath", path, e) }
    return bytes_is(buf_bytes(&real), c"/dev/null")
}

// File_io.check_output; inputs in the order they are checked. Returns
// whether the output exists.
fn check_output(output Bytes, inputs handle[Vec[Bytes]], reverse bool, out_st handle[Stat]) bool fails {
    os_stat(output.p, out_st, true) catch e {
        if e == NotFound { return false }
        try die_io(c"stat", output, e)
    }
    if (out_st.mode & S_IFMT) != S_IFREG && !try null_output(output, out_st) {
        m handle[Buf] = msg()
        bb(m, output)
        bs(m, c": output must be a regular file")
        try die()
    }
    for j u64 in 0..inputs.n {
        path Bytes = vec_get(inputs, if reverse { inputs.n - 1 - j } else { j })
        if ld_vfs_has(path) { continue }
        st Stat = {}
        try stat_or_die(path, &st)
        if st.dev == out_st.dev && st.ino == out_st.ino {
            m handle[Buf] = msg()
            bb(m, output)
            bs(m, c": output would overwrite input ")
            bb(m, path)
            try die()
        }
    }
    return true
}

fn link_and_publish() void fails {
    c handle[Config] = config()
    output Bytes = c.output
    in_mem bool = ld_vfs_in_memory()
    paths Vec[Bytes] = {}
    for k u64 in 0..c.items.n {
        it handle[Item] = vec_at(&c.items, k)
        if it.kind == IT_PATH { vec_push(&paths, it.text) }
    }
    // the version script is a metadata input: checked after the inputs,
    // and first in the expanded list
    if c.has_version_script {
        vec_push(&paths, c.version_script)
        vec_push(&ld.expanded, c.version_script)
    }
    if c.has_script {
        vec_push(&paths, c.script)
        vec_push(&ld.expanded, c.script)
    }
    discard bool = false
    if !in_mem {
        // the map is checked before the executable, and published (inside the
        // executable's publication) just before it
        if c.has_map {
            try distinct_outputs(output, c.map_file)
            ms Stat = {}
            try check_output(c.map_file, &paths, false, &ms)
        }
        st Stat = {}
        exists bool = try check_output(output, &paths, false, &st)
        discard = exists && try null_output(output, &st)
    }
    vec_free(&paths)
    if c.has_script { try ls_parse(c.script, try input_read(c.script, 4 * 1024 * 1024)) }
    try resolve()
    if c.has_script { try build_image_script() } else { try build_image() }
    try build_id_emit()
    phase_end(PH_EMIT, &ld.emit_start)
    if in_mem {
        ld_capture_output(ld.image, ld.image_size, c.has_map, buf_bytes(&ld.map_text))
        return
    }
    st2 Stat = {}
    try check_output(output, &ld.expanded, true, &st2)
    if c.has_map {
        ms2 Stat = {}
        if !(try check_output(c.map_file, &ld.expanded, true, &ms2) && try null_output(c.map_file, &ms2)) {
            file_write_atomic(c.map_file.p, buf_bytes(&ld.map_text), 0o644) catch e {
                try die_io(c"write", c.map_file, e)
            }
        }
    }
    wt PhaseStart = {}
    phase_begin(PH_WRITE, &wt)
    if discard {
        stat_add(ST_DISCARDED_OUTPUT_BYTES, ld.image_size)
        return
    }
    permissions u32 = if c.mode == MODE_SHARED { 0o644 } else { 0o755 }
    file_write_atomic(output.p, bytes(ld.image, ld.image_size), permissions) catch e {
        try die_io(c"write", output, e)
    }
    phase_end(PH_WRITE, &wt)
}
