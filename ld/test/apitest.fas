// In-process library API test for ld/api.fas:
//   1. Links inputs purely through LdVfs (no input files on disk at the VFS
//      paths) with in-memory output, and verifies byte-identity against the
//      CLI reference executable.
//   2. Re-runs ld_link in the same process (static again, then -shared with a
//      version script via VFS) and verifies byte-identity on every run.
//   3. Tests the incremental early-parse session (ld_session_begin /
//      ld_add_input / ld_finish) and verifies byte-identity.
//   4. Tests library-mode error recovery (returns exit code 1 with diagnostic
//      in vfs.diag without terminating the process, then links cleanly again).
//   5. Runs 1000 failing + 1000 succeeding links in a loop and verifies RSS
//      growth stays under 4 MiB after warm-up (/proc/self/statm).
//   6. Runs 4 concurrent links on separate threads (pool_start_on, each with
//      its own worker pool) and verifies byte-identical output to sequential runs.
//
// Usage: apitest <ref_static> <ref_shared> <start.o> <main.o> <libfoo.a> <shared.o> <ver.map>

use "../../lib/core.fas"
use "../../lib/thread.fas"
use "../util.fas"
use "../elf.fas"
use "../shared.fas"
use "../cli.fas"
use "../verscript.fas"
use "../resolve.fas"
use "../archive.fas"
use "../shdeps.fas"
use "../layout.fas"
use "../link.fas"
use "../unwind.fas"
use "../symver.fas"
use "../property.fas"
use "../gc.fas"
use "../buildid.fas"
use "../tls.fas"
use "../ifunc.fas"
use "../relax.fas"
use "../copy.fas"
use "../dynamic.fas"
use "../zlib.fas"
use "../script.fas"
use "../map.fas"
use "../stats.fas"
use "../partial.fas"
use "../api.fas"
use "../ctx.fas"

fn slurp(path addr) Bytes {
    fd i32 = os_open(path, O_RDONLY, 0) catch e {
        os_write_all(STDERR, c"apitest: open failed\n", 21) catch {}
        os_exit(2)
        return bytes_empty()
    }
    st Stat = {}
    os_fstat(fd, handle_from_addr[Stat](&st)) catch e { os_exit(2) }
    sz u64 = bitcast[u64](st.size)
    p addr = null
    if sz != 0 {
        p = os_mmap(null, sz, PROT_READ, MAP_PRIVATE, fd, 0) catch e {
            os_exit(2)
            return bytes_empty()
        }
    }
    os_close(fd)
    return bytes(p, sz)
}

fn read_rss_bytes() u64 {
    fd i32 = os_open(c"/proc/self/statm", O_RDONLY, 0) catch { return 0 }
    defer { os_close(fd) }
    buf arr[128, u8] = {}
    n usize = os_read(fd, &buf, 127) catch { return 0 }
    i usize = 0
    while i < n && buf[i] != 32 { i += 1 }
    while i < n && buf[i] == 32 { i += 1 }
    pages u64 = 0
    while i < n && buf[i] >= 48 && buf[i] <= 57 {
        pages = pages * 10 + zext[u64](buf[i] - 48)
        i += 1
    }
    return pages * 4096
}

struct ConcurrentCtx {
    ref_static Bytes
    ref_shared Bytes
    start_b Bytes
    main_b Bytes
    lib_b Bytes
    shared_b Bytes
    ver_b Bytes
    inner_threads u32
    failed arr[4, u32]
}

fn concurrent_link_job(arg addr, b usize, e usize, worker u32) void {
    cc handle[ConcurrentCtx] = handle_from_addr(arg)
    for slot usize in b..e {
        vfs LdVfs = {}
        vfs.in_memory = true
        vfs.quiet = true
        vfs.threads = cc.inner_threads
        vfs_add(&vfs, bytes_c(c"__vfs__/start.o"), cc.start_b)
        vfs_add(&vfs, bytes_c(c"__vfs__/main.o"), cc.main_b)
        vfs_add(&vfs, bytes_c(c"__vfs__/lib/libfoo.a"), cc.lib_b)
        vfs_add(&vfs, bytes_c(c"__vfs__/shared.o"), cc.shared_b)
        vfs_add(&vfs, bytes_c(c"__vfs__/ver.map"), cc.ver_b)

        args_st arr[6, addr] = {}
        args_st[0] = c"-o"
        args_st[1] = c"__vfs__/out_static"
        args_st[2] = c"__vfs__/start.o"
        args_st[3] = c"__vfs__/main.o"
        args_st[4] = c"-L__vfs__/lib"
        args_st[5] = c"-lfoo"

        args_sh arr[5, addr] = {}
        args_sh[0] = c"-shared"
        args_sh[1] = c"-o"
        args_sh[2] = c"__vfs__/out_shared.so"
        args_sh[3] = c"--version-script=__vfs__/ver.map"
        args_sh[4] = c"__vfs__/shared.o"

        bad arr[2, addr] = {}
        bad[0] = c"-o"
        bad[1] = c"__vfs__/bad_out"

        err u32 = 0
        for iter u64 in 0..8 {
            if ld_link(&args_st, 6, &vfs) != 0 || !bytes_eq(bytes(vfs.out_data, vfs.out_size), cc.ref_static) {
                err = 1
                break
            }
            if ld_link(&args_sh, 5, &vfs) != 0 || !bytes_eq(bytes(vfs.out_data, vfs.out_size), cc.ref_shared) {
                err = 2
                break
            }
            if ld_link(&bad, 2, &vfs) != 1 || vfs.diag.n == 0 {
                err = 3
                break
            }
        }
        vfs_free(&vfs)
        if err == 0 {
            // Also exercise an incremental LdSession concurrently
            vfs_s LdVfs = {}
            vfs_s.in_memory = true
            vfs_s.quiet = true
            vfs_s.threads = cc.inner_threads
            sess LdSession = {}
            ld_session_begin(&sess, &vfs_s)
            ld_add_input(&sess, bytes_c(c"__vfs__/start.o"), cc.start_b)
            ld_add_input(&sess, bytes_c(c"__vfs__/main.o"), cc.main_b)
            ld_add_input(&sess, bytes_c(c"__vfs__/lib/libfoo.a"), cc.lib_b)
            if ld_finish(&sess, &args_st, 6) != 0 || !bytes_eq(bytes(vfs_s.out_data, vfs_s.out_size), cc.ref_static) {
                err = 4
            }
            vfs_free(&vfs_s)
        }
        cc.failed[slot] = err
    }
}

fn check_eq(label addr, got Bytes, want Bytes) void {
    if !bytes_eq(got, want) {
        b Buf = {}
        bh handle[Buf] = handle_from_addr[Buf](&b)
        bs(bh, c"apitest: FAIL ")
        bs(bh, label)
        bs(bh, c" (got ")
        bu(bh, got.n)
        bs(bh, c" bytes, want ")
        bu(bh, want.n)
        bs(bh, c" bytes)\n")
        buf_write(bh, STDERR) catch {}
        os_exit(1)
    }
}

fn main(argc i32, argv addr) i32 {
    os_init(argc, argv)
    if os_argc != 8 {
        os_write_all(STDERR, c"usage: apitest ref_static ref_shared start.o main.o libfoo.a shared.o ver.map\n", 78) catch {}
        return 2
    }
    ref_static Bytes = slurp(os_arg(1))
    ref_shared Bytes = slurp(os_arg(2))
    start_b Bytes = slurp(os_arg(3))
    main_b Bytes = slurp(os_arg(4))
    lib_b Bytes = slurp(os_arg(5))
    shared_b Bytes = slurp(os_arg(6))
    ver_b Bytes = slurp(os_arg(7))

    // Populate a VFS with paths that do NOT exist on disk
    vfs LdVfs = {}
    vh handle[LdVfs] = handle_from_addr[LdVfs](&vfs)
    vh.in_memory = true
    vh.quiet = true
    vfs_add(vh, bytes_c(c"__vfs__/start.o"), start_b)
    vfs_add(vh, bytes_c(c"__vfs__/main.o"), main_b)
    vfs_add(vh, bytes_c(c"__vfs__/lib/libfoo.a"), lib_b)
    vfs_add(vh, bytes_c(c"__vfs__/shared.o"), shared_b)
    vfs_add(vh, bytes_c(c"__vfs__/ver.map"), ver_b)

    // 1. Static link via VFS + in-memory output
    args1 arr[6, addr] = {}
    args1[0] = c"-o"
    args1[1] = c"__vfs__/out_static"
    args1[2] = c"__vfs__/start.o"
    args1[3] = c"__vfs__/main.o"
    args1[4] = c"-L__vfs__/lib"
    args1[5] = c"-lfoo"
    rc1 i32 = ld_link(&args1, 6, vh)
    if rc1 != 0 {
        os_write_all(STDERR, c"apitest: run 1 failed\n", 22) catch {}
        return 1
    }
    check_eq(c"vfs static run 1", bytes(vh.out_data, vh.out_size), ref_static)

    // 2. Re-entrant 2nd link (same static link in same process)
    rc2 i32 = ld_link(&args1, 6, vh)
    if rc2 != 0 {
        os_write_all(STDERR, c"apitest: run 2 failed\n", 22) catch {}
        return 1
    }
    check_eq(c"vfs static run 2 (re-entrant)", bytes(vh.out_data, vh.out_size), ref_static)

    // 3. Re-entrant 3rd link (-shared + --version-script via VFS)
    args3 arr[5, addr] = {}
    args3[0] = c"-shared"
    args3[1] = c"-o"
    args3[2] = c"__vfs__/out_shared.so"
    args3[3] = c"--version-script=__vfs__/ver.map"
    args3[4] = c"__vfs__/shared.o"
    rc3 i32 = ld_link(&args3, 5, vh)
    if rc3 != 0 {
        os_write_all(STDERR, c"apitest: run 3 (-shared) failed\n", 32) catch {}
        return 1
    }
    check_eq(c"vfs shared run 3", bytes(vh.out_data, vh.out_size), ref_shared)

    // 4. Error handling: returns exit code 1 with diagnostic in vfs.diag
    bad_args arr[2, addr] = {}
    bad_args[0] = c"-o"
    bad_args[1] = c"__vfs__/bad_out"
    rc4 i32 = ld_link(&bad_args, 2, vh)
    if rc4 != 1 || vh.diag.n == 0 {
        os_write_all(STDERR, c"apitest: expected exit 1 + diag on empty link\n", 46) catch {}
        return 1
    }

    // 5. Clean recovery after error
    rc5 i32 = ld_link(&args1, 6, vh)
    if rc5 != 0 {
        os_write_all(STDERR, c"apitest: run 5 (post-error recovery) failed\n", 44) catch {}
        return 1
    }
    check_eq(c"vfs static run 5 (post-error)", bytes(vh.out_data, vh.out_size), ref_static)
    vfs_free(vh)

    // 6. Incremental early-parse session (ld_session_begin / ld_add_input / ld_finish)
    vfs2 LdVfs = {}
    vh2 handle[LdVfs] = handle_from_addr[LdVfs](&vfs2)
    vh2.in_memory = true
    vh2.quiet = true
    sess LdSession = {}
    sh handle[LdSession] = handle_from_addr[LdSession](&sess)
    ld_session_begin(sh, vh2)
    ld_add_input(sh, bytes_c(c"__vfs__/start.o"), start_b)
    ld_add_input(sh, bytes_c(c"__vfs__/main.o"), main_b)
    ld_add_input(sh, bytes_c(c"__vfs__/lib/libfoo.a"), lib_b)
    rc6 i32 = ld_finish(sh, &args1, 6)
    if rc6 != 0 {
        os_write_all(STDERR, c"apitest: incremental session failed\n", 36) catch {}
        return 1
    }
    check_eq(c"incremental session static", bytes(vh2.out_data, vh2.out_size), ref_static)
    vfs_free(vh2)

    // 7. Memory stability: 1000 failing + 1000 succeeding links, RSS growth < 4 MiB after warm-up
    vfs3 LdVfs = {}
    vfs3.in_memory = true
    vfs3.quiet = true
    limit u32 = 8
    configured addr = os_getenv(c"FAS_LD_TEST_MAX_THREADS")
    if configured != null { limit = trunc[u32](bytes_to_u64(bytes_c(configured)) catch 8) }
    inner_threads u32 = if limit >= 8 { 2 } else { 1 }
    outer_threads u32 = if limit >= 4 { 4 } else { limit }
    vfs3.threads = inner_threads
    vfs_add(&vfs3, bytes_c(c"__vfs__/start.o"), start_b)
    vfs_add(&vfs3, bytes_c(c"__vfs__/main.o"), main_b)
    vfs_add(&vfs3, bytes_c(c"__vfs__/lib/libfoo.a"), lib_b)
    // Warm-up
    for w u64 in 0..16 {
        if ld_link(&bad_args, 2, &vfs3) != 1 || vfs3.diag.n == 0 {
            os_write_all(STDERR, c"apitest: warmup failing link unexpected result\n", 47) catch {}
            return 1
        }
        if ld_link(&args1, 6, &vfs3) != 0 || !bytes_eq(bytes(vfs3.out_data, vfs3.out_size), ref_static) {
            os_write_all(STDERR, c"apitest: warmup succeeding link failed\n", 39) catch {}
            return 1
        }
    }
    rss_before u64 = read_rss_bytes()
    for i u64 in 0..1000 {
        if ld_link(&bad_args, 2, &vfs3) != 1 || vfs3.diag.n == 0 {
            os_write_all(STDERR, c"apitest: loop failing link unexpected result\n", 45) catch {}
            return 1
        }
        if ld_link(&args1, 6, &vfs3) != 0 || !bytes_eq(bytes(vfs3.out_data, vfs3.out_size), ref_static) {
            os_write_all(STDERR, c"apitest: loop succeeding link failed\n", 37) catch {}
            return 1
        }
    }
    rss_after u64 = read_rss_bytes()
    vfs_free(&vfs3)
    if rss_after > rss_before + 4 * 1024 * 1024 {
        b Buf = {}
        bs(&b, c"apitest: FAIL RSS grew from ")
        bu(&b, rss_before)
        bs(&b, c" to ")
        bu(&b, rss_after)
        bs(&b, c" bytes\n")
        buf_write(&b, STDERR) catch {}
        return 1
    }

    // 8. Four link jobs, with independently configured worker pools. Tiers
    // can cap concurrency while still running all four jobs.
    cctx ConcurrentCtx = {
        .ref_static = ref_static,
        .ref_shared = ref_shared,
        .start_b = start_b,
        .main_b = main_b,
        .lib_b = lib_b,
        .shared_b = shared_b,
        .ver_b = ver_b,
        .inner_threads = inner_threads,
    }
    outer_p handle[Pool] = handle_from_addr(heap_alloc_zeroed(sizeof[Pool]))
    outer handle[Pool] = pool_start_on(outer_p, outer_threads)
    pool_for(outer, 4, 1, &concurrent_link_job, &cctx)
    pool_stop(outer)
    heap_free(handle_addr(outer_p))
    for k usize in 0..4 {
        if cctx.failed[k] != 0 {
            b Buf = {}
            bs(&b, c"apitest: FAIL concurrent thread ")
            bu(&b, k)
            bs(&b, c" error ")
            bu(&b, zext[u64](cctx.failed[k]))
            bs(&b, c"\n")
            buf_write(&b, STDERR) catch {}
            return 1
        }
    }

    os_write_all(STDOUT, c"apitest: ok (8/8 checks)\n", 25) catch {}
    return 0
}
