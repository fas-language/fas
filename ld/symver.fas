// Symbol-version aliases (Symver.expand). GNU as keeps `name@VER` and
// `name@@VER` in ET_REL symbol names; a default version (`@@`) also
// defines `name` and `name@VER`, which are appended as extra symbols.

// Symver.parse: NONE64 when the name has no '@', else the '@' position.
// A malformed version fails with the message (no path prefix) in m.
fn symver_at(name Bytes, m handle[Buf]) u64 fails {
    at u64 = NONE64
    for i u64 in 0..name.n {
        if name.p[u8, i] == 64 {
            at = i
            break
        }
    }
    if at == NONE64 { return NONE64 }
    start u64 = at + 1
    if at + 1 < name.n && name.p[u8, at + 1] == 64 { start = at + 2 }
    version Bytes = bytes(name.p + start, name.n - start)
    if version.n == 0 {
        buf_clear(m)
        bs(m, c"empty/base symbol version aliases are unsupported: ")
        bb(m, name)
        fail Bad
    }
    if at == 0 || bytes_contains(version, 64) {
        buf_clear(m)
        bs(m, c"invalid symbol version alias ")
        bb(m, name)
        fail Bad
    }
    return at
}

fn symver_default(name Bytes, at u64) bool { return at + 1 < name.n && name.p[u8, at + 1] == 64 }

// the symbol behind index i: the object's own symbols, then the aliases
fn symver_sym(o handle[Obj], extra handle[Vec[Sym]], i u64) handle[Sym] {
    if i < zext[u64](o.nsym) { return sym(o, i) }
    return vec_at(extra, i - zext[u64](o.nsym))
}

// finds the latest definition named `name`, or NONE
fn symver_find(o handle[Obj], extra handle[Vec[Sym]], kx handle[KeyIndex], ids handle[Vec[u32]], name Bytes) u32 {
    e u32 = kx_first(kx, bytes_hash(name))
    while e != NONE {
        id u32 = vec_get(ids, zext[u64](e))
        if bytes_eq(symver_sym(o, extra, zext[u64](id)).name, name) { return e }
        e = kx_next(kx, e)
    }
    return NONE
}

// Hashtbl.replace: the entry for `name` now points at symbol i
fn symver_define(o handle[Obj], extra handle[Vec[Sym]], kx handle[KeyIndex], ids handle[Vec[u32]], name Bytes, i u64) void {
    e u32 = symver_find(o, extra, kx, ids, name)
    if e != NONE {
        vec_set(ids, zext[u64](e), trunc[u32](i))
        return
    }
    kx_add(kx, bytes_hash(name), trunc[u32](ids.n))
    vec_push(ids, trunc[u32](i))
}

fn symver_fail(o handle[Obj], text addr, name Bytes) void fails {
    m handle[Buf] = ef(o)
    bs(m, text)
    bb(m, name)
    fail Bad
}

// one alias of default-version symbol s (index i)
fn symver_alias(o handle[Obj], extra handle[Vec[Sym]], kx handle[KeyIndex], ids handle[Vec[u32]], i u64, name Bytes) void fails {
    s handle[Sym] = symver_sym(o, extra, i)
    e u32 = symver_find(o, extra, kx, ids, name)
    if e != NONE {
        old handle[Sym] = symver_sym(o, extra, zext[u64](vec_get(ids, zext[u64](e))))
        if old.section == s.section && old.value == s.value && old.kind == s.kind { return }
        try symver_fail(o, c"conflicting default symbol version ", name)
    }
    alias handle[Sym] = vec_add(extra)
    // s may move when extra grows: copy from its current address
    copy_into(alias, symver_sym(o, extra, i))
    alias.name = name
    symver_define(o, extra, kx, ids, name, zext[u64](o.nsym) + extra.n - 1)
}

fn symver_expand(o handle[Obj]) void fails {
    n u64 = zext[u64](o.nsym)
    versioned bool = false
    for k u64 in 0..n {
        y handle[Sym] = sym(o, k)
        if y.binding != 0 && bytes_contains(y.name, 64) {
            versioned = true
            break
        }
    }
    if !versioned { return }
    extra Vec[Sym] = {}
    ids Vec[u32] = {}
    index KeyIndex = {}
    for k u64 in 0..n {
        y handle[Sym] = sym(o, k)
        if y.binding != 0 && y.section != 0 { symver_define(o, &extra, &index, &ids, y.name, k) }
    }
    for k u64 in 0..n {
        y handle[Sym] = sym(o, k)
        if y.binding == 0 { continue }
        at u64 = try symver_at(y.name, &o.msg)
        if at == NONE64 || !symver_default(y.name, at) { continue }
        if y.section == 0 { try symver_fail(o, c"undefined default symbol version ", y.name) }
        // aliases: name, then name@VER (the name without one of the two @)
        try symver_alias(o, &extra, &index, &ids, k, bytes(y.name.p, at))
        nv u64 = y.name.n - 1
        p addr = heap_alloc(nv)
        mem_copy(p, y.name.p, at + 1)
        mem_copy(p + at + 1, y.name.p + at + 2, y.name.n - at - 2)
        try symver_alias(o, &extra, &index, &ids, k, bytes(p, nv))
    }
    if extra.n != 0 {
        total u64 = n + extra.n
        s addr = heap_alloc_zeroed(total * sizeof[Sym])
        mem_copy(s, o.syms, n * sizeof[Sym])
        mem_copy(s + n * sizeof[Sym], extra.p, extra.n * sizeof[Sym])
        o.syms = s
        o.nsym = trunc[u32](total)
    }
    vec_free(&extra)
    vec_free(&ids)
    kx_free(&index)
}

// Shared_output.prepare: a versioned definition needs a version node,
// which only shared output has. OCaml reports the first name in random
// Hashtbl order; this reports the first in definition order, preferring
// a name as written (name@@VER) over its synthesized name@VER alias.
fn has_default_at(b Bytes) bool {
    if b.n < 2 { return false }
    for i u64 in 0..b.n - 1 {
        if b.p[u8, i] == 64 && b.p[u8, i + 1] == 64 { return true }
    }
    return false
}

fn check_static_versions() void fails {
    for pass u64 in 0..2 {
    for i u64 in 0..gsyms.n {
        g handle[GSym] = gsym(trunc[u32](i))
        if g.has_res != 0 && bytes_contains(g.name, 64) && (pass == 1 || has_default_at(g.name)) {
            m handle[Buf] = msg()
            bs(m, c"defined symbol version ")
            bb(m, g.name)
            bs(m, c" requires shared output")
            try die()
        }
    }
    }
}

// ---------- Shared_output.prepare ----------

// Symver.parse without its errors (every name was validated by expand):
// the '@' position, or NONE64
fn sv_at(name Bytes) u64 {
    m Buf = {}
    at u64 = symver_at(name, &m) catch NONE64
    buf_free(&m)
    return at
}

// a parsed name's version text
fn sv_version_text(name Bytes, at u64) Bytes {
    start u64 = if symver_default(name, at) { at + 2 } else { at + 1 }
    return bytes(name.p + start, name.n - start)
}

// Symver.version of a global id: the name of its key, and the '@'
// position there (NONE64: no version)
fn sv_version(id u32, key addr) u64 {
    k Bytes = gsym(symver_key(id)).name
    key[Bytes] = k
    return sv_at(k)
}

// Shared_output.add: the definition or reference (f, i) as a runtime
// lookup descriptor with no provider
fn shared_output_add(f u64, i u64, id u32) void {
    y handle[Sym] = sym(obj(f), i)
    g handle[GSym] = gsym(id)
    key Bytes = {}
    at u64 = sv_version(id, &key)
    p handle[Imp] = imp_put(id)
    p.name = symver_name(y.name)
    p.kind = y.kind
    p.binding = if y.section == 0 && g.strong != 0 { 1 } else { y.binding }
    p.size = y.size
    p.is_default = 1
    if at != NONE64 {
        p.version = sv_version_text(key, at)
        p.is_default = if symver_default(key, at) { 1 } else { 0 }
    }
}

// the definition-version checks (their first failure among the
// definitions; OCaml visits its hash table in no fixed order), the
// version-script locals, and in shared output every default-visibility
// definition and undefined reference as an import
fn shared_output_prepare() void fails {
    c handle[Config] = config()
    shared bool = c.mode == MODE_SHARED
    if c.has_version_script && !shared { try die_c(c"version scripts require shared output") }
    if !shared {
        try check_static_versions()
        return
    }
    for pass u64 in 0..3 {
        for i u64 in 0..gsyms.n {
            id u32 = trunc[u32](i)
            g handle[GSym] = gsym(id)
            if g.has_res == 0 { continue }
            at_name bool = bytes_contains(g.name, 64)
            if pass == 0 && !(at_name && has_default_at(g.name)) { continue }
            if pass == 1 && !at_name { continue }
            key Bytes = {}
            at u64 = sv_version(id, &key)
            if at == NONE64 { continue }
            version Bytes = sv_version_text(key, at)
            found bool = false
            if c.has_version_script {
                for n u64 in 0..vs_node_count() {
                    if bytes_eq(vs_node(n).name, version) { found = true }
                }
            }
            if !found {
                m handle[Buf] = msg()
                bs(m, c"symbol ")
                bb(m, g.name)
                bs(m, c" references missing version node ")
                bb(m, version)
                try die()
            }
        }
    }
    if c.has_version_script {
        for i u64 in 0..gsyms.n {
            id u32 = trunc[u32](i)
            g handle[GSym] = gsym(id)
            if g.has_res == 0 { continue }
            key Bytes = {}
            at u64 = sv_version(id, &key)
            local bool = false
            if at != NONE64 {
                local = vs_exact_local(bytes(key.p, at))
            } else {
                local = try vs_policy(0, g.name) == 0
            }
            if local { g.res_vis = 2 }
        }
    }
    for f u64 in 0..nobj {
        o handle[Obj] = obj(f)
        for k u64 in 0..zext[u64](o.nsec) {
            s handle[Sec] = sec(o, k)
            if s.kind == 16 && s.size != 0 {
                m handle[Buf] = msg()
                bb(m, o.path)
                bs(m, c": preinit arrays are invalid in shared output")
                try die()
            }
        }
        for i u64 in 1..zext[u64](o.nsym) {
            y handle[Sym] = sym(o, i)
            if y.binding == 0 { continue }
            id u32 = gid_of(f, i)
            if id == NONE { continue }
            g handle[GSym] = gsym(id)
            if g.has_res != 0 {
                if zext[u64](g.res_file) == f && zext[u64](g.res_sym) == i && g.res_vis == 0 && f != predefined_file {
                    shared_output_add(f, i, id)
                }
            } else if y.section == 0 && y.visibility == 0 && (!c.no_undefined || y.binding == 2) && g.imp == 0 {
                if sv_at(y.name) != NONE64 {
                    m handle[Buf] = msg()
                    bb(m, o.path)
                    bs(m, c": undefined versioned symbol ")
                    bb(m, y.name)
                    bs(m, c" requires a provider")
                    try die()
                }
                shared_output_add(f, i, id)
            }
        }
    }
}
