// Inputs and symbol resolution: a port of the object-only paths of
// src/linker/resolver.ml (reading, parsing, global symbol states, common
// symbols, linker-defined symbols).
//
// Inputs are read serially in command-line order (the order the OCaml
// linker reads them in) and parsed in parallel. The OCaml linker parses
// each input before reading the next, so before any diagnostic of the
// serial walk, every object before it is parsed and its failure, if any,
// wins.

// ---------- the object table ----------

// per-object link data, parallel to the Obj table
struct Lx {
    gid addr          // u32 per symbol: global id, NONE for locals and index 0
    discarded addr    // u8 per section
    kept addr         // u8 per section
    place addr        // Place per section
    alias addr        // u64 per section: canonical (file << 32 | section) + 1, 0 when none
    gotref addr       // u32 per relocation: GOT slot, NONE when none
    eh addr           // the normalized .eh_frame bytes (unwind.fas), or null
    status u32        // parse: 0 ok, 1 failed, 2 refused
    seq u64           // input order across objects and shared libraries
    snap addr         // --stats: the counters when the input was read
}

struct Place {
    output_index u32
    valid u32
    offset u64
    address u64
}

const MAX_OBJECTS u64 = 65552  // 65536 objects and the synthesized ones


fn obj(i u64) handle[Obj] { return handle_from_addr(ld.objs + i * sizeof[Obj]) }
fn lx(i u64) handle[Lx] { return handle_from_addr(ld.lxs + i * sizeof[Lx]) }

fn gid_of(f u64, i u64) u32 { return lx(f).gid[u32, i] }
fn kept(f u64, s u64) bool { return lx(f).kept[u8, s] != 0 }
fn place(f u64, s u64) handle[Place] { return handle_from_addr(lx(f).place + s * sizeof[Place]) }

fn new_object(path addr) handle[Obj] fails {
    if ld.nobj >= MAX_OBJECTS { try die_c(c"extracted object count exceeds 65536 limit") }
    o handle[Obj] = obj(ld.nobj)
    ld.nobj += 1
    o.path = bytes_c(path)
    return o
}

// ---------- global symbols ----------

const DEF_NONE u8 = 0
const DEF_REGULAR u8 = 1
const DEF_COMMON u8 = 2

struct GSym {
    name Bytes
    def_kind u8
    def_binding u8
    strong u8             // strong_undefined
    shared_undef u8       // shared_undefined
    visibility u8
    def_file u32
    def_sym u32
    csize u64             // common size and alignment
    calign u64
    // the resolved definition (Resolver.definitions)
    has_res u8
    res_vis u8
    res_file u32
    res_sym u32
    // the runtime import (Resolver.imports, by name): 0 for none, else
    // its index + 1 in imps
    imp u32
}


// Resolver.import: a runtime lookup descriptor (the provider's symbol)
struct Imp {
    name Bytes          // the provider symbol's name
    version Bytes       // its version; n = NONE64 for none
    size u64
    library u32         // the providing shared library, NONE for none
    kind u8
    binding u8
    visibility u8
    is_default u8
}


fn imp(id u32) handle[Imp] {
    return vec_at(&ld.imps, zext[u64](gsym(id).imp) - 1)
}

// Hashtbl.replace imports: the (cleared) import of a global id
fn imp_put(id u32) handle[Imp] {
    g handle[GSym] = gsym(id)
    if g.imp == 0 {
        vec_add(&ld.imps)
        g.imp = trunc[u32](ld.imps.n)
    }
    mem_set(handle_addr(vec_at(&ld.imps, zext[u64](g.imp) - 1)), 0, sizeof[Imp])
    p handle[Imp] = imp(id)
    p.version = bytes(null, NONE64)
    p.library = NONE
    return p
}

// the global id of an imported name, or NONE
fn import_id(name Bytes) u32 {
    id u32 = find(name)
    if id == NONE || gsym(id).imp == 0 { return NONE }
    return id
}

fn gsym(id u32) handle[GSym] {
    return vec_at(&ld.gsyms, zext[u64](id))
}

// the state of `name`, created in first-use order (the OCaml `order`)
fn get(name Bytes) u32 {
    id u32 = intern(&ld.names, name)
    if zext[u64](id) == ld.gsyms.n {
        g handle[GSym] = vec_add(&ld.gsyms)
        g.name = name
    }
    return id
}

fn find(name Bytes) u32 {
    return intern_find(&ld.names, name) catch NONE
}

fn visibility_rank(v u8) u8 {
    if v == 0 { return 0 }
    if v == 3 { return 1 }
    if v == 2 { return 2 }
    return 3
}

// ---------- parsing ----------


struct StagedSh {
    lib ShLib
    data Bytes
    seq u64
    status u32
    pad u32
    snap addr
}


fn sh_parse_job_offset(ctx addr, b u64, e u64, worker u32) void {
    base u64 = ctx[u64]
    for i u64 in base + b..base + e {
        st handle[StagedSh] = vec_at(&ld.staged_sh, i)
        shared_parse(&st.lib, st.lib.path, st.data) catch { st.status = 1 }
    }
}

fn parse_job(ctx addr, b u64, e u64, worker u32) void {
    for i u64 in b..e {
        o handle[Obj] = obj(i)
        if o.secs != null || lx(i).status != 0 { continue }
        elf_parse(o, config().has_script) catch err {
            lx(i).status = if err == Refused { 2 } else { 1 }
        }
    }
}

// Parses every object and shared library read so far; the first failure in
// input order is the OCaml linker's diagnostic.
fn parse_flush() void fails {
    if ld.parsed == ld.nobj && ld.parsed_sh == ld.staged_sh.n { return }
    t PhaseStart = {}
    phase_begin(PH_PARSE, &t)
    if ld.parsed < ld.nobj { ld_pool_for(ld.nobj - ld.parsed, 1, &parse_job_offset, &ld.parsed) }
    if ld.parsed_sh < ld.staged_sh.n { ld_pool_for(ld.staged_sh.n - ld.parsed_sh, 1, &sh_parse_job_offset, &ld.parsed_sh) }
    phase_end(PH_PARSE, &t)
    oi u64 = ld.parsed
    si u64 = ld.parsed_sh
    while oi < ld.nobj || si < ld.staged_sh.n {
        take_obj bool = si == ld.staged_sh.n || (oi < ld.nobj && lx(oi).seq < vec_at(&ld.staged_sh, si).seq)
        if take_obj {
            try decoded_charge(obj(oi))
            st u32 = lx(oi).status
            if st != 0 { stat_restore(lx(oi).snap) }
            if st == 1 { try die_buf(&obj(oi).msg) }
            if st == 2 {
                try refuse(buf_cstr(&obj(oi).msg))
            }
            oi += 1
        } else {
            sh handle[StagedSh] = vec_at(&ld.staged_sh, si)
            if sh.status != 0 {
                stat_restore(sh.snap)
                try die_buf(&sh.lib.msg)
            }
            si += 1
        }
    }
    ld.parsed = ld.nobj
    ld.parsed_sh = ld.staged_sh.n
}

// on_decoded: the decoded debug sizes count against the combined input
// budget, in the OCaml linker's parse order
fn decoded_charge(o handle[Obj]) void fails {
    for k u64 in 0..zext[u64](o.ndec) {
        size u64 = o.dec[u64, k]
        if ld.input_bytes > MAX_INPUT_BYTES || size > MAX_INPUT_BYTES - ld.input_bytes {
            m handle[Buf] = msg()
            bs(m, c"combined input and decoded debug size: size exceeds supported limit ")
            bu(m, MAX_INPUT_BYTES)
            try die()
        }
        ld.input_bytes += size
        stat_add(ST_DECODED_DEBUG_BYTES, size)
    }
    o.ndec = 0
}

fn parse_job_offset(ctx addr, b u64, e u64, worker u32) void {
    base u64 = ctx[u64]
    parse_job(null, base + b, base + e, worker)
}

// ---------- reading ----------


fn input_die() void fails {
    if !ld.reading { try die() }
    // the message is in ld_msg: parse the earlier objects first
    keep Buf = {}
    bb(&keep, buf_bytes(&ld.ld_msg))
    try parse_flush()
    try die_buf(&keep)
}

fn input_die_io(call addr, path Bytes, e error) void fails {
    m handle[Buf] = msg()
    io_message(m, call, path, e)
    try input_die()
}

// File_io.read for an input
fn input_read(path Bytes, max_size u64) Bytes fails {
    vdata Bytes = {}
    if ld_vfs_get(path, &vdata) {
        if vdata.n > max_size {
            m handle[Buf] = msg()
            bb(m, path)
            bs(m, c": input exceeds ")
            bu(m, max_size)
            bs(m, c" byte limit or remaining input budget")
            try input_die()
        }
        return vdata
    }
    fd i32 = os_open(path.p, O_RDONLY | O_NONBLOCK, 0) catch e {
        try input_die_io(c"open", path, e)
        return bytes_empty()
    }
    st Stat = {}
    os_fstat(fd, &st) catch e { try input_die_io(c"fstat", bytes_empty(), e) }
    // OCaml 5's Unix.in_channel_of_descr refuses a directory with EINVAL
    // before File_io's own regular-file check runs
    if (st.mode & S_IFMT) == S_IFDIR {
        m handle[Buf] = msg()
        bs(m, c"in_channel_of_descr: : Invalid argument")
        try input_die()
    }
    if (st.mode & S_IFMT) != S_IFREG {
        m handle[Buf] = msg()
        bb(m, path)
        bs(m, c": input must be a regular file")
        try input_die()
    }
    size u64 = bitcast[u64](st.size)
    if size > max_size {
        m handle[Buf] = msg()
        bb(m, path)
        bs(m, c": input exceeds ")
        bu(m, max_size)
        bs(m, c" byte limit or remaining input budget")
        try input_die()
    }
    data addr = null
    if size != 0 {
        data = os_mmap(null, size, PROT_READ, MAP_PRIVATE, fd, 0) catch e {
            try input_die_io(c"read", path, e)
            return bytes_empty()
        }
        ld_track_mmap(data, size)
    }
    os_close(fd)
    return bytes(data, size)
}

struct Snapshot {
    real Bytes
    data Bytes
}

// every input path in the order the inputs were read (File_io's on_input)

fn is_script(d Bytes) bool {
    if d.n == 0 { return false }
    for i u64 in 0..d.n {
        c u8 = d.p[u8, i]
        if !(c == 10 || c == 13 || c == 9 || (c >= 32 && c != 127)) { return false }
    }
    return true
}

// the prepared inputs, parallel to the command-line items
const P_OBJECT u8 = 0
const P_ARCHIVE u8 = 1
const P_GROUP u8 = 2
const P_SHARED u8 = 3

struct PNode {
    kind u8
    loaded bool
    as_needed bool
    ref u32         // P_OBJECT: staged object; P_ARCHIVE: archive; P_SHARED: staged_sh
    count u32       // P_GROUP: the nodes inside
}


fn pnode_add(kind u8, ref u64) void {
    n handle[PNode] = vec_add(&ld.pnodes)
    n.kind = kind
    n.ref = trunc[u32](ref)
}

fn pnode_add_shared(ref u64, as_needed bool) void {
    n handle[PNode] = vec_add(&ld.pnodes)
    n.kind = P_SHARED
    n.ref = trunc[u32](ref)
    n.as_needed = as_needed
}

// ---------- shared library resolution state ----------


fn shlib(i u64) handle[ShLib] {
    return handle_from_addr(vec_get(&ld.shlibs, i))
}

fn shref_add(name Bytes) void {
    map_put(&ld.shared_refs, name, 1)
}

fn is_shared_ref(name Bytes) bool {
    if ld.shared_refs.n == 0 { return false }
    return map_has(&ld.shared_refs, name)
}

fn has_provider(name Bytes) bool {
    if ld.sh_providers.n == 0 { return false }
    return map_has(&ld.sh_providers, name)
}

fn prov_find(name Bytes) u64 {
    if ld.sh_providers.n == 0 { return NONE64 }
    return map_get(&ld.sh_providers, name) catch NONE64
}

fn prov_add(name Bytes, lib_idx u64, exp_idx u64) void {
    if !map_has(&ld.sh_providers, name) {
        map_put(&ld.sh_providers, name, (lib_idx << 32) | exp_idx)
    }
}

fn alloc_at_name(name Bytes, ver Bytes) Bytes {
    n u64 = name.n + 1 + ver.n
    p addr = heap_alloc(n + 1)
    mem_copy(p, name.p, name.n)
    p[u8, name.n] = 64
    mem_copy(p + name.n + 1, ver.p, ver.n)
    p[u8, n] = 0
    return bytes(p, n)
}

// one input file, prepared at script/group nesting `depth`; `scripts` are
// the canonical paths of the scripts being expanded (for cycles)
// Resolver.prepare's static_libraries for the input being read (-Bstatic
// or -static at its position; a script's -l inherits it)

// Library_search.find's ~dynamic: a .so before the .a
fn library_dynamic() bool {
    m u8 = config().mode
    return !ld.input_static && m != MODE_STATIC && m != MODE_STATIC_PIE
}

fn file_limit_message(m handle[Buf]) void {
    bs(m, c"input count exceeds ")
    bu(m, MAX_INPUT_FILES)
    bs(m, c" file limit")
}

fn read_input(path Bytes, whole bool, as_needed bool, depth u64, scripts handle[Vec[Bytes]]) void fails {
    ld.file_count += 1
    if ld.file_count > MAX_INPUT_FILES {
        m handle[Buf] = msg()
        file_limit_message(m)
        try input_die()
    }
    vec_push(&ld.expanded, path)
    rt PhaseStart = {}
    phase_begin(PH_READ, &rt)
    real Buf = {}
    ld_realpath(path, &real) catch e { try input_die_io(c"realpath", path, e) }
    max_size u64 = umin(MAX_FILE_SIZE, MAX_INPUT_BYTES - ld.input_bytes)
    data Bytes = bytes_empty()
    found bool = false
    for k u64 in 0..ld.snapshots.n {
        sn handle[Snapshot] = vec_at(&ld.snapshots, k)
        if bytes_eq(sn.real, buf_bytes(&real)) {
            data = sn.data
            found = true
            if data.n > max_size {
                m handle[Buf] = msg()
                bb(m, path)
                bs(m, c": input exceeds ")
                bu(m, max_size)
                bs(m, c" byte limit or remaining input budget")
                try input_die()
            }
            stat_add(ST_INPUT_READ_CACHE_HITS, 1)
            break
        }
    }
    if !found {
        data = try input_read(path, max_size)
        sn handle[Snapshot] = vec_add(&ld.snapshots)
        sn.real = nul_dup(real.p, real.n)
        sn.data = data
    }
    buf_free(&real)
    phase_end(PH_READ, &rt)
    ld.input_bytes += data.n
    stat_add(ST_INPUT_FILES, 1)
    stat_add(ST_INPUT_BYTES, data.n)
    if is_archive_data(data) {
        at PhaseStart = {}
        phase_begin(PH_PARSE, &at)
        try archive_parse(path, data, whole)
        phase_end(PH_PARSE, &at)
        ai u64 = ld.archives.n - 1
        a handle[Archive] = archive(ai)
        // Lazy member extraction would need the active script expressions
        // as roots and must account for definitions overridden by the script.
        if config().has_script && !a.whole && a.members.n != 0 {
            try refuse(c"lazy archive extraction with an executable linker script")
        }
        for k u64 in 0..a.members.n {
            m handle[Member] = member(a, k)
            if m.ext.n != 0 && ld_exists(m.ext) {
                vec_push(&ld.expanded, m.ext)
            }
        }
        if !whole && !a.indexed && a.members.n != 0 {
            m handle[Buf] = msg()
            bb(m, path)
            bs(m, c": archive has no symbol index (run ar s, or use --whole-archive)")
            try input_die()
        }
        stat_add(ST_ARCHIVES, 1)
        pnode_add(P_ARCHIVE, ai)
        return
    }
    if shared_is(data) {
        m_mode u8 = config().mode
        if m_mode == MODE_STATIC_PIE || m_mode == MODE_STATIC {
            m handle[Buf] = msg()
            bb(m, path)
            if m_mode == MODE_STATIC_PIE {
                bs(m, c": static PIE cannot use shared-library inputs")
            } else {
                bs(m, c": shared input requires -pie or --dynamic-linker")
            }
            try input_die()
        }
        idx u64 = ld.staged_sh.n
        st handle[StagedSh] = vec_add(&ld.staged_sh)
        st.lib.path = path
        st.data = data
        st.seq = ld.parse_seq
        ld.parse_seq += 1
        pnode_add_shared(idx, as_needed)
        if ld.stats_on {
            stat_mark(PH_PARSE)
            st.snap = stat_snapshot()
        }
        return
    }
    if is_script(data) {
        try script_input(path, data, whole, as_needed, depth, scripts)
        return
    }
    pnode_add(P_OBJECT, ld.nobj)
    o handle[Obj] = try new_object(c"")
    if !ld_take_preparsed(path, o, lx(ld.nobj - 1)) {
        o.path = path
        o.data = data.p
        o.len = data.n
    }
    lx(ld.nobj - 1).seq = ld.parse_seq
    ld.parse_seq += 1
    // the OCaml linker parses (and counts) each object as it is read
    if ld.stats_on {
        stat_mark(PH_PARSE)
        lx(ld.nobj - 1).snap = stat_snapshot()
    }
    // the OCaml linker parses each object as it is read: decoded debug
    // sizes shrink the budget of the inputs read after it
    if may_compress(data) { try parse_flush() }
}

// read_extra: a thin archive's member file (read once per canonical path)

fn read_extra_counted(path Bytes, counter u64) Bytes fails {
    real Buf = {}
    ld_realpath(path, &real) catch e { try input_die_io(c"realpath", path, e) }
    for k u64 in 0..ld.extra_files.n {
        sn handle[Snapshot] = vec_at(&ld.extra_files, k)
        if bytes_eq(sn.real, buf_bytes(&real)) {
            buf_free(&real)
            return sn.data
        }
    }
    ld.file_count += 1
    if ld.file_count > MAX_INPUT_FILES {
        file_limit_message(msg())
        try input_die()
    }
    vec_push(&ld.expanded, path)
    rt PhaseStart = {}
    phase_begin(PH_READ, &rt)
    data Bytes = try input_read(path, umin(MAX_FILE_SIZE, MAX_INPUT_BYTES - ld.input_bytes))
    phase_end(PH_READ, &rt)
    ld.input_bytes += data.n
    stat_add(counter, 1)
    stat_add(ST_INPUT_BYTES, data.n)
    sn handle[Snapshot] = vec_add(&ld.extra_files)
    sn.real = nul_dup(real.p, real.n)
    sn.data = data
    buf_free(&real)
    return data
}

fn read_extra(path Bytes) Bytes fails {
    return try read_extra_counted(path, ST_THIN_MEMBER_FILES)
}

// Reads every input in command-line order, then parses them all.
fn read_inputs() void fails {
    c handle[Config] = config()
    scripts Vec[Bytes] = {}
    // the enclosing groups: they end after `count` items; a script input
    // expands to any number of nodes, so a group's node count is only
    // known at its end
    ends Vec[u64] = {}
    starts Vec[u64] = {}
    for i u64 in 0..c.items.n + 1 {
        while ends.n != 0 && vec_last(&ends) == i {
            vec_pop(&ends)
            g u64 = vec_pop(&starts)
            vec_at(&ld.pnodes, g).count = trunc[u32](ld.pnodes.n - g - 1)
        }
        if i == c.items.n { break }
        it handle[Item] = vec_at(&c.items, i)
        depth u64 = ends.n
        if it.kind == IT_GROUP {
            vec_push(&ends, i + 1 + zext[u64](it.count))
            vec_push(&starts, ld.pnodes.n)
            pnode_add(P_GROUP, 0)
            continue
        }
        // Input.As_needed and Input.Static each add one level of policy
        // nesting (the OCaml prepare checks them before the file)
        static_wrap bool = it.kind == IT_PATH && it.static_lib
        extra u64 = 0
        if it.as_needed { extra = 1 }
        if (it.as_needed && depth >= 16) || (static_wrap && depth + extra >= 16) {
            m handle[Buf] = msg()
            bs(m, c"input policy nesting exceeds 16")
            try input_die()
        }
        path Bytes = it.text
        ld.input_static = it.static_lib
        if it.kind == IT_LIBRARY {
            // static output takes only archives (requires_static_inputs)
            path = try library_find(it.text, library_dynamic(), &ld.ldirs)
        }
        // the file's own depth: inside As_needed, then Static
        fd u64 = depth + extra
        if static_wrap { fd += 1 }
        try read_input(path, it.whole, it.as_needed, fd, &scripts)
    }
    vec_free(&ends)
    vec_free(&starts)
    try parse_flush()
    ld.reading = false
}

// ---------- processing (Resolver.process) ----------


fn sh_is_required(lib handle[ShLib]) bool {
    tmp Buf = {}
    defer { buf_free(&tmp) }
    for ei u64 in 0..lib.exports.n {
        ex handle[ShExport] = sh_export(lib, ei)
        if ex.is_default {
            id u32 = find(ex.name)
            if id != NONE && needed(id) { return true }
        }
        if ex.version.n != SH_NONE {
            buf_clear(&tmp)
            bb(&tmp, ex.name)
            buf_u8(&tmp, 64)
            bb(&tmp, ex.version)
            id u32 = find(buf_bytes(&tmp))
            if id != NONE && needed(id) { return true }
        }
    }
    return false
}

fn process_range(b u64, e u64) void fails {
    snh handle[BytesSet] = &ld.sh_names
    i u64 = b
    while i < e {
        n handle[PNode] = vec_at(&ld.pnodes, i)
        if n.kind == P_GROUP {
            inner u64 = zext[u64](n.count)
            prev_obj u64 = NONE64
            prev_sh u64 = NONE64
            while prev_obj != ld.nobj || prev_sh != ld.shlibs.n {
                prev_obj = ld.nobj
                prev_sh = ld.shlibs.n
                try process_range(i + 1, i + 1 + inner)
            }
            i += 1 + inner
            continue
        }
        if n.kind == P_OBJECT {
            if !n.loaded {
                n.loaded = true
                try add_member(handle_from_addr(ld.staged_objs + zext[u64](n.ref) * sizeof[Obj]))
            }
        } else if n.kind == P_SHARED {
            st handle[StagedSh] = vec_at(&ld.staged_sh, zext[u64](n.ref))
            lib handle[ShLib] = &st.lib
            req bool = !n.as_needed || sh_is_required(lib)
            if req && !n.loaded && !map_has(snh, lib.needed) {
                map_put(snh, lib.needed, 1)
                idx u64 = ld.shlibs.n
                vec_push(&ld.shlibs, handle_addr(lib))
                n.loaded = true
                stat_add(ST_SHARED_LIBRARIES, 1)
                ld.sh_sym_total = try chk_add(c"combined shared symbol count", 4000000, ld.sh_sym_total, lib.exports.n + lib.references.n)
                for ri u64 in 0..lib.references.n {
                    rf handle[ShRef] = sh_ref(lib, ri)
                    shref_add(rf.name)
                    if rf.undefined && rf.binding == 1 {
                        gsym(get(rf.name)).shared_undef = 1
                    }
                }
                for ei u64 in 0..lib.exports.n {
                    ex handle[ShExport] = sh_export(lib, ei)
                    if ex.is_default { prov_add(ex.name, idx, ei) }
                    if ex.version.n != SH_NONE { prov_add(alloc_at_name(ex.name, ex.version), idx, ei) }
                }
            }
        } else {
            try extract(zext[u64](n.ref))
        }
        i += 1
    }
}

// Moves the staged input objects aside and adds the objects in the OCaml
// linker's order: inputs and extracted members as the walk reaches them.
fn process_inputs() void fails {
    ld.staged_objs = ld.objs
    ld.staged_lxs = ld.lxs
    ld.objs = heap_alloc_zeroed(MAX_OBJECTS * sizeof[Obj])
    ld.lxs = heap_alloc_zeroed(MAX_OBJECTS * sizeof[Lx])
    ld.nobj = 0
    t PhaseStart = {}
    phase_begin(PH_RESOLVE, &t)
    try process_range(0, ld.pnodes.n)
    phase_end(PH_RESOLVE, &t)
    ld.ninput_objects = ld.nobj
}

// ---------- features the skeleton refuses ----------

fn check_supported(i u64) void {
    o handle[Obj] = obj(i)
}

// ---------- resolution ----------

const NONE64 u64 = 0xffffffffffffffff



// COMDAT signatures seen so far: the first group with a signature wins

fn add_object(f u64) void fails {
    o handle[Obj] = obj(f)
    l handle[Lx] = lx(f)
    n u64 = zext[u64](o.nsec)
    l.discarded = heap_alloc_zeroed(n + 1)
    for k u64 in 0..zext[u64](o.ngroup) {
        g handle[Group] = handle_from_addr(o.groups + k * sizeof[Group])
        if !g.comdat { continue }
        hash u64 = bytes_hash(g.signature)
        e u32 = kx_first(&ld.signature_index, hash)
        while e != NONE && !bytes_eq(vec_get(&ld.signatures, zext[u64](e)), g.signature) { e = kx_next(&ld.signature_index, e) }
        if e != NONE {
            for j u64 in 0..zext[u64](g.n) { l.discarded[u8, zext[u64](g.members[u32, j])] = 1 }
            stat_add(ST_DISCARDED_COMDAT_GROUPS, 1)
        } else {
            kx_add(&ld.signature_index, hash, trunc[u32](ld.signatures.n))
            vec_push(&ld.signatures, g.signature)
        }
    }
    ld.symbol_total = try chk_add(c"combined symbol count", 4000000, ld.symbol_total, zext[u64](o.nsym))
    ld.relocation_total = try chk_add(c"combined relocation count", 4000000, ld.relocation_total, zext[u64](o.nrel))
    stat_add(ST_OBJECTS, 1)
    stat_add(ST_SYMBOLS, zext[u64](o.nsym))
    stat_add(ST_RELOCATIONS, zext[u64](o.nrel))
    l.gid = heap_alloc_zeroed(zext[u64](o.nsym) * 4 + 4)
    c handle[Config] = config()
    for index u64 in 0..zext[u64](o.nsym) {
        y handle[Sym] = sym(o, index)
        l.gid[u32, index] = NONE
        if y.binding == 0 { continue }
        id u32 = get(y.name)
        l.gid[u32, index] = id
        s handle[GSym] = gsym(id)
        if visibility_rank(y.visibility) > visibility_rank(s.visibility) { s.visibility = y.visibility }
        if y.section == 0 || (zext[u64](y.section) < n && l.discarded[u8, zext[u64](y.section)] != 0) {
            if y.binding == 1 { s.strong = 1 }
            continue
        }
        if y.section == 0xfff2 {
            size u64 = y.size
            alignment u64 = umax(1, y.value)
            if s.def_kind == DEF_NONE {
                s.def_kind = DEF_COMMON
                s.csize = size
                s.calign = alignment
            } else if s.def_kind == DEF_COMMON {
                s.csize = umax(s.csize, size)
                s.calign = umax(s.calign, alignment)
            } else if s.def_binding == 2 {
                s.def_kind = DEF_COMMON
                s.csize = size
                s.calign = alignment
            }
        } else {
            replace bool = false
            if s.def_kind == DEF_NONE {
                replace = true
            } else if s.def_kind == DEF_COMMON {
                replace = y.binding == 1
            } else {
                if s.def_binding == 1 && y.binding == 1 && !c.allow_multiple_definition {
                    m handle[Buf] = msg()
                    bs(m, c"duplicate symbol ")
                    bb(m, s.name)
                    bs(m, c": ")
                    bb(m, obj(zext[u64](s.def_file)).path)
                    bs(m, c" and ")
                    bb(m, o.path)
                    try die()
                }
                replace = s.def_binding == 2 && y.binding == 1
            }
            if replace {
                s.def_kind = DEF_REGULAR
                s.def_file = trunc[u32](f)
                s.def_sym = trunc[u32](index)
                s.def_binding = y.binding
            }
        }
    }
}

fn identifier(b Bytes) bool {
    if b.n == 0 { return false }
    for i u64 in 0..b.n {
        c u8 = b.p[u8, i]
        alpha bool = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95
        if !alpha && !(i != 0 && c >= 48 && c <= 57) { return false }
    }
    return true
}

// Section_registry.boundary: the section named by __start_X / __stop_X
fn boundary(name Bytes, last addr) Bytes {
    if bytes_prefix(name, c"__start_") {
        rest Bytes = bytes_from(name, 8)
        if identifier(rest) {
            last[u8] = 0
            return rest
        }
    }
    if bytes_prefix(name, c"__stop_") {
        rest Bytes = bytes_from(name, 7)
        if identifier(rest) {
            last[u8] = 1
            return rest
        }
    }
    return bytes(null, NONE64)
}

fn has_boundary(name Bytes) bool {
    l u8 = 0
    return boundary(name, &l).n != NONE64
}

fn registry_eligible(s handle[Sec]) bool {
    return identifier(s.name) && (s.kind == 1 || s.kind == 8) && (s.flags & 2) != 0 && (s.flags & 0x400) == 0
}

fn same_signature(a handle[Sec], b handle[Sec]) bool {
    mask u64 = ~(0x200 | 0x200000)
    return a.kind == b.kind && (a.flags & mask) == (b.flags & mask) && a.entsize == b.entsize
}

// Section_registry.available, over the input objects (members in reverse
// file order: the OCaml list is built by prepending)
fn registry_available(name Bytes) bool fails {
    l u8 = 0
    section Bytes = boundary(name, &l)
    if section.n == NONE64 { return false }
    first handle[Sec] = null
    found bool = false
    f u64 = ld.ninput_objects
    while f > 0 {
        f -= 1
        o handle[Obj] = obj(f)
        k u64 = zext[u64](o.nsec)
        while k > 0 {
            k -= 1
            s handle[Sec] = sec(o, k)
            if !bytes_eq(s.name, section) || lx(f).discarded[u8, k] != 0 { continue }
            if !found {
                first = s
                found = true
            }
            if !registry_eligible(s) {
                m handle[Buf] = msg()
                bb(m, name)
                bs(m, c": section boundaries require allocatable non-TLS PROGBITS or NOBITS section ")
                bb(m, section)
                try die()
            }
            if !same_signature(s, first) {
                m handle[Buf] = msg()
                bb(m, name)
                bs(m, c": incompatible contributions to registry section ")
                bb(m, section)
                try die()
            }
        }
    }
    return found
}

fn predefined_name(n Bytes) bool {
    return bytes_is(n, c"__executable_start") || bytes_is(n, c"__ehdr_start") ||
        bytes_is(n, c"__bss_start") || bytes_is(n, c"_etext") || bytes_is(n, c"etext") ||
        bytes_is(n, c"_edata") || bytes_is(n, c"edata") || bytes_is(n, c"_end") ||
        bytes_is(n, c"end") || bytes_is(n, c"_GLOBAL_OFFSET_TABLE_") ||
        bytes_is(n, c"__preinit_array_start") || bytes_is(n, c"__preinit_array_end") ||
        bytes_is(n, c"__init_array_start") || bytes_is(n, c"__init_array_end") ||
        bytes_is(n, c"__fini_array_start") || bytes_is(n, c"__fini_array_end") ||
        bytes_is(n, c"__rela_iplt_start") || bytes_is(n, c"__rela_iplt_end") ||
        (bytes_is(n, c"_DYNAMIC") && config().mode != MODE_STATIC)
}

fn hidden_predefined(n Bytes) bool {
    return has_boundary(n) || bytes_is(n, c"__executable_start") || bytes_is(n, c"__ehdr_start") ||
        bytes_is(n, c"_GLOBAL_OFFSET_TABLE_") || bytes_is(n, c"_DYNAMIC") ||
        bytes_is(n, c"__preinit_array_start") || bytes_is(n, c"__preinit_array_end") ||
        bytes_is(n, c"__init_array_start") || bytes_is(n, c"__init_array_end") ||
        bytes_is(n, c"__fini_array_start") || bytes_is(n, c"__fini_array_end") ||
        bytes_is(n, c"__rela_iplt_start") || bytes_is(n, c"__rela_iplt_end")
}

fn set_res(id u32, file u64, symbol u64, vis u8) void {
    g handle[GSym] = gsym(id)
    g.has_res = 1
    g.res_file = trunc[u32](file)
    g.res_sym = trunc[u32](symbol)
    g.res_vis = vis
}

// Builds a synthesized object's symbol (the rest of the Sym is zero)
fn synth_sym(o handle[Obj], index u64, name Bytes) handle[Sym] {
    y handle[Sym] = sym(o, index)
    y.name = name
    return y
}

// -r: no entry root, no linker-defined symbols, commons stay SHN_COMMON

fn resolve() void fails {
    c handle[Config] = config()
    if c.entry.n == 0 { try die_c(c"entry symbol must not be empty") }
    // library search directories (Sysroot.directory without a root)
    if c.has_sysroot { try sysroot_normalize(c.sysroot) }
    for k u64 in 0..c.library_paths.n { vec_push(&ld.ldirs, try root_directory(vec_get(&c.library_paths, k))) }
    if c.library_paths.n > 4096 { try die_c(c"library search exceeds 4096 directories") }
    // Input.paths: every path item
    paths u64 = 0
    for k u64 in 0..c.items.n {
        if vec_at(&c.items, k).kind == IT_PATH { paths += 1 }
    }
    if paths > MAX_INPUT_FILES {
        file_limit_message(msg())
        try die()
    }
    try read_inputs()

    // the entry and -u roots
    if !ld.partial && c.mode != MODE_SHARED { gsym(get(c.entry)).strong = 1 }
    for k u64 in 0..c.undefined.n {
        name Bytes = vec_get(&c.undefined, k)
        if name.n == 0 { try die_c(c"undefined root symbol must not be empty") }
        gsym(get(name)).strong = 1
    }
    try process_inputs()

    if c.has_script { try ls_resolve_symbols() }

    // definitions, commons and linker-defined symbols, in state order
    common_file u64 = ld.nobj
    commons Vec[u32] = {}
    common_size u64 = 0
    common_alignment u64 = 1
    predefined Vec[u32] = {}
    count u64 = ld.gsyms.n
    for i u64 in 0..count {
        id u32 = trunc[u32](i)
        s handle[GSym] = gsym(id)
        if c.has_script && s.has_res != 0 && zext[u64](s.res_file) == ld.script_file { continue }
        if s.def_kind == DEF_NONE {
            if ld.partial || c.has_script {
                // nothing: undefined symbols stay undefined
            } else if predefined_name(s.name) || try registry_available(s.name) {
                vec_push(&predefined, id)
            } else {
                pv u64 = prov_find(s.name)
                if pv != NONE64 {
                    if s.strong != 0 || s.visibility == 0 {
                        lib_idx u64 = pv >> 32
                        exp_idx u64 = pv & 0xffffffff
                        ex handle[ShExport] = sh_export(shlib(lib_idx), exp_idx)
                        p handle[Imp] = imp_put(id)
                        p.name = ex.name
                        p.version = ex.version
                        p.size = ex.size
                        p.library = trunc[u32](lib_idx)
                        p.kind = ex.kind
                        p.binding = if s.strong != 0 { 1 } else { 2 }
                        p.visibility = s.visibility
                        p.is_default = if ex.is_default { 1 } else { 0 }
                    }
                } else if c.mode != MODE_STATIC && c.mode != MODE_STATIC_PIE && s.strong == 0 && s.visibility == 0 {
                    p handle[Imp] = imp_put(id)
                    p.name = s.name
                    p.binding = 2
                    p.is_default = 1
                }
                if !ld.partial && s.strong != 0 && s.visibility != 0 && !c.gc_sections {
                    m handle[Buf] = msg()
                    bs(m, c"undefined non-default visibility symbol ")
                    bb(m, s.name)
                    try die()
                }
            }
        } else if s.def_kind == DEF_REGULAR {
            set_res(id, zext[u64](s.def_file), zext[u64](s.def_sym), s.visibility)
        } else {
            if c.has_script { try refuse(c"COMMON symbols in an executable linker script") }
            if !ld.partial { common_size = try chk_align(c"common symbol layout", MAX_SECTION_SIZE, common_size, s.calign) }
            vec_push(&commons, id)
            // the symbol's value is its offset; kept in csize's place until
            // the object is built
            set_res(id, common_file, commons.n, s.visibility)
            if !ld.partial {
                s.def_sym = trunc[u32](common_size)
                common_size = try chk_add(c"common symbol layout", MAX_SECTION_SIZE, common_size, s.csize)
            }
            common_alignment = umax(common_alignment, s.calign)
        }
    }
    if commons.n != 0 {
        o handle[Obj] = try new_object(c"<common>")
        o.nsec = 2
        o.secs = heap_alloc_zeroed(2 * sizeof[Sec])
        n0 handle[Sec] = sec(o, 0)
        n0.alignment = 1
        n0.group = -1
        b handle[Sec] = sec(o, 1)
        b.name = bytes_c(c".bss.common")
        b.kind = 8
        b.flags = 3
        b.size = common_size
        b.alignment = common_alignment
        b.group = -1
        o.nsym = trunc[u32](commons.n + 1)
        o.syms = heap_alloc_zeroed((commons.n + 1) * sizeof[Sym])
        l handle[Lx] = lx(common_file)
        l.discarded = heap_alloc_zeroed(2)
        l.gid = heap_alloc_zeroed((commons.n + 1) * 4)
        l.gid[u32, 0] = NONE
        for k u64 in 0..commons.n {
            id u32 = vec_get(&commons, k)
            g handle[GSym] = gsym(id)
            y handle[Sym] = synth_sym(o, k + 1, g.name)
            y.binding = 1
            y.kind = 1
            y.visibility = g.visibility
            y.section = if ld.partial { 0xfff2 } else { 1 }
            // under -r the SHN_COMMON value is the alignment
            y.value = if ld.partial { g.calign } else { zext[u64](g.def_sym) }
            y.size = g.csize
            l.gid[u32, k + 1] = id
        }
    }
    if predefined.n != 0 {
        file u64 = ld.nobj
        o handle[Obj] = try new_object(c"<linker symbols>")
        stat_add(ST_LINKER_SYMBOLS, predefined.n)
        o.nsym = trunc[u32](predefined.n + 1)
        o.syms = heap_alloc_zeroed((predefined.n + 1) * sizeof[Sym])
        l handle[Lx] = lx(file)
        l.discarded = heap_alloc_zeroed(1)
        l.gid = heap_alloc_zeroed((predefined.n + 1) * 4)
        l.gid[u32, 0] = NONE
        for k u64 in 0..predefined.n {
            id u32 = vec_get(&predefined, k)
            g handle[GSym] = gsym(id)
            vis u8 = g.visibility
            if hidden_predefined(g.name) && visibility_rank(vis) < 2 { vis = 2 }
            set_res(id, file, k + 1, vis)
            y handle[Sym] = synth_sym(o, k + 1, g.name)
            y.binding = 1
            y.visibility = vis
            y.section = 0xfff1
            l.gid[u32, k + 1] = id
        }
        ld.predefined_file = file
    }
    if !ld.partial {
        try shdeps_load(&ld.shdeps_graph, ld.shlibs.p, ld.shlibs.n)
        for li u64 in 0..ld.shdeps_graph.libraries.n {
            lib handle[ShLib] = shdeps_lib(&ld.shdeps_graph, li)
            for ri u64 in 0..lib.references.n {
                rf handle[ShRef] = sh_ref(lib, ri)
                shref_add(rf.name)
                if rf.version.n != SH_NONE {
                    shref_add(alloc_at_name(rf.name, rf.version))
                }
            }
        }
    }
}
