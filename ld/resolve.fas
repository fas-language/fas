// Inputs and symbol resolution: a port of the object-only paths of
// src/linker/resolver.ml (reading, parsing, global symbol states, common
// symbols, linker-defined symbols).
//
// Inputs are read serially in command-line order (the order the OCaml
// linker reads them in) and parsed in parallel. The OCaml linker parses
// each input before reading the next, so before any diagnostic of the
// serial walk, every object before it is parsed and its failure, if any,
// wins.

// ---------- the object table ----------

// per-object link data, parallel to the Obj table
struct Lx {
    gid addr          // u32 per symbol: global id, NONE for locals and index 0
    discarded addr    // u8 per section
    kept addr         // u8 per section
    place addr        // Place per section
    alias addr        // u64 per section: canonical (file << 32 | section) + 1, 0 when none
    gotref addr       // u32 per relocation: GOT slot, NONE when none
    eh addr           // the normalized .eh_frame bytes (unwind.fas), or null
    status u32        // parse: 0 ok, 1 failed, 2 refused
    seq u64           // input order across objects and shared libraries
    snap addr         // --stats: the counters when the input was read
}

struct Place {
    output_index u32
    valid u32
    offset u64
    address u64
}

const MAX_OBJECTS u64 = 65552  // 65536 objects and the synthesized ones

var objs addr = null           // Obj * MAX_OBJECTS
var lxs addr = null            // Lx * MAX_OBJECTS
var nobj u64 = 0
var ninput_objects u64 = 0     // objects from inputs (the rest are synthesized)

fn obj(i u64) handle[Obj] { return handle_from_addr[Obj](objs + i * sizeof[Obj]) }
fn lx(i u64) handle[Lx] { return handle_from_addr[Lx](lxs + i * sizeof[Lx]) }

fn gid_of(f u64, i u64) u32 { return lx(f).gid[u32, i] }
fn kept(f u64, s u64) bool { return lx(f).kept[u8, s] != 0 }
fn place(f u64, s u64) handle[Place] { return handle_from_addr[Place](lx(f).place + s * sizeof[Place]) }

fn new_object(path addr) handle[Obj] {
    if nobj >= MAX_OBJECTS { die_c(c"extracted object count exceeds 65536 limit") }
    o handle[Obj] = obj(nobj)
    nobj += 1
    o.path = bytes_c(path)
    return o
}

// ---------- global symbols ----------

const DEF_NONE u8 = 0
const DEF_REGULAR u8 = 1
const DEF_COMMON u8 = 2

struct GSym {
    name Bytes
    def_kind u8
    def_binding u8
    strong u8             // strong_undefined
    shared_undef u8       // shared_undefined
    visibility u8
    def_file u32
    def_sym u32
    csize u64             // common size and alignment
    calign u64
    // the resolved definition (Resolver.definitions)
    has_res u8
    res_vis u8
    res_file u32
    res_sym u32
    // the runtime import (Resolver.imports, by name): 0 for none, else
    // its index + 1 in imps
    imp u32
}

var names Intern = {}
var gsyms Vec[GSym] = {}

// Resolver.import: a runtime lookup descriptor (the provider's symbol)
struct Imp {
    name Bytes          // the provider symbol's name
    version Bytes       // its version; n = NONE64 for none
    size u64
    library u32         // the providing shared library, NONE for none
    kind u8
    binding u8
    visibility u8
    is_default u8
}

var imps Vec[Imp] = {}

fn imp(id u32) handle[Imp] {
    return vec_ref[Imp](handle_from_addr[Vec[Imp]](&imps), zext[u64](gsym(id).imp) - 1)
}

// Hashtbl.replace imports: the (cleared) import of a global id
fn imp_put(id u32) handle[Imp] {
    g handle[GSym] = gsym(id)
    iv handle[Vec[Imp]] = handle_from_addr[Vec[Imp]](&imps)
    if g.imp == 0 {
        vec_new[Imp](iv)
        g.imp = trunc[u32](iv.n)
    }
    mem_set(handle_addr(vec_at[Imp](iv, zext[u64](g.imp) - 1)), 0, sizeof[Imp])
    p handle[Imp] = imp(id)
    p.version = bytes(null, NONE64)
    p.library = NONE
    return p
}

// the global id of an imported name, or NONE
fn import_id(name Bytes) u32 {
    id u32 = find(name)
    if id == NONE || gsym(id).imp == 0 { return NONE }
    return id
}

fn gsym(id u32) handle[GSym] {
    return vec_at[GSym](handle_from_addr[Vec[GSym]](&gsyms), zext[u64](id))
}

// the state of `name`, created in first-use order (the OCaml `order`)
fn get(name Bytes) u32 {
    id u32 = intern(handle_from_addr[Intern](&names), name)
    v handle[Vec[GSym]] = handle_from_addr[Vec[GSym]](&gsyms)
    if zext[u64](id) == v.n {
        g handle[GSym] = handle_from_addr[GSym](vec_push_zeroed[GSym](v))
        g.name = name
    }
    return id
}

fn find(name Bytes) u32 {
    return intern_find(handle_from_addr[Intern](&names), name) catch NONE
}

fn visibility_rank(v u8) u8 {
    if v == 0 { return 0 }
    if v == 3 { return 1 }
    if v == 2 { return 2 }
    return 3
}

// ---------- parsing ----------

var pool handle[Pool] = null
var parsed u64 = 0      // objects [0, parsed) are parsed and checked

struct StagedSh {
    lib ShLib
    data Bytes
    seq u64
    status u32
    pad u32
    snap addr
}

var staged_sh Vec[StagedSh] = {}
var parsed_sh u64 = 0
var parse_seq u64 = 0

fn sh_parse_job_offset(ctx addr, b u64, e u64, worker u32) void {
    base u64 = ctx[u64]
    shv handle[Vec[StagedSh]] = handle_from_addr[Vec[StagedSh]](&staged_sh)
    for i u64 in base + b..base + e {
        st handle[StagedSh] = vec_ref[StagedSh](shv, i)
        lh handle[ShLib] = handle_from_addr[ShLib](&st.lib)
        shared_parse(lh, lh.path, st.data) catch { st.status = 1 }
    }
}

fn parse_job(ctx addr, b u64, e u64, worker u32) void {
    for i u64 in b..e {
        o handle[Obj] = obj(i)
        if o.secs != null || lx(i).status != 0 { continue }
        elf_parse(o) catch err {
            lx(i).status = if err == Refused { 2 } else { 1 }
        }
    }
}

// Parses every object and shared library read so far; the first failure in
// input order is the OCaml linker's diagnostic.
fn parse_flush() void {
    shv handle[Vec[StagedSh]] = handle_from_addr[Vec[StagedSh]](&staged_sh)
    if parsed == nobj && parsed_sh == shv.n { return }
    t PhaseStart = {}
    phase_begin(PH_PARSE, &t)
    if parsed < nobj { pool_for(pool, nobj - parsed, 1, &parse_job_offset, &parsed) }
    if parsed_sh < shv.n { pool_for(pool, shv.n - parsed_sh, 1, &sh_parse_job_offset, &parsed_sh) }
    phase_end(PH_PARSE, &t)
    oi u64 = parsed
    si u64 = parsed_sh
    while oi < nobj || si < shv.n {
        take_obj bool = si == shv.n || (oi < nobj && lx(oi).seq < vec_ref[StagedSh](shv, si).seq)
        if take_obj {
            decoded_charge(obj(oi))
            st u32 = lx(oi).status
            if st != 0 { stat_restore(lx(oi).snap) }
            if st == 1 { die_buf(handle_from_addr[Buf](&obj(oi).msg)) }
            if st == 2 {
                refuse(buf_cstr(handle_from_addr[Buf](&obj(oi).msg)))
            }
            oi += 1
        } else {
            sh handle[StagedSh] = vec_ref[StagedSh](shv, si)
            if sh.status != 0 {
                stat_restore(sh.snap)
                die_buf(handle_from_addr[Buf](&sh.lib.msg))
            }
            si += 1
        }
    }
    parsed = nobj
    parsed_sh = shv.n
}

// on_decoded: the decoded debug sizes count against the combined input
// budget, in the OCaml linker's parse order
fn decoded_charge(o handle[Obj]) void {
    for k u64 in 0..zext[u64](o.ndec) {
        size u64 = o.dec[u64, k]
        if input_bytes > 268435456 || size > 268435456 - input_bytes {
            die_c(c"combined input and decoded debug size: size exceeds supported limit 268435456")
        }
        input_bytes += size
        stat_add(ST_DECODED_DEBUG_BYTES, size)
    }
    o.ndec = 0
}

fn parse_job_offset(ctx addr, b u64, e u64, worker u32) void {
    base u64 = ctx[u64]
    parse_job(null, base + b, base + e, worker)
}

// ---------- reading ----------

var reading bool = true   // the inputs are being read (objects staged)

fn input_die() void {
    if !reading { die() }
    // the message is in ld_msg: parse the earlier objects first
    keep Buf = {}
    k handle[Buf] = handle_from_addr[Buf](&keep)
    bb(k, buf_bytes(handle_from_addr[Buf](&ld_msg)))
    parse_flush()
    die_buf(k)
}

fn input_die_io(call addr, path Bytes, e error) void {
    m handle[Buf] = msg()
    io_message(m, call, path, e)
    input_die()
}

// File_io.read for an input
fn input_read(path Bytes, max_size u64) Bytes {
    vdata Bytes = {}
    if ld_vfs_get(path, handle_from_addr[Bytes](&vdata)) {
        if vdata.n > max_size {
            m handle[Buf] = msg()
            bb(m, path)
            bs(m, c": input exceeds ")
            bu(m, max_size)
            bs(m, c" byte limit or remaining input budget")
            input_die()
        }
        return vdata
    }
    fd i32 = os_open(path.p, O_RDONLY | O_NONBLOCK, 0) catch e {
        input_die_io(c"open", path, e)
        return bytes_empty()
    }
    st Stat = {}
    os_fstat(fd, handle_from_addr[Stat](&st)) catch e { input_die_io(c"fstat", bytes_empty(), e) }
    // OCaml 5's Unix.in_channel_of_descr refuses a directory with EINVAL
    // before File_io's own regular-file check runs
    if (st.mode & S_IFMT) == S_IFDIR {
        m handle[Buf] = msg()
        bs(m, c"in_channel_of_descr: : Invalid argument")
        input_die()
    }
    if (st.mode & S_IFMT) != S_IFREG {
        m handle[Buf] = msg()
        bb(m, path)
        bs(m, c": input must be a regular file")
        input_die()
    }
    size u64 = bitcast[u64](st.size)
    if size > max_size {
        m handle[Buf] = msg()
        bb(m, path)
        bs(m, c": input exceeds ")
        bu(m, max_size)
        bs(m, c" byte limit or remaining input budget")
        input_die()
    }
    data addr = null
    if size != 0 {
        data = os_mmap(null, size, PROT_READ, MAP_PRIVATE, fd, 0) catch e {
            input_die_io(c"read", path, e)
            return bytes_empty()
        }
    }
    os_close(fd)
    return bytes(data, size)
}

struct Snapshot {
    real Bytes
    data Bytes
}

var snapshots Vec[Snapshot] = {}
var input_bytes u64 = 0
var file_count u64 = 0
// every input path in the order the inputs were read (File_io's on_input)
var expanded Vec[Bytes] = {}

fn is_script(d Bytes) bool {
    if d.n == 0 { return false }
    for i u64 in 0..d.n {
        c u8 = d.p[u8, i]
        if !(c == 10 || c == 13 || c == 9 || (c >= 32 && c != 127)) { return false }
    }
    return true
}

// the prepared inputs, parallel to the command-line items
const P_OBJECT u8 = 0
const P_ARCHIVE u8 = 1
const P_GROUP u8 = 2
const P_SHARED u8 = 3

struct PNode {
    kind u8
    loaded bool
    as_needed bool
    ref u32         // P_OBJECT: staged object; P_ARCHIVE: archive; P_SHARED: staged_sh
    count u32       // P_GROUP: the nodes inside
}

var pnodes Vec[PNode] = {}

fn pnode_add(kind u8, ref u64) void {
    n handle[PNode] = vec_new[PNode](handle_from_addr[Vec[PNode]](&pnodes))
    n.kind = kind
    n.ref = trunc[u32](ref)
}

fn pnode_add_shared(ref u64, as_needed bool) void {
    n handle[PNode] = vec_new[PNode](handle_from_addr[Vec[PNode]](&pnodes))
    n.kind = P_SHARED
    n.ref = trunc[u32](ref)
    n.as_needed = as_needed
}

// ---------- shared library resolution state ----------

var shlibs Vec[addr] = {}                               // handle[ShLib] as addr (resolved.shared)
var sh_names Map[Bytes, u8, bytes_hash, bytes_eq] = {}  // loaded SONAMEs
var shared_refs Map[Bytes, u8, bytes_hash, bytes_eq] = {}
var sh_providers Map[Bytes, u64, bytes_hash, bytes_eq] = {} // name -> (lib_idx << 32 | exp_idx)
var sh_sym_total u64 = 0
var shdeps_graph ShDeps = {}

fn shlib(i u64) handle[ShLib] {
    return handle_from_addr[ShLib](vec_get[addr](handle_from_addr[Vec[addr]](&shlibs), i))
}

fn shref_add(name Bytes) void {
    h handle[Map[Bytes, u8, bytes_hash, bytes_eq]] = handle_from_addr[Map[Bytes, u8, bytes_hash, bytes_eq]](&shared_refs)
    map_put(h, name, 1)
}

fn is_shared_ref(name Bytes) bool {
    if shared_refs.n == 0 { return false }
    h handle[Map[Bytes, u8, bytes_hash, bytes_eq]] = handle_from_addr[Map[Bytes, u8, bytes_hash, bytes_eq]](&shared_refs)
    return map_has(h, name)
}

fn has_provider(name Bytes) bool {
    if sh_providers.n == 0 { return false }
    h handle[Map[Bytes, u64, bytes_hash, bytes_eq]] = handle_from_addr[Map[Bytes, u64, bytes_hash, bytes_eq]](&sh_providers)
    return map_has(h, name)
}

fn prov_find(name Bytes) u64 {
    if sh_providers.n == 0 { return NONE64 }
    h handle[Map[Bytes, u64, bytes_hash, bytes_eq]] = handle_from_addr[Map[Bytes, u64, bytes_hash, bytes_eq]](&sh_providers)
    return map_get(h, name) catch NONE64
}

fn prov_add(name Bytes, lib_idx u64, exp_idx u64) void {
    h handle[Map[Bytes, u64, bytes_hash, bytes_eq]] = handle_from_addr[Map[Bytes, u64, bytes_hash, bytes_eq]](&sh_providers)
    if !map_has(h, name) {
        map_put(h, name, (lib_idx << 32) | exp_idx)
    }
}

fn alloc_at_name(name Bytes, ver Bytes) Bytes {
    n u64 = name.n + 1 + ver.n
    p addr = heap_alloc(n + 1)
    mem_copy(p, name.p, name.n)
    p[u8, name.n] = 64
    mem_copy(p + name.n + 1, ver.p, ver.n)
    p[u8, n] = 0
    return bytes(p, n)
}

// one input file, prepared at script/group nesting `depth`; `scripts` are
// the canonical paths of the scripts being expanded (for cycles)
// Resolver.prepare's static_libraries for the input being read (-Bstatic
// or -static at its position; a script's -l inherits it)
var input_static bool = false

// Library_search.find's ~dynamic: a .so before the .a
fn library_dynamic() bool {
    m u8 = config().mode
    return !input_static && m != MODE_STATIC && m != MODE_STATIC_PIE
}

fn read_input(path Bytes, whole bool, as_needed bool, depth u64, scripts handle[Vec[Bytes]]) void {
    file_count += 1
    if file_count > 1024 {
        m handle[Buf] = msg()
        bs(m, c"input count exceeds 1024 file limit")
        input_die()
    }
    vec_push[Bytes](handle_from_addr[Vec[Bytes]](&expanded), path)
    rt PhaseStart = {}
    phase_begin(PH_READ, &rt)
    real Buf = {}
    rh handle[Buf] = handle_from_addr[Buf](&real)
    ld_realpath(path, rh) catch e { input_die_io(c"realpath", path, e) }
    max_size u64 = umin(MAX_FILE_SIZE, 268435456 - input_bytes)
    snaps handle[Vec[Snapshot]] = handle_from_addr[Vec[Snapshot]](&snapshots)
    data Bytes = bytes_empty()
    found bool = false
    for k u64 in 0..snaps.n {
        sn handle[Snapshot] = vec_ref[Snapshot](snaps, k)
        if bytes_eq(sn.real, buf_bytes(rh)) {
            data = sn.data
            found = true
            if data.n > max_size {
                m handle[Buf] = msg()
                bb(m, path)
                bs(m, c": input exceeds ")
                bu(m, max_size)
                bs(m, c" byte limit or remaining input budget")
                input_die()
            }
            stat_add(ST_INPUT_READ_CACHE_HITS, 1)
            break
        }
    }
    if !found {
        data = input_read(path, max_size)
        sn handle[Snapshot] = vec_new[Snapshot](snaps)
        sn.real = nul_dup(rh.p, rh.n)
        sn.data = data
    }
    buf_free(rh)
    phase_end(PH_READ, &rt)
    input_bytes += data.n
    stat_add(ST_INPUT_FILES, 1)
    stat_add(ST_INPUT_BYTES, data.n)
    if is_archive_data(data) {
        at PhaseStart = {}
        phase_begin(PH_PARSE, &at)
        archive_parse(path, data, whole)
        phase_end(PH_PARSE, &at)
        ai u64 = archives.n - 1
        a handle[Archive] = archive(ai)
        for k u64 in 0..a.members.n {
            m handle[Member] = member(a, k)
            if m.ext.n != 0 && ld_exists(m.ext) {
                vec_push[Bytes](handle_from_addr[Vec[Bytes]](&expanded), m.ext)
            }
        }
        if !whole && !a.indexed && a.members.n != 0 {
            m handle[Buf] = msg()
            bb(m, path)
            bs(m, c": archive has no symbol index (run ar s, or use --whole-archive)")
            input_die()
        }
        stat_add(ST_ARCHIVES, 1)
        pnode_add(P_ARCHIVE, ai)
        return
    }
    if shared_is(data) {
        m_mode u8 = config().mode
        if m_mode == MODE_STATIC_PIE || m_mode == MODE_STATIC {
            m handle[Buf] = msg()
            bb(m, path)
            if m_mode == MODE_STATIC_PIE {
                bs(m, c": static PIE cannot use shared-library inputs")
            } else {
                bs(m, c": shared input requires -pie or --dynamic-linker")
            }
            input_die()
        }
        shv handle[Vec[StagedSh]] = handle_from_addr[Vec[StagedSh]](&staged_sh)
        idx u64 = shv.n
        st handle[StagedSh] = vec_new[StagedSh](shv)
        st.lib.path = path
        st.data = data
        st.seq = parse_seq
        parse_seq += 1
        pnode_add_shared(idx, as_needed)
        if stats_on {
            stat_mark(PH_PARSE)
            st.snap = stat_snapshot()
        }
        return
    }
    if is_script(data) {
        script_input(path, data, whole, as_needed, depth, scripts)
        return
    }
    pnode_add(P_OBJECT, nobj)
    o handle[Obj] = new_object(c"")
    if !ld_take_preparsed(path, o, lx(nobj - 1)) {
        o.path = path
        o.data = data.p
        o.len = data.n
    }
    lx(nobj - 1).seq = parse_seq
    parse_seq += 1
    // the OCaml linker parses (and counts) each object as it is read
    if stats_on {
        stat_mark(PH_PARSE)
        lx(nobj - 1).snap = stat_snapshot()
    }
    // the OCaml linker parses each object as it is read: decoded debug
    // sizes shrink the budget of the inputs read after it
    if may_compress(data) { parse_flush() }
}

// read_extra: a thin archive's member file (read once per canonical path)
var extra_files Vec[Snapshot] = {}

fn read_extra_counted(path Bytes, counter u64) Bytes {
    real Buf = {}
    rh handle[Buf] = handle_from_addr[Buf](&real)
    ld_realpath(path, rh) catch e { input_die_io(c"realpath", path, e) }
    xs handle[Vec[Snapshot]] = handle_from_addr[Vec[Snapshot]](&extra_files)
    for k u64 in 0..xs.n {
        sn handle[Snapshot] = vec_ref[Snapshot](xs, k)
        if bytes_eq(sn.real, buf_bytes(rh)) {
            buf_free(rh)
            return sn.data
        }
    }
    file_count += 1
    if file_count > 1024 { input_die_c(c"input count exceeds 1024 file limit") }
    vec_push[Bytes](handle_from_addr[Vec[Bytes]](&expanded), path)
    rt PhaseStart = {}
    phase_begin(PH_READ, &rt)
    data Bytes = input_read(path, umin(MAX_FILE_SIZE, 268435456 - input_bytes))
    phase_end(PH_READ, &rt)
    input_bytes += data.n
    stat_add(counter, 1)
    stat_add(ST_INPUT_BYTES, data.n)
    sn handle[Snapshot] = vec_new[Snapshot](xs)
    sn.real = nul_dup(rh.p, rh.n)
    sn.data = data
    buf_free(rh)
    return data
}

fn read_extra(path Bytes) Bytes {
    return read_extra_counted(path, ST_THIN_MEMBER_FILES)
}

// Reads every input in command-line order, then parses them all.
fn read_inputs() void {
    c handle[Config] = config()
    items handle[Vec[Item]] = handle_from_addr[Vec[Item]](&c.items)
    nodes handle[Vec[PNode]] = handle_from_addr[Vec[PNode]](&pnodes)
    scripts Vec[Bytes] = {}
    sh handle[Vec[Bytes]] = handle_from_addr[Vec[Bytes]](&scripts)
    // the enclosing groups: they end after `count` items; a script input
    // expands to any number of nodes, so a group's node count is only
    // known at its end
    ends Vec[u64] = {}
    eh handle[Vec[u64]] = handle_from_addr[Vec[u64]](&ends)
    starts Vec[u64] = {}
    gh handle[Vec[u64]] = handle_from_addr[Vec[u64]](&starts)
    for i u64 in 0..items.n + 1 {
        while eh.n != 0 && vec_last[u64](eh) == i {
            vec_pop[u64](eh)
            g u64 = vec_pop[u64](gh)
            vec_ref[PNode](nodes, g).count = trunc[u32](nodes.n - g - 1)
        }
        if i == items.n { break }
        it handle[Item] = vec_ref[Item](items, i)
        depth u64 = eh.n
        if it.kind == IT_GROUP {
            vec_push[u64](eh, i + 1 + zext[u64](it.count))
            vec_push[u64](gh, nodes.n)
            pnode_add(P_GROUP, 0)
            continue
        }
        // Input.As_needed and Input.Static each add one level of policy
        // nesting (the OCaml prepare checks them before the file)
        static_wrap bool = it.kind == IT_PATH && it.static_lib
        extra u64 = 0
        if it.as_needed { extra = 1 }
        if (it.as_needed && depth >= 16) || (static_wrap && depth + extra >= 16) {
            m handle[Buf] = msg()
            bs(m, c"input policy nesting exceeds 16")
            input_die()
        }
        path Bytes = it.text
        input_static = it.static_lib
        if it.kind == IT_LIBRARY {
            // static output takes only archives (requires_static_inputs)
            path = library_find(it.text, library_dynamic(), handle_from_addr[Vec[Bytes]](&ldirs))
        }
        // the file's own depth: inside As_needed, then Static
        fd u64 = depth + extra
        if static_wrap { fd += 1 }
        read_input(path, it.whole, it.as_needed, fd, sh)
    }
    vec_free[u64](eh)
    vec_free[u64](gh)
    parse_flush()
    reading = false
}

// ---------- processing (Resolver.process) ----------

var staged_objs addr = null
var staged_lxs addr = null

fn sh_is_required(lib handle[ShLib]) bool {
    tmp Buf = {}
    th handle[Buf] = handle_from_addr[Buf](&tmp)
    defer { buf_free(th) }
    for ei u64 in 0..lib.exports.n {
        ex handle[ShExport] = sh_export(lib, ei)
        if ex.is_default {
            id u32 = find(ex.name)
            if id != NONE && needed(id) { return true }
        }
        if ex.version.n != SH_NONE {
            buf_clear(th)
            bb(th, ex.name)
            buf_u8(th, 64)
            bb(th, ex.version)
            id u32 = find(buf_bytes(th))
            if id != NONE && needed(id) { return true }
        }
    }
    return false
}

fn process_range(b u64, e u64) void {
    nodes handle[Vec[PNode]] = handle_from_addr[Vec[PNode]](&pnodes)
    shv handle[Vec[StagedSh]] = handle_from_addr[Vec[StagedSh]](&staged_sh)
    snh handle[Map[Bytes, u8, bytes_hash, bytes_eq]] = handle_from_addr[Map[Bytes, u8, bytes_hash, bytes_eq]](&sh_names)
    slh handle[Vec[addr]] = handle_from_addr[Vec[addr]](&shlibs)
    i u64 = b
    while i < e {
        n handle[PNode] = vec_ref[PNode](nodes, i)
        if n.kind == P_GROUP {
            inner u64 = zext[u64](n.count)
            prev_obj u64 = NONE64
            prev_sh u64 = NONE64
            while prev_obj != nobj || prev_sh != slh.n {
                prev_obj = nobj
                prev_sh = slh.n
                process_range(i + 1, i + 1 + inner)
            }
            i += 1 + inner
            continue
        }
        if n.kind == P_OBJECT {
            if !n.loaded {
                n.loaded = true
                add_member(handle_from_addr[Obj](staged_objs + zext[u64](n.ref) * sizeof[Obj]))
            }
        } else if n.kind == P_SHARED {
            st handle[StagedSh] = vec_ref[StagedSh](shv, zext[u64](n.ref))
            lib handle[ShLib] = handle_from_addr[ShLib](&st.lib)
            req bool = !n.as_needed || sh_is_required(lib)
            if req && !n.loaded && !map_has(snh, lib.needed) {
                map_put(snh, lib.needed, 1)
                idx u64 = slh.n
                vec_push[addr](slh, handle_addr(lib))
                n.loaded = true
                stat_add(ST_SHARED_LIBRARIES, 1)
                sh_sym_total = chk_add(c"combined shared symbol count", 4000000, sh_sym_total, lib.exports.n + lib.references.n)
                for ri u64 in 0..lib.references.n {
                    rf handle[ShRef] = sh_ref(lib, ri)
                    shref_add(rf.name)
                    if rf.undefined && rf.binding == 1 {
                        gsym(get(rf.name)).shared_undef = 1
                    }
                }
                for ei u64 in 0..lib.exports.n {
                    ex handle[ShExport] = sh_export(lib, ei)
                    if ex.is_default { prov_add(ex.name, idx, ei) }
                    if ex.version.n != SH_NONE { prov_add(alloc_at_name(ex.name, ex.version), idx, ei) }
                }
            }
        } else {
            extract(zext[u64](n.ref))
        }
        i += 1
    }
}

// Moves the staged input objects aside and adds the objects in the OCaml
// linker's order: inputs and extracted members as the walk reaches them.
fn process_inputs() void {
    staged_objs = objs
    staged_lxs = lxs
    objs = heap_alloc_zeroed(MAX_OBJECTS * sizeof[Obj])
    lxs = heap_alloc_zeroed(MAX_OBJECTS * sizeof[Lx])
    nobj = 0
    t PhaseStart = {}
    phase_begin(PH_RESOLVE, &t)
    process_range(0, pnodes.n)
    phase_end(PH_RESOLVE, &t)
    ninput_objects = nobj
}

// ---------- features the skeleton refuses ----------

fn check_supported(i u64) void {
    o handle[Obj] = obj(i)
}

// ---------- resolution ----------

var predefined_file u64 = NONE64
const NONE64 u64 = 0xffffffffffffffff

var ldirs Vec[Bytes] = {}

var symbol_total u64 = 0
var relocation_total u64 = 0

// COMDAT signatures seen so far: the first group with a signature wins
var signatures Vec[Bytes] = {}
var signature_index KeyIndex = {}

fn add_object(f u64) void {
    o handle[Obj] = obj(f)
    l handle[Lx] = lx(f)
    n u64 = zext[u64](o.nsec)
    l.discarded = heap_alloc_zeroed(n + 1)
    sv handle[Vec[Bytes]] = handle_from_addr[Vec[Bytes]](&signatures)
    sx handle[KeyIndex] = handle_from_addr[KeyIndex](&signature_index)
    for k u64 in 0..zext[u64](o.ngroup) {
        g handle[Group] = handle_from_addr[Group](o.groups + k * sizeof[Group])
        if !g.comdat { continue }
        hash u64 = bytes_hash(g.signature)
        e u32 = kx_first(sx, hash)
        while e != NONE && !bytes_eq(vec_get[Bytes](sv, zext[u64](e)), g.signature) { e = kx_next(sx, e) }
        if e != NONE {
            for j u64 in 0..zext[u64](g.n) { l.discarded[u8, zext[u64](g.members[u32, j])] = 1 }
            stat_add(ST_DISCARDED_COMDAT_GROUPS, 1)
        } else {
            kx_add(sx, hash, trunc[u32](sv.n))
            vec_push[Bytes](sv, g.signature)
        }
    }
    symbol_total = chk_add(c"combined symbol count", 4000000, symbol_total, zext[u64](o.nsym))
    relocation_total = chk_add(c"combined relocation count", 4000000, relocation_total, zext[u64](o.nrel))
    stat_add(ST_OBJECTS, 1)
    stat_add(ST_SYMBOLS, zext[u64](o.nsym))
    stat_add(ST_RELOCATIONS, zext[u64](o.nrel))
    l.gid = heap_alloc_zeroed(zext[u64](o.nsym) * 4 + 4)
    c handle[Config] = config()
    for index u64 in 0..zext[u64](o.nsym) {
        y handle[Sym] = sym(o, index)
        l.gid[u32, index] = NONE
        if y.binding == 0 { continue }
        id u32 = get(y.name)
        l.gid[u32, index] = id
        s handle[GSym] = gsym(id)
        if visibility_rank(y.visibility) > visibility_rank(s.visibility) { s.visibility = y.visibility }
        if y.section == 0 || (zext[u64](y.section) < n && l.discarded[u8, zext[u64](y.section)] != 0) {
            if y.binding == 1 { s.strong = 1 }
            continue
        }
        if y.section == 0xfff2 {
            size u64 = y.size
            alignment u64 = umax(1, y.value)
            if s.def_kind == DEF_NONE {
                s.def_kind = DEF_COMMON
                s.csize = size
                s.calign = alignment
            } else if s.def_kind == DEF_COMMON {
                s.csize = umax(s.csize, size)
                s.calign = umax(s.calign, alignment)
            } else if s.def_binding == 2 {
                s.def_kind = DEF_COMMON
                s.csize = size
                s.calign = alignment
            }
        } else {
            replace bool = false
            if s.def_kind == DEF_NONE {
                replace = true
            } else if s.def_kind == DEF_COMMON {
                replace = y.binding == 1
            } else {
                if s.def_binding == 1 && y.binding == 1 && !c.allow_multiple_definition {
                    m handle[Buf] = msg()
                    bs(m, c"duplicate symbol ")
                    bb(m, s.name)
                    bs(m, c": ")
                    bb(m, obj(zext[u64](s.def_file)).path)
                    bs(m, c" and ")
                    bb(m, o.path)
                    die()
                }
                replace = s.def_binding == 2 && y.binding == 1
            }
            if replace {
                s.def_kind = DEF_REGULAR
                s.def_file = trunc[u32](f)
                s.def_sym = trunc[u32](index)
                s.def_binding = y.binding
            }
        }
    }
}

fn identifier(b Bytes) bool {
    if b.n == 0 { return false }
    for i u64 in 0..b.n {
        c u8 = b.p[u8, i]
        alpha bool = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95
        if !alpha && !(i != 0 && c >= 48 && c <= 57) { return false }
    }
    return true
}

// Section_registry.boundary: the section named by __start_X / __stop_X
fn boundary(name Bytes, last addr) Bytes {
    if bytes_prefix(name, c"__start_") {
        rest Bytes = bytes_from(name, 8)
        if identifier(rest) {
            last[u8] = 0
            return rest
        }
    }
    if bytes_prefix(name, c"__stop_") {
        rest Bytes = bytes_from(name, 7)
        if identifier(rest) {
            last[u8] = 1
            return rest
        }
    }
    return bytes(null, NONE64)
}

fn has_boundary(name Bytes) bool {
    l u8 = 0
    return boundary(name, &l).n != NONE64
}

fn registry_eligible(s handle[Sec]) bool {
    return identifier(s.name) && (s.kind == 1 || s.kind == 8) && (s.flags & 2) != 0 && (s.flags & 0x400) == 0
}

fn same_signature(a handle[Sec], b handle[Sec]) bool {
    mask u64 = ~(0x200 | 0x200000)
    return a.kind == b.kind && (a.flags & mask) == (b.flags & mask) && a.entsize == b.entsize
}

// Section_registry.available, over the input objects (members in reverse
// file order: the OCaml list is built by prepending)
fn registry_available(name Bytes) bool {
    l u8 = 0
    section Bytes = boundary(name, &l)
    if section.n == NONE64 { return false }
    first handle[Sec] = null
    found bool = false
    f u64 = ninput_objects
    while f > 0 {
        f -= 1
        o handle[Obj] = obj(f)
        k u64 = zext[u64](o.nsec)
        while k > 0 {
            k -= 1
            s handle[Sec] = sec(o, k)
            if !bytes_eq(s.name, section) || lx(f).discarded[u8, k] != 0 { continue }
            if !found {
                first = s
                found = true
            }
            if !registry_eligible(s) {
                m handle[Buf] = msg()
                bb(m, name)
                bs(m, c": section boundaries require allocatable non-TLS PROGBITS or NOBITS section ")
                bb(m, section)
                die()
            }
            if !same_signature(s, first) {
                m handle[Buf] = msg()
                bb(m, name)
                bs(m, c": incompatible contributions to registry section ")
                bb(m, section)
                die()
            }
        }
    }
    return found
}

fn predefined_name(n Bytes) bool {
    return bytes_is(n, c"__executable_start") || bytes_is(n, c"__ehdr_start") ||
        bytes_is(n, c"__bss_start") || bytes_is(n, c"_etext") || bytes_is(n, c"etext") ||
        bytes_is(n, c"_edata") || bytes_is(n, c"edata") || bytes_is(n, c"_end") ||
        bytes_is(n, c"end") || bytes_is(n, c"_GLOBAL_OFFSET_TABLE_") ||
        bytes_is(n, c"__preinit_array_start") || bytes_is(n, c"__preinit_array_end") ||
        bytes_is(n, c"__init_array_start") || bytes_is(n, c"__init_array_end") ||
        bytes_is(n, c"__fini_array_start") || bytes_is(n, c"__fini_array_end") ||
        bytes_is(n, c"__rela_iplt_start") || bytes_is(n, c"__rela_iplt_end") ||
        (bytes_is(n, c"_DYNAMIC") && config().mode != MODE_STATIC)
}

fn hidden_predefined(n Bytes) bool {
    return has_boundary(n) || bytes_is(n, c"__executable_start") || bytes_is(n, c"__ehdr_start") ||
        bytes_is(n, c"_GLOBAL_OFFSET_TABLE_") || bytes_is(n, c"_DYNAMIC") ||
        bytes_is(n, c"__preinit_array_start") || bytes_is(n, c"__preinit_array_end") ||
        bytes_is(n, c"__init_array_start") || bytes_is(n, c"__init_array_end") ||
        bytes_is(n, c"__fini_array_start") || bytes_is(n, c"__fini_array_end") ||
        bytes_is(n, c"__rela_iplt_start") || bytes_is(n, c"__rela_iplt_end")
}

fn set_res(id u32, file u64, symbol u64, vis u8) void {
    g handle[GSym] = gsym(id)
    g.has_res = 1
    g.res_file = trunc[u32](file)
    g.res_sym = trunc[u32](symbol)
    g.res_vis = vis
}

// Builds a synthesized object's symbol (the rest of the Sym is zero)
fn synth_sym(o handle[Obj], index u64, name Bytes) handle[Sym] {
    y handle[Sym] = sym(o, index)
    y.name = name
    return y
}

// -r: no entry root, no linker-defined symbols, commons stay SHN_COMMON
var partial bool = false

fn resolve() void {
    c handle[Config] = config()
    if c.entry.n == 0 { die_c(c"entry symbol must not be empty") }
    // library search directories (Sysroot.directory without a root)
    dirs handle[Vec[Bytes]] = handle_from_addr[Vec[Bytes]](&c.library_paths)
    if c.has_sysroot { sysroot_normalize(c.sysroot) }
    lh handle[Vec[Bytes]] = handle_from_addr[Vec[Bytes]](&ldirs)
    for k u64 in 0..dirs.n { vec_push[Bytes](lh, root_directory(vec_get[Bytes](dirs, k))) }
    if dirs.n > 4096 { die_c(c"library search exceeds 4096 directories") }
    // Input.paths: every path item
    paths u64 = 0
    items handle[Vec[Item]] = handle_from_addr[Vec[Item]](&c.items)
    for k u64 in 0..items.n {
        if vec_ref[Item](items, k).kind == IT_PATH { paths += 1 }
    }
    if paths > 1024 { die_c(c"input count exceeds 1024 file limit") }
    read_inputs()

    // the entry and -u roots
    if !partial && c.mode != MODE_SHARED { gsym(get(c.entry)).strong = 1 }
    und handle[Vec[Bytes]] = handle_from_addr[Vec[Bytes]](&c.undefined)
    for k u64 in 0..und.n {
        name Bytes = vec_get[Bytes](und, k)
        if name.n == 0 { die_c(c"undefined root symbol must not be empty") }
        gsym(get(name)).strong = 1
    }
    process_inputs()

    // definitions, commons and linker-defined symbols, in state order
    common_file u64 = nobj
    commons Vec[u32] = {}
    ch handle[Vec[u32]] = handle_from_addr[Vec[u32]](&commons)
    common_size u64 = 0
    common_alignment u64 = 1
    predefined Vec[u32] = {}
    ph handle[Vec[u32]] = handle_from_addr[Vec[u32]](&predefined)
    count u64 = gsyms.n
    for i u64 in 0..count {
        id u32 = trunc[u32](i)
        s handle[GSym] = gsym(id)
        if s.def_kind == DEF_NONE {
            if partial {
                // nothing: undefined symbols stay undefined
            } else if predefined_name(s.name) || registry_available(s.name) {
                vec_push[u32](ph, id)
            } else {
                pv u64 = prov_find(s.name)
                if pv != NONE64 {
                    if s.strong != 0 || s.visibility == 0 {
                        lib_idx u64 = pv >> 32
                        exp_idx u64 = pv & 0xffffffff
                        ex handle[ShExport] = sh_export(shlib(lib_idx), exp_idx)
                        p handle[Imp] = imp_put(id)
                        p.name = ex.name
                        p.version = ex.version
                        p.size = ex.size
                        p.library = trunc[u32](lib_idx)
                        p.kind = ex.kind
                        p.binding = if s.strong != 0 { 1 } else { 2 }
                        p.visibility = s.visibility
                        p.is_default = if ex.is_default { 1 } else { 0 }
                    }
                } else if c.mode != MODE_STATIC && c.mode != MODE_STATIC_PIE && s.strong == 0 && s.visibility == 0 {
                    p handle[Imp] = imp_put(id)
                    p.name = s.name
                    p.binding = 2
                    p.is_default = 1
                }
                if !partial && s.strong != 0 && s.visibility != 0 && !c.gc_sections {
                    m handle[Buf] = msg()
                    bs(m, c"undefined non-default visibility symbol ")
                    bb(m, s.name)
                    die()
                }
            }
        } else if s.def_kind == DEF_REGULAR {
            set_res(id, zext[u64](s.def_file), zext[u64](s.def_sym), s.visibility)
        } else {
            if !partial { common_size = chk_align(c"common symbol layout", MAX_SECTION_SIZE, common_size, s.calign) }
            vec_push[u32](ch, id)
            // the symbol's value is its offset; kept in csize's place until
            // the object is built
            set_res(id, common_file, ch.n, s.visibility)
            if !partial {
                s.def_sym = trunc[u32](common_size)
                common_size = chk_add(c"common symbol layout", MAX_SECTION_SIZE, common_size, s.csize)
            }
            common_alignment = umax(common_alignment, s.calign)
        }
    }
    if ch.n != 0 {
        o handle[Obj] = new_object(c"<common>")
        o.nsec = 2
        o.secs = heap_alloc_zeroed(2 * sizeof[Sec])
        n0 handle[Sec] = sec(o, 0)
        n0.alignment = 1
        n0.group = -1
        b handle[Sec] = sec(o, 1)
        b.name = bytes_c(c".bss.common")
        b.kind = 8
        b.flags = 3
        b.size = common_size
        b.alignment = common_alignment
        b.group = -1
        o.nsym = trunc[u32](ch.n + 1)
        o.syms = heap_alloc_zeroed((ch.n + 1) * sizeof[Sym])
        l handle[Lx] = lx(common_file)
        l.discarded = heap_alloc_zeroed(2)
        l.gid = heap_alloc_zeroed((ch.n + 1) * 4)
        l.gid[u32, 0] = NONE
        for k u64 in 0..ch.n {
            id u32 = vec_get[u32](ch, k)
            g handle[GSym] = gsym(id)
            y handle[Sym] = synth_sym(o, k + 1, g.name)
            y.binding = 1
            y.kind = 1
            y.visibility = g.visibility
            y.section = if partial { 0xfff2 } else { 1 }
            // under -r the SHN_COMMON value is the alignment
            y.value = if partial { g.calign } else { zext[u64](g.def_sym) }
            y.size = g.csize
            l.gid[u32, k + 1] = id
        }
    }
    if ph.n != 0 {
        file u64 = nobj
        o handle[Obj] = new_object(c"<linker symbols>")
        stat_add(ST_LINKER_SYMBOLS, ph.n)
        o.nsym = trunc[u32](ph.n + 1)
        o.syms = heap_alloc_zeroed((ph.n + 1) * sizeof[Sym])
        l handle[Lx] = lx(file)
        l.discarded = heap_alloc_zeroed(1)
        l.gid = heap_alloc_zeroed((ph.n + 1) * 4)
        l.gid[u32, 0] = NONE
        for k u64 in 0..ph.n {
            id u32 = vec_get[u32](ph, k)
            g handle[GSym] = gsym(id)
            vis u8 = g.visibility
            if hidden_predefined(g.name) && visibility_rank(vis) < 2 { vis = 2 }
            set_res(id, file, k + 1, vis)
            y handle[Sym] = synth_sym(o, k + 1, g.name)
            y.binding = 1
            y.visibility = vis
            y.section = 0xfff1
            l.gid[u32, k + 1] = id
        }
        predefined_file = file
    }
    if !partial {
        gh handle[ShDeps] = handle_from_addr[ShDeps](&shdeps_graph)
        shdeps_load(gh, shlibs.p, shlibs.n)
        for li u64 in 0..gh.libraries.n {
            lib handle[ShLib] = shdeps_lib(gh, li)
            for ri u64 in 0..lib.references.n {
                rf handle[ShRef] = sh_ref(lib, ri)
                shref_add(rf.name)
                if rf.version.n != SH_NONE {
                    shref_add(alloc_at_name(rf.name, rf.version))
                }
            }
        }
    }
}
