// In-process library API, virtual filesystem (LdVfs), per-link Region
// isolation, and incremental early-parse session hooks for fas-ld.
//
// Public API:
//   struct LdVfs {
//       files Map[Bytes, Bytes, bytes_hash, bytes_eq]
//       keys Vec[Bytes]
//       in_memory bool       // true: capture output in out_data/out_size instead of disk
//       quiet bool           // true: capture diagnostics in `diag` without writing stderr
//       threads u32          // 0 = default (CPU count)
//       out_data addr        // heap-allocated output image (valid until vfs_clear_output/vfs_free)
//       out_size u64
//       map_data addr        // heap-allocated -Map output when in_memory && -Map
//       map_size u64
//       diag Buf             // diagnostic text when exit code != 0
//   }
//
//   fn vfs_add(v handle[LdVfs], path Bytes, data Bytes) void
//   fn vfs_has(v handle[LdVfs], path Bytes) bool
//   fn vfs_get(v handle[LdVfs], path Bytes, out handle[Bytes]) bool
//   fn vfs_clear_output(v handle[LdVfs]) void
//   fn vfs_free(v handle[LdVfs]) void
//
//   fn ld_link(argv addr, argc u64, vfs handle[LdVfs]) i32
//
//   struct LdSession { vfs handle[LdVfs], pre_objs Vec[addr], pre_map Map[Bytes, addr, bytes_hash, bytes_eq] }
//   fn ld_session_begin(s handle[LdSession], vfs handle[LdVfs]) void
//   fn ld_add_input(s handle[LdSession], name Bytes, data Bytes) void
//   fn ld_finish(s handle[LdSession], argv addr, argc u64) i32

struct LdVfs {
    files Map[Bytes, Bytes, bytes_hash, bytes_eq]
    keys Vec[Bytes]
    in_memory bool
    quiet bool
    threads u32
    pad u32
    out_data addr
    out_size u64
    map_data addr
    map_size u64
    diag Buf
}

struct LdPreObj {
    obj Obj
    status u32
    pad u32
}

struct LdSession {
    vfs handle[LdVfs]
    pre_objs Vec[addr]
    pre_map Map[Bytes, addr, bytes_hash, bytes_eq]
}

// ---------- VFS operations ----------

fn vfs_add(v handle[LdVfs], path Bytes, data Bytes) void {
    k Bytes = nul_dup(path.p, path.n)
    vec_push(&v.keys, k)
    map_put(&v.files, k, data)
}

fn vfs_has(v handle[LdVfs], path Bytes) bool {
    if v == null { return false }
    return map_has(&v.files, path)
}

fn vfs_get(v handle[LdVfs], path Bytes, out handle[Bytes]) bool {
    if v == null { return false }
    d Bytes = map_get(&v.files, path) catch { return false }
    out.p = d.p
    out.n = d.n
    return true
}

fn vfs_clear_output(v handle[LdVfs]) void {
    if v == null { return }
    if v.out_data != null { heap_free(v.out_data) }
    v.out_data = null
    v.out_size = 0
    if v.map_data != null { heap_free(v.map_data) }
    v.map_data = null
    v.map_size = 0
    buf_clear(&v.diag)
}

fn vfs_free(v handle[LdVfs]) void {
    if v == null { return }
    vfs_clear_output(v)
    buf_free(&v.diag)
    for i u64 in 0..v.keys.n {
        heap_free(vec_get(&v.keys, i).p)
    }
    vec_free(&v.keys)
    map_free(&v.files)
}

// ---------- VFS-aware hooks used by linker modules ----------

fn ld_vfs_has(path Bytes) bool {
    return vfs_has(ld.ld_api_vfs, path)
}

fn ld_vfs_get(path Bytes, out handle[Bytes]) bool {
    return vfs_get(ld.ld_api_vfs, path, out)
}

fn ld_vfs_in_memory() bool {
    v handle[LdVfs] = ld.ld_api_vfs
    return v != null && v.in_memory
}

// Consults the VFS before os_exists.
fn ld_exists(path Bytes) bool {
    if ld_vfs_has(path) { return true }
    return os_exists(path.p)
}

// Consults the VFS before path_realpath.
fn ld_realpath(path Bytes, out handle[Buf]) void fails {
    if ld_vfs_has(path) {
        bb(out, path)
        return
    }
    try path_realpath(path.p, out)
}

// Captures output image (and optional map) into VFS memory when in_memory is set.
// Allocated on the plain heap so the buffers survive the link's region_dispose.
fn ld_capture_output(img addr, sz u64, has_map bool, map_b Bytes) void {
    v handle[LdVfs] = ld.ld_api_vfs
    if v == null { return }
    if sz != 0 {
        v.out_data = heap_alloc_plain(sz)
        mem_copy(v.out_data, img, sz)
    }
    v.out_size = sz
    if has_map {
        if map_b.n != 0 {
            v.map_data = heap_alloc_plain(map_b.n)
            mem_copy(v.map_data, map_b.p, map_b.n)
        }
        v.map_size = map_b.n
    }
}

// ---------- library entry point ----------

fn ld_link_session(argv addr, argc u64, vfs handle[LdVfs], sess handle[LdSession]) i32 {
    vfs_clear_output(vfs)

    reg Region = {}
    prev_reg handle[Region] = region_switch(&reg)
    prev_ld handle[Ld] = ld

    ctx handle[Ld] = handle_from_addr(heap_alloc_zeroed(sizeof[Ld]))
    ld_init(ctx)
    ld = ctx
    ld.ld_api_vfs = vfs
    ld.ld_api_session = sess
    ld.ld_api_active = true
    ld.ld_api_quiet = vfs != null && vfs.quiet

    ld.objs = heap_alloc_zeroed(MAX_OBJECTS * sizeof[Obj])
    ld.lxs = heap_alloc_zeroed(MAX_OBJECTS * sizeof[Lx])

    threads u32 = if vfs != null { vfs.threads } else { 0 }
    if threads == 0 {
        t addr = os_getenv(c"FAS_LD_THREADS")
        if t != null { threads = trunc[u32](bytes_to_u64(bytes_c(t)) catch 0) }
    }
    pool_p handle[Pool] = handle_from_addr(heap_alloc_zeroed(sizeof[Pool]))
    ld.pool = pool_start_on(pool_p, threads)

    code i32 = 0
    ld_run(argv, argc) catch e { code = ld_exit_code(e) }

    pool_stop(ld.pool)
    ld.pool = null
    intern_free(&ld.names)
    ld_unmap_all()

    // Switch out of the link's region before copying diagnostics into vfs.diag
    // so vfs.diag lives on the caller's heap and survives region_dispose.
    region_switch(prev_reg)
    if vfs != null && ld.ld_api_diag.n != 0 {
        buf_clear(&vfs.diag)
        bb(&vfs.diag, buf_bytes(&ld.ld_api_diag))
    }

    ld = prev_ld
    region_dispose(&reg)
    return code
}

// Links using `argv[0..argc)` (C-string arguments, without argv[0] program
// name) and optional `vfs`. Returns the linker exit code (0, 1, or 3) without
// terminating the process, reclaiming all per-link allocations on return.
fn ld_link(argv addr, argc u64, vfs handle[LdVfs]) i32 {
    return ld_link_session(argv, argc, vfs, null)
}

fn ld_run(argv addr, argc u64) void fails {
    try parse_command_line_argv(argv, argc)
    c handle[Config] = config()
    if c.statistics { stats_start() }
    if c.print_version { print_version() }
    if c.relocatable { try partial_link_and_publish() } else { try link_and_publish() }
    stats_print()
}

// ---------- incremental early-parse session ----------

// Starts an incremental session: inputs added via `ld_add_input` are stored in
// `vfs` and relocatable objects are parsed immediately so parsing overlaps with
// upstream compilation; `ld_finish` runs the deterministic link in argv order.
fn ld_session_begin(s handle[LdSession], vfs handle[LdVfs]) void {
    s.vfs = vfs
    vec_clear(&s.pre_objs)
    map_clear(&s.pre_map)
}

fn ld_add_input(s handle[LdSession], name Bytes, data Bytes) void {
    vfs_add(s.vfs, name, data)
    if is_archive_data(data) || shared_is(data) || is_script(data) { return }
    p addr = heap_alloc_zeroed(sizeof[LdPreObj])
    pre handle[LdPreObj] = handle_from_addr(p)
    o handle[Obj] = &pre.obj
    o.path = nul_dup(name.p, name.n)
    o.data = data.p
    o.len = data.n
    elf_parse(o) catch err {
        pre.status = if err == Refused { 2 } else { 1 }
    }
    vec_push(&s.pre_objs, p)
    map_put(&s.pre_map, o.path, p)
}

// Consumes a pre-parsed object if `path` was added via `ld_add_input`.
fn ld_take_preparsed(path Bytes, dst_obj handle[Obj], dst_lx handle[Lx]) bool {
    s handle[LdSession] = ld.ld_api_session
    if s == null { return false }
    p addr = map_get(&s.pre_map, path) catch null
    if p == null { return false }
    map_remove(&s.pre_map, path)
    pre handle[LdPreObj] = handle_from_addr(p)
    mem_copy(handle_addr(dst_obj), &pre.obj, sizeof[Obj])
    dst_obj.path = path
    dst_lx.status = pre.status
    return true
}

fn ld_finish(s handle[LdSession], argv addr, argc u64) i32 {
    code i32 = ld_link_session(argv, argc, s.vfs, s)
    for i u64 in 0..s.pre_objs.n {
        p addr = vec_get(&s.pre_objs, i)
        pre handle[LdPreObj] = handle_from_addr(p)
        o handle[Obj] = &pre.obj
        heap_free(o.path.p)
        heap_free(o.secs)
        heap_free(o.syms)
        heap_free(o.rels)
        heap_free(o.groups)
        heap_free(o.dec)
        buf_free(&o.msg)
        heap_free(p)
    }
    vec_free(&s.pre_objs)
    map_free(&s.pre_map)
    return code
}
