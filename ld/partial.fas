// -r: relocatable output, a port of src/linker/partial_link.ml (and
// Symver.plan/key, which only the partial link needs).
//
// ET_REL combination merges same-named input sections (see the content
// pass in partial_combine): no addresses are assigned and no relocation
// expressions are evaluated. Output sections come in the OCaml order: group
// headers, content sections, relocation sections, then the synthesized
// tables.

// ---------- Symver.plan / Symver.key ----------

// per global id: the id `key` maps it to, NONE when it maps to itself

// Symver.plan: a default-version definition name@@V of (file, index) is
// the key for the aliases `name` and `name@V` when they resolve to the
// same section, value and kind of the same file
fn symver_plan() void {
    ld.sv_alias = heap_alloc(ld.gsyms.n * 4 + 4)
    for i u64 in 0..ld.gsyms.n { ld.sv_alias[u32, i] = NONE }
    m Buf = {}
    tmp Buf = {}
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for k u64 in 0..zext[u64](o.nsym) {
            y handle[Sym] = sym(o, k)
            if y.binding == 0 { continue }
            id u32 = gid_of(f, k)
            if id == NONE { continue }
            g handle[GSym] = gsym(id)
            if g.has_res == 0 || zext[u64](g.res_file) != f || zext[u64](g.res_sym) != k { continue }
            // Symver.expand has validated every versioned name
            at u64 = symver_at(y.name, &m) catch NONE64
            if at == NONE64 || !symver_default(y.name, at) { continue }
            for which u64 in 0..2 {
                buf_clear(&tmp)
                buf_raw(&tmp, y.name.p, at)
                if which == 1 {
                    buf_u8(&tmp, 64)
                    buf_raw(&tmp, y.name.p + at + 2, y.name.n - at - 2)
                }
                aid u32 = find(buf_bytes(&tmp))
                if aid == NONE { continue }
                a handle[GSym] = gsym(aid)
                if a.has_res == 0 || zext[u64](a.res_file) != f { continue }
                t handle[Sym] = sym(obj(f), zext[u64](a.res_sym))
                if t.section == y.section && t.value == y.value && t.kind == y.kind {
                    ld.sv_alias[u32, zext[u64](aid)] = id
                }
            }
        }
    }
    buf_free(&m)
    buf_free(&tmp)
}

fn symver_key(id u32) u32 {
    a u32 = ld.sv_alias[u32, zext[u64](id)]
    return if a == NONE { id } else { a }
}

// ---------- the output sections ----------

struct PSec {
    hdr Sec             // name, kind, flags, size, link, info, alignment, entsize; offset is the output offset
    data addr           // the bytes (hdr.size of them), unless kind 8
    file u64            // the source (relocations and groups)
    src u64
}


// `add`: the next output section (index = position + 1)
fn padd(h handle[Sec], data addr, file u64, src u64) u64 fails {
    if ld.psecs.n + 1 >= 0xff00 - 4 { try die_c(c"partial link: too many output sections") }
    p handle[PSec] = vec_add(&ld.psecs)
    copy_into[Sec](&p.hdr, h)
    p.data = data
    p.file = file
    p.src = src
    return ld.psecs.n
}

fn psec(i u64) handle[PSec] {
    return vec_at(&ld.psecs, i - 1)
}

// `fresh`: a synthesized section header
fn pfresh(name addr, kind u32, flags u64, alignment u64, entsize u64, size u64, data addr) u64 fails {
    h Sec = {}
    h.name = bytes_c(name)
    h.kind = kind
    h.flags = flags
    h.alignment = alignment
    h.entsize = entsize
    h.size = size
    return try padd(&h, data, NONE64, 0)
}

// ---------- symbols ----------


fn psym_add(y handle[Sym]) u32 fails {
    if ld.psyms.n + 1 >= MAX_SYMBOLS { try die_c(c"partial link: too many output symbols") }
    copy_into[Sym](vec_add(&ld.psyms), y)
    return trunc[u32](ld.psyms.n)
}

// per file: u32 per section (output index, 0 when dropped) and u32 per
// symbol (output index, 0 when dropped)

fn pmap(f u64) addr { return ld.pmaps[addr, f] }
fn psmap(f u64) addr { return ld.psmaps[addr, f] }
fn pbase(f u64) addr { return ld.pbases[addr, f] }

// remap_symbol: the copy of y with its section index remapped and its
// value moved by its input section's offset in the output section
fn premap(f u64, y handle[Sym], out handle[Sym]) void {
    copy_into(out, y)
    if y.section != 0 && y.section < 0xff00 {
        out.section = pmap(f)[u32, zext[u64](y.section)]
        out.value = y.value + pbase(f)[u64, zext[u64](y.section)]
    }
}

// one input relocation section's entries inside its output section
struct RPart {
    file u64
    src u64
    out u64
    start u64
}

fn content_kind(kd u32) bool {
    return kd == 1 || kd == 7 || kd == 8 || kd == 14 || kd == 15 || kd == 16
}

// Binary.add with the partial string context
fn pstring(b handle[Buf], name Bytes) u64 fails {
    offset u64 = b.n
    try chk_add(c"partial string storage", MAX_FILE_SIZE, offset, name.n + 1)
    buf_append(b, name)
    buf_u8(b, 0)
    return offset
}

fn pfail_name(text addr, name Bytes) void fails {
    m handle[Buf] = msg()
    bs(m, text)
    bb(m, name)
    try die()
}

// ---------- combine ----------

fn partial_combine() void fails {
    alloc_tables()
    try properties_prepare()
    ld.pmaps = heap_alloc_zeroed(ld.nobj * 8 + 8)
    ld.psmaps = heap_alloc_zeroed(ld.nobj * 8 + 8)
    ld.pbases = heap_alloc_zeroed(ld.nobj * 8 + 8)
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        ld.pmaps[addr, f] = heap_alloc_zeroed(zext[u64](o.nsec) * 4 + 4)
        ld.psmaps[addr, f] = heap_alloc_zeroed(zext[u64](o.nsym) * 4 + 4)
        ld.pbases[addr, f] = heap_alloc_zeroed(zext[u64](o.nsec) * 8 + 8)
    }
    // group headers first: ELF requires each to precede its members
    groups Vec[u64] = {}
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for k u64 in 0..zext[u64](o.nsec) {
            s handle[Sec] = sec(o, k)
            if s.kind != 17 { continue }
            members u64 = s.size / 4 - 1
            keep bool = members == 0
            for n u64 in 0..members {
                if kept(f, rd32(o.data, s.offset + 4 + n * 4)) {
                    keep = true
                    break
                }
            }
            if !keep { continue }
            index u64 = try padd(s, heap_alloc_zeroed(s.size + 1), f, k)
            pmap(f)[u32, k] = trunc[u32](index)
            vec_push(&groups, index)
        }
    }
    // content sections: input sections with the same name, type, entsize
    // and flags other than SHF_WRITE/SHF_EXECINSTR share one output section
    // whose flags are the union, as in GNU ld and lld -r (objtool finds
    // vmlinux.o sections by name; the kernel mixes "a" assembly with "aw" C
    // sections of one name). Group members stay separate. pbase records
    // each input section's offset in its output section.
    merged KeyIndex = {}
    merged_out Vec[u64] = {}    // per merged entry: its output section
    contents Vec[u64] = {}
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for k u64 in 0..zext[u64](o.nsec) {
            s handle[Sec] = sec(o, k)
            if !kept(f, k) || !content_kind(s.kind) { continue }
            if bytes_is(s.name, c".note.GNU-stack") { continue }
            if f >= ld.ninput_objects && bytes_is(o.path, c"<common>") { continue }
            separate bool = (s.flags & 0x200) != 0
            key_flags u64 = s.flags & ~5
            hash u64 = hash_mix(bytes_hash(s.name) ^ (zext[u64](s.kind) << 48) ^ hash_mix(key_flags ^ (s.entsize << 32)))
            out u64 = 0
            if !separate {
                id u32 = kx_first(&merged, hash)
                while id != NONE {
                    c handle[Sec] = &psec(vec_get(&merged_out, zext[u64](id))).hdr
                    if c.kind == s.kind && (c.flags & ~5) == key_flags && c.entsize == s.entsize && bytes_eq(c.name, s.name) {
                        out = vec_get(&merged_out, zext[u64](id))
                        break
                    }
                    id = kx_next(&merged, id)
                }
            }
            if out == 0 {
                h Sec = {}
                copy_into[Sec](&h, s)
                h.size = 0
                h.alignment = 1
                out = try padd(&h, null, f, k)
                vec_push(&contents, out)
                if !separate {
                    kx_add(&merged, hash, trunc[u32](merged_out.n))
                    vec_push(&merged_out, out)
                }
            }
            p handle[PSec] = psec(out)
            alignment u64 = umax(1, s.alignment)
            base u64 = try chk_align(c"partial section layout", MAX_FILE_SIZE, p.hdr.size, alignment)
            p.hdr.size = try chk_add(c"partial section size", MAX_FILE_SIZE, base, s.size)
            p.hdr.alignment = umax(p.hdr.alignment, alignment)
            p.hdr.flags = p.hdr.flags | s.flags
            pbase(f)[u64, k] = base
            pmap(f)[u32, k] = trunc[u32](out)
        }
    }
    kx_free(&merged)
    vec_free(&merged_out)
    // the bytes: gaps in executable output sections are int3, others zero
    for j u64 in 0..contents.n {
        p handle[PSec] = psec(vec_get(&contents, j))
        if p.hdr.kind == 8 { continue }
        p.data = heap_alloc_zeroed(p.hdr.size + 1)
        if (p.hdr.flags & 4) != 0 { mem_set(p.data, 0xcc, p.hdr.size) }
    }
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for k u64 in 0..zext[u64](o.nsec) {
            s handle[Sec] = sec(o, k)
            out u64 = zext[u64](pmap(f)[u32, k])
            if out == 0 || s.kind == 8 || !content_kind(s.kind) { continue }
            mem_copy(psec(out).data + pbase(f)[u64, k], o.data + s.offset, s.size)
        }
    }
    vec_free(&contents)
    // relocation sections whose target was kept: one output section per
    // output target, holding each input's entries in input order
    relocs Vec[u64] = {}
    rparts Vec[RPart] = {}
    rmap addr = heap_alloc_zeroed(0xff00 * 4)
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for k u64 in 0..zext[u64](o.nsec) {
            s handle[Sec] = sec(o, k)
            if s.kind != 4 || !kept(f, k) || pmap(f)[u32, zext[u64](s.info)] == 0 { continue }
            target u64 = zext[u64](pmap(f)[u32, zext[u64](s.info)])
            index u64 = zext[u64](rmap[u32, target])
            if index == 0 {
                h Sec = {}
                copy_into[Sec](&h, s)
                h.size = 0
                h.info = trunc[u32](target)
                index = try padd(&h, null, f, k)
                rmap[u32, target] = trunc[u32](index)
                vec_push(&relocs, index)
            }
            p handle[PSec] = psec(index)
            part handle[RPart] = vec_add(&rparts)
            part.file = f
            part.src = k
            part.out = index
            part.start = p.hdr.size
            p.hdr.size = try chk_add(c"partial relocation size", MAX_FILE_SIZE, p.hdr.size, s.size)
            pmap(f)[u32, k] = trunc[u32](index)
        }
    }
    heap_free(rmap)
    for j u64 in 0..relocs.n {
        p handle[PSec] = psec(vec_get(&relocs, j))
        p.data = heap_alloc(p.hdr.size + 1)
    }
    for j u64 in 0..rparts.n {
        part handle[RPart] = vec_at(&rparts, j)
        s handle[Sec] = sec(obj(part.file), part.src)
        mem_copy(psec(part.out).data + part.start, obj(part.file).data + s.offset, s.size)
    }

    // locals, in object order; input section symbols collapse into one per
    // output section (relocations against them get the base in the addend)
    out Sym = {}
    section_syms addr = heap_alloc_zeroed(0xff00 * 4)
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for n u64 in 1..zext[u64](o.nsym) {
            y handle[Sym] = sym(o, n)
            if y.binding != 0 { continue }
            if !(y.section >= 0xff00 || (y.section != 0 && pmap(f)[u32, zext[u64](y.section)] != 0)) { continue }
            if y.kind == 3 && y.section < 0xff00 {
                output u64 = zext[u64](pmap(f)[u32, zext[u64](y.section)])
                index u32 = section_syms[u32, output]
                if index == 0 {
                    premap(f, y, &out)
                    out.value = 0
                    index = try psym_add(&out)
                    section_syms[u32, output] = index
                }
                psmap(f)[u32, n] = index
                continue
            }
            premap(f, y, &out)
            psmap(f)[u32, n] = try psym_add(&out)
        }
    }
    heap_free(section_syms)
    first_global u64 = ld.psyms.n + 1

    // globals: one per key, in first-seen order, with the highest
    // visibility and the first nonzero kind
    ng u64 = ld.gsyms.n
    pos addr = heap_alloc(ng * 4 + 4)
    for i u64 in 0..ng { pos[u32, i] = NONE }
    order Vec[u32] = {}
    decls Vec[Sym] = {}
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for n u64 in 0..zext[u64](o.nsym) {
            y handle[Sym] = sym(o, n)
            if y.binding == 0 { continue }
            key u32 = symver_key(gid_of(f, n))
            p u32 = pos[u32, zext[u64](key)]
            if p == NONE {
                pos[u32, zext[u64](key)] = trunc[u32](decls.n)
                vec_push(&order, key)
                d handle[Sym] = vec_add(&decls)
                copy_into(d, y)
                d.name = gsym(key).name
            } else {
                d handle[Sym] = vec_at(&decls, zext[u64](p))
                if visibility_rank(y.visibility) > visibility_rank(d.visibility) { d.visibility = y.visibility }
                if d.kind == 0 { d.kind = y.kind }
            }
        }
    }
    gidx addr = heap_alloc_zeroed(ng * 4 + 4)
    for j u64 in 0..order.n {
        key u32 = vec_get(&order, j)
        g handle[GSym] = gsym(key)
        if g.has_res != 0 {
            df u64 = zext[u64](g.res_file)
            premap(df, sym(obj(df), zext[u64](g.res_sym)), &out)
            if out.section == 0 {
                m handle[Buf] = msg()
                bs(m, c"partial link: definition ")
                bb(m, g.name)
                bs(m, c" lost its section")
                try die()
            }
            out.name = g.name
            out.visibility = g.res_vis
        } else {
            copy_into[Sym](&out, vec_at(&decls, j))
            out.section = 0
            out.value = 0
            out.binding = if g.strong != 0 { 1 } else { 2 }
        }
        gidx[u32, zext[u64](key)] = try psym_add(&out)
    }
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for n u64 in 0..zext[u64](o.nsym) {
            if sym(o, n).binding == 0 { continue }
            psmap(f)[u32, n] = gidx[u32, zext[u64](symver_key(gid_of(f, n)))]
        }
    }
    heap_free(pos)
    heap_free(gidx)
    vec_free(&order)
    vec_free(&decls)

    // relocations, last section first (the OCaml list order): symbol
    // indices remapped; a dropped local keeps a zero addend outside
    // allocated sections and .eh_frame
    // offsets move by the target's base; section-symbol addends by theirs
    ri u64 = rparts.n
    while ri > 0 {
        ri -= 1
        part handle[RPart] = vec_at(&rparts, ri)
        p handle[PSec] = psec(part.out)
        f u64 = part.file
        o handle[Obj] = obj(f)
        original handle[Sec] = sec(o, part.src)
        target handle[Sec] = sec(o, zext[u64](original.info))
        shift u64 = pbase(f)[u64, zext[u64](original.info)]
        for n u64 in 0..original.size / 24 {
            at u64 = part.start + n * 24
            source u64 = original.offset + n * 24
            wr64(p.data, at, rd64(o.data, source) + shift)
            info u64 = rd64(o.data, source + 8)
            old u64 = info >> 32
            mapped u64 = zext[u64](psmap(f)[u32, old])
            y handle[Sym] = sym(o, old)
            if old != 0 && mapped != 0 && y.kind == 3 && y.section != 0 && y.section < 0xff00 {
                wr64(p.data, at + 16, rd64(o.data, source + 16) + pbase(f)[u64, zext[u64](y.section)])
            }
            if old != 0 && mapped == 0 {
                if (target.flags & 2) != 0 && !bytes_is(target.name, c".eh_frame") {
                    m handle[Buf] = msg()
                    bb(m, o.path)
                    bs(m, c": partial relocation references discarded local symbol ")
                    bb(m, sym(o, old).name)
                    try die()
                }
                wr64(p.data, at + 16, 0)
            }
            wr64(p.data, at + 8, (mapped << 32) | (info & 0xffffffff))
        }
    }
    vec_free(&rparts)
    // group bodies, last group first
    gi u64 = groups.n
    while gi > 0 {
        gi -= 1
        p handle[PSec] = psec(vec_get(&groups, gi))
        f u64 = p.file
        o handle[Obj] = obj(f)
        original handle[Sec] = sec(o, p.src)
        wr32(p.data, 0, rd32(o.data, original.offset))
        for n u64 in 0..original.size / 4 - 1 {
            mapped u32 = pmap(f)[u32, rd32(o.data, original.offset + 4 + n * 4)]
            if mapped == 0 { try die_c(c"partial link: incomplete group membership") }
            wr32(p.data, 4 + n * 4, zext[u64](mapped))
        }
        p.hdr.info = psmap(f)[u32, zext[u64](original.info)]
    }

    // address significance: every output symbol of an object without
    // (valid) tables, else the ones its tables list
    count u64 = ld.psyms.n
    significant addr = heap_alloc_zeroed(count + 1)
    has_significance bool = false
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        tables u64 = 0
        unlinked bool = false
        for k u64 in 0..zext[u64](o.nsec) {
            s handle[Sec] = sec(o, k)
            if s.kind != 0x6fff4c03 { continue }
            tables += 1
            if s.link == 0 { unlinked = true }
        }
        if tables != 0 { has_significance = true }
        sm addr = psmap(f)
        if tables == 0 || unlinked {
            for n u64 in 0..zext[u64](o.nsym) { significant[u8, zext[u64](sm[u32, n])] = 1 }
            continue
        }
        for k u64 in 0..zext[u64](o.nsec) {
            s handle[Sec] = sec(o, k)
            if s.kind != 0x6fff4c03 { continue }
            at u64 = s.offset
            while at < s.offset + s.size {
                value u64 = 0
                shift u64 = 0
                more bool = true
                while more {
                    b u64 = rd8(o.data, at)
                    at += 1
                    value = value | ((b & 127) << shift)
                    shift += 7
                    more = (b & 128) != 0
                }
                significant[u8, zext[u64](sm[u32, value])] = 1
            }
        }
    }
    sig Buf = {}
    for index u64 in 1..count + 1 {
        if significant[u8, index] == 0 { continue }
        value u64 = index
        while true {
            byte u64 = value & 127
            if value > 127 { byte = byte | 128 }
            buf_u8(&sig, trunc[u8](byte))
            if value <= 127 { break }
            value = value >> 7
        }
    }
    heap_free(significant)
    sig_index u64 = 0
    if has_significance {
        sig_index = try pfresh(c".llvm_addrsig", 0x6fff4c03, 0x80000000, 1, 0, sig.n, sig.p)
    }
    try pfresh(c".note.GNU-stack", 1, 0, 1, 0, 0, null)

    // .symtab and .strtab (names are not shared)
    strings Buf = {}
    buf_u8(&strings, 0)
    symbol_data addr = heap_alloc_zeroed((count + 1) * 24)
    for n u64 in 0..count {
        y handle[Sym] = vec_at(&ld.psyms, n)
        at u64 = (n + 1) * 24
        wr32(symbol_data, at, try pstring(&strings, y.name))
        wr8(symbol_data, at + 4, (zext[u64](y.binding) << 4) | zext[u64](y.kind))
        wr8(symbol_data, at + 5, zext[u64](y.visibility))
        wr16(symbol_data, at + 6, zext[u64](y.section))
        wr64(symbol_data, at + 8, y.value)
        wr64(symbol_data, at + 16, y.size)
    }
    symtab u64 = try pfresh(c".symtab", 2, 0, 8, 24, (count + 1) * 24, symbol_data)
    psec(symtab).hdr.info = trunc[u32](first_global)
    strtab u64 = try pfresh(c".strtab", 3, 0, 1, 0, strings.n, strings.p)
    psec(symtab).hdr.link = trunc[u32](strtab)
    for j u64 in 0..relocs.n { psec(vec_get(&relocs, j)).hdr.link = trunc[u32](symtab) }
    for j u64 in 0..groups.n { psec(vec_get(&groups, j)).hdr.link = trunc[u32](symtab) }
    if sig_index != 0 { psec(sig_index).hdr.link = trunc[u32](symtab) }

    // .shstrtab, every name appended in section order
    shstrtab u64 = try pfresh(c".shstrtab", 3, 0, 1, 0, 0, null)
    total u64 = ld.psecs.n
    shs Buf = {}
    buf_u8(&shs, 0)
    names addr = heap_alloc(total * 8 + 8)
    for i u64 in 1..total + 1 { names[u64, i - 1] = try pstring(&shs, psec(i).hdr.name) }
    psec(shstrtab).data = shs.p
    psec(shstrtab).hdr.size = shs.n

    // layout
    cursor u64 = 64
    for i u64 in 1..total + 1 {
        h handle[Sec] = &psec(i).hdr
        cursor = try chk_align(c"partial output layout", MAX_FILE_SIZE, cursor, umax(1, h.alignment))
        h.offset = cursor
        if h.kind != 8 { cursor = try chk_add(c"partial output size", MAX_FILE_SIZE, cursor, h.size) }
    }
    shoff u64 = try chk_align(c"partial output layout", MAX_FILE_SIZE, cursor, 8)
    size u64 = try chk_add(c"partial output size", MAX_FILE_SIZE, shoff, (total + 1) * 64)
    output addr = heap_alloc_zeroed(size + 1)
    ident arr[7, u8] = b"\x7fELF\x02\x01\x01"
    mem_copy(output, &ident, 7)
    wr16(output, 16, 1)
    wr16(output, 18, 62)
    wr32(output, 20, 1)
    wr64(output, 40, shoff)
    wr16(output, 52, 64)
    wr16(output, 58, 64)
    wr16(output, 60, total + 1)
    wr16(output, 62, shstrtab)
    for i u64 in 1..total + 1 {
        p handle[PSec] = psec(i)
        h handle[Sec] = &p.hdr
        if h.kind != 8 && h.size != 0 { mem_copy(output + h.offset, p.data, h.size) }
        at u64 = shoff + i * 64
        wr32(output, at, names[u64, i - 1])
        wr32(output, at + 4, zext[u64](h.kind))
        wr64(output, at + 8, h.flags)
        wr64(output, at + 24, h.offset)
        wr64(output, at + 32, h.size)
        wr32(output, at + 40, zext[u64](h.link))
        wr32(output, at + 44, zext[u64](h.info))
        wr64(output, at + 48, h.alignment)
        wr64(output, at + 56, h.entsize)
    }
    heap_free(names)

    // E.parse ~path:"<partial output>": the output must read back
    check handle[Obj] = handle_from_addr(heap_alloc_zeroed(sizeof[Obj]))
    check.path = bytes_c(c"<partial output>")
    check.data = output
    check.len = size
    elf_parse(check, false) catch err { try die_buf(&check.msg) }
    stat_add(ST_OUTPUT_BYTES, size)
    ld.image = output
    ld.image_size = size
}

// Partial_link.link_input_files
fn partial_link_and_publish() void fails {
    c handle[Config] = config()
    output Bytes = c.output
    in_mem bool = ld_vfs_in_memory()
    discard bool = false
    if !in_mem {
        paths Vec[Bytes] = {}
        for k u64 in 0..c.items.n {
            it handle[Item] = vec_at(&c.items, k)
            if it.kind == IT_PATH { vec_push(&paths, it.text) }
        }
        st Stat = {}
        exists bool = try check_output(output, &paths, false, &st)
        discard = exists && try null_output(output, &st)
        vec_free(&paths)
    }
    // link_inputs' policy (the command line already rejects all of it)
    if c.mode != MODE_STATIC || c.gc_sections || c.has_version_script || c.build_id != 0 {
        try die_c(c"partial link requires relocatable output policy")
    }
    ld.partial = true
    try resolve()
    if ld.ninput_objects == 0 { try die_c(c"partial link: no input objects extracted") }
    et PhaseStart = {}
    phase_begin(PH_EMIT_RELOCATABLE, &et)
    symver_plan()
    try partial_combine()
    phase_end(PH_EMIT_RELOCATABLE, &et)
    if in_mem {
        ld_capture_output(ld.image, ld.image_size, false, bytes_empty())
        return
    }
    st2 Stat = {}
    try check_output(output, &ld.expanded, true, &st2)
    wt PhaseStart = {}
    phase_begin(PH_WRITE, &wt)
    if discard {
        stat_add(ST_DISCARDED_OUTPUT_BYTES, ld.image_size)
        return
    }
    file_write_atomic(output.p, bytes(ld.image, ld.image_size), 0o644) catch e {
        try die_io(c"write", output, e)
    }
    phase_end(PH_WRITE, &wt)
}
