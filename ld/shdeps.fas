// Transitive shared-library dependency loading and link-time validation:
// a literal port of src/linker/shared_dependencies.ml.
//
// Link-time validation is deliberately separate from direct input resolution:
// an indirect DSO must not satisfy a regular object's reference or gain a new
// DT_NEEDED entry merely because it was inspected.
//
// Public API:
//   struct ShDepEdge { from_path Bytes, dep_name Bytes, target addr }
//   struct ShDeps    { libraries Vec[addr], owned Vec[addr],
//                      edges Vec[ShDepEdge], edge_index KeyIndex }
//
//   fn shdeps_expand(origin Bytes, text Bytes) Bytes
//   fn shdeps_paths(prefixes bool, origin Bytes, text Bytes, out handle[Vec[Bytes]]) void
//   fn shdeps_load_with[READ fn(Bytes) Bytes](out handle[ShDeps], direct addr, ndirect u64) void
//   fn shdeps_load(out handle[ShDeps], direct addr, ndirect u64) void
//   fn shdeps_lib(graph handle[ShDeps], i u64) handle[ShLib]
//   fn shdeps_find_edge(graph handle[ShDeps], from_path Bytes, dep_name Bytes) handle[ShLib]
//   fn shdeps_validate[DEFINED fn(Bytes, Bytes) i32](graph handle[ShDeps]) void
//   fn shdeps_free(graph handle[ShDeps]) void

struct ShDepEdge {
    from_path Bytes
    dep_name Bytes
    target addr         // handle[ShLib] as addr
}

struct ShDeps {
    libraries Vec[addr] // handle[ShLib] as addr, in BFS discovery order
    owned Vec[addr]     // transitive ShLib allocations owned by this graph
    edges Vec[ShDepEdge]
    edge_index KeyIndex
}

// Internal queue entry for BFS dependency loading
struct ShPending {
    lib addr            // handle[ShLib] as addr
    inherited Vec[Bytes]
}

// Internal provider entry for validation: (name, version) -> symbol kind
struct ShProvider {
    name Bytes
    version Bytes       // n == SH_NONE when None
    kind u8
    pad arr[7, u8]
}

// Internal defined-version entry for validation: (library.path, version)
struct ShDefVer {
    path Bytes
    version Bytes
}

// ---------- helpers ----------

fn shdeps_lib(graph handle[ShDeps], i u64) handle[ShLib] {
    return handle_from_addr[ShLib](vec_get[addr](handle_from_addr[Vec[addr]](&graph.libraries), i))
}

fn shdeps_pair_hash(a Bytes, b Bytes) u64 {
    return hash_mix(bytes_hash(a) ^ hash_mix(bytes_hash(b) ^ 0x517cc1b727220a95))
}

fn shdeps_put_edge(graph handle[ShDeps], from_path Bytes, dep_name Bytes, target addr) void {
    kx handle[KeyIndex] = handle_from_addr[KeyIndex](&graph.edge_index)
    ev handle[Vec[ShDepEdge]] = handle_from_addr[Vec[ShDepEdge]](&graph.edges)
    h u64 = shdeps_pair_hash(from_path, dep_name)
    id u32 = kx_first(kx, h)
    while id != NONE {
        e handle[ShDepEdge] = vec_ref[ShDepEdge](ev, zext[u64](id))
        if bytes_eq(e.from_path, from_path) && bytes_eq(e.dep_name, dep_name) {
            e.target = target
            return
        }
        id = kx_next(kx, id)
    }
    new_id u32 = trunc[u32](ev.n)
    e handle[ShDepEdge] = vec_new[ShDepEdge](ev)
    e.from_path = from_path
    e.dep_name = dep_name
    e.target = target
    kx_add(kx, h, new_id)
}

// Looks up `(from_path, dep_name)` in `graph.edges`; returns null if absent.
fn shdeps_find_edge(graph handle[ShDeps], from_path Bytes, dep_name Bytes) handle[ShLib] {
    kx handle[KeyIndex] = handle_from_addr[KeyIndex](&graph.edge_index)
    ev handle[Vec[ShDepEdge]] = handle_from_addr[Vec[ShDepEdge]](&graph.edges)
    h u64 = shdeps_pair_hash(from_path, dep_name)
    id u32 = kx_first(kx, h)
    while id != NONE {
        e handle[ShDepEdge] = vec_ref[ShDepEdge](ev, zext[u64](id))
        if bytes_eq(e.from_path, from_path) && bytes_eq(e.dep_name, dep_name) {
            return handle_from_addr[ShLib](e.target)
        }
        id = kx_next(kx, id)
    }
    return null
}

fn shdeps_free(graph handle[ShDeps]) void {
    ov handle[Vec[addr]] = handle_from_addr[Vec[addr]](&graph.owned)
    for i u64 in 0..ov.n {
        p addr = vec_get[addr](ov, i)
        sh_free(handle_from_addr[ShLib](p))
        heap_free(p)
    }
    vec_free[addr](ov)
    vec_free[addr](handle_from_addr[Vec[addr]](&graph.libraries))
    vec_free[ShDepEdge](handle_from_addr[Vec[ShDepEdge]](&graph.edges))
    kx_free(handle_from_addr[KeyIndex](&graph.edge_index))
}

fn shdeps_getcwd() Bytes {
    cwd arr[4096, u8] = {}
    n usize = os_getcwd(&cwd, 4096) catch e {
        die_io(c"getcwd", bytes_empty(), e)
        return bytes_empty()
    }
    if n != 0 && cwd[n - 1] == 0 { n -= 1 }
    return nul_dup(&cwd, n)
}

fn shdeps_is_ident_char(c u8) bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95
}

fn shdeps_prefix_at(text Bytes, at u64, lit addr, lit_len u64) bool {
    if lit_len > text.n - at { return false }
    return mem_eq(text.p + at, lit, lit_len)
}

// Expands `$ORIGIN` and `${ORIGIN}` tokens in `text`, rejecting any other
// `$`-token and enforcing the 65536-byte limit. Returns NUL-terminated Bytes.
fn shdeps_expand(origin Bytes, text Bytes) Bytes {
    if text.n > 65536 { die_c(c"dependency search path exceeds 65536 bytes") }
    out Buf = {}
    oh handle[Buf] = handle_from_addr[Buf](&out)
    at u64 = 0
    while at < text.n {
        c u8 = text.p[u8, at]
        if c == 36 {
            if shdeps_prefix_at(text, at, c"${ORIGIN}", 9) {
                if origin.n > 65536 - oh.n {
                    buf_free(oh)
                    die_c(c"dependency search path exceeds 65536 bytes")
                }
                buf_append(oh, origin)
                at += 9
            } else if shdeps_prefix_at(text, at, c"$ORIGIN", 7) &&
                (at + 7 == text.n || !shdeps_is_ident_char(text.p[u8, at + 7])) {
                if origin.n > 65536 - oh.n {
                    buf_free(oh)
                    die_c(c"dependency search path exceeds 65536 bytes")
                }
                buf_append(oh, origin)
                at += 7
            } else {
                buf_free(oh)
                m handle[Buf] = msg()
                bs(m, c"unsupported dependency path token in ")
                bb(m, text)
                die()
            }
        } else {
            buf_u8(oh, c)
            if oh.n > 65536 {
                buf_free(oh)
                die_c(c"dependency search path exceeds 65536 bytes")
            }
            at += 1
        }
    }
    res Bytes = nul_dup(oh.p, oh.n)
    buf_free(oh)
    return res
}

// Splits a colon-separated search path, applies sysroot prefix/target rules,
// expands `$ORIGIN`, and appends the resulting directories to `out`.
fn shdeps_paths(prefixes bool, origin Bytes, text Bytes, out handle[Vec[Bytes]]) void {
    if text.n > 65536 { die_c(c"dependency search path exceeds 65536 bytes") }
    parts Vec[Bytes] = {}
    ph handle[Vec[Bytes]] = handle_from_addr[Vec[Bytes]](&parts)
    start u64 = 0
    for i u64 in 0..text.n {
        if text.p[u8, i] == 58 {
            vec_push[Bytes](ph, bytes(text.p + start, i - start))
            start = i + 1
        }
    }
    vec_push[Bytes](ph, bytes(text.p + start, text.n - start))
    if ph.n > 4096 {
        vec_free[Bytes](ph)
        die_c(c"dependency search exceeds 4096 directories")
    }
    for i u64 in 0..ph.n {
        part Bytes = vec_get[Bytes](ph, i)
        t Bytes = part
        if prefixes {
            t = root_directory(part)
        } else if !path_is_relative(part) {
            t = root_target(part)
        }
        if t.n == 0 {
            vec_push[Bytes](out, bytes_c(c"."))
        } else {
            vec_push[Bytes](out, shdeps_expand(origin, t))
        }
    }
    vec_free[Bytes](ph)
}

fn shdeps_check_dir_limit(n u64) void {
    if n > 4096 { die_c(c"dependency search exceeds 4096 directories") }
}

fn shdeps_probe(probes addr, path Bytes) bool {
    p u64 = probes[u64] + 1
    probes[u64] = p
    if p > 1000000 { die_c(c"dependency search exceeds 1000000 probes") }
    return os_exists(path.p)
}

fn shdeps_copy_paths(src handle[Vec[Bytes]], dst handle[Vec[Bytes]]) void {
    for i u64 in 0..src.n {
        vec_push[Bytes](dst, vec_get[Bytes](src, i))
    }
}

// ---------- loading ----------

// Default read callback for the linker: reads a dependency file once per
// canonical path and counts it under the OCaml "dependency_files" stat.
fn shdeps_read_dep(path Bytes) Bytes {
    return read_extra_counted(path, ST_DEPENDENCY_FILES)
}

// Loads all transitive DT_NEEDED dependencies of `direct` (an array of
// `ndirect` `handle[ShLib]` stored as `addr`), using `READ` to load newly
// discovered files. Populates `out` (which should be zero-initialized).
fn shdeps_load_with[READ fn(Bytes) Bytes](out handle[ShDeps], direct addr, ndirect u64) void {
    c handle[Config] = config()
    if c.allow_shlib_undefined { return }
    if c.has_sysroot && !has_root { sysroot_normalize(c.sysroot) }

    known Map[Bytes, addr, bytes_hash, bytes_eq] = {}
    kh handle[Map[Bytes, addr, bytes_hash, bytes_eq]] = handle_from_addr[Map[Bytes, addr, bytes_hash, bytes_eq]](&known)
    defer { map_free(kh) }

    visited Map[Bytes, u8, bytes_hash, bytes_eq] = {}
    vh handle[Map[Bytes, u8, bytes_hash, bytes_eq]] = handle_from_addr[Map[Bytes, u8, bytes_hash, bytes_eq]](&visited)
    defer { map_free(vh) }

    pending Vec[ShPending] = {}
    qh handle[Vec[ShPending]] = handle_from_addr[Vec[ShPending]](&pending)
    defer {
        for i u64 in 0..qh.n {
            p handle[ShPending] = vec_ref[ShPending](qh, i)
            vec_free[Bytes](handle_from_addr[Vec[Bytes]](&p.inherited))
        }
        vec_free[ShPending](qh)
    }

    for i u64 in 0..ndirect {
        lp addr = direct[addr, i]
        lib handle[ShLib] = handle_from_addr[ShLib](lp)
        map_put(kh, lib.needed, lp)
    }
    for i u64 in 0..ndirect {
        pe handle[ShPending] = vec_new[ShPending](qh)
        pe.lib = direct[addr, i]
    }

    cwd Bytes = shdeps_getcwd()
    explicit Vec[Bytes] = {}
    eh handle[Vec[Bytes]] = handle_from_addr[Vec[Bytes]](&explicit)
    defer { vec_free[Bytes](eh) }
    rlinks handle[Vec[Bytes]] = handle_from_addr[Vec[Bytes]](&c.rpath_links)
    for i u64 in 0..rlinks.n {
        shdeps_paths(true, cwd, vec_get[Bytes](rlinks, i), eh)
        shdeps_check_dir_limit(eh.n)
    }

    libs_out handle[Vec[addr]] = handle_from_addr[Vec[addr]](&out.libraries)
    owned_out handle[Vec[addr]] = handle_from_addr[Vec[addr]](&out.owned)
    symbols u64 = 0
    edge_count u64 = 0
    probes u64 = 0
    head u64 = 0

    while head < qh.n {
        cur handle[ShPending] = vec_ref[ShPending](qh, head)
        lp addr = cur.lib
        lib handle[ShLib] = handle_from_addr[ShLib](lp)
        head += 1

        if map_has(vh, lib.path) { continue }
        map_put(vh, lib.path, 1)
        if vh.n > 1024 { die_c(c"transitive shared-library count exceeds 1024") }
        vec_push[addr](libs_out, lp)

        sym_delta u64 = lib.exports.n + lib.references.n + lib.defined_versions.n + lib.version_requirements.n
        symbols = chk_add(c"transitive shared symbol count", 4000000, symbols, sym_delta)

        // Absolute path for $ORIGIN
        origin Bytes = bytes_empty()
        if path_is_relative(lib.path) {
            pb Buf = {}
            pbh handle[Buf] = handle_from_addr[Buf](&pb)
            path_concat(pbh, cwd, lib.path)
            full Bytes = nul_dup(pbh.p, pbh.n)
            buf_free(pbh)
            origin = path_dirname(full)
        } else {
            origin = path_dirname(lib.path)
        }

        // Inherited RPATH (only when DT_RUNPATH is absent and DT_RPATH is present)
        cur_inh handle[Vec[Bytes]] = handle_from_addr[Vec[Bytes]](&cur.inherited)
        new_inh Vec[Bytes] = {}
        nih handle[Vec[Bytes]] = handle_from_addr[Vec[Bytes]](&new_inh)
        if lib.runpath.n == SH_NONE && lib.rpath.n != SH_NONE {
            shdeps_paths(false, origin, lib.rpath, nih)
            shdeps_copy_paths(cur_inh, nih)
            shdeps_check_dir_limit(nih.n)
        } else {
            shdeps_copy_paths(cur_inh, nih)
        }

        // Effective search path: explicit (-rpath-link) ++ (runpath | new_inherited)
        search Vec[Bytes] = {}
        sh handle[Vec[Bytes]] = handle_from_addr[Vec[Bytes]](&search)
        shdeps_copy_paths(eh, sh)
        if lib.runpath.n != SH_NONE {
            shdeps_paths(false, origin, lib.runpath, sh)
        } else {
            shdeps_copy_paths(nih, sh)
        }
        shdeps_check_dir_limit(sh.n)

        deps handle[Vec[Bytes]] = handle_from_addr[Vec[Bytes]](&lib.dependencies)
        for di u64 in 0..deps.n {
            name Bytes = vec_get[Bytes](deps, di)
            edge_count += 1
            if edge_count > 65536 { die_c(c"transitive dependency count exceeds 65536") }
            expanded Bytes = if !path_is_relative(name) { root_target(name) } else { shdeps_expand(origin, name) }

            dep_addr addr = map_get(kh, expanded) catch null
            if dep_addr == null {
                found_path Bytes = bytes(null, SH_NONE)
                has_slash bool = bytes_contains(expanded, 47)
                if has_slash {
                    if shdeps_probe(&probes, expanded) { found_path = expanded }
                } else {
                    for si u64 in 0..sh.n {
                        dir Bytes = vec_get[Bytes](sh, si)
                        cb Buf = {}
                        cbh handle[Buf] = handle_from_addr[Buf](&cb)
                        path_concat(cbh, dir, expanded)
                        cand Bytes = nul_dup(cbh.p, cbh.n)
                        buf_free(cbh)
                        if shdeps_probe(&probes, cand) {
                            found_path = cand
                            break
                        }
                    }
                }
                if found_path.n == SH_NONE {
                    m handle[Buf] = msg()
                    bb(m, lib.path)
                    bs(m, c": cannot find DT_NEEDED ")
                    bb(m, name)
                    bs(m, c" (use -rpath-link)")
                    die()
                }
                data Bytes = READ(found_path)
                pt PhaseStart = {}
                phase_begin(PH_PARSE_DEPENDENCY, &pt)
                sp addr = heap_alloc_zeroed(sizeof[ShLib])
                s handle[ShLib] = handle_from_addr[ShLib](sp)
                shared_parse(s, found_path, data) catch {
                    phase_end(PH_PARSE_DEPENDENCY, &pt)
                    die_buf(handle_from_addr[Buf](&s.msg))
                }
                phase_end(PH_PARSE_DEPENDENCY, &pt)
                vec_push[addr](owned_out, sp)

                // Basename lookup reuses the first SONAME identity. Explicit
                // expanded paths can load distinct DSOs with the same SONAME.
                existing addr = map_get(kh, s.needed) catch null
                if existing != null && !has_slash {
                    dep_addr = existing
                } else if existing != null {
                    dep_addr = sp
                } else {
                    map_put(kh, s.needed, sp)
                    dep_addr = sp
                }
                map_put(kh, expanded, dep_addr)
                stat_add(ST_TRANSITIVE_SHARED_LIBRARIES, 1)
            }

            shdeps_put_edge(out, lib.path, name, dep_addr)
            // Enqueue (dependency, new_inherited). Note: qh may reallocate,
            // which is safe because we no longer use `cur` after this loop's
            // `cur_inh` copy above.
            ne handle[ShPending] = vec_new[ShPending](qh)
            ne.lib = dep_addr
            shdeps_copy_paths(nih, handle_from_addr[Vec[Bytes]](&ne.inherited))
        }
        vec_free[Bytes](sh)
        vec_free[Bytes](nih)
    }
}

fn shdeps_load(out handle[ShDeps], direct addr, ndirect u64) void {
    shdeps_load_with[shdeps_read_dep](out, direct, ndirect)
}

// ---------- validation ----------

fn shdeps_add_provider(pv handle[Vec[ShProvider]], kx handle[KeyIndex], name Bytes, version Bytes, kind u8) void {
    h u64 = sh_sym_hash(name, version)
    id u32 = kx_first(kx, h)
    while id != NONE {
        p handle[ShProvider] = vec_ref[ShProvider](pv, zext[u64](id))
        if sh_sym_eq(p.name, p.version, name, version) { return }
        id = kx_next(kx, id)
    }
    new_id u32 = trunc[u32](pv.n)
    p handle[ShProvider] = vec_new[ShProvider](pv)
    p.name = name
    p.version = version
    p.kind = kind
    kx_add(kx, h, new_id)
}

fn shdeps_find_provider(pv handle[Vec[ShProvider]], kx handle[KeyIndex], name Bytes, version Bytes) i32 {
    h u64 = sh_sym_hash(name, version)
    id u32 = kx_first(kx, h)
    while id != NONE {
        p handle[ShProvider] = vec_ref[ShProvider](pv, zext[u64](id))
        if sh_sym_eq(p.name, p.version, name, version) { return zext[i32](p.kind) }
        id = kx_next(kx, id)
    }
    return -1
}

fn shdeps_add_defver(dv handle[Vec[ShDefVer]], kx handle[KeyIndex], path Bytes, version Bytes) void {
    h u64 = shdeps_pair_hash(path, version)
    id u32 = kx_first(kx, h)
    while id != NONE {
        v handle[ShDefVer] = vec_ref[ShDefVer](dv, zext[u64](id))
        if bytes_eq(v.path, path) && bytes_eq(v.version, version) { return }
        id = kx_next(kx, id)
    }
    new_id u32 = trunc[u32](dv.n)
    v handle[ShDefVer] = vec_new[ShDefVer](dv)
    v.path = path
    v.version = version
    kx_add(kx, h, new_id)
}

fn shdeps_has_defver(dv handle[Vec[ShDefVer]], kx handle[KeyIndex], path Bytes, version Bytes) bool {
    h u64 = shdeps_pair_hash(path, version)
    id u32 = kx_first(kx, h)
    while id != NONE {
        v handle[ShDefVer] = vec_ref[ShDefVer](dv, zext[u64](id))
        if bytes_eq(v.path, path) && bytes_eq(v.version, version) { return true }
        id = kx_next(kx, id)
    }
    return false
}

// Validates all required versions and strong undefined references across the
// loaded dependency graph. `DEFINED(name, version)` returns the output-defined
// symbol's ELF type (`0..255`), or `-1` if not defined by the output.
fn shdeps_validate[DEFINED fn(Bytes, Bytes) i32](graph handle[ShDeps]) void {
    libs handle[Vec[addr]] = handle_from_addr[Vec[addr]](&graph.libraries)
    if libs.n == 0 { return }

    providers Vec[ShProvider] = {}
    pv handle[Vec[ShProvider]] = handle_from_addr[Vec[ShProvider]](&providers)
    prov_kx KeyIndex = {}
    pkx handle[KeyIndex] = handle_from_addr[KeyIndex](&prov_kx)
    defer {
        vec_free[ShProvider](pv)
        kx_free(pkx)
    }

    defvers Vec[ShDefVer] = {}
    dv handle[Vec[ShDefVer]] = handle_from_addr[Vec[ShDefVer]](&defvers)
    ver_kx KeyIndex = {}
    vkx handle[KeyIndex] = handle_from_addr[KeyIndex](&ver_kx)
    defer {
        vec_free[ShDefVer](dv)
        kx_free(vkx)
    }

    none_ver Bytes = bytes(null, SH_NONE)
    for li u64 in 0..libs.n {
        lib handle[ShLib] = shdeps_lib(graph, li)
        dvs handle[Vec[Bytes]] = handle_from_addr[Vec[Bytes]](&lib.defined_versions)
        for vi u64 in 0..dvs.n {
            shdeps_add_defver(dv, vkx, lib.path, vec_get[Bytes](dvs, vi))
        }
        exps handle[Vec[ShExport]] = handle_from_addr[Vec[ShExport]](&lib.exports)
        for ei u64 in 0..exps.n {
            ex handle[ShExport] = vec_ref[ShExport](exps, ei)
            if ex.is_default {
                shdeps_add_provider(pv, pkx, ex.name, none_ver, ex.kind)
            }
            if ex.version.n != SH_NONE {
                shdeps_add_provider(pv, pkx, ex.name, ex.version, ex.kind)
            }
        }
    }

    for li u64 in 0..libs.n {
        lib handle[ShLib] = shdeps_lib(graph, li)
        vreqs handle[Vec[ShVerReq]] = handle_from_addr[Vec[ShVerReq]](&lib.version_requirements)
        for ri u64 in 0..vreqs.n {
            req handle[ShVerReq] = vec_ref[ShVerReq](vreqs, ri)
            if !req.weak {
                prov handle[ShLib] = shdeps_find_edge(graph, lib.path, req.provider)
                if prov == null || !shdeps_has_defver(dv, vkx, prov.path, req.version) {
                    m handle[Buf] = msg()
                    bb(m, lib.path)
                    bs(m, c": required version ")
                    bb(m, req.version)
                    bs(m, c" not found in ")
                    bb(m, req.provider)
                    die()
                }
            }
        }
        refs handle[Vec[ShRef]] = handle_from_addr[Vec[ShRef]](&lib.references)
        for ri u64 in 0..refs.n {
            rf handle[ShRef] = vec_ref[ShRef](refs, ri)
            if rf.undefined && rf.binding == 1 {
                kind i32 = DEFINED(rf.name, rf.version)
                if kind < 0 {
                    kind = shdeps_find_provider(pv, pkx, rf.name, rf.version)
                }
                if kind < 0 {
                    m handle[Buf] = msg()
                    bb(m, lib.path)
                    bs(m, c": unresolved shared-library reference ")
                    bb(m, rf.name)
                    if rf.version.n != SH_NONE {
                        buf_u8(m, 64)
                        bb(m, rf.version)
                    }
                    die()
                } else if (kind == 6) != (rf.kind == 6) {
                    m handle[Buf] = msg()
                    bb(m, lib.path)
                    bs(m, c": shared-library TLS type mismatch for ")
                    bb(m, rf.name)
                    if rf.version.n != SH_NONE {
                        buf_u8(m, 64)
                        bb(m, rf.version)
                    }
                    die()
                }
            }
        }
    }
}
