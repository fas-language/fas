// Transitive shared-library dependency loading and link-time validation:
// a literal port of src/linker/shared_dependencies.ml.
//
// Link-time validation is deliberately separate from direct input resolution:
// an indirect DSO must not satisfy a regular object's reference or gain a new
// DT_NEEDED entry merely because it was inspected.
//
// Public API:
//   struct ShDepEdge { from_path Bytes, dep_name Bytes, target addr }
//   struct ShDeps    { libraries Vec[addr], owned Vec[addr],
//                      edges Vec[ShDepEdge], edge_index KeyIndex }
//
//   fn shdeps_expand(origin Bytes, text Bytes) Bytes
//   fn shdeps_paths(prefixes bool, origin Bytes, text Bytes, out handle[Vec[Bytes]]) void
//   fn shdeps_load_with[READ fn(Bytes) Bytes fails](out handle[ShDeps], direct addr, ndirect u64) void
//   fn shdeps_load(out handle[ShDeps], direct addr, ndirect u64) void
//   fn shdeps_lib(graph handle[ShDeps], i u64) handle[ShLib]
//   fn shdeps_find_edge(graph handle[ShDeps], from_path Bytes, dep_name Bytes) handle[ShLib]
//   fn shdeps_validate[DEFINED fn(Bytes, Bytes) i32](graph handle[ShDeps]) void
//   fn shdeps_free(graph handle[ShDeps]) void

struct ShDepEdge {
    from_path Bytes
    dep_name Bytes
    target handle[ShLib]
}

struct ShDeps {
    libraries Vec[handle[ShLib]] // in BFS discovery order
    owned Vec[handle[ShLib]]     // transitive ShLib allocations owned by this graph
    edges Vec[ShDepEdge]
    edge_index KeyIndex
}

// Internal queue entry for BFS dependency loading
struct ShPending {
    lib handle[ShLib]
    inherited Vec[Bytes]
}

type ShLibMap = Map[Bytes, handle[ShLib], bytes_hash, bytes_eq]

// Internal provider entry for validation: (name, version) -> symbol kind
struct ShProvider {
    name Bytes
    version Bytes       // n == SH_NONE when None
    kind u8
    pad arr[7, u8]
}

// Internal defined-version entry for validation: (library.path, version)
struct ShDefVer {
    path Bytes
    version Bytes
}

// ---------- helpers ----------

fn shdeps_lib(graph handle[ShDeps], i u64) handle[ShLib] {
    return vec_get(&graph.libraries, i)
}

fn shdeps_pair_hash(a Bytes, b Bytes) u64 {
    return hash_mix(bytes_hash(a) ^ hash_mix(bytes_hash(b) ^ 0x517cc1b727220a95))
}

fn shdeps_put_edge(graph handle[ShDeps], from_path Bytes, dep_name Bytes, target handle[ShLib]) void {
    h u64 = shdeps_pair_hash(from_path, dep_name)
    id u32 = kx_first(&graph.edge_index, h)
    while id != NONE {
        e handle[ShDepEdge] = vec_at(&graph.edges, zext[u64](id))
        if bytes_eq(e.from_path, from_path) && bytes_eq(e.dep_name, dep_name) {
            e.target = target
            return
        }
        id = kx_next(&graph.edge_index, id)
    }
    new_id u32 = trunc[u32](graph.edges.n)
    e handle[ShDepEdge] = vec_add(&graph.edges)
    e.from_path = from_path
    e.dep_name = dep_name
    e.target = target
    kx_add(&graph.edge_index, h, new_id)
}

// Looks up `(from_path, dep_name)` in `graph.edges`; returns null if absent.
fn shdeps_find_edge(graph handle[ShDeps], from_path Bytes, dep_name Bytes) handle[ShLib] {
    h u64 = shdeps_pair_hash(from_path, dep_name)
    id u32 = kx_first(&graph.edge_index, h)
    while id != NONE {
        e handle[ShDepEdge] = vec_at(&graph.edges, zext[u64](id))
        if bytes_eq(e.from_path, from_path) && bytes_eq(e.dep_name, dep_name) {
            return e.target
        }
        id = kx_next(&graph.edge_index, id)
    }
    return null
}

fn shdeps_free(graph handle[ShDeps]) void {
    for i u64 in 0..graph.owned.n {
        lib handle[ShLib] = vec_get(&graph.owned, i)
        sh_free(lib)
        heap_free(handle_addr(lib))
    }
    vec_free(&graph.owned)
    vec_free(&graph.libraries)
    vec_free(&graph.edges)
    kx_free(&graph.edge_index)
}

fn shdeps_getcwd() Bytes fails {
    cwd arr[4096, u8] = {}
    n usize = os_getcwd(&cwd, 4096) catch e {
        try die_io(c"getcwd", bytes_empty(), e)
        return bytes_empty()
    }
    if n != 0 && cwd[n - 1] == 0 { n -= 1 }
    return nul_dup(&cwd, n)
}

fn shdeps_is_ident_char(c u8) bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95
}

fn shdeps_prefix_at(text Bytes, at u64, lit addr, lit_len u64) bool {
    if lit_len > text.n - at { return false }
    return mem_eq(text.p + at, lit, lit_len)
}

// Expands `$ORIGIN` and `${ORIGIN}` tokens in `text`, rejecting any other
// `$`-token and enforcing the 65536-byte limit. Returns NUL-terminated Bytes.
fn shdeps_expand(origin Bytes, text Bytes) Bytes fails {
    if text.n > 65536 { try die_c(c"dependency search path exceeds 65536 bytes") }
    out Buf = {}
    at u64 = 0
    while at < text.n {
        c u8 = text.p[u8, at]
        if c == 36 {
            if shdeps_prefix_at(text, at, c"${ORIGIN}", 9) {
                if origin.n > 65536 - out.n {
                    buf_free(&out)
                    try die_c(c"dependency search path exceeds 65536 bytes")
                }
                buf_append(&out, origin)
                at += 9
            } else if shdeps_prefix_at(text, at, c"$ORIGIN", 7) &&
                (at + 7 == text.n || !shdeps_is_ident_char(text.p[u8, at + 7])) {
                if origin.n > 65536 - out.n {
                    buf_free(&out)
                    try die_c(c"dependency search path exceeds 65536 bytes")
                }
                buf_append(&out, origin)
                at += 7
            } else {
                buf_free(&out)
                m handle[Buf] = msg()
                bs(m, c"unsupported dependency path token in ")
                bb(m, text)
                try die()
            }
        } else {
            buf_u8(&out, c)
            if out.n > 65536 {
                buf_free(&out)
                try die_c(c"dependency search path exceeds 65536 bytes")
            }
            at += 1
        }
    }
    res Bytes = nul_dup(out.p, out.n)
    buf_free(&out)
    return res
}

// Splits a colon-separated search path, applies sysroot prefix/target rules,
// expands `$ORIGIN`, and appends the resulting directories to `out`.
fn shdeps_paths(prefixes bool, origin Bytes, text Bytes, out handle[Vec[Bytes]]) void fails {
    if text.n > 65536 { try die_c(c"dependency search path exceeds 65536 bytes") }
    parts Vec[Bytes] = {}
    start u64 = 0
    for i u64 in 0..text.n {
        if text.p[u8, i] == 58 {
            vec_push(&parts, bytes(text.p + start, i - start))
            start = i + 1
        }
    }
    vec_push(&parts, bytes(text.p + start, text.n - start))
    if parts.n > 4096 {
        vec_free(&parts)
        try die_c(c"dependency search exceeds 4096 directories")
    }
    for i u64 in 0..parts.n {
        part Bytes = vec_get(&parts, i)
        t Bytes = part
        if prefixes {
            t = try root_directory(part)
        } else if !path_is_relative(part) {
            t = try root_target(part)
        }
        if t.n == 0 {
            vec_push(out, bytes_c(c"."))
        } else {
            vec_push(out, try shdeps_expand(origin, t))
        }
    }
    vec_free(&parts)
}

fn shdeps_check_dir_limit(n u64) void fails {
    if n > 4096 { try die_c(c"dependency search exceeds 4096 directories") }
}

fn shdeps_probe(probes addr, path Bytes) bool fails {
    p u64 = probes[u64] + 1
    probes[u64] = p
    if p > 1000000 { try die_c(c"dependency search exceeds 1000000 probes") }
    return ld_exists(path)
}

fn shdeps_copy_paths(src handle[Vec[Bytes]], dst handle[Vec[Bytes]]) void {
    for i u64 in 0..src.n {
        vec_push(dst, vec_get(src, i))
    }
}

// ---------- loading ----------

// Default read callback for the linker: reads a dependency file once per
// canonical path and counts it under the OCaml "dependency_files" stat.
fn shdeps_read_dep(path Bytes) Bytes fails {
    return try read_extra_counted(path, ST_DEPENDENCY_FILES)
}

// Loads all transitive DT_NEEDED dependencies of `direct` (an array of
// `ndirect` `handle[ShLib]` stored as `addr`), using `READ` to load newly
// discovered files. Populates `out` (which should be zero-initialized).
fn shdeps_load_with[READ fn(Bytes) Bytes fails](out handle[ShDeps], direct addr, ndirect u64) void fails {
    c handle[Config] = config()
    if c.allow_shlib_undefined { return }
    if c.has_sysroot && !ld.has_root { try sysroot_normalize(c.sysroot) }

    known ShLibMap = {}
    kh handle[ShLibMap] = &known
    defer { map_free(kh) }

    visited BytesSet = {}
    vh handle[BytesSet] = &visited
    defer { map_free(vh) }

    pending Vec[ShPending] = {}
    defer {
        for i u64 in 0..pending.n {
            p handle[ShPending] = vec_at(&pending, i)
            vec_free(&p.inherited)
        }
        vec_free(&pending)
    }

    for i u64 in 0..ndirect {
        lib handle[ShLib] = handle_from_addr(direct[addr, i])
        map_put(kh, lib.needed, lib)
    }
    for i u64 in 0..ndirect {
        pe handle[ShPending] = vec_add(&pending)
        pe.lib = handle_from_addr(direct[addr, i])
    }

    cwd Bytes = try shdeps_getcwd()
    explicit Vec[Bytes] = {}
    defer { vec_free(&explicit) }
    for i u64 in 0..c.rpath_links.n {
        try shdeps_paths(true, cwd, vec_get(&c.rpath_links, i), &explicit)
        try shdeps_check_dir_limit(explicit.n)
    }

    symbols u64 = 0
    edge_count u64 = 0
    probes u64 = 0
    head u64 = 0

    while head < pending.n {
        cur handle[ShPending] = vec_at(&pending, head)
        lib handle[ShLib] = cur.lib
        head += 1

        if map_has(vh, lib.path) { continue }
        map_put(vh, lib.path, 1)
        if vh.n > 1024 { try die_c(c"transitive shared-library count exceeds 1024") }
        vec_push(&out.libraries, lib)

        sym_delta u64 = lib.exports.n + lib.references.n + lib.defined_versions.n + lib.version_requirements.n
        symbols = try chk_add(c"transitive shared symbol count", 4000000, symbols, sym_delta)

        // Absolute path for $ORIGIN
        origin Bytes = bytes_empty()
        if path_is_relative(lib.path) {
            pb Buf = {}
            path_concat(&pb, cwd, lib.path)
            full Bytes = nul_dup(pb.p, pb.n)
            buf_free(&pb)
            origin = path_dirname(full)
        } else {
            origin = path_dirname(lib.path)
        }

        // Inherited RPATH (only when DT_RUNPATH is absent and DT_RPATH is present)
        new_inh Vec[Bytes] = {}
        if lib.runpath.n == SH_NONE && lib.rpath.n != SH_NONE {
            try shdeps_paths(false, origin, lib.rpath, &new_inh)
            shdeps_copy_paths(&cur.inherited, &new_inh)
            try shdeps_check_dir_limit(new_inh.n)
        } else {
            shdeps_copy_paths(&cur.inherited, &new_inh)
        }

        // Effective search path: explicit (-rpath-link) ++ (runpath | new_inherited)
        search Vec[Bytes] = {}
        shdeps_copy_paths(&explicit, &search)
        if lib.runpath.n != SH_NONE {
            try shdeps_paths(false, origin, lib.runpath, &search)
        } else {
            shdeps_copy_paths(&new_inh, &search)
        }
        try shdeps_check_dir_limit(search.n)

        for di u64 in 0..lib.dependencies.n {
            name Bytes = vec_get(&lib.dependencies, di)
            edge_count += 1
            if edge_count > 65536 { try die_c(c"transitive dependency count exceeds 65536") }
            expanded Bytes = if !path_is_relative(name) { try root_target(name) } else { try shdeps_expand(origin, name) }

            dep handle[ShLib] = map_get(kh, expanded) catch null
            if dep == null {
                found_path Bytes = bytes(null, SH_NONE)
                has_slash bool = bytes_contains(expanded, 47)
                if has_slash {
                    if try shdeps_probe(&probes, expanded) { found_path = expanded }
                } else {
                    for si u64 in 0..search.n {
                        dir Bytes = vec_get(&search, si)
                        cb Buf = {}
                        path_concat(&cb, dir, expanded)
                        cand Bytes = nul_dup(cb.p, cb.n)
                        buf_free(&cb)
                        if try shdeps_probe(&probes, cand) {
                            found_path = cand
                            break
                        }
                    }
                }
                if found_path.n == SH_NONE {
                    m handle[Buf] = msg()
                    bb(m, lib.path)
                    bs(m, c": cannot find DT_NEEDED ")
                    bb(m, name)
                    bs(m, c" (use -rpath-link)")
                    try die()
                }
                data Bytes = try READ(found_path)
                pt PhaseStart = {}
                phase_begin(PH_PARSE_DEPENDENCY, &pt)
                s handle[ShLib] = handle_from_addr(heap_alloc_zeroed(sizeof[ShLib]))
                shared_parse(s, found_path, data) catch {
                    phase_end(PH_PARSE_DEPENDENCY, &pt)
                    try die_buf(&s.msg)
                }
                phase_end(PH_PARSE_DEPENDENCY, &pt)
                vec_push(&out.owned, s)

                // Basename lookup reuses the first SONAME identity. Explicit
                // expanded paths can load distinct DSOs with the same SONAME.
                existing handle[ShLib] = map_get(kh, s.needed) catch null
                if existing != null && !has_slash {
                    dep = existing
                } else if existing != null {
                    dep = s
                } else {
                    map_put(kh, s.needed, s)
                    dep = s
                }
                map_put(kh, expanded, dep)
                stat_add(ST_TRANSITIVE_SHARED_LIBRARIES, 1)
            }

            shdeps_put_edge(out, lib.path, name, dep)
            // Enqueue (dependency, new_inherited). Note: pending may reallocate,
            // which is safe because we no longer use `cur` after the
            // `cur.inherited` copy above.
            ne handle[ShPending] = vec_add(&pending)
            ne.lib = dep
            shdeps_copy_paths(&new_inh, &ne.inherited)
        }
        vec_free(&search)
        vec_free(&new_inh)
    }
}

fn shdeps_load(out handle[ShDeps], direct addr, ndirect u64) void fails {
    try shdeps_load_with[shdeps_read_dep](out, direct, ndirect)
}

// ---------- validation ----------

fn shdeps_add_provider(pv handle[Vec[ShProvider]], kx handle[KeyIndex], name Bytes, version Bytes, kind u8) void {
    h u64 = sh_sym_hash(name, version)
    id u32 = kx_first(kx, h)
    while id != NONE {
        p handle[ShProvider] = vec_at(pv, zext[u64](id))
        if sh_sym_eq(p.name, p.version, name, version) { return }
        id = kx_next(kx, id)
    }
    new_id u32 = trunc[u32](pv.n)
    p handle[ShProvider] = vec_add(pv)
    p.name = name
    p.version = version
    p.kind = kind
    kx_add(kx, h, new_id)
}

fn shdeps_find_provider(pv handle[Vec[ShProvider]], kx handle[KeyIndex], name Bytes, version Bytes) i32 {
    h u64 = sh_sym_hash(name, version)
    id u32 = kx_first(kx, h)
    while id != NONE {
        p handle[ShProvider] = vec_at(pv, zext[u64](id))
        if sh_sym_eq(p.name, p.version, name, version) { return zext[i32](p.kind) }
        id = kx_next(kx, id)
    }
    return -1
}

fn shdeps_add_defver(dv handle[Vec[ShDefVer]], kx handle[KeyIndex], path Bytes, version Bytes) void {
    h u64 = shdeps_pair_hash(path, version)
    id u32 = kx_first(kx, h)
    while id != NONE {
        v handle[ShDefVer] = vec_at(dv, zext[u64](id))
        if bytes_eq(v.path, path) && bytes_eq(v.version, version) { return }
        id = kx_next(kx, id)
    }
    new_id u32 = trunc[u32](dv.n)
    v handle[ShDefVer] = vec_add(dv)
    v.path = path
    v.version = version
    kx_add(kx, h, new_id)
}

fn shdeps_has_defver(dv handle[Vec[ShDefVer]], kx handle[KeyIndex], path Bytes, version Bytes) bool {
    h u64 = shdeps_pair_hash(path, version)
    id u32 = kx_first(kx, h)
    while id != NONE {
        v handle[ShDefVer] = vec_at(dv, zext[u64](id))
        if bytes_eq(v.path, path) && bytes_eq(v.version, version) { return true }
        id = kx_next(kx, id)
    }
    return false
}

// Validates all required versions and strong undefined references across the
// loaded dependency graph. `DEFINED(name, version)` returns the output-defined
// symbol's ELF type (`0..255`), or `-1` if not defined by the output.
fn shdeps_validate[DEFINED fn(Bytes, Bytes) i32](graph handle[ShDeps]) void fails {
    if graph.libraries.n == 0 { return }

    providers Vec[ShProvider] = {}
    prov_kx KeyIndex = {}
    defer {
        vec_free(&providers)
        kx_free(&prov_kx)
    }

    defvers Vec[ShDefVer] = {}
    ver_kx KeyIndex = {}
    defer {
        vec_free(&defvers)
        kx_free(&ver_kx)
    }

    none_ver Bytes = bytes(null, SH_NONE)
    for li u64 in 0..graph.libraries.n {
        lib handle[ShLib] = shdeps_lib(graph, li)
        for vi u64 in 0..lib.defined_versions.n {
            shdeps_add_defver(&defvers, &ver_kx, lib.path, vec_get(&lib.defined_versions, vi))
        }
        for ei u64 in 0..lib.exports.n {
            ex handle[ShExport] = vec_at(&lib.exports, ei)
            if ex.is_default {
                shdeps_add_provider(&providers, &prov_kx, ex.name, none_ver, ex.kind)
            }
            if ex.version.n != SH_NONE {
                shdeps_add_provider(&providers, &prov_kx, ex.name, ex.version, ex.kind)
            }
        }
    }

    for li u64 in 0..graph.libraries.n {
        lib handle[ShLib] = shdeps_lib(graph, li)
        for ri u64 in 0..lib.version_requirements.n {
            req handle[ShVerReq] = vec_at(&lib.version_requirements, ri)
            if !req.weak {
                prov handle[ShLib] = shdeps_find_edge(graph, lib.path, req.provider)
                if prov == null || !shdeps_has_defver(&defvers, &ver_kx, prov.path, req.version) {
                    m handle[Buf] = msg()
                    bb(m, lib.path)
                    bs(m, c": required version ")
                    bb(m, req.version)
                    bs(m, c" not found in ")
                    bb(m, req.provider)
                    try die()
                }
            }
        }
        for ri u64 in 0..lib.references.n {
            rf handle[ShRef] = vec_at(&lib.references, ri)
            if rf.undefined && rf.binding == 1 {
                kind i32 = DEFINED(rf.name, rf.version)
                if kind < 0 {
                    kind = shdeps_find_provider(&providers, &prov_kx, rf.name, rf.version)
                }
                if kind < 0 {
                    m handle[Buf] = msg()
                    bb(m, lib.path)
                    bs(m, c": unresolved shared-library reference ")
                    bb(m, rf.name)
                    if rf.version.n != SH_NONE {
                        buf_u8(m, 64)
                        bb(m, rf.version)
                    }
                    try die()
                } else if (kind == 6) != (rf.kind == 6) {
                    m handle[Buf] = msg()
                    bb(m, lib.path)
                    bs(m, c": shared-library TLS type mismatch for ")
                    bb(m, rf.name)
                    if rf.version.n != SH_NONE {
                        buf_u8(m, 64)
                        bb(m, rf.version)
                    }
                    try die()
                }
            }
        }
    }
}
