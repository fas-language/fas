// Loader-facing metadata (Dynamic, Lifecycle, Gnu_hash): .dynamic, .dynsym,
// .dynstr, the hash tables, .rela.dyn and the direct PLT, built as the
// synthesized "<dynamic metadata>" object and filled after relocation.
// Static PIE and shared output; no shared inputs yet, so imports have no
// provider library.

const DYN_INTERP u64 = 1
const DYN_DYNSTR u64 = 2
const DYN_DYNSYM u64 = 3
const DYN_HASH u64 = 4
const DYN_RELA u64 = 5
const DYN_DYNAMIC u64 = 6
const DYN_PLT u64 = 7
const DYN_VERSYM u64 = 8
const DYN_VERNEED u64 = 9
const DYN_VERDEF u64 = 10
const DYN_GNU_HASH u64 = 11

const HASH_SYSV u8 = 0
const HASH_GNU u8 = 1
const HASH_BOTH u8 = 2

// a fixup's target: an input relocation, a GOT slot, or a COPY storage symbol
const FX_INPUT u8 = 0
const FX_GOT u8 = 1
const FX_COPY u8 = 2

struct Fixup {
    target u64      // FX_INPUT: (file << 32 | relocation); FX_GOT: the slot
    symbol u32
    kind u32
    tkind u8
    pad1 u8
    pad2 u16
    pad3 u32
}

struct Export {
    source u32
    symbol u32
    index u32
    name u32
    image_relative u8
    visibility u8
    version u16
}

// Dynamic.import: a dynsym entry for a runtime import
struct DImp {
    key u32         // the global id (Symver.key)
    name u32        // the provider name's .dynstr offset
    version u32
    index u32
}


struct DynVerNeed {
    library u32
    id u32
    name_off u32
    pad u32
    text Bytes
}


// Lifecycle: _init/_fini (tag 12/13, packed definition) and the arrays of
// kinds 16, 14, 15 (each its kept nonempty sections, in object order)

// ---------- strings ----------


fn dyn_string(name Bytes) u32 fails {
    if bytes_contains(name, 0) || name.n > 65535 { try die_c(c"invalid or oversized dynamic name") }
    h u64 = bytes_hash(name)
    e u32 = kx_first(&ld.ds_index, h)
    while e != NONE {
        if bytes_eq(vec_get(&ld.ds_names, zext[u64](e)), name) { return ld.ds_offsets.p[u32, zext[u64](e)] }
        e = kx_next(&ld.ds_index, e)
    }
    offset u32 = trunc[u32](ld.ds_buf.n)
    buf_append(&ld.ds_buf, name)
    buf_u8(&ld.ds_buf, 0)
    kx_add(&ld.ds_index, h, trunc[u32](ld.ds_names.n))
    vec_push(&ld.ds_names, name)
    vec_push(&ld.ds_offsets, offset)
    return offset
}

// ---------- hashes ----------

// Symbol_hash.sysv, computed like the OCaml linker's (64-bit, the bits
// above 31 that carries leave are kept)
fn sysv_hash(name Bytes) u64 {
    h u64 = 0
    for i u64 in 0..name.n {
        h = (h << 4) + zext[u64](name.p[u8, i])
        high u64 = h & 0xf0000000
        h = (h ^ (high >> 24)) & (high ^ 0xffffffffffffffff)
    }
    return h
}

fn gnu_hash(name Bytes) u64 {
    h u64 = 5381
    for i u64 in 0..name.n { h = (h * 33 + zext[u64](name.p[u8, i])) & 0xffffffff }
    return h
}

// Gnu_hash.build: the old-to-new dynsym indices (remap, u32 per symbol)
// and the table (out)
fn gnu_hash_build(first u64, names addr, total u64, remap addr, out handle[Buf]) void {
    count u64 = total - first
    buckets u64 = umax(1, count / 4)
    hashes addr = heap_alloc(count * 8 + 8)
    counts addr = heap_alloc_zeroed(buckets * 8)
    for n u64 in 0..count {
        h u64 = gnu_hash(names[Bytes, first + n])
        hashes[u64, n] = h
        counts[u64, h % buckets] += 1
    }
    starts addr = heap_alloc(buckets * 8)
    next addr = heap_alloc(buckets * 8)
    cursor u64 = first
    for b u64 in 0..buckets {
        starts[u64, b] = cursor
        next[u64, b] = cursor
        cursor += counts[u64, b]
    }
    for n u64 in 0..total { remap[u32, n] = trunc[u32](n) }
    for n u64 in 0..count {
        b u64 = hashes[u64, n] % buckets
        remap[u32, first + n] = trunc[u32](next[u64, b])
        next[u64, b] += 1
    }
    bloom u64 = 1
    while bloom < umax(1, (count + 7) / 8) { bloom = bloom * 2 }
    bucket_start u64 = 16 + bloom * 8
    chain_start u64 = bucket_start + buckets * 4
    buf_zeros(out, chain_start + count * 4)
    p addr = out.p
    wr32(p, 0, buckets)
    wr32(p, 4, first)
    wr32(p, 8, bloom)
    wr32(p, 12, 6)
    for b u64 in 0..buckets {
        wr32(p, bucket_start + b * 4, if counts[u64, b] == 0 { 0 } else { starts[u64, b] })
    }
    for n u64 in 0..count {
        h u64 = hashes[u64, n]
        word u64 = (h / 64) & (bloom - 1)
        one u64 = 1
        mask u64 = (one << (h & 63)) | (one << ((h >> 6) & 63))
        at u64 = 16 + word * 8
        wr64(p, at, rd64(p, at) | mask)
        index u64 = zext[u64](remap[u32, first + n])
        b u64 = h % buckets
        last u64 = if index + 1 == starts[u64, b] + counts[u64, b] { 1 } else { 0 }
        wr32(p, chain_start + (index - first) * 4, (h & 0xfffffffe) | last)
    }
}

// ---------- Symver.name (Symver.plan is in partial.fas) ----------

// Symver.name: the name before its version
fn symver_name(name Bytes) Bytes {
    for j u64 in 0..name.n {
        if name.p[u8, j] == 64 { return bytes(name.p, j) }
    }
    return name
}

// ---------- Dynamic.prepare ----------

// Dynamic.relative_symbol
fn relative_symbol(f u64, i u64) bool {
    if i == 0 { return false }
    df u64 = 0
    ds u64 = 0
    if !definition(f, i, &df, &ds) { return false }
    if df == ld.predefined_file { return true }
    d handle[Sym] = sym(obj(df), ds)
    if d.section == 0 || d.section >= 0xff00 || d.kind == 6 { return false }
    return (sec(obj(df), zext[u64](d.section)).flags & 2) != 0
}

// Got.canonical_ifunc
fn canonical_ifunc(f u64, i u64) bool {
    df u64 = 0
    ds u64 = 0
    if !definition(f, i, &df, &ds) { return false }
    return map_has(&ld.got_canonical, pk(df, ds))
}

fn strong_undefined(name Bytes) bool {
    id u32 = find(name)
    return id != NONE && gsym(id).strong != 0
}

fn dyn_rfail(o handle[Obj], ts handle[Sec], r handle[Rel], y handle[Sym], text addr) void fails {
    m handle[Buf] = msg()
    bb(m, o.path)
    bs(m, c": ")
    bb(m, ts.name)
    bs(m, c"+0x")
    bx(m, r.offset)
    bs(m, c" referencing ")
    bb(m, y.name)
    bs(m, c": ")
    bs(m, text)
    bs(m, c" is unsupported in dynamic output")
    try die()
}

fn add_fixup(v handle[Vec[Fixup]], tkind u8, target u64, symbol u32, kind u32) void {
    x handle[Fixup] = vec_add(v)
    x.tkind = tkind
    x.target = target
    x.symbol = symbol
    x.kind = kind
}

fn dyn_stub(symbol u32, slot u32) void fails {
    if slot == NONE { try die_c(c"missing GOT slot for dynamic function call") }
    if ld.dyn_stub_index[u32, zext[u64](slot)] != NONE { return }
    ld.dyn_stub_index[u32, zext[u64](slot)] = trunc[u32](ld.dyn_stubs.n)
    vec_push(&ld.dyn_stubs, (zext[u64](symbol) << 32) | zext[u64](slot))
}

fn lifecycle_prepare() void fails {
    kinds arr[3, u32] = {}
    kinds[0] = 16
    kinds[1] = 14
    kinds[2] = 15
    for j u64 in 0..3 {
        before u64 = ld.lc_members.n
        for f u64 in 0..ld.nobj {
            o handle[Obj] = obj(f)
            for k u64 in 0..zext[u64](o.nsec) {
                s handle[Sec] = sec(o, k)
                if s.kind == kinds[j] && s.size != 0 && kept(f, k) { vec_push(&ld.lc_members, pk(f, k)) }
            }
        }
        if ld.lc_members.n != before {
            vec_push(&ld.lc_array_kinds, kinds[j])
            vec_push(&ld.lc_array_ends, ld.lc_members.n)
        }
    }
    for j u64 in 0..2 {
        name addr = if j == 0 { c"_init" } else { c"_fini" }
        id u32 = find(bytes_c(name))
        if id == NONE || gsym(id).has_res == 0 { continue }
        g handle[GSym] = gsym(id)
        df u64 = zext[u64](g.res_file)
        dsym u64 = zext[u64](g.res_sym)
        y handle[Sym] = sym(obj(df), dsym)
        bad bool = y.section == 0 || y.section >= 0xff00
        if !bad {
            k u64 = zext[u64](y.section)
            s handle[Sec] = sec(obj(df), k)
            bad = !kept(df, k) || (s.flags & 6) != 6 || y.value >= s.size
        }
        if bad {
            m handle[Buf] = msg()
            bs(m, name)
            bs(m, c" must be inside executable code")
            try die()
        }
        vec_push(&ld.lc_tags, 12 + j)
        vec_push(&ld.lc_funcs, pk(df, dsym))
    }
}

// Dynamic.version_id: assigns a required symbol version ID (starting at
// 2 + definition_count) for `(library, version)` and interns `version`.
fn dyn_version_id(library u32, version Bytes) u32 fails {
    c handle[Config] = config()
    h u64 = hash_mix((zext[u64](library) << 32) ^ bytes_hash(version))
    eid u32 = kx_first(&ld.dyn_ver_index, h)
    while eid != NONE {
        e handle[DynVerNeed] = vec_at(&ld.dyn_ver_entries, zext[u64](eid))
        if e.library == library && bytes_eq(e.text, version) { return e.id }
        eid = kx_next(&ld.dyn_ver_index, eid)
    }
    def_count u64 = if c.has_version_script && vs_named() { vs_node_count() } else { 0 }
    id u64 = 2 + def_count + ld.dyn_ver_entries.n
    if id >= 0x8000 { try die_c(c"too many required symbol versions") }
    name_off u32 = try dyn_string(version)
    new_idx u32 = trunc[u32](ld.dyn_ver_entries.n)
    e handle[DynVerNeed] = vec_add(&ld.dyn_ver_entries)
    e.library = library
    e.id = trunc[u32](id)
    e.name_off = name_off
    e.text = version
    kx_add(&ld.dyn_ver_index, h, new_idx)
    return trunc[u32](id)
}

// Dynamic.import: the dynsym index of a global id's import, or NONE
fn dyn_import(id u32, for_copy bool) u32 fails {
    if id == NONE { return NONE }
    key u32 = symver_key(id)
    if !for_copy && copy_has(key) { return NONE }
    g handle[GSym] = gsym(key)
    if g.imp == 0 { return NONE }
    p handle[Imp] = imp(key)
    if p.visibility != 0 {
        m handle[Buf] = msg()
        bs(m, c"undefined non-default visibility symbol ")
        bb(m, g.name)
        try die()
    }
    index u32 = ld.dyn_index[u32, zext[u64](key)]
    if index != NONE { return index }
    ld.dyn_import_count += 1
    if ld.dyn_import_count > 1000000 { try die_c(c"too many dynamic imports") }
    index = trunc[u32](ld.dyn_import_count)
    ver u32 = 1
    if p.library != NONE && p.version.n != NONE64 {
        ver = try dyn_version_id(p.library, p.version)
    }
    x handle[DImp] = vec_add(&ld.dyn_imports)
    x.key = key
    x.version = ver
    x.name = try dyn_string(p.name)
    x.index = index
    ld.dyn_index[u32, zext[u64](key)] = index
    return index
}

// Dynamic.export_version of a definition (f, i)
fn dyn_export_version(f u64, i u64, id u32) u64 fails {
    c handle[Config] = config()
    key Bytes = {}
    at u64 = sv_version(id, &key)
    if at != NONE64 {
        version Bytes = sv_version_text(key, at)
        vid u64 = NONE64
        if c.has_version_script && vs_named() {
            for n u64 in 0..vs_node_count() {
                if bytes_eq(vs_node(n).name, version) {
                    vid = n + 2
                    break
                }
            }
        }
        if vid == NONE64 {
            m handle[Buf] = msg()
            bs(m, c"symbol ")
            bb(m, sym(obj(f), i).name)
            bs(m, c" references missing version node ")
            bb(m, version)
            try die()
        }
        if !symver_default(key, at) { vid = vid | 0x8000 }
        return vid
    }
    if !c.has_version_script { return 1 }
    return zext[u64](try vs_policy(1, sym(obj(f), i).name))
}

// Dynamic's definition_data (.gnu.version_d): the base record (the
// SONAME) and one per named node; its strings are interned in record order
fn dyn_verdef_build(out handle[Buf]) void fails {
    c handle[Config] = config()
    if !c.has_version_script || !vs_named() { return }
    count u64 = vs_node_count()
    ld.dyn_verdef_count = count + 1
    for n u64 in 0..count + 1 {
        name Bytes = bytes_c(c"fas-shared")
        // (strings interned here: the base name, then each node's name and parent)
        if c.has_soname { name = c.soname }
        has_parent bool = false
        parent Bytes = bytes_empty()
        id u64 = 1
        flags u64 = 1
        if n != 0 {
            node handle[VsNode] = vs_node(n - 1)
            name = node.name
            has_parent = node.has_parent != 0
            parent = node.parent
            id = n + 1
            flags = 0
        }
        at u64 = out.n
        size u64 = if has_parent { 36 } else { 28 }
        buf_zeros(out, size)
        wr16(out.p, at, 1)
        wr16(out.p, at + 2, flags)
        wr16(out.p, at + 4, id)
        wr16(out.p, at + 6, if has_parent { 2 } else { 1 })
        wr32(out.p, at + 8, sysv_hash(name))
        wr32(out.p, at + 12, 20)
        wr32(out.p, at + 16, if n == count { 0 } else { size })
        wr32(out.p, at + 20, zext[u64](try dyn_string(name)))
        if has_parent {
            wr32(out.p, at + 24, 8)
            wr32(out.p, at + 28, zext[u64](try dyn_string(parent)))
        }
    }
}

// Dynamic.bound_definition: a descriptor symbol's canonical definition
fn dyn_bound_definition(f u64, i u64) u64 fails {
    y handle[Sym] = sym(obj(f), i)
    if y.binding == 0 { return pk(f, i) }
    id u32 = gid_of(f, i)
    if id != NONE {
        g handle[GSym] = gsym(id)
        if g.has_res != 0 { return pk(zext[u64](g.res_file), zext[u64](g.res_sym)) }
    }
    m handle[Buf] = msg()
    bb(m, obj(f).path)
    bs(m, c": undefined TLS symbol ")
    bb(m, y.name)
    try die()
    return 0
}

fn dyn_section(o handle[Obj], data handle[Buf], index u64, name addr, kind u32, flags u64, alignment u64,
    entsize u64, size u64) void {
    s handle[Sec] = sec(o, index)
    s.name = bytes_c(name)
    s.kind = kind
    s.flags = flags
    s.offset = data.n
    s.size = size
    s.alignment = alignment
    s.entsize = entsize
    s.group = -1
    buf_zeros(data, size)
}

fn dyn_prepare() void fails {
    c handle[Config] = config()
    ld.dyn_shared = c.mode == MODE_SHARED
    static_pie bool = c.mode == MODE_STATIC_PIE
    ld.dyn_pie = c.pie || ld.dyn_shared
    ld.dyn_static_tls = false
    if ld.dyn_shared {
        for slot u64 in 0..ld.got_slots.n {
            if ld.got_model.p[u8, slot] == GM_THREAD { ld.dyn_static_tls = true }
        }
    }
    try lifecycle_prepare()
    interp Bytes = if ld.dyn_shared || static_pie { bytes_empty() } else { c.interpreter }
    if (!ld.dyn_shared && !static_pie && interp.n == 0) || interp.n > 4095 || bytes_contains(interp, 0) {
        try die_c(c"dynamic interpreter must be a nonempty path of at most 4095 bytes")
    }
    buf_u8(&ld.ds_buf, 0)
    for j u64 in 0..ld.shlibs.n {
        vec_push(&ld.dyn_needed, try dyn_string(shlib(j).needed))
    }
    if c.runpath != 0 {
        rp Buf = {}
        for j u64 in 0..c.runpaths.n {
            if j != 0 { buf_u8(&rp, 58) }
            bb(&rp, vec_get(&c.runpaths, j))
        }
        ld.dyn_runpath = try dyn_string(buf_bytes(&rp))
        ld.dyn_has_runpath = true
    }
    if c.has_soname {
        ld.dyn_soname = try dyn_string(c.soname)
        ld.dyn_has_soname = true
        if !ld.dyn_shared { try die_c(c"SONAME requires shared output") }
        if c.soname.n == 0 { try die_c(c"empty SONAME") }
    }
    verdef Buf = {}
    try dyn_verdef_build(&verdef)
    // local descriptors still need a TLS dynsym (symbol 0 is an undefined
    // weak descriptor to the loader): their canonical definitions come
    // before every global symbol
    bh handle[U64Map] = &ld.dyn_bound_index
    for slot u64 in 0..ld.got_slots.n {
        if ld.got_model.p[u8, slot] != GM_DESCRIPTOR { continue }
        x u64 = ld.got_slots.p[u64, slot]
        y handle[Sym] = sym(obj(pk_file(x)), pk_sec(x))
        if y.binding != 0 && dyn_imported(y.name) { continue }
        key u64 = try dyn_bound_definition(pk_file(x), pk_sec(x))
        if map_val_addr(bh, key) != null { continue }
        vec_push(&ld.dyn_bound, key)
        map_put(bh, key, trunc[u32](ld.dyn_bound.n))
    }
    local_count u64 = ld.dyn_bound.n
    ld.dyn_import_count = local_count
    ld.dyn_index = heap_alloc(ld.gsyms.n * 4 + 4)
    for j u64 in 0..ld.gsyms.n { ld.dyn_index[u32, j] = NONE }
    relative Vec[Fixup] = {}
    symbolic Vec[Fixup] = {}
    for j u64 in 0..ld.copy_entries.n {
        ent handle[CopyEntry] = vec_at(&ld.copy_entries, j)
        sym_idx u32 = try dyn_import(ent.key_id, true)
        add_fixup(&symbolic, FX_COPY, pk(zext[u64](ent.file), zext[u64](ent.symbol)), sym_idx, 5)
    }
    ld.dyn_stub_index = heap_alloc(ld.got_slots.n * 4 + 4)
    for slot u64 in 0..ld.got_slots.n { ld.dyn_stub_index[u32, slot] = NONE }
    isl handle[U64Map] = &ld.dyn_ifunc_slots
    for slot u64 in 0..ld.got_slots.n {
        if ld.got_model.p[u8, slot] != GM_IFUNC { continue }
        x u64 = ld.got_slots.p[u64, slot]
        df u64 = 0
        ds u64 = 0
        if definition(pk_file(x), pk_sec(x), &df, &ds) { map_put(isl, pk(df, ds), trunc[u32](slot)) }
    }
    eh_frame addr = c".eh_frame"
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for k u64 in 0..zext[u64](o.nrel) {
            r handle[Rel] = rel(o, k)
            t u64 = zext[u64](r.target)
            if r.kind == 0 || r.kind == 35 || !kept(f, t) { continue }
            ts handle[Sec] = sec(o, t)
            if (ts.flags & 2) == 0 { continue }
            si u64 = zext[u64](r.symbol)
            y handle[Sym] = sym(o, si)
            slot u32 = lx(f).gotref[u32, k]
            imported u32 = NONE
            if y.binding != 0 {
                id u32 = gid_of(f, si)
                defined bool = id != NONE && gsym(id).has_res != 0
                if (bytes_is(ts.name, eh_frame) || r.kind == 17 || r.kind == 21) && defined {
                    // a local reference
                } else if !ld.dyn_pie && (r.kind == 10 || r.kind == 11) && id != NONE && gsym(id).imp != 0 &&
                    imp(id).library == NONE && imp(id).binding == 2 {
                    // an absent weak provider: the address is 0
                } else {
                    imported = try dyn_import(id, false)
                }
            }
            if imported != NONE {
                if r.kind == 4 {
                    pk_kind u8 = imp(symver_key(gid_of(f, si))).kind
                    if pk_kind != 0 && pk_kind != 2 && pk_kind != 10 { try dyn_rfail(o, ts, r, y, c"function call to a data symbol") }
                    try dyn_stub(imported, slot)
                } else if r.kind == 1 {
                    if (ts.flags & 1) == 0 { try dyn_rfail(o, ts, r, y, c"import relocation in read-only memory") }
                    add_fixup(&symbolic, FX_INPUT, pk(f, k), imported, 1)
                } else if !got_relocation(r.kind) {
                    try dyn_rfail(o, ts, r, y, c"direct import relocation (compile position-independent code)")
                }
                continue
            }
            if is_ifunc(f, si) && !bytes_is(ts.name, eh_frame) {
                if r.kind == 4 || r.kind == 2 {
                    try dyn_stub(0, slot)
                } else if r.kind == 1 {
                    if (ts.flags & 1) == 0 { try dyn_rfail(o, ts, r, y, c"IFUNC relocation in read-only memory") }
                    canonical bool = canonical_ifunc(f, si)
                    if r.addend != 0 && !canonical { try dyn_rfail(o, ts, r, y, c"nonzero addend on local IFUNC address") }
                    if !canonical {
                        add_fixup(&symbolic, FX_INPUT, pk(f, k), 0, 37)
                    } else if ld.dyn_pie {
                        add_fixup(&relative, FX_INPUT, pk(f, k), 0, 8)
                    }
                } else if !got_relocation(r.kind) {
                    try dyn_rfail(o, ts, r, y, c"direct local IFUNC reference")
                }
                continue
            }
            if y.section == 0 && y.binding != 0 && strong_undefined(y.name) && !name_defined(y.name) {
                m handle[Buf] = msg()
                bb(m, o.path)
                bs(m, c": undefined symbol ")
                bb(m, y.name)
                try die()
            }
            rs bool = relative_symbol(f, si)
            if ld.dyn_pie && rs && r.kind == 1 {
                if (ts.flags & 1) == 0 { try dyn_rfail(o, ts, r, y, c"absolute relocation in read-only memory") }
                add_fixup(&relative, FX_INPUT, pk(f, k), 0, 8)
            } else if ld.dyn_pie && rs && (r.kind == 10 || r.kind == 11) {
                try dyn_rfail(o, ts, r, y, c"narrow absolute address relocation (compile position-independent code)")
            } else if ld.dyn_pie && !rs && (r.kind == 2 || r.kind == 4 || r.kind == 24) {
                weak_call bool = static_pie && r.kind == 4 && (ts.flags & 4) != 0 && y.section == 0 &&
                    y.binding == 2 && !name_defined(y.name) && !strong_undefined(y.name)
                if !weak_call { try dyn_rfail(o, ts, r, y, c"PC-relative reference to an absolute or undefined address") }
            }
        }
    }
    for slot u64 in 0..ld.got_slots.n {
        x u64 = ld.got_slots.p[u64, slot]
        f u64 = pk_file(x)
        si u64 = pk_sec(x)
        model u8 = ld.got_model.p[u8, slot]
        imported u32 = NONE
        if sym(obj(f), si).binding != 0 && model != GM_LOCAL_MODULE && model != GM_LOCAL_OFFSET {
            imported = try dyn_import(gid_of(f, si), false)
        }
        if model == GM_DESCRIPTOR_ARGUMENT { continue }
        if imported != NONE {
            kind u32 = 6
            if model == GM_THREAD {
                kind = 18
            } else if model == GM_MODULE_ID {
                kind = 16
            } else if model == GM_DYNAMIC_OFFSET {
                kind = 17
            } else if model == GM_DESCRIPTOR {
                kind = 36
            }
            add_fixup(&symbolic, FX_GOT, slot, imported, kind)
            continue
        }
        ifn bool = is_ifunc(f, si)
        if model == GM_ADDRESS && ld.dyn_pie && relative_symbol(f, si) && (!ifn || canonical_ifunc(f, si)) {
            add_fixup(&relative, FX_GOT, slot, 0, 8)
        } else if ld.dyn_shared && (model == GM_MODULE_ID || model == GM_LOCAL_MODULE) {
            add_fixup(&symbolic, FX_GOT, slot, 0, 16)
        } else if ld.dyn_shared && model == GM_THREAD {
            add_fixup(&symbolic, FX_GOT, slot, 0, 18)
        } else if model == GM_DESCRIPTOR {
            a addr = map_val_addr(bh, try dyn_bound_definition(f, si))
            add_fixup(&symbolic, FX_GOT, slot, a[u32], 36)
        } else if (model == GM_IFUNC || (model == GM_ADDRESS && !canonical_ifunc(f, si))) && ifn {
            add_fixup(&symbolic, FX_GOT, slot, 0, 37)
        }
    }
    ld.dyn_relative_count = relative.n
    for j u64 in 0..relative.n { copy_into[Fixup](vec_add(&ld.dyn_fixups), vec_at(&relative, j)) }
    for j u64 in 0..symbolic.n { copy_into[Fixup](vec_add(&ld.dyn_fixups), vec_at(&symbolic, j)) }
    vec_free(&relative)
    vec_free(&symbolic)

    // exports
    dnames Vec[Bytes] = {}
    for j u64 in 0..local_count + 1 { vec_push(&dnames, bytes(null, 0)) }
    for j u64 in 0..ld.dyn_imports.n { vec_push(&dnames, imp(vec_at(&ld.dyn_imports, j).key).name) }
    for f u64 in 0..ld.nobj {
        o handle[Obj] = obj(f)
        for i u64 in 1..zext[u64](o.nsym) {
            y handle[Sym] = sym(o, i)
            if y.binding == 0 { continue }
            id u32 = gid_of(f, i)
            if id == NONE { continue }
            g handle[GSym] = gsym(id)
            if g.has_res == 0 || zext[u64](g.res_file) != f || zext[u64](g.res_sym) != i { continue }
            if ld.sv_alias[u32, zext[u64](id)] != NONE || (g.res_vis != 0 && g.res_vis != 3) { continue }
            if !ld.dyn_shared && !c.export_dynamic && !is_shared_ref(y.name) { continue }
            if y.section != 0xfff1 {
                if y.section == 0 || y.section >= 0xff00 { continue }
                k u64 = zext[u64](y.section)
                if !kept(f, k) || (sec(o, k).flags & 2) == 0 { continue }
            }
            dynamic_name Bytes = symver_name(y.name)
            // the record's fields evaluate right to left: the index, then the
            // version (a versioned name needs a version node), then the name
            index u64 = dnames.n
            ii u32 = ld.dyn_index[u32, zext[u64](symver_key(id))]
            fresh bool = ii == NONE
            if !fresh { index = zext[u64](ii) }
            version u64 = 1
            if copy_has(id) {
                p handle[Imp] = imp(id)
                if p.library != NONE && p.version.n != NONE64 {
                    version = zext[u64](try dyn_version_id(p.library, p.version))
                }
            } else {
                version = try dyn_export_version(f, i, id)
            }
            e handle[Export] = vec_add(&ld.dyn_exports)
            e.source = trunc[u32](f)
            e.symbol = trunc[u32](i)
            e.index = trunc[u32](index)
            e.version = trunc[u16](version)
            e.name = try dyn_string(dynamic_name)
            e.image_relative = if f == ld.predefined_file { 1 } else { 0 }
            e.visibility = g.res_vis
            if fresh {
                vec_push(&dnames, dynamic_name)
            } else {
                dnames.p[Bytes, index] = dynamic_name
            }
        }
    }
    symbol_count u64 = dnames.n
    ld.dyn_symbol_count = symbol_count
    if symbol_count > 1000000 { try die_c(c"too many dynamic symbols") }
    remap addr = heap_alloc(symbol_count * 4 + 4)
    gnu Buf = {}
    if c.hash_style == HASH_SYSV {
        for n u64 in 0..symbol_count { remap[u32, n] = trunc[u32](n) }
    } else {
        gnu_hash_build(local_count + 1, dnames.p, symbol_count, remap, &gnu)
    }
    ordered addr = heap_alloc_zeroed(symbol_count * sizeof[Bytes] + 8)
    for n u64 in 0..symbol_count { ordered[Bytes, zext[u64](remap[u32, n])] = dnames.p[Bytes, n] }
    ld.dyn_ifunc_symbols = heap_alloc_zeroed(symbol_count + 1)
    for j u64 in 0..ld.dyn_exports.n {
        e handle[Export] = vec_at(&ld.dyn_exports, j)
        e.index = remap[u32, zext[u64](e.index)]
        if sym(obj(zext[u64](e.source)), zext[u64](e.symbol)).kind == 10 { ld.dyn_ifunc_symbols[u8, zext[u64](e.index)] = 1 }
    }
    for j u64 in 0..ld.dyn_imports.n {
        x handle[DImp] = vec_at(&ld.dyn_imports, j)
        x.index = remap[u32, zext[u64](x.index)]
        if imp(x.key).kind == 10 { ld.dyn_ifunc_symbols[u8, zext[u64](x.index)] = 1 }
    }
    for j u64 in 0..ld.dyn_fixups.n {
        x handle[Fixup] = vec_at(&ld.dyn_fixups, j)
        x.symbol = remap[u32, zext[u64](x.symbol)]
    }
    for j u64 in 0..ld.dyn_stubs.n {
        s u64 = ld.dyn_stubs.p[u64, j]
        ld.dyn_stubs.p[u64, j] = (zext[u64](remap[u32, s >> 32]) << 32) | (s & 0xffffffff)
    }

    // Build .gnu.version_r: per library in shlibs order, aux entries in reverse
    // discovery order (matching dynamic.ml's double-prepend + List.rev).
    verneed Buf = {}
    ld.dyn_verneed_count = 0
    if ld.dyn_ver_entries.n != 0 && ld.shlibs.n != 0 {
        nonempty Vec[u64] = {}
        for lib_idx u64 in 0..ld.shlibs.n {
            cnt u64 = 0
            for j u64 in 0..ld.dyn_ver_entries.n {
                if zext[u64](vec_at(&ld.dyn_ver_entries, j).library) == lib_idx { cnt += 1 }
            }
            if cnt != 0 { vec_push(&nonempty, lib_idx) }
        }
        ld.dyn_verneed_count = nonempty.n
        for gi u64 in 0..nonempty.n {
            lib_idx u64 = vec_get(&nonempty, gi)
            group_ids Vec[u64] = {}
            j u64 = ld.dyn_ver_entries.n
            while j > 0 {
                j -= 1
                if zext[u64](vec_at(&ld.dyn_ver_entries, j).library) == lib_idx { vec_push(&group_ids, j) }
            }
            vcnt u64 = group_ids.n
            start u64 = verneed.n
            gsize u64 = 16 + vcnt * 16
            buf_zeros(&verneed, gsize)
            wr16(verneed.p, start, 1)
            wr16(verneed.p, start + 2, vcnt)
            wr32(verneed.p, start + 4, zext[u64](ld.dyn_needed.p[u32, lib_idx]))
            wr32(verneed.p, start + 8, 16)
            wr32(verneed.p, start + 12, if gi + 1 == nonempty.n { 0 } else { gsize })
            for k u64 in 0..vcnt {
                e handle[DynVerNeed] = vec_at(&ld.dyn_ver_entries, vec_get(&group_ids, k))
                at u64 = start + 16 + k * 16
                wr32(verneed.p, at, sysv_hash(e.text))
                wr16(verneed.p, at + 6, zext[u64](e.id))
                wr32(verneed.p, at + 8, zext[u64](e.name_off))
                wr32(verneed.p, at + 12, if k + 1 == vcnt { 0 } else { 16 })
            }
            vec_free(&group_ids)
        }
        vec_free(&nonempty)
    }

    // the metadata object
    file u64 = ld.nobj
    o handle[Obj] = try new_object(c"<dynamic metadata>")
    o.nsec = 12
    o.secs = heap_alloc_zeroed(12 * sizeof[Sec])
    data Buf = {}
    d handle[Buf] = &data
    s0 handle[Sec] = sec(o, 0)
    s0.alignment = 1
    s0.group = -1
    isec handle[Sec] = sec(o, DYN_INTERP)
    dyn_section(o, d, DYN_INTERP, c".interp", 1, 2, 1, 0, 0)
    if !ld.dyn_shared && !static_pie {
        buf_append(d, interp)
        buf_u8(d, 0)
        isec.size = interp.n + 1
    }
    ds handle[Sec] = sec(o, DYN_DYNSTR)
    dyn_section(o, d, DYN_DYNSTR, c".dynstr", 3, 2, 1, 0, 0)
    buf_append(d, buf_bytes(&ld.ds_buf))
    ds.size = ld.ds_buf.n
    dsy u64 = d.n
    dyn_section(o, d, DYN_DYNSYM, c".dynsym", 11, 2, 8, 24, symbol_count * 24)
    for j u64 in 0..ld.dyn_imports.n {
        x handle[DImp] = vec_at(&ld.dyn_imports, j)
        p handle[Imp] = imp(x.key)
        at u64 = dsy + zext[u64](x.index) * 24
        wr32(d.p, at, zext[u64](x.name))
        wr8(d.p, at + 4, (zext[u64](p.binding) << 4) | (if p.kind == 10 { 2 } else { zext[u64](p.kind) }))
    }
    if c.hash_style == HASH_GNU {
        dyn_section(o, d, DYN_HASH, c".hash", 5, 2, 4, 4, 0)
    } else {
        buckets u64 = umax(1, (symbol_count - 1) / 4)
        at u64 = d.n
        dyn_section(o, d, DYN_HASH, c".hash", 5, 2, 4, 4, 8 + (buckets + symbol_count) * 4)
        wr32(d.p, at, buckets)
        wr32(d.p, at + 4, symbol_count)
        for n u64 in local_count + 1..symbol_count {
            h i64 = bitcast[i64](sysv_hash(ordered[Bytes, n]))
            bucket i64 = h % bitcast[i64](buckets)
            if bucket < 0 { try die_c(c"SysV hash bucket out of range") }
            b u64 = at + 8 + bitcast[u64](bucket) * 4
            wr32(d.p, at + 8 + (buckets + n) * 4, zext[u64]((d.p + b)[u32]))
            wr32(d.p, b, n)
        }
    }
    dyn_section(o, d, DYN_RELA, c".rela.dyn", 4, 2, 8, 24, 24 * ld.dyn_fixups.n)
    tag_count u64 = 13 + ld.dyn_needed.n + ld.lc_funcs.n + 2 * ld.lc_array_ends.n
    if c.hash_style == HASH_BOTH { tag_count += 1 }
    if ld.dyn_has_runpath { tag_count += 1 }
    if ld.dyn_has_soname { tag_count += 1 }
    if ld.dyn_shared { tag_count -= 1 }
    if ld.dyn_verneed_count != 0 || ld.dyn_verdef_count != 0 { tag_count += 1 }
    if ld.dyn_verneed_count != 0 { tag_count += 2 }
    if ld.dyn_verdef_count != 0 { tag_count += 2 }
    dyn_section(o, d, DYN_DYNAMIC, c".dynamic", 6, 3, 8, 16, tag_count * 16)
    dyn_section(o, d, DYN_PLT, c".plt", 1, 6, 16, 16, ld.dyn_stubs.n * 16)
    vs u64 = d.n
    dyn_section(o, d, DYN_VERSYM, c".gnu.version", 0x6fffffff, 2, 2, 2, symbol_count * 2)
    for j u64 in 0..ld.dyn_imports.n {
        x handle[DImp] = vec_at(&ld.dyn_imports, j)
        wr16(d.p, vs + zext[u64](x.index) * 2, zext[u64](x.version))
    }
    for j u64 in 0..ld.dyn_exports.n {
        e handle[Export] = vec_at(&ld.dyn_exports, j)
        wr16(d.p, vs + zext[u64](e.index) * 2, zext[u64](e.version))
    }
    vns handle[Sec] = sec(o, DYN_VERNEED)
    dyn_section(o, d, DYN_VERNEED, c".gnu.version_r", 0x6ffffffe, 2, 8, 0, 0)
    buf_append(d, buf_bytes(&verneed))
    vns.size = verneed.n
    vds handle[Sec] = sec(o, DYN_VERDEF)
    dyn_section(o, d, DYN_VERDEF, c".gnu.version_d", 0x6ffffffd, 2, 8, 0, 0)
    buf_append(d, buf_bytes(&verdef))
    vds.size = verdef.n
    gs handle[Sec] = sec(o, DYN_GNU_HASH)
    dyn_section(o, d, DYN_GNU_HASH, c".gnu.hash", 0x6ffffff6, 2, 8, 0, 0)
    buf_append(d, buf_bytes(&gnu))
    gs.size = gnu.n
    o.data = d.p
    o.len = d.n
    o.nsym = 1
    o.syms = heap_alloc_zeroed(sizeof[Sym])
    l handle[Lx] = lx(file)
    l.discarded = heap_alloc_zeroed(13)
    l.gid = heap_alloc_zeroed(4)
    l.gid[u32, 0] = NONE
    l.kept = heap_alloc_zeroed(13)
    for k u64 in 1..12 {
        keep bool = true
        if (ld.dyn_shared || static_pie) && k == DYN_INTERP { keep = false }
        if k == DYN_VERSYM && ld.dyn_verneed_count == 0 && ld.dyn_verdef_count == 0 { keep = false }
        if k == DYN_VERNEED && ld.dyn_verneed_count == 0 { keep = false }
        if k == DYN_VERDEF && ld.dyn_verdef_count == 0 { keep = false }
        if k == DYN_HASH && c.hash_style == HASH_GNU { keep = false }
        if k == DYN_GNU_HASH && c.hash_style == HASH_SYSV { keep = false }
        if keep { l.kept[u8, k] = 1 }
    }
    l.alias = heap_alloc_zeroed(12 * 8 + 8)
    l.gotref = heap_alloc_zeroed(4)
    ld.dyn_file = file
    stat_add(ST_DYNAMIC_RELATIVE_RELOCATIONS, ld.dyn_relative_count)
    stat_add(ST_DYNAMIC_IMPORTS, ld.dyn_imports.n)
    stat_add(ST_DYNAMIC_EXPORTS, ld.dyn_exports.n)
    stat_add(ST_PLT_ENTRIES, ld.dyn_stubs.n)
}

// ---------- after layout ----------

fn dyn_place(k u64) handle[Place] { return place(ld.dyn_file, k) }

// Dynamic.metadata: an output section's (link, info), or false
fn dyn_metadata(output_index u64, link addr, info addr) bool {
    if ld.dyn_file == NONE64 { return false }
    which u64 = NONE64
    for k u64 in 1..12 {
        p handle[Place] = dyn_place(k)
        if p.valid != 0 && zext[u64](p.output_index) == output_index {
            which = k
            break
        }
    }
    if which == NONE64 { return false }
    dynstr u64 = zext[u64](dyn_place(DYN_DYNSTR).output_index)
    if which == DYN_DYNSYM {
        link[u64] = dynstr
        info[u64] = ld.dyn_bound.n + 1
    } else if which == DYN_HASH || which == DYN_GNU_HASH || which == DYN_RELA || which == DYN_VERSYM {
        link[u64] = zext[u64](dyn_place(DYN_DYNSYM).output_index)
        info[u64] = 0
    } else if which == DYN_DYNAMIC || which == DYN_VERNEED || which == DYN_VERDEF {
        link[u64] = dynstr
        info[u64] = if which == DYN_VERNEED { ld.dyn_verneed_count } else if which == DYN_VERDEF { ld.dyn_verdef_count } else { 0 }
    } else {
        return false
    }
    return true
}

// the PLT stub for a GOT slot (Dynamic.stub), or false
fn dyn_stub_address(slot u32, out addr) bool {
    if ld.dyn_file == NONE64 || slot == NONE { return false }
    index u32 = ld.dyn_stub_index[u32, zext[u64](slot)]
    if index == NONE { return false }
    out[u64] = dyn_place(DYN_PLT).address + zext[u64](index) * 16
    return true
}

// Dynamic.ifunc_stub
fn dyn_ifunc_stub(f u64, i u64, out addr) bool {
    if ld.dyn_file == NONE64 { return false }
    df u64 = 0
    ds u64 = 0
    if !definition(f, i, &df, &ds) { return false }
    a addr = map_val_addr(&ld.dyn_ifunc_slots, pk(df, ds))
    if a == null { return false }
    return dyn_stub_address(a[u32], out)
}

// Layout.image_symbol_section
fn image_symbol_section(value u64) u64 fails {
    first u64 = NONE64
    containing u64 = NONE64
    for k u64 in 0..ld.headers.n {
        s handle[OutSec] = vec_at(&ld.headers, k)
        if (s.flags & 2) == 0 || (s.flags & 0x400) != 0 { continue }
        if first == NONE64 { first = k + 1 }
        if value >= s.address && value <= s.address + s.size { containing = k + 1 }
    }
    if containing != NONE64 { return containing }
    if first != NONE64 { return first }
    try die_c(c"image-relative symbol has no allocatable output section")
    return 0
}

// a fixup to sort: (rank << 62 | its index in dyn_fixups) and its address
value struct FxOut { meta u64, address u64 }

fn fx_less(a FxOut, b FxOut) bool {
    if (a.meta >> 62) != (b.meta >> 62) { return (a.meta >> 62) < (b.meta >> 62) }
    return a.address < b.address
}

// a fixup's file offset and address
fn fx_target(x handle[Fixup], gp u64, ga u64, address addr) u64 {
    if x.tkind == FX_INPUT {
        f u64 = pk_file(x.target)
        r handle[Rel] = rel(obj(f), pk_sec(x.target))
        p handle[Place] = place(f, zext[u64](r.target))
        address[u64] = p.address + r.offset
        return p.offset + r.offset
    }
    if x.tkind == FX_COPY {
        f u64 = pk_file(x.target)
        y handle[Sym] = sym(obj(f), pk_sec(x.target))
        p handle[Place] = place(f, zext[u64](y.section))
        address[u64] = p.address + y.value
        return p.offset + y.value
    }
    address[u64] = ga + x.target * 8
    return gp + x.target * 8
}

fn dyn_tag(at u64, tag u64, value u64) u64 {
    wr64(ld.image, at, tag)
    wr64(ld.image, at + 8, value)
    return at + 16
}

// Dynamic.emit, after relocation
fn dyn_emit() void fails {
    if ld.dyn_file == NONE64 { return }
    c handle[Config] = config()
    dynsym handle[Place] = dyn_place(DYN_DYNSYM)
    for j u64 in 0..ld.dyn_bound.n {
        x u64 = ld.dyn_bound.p[u64, j]
        f u64 = pk_file(x)
        y handle[Sym] = sym(obj(f), pk_sec(x))
        p handle[Place] = place(f, zext[u64](y.section))
        at u64 = dynsym.offset + (j + 1) * 24
        wr8(ld.image, at + 4, 6)
        wr16(ld.image, at + 6, zext[u64](p.output_index))
        value u64 = 0
        if x != ld.module_base { value = y.value + p.address - ld.lay_base - ld.tls_seg.offset }
        wr64(ld.image, at + 8, value)
        wr64(ld.image, at + 16, y.size)
    }
    for j u64 in 0..ld.dyn_exports.n {
        e handle[Export] = vec_at(&ld.dyn_exports, j)
        f u64 = zext[u64](e.source)
        y handle[Sym] = sym(obj(f), zext[u64](e.symbol))
        section u64 = 0
        value u64 = 0
        if e.image_relative != 0 {
            section = try image_symbol_section(y.value)
            value = y.value
        } else if y.section == 0xfff1 {
            section = 0xfff1
            value = y.value
        } else {
            p handle[Place] = place(f, zext[u64](y.section))
            section = zext[u64](p.output_index)
            a u64 = p.address
            if y.kind == 6 { a = a - (ld.lay_base + ld.tls_seg.offset) }
            value = a + y.value
        }
        at u64 = dynsym.offset + zext[u64](e.index) * 24
        wr32(ld.image, at, zext[u64](e.name))
        wr8(ld.image, at + 4, (zext[u64](y.binding) << 4) | zext[u64](y.kind))
        wr8(ld.image, at + 5, zext[u64](e.visibility))
        wr16(ld.image, at + 6, section)
        wr64(ld.image, at + 8, value)
        wr64(ld.image, at + 16, y.size)
    }
    outs Vec[FxOut] = {}
    gp u64 = 0
    ga u64 = 0
    if ld.got_file != NONE64 {
        g handle[Place] = place(ld.got_file, 1)
        gp = g.offset
        ga = g.address
    }
    for j u64 in 0..ld.dyn_fixups.n {
        x handle[Fixup] = vec_at(&ld.dyn_fixups, j)
        a u64 = 0
        fx_target(x, gp, ga, &a)
        rank u64 = 1
        if x.kind == 8 {
            rank = 0
        } else if x.kind == 37 || ld.dyn_ifunc_symbols[u8, zext[u64](x.symbol)] != 0 {
            rank = 2
        }
        vec_push(&outs, {(rank << 62) | j, a})
    }
    sort_vec[FxOut, fx_less](&outs)
    rela handle[Place] = dyn_place(DYN_RELA)
    for j u64 in 0..outs.n {
        t FxOut = vec_get(&outs, j)
        x handle[Fixup] = vec_at(&ld.dyn_fixups, t.meta & 0x3fffffffffffffff)
        address u64 = 0
        offset u64 = fx_target(x, gp, ga, &address)
        at u64 = rela.offset + j * 24
        addend u64 = 0
        if x.kind == 5 || x.kind == 6 || x.kind == 16 || x.kind == 36 {
            addend = 0
        } else if x.tkind == FX_INPUT && x.kind == 1 {
            addend = rel(obj(pk_file(x.target)), pk_sec(x.target)).addend
        } else {
            addend = rd64(ld.image, offset)
        }
        wr64(ld.image, at, t.address)
        wr64(ld.image, at + 8, (zext[u64](x.symbol) << 32) | zext[u64](x.kind))
        wr64(ld.image, at + 16, addend)
        if x.kind != 5 { wr64(ld.image, offset, 0) }
    }
    plt handle[Place] = dyn_place(DYN_PLT)
    for j u64 in 0..ld.dyn_stubs.n {
        slot u64 = ld.dyn_stubs.p[u64, j] & 0xffffffff
        stub u64 = plt.offset + j * 16
        address u64 = plt.address + j * 16
        mem_copy(ld.image + stub, &IPLT_PREFIX, 6)
        v u64 = ga + slot * 8 - 4 - (address + 6)
        sv i64 = bitcast[i64](v)
        if sv < -2147483648 || sv > 2147483647 {
            m handle[Buf] = msg()
            bs(m, c"dynamic PLT: R_X86_64_PC32 overflow: result 0x")
            bx(m, v)
            try die()
        }
        wr32(ld.image, stub + 6, v)
        mem_copy(ld.image + stub + 10, &IPLT_NOP6, 6)
    }
    at u64 = dyn_place(DYN_DYNAMIC).offset
    for j u64 in 0..ld.dyn_needed.n {
        at = dyn_tag(at, 1, zext[u64](ld.dyn_needed.p[u32, j]))
    }
    for j u64 in 0..ld.lc_funcs.n {
        x u64 = ld.lc_funcs.p[u64, j]
        y handle[Sym] = sym(obj(pk_file(x)), pk_sec(x))
        at = dyn_tag(at, ld.lc_tags.p[u64, j], place(pk_file(x), zext[u64](y.section)).address + y.value)
    }
    for j u64 in 0..ld.lc_array_ends.n {
        first u64 = 0xffffffffffffffff
        last u64 = 0
        from u64 = if j == 0 { 0 } else { ld.lc_array_ends.p[u64, j - 1] }
        for m u64 in from..ld.lc_array_ends.p[u64, j] {
            x u64 = ld.lc_members.p[u64, m]
            p handle[Place] = place(pk_file(x), pk_sec(x))
            first = umin(first, p.address)
            last = umax(last, p.address + sec(obj(pk_file(x)), pk_sec(x)).size)
        }
        kind u32 = ld.lc_array_kinds.p[u32, j]
        ta u64 = 32
        ts u64 = 33
        if kind == 14 {
            ta = 25
            ts = 27
        } else if kind == 15 {
            ta = 26
            ts = 28
        }
        at = dyn_tag(at, ta, first)
        at = dyn_tag(at, ts, last - first)
    }
    if ld.dyn_has_runpath { at = dyn_tag(at, if c.new_dtags { 29 } else { 15 }, zext[u64](ld.dyn_runpath)) }
    if ld.dyn_has_soname { at = dyn_tag(at, 14, zext[u64](ld.dyn_soname)) }
    if !ld.dyn_shared { at = dyn_tag(at, 21, 0) }
    if ld.dyn_verneed_count != 0 || ld.dyn_verdef_count != 0 { at = dyn_tag(at, 0x6ffffff0, dyn_place(DYN_VERSYM).address) }
    if ld.dyn_verdef_count != 0 {
        at = dyn_tag(at, 0x6ffffffc, dyn_place(DYN_VERDEF).address)
        at = dyn_tag(at, 0x6ffffffd, ld.dyn_verdef_count)
    }
    if ld.dyn_verneed_count != 0 {
        at = dyn_tag(at, 0x6ffffffe, dyn_place(DYN_VERNEED).address)
        at = dyn_tag(at, 0x6fffffff, ld.dyn_verneed_count)
    }
    if c.hash_style != HASH_GNU { at = dyn_tag(at, 4, dyn_place(DYN_HASH).address) }
    if c.hash_style != HASH_SYSV { at = dyn_tag(at, 0x6ffffef5, dyn_place(DYN_GNU_HASH).address) }
    at = dyn_tag(at, 5, dyn_place(DYN_DYNSTR).address)
    at = dyn_tag(at, 6, dynsym.address)
    at = dyn_tag(at, 10, sec(obj(ld.dyn_file), DYN_DYNSTR).size)
    at = dyn_tag(at, 11, 24)
    at = dyn_tag(at, 7, rela.address)
    at = dyn_tag(at, 8, 24 * outs.n)
    at = dyn_tag(at, 9, 24)
    at = dyn_tag(at, 0x6ffffff9, ld.dyn_relative_count)
    flags1 u64 = 1
    if ld.dyn_pie && !ld.dyn_shared { flags1 = 0x08000001 }
    at = dyn_tag(at, 0x6ffffffb, flags1)
    flags u64 = 8
    if ld.dyn_static_tls { flags = 24 }
    at = dyn_tag(at, 30, flags)
    at = dyn_tag(at, 0, 0)
    vec_free(&outs)
}
