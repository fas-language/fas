// cc2/sema.fas: Declaration semantics, linkage, and value transformations.

fn se_symbol(p handle[Parser], name u32, loc u32, ty u32, storage u8, tu_lifetime bool) handle[Symbol] {
    s handle[Symbol] = if tu_lifetime { pa_tu_alloc[Symbol](p) } else { pa_alloc[Symbol](p) }
    s.name = name
    s.loc = loc
    s.ty = ty
    s.storage = storage
    return s
}

fn se_bind(p handle[Parser], s handle[Symbol]) void {
    if s.name == 0 { return }
    pa_bind_ord(p, s.name, s)
}

fn se_cleanup_attribute(p handle[Parser], s handle[Symbol], file bool, func bool) void fails {
    a handle[Attr] = s.attrs
    while a != null && !pa_attr_name(p, a, c"cleanup") { a = a.next }
    if a == null { return }
    if file || func || s.linkage != 0 || s.storage == SC_STATIC || s.storage == SC_TYPEDEF || s.thread_local {
        cc_diag(p.ctx, a.loc, c"warning: ", bytes_c(c"cleanup attribute requires an automatic object"))
        return
    }
    if a.args_n != 1 || a.args_p[Token].kind != TK_IDENT {
        try pa_error(p, a.loc, c"cleanup attribute requires a function identifier")
    }
    target handle[Symbol] = pa_lookup(p, cc_ident(p.ctx, a.args_p[Token]))
    if target == null || !ty_is_func(target.ty) { try pa_error(p, a.loc, c"cleanup attribute names no visible function") }
    ft handle[TypeNode] = ty_node(ty_unqual(target.ty))
    if ft.aux2 > 1 || (ft.aux2 == 0 && (ft.flags & TYF_VARIADIC) == 0) {
        try pa_error(p, a.loc, c"cleanup function must accept one argument")
    }
    if ft.aux2 == 1 && s.ty != TY_INVALID {
        arg handle[Ast] = pa_node(p, ND_UNARY, a.loc, ty_ptr(s.ty))
        try se_conversion(p, tc.fn_params.p[u32, zext[usize](ft.aux1)], arg)
    }
    s.cleanup = handle_addr(target)
}

fn se_interrupt_signature(p handle[Parser], s handle[Symbol]) void fails {
    fn_type handle[TypeNode] = ty_node(ty_unqual(s.ty))
    if !ty_is_void(fn_type.elem) || (fn_type.flags & TYF_VARIADIC) != 0 ||
        fn_type.aux2 == 0 || fn_type.aux2 > 2 ||
        !ty_is_ptr(tc.fn_params.p[u32, zext[usize](fn_type.aux1)]) ||
        (fn_type.aux2 == 2 && tc.fn_params.p[u32, zext[usize](fn_type.aux1) + 1] != TY_ULONG) {
        try pa_error(p, s.loc, c"x86-64 interrupt handler requires void return, a pointer and optional unsigned long")
    }
}

fn se_malloc_attribute(p handle[Parser], a handle[Attr], count u32) void fails {
    save ReplaySave = {}
    try pa_attr_replay(p, a, &save)
    defer { pa_attr_restore(p, &save) }
    name Token = try pa_take(p)
    if name.kind != TK_IDENT { try pa_error(p, name.loc, c"malloc attribute requires a deallocator function") }
    param u64 = 1
    if count == 2 {
        try pa_expect_k(p, TK_COMMA)
        param = try se_ice(p, try pa_expression(p, 3))
    }
    if p.cur.kind != TK_EOF { try pa_error(p, a.loc, c"extra tokens in malloc attribute") }
    target handle[Symbol] = pa_lookup(p, cc_ident(p.ctx, name))
    if target == null && bytes_eq_c(tok_spelling(p.ctx, name), c"__builtin_free") && param == 1 { return }
    if target == null || !ty_is_func(target.ty) { try pa_error(p, name.loc, c"malloc attribute names no visible function") }
    ft handle[TypeNode] = ty_node(ty_unqual(target.ty))
    if param == 0 || param > zext[u64](ft.aux2) ||
        !ty_is_ptr(tc.fn_params.p[u32, zext[usize](ft.aux1) + (param - 1)]) {
        try pa_error(p, a.loc, c"malloc deallocator index must name a pointer parameter")
    }
}

fn se_callback_index(p handle[Parser], params handle[Param], n u32, unknown bool) u32 fails {
    tok Token = p.cur
    if tok.kind == TK_IDENT {
        try pa_bump(p)
        if unknown && bytes_eq_c(tok_spelling(p.ctx, tok), c"__") { return 0 }
        name u32 = cc_ident(p.ctx, tok)
        i u32 = 1
        while params != null {
            if params.name == name { return i }
            params = params.next
            i += 1
        }
        try pa_error(p, tok.loc, c"callback attribute names no parameter")
    }
    e handle[Ast] = try pa_expression(p, 3)
    index u64 = try se_ice(p, e)
    if unknown && !ty_is_unsigned(e.ty) && index == ~0 { return 0 }
    if index == 0 || index > zext[u64](n) { try pa_error(p, tok.loc, c"callback parameter index is out of range") }
    return trunc[u32](index)
}

fn se_callback_attributes(p handle[Parser], s handle[Symbol]) void fails {
    a handle[Attr] = s.attrs
    seen bool = false
    while a != null {
        if pa_attr_name(p, a, c"callback") {
            if seen { try pa_error(p, a.loc, c"duplicate callback attribute") }
            seen = true
            if a.args_n == 0 { try pa_error(p, a.loc, c"callback attribute requires a callee parameter") }
            save ReplaySave = {}
            try pa_attr_replay(p, a, &save)
            defer { pa_attr_restore(p, &save) }
            broker handle[TypeNode] = ty_node(ty_unqual(s.ty))
            params handle[Param] = handle_from_addr(s.params)
            index u32 = try se_callback_index(p, params, broker.aux2, false)
            ptr u32 = ty_unqual(tc.fn_params.p[u32, zext[usize](broker.aux1 + index - 1)])
            if !ty_is_ptr(ptr) || !ty_is_func(ty_node(ptr).elem) {
                try pa_error(p, a.loc, c"callback callee must be a function pointer parameter")
            }
            callee handle[TypeNode] = ty_node(ty_unqual(ty_node(ptr).elem))
            if (callee.flags & TYF_VARIADIC) != 0 { try pa_error(p, a.loc, c"callback callee cannot be variadic") }
            forwarded u32 = 0
            while try pa_accept_k(p, TK_COMMA) {
                try se_callback_index(p, params, broker.aux2, true)
                forwarded += 1
            }
            if p.cur.kind != TK_EOF || forwarded != callee.aux2 {
                try pa_error(p, a.loc, c"callback argument count disagrees with its callee prototype")
            }
        }
        a = a.next
    }
}

fn se_diagnose_as_builtin(p handle[Parser], s handle[Symbol]) void fails {
    a handle[Attr] = s.attrs
    while a != null {
        if pa_attr_name(p, a, c"diagnose_as_builtin") {
            save ReplaySave = {}
            try pa_attr_replay(p, a, &save)
            defer { pa_attr_restore(p, &save) }
            t Token = try pa_take(p)
            if t.kind != TK_IDENT { try pa_error(p, t.loc, c"diagnose_as_builtin requires a builtin function") }
            name Bytes = tok_spelling(p.ctx, t)
            if bytes_starts_with(name, bytes_c(c"__builtin_")) { name = bytes_from(name, 10) }
            expected arr[3, u32] = {}
            n u32 = 3
            if feature_in(c" memcpy memmove memset ", name) {
                expected[0] = ty_ptr(TY_VOID)
                expected[1] = if bytes_eq_c(name, c"memset") { TY_INT } else { ty_ptr(ty_qual(TY_VOID, Q_CONST)) }
                expected[2] = ty_size_type()
            } else if bytes_eq_c(name, c"sscanf") {
                n = 2
                expected[0] = ty_ptr(ty_qual(TY_CHAR, Q_CONST))
                expected[1] = expected[0]
            } else {
                try pa_error(p, t.loc, c"diagnose_as_builtin names an unsupported builtin function")
            }
            ft handle[TypeNode] = ty_node(ty_unqual(s.ty))
            for i u32 in 0..n {
                try pa_expect_k(p, TK_COMMA)
                e handle[Ast] = try pa_expression(p, 3)
                index u64 = try se_ice(p, e)
                if index == 0 || index > zext[u64](ft.aux2) {
                    try pa_error(p, e.loc, c"diagnose_as_builtin parameter index is out of range")
                }
                actual u32 = tc.fn_params.p[u32, zext[usize](ft.aux1) + index - 1]
                if !ty_compatible(ty_unqual(actual), expected[zext[usize](i)]) {
                    try pa_error(p, e.loc, c"diagnose_as_builtin parameter type disagrees with the builtin")
                }
            }
            if p.cur.kind != TK_EOF {
                try pa_error(p, a.loc, c"extra arguments in diagnose_as_builtin parameter map")
            }
        }
        a = a.next
    }
}

fn se_format_attributes(p handle[Parser], s handle[Symbol]) void fails {
    ft handle[TypeNode] = ty_node(ty_unqual(s.ty))
    a handle[Attr] = s.attrs
    while a != null {
        if pa_attr_name(p, a, c"format") {
            save ReplaySave = {}
            try pa_attr_replay(p, a, &save)
            defer { pa_attr_restore(p, &save) }
            dialect Token = try pa_take(p)
            if dialect.kind != TK_IDENT { try pa_error(p, dialect.loc, c"expected format dialect identifier") }
            kind Bytes = feature_attr(tok_spelling(p.ctx, dialect))
            try pa_expect_k(p, TK_COMMA)
            fmt u64 = try se_ice(p, try pa_expression(p, 3))
            try pa_expect_k(p, TK_COMMA)
            first u64 = try se_ice(p, try pa_expression(p, 3))
            if p.cur.kind != TK_EOF { try pa_error(p, a.loc, c"extra tokens in format attribute") }
            params u64 = zext[u64](ft.aux2)
            if fmt == 0 || fmt > params { try pa_error(p, a.loc, c"format index is out of range") }
            if first != 0 {
                if bytes_eq_c(kind, c"strftime") || bytes_eq_c(kind, c"gnu_strftime") {
                    try pa_error(p, a.loc, c"strftime format requires a zero first argument index")
                }
                if first <= fmt || first > params + 1 ||
                    ((ft.flags & TYF_VARIADIC) != 0 && first != params + 1) ||
                    ((ft.flags & TYF_VARIADIC) == 0 && first > params) {
                    try pa_error(p, a.loc, c"first checked format argument is out of range")
                }
            }
            if feature_in(c" printf scanf strftime strfmon gnu_printf gnu_scanf gnu_strftime gnu_strfmon ms_printf ms_scanf ms_strftime ", kind) {
                param u32 = ty_unqual(tc.fn_params.p[u32, zext[usize](ft.aux1) + (fmt - 1)])
                elem u32 = if ty_is_ptr(param) { ty_unqual(ty_node(param).elem) } else { TY_INVALID }
                if elem != TY_CHAR && elem != TY_SCHAR && elem != TY_UCHAR {
                    try pa_error(p, a.loc, c"format parameter must point to a narrow string")
                }
            }
        }
        a = a.next
    }
}

fn se_linkage_attributes(p handle[Parser], s handle[Symbol], prior handle[Symbol],
                         definition bool, tentative bool) bool fails {
    alias bool = pa_has_attr(p, s.attrs, c"alias")
    ifunc bool = pa_has_attr(p, s.attrs, c"ifunc")
    weak bool = pa_has_attr(p, s.attrs, c"weak")
    if weak && s.linkage != 2 { try pa_error(p, s.loc, c"weak declaration requires external linkage") }
    if ifunc && (!ty_is_func(s.ty) || weak ||
        (prior != null && pa_has_attr(p, prior.attrs, c"weak"))) {
        try pa_error(p, s.loc, c"ifunc requires a non-weak function declaration")
    }
    if weak && prior != null && pa_has_attr(p, prior.attrs, c"ifunc") {
        try pa_error(p, s.loc, c"ifunc cannot be declared weak")
    }
    if alias || ifunc {
        if (alias && ifunc) || definition || (tentative && s.linkage == 2) ||
            (prior != null && (prior.defined || prior.tentative)) {
            try pa_error(p, s.loc, c"alias or ifunc conflicts with another definition")
        }
    }
    a handle[Attr] = s.attrs
    while a != null && !pa_attr_name(p, a, c"weakref") { a = a.next }
    if a != null {
        if a.args_n == 0 && !alias {
            try pa_error(p, a.loc, c"weakref requires an alias target")
        }
        if s.linkage != 1 { try pa_error(p, a.loc, c"weakref requires internal linkage") }
    }
    if definition && prior != null && pa_has_attr(p, prior.attrs, c"weakref") {
        try pa_error(p, s.loc, c"definition conflicts with an earlier weakref")
    }
    return alias || ifunc
}

fn se_declare(p handle[Parser], s handle[Symbol], definition bool, tentative bool) handle[Symbol] fails {
    prior handle[Symbol] = pa_lookup_local(p, s.name)
    if s.linkage != 0 && prior == null {
        if s.storage == SC_EXTERN || ty_is_func(s.ty) {
            visible handle[Symbol] = pa_lookup(p, s.name)
            if visible != null && visible.linkage != 0 && s.storage != SC_STATIC {
                prior = visible
                s.linkage = visible.linkage
            }
        }
        if prior == null && s.linkage == 2 {
            prior = pa_lookup_ext(p, s.name)
            if prior != null && p.scope_depth != 1 {
                if prior.thread_local != s.thread_local || !ty_compatible(prior.ty, s.ty) {
                    try pa_error(p, s.loc, c"conflicting types or storage duration for external declaration")
                }
                s.link_symbol = prior
                se_bind(p, s)
                return s
            }
        }
    }
    if prior != null && prior.linkage == 1 && s.linkage == 2 &&
        (s.storage == SC_EXTERN || ty_is_func(s.ty)) { s.linkage = 1 }
    if prior != null && ty_is_func(prior.ty) && ty_is_func(s.ty) &&
        (ty_node(ty_unqual(prior.ty)).flags & TYF_MS_ABI) != 0 &&
        !pa_has_attr(p, s.attrs, c"sysv_abi") && !pa_has_attr(p, s.attrs, c"cdecl") {
        s.ty = ty_func_ms_abi(s.ty)
    }
    if s.linkage == 1 && p.scope_depth == 1 && pa_lookup_ext(p, s.name) != null {
        try pa_error(p, s.loc, c"static declaration follows an external declaration")
    }
    attr_definition bool = try se_linkage_attributes(p, s, prior, definition, tentative)
    if definition && ty_is_func(s.ty) && s.storage == SC_EXTERN && (s.flags & 1) != 0 &&
        (pa_has_attr(p, s.attrs, c"gnu_inline") || (prior != null && pa_has_attr(p, prior.attrs, c"gnu_inline"))) {
        s.flags |= SF_GNU_EXTERN_INLINE
    }
    if prior != null {
        if prior.storage == SC_ENUMERATOR || s.storage == SC_ENUMERATOR ||
            (prior.storage == SC_TYPEDEF) != (s.storage == SC_TYPEDEF) ||
            (prior.linkage == 0 && s.storage != SC_TYPEDEF) {
            try pa_error(p, s.loc, c"redeclaration of name")
        }
        if prior.linkage != s.linkage || prior.thread_local != s.thread_local {
            try pa_error(p, s.loc, c"conflicting linkage or storage duration")
        }
        if s.storage == SC_TYPEDEF && se_variably_modified(prior.ty) {
            try pa_error(p, s.loc, c"cannot redeclare a typedef for a variably modified type")
        }
        if definition && ty_is_func(s.ty) && ty_is_func(prior.ty) &&
            (ty_node(ty_unqual(s.ty)).flags & TYF_NO_PROTO) != 0 &&
            ty_node(ty_unqual(prior.ty)).aux2 != 0 {
            try pa_error(p, s.loc, c"empty parameter definition conflicts with previous prototype")
        }
        composite u32 = ty_composite(prior.ty, s.ty)
        if composite == TY_INVALID { try pa_error(p, s.loc, c"conflicting types for declaration") }
        if definition && prior.defined &&
            ((prior.flags & SF_GNU_EXTERN_INLINE) == 0 || (s.flags & SF_GNU_EXTERN_INLINE) != 0) {
            try pa_error(p, s.loc, c"redefinition")
        }
        prior.ty = composite
        if s.attrs != null {
            prior.attrs = pa_join_attrs(s.attrs, prior.attrs)
        }
        if definition {
            prior.flags &= ~SF_GNU_EXTERN_INLINE
            prior.loc = s.loc
            prior.params = s.params
        }
        if s.asm_name != 0 { prior.asm_name = s.asm_name }
        prior.flags |= s.flags
        s = prior
    } else {
        if s.linkage == 2 { pa_bind_ext(p, s.name, s) }
        if s.linkage != 0 { vec_push[addr](&p.objects, handle_addr(s)) }
    }
    s.defined = s.defined || definition || attr_definition
    s.tentative = s.tentative || tentative
    se_bind(p, s)
    return s
}

fn se_finish_weak_aliases(p handle[Parser]) void fails {
    for i usize in 0..p.weak_aliases.n {
        w handle[WeakAlias] = vec_at(&p.weak_aliases, i)
        target handle[Symbol] = pa_lookup(p, w.target)
        if target == null || target.linkage == 0 || (!target.defined && !target.tentative) {
            try pa_error(p, w.loc, c"weak pragma alias target must be defined in this translation unit")
        }
        weak handle[Attr] = pa_tu_alloc[Attr](p)
        weak.name = sym_intern_c(&p.ctx.syms, c"weak")
        weak.loc = w.loc
        alias handle[Attr] = pa_tu_alloc[Attr](p)
        alias.name = sym_intern_c(&p.ctx.syms, c"alias")
        alias.loc = w.loc
        alias.next = weak
        spelling u32 = target.asm_name
        if spelling == 0 {
            name Buf = {}
            defer { buf_free(&name) }
            buf_u8(&name, 34)
            buf_append(&name, sym_name(&p.ctx.syms, target.name))
            buf_u8(&name, 34)
            spelling = sm_add_synth(&p.ctx.sm, buf_bytes(&name))
        } else {
            spelling = sm_add_synth(&p.ctx.sm, sym_name(&p.ctx.syms, spelling))
        }
        tok_mem addr = arena_alloc(&p.tu_arena, sizeof[Token], alignof[Token])
        tok_mem[Token] = tok_make(TK_STR, F_SYNTH, 0xFFFF, w.loc, spelling)
        alias.args_p = tok_mem
        alias.args_n = 1
        s handle[Symbol] = se_symbol(p, w.name, w.loc, target.ty, SC_EXTERN, true)
        s.linkage = 2
        s.thread_local = target.thread_local
        s.attrs = alias
        try se_declare(p, s, false, false)
    }
}

fn se_complete(ty u32) bool {
    k u8 = ty_kind(ty)
    if k == TYK_VOID || k == TYK_FUNC || ty == TY_INVALID { return false }
    n handle[TypeNode] = ty_node(ty_unqual(ty))
    if k == TYK_ARRAY { return n.aux1 != ARR_INCOMPLETE && se_complete(n.elem) }
    if k == TYK_STRUCT || k == TYK_UNION { return ty_record(n.aux1).is_complete }
    if k == TYK_ENUM { return ty_enum(n.aux1).is_complete }
    return true
}

fn se_vla(ty u32) bool {
    n handle[TypeNode] = ty_node(ty_unqual(ty))
    return n.kind == TYK_ARRAY && (n.aux1 == ARR_VLA || se_vla(n.elem))
}

fn se_variably_modified(ty u32) bool {
    while true {
        n handle[TypeNode] = ty_node(ty_unqual(ty))
        if n.kind == TYK_ARRAY && n.aux1 == ARR_VLA { return true }
        if n.kind != TYK_ARRAY && n.kind != TYK_PTR && n.kind != TYK_FUNC { return false }
        ty = n.elem
    }
}

fn se_finish_object(p handle[Parser], s handle[Symbol]) void fails {
    if !s.defined && s.tentative {
        n handle[TypeNode] = ty_node(ty_unqual(s.ty))
        if n.kind == TYK_ARRAY && n.aux1 == ARR_INCOMPLETE { s.ty = ty_array(n.elem, 1) }
    }
    if (s.defined || s.tentative) && !se_complete(s.ty) {
        try pa_error(p, s.loc, c"object has incomplete type")
    }
}

fn se_decay(ty u32) u32 {
    if ty <= TY_FLOAT128 { return ty }
    n handle[TypeNode] = ty_node(ty)
    k u8 = n.kind
    if k == TYK_PTR || k == TYK_STRUCT || k == TYK_UNION || k == TYK_ENUM { return ty }
    if k == TYK_FUNC { return ty_ptr(ty) }
    if k == TYK_ARRAY { return ty_ptr(n.elem) }
    u u32 = if k == TYK_QUAL { n.elem } else { ty }
    if u <= TY_FLOAT128 { return u }
    un handle[TypeNode] = ty_node(u)
    if un.kind == TYK_ARRAY { return ty_ptr(ty_qual(un.elem, n.flags & 15)) }
    if un.kind == TYK_FUNC { return ty_ptr(ty) }
    return u
}

fn se_null(e handle[Ast]) bool {
    return ty_is_nullptr(e.ty) || (ty_is_integer(e.ty) && (e.flags & NF_ICE) != 0 && !se_truth(e)) ||
        (ty_is_ptr(e.ty) && (e.flags & NF_ICE) != 0 && e.value == 0 && ty_node(ty_unqual(e.ty)).elem == TY_VOID)
}

fn se_array_quals(ty u32) u32 {
    quals u32 = ty_quals(ty)
    while ty_is_array(ty) {
        ty = ty_node(ty_unqual(ty)).elem
        quals |= ty_quals(ty)
    }
    return quals
}

fn se_ptr_compatible(a u32, b u32, assign bool) bool {
    x u32 = ty_node(ty_unqual(a)).elem
    y u32 = ty_node(ty_unqual(b)).elem
    if assign && (se_array_quals(y) & ~se_array_quals(x)) != 0 { return false }
    if ty_is_void(x) || ty_is_void(y) { return !ty_is_func(x) && !ty_is_func(y) }
    while ty_is_array(x) && ty_is_array(y) {
        ax handle[TypeNode] = ty_node(ty_unqual(x))
        ay handle[TypeNode] = ty_node(ty_unqual(y))
        if ax.aux1 == ARR_FIXED && ay.aux1 == ARR_FIXED && ax.arr_len != ay.arr_len { return false }
        x = ax.elem
        y = ay.elem
    }
    return ty_compatible(ty_unqual(x), ty_unqual(y))
}

fn se_require_value(p handle[Parser], e handle[Ast]) void fails {
    if ty_is_record(e.ty) && !se_complete(e.ty) {
        try pa_error(p, e.loc, c"expression uses the value of an incomplete record")
    }
}

fn se_conversion(p handle[Parser], dest u32, src handle[Ast]) void fails {
    try se_require_value(p, src)
    from u32 = se_decay(src.ty)
    if dest == TY_INVALID || from == TY_INVALID { return }
    if ty_is_arith(dest) && ty_is_arith(from) {
        try se_quad_conversion(p, src.loc, dest, from)
        return
    }
    if ty_compatible(ty_unqual(dest), ty_unqual(from)) { return }
    if ty_is_ptr(dest) && (se_null(src) || (ty_is_ptr(from) && se_ptr_compatible(dest, from, true))) { return }
    if ty_is_ptr(dest) && ty_is_ptr(from) {
        d u32 = ty_unqual(ty_node(ty_unqual(dest)).elem)
        f u32 = ty_unqual(ty_node(ty_unqual(from)).elem)
        ptr_signedness bool = ty_is_integer(d) && ty_is_integer(f) && ty_int_bits(d) == ty_int_bits(f) &&
            (ty_make_unsigned(d) == ty_make_unsigned(f) || (ty_int_bits(d) == 8 && ty_int_rank(d) == ty_int_rank(f)))
        if (ty_is_void(d) && ty_is_func(f)) || (ty_is_func(d) && ty_is_void(f)) {
            cc_diag(p.ctx, src.loc, c"warning: ", bytes_c(c"conversion between void pointer and function pointer"))
            return
        }
        if ptr_signedness || (pa_is_gnu(p) && se_ptr_compatible(dest, from, false)) {
            cc_diag(p.ctx, src.loc, c"warning: ", bytes_c(c"pointer conversion changes pointed-to qualifiers or signedness"))
            return
        }
    }
    if pa_is_gnu(p) && ty_is_vector(dest) && ty_is_vector(from) && ty_size(dest) == ty_size(from) &&
        ty_is_integer(ty_node(ty_unqual(dest)).elem) && ty_is_integer(ty_node(ty_unqual(from)).elem) { return }
    if pa_is_gnu(p) && ty_is_vector(dest) && src.kind == ND_BINARY && src.operand_ty != TY_INVALID &&
        ty_compatible(ty_unqual(dest), ty_unqual(src.operand_ty)) { return }
    if ty_is_bool(dest) && (ty_is_ptr(from) || ty_is_nullptr(from)) { return }
    try pa_error(p, src.loc, c"incompatible types in assignment or initialization")
}

fn se_require_ice(p handle[Parser], e handle[Ast]) void fails {
    if (e.flags & NF_OVERFLOW) != 0 { try pa_error(p, e.loc, c"invalid arithmetic or signed overflow in constant expression") }
    if ty_is_integer(e.ty) && (e.flags & NF_ICE) != 0 { return }
    if ty_is_integer(e.ty) && pa_is_gnu(p) && (e.flags & NF_FOLD) != 0 {
        cc_diag(p.ctx, e.loc, c"warning: ", bytes_c(c"folding an expression that is not an integer constant expression"))
    } else {
        try pa_error(p, e.loc, c"expected an integer constant expression")
    }
}

fn se_ice(p handle[Parser], e handle[Ast]) u64 fails {
    try se_require_ice(p, e)
    if ast_wide(e) != null && wi_ast_length(e) > 64 {
        try pa_error(p, e.loc, c"integer constant exceeds this context's range")
    }
    return e.value
}

fn se_scalar(p handle[Parser], e handle[Ast]) void fails {
    if !ty_is_scalar(se_decay(e.ty)) && e.ty != TY_INVALID { try pa_error(p, e.loc, c"expected a scalar expression") }
    if p.pp != null && p.pp.warning_modes.address != WARN_OFF &&
        e.kind == ND_UNARY && e.op_kind == TK_AMP &&
        e.a.kind == ND_NAME && e.a.decl != null && !pa_has_attr(p, e.a.decl.attrs, c"weak") &&
        !pa_has_attr(p, e.a.decl.attrs, c"weakref") {
        try cc_warning(p.ctx, e.loc, p.pp.warning_modes.address, c"address of object or function always evaluates to true")
    }
}

fn se_value(ty u32, value u64) u64 {
    if ty_is_bool(ty) {
        if value != 0 { return 1 }
        return 0
    }
    width u32 = ty_int_bits(ty)
    if width == 0 || width >= 64 { return value }
    full u64 = 1
    full <<= width
    low u64 = value & (full - 1)
    if !ty_is_unsigned(ty) && low >= full / 2 { return low - full }
    return low
}

fn se_int(p handle[Parser], loc u32, ty u32, value u64) handle[Ast] {
    n handle[Ast] = pa_node(p, ND_INT, loc, ty)
    n.value = se_value(ty, value)
    n.flags = NF_ICE | NF_STATIC
    return n
}

fn se_has_const_subobject(ty u32) bool {
    if (ty_quals(ty) & Q_CONST) != 0 { return true }
    n handle[TypeNode] = ty_node(ty_unqual(ty))
    if n.kind == TYK_ARRAY { return se_has_const_subobject(n.elem) }
    if n.kind == TYK_STRUCT || n.kind == TYK_UNION {
        r handle[RecordDef] = ty_record(n.aux1)
        for i u32 in 0..r.fields_len {
            if se_has_const_subobject(ty_field(r.fields_start + i).ty) { return true }
        }
    }
    return false
}

fn se_modifiable(p handle[Parser], a handle[Ast]) void fails {
    if (a.flags & NF_LVALUE) == 0 || ty_is_array(a.ty) || !se_complete(a.ty) || se_has_const_subobject(a.ty) {
        try pa_error(p, a.loc, c"expression is not a modifiable lvalue")
    }
}
