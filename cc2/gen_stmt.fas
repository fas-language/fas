// C23 -> Fir 0.3 statement & function lowering:
// blocks, declarations (locals, static locals, VLAs, cleanups), if/while/do/for,
// switch (including GNU case ranges), goto, computed goto (blockaddr/indirect_br),
// inline asm / asm goto, return, CFG reachability pruning, and function emission.


// ---------- Label & BlockAddr Management ----------

fn gen_get_label_block(lbl handle[Label]) u32 {
    // GNU __label__ declarations may reuse a spelling in sibling blocks.
    key U64Key = {addr_bits(handle_addr(lbl))}
    labels handle[GenLabelMap] = if gc.inline_frame != null { &gc.inline_frame.labels } else { &gc.labels }
    existing u32 = table_get(labels, &key) catch 0
    if existing != 0 { return existing }
    blk u32 = gen_new_block()
    _ bool = table_put(labels, &key, blk)
    return blk
}

fn gen_address_labels() handle[Vec[u32]] {
    return if gc.inline_frame != null { &gc.inline_frame.addr_taken } else { &gc.addr_taken_labels }
}

fn gen_mark_addr_taken(blk_id u32) void {
    labels handle[Vec[u32]] = gen_address_labels()
    for i usize in 0..labels.n {
        if vec_get(labels, i) == blk_id { return }
    }
    vec_push(labels, blk_id)
    vec_at(&gc.blocks, zext[usize](blk_id)).pinned = true
}

// Emit `ptr blockaddr(@fn, 00000000)` with an 8-digit placeholder patched at func_end
fn gen_emit_blockaddr(target_blk u32) u32 {
    v u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    gen_emit_val(b, v)
    buf_str(b, c" = ptradd ptr ptr blockaddr(@")
    buf_append(b, gen_sym_bytes(gc.cur_fn_name))
    buf_str(b, c", ")
    off usize = b.n
    buf_str(b, c"00000000")
    buf_str(b, c"), i64 0, 1, 0\n")
    p handle[BlockAddrPatch] = vec_add(&gc.ba_patches)
    p.blk_id = gc.cur_blk
    p.off = off
    p.target_blk = target_blk
    return v
}

// ---------- Scope Cleanups & VLA Stack Restore ----------

fn gen_call_cleanup(item handle[CleanupItem], object u32, null_v u32) void fails {
    // Clear it first: a cleanup that itself unwinds must not run again.
    if item.active_slot != 0 {
        gen_store_ty(null_v, item.active_slot, 8, true, false)
    }
    sym handle[Symbol] = item.fn_sym
    def handle[GenInlineDef] = try gen_inline_target(sym, sym.loc)
    if def != null {
        args Vec[GenInlineArg] = {}
        defer { vec_free(&args) }
        vec_push[GenInlineArg](&args, {object, ty_ptr(TY_VOID), null})
        _ u32 = try gen_inline_body(def, &args)
        return
    }
    gen_note_extern_fn(sym)
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  call (ptr) -> () ")
    gen_emit_sym_name(b, gen_sym_fir_name(sym))
    buf_u8(b, 40)
    gen_emit_val(b, object)
    buf_str(b, c")\n")
}

fn gen_run_cleanups_to(target_depth usize) void fails {
    if gc.cleanups.n <= target_depth { return }
    i usize = gc.cleanups.n
    while i > target_depth {
        i -= 1
        c handle[CleanupItem] = vec_at(&gc.cleanups, i)
        if c.fn_sym != null {
            nil u32 = if c.active_slot != 0 { gen_const_zero(ty_ptr(TY_VOID)) } else { 0 }
            try gen_call_cleanup(c, c.ptr_v, nil)
        }
    }
}

// An exceptional exit can arrive from any call or trapping instruction
// in the body. Record active objects in fixed frame slots, which remain
// addressable even if the interrupted code allocated a VLA or used alloca.
fn gen_unwind_slot(item handle[CleanupItem]) u32 {
    slot u32 = gen_alloca_entry(8, 8)
    cur u32 = gc.cur_blk
    gen_switch_block(0)
    gen_store_ty(gen_const_zero(ty_ptr(TY_VOID)), slot, 8, true, false)
    gen_switch_block(cur)
    item.active_slot = slot
    other handle[CleanupItem] = vec_add(&gc.unwind_cleanups)
    other.active_slot = slot
    other.fn_sym = item.fn_sym
    return slot
}

fn gen_unwind_landing_pad() u32 fails {
    pad u32 = gen_new_block()
    gen_switch_block(pad)
    // The SysV x86-64 unwind ABI supplies the exception object in rax.
    exception u32 = gen_new_val()
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    gen_emit_val(b, exception)
    buf_str(b, c" = asm volatile \"\" out(\"=a\" ptr)\n")
    pt u32 = ty_ptr(TY_VOID)
    nil u32 = gen_const_zero(pt)
    i usize = gc.unwind_cleanups.n
    while i > 0 {
        i -= 1
        item handle[CleanupItem] = vec_at(&gc.unwind_cleanups, i)
        object u32 = gen_load_ty(pt, item.active_slot, 8, true, false)
        active u32 = gen_icmp(c"ne", object, nil)
        call_blk u32 = gen_new_block()
        next_blk u32 = gen_new_block()
        gen_term_br(active, call_blk, next_blk)
        gen_switch_block(call_blk)
        try gen_call_cleanup(item, object, nil)
        if !gen_is_terminated() { gen_term_jump(next_blk) }
        gen_switch_block(next_blk)
    }
    gen_note_extern_fn_raw(bytes_c(c"_Unwind_Resume"), ty_func(TY_VOID, &pt, 1, false))
    resume handle[Buf] = gen_cur_buf()
    buf_str(resume, c"  call (ptr) -> () @_Unwind_Resume(")
    gen_emit_val(resume, exception)
    buf_str(resume, c")\n")
    gen_term_unreachable()
    return pad
}

fn gen_restore_vlas_to(target_depth usize) void {
    if gc.has_alloca || gc.vla_stack.n <= target_depth { return }
    v handle[VlaScope] = vec_at(&gc.vla_stack, target_depth)
    gen_stackrestore(v.sp_v)
}

fn gen_pop_scope(old_cleanups usize, old_vlas usize) void fails {
    if !gen_is_terminated() {
        try gen_run_cleanups_to(old_cleanups)
        gen_restore_vlas_to(old_vlas)
    }
    gc.cleanups.n = old_cleanups
    gc.vla_stack.n = old_vlas
}

// ---------- Local Variable Declaration ----------

// -ftrivial-auto-var-init=zero, unless the object opts out with
// __attribute__((uninitialized)).
fn gen_auto_init_zero(s handle[Symbol]) bool {
    return gc.auto_init_zero && !gen_has_attr(s.attrs, c"uninitialized")
}

fn gen_local_decl(n handle[Ast]) void fails {
    s handle[Symbol] = n.decl
    if s == null { return }
    inherited bool = (n.flags & NF_INFERRED_DECL) != 0 ||
        (n.b != null && ty_unqual(n.b.ty) == ty_unqual(s.ty))
    if (n.flags & NF_TYPEOF_EVAL) != 0 && !gen_is_terminated() { _ u32 = try gen_rvalue(n.b) }
    if s.storage == SC_TYPEDEF {
        if !inherited && !gen_is_terminated() { try gen_eval_vm_type(s.ty) }
        return
    }
    if s.storage == SC_ENUMERATOR || ty_is_func(s.ty) { return }
    if s.storage == SC_EXTERN {
        gen_note_extern_obj(s)
        return
    }
    // Static local variable: emit as a deferred local global
    if s.storage == SC_STATIC || s.thread_local {
        nid u32 = gen_make_static_local_name(s)
        if !gen_is_defined(nid) {
            gen_mark_defined(nid)
            sz u64 = ty_size(s.ty)
            al u64 = ty_align(s.ty)
            init handle[Ast] = handle_from_addr(s.value)
            sec_buf Buf = {}
            defer { buf_free(&sec_buf) }
            _ bool = gen_attr_str_arg(s.attrs, c"section", &sec_buf)
            gen_emit_discardable(gen_global_buf(), s, nid)
            gen_emit_static_init_global(gen_sym_bytes(nid), sz, al, FIR_LOCAL, FIR_VIS_DEFAULT,
                                        buf_bytes(&sec_buf), false, s.thread_local, init, s.ty)
        }
        gen_debug_local(s, 0, 0, false, nid)
        return
    }

    // VLA local variable (with per-VLA saved stack pointer so backward `goto` deallocates previous iteration!)
    if gen_type_is_vla(s.ty) {
        sp_slot u32 = gen_alloca_entry(8, 8)
        // Reset on function entry, including each execution of an inline copy.
        current u32 = gc.cur_blk
        entry u32 = if gc.inline_frame != null { gc.inline_frame.entry_block } else { 0 }
        gen_switch_block(entry)
        gen_store_ty(gen_const_zero(TY_NULLPTR), sp_slot, 8, false, false)
        gen_switch_block(current)
        // If sp_slot != null (re-entered via backward goto), restore stack before re-allocating!
        prev_sp u32 = gen_load_raw(c"ptr", sp_slot, 8, false)
        is_nonnull u32 = gen_icmp(c"ne", prev_sp, gen_const_zero(TY_NULLPTR))
        rest_blk u32 = gen_new_block()
        alloc_blk u32 = gen_new_block()
        gen_term_br(is_nonnull, rest_blk, alloc_blk)
        gen_switch_block(rest_blk)
        gen_stackrestore(prev_sp)
        gen_term_jump(alloc_blk)
        gen_switch_block(alloc_blk)

        sp u32 = gen_stacksave()
        gen_store_ty(sp, sp_slot, 8, false, false)
        vs handle[VlaScope] = vec_add(&gc.vla_stack)
        vs.sp_v = sp
        vs.scope_depth = gc.scope_depth
        sz_v u32 = if inherited { try gen_vla_type_size(s.ty) } else { try gen_eval_vla_size_and_cache(s.ty) }
        al u64 = ty_align(s.ty)
        dyn_p u32 = gen_alloca_dyn(sz_v, al)
        if s.value != null || gen_auto_init_zero(s) {
            // C23 empty initializer `T vla[n] = {};` zero-initializes the VLA,
            // as -ftrivial-auto-var-init=zero does an uninitialized one
            gen_memset_dyn(dyn_p, gen_const_i8(0), sz_v, gen_is_volatile(s.ty))
        }
        slot u32 = gen_alloca_entry(8, 8)
        gen_store_ty(dyn_p, slot, 8, false, false)
        key U64Key = {addr_bits(handle_addr(s))}
        _ bool = table_put(&gc.vla_ptrs, &key, slot)
        gen_debug_local(s, slot, 0, true, 0)
        return
    }

    // Normal automatic local variable (always allocate entry-block slot even in dead code,
    // since a goto/case label later in the block may jump into its scope!)
    if !inherited && !gen_is_terminated() { try gen_eval_vm_type(s.ty) }
    sz u64 = ty_size(s.ty)
    al u64 = ty_align(s.ty)
    slot u32 = gen_alloca_entry(sz, al)
    key U64Key = {addr_bits(handle_addr(s))}
    _ bool = table_put(&gc.locals, &key, slot)

    gen_debug_var(s, slot, 0)

    // Register GNU cleanup attribute if present
    active_slot u32 = 0
    if s.cleanup != null {
        ci handle[CleanupItem] = vec_add(&gc.cleanups)
        ci.ptr_v = slot
        ci.scope_depth = gc.scope_depth
        ci.fn_sym = handle_from_addr(s.cleanup)
        if gc.exceptions { active_slot = gen_unwind_slot(ci) }
    }

    init handle[Ast] = handle_from_addr(s.value)
    if init != null && !gen_is_terminated() {
        try gen_auto_init(slot, s.ty, init, true)
    } else if init == null && !gen_is_terminated() && sz > 0 && gen_auto_init_zero(s) {
        // Each time the declaration is reached, like Clang: a jump past it
        // leaves the object indeterminate.
        gen_memset_const(slot, 0, sz, gen_is_volatile(s.ty))
    }
    if active_slot != 0 && !gen_is_terminated() { gen_store_ty(slot, active_slot, 8, true, false) }
}

// ---------- Switch Statement Helpers ----------

struct SwitchCase {
    lo u64
    hi u64
    is_range bool
    _pad u8
    _pad2 u16
    blk_id u32
    ast handle[Ast]
}

struct SwitchInfo {
    cases Vec[SwitchCase]
    default_blk u32
    has_default bool
    _pad u8
    _pad2 u16
    default_ast handle[Ast]
    case_map Table[U64Key, u32, gen_u64_hash, gen_u64_eq]
}

fn gen_collect_switch_cases(n handle[Ast], sw handle[SwitchInfo]) void {
    if n == null { return }
    if n.kind == ND_BLOCK {
        s handle[Ast] = n.a
        while s != null {
            gen_collect_switch_cases(s, sw)
            s = s.next
        }
        return
    }
    if n.kind != ND_STMT { return }
    if n.op == 0 { return }
    kw Bytes = sym_name(&gc.p.ctx.syms, n.op)
    // Do NOT descend into nested switch statements!
    if bytes_eq_c(kw, c"switch") { return }
    if bytes_eq_c(kw, c"case") {
        blk u32 = gen_new_block()
        sc handle[SwitchCase] = vec_add(&sw.cases)
        sc.lo = n.a.value
        sc.hi = if n.b != null { n.b.value } else { n.a.value }
        sc.is_range = n.b != null && sc.hi != sc.lo
        sc.blk_id = blk
        sc.ast = n
        key U64Key = {addr_bits(handle_addr(n))}
        _ bool = table_put(&sw.case_map, &key, blk)
        gen_collect_switch_cases(ast_c(n), sw)
        return
    }
    if bytes_eq_c(kw, c"default") {
        blk u32 = gen_new_block()
        sw.has_default = true
        sw.default_blk = blk
        sw.default_ast = n
        key U64Key = {addr_bits(handle_addr(n))}
        _ bool = table_put(&sw.case_map, &key, blk)
        gen_collect_switch_cases(ast_c(n), sw)
        return
    }
    if bytes_eq_c(kw, c"if") {
        gen_collect_switch_cases(n.b, sw)
        gen_collect_switch_cases(ast_c(n), sw)
    } else if bytes_eq_c(kw, c"while") || bytes_eq_c(kw, c"do") {
        gen_collect_switch_cases(n.b, sw)
    } else if bytes_eq_c(kw, c"for") {
        gen_collect_switch_cases(ast_d(n), sw)
    } else if bytes_eq_c(kw, c":") {
        gen_collect_switch_cases(n.a, sw)
    }
}

thread var cur_switch handle[SwitchInfo] = null

fn gen_switch_dispatch(sw handle[SwitchInfo], key_ty u32, key_v u32, def_target u32) void {
    // Emit range checks first (if any GNU `case lo ... hi` exist)
    has_ranges bool = false
    for i usize in 0..sw.cases.n {
        if vec_at(&sw.cases, i).is_range { has_ranges = true; break }
    }
    if has_ranges {
        is_uns bool = ty_is_unsigned(key_ty)
        for i usize in 0..sw.cases.n {
            sc handle[SwitchCase] = vec_at(&sw.cases, i)
            if !sc.is_range { continue }
            lo_v u32 = gen_const_int(key_ty, sc.lo)
            hi_v u32 = gen_const_int(key_ty, sc.hi)
            c1 u32 = gen_icmp(if is_uns { c"uge" } else { c"sge" }, key_v, lo_v)
            c2 u32 = gen_icmp(if is_uns { c"ule" } else { c"sle" }, key_v, hi_v)
            in_r u32 = gen_binop_raw(c"and", c"i1", c1, c2)
            next_chk u32 = gen_new_block()
            gen_term_br(in_r, sc.blk_id, next_chk)
            gen_switch_block(next_chk)
        }
    }

    // Emit Fir `switch` terminator for all single-value cases
    blk handle[GenBlock] = gen_cur_block()
    blk.terminated = true
    gen_add_succ(blk, def_target)
    buf_str(&blk.term, c"  switch ")
    gen_emit_val(&blk.term, key_v)
    buf_str(&blk.term, c", ")
    gen_emit_lbl(&blk.term, def_target)
    buf_str(&blk.term, c", [")
    first bool = true
    is_signed bool = ty_is_signed(key_ty)
    bits u32 = ty_int_bits(key_ty)
    for i usize in 0..sw.cases.n {
        sc handle[SwitchCase] = vec_at(&sw.cases, i)
        if sc.is_range { continue }
        if !first { buf_str(&blk.term, c", ") }
        first = false
        gen_add_succ(blk, sc.blk_id)
        // Print key matching signedness & width (including >64-bit _BitInt cases!)
        if bits > 64 && sc.ast != null && sc.ast.a != null && ast_wide(sc.ast.a) != null {
            words u32 = (bits + 31) / 32
            limbs addr = ast_wide(sc.ast.a)
            buf_str(&blk.term, c"0x")
            started bool = false
            wi u32 = words
            while wi > 0 {
                wi -= 1
                w u32 = limbs[u32, zext[usize](wi)]
                if !started {
                    if w != 0 || wi == 0 {
                        buf_hex(&blk.term, zext[u64](w), 1)
                        started = true
                    }
                } else {
                    buf_hex(&blk.term, zext[u64](w), 8)
                }
            }
        } else if is_signed && bits <= 64 {
            sv i64 = bitcast[i64](sc.lo)
            if bits < 64 {
                sh u32 = 64 - bits
                sv = (sv << sh) >> sh
            }
            buf_dec_i64(&blk.term, sv)
        } else {
            buf_str(&blk.term, c"0x")
            buf_hex(&blk.term, sc.lo, 1)
        }
        buf_str(&blk.term, c": ")
        gen_emit_lbl(&blk.term, sc.blk_id)
    }
    buf_str(&blk.term, c"]\n")

}

fn gen_switch_stmt(n handle[Ast]) void fails {
    key_ty u32 = ty_integer_promote(ty_unqual(n.a.ty))
    sw SwitchInfo = {}
    defer { vec_free(&sw.cases); table_free(&sw.case_map) }
    gen_collect_switch_cases(n.b, &sw)

    end_blk u32 = gen_new_block()
    def_target u32 = if sw.has_default { sw.default_blk } else { end_blk }

    // Emit only the reachable dispatch edge for a constant key. Still
    // lower the body so fallthrough and jumps to C labels work normally.
    folded handle[Ast] = try gen_inline_fold(n.a, false)
    if gen_is_terminated() {
        // A C label in the body may still be reached by a goto.
    } else if ty_int_bits(key_ty) <= 64 && (folded.flags & (NF_ICE | NF_OVERFLOW)) == NF_ICE {
        key u64 = se_value(key_ty, folded.value)
        target u32 = def_target
        for i usize in 0..sw.cases.n {
            sc handle[SwitchCase] = vec_at(&sw.cases, i)
            lo u64 = se_value(key_ty, sc.lo)
            hi u64 = se_value(key_ty, sc.hi)
            matches bool = if !sc.is_range { key == lo }
                           else if ty_is_unsigned(key_ty) { key >= lo && key <= hi }
                           else { bitcast[i64](key) >= bitcast[i64](lo) && bitcast[i64](key) <= bitcast[i64](hi) }
            if matches { target = sc.blk_id; break }
        }
        gen_term_jump(target)
    } else {
        raw_v u32 = try gen_rvalue(n.a)
        if !gen_is_terminated() {
            gen_switch_dispatch(&sw, key_ty, gen_convert(raw_v, n.a.ty, key_ty), def_target)
        }
    }

    // Push switch frame for `break`
    lf handle[LoopFrame] = vec_add(&gc.loops)
    lf.break_blk = end_blk
    lf.continue_blk = 0
    lf.cleanup_depth = gc.cleanups.n
    lf.vla_depth = gc.vla_stack.n
    lf.is_switch = true

    saved_sw handle[SwitchInfo] = cur_switch
    cur_switch = &sw
    body_blk u32 = gen_new_block()
    gen_switch_block(body_blk)
    vec_at(&gc.blocks, zext[usize](body_blk)).terminated = true // unreachable until a case/default/label
    try gen_stmt(n.b)
    if !gen_is_terminated() { gen_term_jump(end_blk) }
    cur_switch = saved_sw
    gc.loops.n -= 1

    gen_switch_block(end_blk)
}

// ---------- Inline Asm Lowering ----------

struct GenAsmInput {
    operand handle[Ast]
    ty u32
    val_id u32
    integer bool
    integer_value u64
    address ConstAddr
}

// Immediates must reach Fir as constants so instruction selection can use
// the literal or the symbol and addend directly in the asm template.
fn gen_emit_asm_input(b handle[Buf], input handle[GenAsmInput]) void {
    gen_emit_fir_ty(b, input.ty)
    buf_u8(b, 32)
    if input.address.ok {
        gen_emit_sym_name(b, gen_sym_bytes(input.address.sym_id))
        if input.address.addend != 0 {
            buf_str(b, c" + ")
            buf_dec_i64(b, input.address.addend)
        }
    } else if input.integer {
        width u32 = ty_int_bits(input.ty)
        raw u64 = input.integer_value
        value u64 = if width < 64 { raw & ((1 << width) - 1) } else { raw }
        buf_str(b, c"0x")
        buf_hex(b, value, 1)
    } else { gen_emit_val(b, input.val_id) }
}

// Tied GP operands share a register even if the C lvalues have different
// widths. Fir represents both sides at the wider type and narrows the
// result only when storing back to C.
fn gen_asm_gp_width(t u32) u32 {
    if ty_is_ptr(t) { return 64 }
    return if ty_is_integer(t) { ty_int_bits(t) } else { 0 }
}

fn gen_store_asm_output(value u32, ptr u32, asm_ty u32, operand handle[Ast]) void {
    expr handle[Ast] = operand.b
    t u32 = expr.ty
    align u64 = ty_align(t)
    if expr.kind == ND_MEMBER && expr.a != null {
        parent_align u64 = ty_align(expr.a.ty)
        if parent_align < align { align = parent_align }
    }
    gen_store_ty(gen_convert(value, asm_ty, t), ptr, align, gen_is_volatile(t), false)
}

// A GNU local register binding constrains direct extended-asm operands.
// The ordinary C value still lives in its normal local slot.
fn gen_asm_constraint(operand handle[Ast], out handle[Buf]) void {
    if operand.a == null { return }
    gen_decode_string_ast(operand.a, out, false)
    expr handle[Ast] = operand.b
    if expr.kind != ND_NAME { return }
    decl handle[Symbol] = expr.decl
    if decl == null || decl.storage != SC_REGISTER || decl.asm_name == 0 { return }
    n usize = 0
    while n < out.n {
        ch u8 = out.p[u8, n]
        if ch != 61 && ch != 43 && ch != 38 && ch != 37 { break }
        n += 1
    }
    if n + 1 != out.n || (out.p[u8, n] != 114 && out.p[u8, n] != 103) { return }
    buf_truncate(out, n)
    buf_u8(out, 123)
    if gen_stack_pointer_symbol(decl) { buf_str(out, c"rsp") }
    else { gen_decode_string_piece(sym_name(&gc.p.ctx.syms, decl.asm_name), 1, out) }
    buf_u8(out, 125)
}

fn gen_asm_memory_input(cs Bytes) bool {
    return cs.n > 0 && (cs.p[u8] == 109 || cs.p[u8] == 111 || cs.p[u8] == 86)
}

fn gen_inline_asm(n handle[Ast]) void fails {
    is_goto bool = (n.flags & 1) != 0
    is_vol bool = (n.flags & 2) != 0 || n.b == null
    tmpl Buf = {}
    defer { buf_free(&tmpl) }
    if n.a != null {
        if (n.flags & NF_ASM_EXTENDED) != 0 { gen_decode_string_ast(n.a, &tmpl, false) }
        else {
            // Basic GNU asm is literal text. Escape Fir's operand and
            // dialect markers without changing the assembler's input.
            literal Buf = {}
            defer { buf_free(&literal) }
            gen_decode_string_ast(n.a, &literal, false)
            for i usize in 0..literal.n {
                c u8 = literal.p[u8, i]
                if c == 37 || c == 123 || c == 124 || c == 125 { buf_u8(&tmpl, 37) }
                buf_u8(&tmpl, c)
            }
        }
    }

    // Evaluate output operand lvalues and input operand rvalues
    out_ptrs Vec[u32] = {}
    out_tids Vec[u32] = {}
    out_res_vs Vec[u32] = {}
    out_is_mem Vec[u8] = {}
    out_is_rw Vec[u8] = {}
    out_old_vs Vec[u32] = {}
    out_nodes Vec[addr] = {}
    defer {
        vec_free(&out_ptrs); vec_free(&out_tids); vec_free(&out_res_vs)
        vec_free(&out_is_mem); vec_free(&out_is_rw); vec_free(&out_old_vs); vec_free(&out_nodes)
    }
    o handle[Ast] = n.b
    while o != null {
        cb Buf = {}
        gen_asm_constraint(o, &cb)
        cs Bytes = buf_bytes(&cb)
        has_m bool = false
        has_r bool = false
        is_rw bool = cs.n > 0 && cs.p[u8] == 43 // '+'
        for k usize in 0..cs.n {
            ch u8 = cs.p[u8, k]
            if ch == 123 { has_r = true; break }
            if ch == 109 || ch == 111 || ch == 86 { has_m = true }
            if ch == 114 || ch == 113 || ch == 81 || ch == 82 || ch == 97 || ch == 98 ||
               ch == 99 || ch == 100 || ch == 83 || ch == 68 || ch == 65 || ch == 120 || ch == 103 { has_r = true }
        }
        mem_only bool = has_m && !has_r
        is_sp bool = o.b.kind == ND_NAME && gen_stack_pointer_symbol(o.b.decl)
        if is_sp && (!is_rw || !bytes_starts_with(cs, bytes_c(c"+{rsp}"))) {
            try pa_error(gc.p, o.loc, c"the stack pointer requires a read-write register constraint")
        }
        buf_free(&cb)
        ptr_v u32 = if is_sp { 0 } else { try gen_lvalue(o.b) }
        vec_push(&out_ptrs, ptr_v)
        vec_push(&out_tids, o.b.ty)
        vec_push(&out_is_mem, if mem_only { 1 } else { 0 })
        vec_push(&out_is_rw, if is_rw { 1 } else { 0 })
        vec_push(&out_nodes, handle_addr(o))
        if is_rw && !mem_only {
            al_rw u64 = ty_align(o.b.ty)
            if o.b.kind == ND_MEMBER && o.b.a != null {
                pal u64 = ty_align(o.b.a.ty)
                if pal < al_rw { al_rw = pal }
            }
            old u32 = if is_sp { gen_const_zero(o.b.ty) } else { gen_load_ty(o.b.ty, ptr_v, al_rw, false, false) }
            vec_push(&out_old_vs, old)
        } else {
            vec_push(&out_old_vs, 0)
        }
        if !mem_only {
            vec_push(&out_res_vs, gen_new_val())
        } else {
            vec_push(&out_res_vs, 0)
        }
        o = o.next
    }

    inputs Vec[GenAsmInput] = {}
    defer { vec_free(&inputs) }
    inp handle[Ast] = ast_c(n)
    while inp != null {
        cb Buf = {}
        gen_asm_constraint(inp, &cb)
        cs Bytes = buf_bytes(&cb)
        is_m bool = gen_asm_memory_input(cs)
        tied_idx usize = out_tids.n
        if cs.n > 0 && cs.p[u8] >= 48 && cs.p[u8] <= 57 {
            tied_idx = bytes_to_u64(cs) catch out_tids.n
        } else if cs.n > 2 && cs.p[u8] == 91 && cs.p[u8, cs.n - 1] == 93 {
            name Bytes = bytes_sub(cs, 1, cs.n - 2)
            for i usize in 0..out_nodes.n {
                node handle[Ast] = handle_from_addr(vec_get(&out_nodes, i))
                if node.op != 0 && bytes_eq(name, sym_name(&gc.p.ctx.syms, node.op)) {
                    tied_idx = i
                    break
                }
            }
        }
        is_sp bool = bytes_eq_c(cs, c"{rsp}")
        imm_symbol bool = bytes_eq_c(cs, c"i")
        imm_integer bool = imm_symbol || bytes_eq_c(cs, c"n")
        buf_free(&cb)
        input handle[GenAsmInput] = vec_add(&inputs)
        input.operand = inp
        // Value operands decay, so an array designator such as a string
        // literal can use the same symbolic immediate path as pointers.
        input.ty = if is_m { ty_ptr(inp.b.ty) } else { se_decay(inp.b.ty) }
        at_entry bool = gc.inline_frame != null && gc.inline_frame.entry_asm == n
        expr handle[Ast] = if imm_integer { try gen_inline_fold(inp.b, at_entry) } else { inp.b }
        input.integer_value = expr.value
        width u32 = if ty_is_integer(input.ty) { ty_int_bits(input.ty) } else { 0 }
        input.integer = imm_integer && width > 0 && width <= 64 &&
            (expr.flags & NF_INT_VALUE) != 0 && (expr.flags & NF_OVERFLOW) == 0
        if !input.integer && imm_symbol && (ty_is_ptr(input.ty) || ty_is_func(input.ty) || width == 64) &&
            (expr.flags & NF_STATIC) != 0 {
            if !(gen_eval_const_addr(expr, &input.address)) || input.address.is_blockaddr {
                input.address.ok = false
            }
        }
        if !input.integer && !input.address.ok {
            input.val_id = if is_sp { gen_const_zero(input.ty) }
                           else if is_m { try gen_lvalue(inp.b) }
                           else { try gen_rvalue(inp.b) }
        }
        if !is_m && tied_idx < out_tids.n {
            result_ty u32 = vec_get(&out_tids, tied_idx)
            input_width u32 = gen_asm_gp_width(input.ty)
            result_width u32 = gen_asm_gp_width(result_ty)
            if result_width != 0 && result_width < input_width && input_width <= 64 {
                if vec_get(&out_is_rw, tied_idx) != 0 {
                    out_old_vs.p[u32, tied_idx] = gen_convert(vec_get(&out_old_vs, tied_idx), result_ty, input.ty)
                }
                out_tids.p[u32, tied_idx] = input.ty
            } else if ty_unqual(result_ty) != ty_unqual(input.ty) {
                input.val_id = gen_convert(input.val_id, input.ty, result_ty)
                input.ty = result_ty
            }
        }
        inp = inp.next
    }

    if gen_is_terminated() { return }
    if is_goto {
        // Rewrite `%l[name]` references in template to `%l<inputs.n + K>` (Fir only supports numbered `%lN`)
        goto_tmpl Buf = {}
        defer { buf_free(&goto_tmpl) }
        ti usize = 0
        while ti < tmpl.n {
            if ti + 3 < tmpl.n && tmpl.p[u8, ti] == 37 && tmpl.p[u8, ti + 1] == 108 && tmpl.p[u8, ti + 2] == 91 {
                // Find closing ']'
                tj usize = ti + 3
                while tj < tmpl.n && tmpl.p[u8, tj] != 93 { tj += 1 }
                if tj < tmpl.n {
                    lname Bytes = bytes(tmpl.p + ti + 3, tj - (ti + 3))
                    lidx usize = 0
                    found_l bool = false
                    gl_s handle[Ast] = handle_from_addr(ast_extra(n))
                    while gl_s != null {
                        lbl_s handle[Label] = handle_from_addr(ast_extra(gl_s))
                        if lbl_s != null && bytes_eq(sym_name(&gc.p.ctx.syms, lbl_s.name), lname) {
                            found_l = true
                            break
                        }
                        lidx += 1
                        gl_s = gl_s.next
                    }
                    if found_l {
                        buf_str(&goto_tmpl, c"%l")
                        buf_dec_u64(&goto_tmpl, out_nodes.n + inputs.n + lidx)
                        ti = tj + 1
                        continue
                    }
                }
            }
            buf_u8(&goto_tmpl, tmpl.p[u8, ti])
            ti += 1
        }
        has_reg_out bool = false
        for i usize in 0..out_res_vs.n {
            if vec_get(&out_res_vs, i) != 0 { has_reg_out = true }
        }
        fall_blk u32 = gen_new_block()
        // Collect target blocks (use trampoline blocks when there are register outputs so
        // outputs are stored to their C lvalues on indirect edges too, per C23 / Clang 16+).
        goto_tramps Vec[u32] = {}
        goto_reals Vec[u32] = {}
        defer { vec_free(&goto_tramps); vec_free(&goto_reals) }
        gl_c handle[Ast] = handle_from_addr(ast_extra(n))
        while gl_c != null {
            lbl_c handle[Label] = handle_from_addr(ast_extra(gl_c))
            real_blk u32 = gen_get_label_block(lbl_c)
            if has_reg_out {
                tb u32 = gen_new_block()
                vec_push(&goto_tramps, tb)
                vec_push(&goto_reals, real_blk)
            } else {
                vec_push(&goto_tramps, real_blk)
            }
            gl_c = gl_c.next
        }
        // Allocating label and trampoline blocks can grow gc.blocks.
        blk handle[GenBlock] = gen_cur_block()
        blk.terminated = true
        gen_add_succ(blk, fall_blk)
        for i usize in 0..goto_tramps.n {
            gen_add_succ(blk, vec_get(&goto_tramps, i))
        }
        b handle[Buf] = &blk.term
        buf_str(b, c"  ")
        if has_reg_out {
            first_r bool = true
            for i usize in 0..out_res_vs.n {
                rv u32 = vec_get(&out_res_vs, i)
                if rv != 0 {
                    if !first_r { buf_str(b, c", ") }
                    first_r = false
                    gen_emit_val(b, rv)
                }
            }
            buf_str(b, c" = ")
        }
        buf_str(b, c"asm_goto volatile ")
        fir_emit_quoted_bytes(b, goto_tmpl.p, goto_tmpl.n)
        if out_nodes.n > 0 {
            buf_str(b, c" out(")
            for i usize in 0..out_nodes.n {
                if i > 0 { buf_str(b, c", ") }
                onode handle[Ast] = handle_from_addr(vec_get(&out_nodes, i))
                cb Buf = {}
                gen_asm_constraint(onode, &cb)
                if onode.op != 0 {
                    buf_u8(b, 91); buf_append(b, sym_name(&gc.p.ctx.syms, onode.op)); buf_str(b, c"] ")
                }
                fir_emit_quoted_bytes(b, cb.p, cb.n)
                buf_free(&cb)
                buf_u8(b, 32)
                gen_emit_fir_ty(b, vec_get(&out_tids, i))
                if vec_get(&out_is_mem, i) != 0 {
                    buf_u8(b, 32)
                    gen_emit_val(b, vec_get(&out_ptrs, i))
                } else if vec_get(&out_is_rw, i) != 0 {
                    buf_u8(b, 32)
                    gen_emit_val(b, vec_get(&out_old_vs, i))
                }
            }
            buf_u8(b, 41)
        }
        if inputs.n > 0 {
            buf_str(b, c" in(")
            for i usize in 0..inputs.n {
                if i > 0 { buf_str(b, c", ") }
                input handle[GenAsmInput] = vec_at(&inputs, i)
                onode handle[Ast] = input.operand
                cb Buf = {}
                gen_asm_constraint(onode, &cb)
                if onode.op != 0 {
                    buf_u8(b, 91); buf_append(b, sym_name(&gc.p.ctx.syms, onode.op)); buf_str(b, c"] ")
                }
                fir_emit_quoted_bytes(b, cb.p, cb.n)
                buf_free(&cb)
                buf_u8(b, 32)
                gen_emit_asm_input(b, input)
            }
            buf_u8(b, 41)
        }
        if ast_d(n) != null {
            buf_str(b, c" clobber(")
            cl handle[Ast] = ast_d(n)
            first_c bool = true
            while cl != null {
                if !first_c { buf_str(b, c", ") }
                first_c = false
                cb Buf = {}
                gen_decode_string_ast(cl, &cb, false)
                fir_emit_quoted_bytes(b, cb.p, cb.n)
                buf_free(&cb)
                cl = cl.next
            }
            buf_u8(b, 41)
        }
        buf_u8(b, 32)
        gen_emit_lbl(b, fall_blk)
        buf_str(b, c" [")
        for i usize in 0..goto_tramps.n {
            if i > 0 { buf_str(b, c", ") }
            gen_emit_lbl(b, vec_get(&goto_tramps, i))
        }
        buf_str(b, c"]\n")
        if has_reg_out {
            for i usize in 0..goto_tramps.n {
                gen_switch_block(vec_get(&goto_tramps, i))
                for j usize in 0..out_res_vs.n {
                    rv u32 = vec_get(&out_res_vs, j)
                    if rv != 0 && vec_get(&out_ptrs, j) != 0 {
                        onode handle[Ast] = handle_from_addr(vec_get(&out_nodes, j))
                        gen_store_asm_output(rv, vec_get(&out_ptrs, j), vec_get(&out_tids, j), onode)
                    }
                }
                gen_term_jump(vec_get(&goto_reals, i))
            }
        }
        gen_switch_block(fall_blk)
        if has_reg_out {
            for j usize in 0..out_res_vs.n {
                rv u32 = vec_get(&out_res_vs, j)
                if rv != 0 && vec_get(&out_ptrs, j) != 0 {
                    onode handle[Ast] = handle_from_addr(vec_get(&out_nodes, j))
                    gen_store_asm_output(rv, vec_get(&out_ptrs, j), vec_get(&out_tids, j), onode)
                }
            }
        }
        return
    }

    // Normal `asm`
    b handle[Buf] = gen_cur_buf()
    buf_str(b, c"  ")
    n_res usize = 0
    for i usize in 0..out_res_vs.n {
        rv u32 = vec_get(&out_res_vs, i)
        if rv != 0 {
            if n_res > 0 { buf_str(b, c", ") }
            gen_emit_val(b, rv)
            n_res += 1
        }
    }
    if n_res > 0 { buf_str(b, c" = ") }
    buf_str(b, if is_vol { c"asm volatile " } else { c"asm " })
    fir_emit_quoted_bytes(b, tmpl.p, tmpl.n)
    // Count tied inputs generated from `+` read-write register outputs (appended after explicit inputs, per GCC)
    n_rw_tied usize = 0
    for i usize in 0..out_nodes.n {
        if vec_get(&out_is_rw, i) != 0 && vec_get(&out_is_mem, i) == 0 {
            n_rw_tied += 1
        }
    }
    if out_nodes.n > 0 {
        buf_str(b, c" out(")
        for i usize in 0..out_nodes.n {
            if i > 0 { buf_str(b, c", ") }
            onode handle[Ast] = handle_from_addr(vec_get(&out_nodes, i))
            cb Buf = {}
            gen_asm_constraint(onode, &cb)
            // Split `+c` register output into `=c` + tied input `"i"` so GCC operand numbering matches
            if vec_get(&out_is_rw, i) != 0 && vec_get(&out_is_mem, i) == 0 && cb.n > 0 && cb.p[u8] == 43 {
                cb.p[u8] = 61 // '='
            }
            if onode.op != 0 {
                buf_u8(b, 91); buf_append(b, sym_name(&gc.p.ctx.syms, onode.op)); buf_str(b, c"] ")
            }
            fir_emit_quoted_bytes(b, cb.p, cb.n)
            buf_free(&cb)
            buf_u8(b, 32)
            if vec_get(&out_is_mem, i) != 0 {
                buf_str(b, c"ptr ")
                gen_emit_val(b, vec_get(&out_ptrs, i))
            } else {
                gen_emit_fir_ty(b, vec_get(&out_tids, i))
            }
        }
        buf_u8(b, 41)
    }
    if inputs.n > 0 || n_rw_tied > 0 {
        buf_str(b, c" in(")
        in_emitted usize = 0
        for i usize in 0..inputs.n {
            if in_emitted > 0 { buf_str(b, c", ") }
            in_emitted += 1
            input handle[GenAsmInput] = vec_at(&inputs, i)
            onode handle[Ast] = input.operand
            cb Buf = {}
            gen_asm_constraint(onode, &cb)
            if onode.op != 0 {
                buf_u8(b, 91); buf_append(b, sym_name(&gc.p.ctx.syms, onode.op)); buf_str(b, c"] ")
            }
            fir_emit_quoted_bytes(b, cb.p, cb.n)
            buf_free(&cb)
            buf_u8(b, 32)
            gen_emit_asm_input(b, input)
        }
        for i usize in 0..out_nodes.n {
            if vec_get(&out_is_rw, i) != 0 && vec_get(&out_is_mem, i) == 0 {
                if in_emitted > 0 { buf_str(b, c", ") }
                in_emitted += 1
                buf_u8(b, 34)
                buf_dec_u64(b, i)
                buf_str(b, c"\" ")
                gen_emit_fir_ty(b, vec_get(&out_tids, i))
                buf_u8(b, 32)
                gen_emit_val(b, vec_get(&out_old_vs, i))
            }
        }
        buf_u8(b, 41)
    }
    if ast_d(n) != null {
        buf_str(b, c" clobber(")
        cl handle[Ast] = ast_d(n)
        first_c bool = true
        while cl != null {
            if !first_c { buf_str(b, c", ") }
            first_c = false
            cb Buf = {}
            gen_decode_string_ast(cl, &cb, false)
            fir_emit_quoted_bytes(b, cb.p, cb.n)
            buf_free(&cb)
            cl = cl.next
        }
        buf_u8(b, 41)
    }
    buf_u8(b, 10)
    // Store register output results back to their lvalues
    for i usize in 0..out_res_vs.n {
        rv u32 = vec_get(&out_res_vs, i)
        if rv != 0 && vec_get(&out_ptrs, i) != 0 {
            onode handle[Ast] = handle_from_addr(vec_get(&out_nodes, i))
            gen_store_asm_output(rv, vec_get(&out_ptrs, i), vec_get(&out_tids, i), onode)
        }
    }
}

// ---------- Statement Lowering ----------

fn gen_stmt_expr(n handle[Ast]) u32 fails {
    old_cleanups usize = gc.cleanups.n
    old_vlas usize = gc.vla_stack.n
    gc.scope_depth += 1
    res u32 = gen_const_i32(0)
    s handle[Ast] = n.a
    while s != null {
        if s.next == null && s.kind == ND_STMT && s.op == 0 && s.a != null && !ty_is_void(n.ty) {
            res = try gen_rvalue(s.a)
        } else {
            try gen_stmt(s)
        }
        s = s.next
    }
    gc.scope_depth -= 1
    try gen_pop_scope(old_cleanups, old_vlas)
    return res
}

fn gen_stmt(n handle[Ast]) void fails {
    if n == null { return }
    enclosing_scope u32 = gc.debug.scope
    enclosing_loc u32 = gc.debug.loc
    if gc.debug.enabled {
        if n.kind == ND_BLOCK { gc.debug.scope = gen_debug_scope(enclosing_scope) }
        gc.debug.loc = gen_debug_loc(n.loc, gc.debug.scope)
    }
    defer { gc.debug.scope = enclosing_scope; gc.debug.loc = enclosing_loc }

    if n.kind == ND_BLOCK {
        if !gen_is_terminated() { try gen_asm_block_locals(n) }
        old_cleanups usize = gc.cleanups.n
        old_vlas usize = gc.vla_stack.n
        gc.scope_depth += 1
        s handle[Ast] = n.a
        while s != null {
            try gen_stmt(s)
            s = s.next
        }
        gc.scope_depth -= 1
        try gen_pop_scope(old_cleanups, old_vlas)
        return
    }
    if n.kind == ND_DECL {
        try gen_local_decl(n)
        return
    }
    if n.kind == ND_ASM {
        if !gen_is_terminated() { try gen_inline_asm(n) }
        return
    }
    if n.kind != ND_STMT {
        if !gen_is_terminated() { _ u32 = try gen_rvalue(n) }
        return
    }

    // Expression statement
    if n.op == 0 {
        if !gen_is_terminated() && n.a != null {
            _ u32 = try gen_rvalue(n.a)
        }
        return
    }

    kw Bytes = sym_name(&gc.p.ctx.syms, n.op)

    // Labels, case, default can make control flow live again even after a terminator!
    if bytes_eq_c(kw, c":") {
        lbl handle[Label] = handle_from_addr(ast_extra(n))
        if lbl != null {
            lbl_blk u32 = gen_get_label_block(lbl)
            if !gen_is_terminated() { gen_term_jump(lbl_blk) }
            gen_switch_block(lbl_blk)
        }
        if n.a != null { try gen_stmt(n.a) }
        return
    }
    if bytes_eq_c(kw, c"case") || bytes_eq_c(kw, c"default") {
        if cur_switch != null {
            key U64Key = {addr_bits(handle_addr(n))}
            cblk u32 = table_get(&cur_switch.case_map, &key) catch 0
            if cblk != 0 {
                if !gen_is_terminated() { gen_term_jump(cblk) }
                gen_switch_block(cblk)
            }
        }
        if ast_c(n) != null { try gen_stmt(ast_c(n)) }
        return
    }

    // All other statements are skipped if current block is already terminated
    // EXCEPT compound statements that might contain labels or switch cases!
    if bytes_eq_c(kw, c"if") {
        // Avoid emitting references from an untaken constant branch. A goto
        // or enclosing switch can still enter it independently of the test,
        // so only drop a branch that defines no label. Ask the branch itself:
        // the parser's label list is already cleared when a body waits in
        // the translation unit is lowered (scoped_guard jumps into `if (0)`).
        cond handle[Ast] = try gen_inline_fold(n.a, false)
        if !gen_is_terminated() && cur_switch == null &&
            ty_is_integer(cond.ty) && (cond.flags & (NF_ICE | NF_OVERFLOW)) == NF_ICE &&
            !gen_defines_label(if se_truth(cond) { ast_c(n) } else { n.b }) {
            try gen_stmt(if se_truth(cond) { n.b } else { ast_c(n) })
            return
        }
        if gen_is_terminated() {
            // Even when `if` is unreachable, a `goto` or `case` label may jump into
            // `then` or `else`; keep them separated so `then` does not fall into `else`!
            end_blk u32 = gen_new_block()
            try gen_stmt(n.b)
            if !gen_is_terminated() { gen_term_jump(end_blk) }
            if ast_c(n) != null {
                dead_else u32 = gen_new_block()
                gen_switch_block(dead_else)
                vec_at(&gc.blocks, zext[usize](dead_else)).terminated = true
                try gen_stmt(ast_c(n))
                if !gen_is_terminated() { gen_term_jump(end_blk) }
            }
            gen_switch_block(end_blk)
            return
        }
        cv u32 = try gen_rvalue(n.a)
        cb u32 = gen_to_bool(cv, n.a.ty)
        t_blk u32 = gen_new_block()
        end_blk u32 = gen_new_block()
        f_blk u32 = if ast_c(n) != null { gen_new_block() } else { end_blk }
        gen_term_br(cb, t_blk, f_blk)
        gen_switch_block(t_blk)
        try gen_stmt(n.b)
        if !gen_is_terminated() { gen_term_jump(end_blk) }
        if ast_c(n) != null {
            gen_switch_block(f_blk)
            try gen_stmt(ast_c(n))
            if !gen_is_terminated() { gen_term_jump(end_blk) }
        }
        gen_switch_block(end_blk)
        return
    }

    if bytes_eq_c(kw, c"while") {
        cond_blk u32 = gen_new_block()
        body_blk u32 = gen_new_block()
        end_blk u32 = gen_new_block()
        if !gen_is_terminated() { gen_term_jump(cond_blk) }
        gen_switch_block(cond_blk)
        cv u32 = try gen_rvalue(n.a)
        cb u32 = gen_to_bool(cv, n.a.ty)
        gen_term_br(cb, body_blk, end_blk)

        lf handle[LoopFrame] = vec_add(&gc.loops)
        lf.break_blk = end_blk
        lf.continue_blk = cond_blk
        lf.cleanup_depth = gc.cleanups.n
        lf.vla_depth = gc.vla_stack.n
        lf.is_switch = false

        gen_switch_block(body_blk)
        try gen_stmt(n.b)
        if !gen_is_terminated() { gen_term_jump(cond_blk) }
        gc.loops.n -= 1
        gen_switch_block(end_blk)
        return
    }

    if bytes_eq_c(kw, c"do") {
        body_blk u32 = gen_new_block()
        cond_blk u32 = gen_new_block()
        end_blk u32 = gen_new_block()
        if !gen_is_terminated() { gen_term_jump(body_blk) }

        lf handle[LoopFrame] = vec_add(&gc.loops)
        lf.break_blk = end_blk
        lf.continue_blk = cond_blk
        lf.cleanup_depth = gc.cleanups.n
        lf.vla_depth = gc.vla_stack.n
        lf.is_switch = false

        gen_switch_block(body_blk)
        try gen_stmt(n.b)
        if !gen_is_terminated() { gen_term_jump(cond_blk) }
        gc.loops.n -= 1

        gen_switch_block(cond_blk)
        // A macro's `do { … } while (0)` has no conditional backedge,
        // including in functions whose computed goto pins their blocks.
        cond handle[Ast] = try gen_inline_fold(n.a, false)
        if ty_is_integer(cond.ty) && (cond.flags & (NF_ICE | NF_OVERFLOW)) == NF_ICE {
            gen_term_jump(if se_truth(cond) { body_blk } else { end_blk })
        } else {
            cv u32 = try gen_rvalue(n.a)
            cb u32 = gen_to_bool(cv, n.a.ty)
            gen_term_br(cb, body_blk, end_blk)
        }
        gen_switch_block(end_blk)
        return
    }

    if bytes_eq_c(kw, c"for") {
        old_cleanups usize = gc.cleanups.n
        old_vlas usize = gc.vla_stack.n
        gc.scope_depth += 1
        // A declaration initializer can contain a chain of declarators.
        init handle[Ast] = n.a
        while init != null {
            try gen_stmt(init)
            init = init.next
        }

        cond_blk u32 = gen_new_block()
        body_blk u32 = gen_new_block()
        step_blk u32 = gen_new_block()
        end_blk u32 = gen_new_block()
        if !gen_is_terminated() { gen_term_jump(cond_blk) }

        gen_switch_block(cond_blk)
        if n.b != null {
            cv u32 = try gen_rvalue(n.b)
            cb u32 = gen_to_bool(cv, n.b.ty)
            gen_term_br(cb, body_blk, end_blk)
        } else {
            gen_term_jump(body_blk)
        }

        lf handle[LoopFrame] = vec_add(&gc.loops)
        lf.break_blk = end_blk
        lf.continue_blk = step_blk
        lf.cleanup_depth = gc.cleanups.n
        lf.vla_depth = gc.vla_stack.n
        lf.is_switch = false

        gen_switch_block(body_blk)
        try gen_stmt(ast_d(n))
        if !gen_is_terminated() { gen_term_jump(step_blk) }
        gc.loops.n -= 1

        gen_switch_block(step_blk)
        if ast_c(n) != null { _ u32 = try gen_rvalue(ast_c(n)) }
        if !gen_is_terminated() { gen_term_jump(cond_blk) }

        gen_switch_block(end_blk)
        gc.scope_depth -= 1
        try gen_pop_scope(old_cleanups, old_vlas)
        return
    }

    if bytes_eq_c(kw, c"switch") {
        try gen_switch_stmt(n)
        return
    }

    if gen_is_terminated() { return }

    if bytes_eq_c(kw, c"break") {
        if gc.loops.n > 0 {
            lf LoopFrame = {}
            copy_into(&lf, vec_at(&gc.loops, gc.loops.n - 1))
            try gen_run_cleanups_to(lf.cleanup_depth)
            gen_restore_vlas_to(lf.vla_depth)
            gen_term_jump(lf.break_blk)
        }
        return
    }
    if bytes_eq_c(kw, c"continue") {
        i usize = gc.loops.n
        while i > 0 {
            i -= 1
            lf LoopFrame = {}
            copy_into(&lf, vec_at(&gc.loops, i))
            if !lf.is_switch {
                try gen_run_cleanups_to(lf.cleanup_depth)
                gen_restore_vlas_to(lf.vla_depth)
                gen_term_jump(lf.continue_blk)
                return
            }
        }
        return
    }
    if bytes_eq_c(kw, c"goto") {
        if n.a != null {
            // Computed goto `goto *expr`
            pv u32 = try gen_rvalue(n.a)
            if gen_is_terminated() { return }
            blk handle[GenBlock] = gen_cur_block()
            blk.terminated = true
            buf_str(&blk.term, c"  indirect_br ")
            gen_emit_val(&blk.term, pv)
            buf_str(&blk.term, c", [")
            labels handle[Vec[u32]] = gen_address_labels()
            for i usize in 0..labels.n {
                if i > 0 { buf_str(&blk.term, c", ") }
                tb u32 = vec_get(labels, i)
                gen_add_succ(blk, tb)
                gen_emit_lbl(&blk.term, tb)
            }
            buf_str(&blk.term, c"]\n")
            return
        }
        lbl handle[Label] = handle_from_addr(ast_extra(n))
        if lbl != null {
            gen_term_jump(gen_get_label_block(lbl))
        }
        return
    }
    if bytes_eq_c(kw, c"return") {
        if gc.inline_frame != null {
            try gen_inline_return(n)
            return
        }
        if n.a != null && !ty_is_void(gc.cur_ret_ty) {
            rv u32 = try gen_rvalue(n.a)
            rv = gen_convert(rv, n.a.ty, gc.cur_ret_ty)
            if gen_is_wide_bitint(gc.cur_ret_ty) {
                tmp u32 = gen_alloca_entry(ty_size(gc.cur_ret_ty), ty_align(gc.cur_ret_ty))
                gen_store_ty(rv, tmp, ty_align(gc.cur_ret_ty), false, false)
                try gen_run_cleanups_to(0)
                gen_term_ret_val(tmp)
            } else if gc.cleanups.n > 0 {
                // Save return value before running cleanups
                if gen_is_mem_ty(gc.cur_ret_ty) {
                    tmp u32 = gen_alloca_entry(ty_size(gc.cur_ret_ty), ty_align(gc.cur_ret_ty))
                    gen_memcpy_const(tmp, rv, ty_size(gc.cur_ret_ty), false)
                    try gen_run_cleanups_to(0)
                    gen_term_ret_val(tmp)
                } else {
                    try gen_run_cleanups_to(0)
                    gen_term_ret_val(rv)
                }
            } else {
                gen_term_ret_val(rv)
            }
        } else {
            if n.a != null { _ u32 = try gen_rvalue(n.a) }
            try gen_run_cleanups_to(0)
            gen_term_ret_void()
        }
        return
    }
}

// ---------- Pre-scan for `&&label` so `indirect_br` sees all address-taken labels ----------

// Whether a statement defines a label anywhere inside it, statement
// expressions in initializers included. Its `next` siblings are not part
// of it; its children's are.
fn gen_defines_label(n handle[Ast]) bool {
    if n == null { return false }
    if n.kind == ND_STMT && n.op != 0 && bytes_eq_c(sym_name(&gc.p.ctx.syms, n.op), c":") { return true }
    if n.kind == ND_DECL && n.decl != null && n.decl.value != null &&
        gen_defines_label_list(handle_from_addr(n.decl.value)) { return true }
    return gen_defines_label_list(n.a) || gen_defines_label_list(n.b) ||
           gen_defines_label_list(ast_c(n)) || gen_defines_label_list(ast_d(n))
}

fn gen_defines_label_list(n handle[Ast]) bool {
    s handle[Ast] = n
    while s != null {
        if gen_defines_label(s) { return true }
        s = s.next
    }
    return false
}

fn gen_prescan_addr_taken(n handle[Ast]) void {
    if n == null { return }
    if n.kind == ND_UNARY {
        op Bytes = sym_name(&gc.p.ctx.syms, n.op)
        if bytes_eq_c(op, c"&&") && ast_extra(n) != null {
            blk u32 = gen_get_label_block(handle_from_addr(ast_extra(n)))
            gen_mark_addr_taken(blk)
        }
    }
    if n.kind == ND_DECL && n.decl != null && n.decl.value != null {
        gen_prescan_addr_taken(handle_from_addr(n.decl.value))
    }
    gen_prescan_addr_taken(n.a)
    gen_prescan_addr_taken(n.b)
    gen_prescan_addr_taken(ast_c(n))
    gen_prescan_addr_taken(ast_d(n))
    gen_prescan_addr_taken(n.next)
}

// ---------- Function Definition Emission ----------

fn gen_protect_type(tid u32, strong bool) bool {
    n handle[TypeNode] = ty_node(ty_unqual(tid))
    if n.kind == TYK_ARRAY {
        if strong || n.aux1 == ARR_VLA { return true }
        elem u32 = ty_unqual(n.elem)
        return (ty_size(tid) >= 8 && (elem == TY_CHAR || elem == TY_SCHAR || elem == TY_UCHAR)) ||
               gen_protect_type(elem, false)
    }
    if n.kind == TYK_STRUCT || n.kind == TYK_UNION {
        r handle[RecordDef] = ty_record(n.aux1)
        for i u32 in 0..r.fields_len {
            if gen_protect_type(ty_field(r.fields_start + i).ty, strong) { return true }
        }
    }
    return false
}

fn gen_protect_body(n handle[Ast], strong bool) bool {
    if n == null { return false }
    if n.kind == ND_DECL && n.decl != null {
        s handle[Symbol] = n.decl
        if s.storage == SC_NONE || s.storage == SC_AUTO || s.storage == SC_REGISTER {
            if gen_protect_type(s.ty, strong) || gen_protect_body(handle_from_addr(s.value), strong) { return true }
        }
    } else if n.kind == ND_UNARY && strong && bytes_eq_c(sym_name(&gc.p.ctx.syms, n.op), c"&") {
        a handle[Ast] = n.a
        while a.kind == ND_MEMBER && !ty_is_ptr(a.a.ty) { a = a.a }
        if a.kind == ND_NAME && a.decl != null && a.decl.linkage == 0 &&
            a.decl.storage != SC_STATIC && a.decl.storage != SC_EXTERN && !ty_is_func(a.ty) { return true }
    } else if n.kind == ND_CALL && n.a != null {
        name Bytes = sym_name(&gc.p.ctx.syms, n.a.op)
        if bytes_eq_c(name, c"__builtin_alloca") || bytes_eq_c(name, c"__builtin_alloca_with_align") { return true }
    }
    return gen_protect_body(n.a, strong) || gen_protect_body(n.b, strong) ||
           gen_protect_body(ast_c(n), strong) || gen_protect_body(ast_d(n), strong) || gen_protect_body(n.next, strong)
}

// patchable_function_entry(N[, M]) as Fir's patchable(N, M): integer
// literals, M <= N <= 65535
fn gen_emit_patchable(out_b handle[Buf], attrs handle[Attr]) void fails {
    a handle[Attr] = attrs
    while a != null {
        if pa_attr_name(gc.p, a, c"patchable_function_entry") {
            n u64 = 0
            m u64 = 0
            ok bool = zext[usize](a.args_n) == 1 || zext[usize](a.args_n) == 3
            for i usize in 0..zext[usize](a.args_n) {
                t Token = a.args_p[Token, i]
                if (i & 1) == 1 {
                    if t.kind != TK_COMMA { ok = false }
                } else if t.kind != TK_NUM {
                    ok = false
                } else {
                    v u64 = bytes_to_u64(tok_spelling(gc.p.ctx, t)) catch 0x10000
                    if i == 0 { n = v } else { m = v }
                }
            }
            if !ok || n > 65535 || m > n {
                try pa_error(gc.p, a.loc, c"patchable_function_entry takes integer literals N and M, M <= N <= 65535")
            }
            buf_str(out_b, c" patchable(")
            buf_dec_u64(out_b, n)
            buf_str(out_b, c", ")
            buf_dec_u64(out_b, m)
            buf_str(out_b, c")")
            return
        }
        a = a.next
    }
}

fn gen_guard_inline_returns() void {
    cur u32 = gc.cur_blk
    gen_switch_block(0)
    gc.stack_guard = gen_alloca_entry(8, 8)
    gen_store_ty(gen_read_stack_guard(), gc.stack_guard, 8, true, false)
    // An inlined helper may introduce a protected local after an earlier
    // return was lowered. Route every existing return through a check.
    for i usize in 0..gc.blocks.n {
        blk handle[GenBlock] = vec_at(&gc.blocks, i)
        if !blk.returns { continue }
        term Buf = {}
        copy_into(&term, &blk.term)
        loc u32 = blk.debug_term_loc
        mem_set(&blk.term, 0, sizeof[Buf])
        blk.terminated = false
        blk.returns = false
        gen_switch_block(trunc[u32](i))
        gen_check_stack_guard()
        pass handle[GenBlock] = gen_cur_block()
        copy_into(&pass.term, &term)
        pass.debug_term_loc = loc
        pass.terminated = true
    }
    gen_switch_block(cur)
}

fn gen_function(node handle[Ast]) void fails {
    s handle[Symbol] = node.decl
    if s == null || node.a == null { return }
    nid u32 = gen_sym_fir_name_id(s)
    if gen_is_defined(nid) { return }
    // An unreferenced static inline must not introduce external dependencies.
    is_gnu_inline bool = gen_lazy_inline(s)
    if is_gnu_inline {
        gk U64Key = {zext[u64](nid)}
        prev u32 = table_get(&gc.gnu_inline_map, &gk) catch 0
        if prev != 0 { return }
    } else {
        gen_mark_defined(nid)
    }

    fn_node handle[TypeNode] = ty_node(ty_unqual(s.ty))
    if fn_node.kind != TYK_FUNC { return }
    ret_ty u32 = fn_node.elem
    is_var bool = (fn_node.flags & TYF_VARIADIC) != 0

    if is_gnu_inline {
        gi_idx usize = gc.gnu_inlines.n
        gi handle[GnuInlineDef] = vec_add(&gc.gnu_inlines)
        mem_set(handle_addr(gi), 0, sizeof[GnuInlineDef])
        gk U64Key = {zext[u64](nid)}
        _ bool = table_put(&gc.gnu_inline_map, &gk, trunc[u32](gi_idx + 1))
        gc.cur_gnu_inline_idx = trunc[u32](gi_idx + 1)
    }

    // Collect parameter symbols & types
    param_syms Vec[addr] = {}
    param_tids Vec[u32] = {}
    defer { vec_free(&param_syms); vec_free(&param_tids) }
    pm handle[Param] = handle_from_addr(s.params)
    while pm != null {
        if pm.decl != null {
            vec_push(&param_syms, handle_addr(pm.decl))
            vec_push(&param_tids, pm.decl.ty)
        } else if !ty_is_void(pm.ty) {
            vec_push(&param_syms, null)
            vec_push(&param_tids, pm.ty)
        }
        pm = pm.next
    }
    n_params u32 = trunc[u32](param_tids.n)

    // Reset per-function state
    gen_reset_func_state(gc)
    gc.in_func = true
    gc.cur_fn = s
    gc.cur_fn_name = nid
    gc.cur_ret_ty = ret_ty
    gc.has_fenv = (node.flags & NF_FENV) != 0
    gc.next_ssa = n_params + 1
    decl_loc u32 = if gc.debug.enabled { gen_debug_loc(s.loc, 0) } else { 0 }

    // Create entry block (block 0) and first body block (block 1)
    // Putting body in block 1 ensures nothing ever jumps to ^entry!
    entry_blk u32 = gen_new_block()
    body_blk u32 = gen_new_block()
    gen_switch_block(body_blk)

    protect bool = gc.stack_protector == 3 ||
        (gc.stack_protector != 0 && gen_has_attr(s.attrs, c"stack_protect")) ||
        ((gc.stack_protector == 1 || gc.stack_protector == 2) &&
            gen_protect_body(node.a, gc.stack_protector == 2))
    if protect && !gen_has_attr(s.attrs, c"no_stack_protector") {
        // Reserve the guard before user slots, toward the saved frame and
        // return address. Read it before evaluating parameter VLA bounds.
        gc.stack_guard = gen_alloca_entry(8, 8)
        gen_store_ty(gen_read_stack_guard(), gc.stack_guard, 8, true, false)
    }

    // Pre-scan for `&&label` so `indirect_br` has the complete target list
    gen_prescan_addr_taken(node.a)

    // Spill all parameters into entry-block allocas so `&param` and mutation always work
    for i u32 in 0..n_params {
        ps handle[Symbol] = handle_from_addr(vec_get(&param_syms, zext[usize](i)))
        if ps == null { continue }
        pt u32 = vec_get(&param_tids, zext[usize](i))
        sz u64 = ty_size(pt)
        al u64 = ty_align(pt)
        slot u32 = gen_alloca_entry(sz, al)
        key U64Key = {addr_bits(handle_addr(ps))}
        _ bool = table_put(&gc.locals, &key, slot)
        gen_debug_var(ps, slot, i + 1)
        if gen_is_mem_ty(pt) || gen_is_wide_bitint(pt) {
            // Copy agg/complex/wide-BitInt parameter bytes into local slot (per Fir SPEC.md §5)
            if sz > 0 { gen_memcpy_const(slot, i, sz, false) }
        } else {
            gen_store_ty(i, slot, al, false, false)
        }
    }

    // Parameter adjustment discards the outer array type from the ABI,
    // but its bound expression still runs at entry.
    pm2 handle[Param] = handle_from_addr(s.params)
    while pm2 != null {
        if pm2.declared_ty != TY_INVALID { try gen_eval_vm_type(pm2.declared_ty) }
        pm2 = pm2.next
    }

    // Lower function body
    try gen_stmt(node.a)

    if gc.debug.enabled { gc.debug.loc = gen_debug_loc(node.a.loc, 0) }
    // Implicit return at end of function body
    if !gen_is_terminated() {
        try gen_run_cleanups_to(0)
        if ty_is_void(ret_ty) {
            gen_term_ret_void()
        } else if bytes_eq_c(gen_sym_bytes(nid), c"main") {
            gen_term_ret_val(gen_const_int(ret_ty, 0))
        } else {
            gen_term_ret_val(gen_const_zero(ret_ty))
        }
    }

    pad u32 = if gc.unwind_cleanups.n > 0 { try gen_unwind_landing_pad() } else { 0 }
    if gc.inline_needs_guard && gc.stack_guard == 0 && !gen_has_attr(s.attrs, c"no_stack_protector") {
        gen_guard_inline_returns()
    }
    // Declare the exceptional edge to the verifier and allocator. The
    // empty asm falls through to the body. Only libgcc enters the pad.
    eb handle[GenBlock] = vec_at(&gc.blocks, zext[usize](entry_blk))
    eb.terminated = true
    gen_add_succ(eb, body_blk)
    buf_str(&eb.term, if pad == 0 { c"  jump " } else { c"  asm_goto volatile \"\" " })
    gen_emit_lbl(&eb.term, body_blk)
    if pad != 0 {
        gen_add_succ(eb, pad)
        buf_str(&eb.term, c" [")
        gen_emit_lbl(&eb.term, pad)
        buf_u8(&eb.term, 93)
    }
    buf_u8(&eb.term, 10)

    // Ensure every block that might be reachable has a terminator
    for i usize in 0..gc.blocks.n {
        blk handle[GenBlock] = vec_at(&gc.blocks, i)
        if !blk.terminated {
            blk.terminated = true
            buf_str(&blk.term, c"  unreachable\n")
        }
    }

    // BFS reachability from entry block (block 0) so Fir verifier never sees unreachable blocks
    n_blks usize = gc.blocks.n
    visited addr = heap_alloc_zeroed(n_blks)
    queue Vec[u32] = {}
    defer { vec_free(&queue) }
    visited[u8, 0] = 1
    vec_push(&queue, 0)
    qh usize = 0
    while qh < queue.n {
        cur u32 = vec_get(&queue, qh)
        qh += 1
        blk handle[GenBlock] = vec_at(&gc.blocks, zext[usize](cur))
        for j usize in 0..blk.succs.n {
            nxt u32 = vec_get(&blk.succs, j)
            if zext[usize](nxt) < n_blks && visited[u8, zext[usize](nxt)] == 0 {
                visited[u8, zext[usize](nxt)] = 1
                vec_push(&queue, nxt)
            }
        }
    }

    // Assign dense emission index 0..K-1 to reachable blocks (for blockaddr(@fn, N))
    emit_order Vec[u32] = {}
    defer { vec_free(&emit_order) }
    blk_to_idx addr = heap_alloc_zeroed(n_blks * 4)
    for i usize in 0..n_blks {
        if visited[u8, i] != 0 {
            blk_to_idx[u32, i] = trunc[u32](emit_order.n)
            vec_push(&emit_order, trunc[u32](i))
        }
    }

    // Patch any `blockaddr(@fn, 00000000)` placeholders with the exact 0-based block index
    for i usize in 0..gc.ba_patches.n {
        pt handle[BlockAddrPatch] = vec_at(&gc.ba_patches, i)
        if pt.blk_id != 0xffffffff && visited[u8, zext[usize](pt.blk_id)] == 0 { continue }
        idx u32 = blk_to_idx[u32, zext[usize](pt.target_blk)]
        code_b handle[Buf] = if pt.blk_id == 0xffffffff {
            &gc.deferred
        } else {
            &vec_at(&gc.blocks, zext[usize](pt.blk_id)).code
        }
        // Overwrite the 8-byte placeholder with right-padded spaces + decimal digits
        tmp Buf = {}
        buf_dec_u64(&tmp, zext[u64](idx))
        for k usize in 0..8 {
            ch u8 = if k < tmp.n { tmp.p[u8, k] } else { 32 }
            code_b.p[u8, pt.off + k] = ch
        }
        buf_free(&tmp)
    }

    // Emit the function to gc.out (or to its buffered GnuInlineDef)
    out_b handle[Buf] = if is_gnu_inline {
        &vec_at(&gc.gnu_inlines, zext[usize](gc.cur_gnu_inline_idx - 1)).code
    } else {
        &gc.out.buf
    }
    if gen_sym_linkage(s) == FIR_LOCAL { gen_emit_discardable(out_b, s, nid) }
    buf_str(out_b, c"func ")
    gen_emit_sym_name(out_b, gen_sym_bytes(nid))
    buf_u8(out_b, 32)
    if (fn_node.flags & TYF_MS_ABI) != 0 { buf_str(out_b, c"ms_abi ") }
    abi_emit_fir_sig(out_b, ret_ty, param_tids.p, n_params, is_var)
    buf_u8(out_b, 32)
    fn_link u8 = if is_gnu_inline { FIR_LOCAL } else { gen_sym_linkage(s) }
    fir_emit_linkage(out_b, fn_link, gen_sym_visibility(s))
    if gen_is_noreturn(s) {
        buf_str(out_b, c" noreturn")
    }
    if gen_has_attr(s.attrs, c"noinline") { buf_str(out_b, c" noinline") }
    if gen_has_attr(s.attrs, c"nocf_check") { buf_str(out_b, c" nocf_check") }
    try gen_emit_patchable(out_b, s.attrs)
    sec_buf Buf = {}
    if gen_attr_str_arg(s.attrs, c"section", &sec_buf) && sec_buf.n != 0 {
        buf_str(out_b, c" section ")
        fir_emit_quoted_bytes(out_b, sec_buf.p, sec_buf.n)
    }
    buf_free(&sec_buf)
    if gc.has_fenv { buf_str(out_b, c" fenv") }
    if pad != 0 {
        buf_str(out_b, c" !cleanup ")
        buf_dec_u64(out_b, zext[u64](blk_to_idx[u32, zext[usize](pad)]))
        buf_str(out_b, c", ")
        buf_dec_u64(out_b, zext[u64](blk_to_idx[u32, zext[usize](gc.cur_blk)]))
    }
    if gc.debug.enabled && !bytes_eq(gen_sym_bytes(nid), sym_name(&gc.p.ctx.syms, s.name)) {
        buf_str(out_b, c" display ")
        gen_debug_quote(out_b, sym_name(&gc.p.ctx.syms, s.name))
    }
    gen_debug_suffix(out_b, decl_loc)
    buf_str(out_b, c" {\n")
    buf_append(out_b, buf_bytes(&gc.debug.vars))

    for ei usize in 0..emit_order.n {
        bid u32 = vec_get(&emit_order, ei)
        blk handle[GenBlock] = vec_at(&gc.blocks, zext[usize](bid))
        if bid == 0 {
            buf_str(out_b, c"^entry")
            if n_params > 0 {
                buf_u8(out_b, 40)
                for i u32 in 0..n_params {
                    if i > 0 { buf_str(out_b, c", ") }
                    gen_emit_val(out_b, i)
                    buf_str(out_b, c": ")
                    abi_emit_fir_ssa_ty(out_b, vec_get(&param_tids, zext[usize](i)))
                }
                buf_u8(out_b, 41)
            }
            buf_str(out_b, c":\n")
        } else {
            gen_emit_lbl(out_b, bid)
            if blk.bool_param != 0 {
                buf_u8(out_b, 40)
                gen_emit_val(out_b, blk.bool_param)
                buf_str(out_b, c": i1)")
            }
            buf_str(out_b, c":\n")
        }
        if blk.unreachable_offset != 0 { blk.code.n = blk.unreachable_offset - 1 }
        gen_debug_write_code(out_b, blk)
        if blk.debug_term_loc != 0 && blk.term.n > 0 {
            term Bytes = buf_bytes(&blk.term)
            buf_append(out_b, bytes_sub(term, 0, term.n - 1))
            gen_debug_suffix(out_b, blk.debug_term_loc)
            buf_u8(out_b, 10)
        } else {
            buf_append(out_b, buf_bytes(&blk.term))
        }
    }
    buf_str(out_b, c"}\n\n")
    if !is_gnu_inline { fir_flush(&gc.out) }

    gc.in_func = false

    // Flush any deferred globals (strings, static locals, compound literals) emitted during this function
    if gc.deferred.n > 0 {
        if is_gnu_inline {
            buf_append(out_b, buf_bytes(&gc.deferred))
            buf_clear(&gc.deferred)
        } else {
            buf_append(&gc.out.buf, buf_bytes(&gc.deferred))
            buf_clear(&gc.deferred)
            fir_flush(&gc.out)
        }
    }
    if is_gnu_inline {
        gc.cur_gnu_inline_idx = 0
        gen_reset_func_state(gc)
        return
    }

    // Emit constructor / destructor entries if attributed
    if gen_has_attr(s.attrs, c"constructor") {
        prio u64 = gen_attr_int_arg(s.attrs, c"constructor", 0)
        gen_emit_ctor_dtor(gen_sym_bytes(nid), false, prio)
    }
    if gen_has_attr(s.attrs, c"destructor") {
        prio u64 = gen_attr_int_arg(s.attrs, c"destructor", 0)
        gen_emit_ctor_dtor(gen_sym_bytes(nid), true, prio)
    }

    gen_reset_func_state(gc)
}
