// cc2/directive.fas: Preprocessor directives dispatched by pre-interned SymId.

fn pp_lex_line(ctx handle[CcCtx], l handle[Lexer], tokens handle[Vec[Token]], header bool) void fails {
    l.header = header
    while true {
        t Token = try lex_next(ctx, l, false)
        if t.kind == TK_NL || t.kind == TK_EOF { l.header = false; return }
        vec_push[Token](tokens, t)
    }
}

fn pp_param_index(ctx handle[CcCtx], m handle[Macro], t Token) usize {
    if t.kind == TK_IDENT {
        id u32 = cc_ident(ctx, t)
        for i usize in 0..m.params.n {
            if m.params.p[u32, i] == id { return i }
        }
    }
    return m.params.n
}

fn pp_check_replacement(ctx handle[CcCtx], m handle[Macro], data addr, first usize, stop usize, inner bool) void fails {
    i usize = first
    while i < stop {
        t Token = data[Token, i]
        if (i == first || i + 1 == stop) && tok_is_paste(t.kind) {
            try cc_error(ctx, t.loc, c"'##' at edge of macro replacement")
        }
        if t.kind == TK_IDENT && cc_ident(ctx, t) == SYM_VA_OPT {
            if inner || !m.variadic || i + 1 >= stop || data[Token, i + 1].kind != TK_LPAREN {
                try cc_error(ctx, t.loc, c"invalid __VA_OPT__")
            }
            i += 2
            begin usize = i
            depth usize = 1
            while i < stop {
                part Token = data[Token, i]
                if part.kind == TK_LPAREN { depth += 1 }
                if part.kind == TK_RPAREN { depth -= 1 }
                if depth == 0 { break }
                i += 1
            }
            if depth != 0 { try cc_error(ctx, t.loc, c"unterminated __VA_OPT__") }
            try pp_check_replacement(ctx, m, data, begin, i, true)
        } else if m.function && tok_is_hash(t.kind) {
            if i + 1 == stop || (pp_param_index(ctx, m, data[Token, i + 1]) == m.params.n &&
                !(data[Token, i + 1].kind == TK_IDENT && cc_ident(ctx, data[Token, i + 1]) == SYM_VA_OPT)) {
                try cc_error(ctx, t.loc, c"'#' must precede a macro parameter")
            }
        }
        i += 1
    }
}

fn pp_define(p handle[Pp], args handle[Vec[Token]], loc u32, system bool) void fails {
    ctx handle[CcCtx] = &p.ctx
    if args.n == 0 || args.p[Token].kind != TK_IDENT { try cc_error(ctx, loc, c"expected macro name") }
    id u32 = cc_ident(ctx, args.p[Token])
    if id == SYM_DEFINED { try cc_error(ctx, loc, c"cannot define the preprocessor operator defined") }
    a addr = arena_alloc(&ctx.syms.arena, sizeof[Macro], 8)
    m handle[Macro] = handle_from_addr(a)
    i usize = 1
    if i < args.n && (args.p[Token, i].flags & F_SPACE) == 0 && args.p[Token, i].kind == TK_LPAREN {
        m.function = true
        i += 1
        while i < args.n && args.p[Token, i].kind != TK_RPAREN {
            t Token = args.p[Token, i]
            i += 1
            if t.kind == TK_ELLIPSIS {
                m.variadic = true
                vec_push[u32](&m.params, SYM_VA_ARGS)
                break
            }
            if t.kind != TK_IDENT { try cc_error(ctx, t.loc, c"expected macro parameter") }
            param u32 = cc_ident(ctx, t)
            for j usize in 0..m.params.n {
                if m.params.p[u32, j] == param { try cc_error(ctx, t.loc, c"duplicate macro parameter") }
            }
            vec_push[u32](&m.params, param)
            if i < args.n && (ctx.gnu || system) && args.p[Token, i].kind == TK_ELLIPSIS {
                try cc_warning(ctx, args.p[Token, i].loc, p.warning_modes.named_variadic, c"named variadic macros are a GNU extension")
                m.variadic = true
                i += 1
                break
            }
            if i == args.n || args.p[Token, i].kind != TK_COMMA { break }
            i += 1
            if i < args.n && args.p[Token, i].kind == TK_RPAREN { try cc_error(ctx, loc, c"expected macro parameter after comma") }
        }
        if i == args.n || args.p[Token, i].kind != TK_RPAREN { try cc_error(ctx, loc, c"expected ')' in macro parameters") }
        i += 1
    }
    try pp_check_replacement(ctx, m, args.p, i, args.n, false)
    has_paste bool = false
    has_ident bool = false
    has_param bool = false
    has_hash bool = false
    body_n usize = args.n - i
    if body_n != 0 {
        m.body.p = arena_alloc(&ctx.syms.arena, body_n * sizeof[Token], 8)
        m.body.n = body_n
        m.body.cap = body_n
        for j usize in 0..body_n {
            bt Token = tok_materialize(ctx, args.p[Token, i + j])
            if tok_is_paste(bt.kind) { has_paste = true }
            if m.function && tok_is_hash(bt.kind) { has_hash = true }
            if bt.kind == TK_IDENT {
                if m.function {
                    pidx usize = pp_param_index(ctx, m, bt)
                    if pidx != m.params.n {
                        bt.kind = TK_PARAM
                        bt.val = trunc[u32](pidx)
                        has_param = true
                    } else {
                        if cc_ident(ctx, bt) == SYM_VA_OPT { has_param = true }
                        has_ident = true
                    }
                } else {
                    has_ident = true
                }
            }
            m.body.p[Token, j] = bt
        }
    }
    m.simple = !m.function && !has_paste
    m.const_simple = m.simple && !has_ident
    m.drop_args = m.function && !has_param && !has_hash && !has_paste
    if (m.simple || m.drop_args) && body_n != 0 {
        // Pre-render exact text into TU arena for zero-overhead inline -E emission!
        rb Buf = {}
        defer { buf_free(&rb) }
        for j usize in 0..body_n {
            if j != 0 { buf_u8(&rb, 32) }
            buf_append(&rb, tok_spelling(ctx, m.body.p[Token, j]))
        }
        cp addr = arena_alloc(&ctx.syms.arena, rb.n + 1, 1)
        if rb.n != 0 { mem_copy(cp, rb.p, rb.n) }
        m.const_text = bytes(cp, rb.n)
    }
    sym_set_macro(&ctx.syms, id, a)
}

fn pp_single_name(p handle[Pp], args handle[Vec[Token]], loc u32) u32 fails {
    if args.n == 0 || args.p[Token].kind != TK_IDENT { try cc_error(&p.ctx, loc, c"expected identifier") }
    return cc_ident(&p.ctx, args.p[Token])
}

fn pp_message(ctx handle[CcCtx], args handle[Vec[Token]], out handle[Buf]) void {
    for i usize in 0..args.n {
        t Token = args.p[Token, i]
        if i != 0 && (t.flags & F_SPACE) != 0 { buf_u8(out, 32) }
        buf_append(out, tok_spelling(ctx, t))
    }
}

struct Header { name Bytes, owned Buf, quote bool, used usize }

fn pp_header(p handle[Pp], tokens handle[Vec[Token]], loc u32, out handle[Header]) void fails {
    ctx handle[CcCtx] = &p.ctx
    if tokens.n != 0 {
        first Token = tokens.p[Token]
        if first.kind == TK_HEADER || first.kind == TK_STR {
            s Bytes = tok_spelling(ctx, first)
            if s.n >= 2 && (s.p[u8] == 34 || s.p[u8] == 60) {
                out.name = bytes_sub(s, 1, s.n - 2)
                out.quote = s.p[u8] == 34
                out.used = 1
                return
            }
        }
        if first.kind == TK_LT {
            for i usize in 1..tokens.n {
                t Token = tokens.p[Token, i]
                if (t.flags & F_SPACE) != 0 { buf_u8(&out.owned, 32) }
                if t.kind == TK_GT { out.name = buf_bytes(&out.owned); out.used = i + 1; return }
                buf_append(&out.owned, tok_spelling(ctx, t))
            }
        }
    }
    try cc_error(ctx, loc, c"expected header name")
}

fn pp_include(p handle[Pp], args handle[Vec[Token]], loc u32, next bool, importing bool) void fails {
    ctx handle[CcCtx] = &p.ctx
    expanded Vec[Token] = {}
    defer { if expanded.cap != 0 { vec_free[Token](&expanded) } }
    if args.n > 0 && args.p[Token].kind == TK_HEADER {
        if args.n == 1 { expanded.p = args.p; expanded.n = args.n }
        else {
            vec_push[Token](&expanded, args.p[Token])
            try expand_list(p, args.p + sizeof[Token], args.n - 1, &expanded, false)
        }
    } else {
        try expand_list(p, args.p, args.n, &expanded, false)
    }
    h Header = {}
    defer { buf_free(&h.owned) }
    try pp_header(p, &expanded, loc, &h)
    if h.used != expanded.n { try cc_error(ctx, loc, c"extra tokens after header name") }
    found Found = pp_find(p, h.name, h.quote, next)
    if found.file == null {
        m Buf = {}
        defer { buf_free(&m) }
        buf_u8(&m, 39)
        buf_append(&m, h.name)
        buf_str(&m, c"' file not found")
        cc_diag(ctx, loc, c"error: ", buf_bytes(&m))
        fail CError
    }
    sf handle[SourceFile] = handle_from_addr(found.file)
    if importing && sf.read {
        sf.once = true
        pp_depend(p, found.path, found.system)
        return
    }
    try pp_push_file(p, sf, found.path, sext[i32](found.dir), found.system, loc)
    if importing { sf.once = true }
}

fn pp_guard(p handle[Pp], f handle[Frame], dir_id u32, args handle[Vec[Token]]) void {
    ctx handle[CcCtx] = &p.ctx
    depth usize = p.conditions.n - f.base
    if f.guard_stage == 0 && dir_id == SYM_IFNDEF && args.n == 1 && args.p[Token].kind == TK_IDENT {
        f.guard = cc_ident(ctx, args.p[Token])
        f.guard_stage = 1
    } else if f.guard_stage == 1 && depth == 1 && dir_id == SYM_DEFINE && args.n != 0 &&
        args.p[Token].kind == TK_IDENT && cc_ident(ctx, args.p[Token]) == f.guard {
        f.guard_stage = 2
    } else if f.guard_stage == 2 && depth == 1 && dir_id == SYM_ENDIF {
        f.guard_stage = 3
    } else if f.guard_stage != 2 || (depth == 1 && (dir_id == SYM_ELSE || dir_id == SYM_ELIF ||
        dir_id == SYM_ELIFDEF || dir_id == SYM_ELIFNDEF)) {
        f.guard_stage = 4
    }
}

fn pp_condition(p handle[Pp], f handle[Frame], dir_id u32, args handle[Vec[Token]], loc u32) bool fails {
    ctx handle[CcCtx] = &p.ctx
    if dir_id == SYM_IF || dir_id == SYM_IFDEF || dir_id == SYM_IFNDEF {
        parent bool = pp_active(p)
        yes bool = false
        if parent {
            if dir_id == SYM_IF { yes = (try pp_eval(p, args, loc)).bits != 0 }
            else {
                yes = sym_is_defined(&ctx.syms, try pp_single_name(p, args, loc))
                if dir_id == SYM_IFNDEF { yes = !yes }
            }
        }
        vec_push[Cond](&p.conditions, {loc, parent, yes, yes, false})
        return true
    }
    if dir_id != SYM_ENDIF && dir_id != SYM_ELSE && dir_id != SYM_ELIF &&
       dir_id != SYM_ELIFDEF && dir_id != SYM_ELIFNDEF {
        return false
    }
    if p.conditions.n == f.base { try cc_error(ctx, loc, c"conditional directive without matching #if") }
    if dir_id == SYM_ENDIF {
        vec_truncate[Cond](&p.conditions, p.conditions.n - 1)
        return true
    }
    cond handle[Cond] = vec_at[Cond](&p.conditions, p.conditions.n - 1)
    if cond.otherwise { try cc_error(ctx, loc, c"conditional branch after #else") }
    alt bool = dir_id == SYM_ELSE
    cond.otherwise = alt
    cond.active = false
    if cond.parent && !cond.taken {
        yes bool = alt
        if dir_id == SYM_ELIF { yes = (try pp_eval(p, args, loc)).bits != 0 }
        if dir_id == SYM_ELIFDEF || dir_id == SYM_ELIFNDEF {
            yes = sym_is_defined(&ctx.syms, try pp_single_name(p, args, loc)) != (dir_id == SYM_ELIFNDEF)
        }
        cond.active = yes
        cond.taken = yes
    }
    return true
}

fn pragma_tokens(p handle[Pp], source Bytes, loc u32, tokens handle[Vec[Token]]) void fails {
    ctx handle[CcCtx] = &p.ctx
    b addr = heap_alloc_zeroed(source.n + 64)
    defer { heap_free(b) }
    if source.n != 0 { mem_copy(b, source.p, source.n) }
    l Lexer = {}
    l.p = b
    l.n = source.n
    l.at = 0
    l.base = 0
    l.pragma_line = true
    while true {
        t Token = try lex_next(ctx, &l, false)
        if t.kind == TK_NL || t.kind == TK_EOF { break }
        if t.kind != TK_IDENT && !tok_is_punct(t.kind) && (t.flags & F_SYNTH) == 0 {
            id u32 = sm_add_synth(&ctx.sm, bytes(b + zext[usize](t.loc), zext[usize](t.len)))
            t.flags |= F_SYNTH
            t.len = 0xFFFF
            t.val = id
        }
        t.loc = loc
        vec_push[Token](tokens, t)
    }
}

fn pp_pragma_message(p handle[Pp], args handle[Vec[Token]], first usize, loc u32, fatal bool) void fails {
    ctx handle[CcCtx] = &p.ctx
    expanded Vec[Token] = {}
    defer { vec_free[Token](&expanded) }
    try expand_list(p, args.p + first * sizeof[Token], args.n - first, &expanded, false)
    start usize = 0
    end usize = expanded.n
    if end != 0 && expanded.p[Token].kind == TK_LPAREN {
        if expanded.p[Token, end - 1].kind != TK_RPAREN {
            try cc_error(ctx, loc, c"missing ')' after pragma message")
        }
        start = 1
        end -= 1
    }
    if start >= end { try cc_error(ctx, loc, c"expected a string in pragma message") }
    message Buf = {}
    defer { buf_free(&message) }
    for i usize in start..end {
        piece Token = expanded.p[Token, i]
        if piece.kind != TK_STR { try cc_error(ctx, piece.loc, c"expected a string in pragma message") }
        if fatal { pp_destringize(tok_spelling(ctx, piece), &message) }
    }
    if fatal {
        cc_diag(ctx, loc, c"error: ", buf_bytes(&message))
        fail CError
    }
}

fn pp_pragma_diagnostic(p handle[Pp], args handle[Vec[Token]], loc u32) void fails {
    ctx handle[CcCtx] = &p.ctx
    if args.n < 3 { return }
    action Token = args.p[Token, 2]
    if action.kind != TK_IDENT { return }
    act_id u32 = cc_ident(ctx, action)
    if act_id == SYM_PUSH {
        vec_push[WarningModes](&p.warning_stack, p.warning_modes)
        return
    }
    if act_id == SYM_POP {
        if p.warning_stack.n != 0 {
            p.warning_modes = vec_last[WarningModes](&p.warning_stack)
            p.warning_stack.n -= 1
        }
        return
    }
    mode u8 = WARN_OFF
    if act_id == SYM_ERROR || act_id == SYM_FATAL { mode = WARN_ERROR }
    else if act_id == SYM_WARNING { mode = WARN_ON }
    else if act_id != SYM_IGNORED { return }
    if args.n < 4 || args.p[Token, 3].kind != TK_STR {
        try cc_error(ctx, loc, c"expected a string literal in diagnostic pragma")
    }
    option Buf = {}
    defer { buf_free(&option) }
    for i usize in 3..args.n {
        piece Token = args.p[Token, i]
        if piece.kind != TK_STR { break }
        pp_destringize(tok_spelling(ctx, piece), &option)
    }
    spelling Bytes = buf_bytes(&option)
    if bytes_eq_c(spelling, c"-Waddress") || bytes_eq_c(spelling, c"-Wpointer-bool-conversion") {
        p.warning_modes.address = mode
    } else if bytes_eq_c(spelling, c"-Wundef") {
        p.warning_modes.undef = mode
    } else if bytes_eq_c(spelling, c"-Wvariadic-macros") || bytes_eq_c(spelling, c"-Wpedantic") {
        p.warning_modes.named_variadic = mode
    }
}

fn pp_pragma(p handle[Pp], args handle[Vec[Token]], loc u32) Token fails {
    ctx handle[CcCtx] = &p.ctx
    drop Token = tok_make(TK_PLACE, 0, 0, loc, 0)
    if args.n == 0 { return drop }
    first Token = args.p[Token]
    first_id u32 = if first.kind == TK_IDENT { cc_ident(ctx, first) } else { 0 }
    if args.n > 1 && (first_id == SYM_GCC || first_id == SYM_CLANG) &&
        args.p[Token, 1].kind == TK_IDENT && cc_ident(ctx, args.p[Token, 1]) == SYM_DIAGNOSTIC {
        try pp_pragma_diagnostic(p, args, loc)
    }
    if first_id == SYM_MESSAGE { try pp_pragma_message(p, args, 1, loc, false) }
    if first_id == SYM_ONCE && p.frames.n != 0 {
        f handle[Frame] = vec_at[Frame](&p.frames, p.frames.n - 1)
        f.file.once = true
        return drop
    }
    if first_id == SYM_GCC && args.n > 1 && args.p[Token, 1].kind == TK_IDENT {
        cmd_id u32 = cc_ident(ctx, args.p[Token, 1])
        if cmd_id == SYM_ERROR { try pp_pragma_message(p, args, 2, loc, true) }
        if cmd_id == SYM_SYSTEM_HEADER {
            if p.frames.n > 1 {
                f handle[Frame] = vec_at[Frame](&p.frames, p.frames.n - 1)
                f.system = true
            }
            return drop
        }
        if cmd_id == SYM_DEPENDENCY {
            rest Vec[Token] = {}
            rest.p = args.p + 2 * sizeof[Token]
            rest.n = args.n - 2
            h Header = {}
            defer { buf_free(&h.owned) }
            try pp_header(p, &rest, loc, &h)
            if pp_find(p, h.name, h.quote, false).file == null {
                try cc_error(ctx, loc, c"pragma dependency file not found")
            }
            return drop
        }
    }
    if first_id == SYM_PUSH_MACRO || first_id == SYM_POP_MACRO {
        if args.n != 4 || args.p[Token, 1].kind != TK_LPAREN || args.p[Token, 2].kind != TK_STR ||
            args.p[Token, 3].kind != TK_RPAREN {
            try cc_error(ctx, loc, c"macro pragma expects a parenthesized string")
        }
        mname Buf = {}
        defer { buf_free(&mname) }
        pp_destringize(tok_spelling(ctx, args.p[Token, 2]), &mname)
        id u32 = sym_intern_b(&ctx.syms, buf_bytes(&mname))
        if first_id == SYM_PUSH_MACRO {
            vec_push[SavedMacro](&p.macro_stack, {pp_macro(p, id), id, ctx.syms.flags.p[u8, zext[usize](id)]})
        } else {
            i usize = p.macro_stack.n
            while i != 0 {
                i -= 1
                saved SavedMacro = p.macro_stack.p[SavedMacro, i]
                if saved.id == id {
                    ctx.syms.macros.p[addr, zext[usize](id)] = saved.macro
                    ctx.syms.flags.p[u8, zext[usize](id)] = saved.flags
                    ctx.syms.macro_epoch += 1
                    pos addr = p.macro_stack.p + i * sizeof[SavedMacro]
                    mem_move(pos, pos + sizeof[SavedMacro], (p.macro_stack.n - i - 1) * sizeof[SavedMacro])
                    p.macro_stack.n -= 1
                    break
                }
            }
        }
        return drop
    }
    b Buf = {}
    defer { buf_free(&b) }
    if first_id == SYM_OMP || first_id == SYM_ACC {
        expanded Vec[Token] = {}
        defer { vec_free[Token](&expanded) }
        vec_push[Token](&expanded, first)
        try expand_list(p, args.p + sizeof[Token], args.n - 1, &expanded, false)
        for i usize in 0..expanded.n {
            if i != 0 { buf_u8(&b, 32) }
            buf_append(&b, tok_spelling(ctx, expanded.p[Token, i]))
        }
    } else {
        pp_message(ctx, args, &b)
    }
    id u32 = sm_add_synth(&ctx.sm, buf_bytes(&b))
    return tok_make(TK_PRAGMA, F_BOL | F_SYNTH, 0xFFFF, loc, id)
}

fn pp_line_number(ctx handle[CcCtx], t Token) u64 fails {
    spelling Bytes = tok_spelling(ctx, t)
    value u64 = 0
    if t.kind != TK_NUM { try cc_error(ctx, t.loc, c"invalid line number") }
    for i usize in 0..spelling.n {
        c u8 = spelling.p[u8, i]
        if c == 39 && i != 0 && i + 1 < spelling.n && cc_digit(spelling.p[u8, i + 1]) { continue }
        if !cc_digit(c) { try cc_error(ctx, t.loc, c"invalid line number") }
        digit u64 = zext[u64](c - 48)
        if value > (~0 - digit) / 10 { try cc_error(ctx, t.loc, c"line number out of range") }
        value = value * 10 + digit
    }
    return value
}

fn pp_line(p handle[Pp], f handle[Frame], args handle[Vec[Token]], loc u32, marker bool) void fails {
    ctx handle[CcCtx] = &p.ctx
    l handle[Lexer] = &f.lexer
    expanded Vec[Token] = {}
    defer { vec_free[Token](&expanded) }
    try expand_list(p, args.p, args.n, &expanded, false)
    if expanded.n == 0 { try cc_error(ctx, loc, c"expected line number") }
    number u64 = try pp_line_number(ctx, expanded.p[Token])
    if number == 0 || number > 2147483647 {
        if !ctx.gnu { try cc_error(ctx, loc, c"line number out of range") }
        cc_diag(ctx, loc, c"warning: ", bytes_c(c"line number out of range"))
        number &= 0xffffffff
    }
    if expanded.n > 1 {
        name Token = expanded.p[Token, 1]
        if name.kind != TK_STR { try cc_error(ctx, loc, c"expected filename string") }
        destr Buf = {}
        defer { buf_free(&destr) }
        pp_destringize(tok_spelling(ctx, name), &destr)
        f.logical_path = sym_intern_b(&ctx.syms, buf_bytes(&destr))
        if f.physical == p.base_file { p.base_logical = f.logical_path }
    }
    if marker && expanded.n > 2 {
        for i usize in 2..expanded.n {
            s Bytes = tok_spelling(ctx, expanded.p[Token, i])
            if s.n == 1 && s.p[u8] == 51 { f.system = true }
        }
    }
    inst handle[SourceInst] = vec_at[SourceInst](&ctx.sm.insts, zext[usize](l.inst_idx))
    off u32 = trunc[u32](l.at)
    phys_line u32 = sf_phys_line_col(inst.file, off, null)
    vec_push[LineOverride](&inst.overrides, {off, trunc[u32](number), f.logical_path, phys_line})
    l.line = trunc[u32](number)
    if p.line_markers {
        vec_push[Token](&p.pending.tokens, tok_make(TK_MARK, if f.system { F_SYSTEM } else { 0 }, 0, l.base + off, 0))
    }
}

fn pp_directive(p handle[Pp], f handle[Frame], hash Token) void fails {
    ctx handle[CcCtx] = &p.ctx
    l handle[Lexer] = &f.lexer
    loc u32 = hash.loc
    start usize = l.at - zext[usize](hash.len)
    l.pragma_line = ctx.assembler
    word Token = try lex_next(ctx, l, false)
    l.pragma_line = false
    if word.kind == TK_NL || word.kind == TK_EOF { return }
    dir_id u32 = if word.kind == TK_IDENT { cc_ident(ctx, word) } else { 0 }
    if ctx.assembler && word.kind != TK_NUM && (dir_id < SYM_IF || dir_id > SYM_SCCS) {
        comment Token = pp_asm_comment(ctx, l, hash, start)
        if pp_active(p) { vec_push[Token](&p.pending.tokens, comment) }
        return
    }
    inc bool = dir_id == SYM_INCLUDE
    next bool = dir_id == SYM_INCLUDE_NEXT
    embed bool = dir_id == SYM_EMBED
    importing bool = ctx.gnu && dir_id == SYM_IMPORT
    pragma bool = dir_id == SYM_PRAGMA

    args Vec[Token] = {}
    defer { vec_free[Token](&args) }
    if word.kind == TK_NUM { vec_push[Token](&args, word) }
    l.pragma_line = pragma
    try pp_lex_line(ctx, l, &args, pp_active(p) && (inc || next || embed || importing))
    l.pragma_line = false
    pp_guard(p, f, dir_id, &args)
    if try pp_condition(p, f, dir_id, &args, loc) { return }
    if !pp_active(p) { return }
    if inc || next || importing {
        if next && !ctx.gnu && !f.system { try cc_error(ctx, loc, c"#include_next requires GNU mode") }
        try pp_include(p, &args, loc, next, importing)
    } else if dir_id == SYM_DEFINE {
        try pp_define(p, &args, loc, f.system)
    } else if dir_id == SYM_UNDEF_KW {
        id u32 = try pp_single_name(p, &args, loc)
        sym_undef(&ctx.syms, id)
    } else if dir_id == SYM_LINE || (word.kind == TK_NUM && ctx.gnu) {
        try pp_line(p, f, &args, loc, word.kind == TK_NUM)
    } else if pragma {
        t Token = try pp_pragma(p, &args, loc)
        if t.kind == TK_PRAGMA { vec_push[Token](&p.pending.tokens, t) }
    } else if ctx.gnu && (dir_id == SYM_IDENT || dir_id == SYM_SCCS) {
        b Buf = {}
        defer { buf_free(&b) }
        buf_str(&b, c"ident ")
        pp_message(ctx, &args, &b)
        id u32 = sm_add_synth(&ctx.sm, buf_bytes(&b))
        vec_push[Token](&p.pending.tokens, tok_make(TK_DIRECT, F_BOL | F_SYNTH, 0xFFFF, loc, id))
    } else if dir_id == SYM_ERROR || dir_id == SYM_WARNING {
        b Buf = {}
        defer { buf_free(&b) }
        pp_message(ctx, &args, &b)
        fatal bool = dir_id == SYM_ERROR
        cc_diag(ctx, loc, if fatal { c"error: " } else { c"warning: " }, buf_bytes(&b))
        if fatal { fail CError }
    } else if embed {
        try pp_embed(p, &args, loc)
    } else {
        try cc_error(ctx, loc, c"invalid preprocessing directive")
    }
}
